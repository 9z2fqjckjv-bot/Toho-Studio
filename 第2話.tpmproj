    {
      "slide_index": 5,
      "text": "「こんにちは。霊夢さんに用でもあるのですか？」",
      "notes": "（操夢）「こんにちは。霊夢さんに用でもあるのですか？」",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "コンニチワ。レームサンニヨウデモアルノデスカ",
