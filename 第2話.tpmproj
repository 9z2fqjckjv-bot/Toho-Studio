      "_cacheBuster": 1787653028778
    },
    {
      "slide_index": 10,
      "text": "「見ててくれよ。」私はそう言い、彼に実演をする。",
      "notes": "（にとり）「見ててくれよ。」私はそう言い、彼に実演をする。",
      "character": "にとり",
      "voice": "jgr",
      "speed": 105,
      "pitch": 105,
      "phonemes": "ミテテクレヨ。ワタシワソウイイ、カレニジツエンオスル。",
