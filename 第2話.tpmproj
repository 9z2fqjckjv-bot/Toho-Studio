      "_cacheBuster": 1787653028778
    },
    {
      "slide_index": 6,
      "text": "「そうそう、彼女に新製品の宣伝にでも行こうと思ってね…」",
      "notes": "（にとり）「そうそう、彼女に新製品の宣伝にでも行こうと思ってね…」",
      "character": "にとり",
      "voice": "jgr",
      "speed": 105,
      "pitch": 105,
      "phonemes": "ソウソウ、カノジョニシンセイヒンノセンデンニデモイコウトオモッテネ",
      "extra_delay": 0,
      "transition_delay": 0.5,
