      "_cacheBuster": 1787653028778
    },
    {
      "slide_index": 3,
      "text": "すると、誰かが向こうから歩いてくる。",
      "notes": "（操夢）すると、誰かが向こうから歩いてくる。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、ダレカガムコウカラアルイテクル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
