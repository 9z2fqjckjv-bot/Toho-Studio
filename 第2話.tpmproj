    {
      "slide_index": 4,
      "text": "「おや、こんにちは、操夢さん。」私は、そう彼に話しかける。",
      "notes": "（にとり）「おや、こんにちは、操夢さん。」私は、そう彼に話しかける。",
      "character": "にとり",
      "voice": "jgr",
      "speed": 105,
      "pitch": 105,
      "phonemes": "オヤ、コンニチワ、ソームサン。ワタシワ、ソウカレニハナシカケル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
