    {
      "slide_index": 2,
      "text": "僕は、博麗神社から西の方角に向けて、林道を歩く。",
      "notes": "（操夢）僕は、博麗神社から西の方角に向けて、林道を歩く。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ハクレイジンジャカラニシノホウガクニムケテ、リンドウオアルク。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
