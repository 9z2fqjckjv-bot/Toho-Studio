  },
  "settings": {
    "padding_delay": 0.5,
    "auto_backup_enabled": true,
    "auto_backup_interval_min": 10,
    "quality_enhance": true,
    "effect": "none"
  },
  "scenes": [
    {
      "slide_index": 1,
      "text": "僕は、ふと、どこからか懐かしい声が聞こえ、\n森林に挟まれた道路を歩き進める…",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フト、ドコカラカナツカシイコエガキコエ、。シンリンニハサマレタドウロオアルキススメル",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 7.143061224489796,
      "audio_file": "slide_001.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.001.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": false,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_001.wav"
    },
    {
      "slide_index": 2,
      "text": "そして、歩き進むうちに、その声は大きくなっていく。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、アルキススムウチニ、ソノコエワオオキクナッテイク。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 4.279251700680272,
      "audio_file": "slide_002.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.002.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_002.wav"
    },
    {
      "slide_index": 3,
      "text": "「早く…こっちに…来て。」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ハヤクコッチニキテ。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 1.3945124716553288,
      "audio_file": "slide_003.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.003.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_003.wav"
    },
    {
      "slide_index": 4,
      "text": "僕は、その声に急かされて、早く歩く。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ソノコエニセカサレテ、ハヤクアルク。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 3.3920861678004535,
      "audio_file": "slide_004.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.004.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_004.wav"
    },
    {
      "slide_index": 5,
      "text": "「ほら、もっと早く！」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ホラ、モットハヤク",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 1.5845124716553287,
      "audio_file": "slide_005.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.005.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_005.wav"
    },
    {
      "slide_index": 6,
      "text": "僕は、だんだんと走り始める。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ダンダントハシリハジメル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 2.471972789115646,
      "audio_file": "slide_006.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.006.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": false,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_006.wav"
    },
    {
      "slide_index": 7,
      "text": "だが、僕は、彼女を視界に捉えると、何かにつまづき、転ぶ。そして、頭を打つような形で、倒れ、気絶した。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ダガ、ボクワ、カノジョオシカイニトラエルト、ナニカニツマズキ、コロブ。ソシテ、アタマオウツヨウナカタチデ、タオレ、キゼツシタ。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 10.328480725623583,
      "audio_file": "slide_007.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.007.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/倒れる.mp3",
      "se_offset": 5,
      "no_voice": false,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_007.wav"
    },
    {
      "slide_index": 8,
      "text": "@zuyasi　東方Project二次創作作品",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "エーエスアイトーホープロジェクトニジソウサクサクヒン",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 0,
      "audio_file": "slide_008.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.008.jpeg",
      "is_enabled": false,
      "no_voice": true,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 9,
      "text": "僕は、ふと目が覚めると、そこは自分の部屋だった。\n「さっきの彼女の声は…夢か…」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フトメガサメルト、ソコワジブンノヘヤダッタ。サッキノカノジョノコエワユメカ",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 6.5167573696145125,
      "audio_file": "slide_009.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.009.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_009.wav"
    },
    {
      "slide_index": 10,
      "text": "僕は、そんなことを言いながら、部屋から出る。\nそして、リビングに向かう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ソンナコトオイイナガラ、ヘヤカラデル。ソシテ、リビングニムカウ。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 5.7667573696145125,
      "audio_file": "slide_010.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.010.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_010.wav"
    },
    {
      "slide_index": 11,
      "text": "「おはよう、操夢。ちょうど朝ごはんができたわよ。」\n私はそう言いながら、座布団に座る。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "オハヨウ、ソーム。チョウドアサゴハンガデキタワヨ。ワタシワソウイイナガラ、ザブトンニスワル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 7.124512471655329,
      "audio_file": "slide_011.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.011.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_011.wav"
    },
    {
      "slide_index": 12,
      "text": "僕は、なんとなく座布団に座ると、彼女と共に手を合わせて、\nいつもの言葉を言って食べ始める。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ナントナクザブトンニスワルト、カノジョトトモニテオアワセテ、。イツモノコトバオイッテタベハジメル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 7.890657596371882,
      "audio_file": "slide_012.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.012.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_012.wav"
    },
    {
      "slide_index": 13,
      "text": "私は、彼の様子にどことなく違和感を感じ、尋ねる。\n「どうしたの、嫌な夢でも見たの？」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシワ、カレノヨウスニドコトナクイワカンオカンジ、タズネル。ドウシタノ、イヤナユメデモミタノ",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 7.462018140589569,
      "audio_file": "slide_013.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.013.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_013.wav"
    },
    {
      "slide_index": 14,
      "text": "「木々に挟まれた土の道を、ある懐かしい声に呼ばれて、\n歩く夢ですよ。でも、なんで懐かしいのだろう…？」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "キギニハサマレタツチノミチオ、アルナツカシイコエニヨバレテ、。アルクユメデスヨ。デモ、ナンデナツカシイノダロウ",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 8.820226757369614,
      "audio_file": "slide_014.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.014.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": false,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_014.wav"
    },
    {
      "slide_index": 15,
      "text": "「それくらいで、悩む必要はないわよ。」\n私は、内心、少し焦りながら、そう言い聞かせる。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソレクライデ、ナヤムヒツヨウワナイワヨ。ワタシワ、ナイシン、スコシアセリナガラ、ソウイイキカセル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 7.6545124716553286,
      "audio_file": "slide_015.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.015.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_015.wav"
    },
    {
      "slide_index": 16,
      "text": "すると、彼女は突如こっちに移動し、そっと僕に唇を付ける。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、カノジョワトツジョコッチニイドウシ、ソットボクニクチビルオツケル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 5.1236961451247165,
      "audio_file": "slide_016.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.016.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_016.wav"
    },
    {
      "slide_index": 17,
      "text": "「ほら、そんなこと考えなくても、私がいるじゃない。\nだから、そんなこと忘れて、ささっと朝ごはん食べましょ。」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ホラ、ソンナコトカンガエナクテモ、ワタシガイルジャナイ。ダカラ、ソンナコトワスレテ、ササットアサゴハンタベマショ。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 8.70451247165533,
      "audio_file": "slide_017.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.017.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_017.wav"
    },
    {
      "slide_index": 18,
      "text": "「そうですか…」僕は、彼女の言葉に従うことにして、\n朝ごはんを食べ進める。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカボクワ、カノジョノコトバニシタガウコトニシテ、。アサゴハンオタベススメル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 6.333061224489796,
      "audio_file": "slide_018.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.018.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_018.wav"
    },
    {
      "slide_index": 19,
      "text": "そして、自室に戻ってくると、ぼんやり部屋の外を眺める。\nここは神社で窓の外には参道が見える。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、ジシツニモドッテクルト、ボンヤリヘヤノソトオナガメル。ココワジンジャデマドノソトニワサンドウガミエル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 8.024897959183674,
      "audio_file": "slide_019.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.019.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_019.wav"
    },
    {
      "slide_index": 20,
      "text": "そして、ふと散歩がしたくなった僕は、そのまま部屋を出る。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、フトサンポガシタクナッタボクワ、ソノママヘヤオデル。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 4.503696145124716,
      "audio_file": "slide_020.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.020.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_020.wav"
    },
    {
      "slide_index": 21,
      "text": "そして、土間で草履を履くと、そのまま外に出る。\n外には新鮮な空気が広がっていた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、ドマデゾウリオハクト、ソノママソトニデル。ソトニワシンセンナクウキガヒロガッテイタ。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 7.074353741496599,
      "audio_file": "slide_021.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/第1話/第1話.021.jpeg",
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/第1話/slide_021.wav"
    },
    {
      "slide_index": 22,
      "text": "僕はそれから、この林道を歩き始めた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワソレカラ、コノリンドウオアルキハジメタ。",
      "extra_delay": 0.5,
      "transition_delay": 0.5,
      "audio_duration": 3.1490249433106574,
      "audio_file": "slide_022.wav",
