    },
    {
      "slide_index": 16,
      "text": "そして、彼が走ってきたのは、結界から離れた永遠亭だった。なぜ彼が、ここにきたのか、当時の私は分からなかった。",
      "notes": "（霊夢）そして、彼が走ってきたのは、結界から離れた永遠亭だった。なぜ彼が、ここにきたのか、当時の私は分からなかった。",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソシテ、カレガハシッテキタノワ、ケッカイカラハナレタエイエンテイダッタ。ナゼカレガ、ココニキタノカ、トウジノワタシワワカラナカッタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
