    {
      "slide_index": 13,
      "text": "私がふと目が覚めたとき…声をかけても反応がなく、地面に倒れている母と彼がいた。",
      "notes": "（霊夢）私がふと目が覚めたとき…声をかけても反応がなく、地面に倒れている母と彼がいた。",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシガフトメガサメタトキ、コエオカケテモハンノウガナク、ジメンニタオレテイルハハトカレガイタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
