      "no_voice": false,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第4話/slide_009.wav"
    },
    {
      "slide_index": 10,
      "text": "すると、あたりが急に暗くなり、私は、怖気付き、彼から離れる。",
      "notes": "（霊夢）すると、あたりが急に暗くなり、私は、怖気付き、彼から離れる。",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "スルト、アタリガキュウニクラクナリ、ワタシワ、オジケズキ、カレカラハナレル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
