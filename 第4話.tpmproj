      "no_voice": false,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第4話/slide_010.wav"
    },
    {
      "slide_index": 11,
      "text": "そして、彼が再び目覚めると、私は、誰かに抱き上げられる。",
      "notes": "（霊夢）そして、彼が再び目覚めると、私は、誰かに抱き上げられる。",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソシテ、カレガフタタビメザメルト、ワタシワ、ダレカニダキアゲラレル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
