      "_cacheBuster": 1787916321308,
      "sound_effects": []
    },
    {
      "slide_index": 12,
      "text": "私を抱き上げた、その人…母の手が私の首筋にあたり、そのまま私は視界が暗転する。",
      "notes": "（霊夢）私を抱き上げた、その人…母の手が私の首筋にあたり、そのまま私は視界が暗転する。",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシオダキアゲタ、ソノヒトハハノテガワタシノクビスジニアタリ、ソノママワタシワシカイガアンテンスル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
