      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 18,
      "text": "「もし、あなたがかれにしかえすのなら、べつにはんたいはしないわ。ただじゅうごねんまえのじてんで、そのちからだということをふまえるべきね。」",
      "notes": "（紫）「もし、あなたがかれにしかえすのなら、べつにはんたいはしないわ。ただじゅうごねんまえのじてんで、そのちからだということをふまえるべきね。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "モシ、アナタガカレニシカエスノナラ、ベツニハンタイワシナイワ。タダジュウゴネンマエノジテンデ、ソノチカラダトイウコトオフマエルベキネ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
