    },
    {
      "slide_index": 16,
      "text": "「これで、なっとくしたかしら。」",
      "notes": "（紫）「これで、なっとくしたかしら。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "コレデ、ナットクシタカシラ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
