      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 21,
      "text": "「もしあなたがかてば、かれとあなたのかこやそのじじつは、やみにほうむりましょう。そうすれば、なにもしんぱいしなくていいわよ。」",
      "notes": "（紫）「もしあなたがかてば、かれとあなたのかこやそのじじつは、やみにほうむりましょう。そうすれば、なにもしんぱいしなくていいわよ。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "モシアナタガカテバ、カレトアナタノカコヤソノジジツハ、ヤミニホウムリマショウ。ソウスレバ、ナニモシンパイシナクテイイワヨ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
