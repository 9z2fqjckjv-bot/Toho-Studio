      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 22,
      "text": "「ただし、かれにしかえしをするなら、あなたにはよほどのかくごがないと、いけないわよ。それでも、あなたはしかえしをえらぶのかしら？」",
      "notes": "（紫）「ただし、かれにしかえしをするなら、あなたにはよほどのかくごがないと、いけないわよ。それでも、あなたはしかえしをえらぶのかしら？」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "タダシ、カレニシカエシオスルナラ、アナタニワヨホドノカクゴガナイト、イケナイワヨ。ソレデモ、アナタワシカエシオエラブノカシラ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
