    {
      "slide_index": 2,
      "text": "「そろそろ、あなたにもはなすころあいかしら…」",
      "notes": "（紫）「そろそろ、あなたにもはなすころあいかしら…」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
