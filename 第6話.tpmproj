        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 10.228253968253968,
      "audio_file": "slide_018.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.018.jpeg",
      "video_clip_path": null,
      "animation_path": null,
