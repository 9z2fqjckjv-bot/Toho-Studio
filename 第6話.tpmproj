      "sound_effects": []
    },
    {
      "slide_index": 24,
      "text": "「さて、あなたのはんだんをきかせてくれるかしら？」",
      "notes": "（紫）「さて、あなたのはんだんをきかせてくれるかしら？」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "サテ、アナタノハンダンオキカセテクレルカシラ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
