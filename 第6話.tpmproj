      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 20,
      "text": "「あとほそくしておくとしたら、このじじつはわたしとまほうつかいのさんにん、こうまかんのじゅうにん、あやといったかぎられたひとしかしらないことね…。」",
      "notes": "（紫）「あとほそくしておくとしたら、このじじつはわたしとまほうつかいのさんにん、こうまかんのじゅうにん、あやといったかぎられたひとしかしらないことね…。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "アトホソクシテオクトシタラ、コノジジツハワタシトマホウツカイノサンニン、コウマカンノジュウニン、アヤトイッタカギラレタヒトシカシラナイコトネ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
