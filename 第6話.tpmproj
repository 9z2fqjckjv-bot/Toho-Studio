      "sound_effects": []
    },
    {
      "slide_index": 3,
      "text": "「何の話があるの？」",
      "notes": "（霊夢）「何の話があるの？」",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ナニノハナシガアルノ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
