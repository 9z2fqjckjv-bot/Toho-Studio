      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_018.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 19,
      "text": "「もし、あなたがかれにかてば、かれのあつかいはあなたにぜんめんてきにゆだねるわ。ただ、まけたばあいはさくやのいうとおりになるわね。」",
      "notes": "（紫）「もし、あなたがかれにかてば、かれのあつかいはあなたにぜんめんてきにゆだねるわ。ただ、まけたばあいはさくやのいうとおりになるわね。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "モシ、アナタガカレニカテバ、カレノアツカイワアナタニゼンメンテキニユダネルワ。タダ、マケタバアイワサクヤノイウトオリニナルワネ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
