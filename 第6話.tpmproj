    {
      "slide_index": 14,
      "text": "「そのさんじょうは、かれがまえいののうりょくをしゅつげんさせれば、みこにうちかつつよさを、ゆうするかのうせいをさししめしたの。」",
      "notes": "（紫）「そのさんじょうは、かれがまえいののうりょくをしゅつげんさせれば、みこにうちかつつよさを、ゆうするかのうせいをさししめした。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソノサンジョウハ、カレガマエイノノウリョクヲシュツゲンサセレバ、ミコニウチカツツヨサオ、ユウスルカノウセイオサシシメシタノ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
