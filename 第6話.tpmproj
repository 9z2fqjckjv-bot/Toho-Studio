      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 4,
      "text": "「あのひのことを、きくかくごはあるかしら？」",
      "notes": "（紫）「あのひのことを、きくかくごはあるかしら？」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "アノヒノコトオ、キクカクゴワアルカシラ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 2.9826303854875285,
      "audio_file": "slide_004.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.004.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_004.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 5,
      "text": "「、かれが、げんそうきょうにきたひのこと、。だいじょうぶよ。」",
      "notes": "（霊夢）「、かれが、げんそうきょうにきたひのこと、。だいじょうぶよ。」",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "カレガ、ゲンソウキョウニキタヒノコト、。ダイジョウブヨ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 4.304512471655329,
      "audio_file": "slide_005.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.005.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_005.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 6,
      "text": "「じゃあ、あのひのじじつをはなしはじめるわね。」",
      "notes": "（紫）「じゃあ、あのひのじじつをはなしはじめるわね。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ジャア、アノヒノジジツオハナシハジメルワネ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.2057596371882084,
      "audio_file": "slide_006.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.006.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_006.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 7,
      "text": "「そのひ、わたしはいつもどおりすきまからげんそうきょうとけっかいをみわたしていた。そして、ふとそとのせかいのようすをのぞこうとしたの。」",
      "notes": "（紫）「そのひ、わたしはいつもどおりすきまからげんそうきょうとけっかいをみわたしていた。そして、ふとそとのせかいのようすをのぞこうとしたの。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソノヒ、ワタシワイツモドオリスキマカラゲンソウキョウトケッカイオミワタシテイタ。ソシテ、フトソトノセカイノヨウスオノゾコウトシタノ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 10.0837641723356,
      "audio_file": "slide_007.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.007.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_007.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 8,
      "text": "「だけども、そとのせかいをのぞくために、すきまをひらこうとしても、ひらけないじょうたいだった。そとのせかいのようすはみれなかったの。」",
      "notes": "（紫）「だけども、そとのせかいをのぞくために、すきまをひらこうとしても、ひらけないじょうたいだった。そとのせかいのようすはみれなかったの。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ダケドモ、ソトノセカイオノゾクタメニ、スキマオヒラコウトシテモ、ヒラケナイジョウタイダッタ。ソトノセカイノヨウスワミレナカッタノ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 10.253378684807256,
      "audio_file": "slide_008.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.008.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_008.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 9,
      "text": "「それで、しかたなく、けっかいふきんをのぞいたの。」",
      "notes": "（紫）「それで、しかたなく、けっかいふきんをのぞいたの。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソレデ、シカタナク、ケッカイフキンオノゾイタノ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.833265306122449,
      "audio_file": "slide_009.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.009.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_009.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 10,
      "text": "「するとそこには、ねているあなたとかれ、そしてふくがびりびりになってしまった、とうじのはくれいじんじゃのみこだったかのじょがいたの。」",
      "notes": "（紫）「するとそこには、ねているあなたとかれ、そしてふくがびりびりになってしまった、とうじのはくれいじんじゃのみこだったかのじょがいたの。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "スルトソコニワ、ネテイルアナタトカレ、ソシテフクガビリビリニナッテシマッタ、トウジノワクレイジンジャノミコダッタカノジョガイタノ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 9.418253968253968,
      "audio_file": "slide_010.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.010.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_010.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 11,
      "text": "「そして、かのじょはきずだらけのじょうたいで、わたしにこうつげたの。『わたしのまなむすめに、かれのめんどうをみさせてください』ってね。」",
      "notes": "（紫）「そして、かのじょはきずだらけのじょうたいで、わたしにこうつげたの。『わたしのまなむすめに、かれのめんどうをみさせてください』ってね。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソシテ、カノジョハキズダラケノジョウタイデ、ワタシニコウツゲタノ。ワタシノマナムスメニ、カレノメンドウオミサセテクダサイッテネ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 10.010385487528344,
      "audio_file": "slide_011.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.011.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_011.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 12,
      "text": "「そして、かのじょは『もはやきずついた、このからだをしゅうふくするのはておくれだ』といい、そのままじめんにうつぶせになったの。」",
      "notes": "（紫）「そして、かのじょは『もはやきずついた、このからだをしゅうふくするのはておくれだ』といい、そのままじめんにうつぶせになったの。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソシテ、カノジョハモハヤキズツイタ、コノカラダオシュウフクスルノハテオクレダトイイ、ソノママジメンニウツブセニナッタノ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 8.868140589569162,
      "audio_file": "slide_012.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第6話/第6話.012.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第6話/slide_012.wav",
      "_cacheBuster": 1788052678317,
      "sound_effects": []
    },
    {
      "slide_index": 13,
      "text": "「そして、わたしはかのじょがさいごをさとったのだとしり、わたしは、あなたにかのじょのゆいごんをつたえるやくめをせおうことになった。」",
      "notes": "（紫）「そして、わたしはかのじょがさいごをさとったのだとしり、わたしは、あなたにかのじょのゆいごんをつたえるやくめをせおうことになった。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソシテ、ワタシワカノジョガサイゴヲサトッタノダトシリ、ワタシワ、アナタニカノジョノユイゴンヲツタエルヤクメヲセオウコトニナッタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
