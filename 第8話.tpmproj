    },
    {
      "slide_index": 2,
      "text": "ぼくたちが、そとにでると、へやにいたはずのあやが、らいたーふくからふだんぎにきがえたじょうたいで、そとにでてきた。",
      "notes": "（操夢）ぼくたちが、そとにでると、へやにいたはずのあやが、らいたーふくからふだんぎにきがえたじょうたいで、そとにでてきた。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクタチガ、ソトニデルト、ヘヤニイタハズノアヤガ、ライターフクカラフダンギニキガエタジョウタイデ、ソトニデテキタ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 8.37392290249433,
      "audio_file": "slide_002.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.002.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 3,
      "text": "「それで、おふたりさんは、これからなにをするのですか？」",
      "notes": "（文）「それで、おふたりさんは、これからなにをするのですか？」",
      "character": "文",
      "voice": "f2",
      "speed": 100,
      "pitch": 125,
      "phonemes": "ソレデ、オフタリサンワ、コレカラナニオスルノデスカ",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.834104308390023,
      "audio_file": "slide_003.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.003.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 4,
      "text": "「かれとともにひとざとで、じんじゃのせんでんをしようとおもいまして。」",
      "notes": "（早苗）「かれとともにひとざとで、じんじゃのせんでんをしようとおもいまして。」",
      "character": "早苗",
      "voice": "f1",
      "speed": 130,
      "pitch": 95,
      "phonemes": "カレトトモニヒトザトデ、ジンジャノセンデンヲシヨウトオモイマシテ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.313174603174603,
      "audio_file": "slide_004.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.004.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 5,
      "text": "「そうですか、それでそうむさんはどうします？」",
      "notes": "（文）「そうですか、それでそうむさんはどうします？」",
      "character": "文",
      "voice": "f2",
      "speed": 100,
      "pitch": 125,
      "phonemes": "ソウデスカ、ソレデソウムサンワドウシマス",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.0087074829931972,
      "audio_file": "slide_005.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.005.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 6,
      "text": "ぼくは、ふたりのじょせいからのしせんにとまどってしまう。「えっと。」",
      "notes": "（操夢）ぼくは、ふたりのじょせいからのしせんにとまどってしまう。「えっと。」",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フタリノジョセイカラノシセンニトマドッテシマウ。エット。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 4.726848072562358,
      "audio_file": "slide_006.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.006.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 7,
      "text": "ぼくは、ふとじぶんがまだおさなかったころのことをおもいだす。このときもぼくはにたようなことをきかれた。",
      "notes": "（操夢）ぼくは、ふとじぶんがまだおさなかったころのことをおもいだす。このときもぼくはにたようなことをきかれた。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フトジブンガマダオサナカッタコロノコトオオモイダス。コノトキモボクワニタヨウナコトオキカレタ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 7.432517006802721,
      "audio_file": "slide_007.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.007.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 8,
      "text": "「ぼくは。」ぼくは、そのことばのさきをいおうとする。すると、だれかがそらからやってきた。",
      "notes": "（操夢）「ぼくは。」ぼくは、そのことばのさきをいおうとする。すると、だれかがそらからやってきた。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ。ボクワ、ソノコトバノサキオイオウトスル。スルト、ダレカガソラカラヤッテキタ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 6.976961451247165,
      "audio_file": "slide_008.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.008.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 9,
      "text": "「おい、そうむ、だいじょうぶか。」わたしは、そうかれにきく。",
      "notes": "（魔理沙）「おい、そうむ、だいじょうぶか。」わたしは、そうかれにきく。",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "オイ、ソウム、ダイジョウブカ。ワタシワ、ソウカレニキク。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 4.677006802721088,
      "audio_file": "slide_009.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.009.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 10,
      "text": "「まりささん…」ぼくはそうことばをいいかけると、あるきおくがよみがえる。",
      "notes": "（操夢）「まりささん…」ぼくはそうことばをいいかけると、あるきおくがよみがえる。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "マリササンボクワソウコトバオイイカケルト、アルキオクガヨミガエル。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 4.360997732426304,
      "audio_file": "slide_010.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.010.jpeg",
      "video_clip_path": null,
      "animation_path": null,
