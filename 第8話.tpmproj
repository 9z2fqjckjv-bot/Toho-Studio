      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 26,
      "text": "「ぶじにおわったみたいでよかったわ。それであなたのさくせんについておしえてちょうだい。」",
      "notes": "（パチュリー）「ぶじにおわったみたいでよかったわ。それであなたのさくせんについておしえてちょうだい。」",
      "character": "パチュリー",
      "voice": "f2",
      "speed": 120,
      "pitch": 115,
      "phonemes": "ブジニオワッタミタイデヨカッタワ。ソレデアナタノサクセンニツイテオシエテチョウダイ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
