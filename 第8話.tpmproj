      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 13,
      "text": "「はい、むかしにも、れいむさんとまりささんにどっちをえらぶか、きかれてたことをおもいだしたので、。」",
      "notes": "（操夢）「はい、むかしにも、れいむさんとまりささんにどっちをえらぶか、きかれてたことをおもいだしたので、。」",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ハイ、ムカシニモ、レイムサントマリササンニドッチオエラブカ、キカレテタコトオオモイダシタノデ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
