      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 11,
      "text": "あのときは、ぼくはどちらにするか、なやんでいるうちに、はっとめをさますと、そこはじんじゃのえんがわで、めになみだをうかべたふたりがいた。",
      "notes": "（操夢）あのときは、ぼくはどちらにするか、なやんでいるうちに、はっとめをさますと、そこはじんじゃのえんがわで、めになみだをうかべたふたりがいた。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "アノトキワ、ボクワドチラニスルカ、ナヤンデイルウチニ、ハットメオサマスト、ソコハジンジャノエンガワデ、メニナミダオウカベタフタリガイタ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 9.896961451247165,
      "audio_file": "slide_011.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第8話/第8話.011.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0.0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 12,
      "text": "「どうした、むかしのことでも、おもいだしたのか。」わたしがめになみだをうかばせながら、かれにそうきく。",
      "notes": "（魔理沙）「どうした、むかしのことでも、おもいだしたのか。」わたしがめになみだをうかばせながら、かれにそうきく。",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ドウシタ、ムカシノコトデモ、オモイダシタノカ。ワタシガメニナミダオウカバセナガラ、カレニソウキク。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "builds": [],
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "builds": [],
        "images": [],
