    {
      "slide_index": 23,
      "text": "「かれを、もりやじんじゃでみつけて、れいむにひきわたした。」",
      "notes": "（魔理沙）「かれを、もりやじんじゃでみつけて、れいむにひきわたした。」",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "カレオ、モリヤジンジャデミツケテ、レイムニヒキワタシタ。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
