    {
      "slide_index": 21,
      "text": "わたしが、こうまかんのとしょかんにもどると、ぱちゅりーがこえをかける。",
      "notes": "（魔理沙）わたしが、こうまかんのとしょかんにもどると、ぱちゅりーがこえをかける。",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシガ、コウマカンノトショカンニモドルト、パチュリーガコエオカケル。",
      "extra_delay": 0.0,
      "transition_delay": 0.5,
      "transition_duration": 1.0,
