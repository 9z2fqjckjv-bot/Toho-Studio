  "settings": {
    "padding_delay": 0.5,
    "auto_backup_enabled": true,
    "auto_backup_interval_min": 10,
    "quality_enhance": true,
    "effect": "none"
  },
  "scenes": [
    {
      "slide_index": 1,
      "text": "東方Project二次創作 powerd by zuyasi※ニコニコ版とは内容が異なります。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "トウホウピーアールオージェーイーシーティーニジソウサク ピーオーダブリューイーアールディー ビーワイ ゼットユーワイエーエスアイニコニコバントワナイヨウガコトナリマス。",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_001.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.001.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": true,
      "audio_path": null
    },
    {
      "slide_index": 2,
      "text": "「んっ…」\n僕は、ふと誰かの視線を感じ、目が覚める。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ンッ。ボクワ、フトダレカノシセンオカンジ、メガサメル。",
      "extra_delay": 5.010000228882,
      "transition_delay": 5.010000228882,
      "audio_duration": 4.509569160997732,
      "audio_file": "slide_002.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.002.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_002.wav"
    },
    {
      "slide_index": 3,
      "text": "そして、ふと上半身を起こして、そちらを向くと、\nレミリアとフランが怖い笑みを浮かべていた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、フトジョウハンシンオオコシテ、ソチラオムクト、。レミリアトフランガコワイエミオウカベテイタ。",
      "extra_delay": 7.739999771118,
      "transition_delay": 7.739999771118,
      "audio_duration": 7.240884353741497,
      "audio_file": "slide_003.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.003.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_003.wav"
    },
    {
      "slide_index": 4,
      "text": "「あら、目が覚めたの。」私はそういうと、\n素早くベッドに乗り、彼の耳のそばに勢いよく、手をつく。",
      "notes": "",
      "character": "レミリア",
      "voice": "f1",
      "speed": 80,
      "pitch": 150,
      "phonemes": "アラ、メガサメタノ。ワタシワソウイウト、。スバヤクベッドニノリ、カレノミミノソバニイキオイヨク、テオツク。",
      "extra_delay": 11.310000419617,
      "transition_delay": 11.310000419617,
      "audio_duration": 10.809931972789116,
      "audio_file": "slide_004.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.004.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/軽いパンチ1.mp3",
      "se_offset": 9,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_004.wav"
    },
    {
      "slide_index": 5,
      "text": "「あなた、あの泥棒記者と夜中まで仲良くしてたみたいね。\nその理由を聞かせてくれるかしら…？」",
      "notes": "",
      "character": "レミリア",
      "voice": "f1",
      "speed": 80,
      "pitch": 150,
      "phonemes": "アナタ、アノドロボウキシャトヨナカマデナカヨクシテタミタイネ。ソノリユウオキカセテクレルカシラ",
      "extra_delay": 9.090000152588,
      "transition_delay": 9.090000152588,
      "audio_duration": 8.616757369614513,
      "audio_file": "slide_005.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.005.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_005.wav"
    },
    {
      "slide_index": 6,
      "text": "僕は、彼女を眺めると同時に、思考を巡らせて、この場を鎮める方法を考える。だが、恐怖の笑みで何も思いつかない…。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、カノジョオナガメルトドウジニ、シコウオメグラセテ、コノバオシズメルホウホウオカンガエル。ダガ、キョウフノエミデナニモオモイツカナイ。",
      "extra_delay": 10.539999961853,
      "transition_delay": 10.539999961853,
      "audio_duration": 10.04,
      "audio_file": "slide_006.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.006.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_006.wav"
    },
    {
      "slide_index": 7,
      "text": "仕方なく、僕は覚悟の上で昨晩のことを話す。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "シカタナク、ボクワカクゴノウエデサクバンノコトオハナス。",
      "extra_delay": 4.510000228882,
      "transition_delay": 4.510000228882,
      "audio_duration": 4.0055555555555555,
      "audio_file": "slide_007.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.007.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_007.wav"
    },
    {
      "slide_index": 8,
      "text": "「そう、ならお仕置きね。フラン、準備はいいかしら？」",
      "notes": "",
      "character": "レミリア",
      "voice": "f1",
      "speed": 80,
      "pitch": 150,
      "phonemes": "ソウ、ナラオシオキネ。フラン、ジュンビワイイカシラ",
      "extra_delay": 5.519999980927,
      "transition_delay": 5.519999980927,
      "audio_duration": 5.022675736961451,
      "audio_file": "slide_008.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.008.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_008.wav"
    },
    {
      "slide_index": 9,
      "text": "「準備は万端だよ、お姉様。」\n私はそう言いながら、ベッドに入り、彼の上にまたがる。",
      "notes": "",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ジュンビワバンタンダヨ、オネーサマ。ワタシワソウイイナガラ、ベッドニハイリ、カレノウエニマタガル。",
      "extra_delay": 7.659999847412,
      "transition_delay": 7.659999847412,
      "audio_duration": 7.162018140589569,
      "audio_file": "slide_009.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.009.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/衣擦れ1.mp3",
      "se_offset": 6,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_009.wav"
    },
    {
      "slide_index": 10,
      "text": "「なら、始めるわよ、フラン。」",
      "notes": "",
      "character": "レミリア",
      "voice": "f1",
      "speed": 80,
      "pitch": 150,
      "phonemes": "ナラ、ハジメルワヨ、フラン。",
      "extra_delay": 3.289999961853,
      "transition_delay": 3.289999961853,
      "audio_duration": 2.7866666666666666,
      "audio_file": "slide_010.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.010.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_010.wav"
    },
    {
      "slide_index": 11,
      "text": "「じゃあ、始めるね、お仕置きを…」\n私たちはそういって、彼にお仕置きを始めた。",
      "notes": "",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ジャア、ハジメルネ、オシオキオ。ワタシタチワソウイッテ、カレニオシオキオハジメタ。",
      "extra_delay": 6.80999994278,
      "transition_delay": 6.80999994278,
      "audio_duration": 6.313265306122449,
      "audio_file": "slide_011.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.011.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_011.wav"
    },
    {
      "slide_index": 12,
      "text": "お仕置きシーンはニコニコ動画で！",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "オシオキシーンワニコニコドウガデ",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_012.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.012.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 13,
      "text": "二人のお仕置きが終わると…",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ニニンノオシオキガオワルト",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_013.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.013.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 14,
      "text": "それから僕は、コスト（精子の量）とタイム（お仕置きの時間）を必要最小限に抑え込む工夫をすると、立場が逆転した。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソレカラボクワ、コストセイシノリョウトタイムオシオキノジカンオヒツヨウサイショウゲンニオサエコムクフウオスルト、タチバガギャクテンシタ。",
      "extra_delay": 9.329999923706,
      "transition_delay": 9.329999923706,
      "audio_duration": 8.825668934240364,
      "audio_file": "slide_014.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.014.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 1.1,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_014.wav"
    },
    {
      "slide_index": 15,
      "text": "「ふぅ…」僕は、二人が起きないように小さく息を吐く。\nそして、二人の合間を縫って、ベッドから降りる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "フーボクワ、フタリガオキナイヨウニチイサクイキオハク。ソシテ、フタリノアイマオヌッテ、ベッドカラオリル。",
      "extra_delay": 8.229999542236,
      "transition_delay": 8.229999542236,
      "audio_duration": 7.733061224489796,
      "audio_file": "slide_015.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.015.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_015.wav"
    },
    {
      "slide_index": 16,
      "text": "そして、これからすべきことを考え、PCの電源を押す。\nだが、うまく起動しないので、親機がある部屋に向かう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、コレカラスベキコトオカンガエ、ピーシーノデンゲンオオス。ダガ、ウマクキドウシナイノデ、オヤキガアルヘヤニムカウ。",
      "extra_delay": 9.520000457764,
      "transition_delay": 9.520000457764,
      "audio_duration": 9.017732426303855,
      "audio_file": "slide_016.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.016.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_016.wav"
    },
    {
      "slide_index": 17,
      "text": "そして、親機のある部屋に入ると、先ほど借りてきたレミリアのポケベルを床に置き、早速電源を押す。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、オヤキノアルヘヤニハイルト、サキホドカリテキタレミリアノポケベルオユカニオキ、サッソクデンゲンオオス。",
      "extra_delay": 8.329999923706,
      "transition_delay": 8.329999923706,
      "audio_duration": 7.834149659863946,
      "audio_file": "slide_017.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.017.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_017.wav"
    },
    {
      "slide_index": 18,
      "text": "そして、ポケベルのアイコンにカーソルを合わせてクリックする。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、ポケベルノアイコンニカーソルオアワセテクリックスル。",
      "extra_delay": 4.530000209808,
      "transition_delay": 4.530000209808,
      "audio_duration": 4.034353741496599,
      "audio_file": "slide_018.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.018.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/キーボード1.mp3",
      "se_offset": 3,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_018.wav"
    },
    {
      "slide_index": 19,
      "text": "すると、前に１度だけみたWebページが開く。\nそして僕は、操作にカーソルを合わせる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、マエニイチドダケミタウーブページガヒラク。ソシテボクワ、ソウサニカーソルオアワセル。",
      "extra_delay": 7.090000152588,
      "transition_delay": 7.090000152588,
      "audio_duration": 6.89578231292517,
      "audio_file": "slide_019.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.019.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_019.wav"
    },
    {
      "slide_index": 20,
      "text": "次に発信にカーソルを合わせて選択する。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ツギニハッシンニカーソルオアワセテセンタクスル。",
      "extra_delay": 3.549999952316,
      "transition_delay": 3.549999952316,
      "audio_duration": 3.053605442176871,
      "audio_file": "slide_020.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.020.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_020.wav"
    },
    {
      "slide_index": 21,
      "text": "次に霊夢にカーソルを合わせる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ツギニレームニカーソルオアワセル。",
      "extra_delay": 2.569999933243,
      "transition_delay": 2.569999933243,
      "audio_duration": 2.065011337868481,
      "audio_file": "slide_021.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.021.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_021.wav"
    },
    {
      "slide_index": 22,
      "text": "すると、「博麗霊夢に発信中…」と表示される。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、ハクレイレームニハッシンチュウトヒョウジサレル。",
      "extra_delay": 4.030000209808,
      "transition_delay": 4.030000209808,
      "audio_duration": 3.5277324263038548,
      "audio_file": "slide_022.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.022.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_022.wav"
    },
    {
      "slide_index": 23,
      "text": "私は、ふとポケベルの振動を感じ、ポッケから出すと、レミリアからの着信だった。そして、オレンジ色のボタンを押す。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシワ、フトポケベルノシンドウオカンジ、ポッケカラダスト、レミリアカラノチャクシンダッタ。ソシテ、オレンジイロノボタンオオス。",
      "extra_delay": 10.170000076294,
      "transition_delay": 10.170000076294,
      "audio_duration": 9.55326530612245,
      "audio_file": "slide_023.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.023.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_023.wav"
    },
    {
      "slide_index": 24,
      "text": "「もしもし、霊夢さん、聞こえますか？」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "モシモシ、レームサン、キコエマスカ",
      "extra_delay": 3.380000114441,
      "transition_delay": 3.380000114441,
      "audio_duration": 2.877845804988662,
      "audio_file": "slide_024.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.024.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_024.wav"
    },
    {
      "slide_index": 25,
      "text": "「この声は、操夢？なんで、操夢がレミリアのポケベルを持ってるの？今どこにいるの？」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "コノコエワ、ソーム、ナンデ、ソームガレミリアノポケベルオモッテルノ、イマドコニイルノ",
      "extra_delay": 6.070000171661,
      "transition_delay": 6.070000171661,
      "audio_duration": 6.332018140589569,
      "audio_file": "slide_025.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.025.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_025.wav"
    },
    {
      "slide_index": 26,
      "text": "僕は、そう聞く霊夢に対して、すこし記憶が戻り、島唄居酒屋のところから、今朝までの経緯を話す。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ソウキクレームニタイシテ、スコシキオクガモドリ、シマウタイザカヤノトコロカラ、ケサマデノケイイオハナス。",
      "extra_delay": 8.770000457764,
      "transition_delay": 8.770000457764,
      "audio_duration": 8.273174603174603,
      "audio_file": "slide_026.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.026.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_026.wav"
    },
    {
      "slide_index": 27,
      "text": "「え？そういうことは、私たちの家にいるの？」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "エソウイウコトワ、ワタシタチノイエニイルノ",
      "extra_delay": 3.47000002861,
      "transition_delay": 3.47000002861,
      "audio_duration": 2.974512471655329,
      "audio_file": "slide_027.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.027.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_027.wav"
    },
    {
      "slide_index": 28,
      "text": "「そうです。それで、さっきまでレミリアとフランさんに…」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデス。ソレデ、サッキマデレミリアトフランサンニ",
      "extra_delay": 4.55999994278,
      "transition_delay": 4.55999994278,
      "audio_duration": 4.064897959183673,
      "audio_file": "slide_028.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.028.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_028.wav"
    },
    {
      "slide_index": 29,
      "text": "私は、彼のその発言に衝撃を受ける…\n「操夢、私たちが帰ったらみっちり、お仕置きね…」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシワ、カレノソノハツゲンニショウゲキオウケル。ソーム、ワタシタチガカエッタラミッチリ、オシオキネ",
      "extra_delay": 8.220000267029,
      "transition_delay": 8.220000267029,
      "audio_duration": 7.72201814058957,
      "audio_file": "slide_029.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.029.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_029.wav"
    },
    {
      "slide_index": 30,
      "text": "「えっと…はい…それで、いつごろこっちに戻りますか？」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "エットハイソレデ、イツゴロコッチニモドリマスカ",
      "extra_delay": 3.829999923706,
      "transition_delay": 3.829999923706,
      "audio_duration": 3.329251700680272,
      "audio_file": "slide_030.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.030.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_030.wav"
    },
    {
      "slide_index": 31,
      "text": "「とりあえず、魔理沙たちを呼んで、今すぐそっちに行けるようにするから、待ってなさい。レミリアにポケベルも返すのよ。」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "トリアエズ、マリサタチオヨンデ、イマスグソッチニイケルヨウニスルカラ、マッテナサイ。レミリアニポケベルモカエスノヨ。",
      "extra_delay": 9.079999923706,
      "transition_delay": 9.079999923706,
      "audio_duration": 8.584512471655328,
      "audio_file": "slide_031.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.031.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_031.wav"
    },
    {
      "slide_index": 32,
      "text": "「分かりました。」\n僕はそういうと、通話を終了のボタンを選択した。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ワカリマシタ。ボクワソウイウト、ツウワオシュウリョウノボタンオセンタクシタ。",
      "extra_delay": 5.769999980927,
      "transition_delay": 5.769999980927,
      "audio_duration": 5.272834467120181,
      "audio_file": "slide_032.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.032.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/キーボード1.mp3",
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_032.wav"
    },
    {
      "slide_index": 33,
      "text": "僕はふと気がつくと、レミリアとフランの二人が部屋に入ってきた。だが、なんとなく二人の様子に違和感を覚える。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワフトキガツクト、レミリアトフランノフタリガヘヤニハイッテキタ。ダガ、ナントナクフタリノヨウスニイワカンオオボエル。",
      "extra_delay": 9.180000305176,
      "transition_delay": 9.180000305176,
      "audio_duration": 8.707619047619048,
      "audio_file": "slide_033.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.033.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_033.wav"
    },
    {
      "slide_index": 34,
      "text": "「ねぇ、操夢…、もう一回私を…いい気持ちにして…」",
      "notes": "",
      "character": "レミリア",
      "voice": "f1",
      "speed": 80,
      "pitch": 150,
      "phonemes": "ネー。ソーム。モウイッカイワタシオ。イイキモチニシテ",
      "extra_delay": 4.25,
      "transition_delay": 4.25,
      "audio_duration": 6.004421768707483,
      "audio_file": "slide_034.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.034.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_034.wav"
    },
    {
      "slide_index": 35,
      "text": "「私も…お願い…操夢…」",
      "notes": "",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシモ。オネガイ。ソーム",
      "extra_delay": 2.05999994278,
      "transition_delay": 2.05999994278,
      "audio_duration": 2.7870068027210886,
      "audio_file": "slide_035.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.035.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_035.wav"
    },
    {
      "slide_index": 36,
      "text": "僕は、二人の表情から何が起きたのかを分析すると、ある予測と傾向が浮かび上がる。それは、警告でもあった。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フタリノヒョウジョウカラナニガオキタノカオブンセキスルト、アルヨソクトケイコウガウカビアガル。ソレワ、ケイコクデモアッタ。",
      "extra_delay": 9.760000228882,
      "transition_delay": 9.760000228882,
      "audio_duration": 9.269138321995465,
      "audio_file": "slide_036.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.036.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_036.wav"
    },
    {
      "slide_index": 37,
      "text": "だが、僕は、何も言わずに、レミリアを抱き抱えると、自室のベッドに運び、フランも運び込んだ。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ダガ、ボクワ、ナニモイワズニ、レミリアオダキカカエルト、ジシツノベッドニハコビ、フランモハコビコンダ。",
      "extra_delay": 8.460000038147,
      "transition_delay": 8.460000038147,
      "audio_duration": 7.869251700680272,
      "audio_file": "slide_037.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.037.jpeg",
      "is_enabled": true,
      "is_skipped": false,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_037.wav"
    },
    {
      "slide_index": 38,
      "text": "叡智シーンはニコニコ動画で！",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "エイチシーンワニコニコドウガデ",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_038.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.038.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": true,
      "audio_path": null
    },
    {
      "slide_index": 39,
      "text": "僕は、先ほど同じように二人とセックスすると、そのままそっとベッドで寝かしつけた。そして、レミリアのポケベルを戻す。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、サキホドオナジヨウニフタリトセックススルト、ソノママソットベッドデネカシツケタ。ソシテ、レミリアノポケベルオモドス。",
      "extra_delay": 10.060000419617,
      "transition_delay": 10.060000419617,
      "audio_duration": 9.564784580498866,
      "audio_file": "slide_039.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.039.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 2,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_039.wav"
    },
    {
      "slide_index": 40,
      "text": "僕はそれから、共同スペースに降りてくる。\nすると、そこには、パチュリーと咲夜がいた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワソレカラ、キョウドウスペースニオリテクル。スルト、ソコニワ、パチュリートサクヤガイタ。",
      "extra_delay": 7.460000038147,
      "transition_delay": 7.460000038147,
      "audio_duration": 6.955011337868481,
      "audio_file": "slide_040.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.040.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_040.wav"
    },
    {
      "slide_index": 41,
      "text": "「あなた…思ったより元気じゃない…心配して損したわ…」",
      "notes": "",
      "character": "パチュリー",
      "voice": "f2",
      "speed": 120,
      "pitch": 115,
      "phonemes": "アナタ。オモッタヨリゲンキジャナイ。シンパイシテソンシタワ",
      "extra_delay": 3.319999933243,
      "transition_delay": 3.319999933243,
      "audio_duration": 3.8426303854875283,
      "audio_file": "slide_041.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.041.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_041.wav"
    },
    {
      "slide_index": 42,
      "text": "「それで、先についたお嬢様たちは、どこにいるのですか？」",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ソレデ、サキニツイタオジョーサマタチワ、ドコニイルノデスカ",
      "extra_delay": 4.519999980927,
      "transition_delay": 4.519999980927,
      "audio_duration": 4.018616780045352,
      "audio_file": "slide_042.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.042.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_042.wav"
    },
    {
      "slide_index": 43,
      "text": "僕は、そこで、先ほどまでの流れを説明する。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ソコデ、サキホドマデノナガレオセツメイスル。",
      "extra_delay": 4.429999828339,
      "transition_delay": 4.429999828339,
      "audio_duration": 3.9336054421768707,
      "audio_file": "slide_043.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.043.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_043.wav"
    },
    {
      "slide_index": 44,
      "text": "「あなた、それは、もはや単なるセックスの領域超えて、あの二人のあなたに懐かせているんじゃない…」",
      "notes": "",
      "character": "パチュリー",
      "voice": "f2",
      "speed": 120,
      "pitch": 115,
      "phonemes": "アナタ、ソレワ、モハヤタンナルセックスノリョウイキコエテ、アノフタリノアナタニナツカセテイルンジャナイ",
      "extra_delay": 6.320000171661,
      "transition_delay": 6.320000171661,
      "audio_duration": 5.872834467120182,
      "audio_file": "slide_044.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.044.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 1.2,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_044.wav"
    },
    {
      "slide_index": 45,
      "text": "「もはや、懐かせるのではなくて、彼とじゃないとセックスでいい気持ちにならなくなってるんじゃ…」",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "モハヤ、ナツカセルノデワナクテ、カレトジャナイトセックスデイイキモチニナラナクナッテルンジャ",
      "extra_delay": 6.420000076294,
      "transition_delay": 6.420000076294,
      "audio_duration": 5.982018140589569,
      "audio_file": "slide_045.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.045.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 3,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_045.wav"
    },
    {
      "slide_index": 46,
      "text": "「ねぇ…私とセックスしてくれないかしら…、あの二人が感じたあなたのテクニックを私も感じたいわ…」",
      "notes": "",
      "character": "パチュリー",
      "voice": "f2",
      "speed": 120,
      "pitch": 115,
      "phonemes": "ネーワタシトセックスシテクレナイカシラ、アノフタリガカンジタアナタノテクニックオワタシモカンジタイワ",
      "extra_delay": 6.159999847412,
      "transition_delay": 6.159999847412,
      "audio_duration": 5.6762131519274375,
      "audio_file": "slide_046.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.046.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 0.2,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_046.wav"
    },
    {
      "slide_index": 47,
      "text": "「私も…あなたのテクニックを自分で実感したい…です…」",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ワタシモ。アナタノテクニックオジブンデジッカンシタイ。デス",
      "extra_delay": 3.880000114441,
      "transition_delay": 3.880000114441,
      "audio_duration": 4.563401360544217,
      "audio_file": "slide_047.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.047.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_047.wav"
    },
    {
      "slide_index": 48,
      "text": "「それなら、どこでしますか？今、僕の部屋はフランさんとレミリアさんが寝ているので、入れないですが…」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソレナラ、ドコデシマスカ。イマ、ボクノヘヤワフランサントレミリアサンガネテイルノデ、ハイレナイデスガ",
      "extra_delay": 7.460000038147,
      "transition_delay": 7.460000038147,
      "audio_duration": 7.726530612244898,
      "audio_file": "slide_048.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.048.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_048.wav"
    },
    {
      "slide_index": 49,
      "text": "「それなら、私の部屋にしましょう…」\n私は、そう彼に提案する。",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ソレナラ、ワタシノヘヤニシマショウ。ワタシワ、ソウカレニテイアンスル。",
      "extra_delay": 5.5,
      "transition_delay": 5.5,
      "audio_duration": 5.000521541950113,
      "audio_file": "slide_049.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.049.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_049.wav"
    },
    {
      "slide_index": 50,
      "text": "「分かりました…」\n僕はそれから、二人と共に咲夜の部屋に向かった。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ワカリマシタ。ボクワソレカラ、フタリトトモニサクヤノヘヤニムカッタ。",
      "extra_delay": 5.840000152588,
      "transition_delay": 5.840000152588,
      "audio_duration": 5.354467120181406,
      "audio_file": "slide_050.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.050.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_050.wav"
    },
    {
      "slide_index": 51,
      "text": "叡智シーンはニコニコ動画で！",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "エイチシーンワニコニコドウガデ",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_051.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.051.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 52,
      "text": "そして、二人とセックスすると、納得したような感じの表情を見せて、それから数分後には、すやすやと眠り始めた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、フタリトセックススルト、ナットクシタヨウナカンジノヒョウジョウオミセテ、ソレカラスウフンゴニワ、スヤスヤトネムリハジメタ。",
      "extra_delay": 9.859999656677,
      "transition_delay": 9.859999656677,
      "audio_duration": 9.363696145124717,
      "audio_file": "slide_052.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.052.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 0.7,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_052.wav"
    },
    {
      "slide_index": 53,
      "text": "僕は、もう一度、共同スペースに降りてくると、ふと眠気が来て、\nそのままソファに横になって、目を閉じた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、モウイチド、キョウドウスペースニオリテクルト、フトネムケガキテ、。ソノママソファニヨコニナッテ、メオトジタ。",
      "extra_delay": 9.529999732971,
      "transition_delay": 9.529999732971,
      "audio_duration": 9.026848072562359,
      "audio_file": "slide_053.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.053.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_053.wav"
    },
    {
      "slide_index": 54,
      "text": "彼が目を覚ますと…",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "カレガメオサマスト",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_054.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.054.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 55,
      "text": "僕は、ふと目が覚めると、そこには霊夢と\n魔理沙がうずうずした状態で立っていた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フトメガサメルト、ソコニワレームト。マリサガウズウズシタジョウタイデタッテイタ。",
      "extra_delay": 7.05999994278,
      "transition_delay": 7.05999994278,
      "audio_duration": 6.559251700680272,
      "audio_file": "slide_055.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.055.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_055.wav"
    },
    {
      "slide_index": 56,
      "text": "「あんた…どうやってあの四人を溺れさせたのよ…」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "アンタ。ドウヤッテアノヨニンオオボレサセタノヨ",
      "extra_delay": 3.269999980927,
      "transition_delay": 3.269999980927,
      "audio_duration": 3.4170068027210885,
      "audio_file": "slide_056.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.056.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_056.wav"
    },
    {
      "slide_index": 57,
      "text": "「私も気になるのだぜ…フランの様子もいつもと違ってたし…」",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシモキニナルノダゼ。フランノヨウスモイツモトチガッテタシ",
      "extra_delay": 4.530000209808,
      "transition_delay": 4.530000209808,
      "audio_duration": 4.662018140589569,
      "audio_file": "slide_057.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.057.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_057.wav"
    },
    {
      "slide_index": 58,
      "text": "僕は、彼女たちの思考を予測し、何が言いたいのかを考える。\n「霊夢さんたちも…体感したいのですか…？」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、カノジョタチノシコウオヨソクシ、ナニガイイタイノカオカンガエル。レームサンタチモ。タイカンシタイノデスカ",
      "extra_delay": 8.579999923706,
      "transition_delay": 8.579999923706,
      "audio_duration": 8.702834467120182,
      "audio_file": "slide_058.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.058.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_058.wav"
    },
    {
      "slide_index": 59,
      "text": "「そうに…決まってるじゃない。こっちは、\nあんたのことで、あそこが渦巻いてるのよ…」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソウニ。キマッテルジャナイ。コッチワ、。アンタノコトデ、アソコガウズマイテルノヨ",
      "extra_delay": 6.789999961853,
      "transition_delay": 6.789999961853,
      "audio_duration": 6.909501133786848,
      "audio_file": "slide_059.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.059.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_059.wav"
    },
    {
      "slide_index": 60,
      "text": "「私もだぜ…」",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシモダゼ",
      "extra_delay": 1.5,
      "transition_delay": 1.5,
      "audio_duration": 1.0045124716553289,
      "audio_file": "slide_060.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.060.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_060.wav"
    },
    {
      "slide_index": 61,
      "text": "「レミリアさんたちは…？」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "レミリアサンタチワ",
      "extra_delay": 1.75,
      "transition_delay": 1.75,
      "audio_duration": 1.250453514739229,
      "audio_file": "slide_061.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.061.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_061.wav"
    },
    {
      "slide_index": 62,
      "text": "「彼女たちなら、あんたのことを私たちに告げてから、\n紅魔館に戻っていったわ…。」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "カノジョタチナラ、アンタノコトオワタシタチニツゲテカラ、。コーマカンニモドッテイッタワ。",
      "extra_delay": 6.929999828339,
      "transition_delay": 6.929999828339,
      "audio_duration": 6.434512471655329,
      "audio_file": "slide_062.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.062.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_062.wav"
    },
    {
      "slide_index": 63,
      "text": "「そろそろ、アレが垂れそうだぜ…、\n早くお前のベッドに行かないか…？」",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソロソロ、アレガタレソウダゼ、。ハヤクオマエノベッドニイカナイカ",
      "extra_delay": 5.550000190735,
      "transition_delay": 5.550000190735,
      "audio_duration": 5.054512471655329,
      "audio_file": "slide_063.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.063.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_063.wav"
    },
    {
      "slide_index": 64,
      "text": "「そうですか…。」\n僕はそう呟くと、ソファからおり、自分の部屋に向かう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカ。ボクワソウツブヤクト、ソファカラオリ、ジブンノヘヤニムカウ。",
      "extra_delay": 6.079999923706,
      "transition_delay": 6.079999923706,
      "audio_duration": 5.578163265306123,
      "audio_file": "slide_064.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.064.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_064.wav"
    },
    {
      "slide_index": 65,
      "text": "僕たちが僕の部屋に入ると、霊夢が僕の体をいきなり掴み、ベッドに押し倒し、そこから僕と二人とのセックスが始まった。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクタチガボクノヘヤニハイルト、レームガボクノカラダオイキナリツカミ、ベッドニオシタオシ、ソコカラボクトフタリノセックスガハジマッタ。",
      "extra_delay": 10.270000457764,
      "transition_delay": 10.270000457764,
      "audio_duration": 9.63718820861678,
      "audio_file": "slide_065.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.065.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 8,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_065.wav"
    },
    {
      "slide_index": 66,
      "text": "叡智シーンはニコニコ動画で！",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "エイチシーンワニコニコドウガデ",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_066.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.066.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 67,
      "text": "彼が再びベッドから降りると…",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "カレガフタタビベッドカラオリルト",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_067.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.067.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 68,
      "text": "僕は、二人とのセックスすると、数分くらいで彼女たちは眠りに落ちていった。何だか魔理沙のアレが前回より出てる気がした。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フタリトノセックススルト、スウフンクライデカノジョタチワネムリニオチテイッタ。ナンダカマリサノアレガゼンカイヨリデテルキガシタ。",
      "extra_delay": 10.189999580383,
      "transition_delay": 10.189999580383,
      "audio_duration": 9.687845804988662,
      "audio_file": "slide_068.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.068.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 0.8,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_068.wav"
    },
    {
      "slide_index": 69,
      "text": "それは、霊夢にも言えることで、二人の感度がいつもより高くなっているのか、健康面で不安を感じるほどアレが出た。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソレワ、レームニモイエルコトデ、フタリノカンドガイツモヨリタカクナッテイルノカ、ケンコウメンデフアンオカンジルホドアレガデタ。",
      "extra_delay": 9.079999923706,
      "transition_delay": 9.079999923706,
      "audio_duration": 8.571746031746033,
      "audio_file": "slide_069.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.069.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_069.wav"
    },
    {
      "slide_index": 70,
      "text": "そして僕は、そっと部屋から出ていく。\nその足取りでそのまま、共同スペースに向かう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテボクワ、ソットヘヤカラデテイク。ソノアシドリデソノママ、キョウドウスペースニムカウ。",
      "extra_delay": 7.25,
      "transition_delay": 7.25,
      "audio_duration": 6.753696145124716,
      "audio_file": "slide_070.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.070.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_070.wav"
    },
    {
      "slide_index": 71,
      "text": "「操夢さん、今ちょうど夕飯ができて、並べたところですよ。」\n私は、上から降りてきた彼にいう。",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ソームサン、イマチョウドユウハンガデキテ、ナラベタトコロデスヨ。ワタシワ、ウエカラオリテキタカレニイウ。",
      "extra_delay": 7.599999904633,
      "transition_delay": 7.599999904633,
      "audio_duration": 7.104603174603175,
      "audio_file": "slide_071.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.071.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_071.wav"
    },
    {
      "slide_index": 72,
      "text": "「あっ、ありがとうございます…」\n僕はそう返す。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "アッ、アリガトウゴザイマス。ボクワソウカエス。",
      "extra_delay": 4.179999828339,
      "transition_delay": 4.179999828339,
      "audio_duration": 3.6770748299319727,
      "audio_file": "slide_072.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.072.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_072.wav"
    },
    {
      "slide_index": 73,
      "text": "「いえ、お礼なんていいですよ。それより食べてください。」\n私は、彼とのセックスしたい欲を抑えていう。",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "イエ、オレイナンテイイデスヨ。ソレヨリタベテクダサイ。ワタシワ、カレトノセックスシタイヨクオオサエテイウ。",
      "extra_delay": 7.880000114441,
      "transition_delay": 7.880000114441,
      "audio_duration": 7.384603174603175,
      "audio_file": "slide_073.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.073.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 5,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_073.wav"
    },
    {
      "slide_index": 74,
      "text": "僕は、「いただきます」といってから、ご飯を食べ始める。\nすると、彼女は僕と対角の席に座る。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、イタダキマストイッテカラ、ゴハンオタベハジメル。スルト、カノジョワボクトタイカクノセキニスワル。",
      "extra_delay": 8.460000038147,
      "transition_delay": 8.460000038147,
      "audio_duration": 7.960884353741497,
      "audio_file": "slide_074.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.074.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_074.wav"
    },
    {
      "slide_index": 75,
      "text": "「咲夜さん、なんでニヤついているんですか…」\n僕は彼女の思考を予測しながら、話しかける。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "サクヤサン、ナンデニヤツイテイルンデスカ。ボクワカノジョノシコウオヨソクシナガラ、ハナシカケル。",
      "extra_delay": 7.619999885559,
      "transition_delay": 7.619999885559,
      "audio_duration": 7.124036281179138,
      "audio_file": "slide_075.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.075.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_075.wav"
    },
    {
      "slide_index": 76,
      "text": "「いつの間に…ちょっと、席を外しますね…。」\n私はそう言い、椅子から立ち上がる。",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "イツノマニ。チョット、セキオハズシマスネ。ワタシワソウイイ、イスカラタチアガル。",
      "extra_delay": 6.050000190735,
      "transition_delay": 6.050000190735,
      "audio_duration": 6.135102040816326,
      "audio_file": "slide_076.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.076.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_076.wav"
    },
    {
      "slide_index": 77,
      "text": "「後片付けなら僕がしておくので、咲夜さんは共同キッチンに戻らなくても大丈夫ですよ。」僕はそう彼女に告げる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "アトカタズケナラボクガシテオクノデ、サクヤサンワキョウドウキッチンニモドラナクテモダイジョウブデスヨ。ボクワソウカノジョニツゲル。",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 8.840544217687075,
      "audio_file": "slide_077.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.077.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_077.wav"
    },
    {
      "slide_index": 78,
      "text": "「そうですか…」\n彼のその言葉に、ふと彼とさっきしたセックスが目に浮かぶ…",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ソウデスカ。カレノソノコトバニ、フトカレトサッキシタセックスガメニウカブ",
      "extra_delay": 5.889999866486,
      "transition_delay": 5.889999866486,
      "audio_duration": 5.38501133786848,
      "audio_file": "slide_078.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.078.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 4.5,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_078.wav"
    },
    {
      "slide_index": 79,
      "text": "「咲夜さん…さっきから様子が変ですよ…」\n僕は、彼女に視線を当てながらそういう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "サクヤサン。サッキカラヨウスガヘンデスヨ。ボクワ、カノジョニシセンオアテナガラソウイウ。",
      "extra_delay": 6.610000133514,
      "transition_delay": 6.610000133514,
      "audio_duration": 6.715124716553288,
      "audio_file": "slide_079.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.079.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_079.wav"
    },
    {
      "slide_index": 80,
      "text": "「はっ…」私は彼の指摘にふと驚きの声を上げる。そして、このままここにいるのは良くない考え、ささっと部屋に戻った。",
      "notes": "",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ハッ。ワタシワカレノシテキニフトオドロキノコエオアゲル。ソシテ、コノママココニイルノワヨクナイカンガエ、ササットヘヤニモドッタ。",
      "extra_delay": 8.989999771118,
      "transition_delay": 8.989999771118,
      "audio_duration": 9.132312925170067,
      "audio_file": "slide_080.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.080.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_080.wav"
    },
    {
      "slide_index": 81,
      "text": "僕は、一人共同スペースで黙々とご飯を食べ進め、\n完食すると、食器の後片付けを済ます。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ヒトリキョウドウスペースデモクモクトゴハンオタベススメ、カンショクスルト、ショッキノアトカタズケオスマス。",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 8.06077097505669,
      "audio_file": "slide_081.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.081.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_081.wav",
      "no_voice": false
    },
    {
      "slide_index": 82,
      "text": "すると、さとりとこいしが帰ってくる。\n「お帰りなさい。」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、サトリトコイシガカエッテクル。オカエリナサイ。",
      "extra_delay": 4.639999866486,
      "transition_delay": 4.639999866486,
      "audio_duration": 4.143809523809524,
      "audio_file": "slide_082.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.082.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_082.wav",
      "no_voice": false
    },
    {
      "slide_index": 83,
      "text": "「よかったです、操夢が無事で…」\n私はそういう。",
      "notes": "",
      "character": "さとり",
      "voice": "jgr",
      "speed": 115,
      "pitch": 125,
      "phonemes": "ヨカッタデス、ソームガブジデ。ワタシワソウイウ。",
      "extra_delay": 3.789999961853,
      "transition_delay": 3.789999961853,
      "audio_duration": 3.2860090702947846,
      "audio_file": "slide_083.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.083.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_083.wav",
      "no_voice": false
    },
    {
      "slide_index": 84,
      "text": "「私も、安心した…」",
      "notes": "",
      "character": "こいし",
      "voice": "f2",
      "speed": 100,
      "pitch": 181,
      "phonemes": "ワタシモ、アンシンシタ",
      "extra_delay": 4.090000152588,
      "transition_delay": 4.090000152588,
      "audio_duration": 1.7931065759637188,
      "audio_file": "slide_084.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.084.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_084.wav",
      "no_voice": false
    },
    {
      "slide_index": 85,
      "text": "「そうですか、先に、お風呂とご飯のどっちにしますか？」\n僕は、そう聞く。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカ、サキニ、オフロトゴハンノドッチニシマスカ。ボクワ、ソウキク。",
      "extra_delay": 6.590000152588,
      "transition_delay": 6.590000152588,
      "audio_duration": 6.087301587301587,
      "audio_file": "slide_085.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.085.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_085.wav"
    },
    {
      "slide_index": 86,
      "text": "「私は、先にお風呂に入ってきますね…」",
      "notes": "",
      "character": "さとり",
      "voice": "jgr",
      "speed": 115,
      "pitch": 125,
      "phonemes": "ワタシワ、サキニオフロニハイッテキマスネ",
      "extra_delay": 3.099999904633,
      "transition_delay": 3.099999904633,
      "audio_duration": 2.601315192743764,
      "audio_file": "slide_086.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.086.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_086.wav",
      "no_voice": false
    },
    {
      "slide_index": 87,
      "text": "「私も、そうしようかな…」",
      "notes": "",
      "character": "こいし",
      "voice": "f2",
      "speed": 100,
      "pitch": 181,
      "phonemes": "ワタシモ、ソウシヨウカナ",
      "extra_delay": 4.420000076294,
      "transition_delay": 4.420000076294,
      "audio_duration": 1.963764172335601,
      "audio_file": "slide_087.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.087.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_087.wav",
      "no_voice": false
    },
    {
      "slide_index": 88,
      "text": "「僕は、その間に歯磨きでもしようかな…」\n僕はそういうと、僕たちはそれぞれの部屋に向かう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ソノアイダ二ハミガキデモシヨウカナ。ボクワソウイウト、ボクタチワソレゾレノヘヤニムカウ。",
      "extra_delay": 7.670000076294,
      "transition_delay": 7.670000076294,
      "audio_duration": 7.2345804988662135,
      "audio_file": "slide_088.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.088.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_088.wav",
      "no_voice": false
    },
    {
      "slide_index": 89,
      "text": "さとりたちが夕飯を食べると…",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "サトリタチガユウハンオタベルト",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_089.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.089.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "no_voice": true,
      "audio_path": null
    },
    {
      "slide_index": 90,
      "text": "僕は、二人の夕飯を作り、二人が夕飯を食べながら、会話を交わすうちに、話の流れで、さっきまでの経緯を語っていた。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フタリノユウハンオツクリ、フタリガユウハンオタベナガラ、カイワオカワスウチニ、ハナシノナガレデ、サッキマデノケイイオカタッテイタ。",
      "extra_delay": 10.420000076294,
      "transition_delay": 10.420000076294,
      "audio_duration": 9.921972789115646,
      "audio_file": "slide_090.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.090.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_090.wav",
      "no_voice": false
    },
    {
      "slide_index": 91,
      "text": "「霊夢たちだけずるいですよ、あなたのテクニックで溺れられるなんて…、私たちにもそれを体感させてください。」",
      "notes": "",
      "character": "さとり",
      "voice": "jgr",
      "speed": 115,
      "pitch": 125,
      "phonemes": "レームタチダケズルイデスヨ、アナタノテクニックデオボレラレルナンテ、ワタシタチニモソレオタイカンサセテクダサイ。",
      "extra_delay": 7.050000190735,
      "transition_delay": 7.050000190735,
      "audio_duration": 6.5515192743764175,
      "audio_file": "slide_091.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.091.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_091.wav",
      "no_voice": false
    },
    {
      "slide_index": 92,
      "text": "「私にも、させて…」",
      "notes": "",
      "character": "こいし",
      "voice": "f2",
      "speed": 100,
      "pitch": 181,
      "phonemes": "ワタシニモ、サセテ",
      "extra_delay": 3.769999980927,
      "transition_delay": 3.769999980927,
      "audio_duration": 1.6252154195011337,
      "audio_file": "slide_092.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.092.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_092.wav",
      "no_voice": false
    },
    {
      "slide_index": 93,
      "text": "「そうですか…いいですよ。それで、誰の部屋でやりますか？僕の部屋は、今霊夢さんと魔理沙さんが寝てるから使えませんが…」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカ。イイデスヨ。ソレデ、ダレノヘヤデヤリマスカボクノヘヤワ、イマレームサントマリササンガネテルカラツカエマセンガ",
      "extra_delay": 9.220000267029,
      "transition_delay": 9.220000267029,
      "audio_duration": 9.34968253968254,
      "audio_file": "slide_093.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.093.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_093.wav",
      "no_voice": false
    },
    {
      "slide_index": 94,
      "text": "「それなら、私の部屋にしましょ。」",
      "notes": "",
      "character": "さとり",
      "voice": "jgr",
      "speed": 115,
      "pitch": 125,
      "phonemes": "ソレナラ、ワタシノヘヤニシマショ。",
      "extra_delay": 2.619999885559,
      "transition_delay": 2.619999885559,
      "audio_duration": 2.1205215419501133,
      "audio_file": "slide_094.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.094.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_094.wav",
      "no_voice": false
    },
    {
      "slide_index": 95,
      "text": "「分かりました…」\n僕は、そういうと、3人でさとりの部屋に向かった。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ワカリマシタ。ボクワ、ソウイウト、サンニンデサトリノヘヤニムカッタ。",
      "extra_delay": 5.679999828339,
      "transition_delay": 5.679999828339,
      "audio_duration": 5.413809523809523,
      "audio_file": "slide_095.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.095.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_095.wav",
      "no_voice": false
    },
    {
      "slide_index": 96,
      "text": "「じゃあ、始めるよ…」\n私たちは彼をベッドに押し倒すと、そういって、始めた。",
      "notes": "",
      "character": "こいし",
      "voice": "f2",
      "speed": 100,
      "pitch": 181,
      "phonemes": "ジャア、ハジメルヨ。ワタシタチワカレオベッドニオシタオスト、ソウイッテ、ハジメタ。",
      "extra_delay": 13.25,
      "transition_delay": 13.25,
      "audio_duration": 6.363900226757369,
      "audio_file": "slide_096.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.096.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_096.wav",
      "no_voice": false
    },
    {
      "slide_index": 97,
      "text": "叡智シーンはニコニコ動画で！",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "エイチシーンワニコニコドウガデ",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 0,
      "audio_file": "slide_098.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.097.jpeg",
      "is_enabled": false,
      "is_skipped": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "audio_path": null
    },
    {
      "slide_index": 98,
      "text": "僕は、二人が霊夢たちと同じような感じで眠りにつくと、二人を起こさないようにそっと、ベッドから降りる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、フタリガレームタチトオナジヨウナカンジデネムリニツクト、フタリオオコサナイヨウニソット、ベッドカラオリル。",
      "extra_delay": 8.479999542236,
      "transition_delay": 8.479999542236,
      "audio_duration": 7.985555555555556,
      "audio_file": "slide_098.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.098.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_098.wav",
      "no_voice": false
    },
    {
      "slide_index": 99,
      "text": "そして、その足取りで共同スペースに戻る。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、ソノアシドリデキョウドウスペースニモドル。",
      "extra_delay": 3.900000095367,
      "transition_delay": 3.900000095367,
      "audio_duration": 3.3882766439909298,
      "audio_file": "slide_099.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.099.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_099.wav"
    },
    {
      "slide_index": 100,
      "text": "僕が共同スペースに降りてくると、霊夢たちがいた。\n「二人とも、目が覚めたんですね…」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクガキョウドウスペースニオリテクルト、レームタチガイタ。フタリトモ、メガサメタンデスネ",
      "extra_delay": 7.300000190735,
      "transition_delay": 7.300000190735,
      "audio_duration": 6.797392290249433,
      "audio_file": "slide_100.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.100.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_100.wav",
      "no_voice": false
    },
    {
      "slide_index": 101,
      "text": "「あんたのお風呂借りて、スッキリしてきたわ。」\n私は、彼ともう一度セックスしたい気持ちを抑えながらいう。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "アンタノオフロカリテ、スッキリシテキタワ。ワタシワ、カレトモウイチドセックスシタイキモチオオサエナガライウ。",
      "extra_delay": 8.319999694824,
      "transition_delay": 8.319999694824,
      "audio_duration": 7.8245124716553285,
      "audio_file": "slide_101.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.101.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 5,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_101.wav",
      "no_voice": false
    },
    {
      "slide_index": 102,
      "text": "「それで、操夢は何してたんだ？」\n私は、彼に犯されたい気持ちを堪えながらいう。",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソレデ、ソームワナニシテタンダ。ワタシワ、カレニオカサレタイキモチオコラエナガライウ。",
      "extra_delay": 6.94000005722,
      "transition_delay": 6.94000005722,
      "audio_duration": 6.414512471655329,
      "audio_file": "slide_102.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.102.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_102.wav",
      "no_voice": false
    },
    {
      "slide_index": 103,
      "text": "「そうですか…、それで、夕飯は食べましたか？」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカ、ソレデ、ユウハンワタベマシタカ",
      "extra_delay": 3.920000076294,
      "transition_delay": 3.920000076294,
      "audio_duration": 3.415986394557823,
      "audio_file": "slide_103.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.103.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_103.wav"
    },
    {
      "slide_index": 104,
      "text": "「いや、まだ食べてないわ…」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "イヤ、マダタベテナイワ",
      "extra_delay": 2.25,
      "transition_delay": 2.25,
      "audio_duration": 1.7545124716553289,
      "audio_file": "slide_104.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.104.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_104.wav",
      "no_voice": false
    },
    {
      "slide_index": 105,
      "text": "「私もまだ食べないぜ…」",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシモマダタベナイゼ",
      "extra_delay": 2.140000104904,
      "transition_delay": 2.140000104904,
      "audio_duration": 1.6395011337868481,
      "audio_file": "slide_105.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.105.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "no_voice": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_105.wav"
    },
    {
      "slide_index": 106,
      "text": "「そうですか…じゃあ、僕が作りますね。」\n僕はそういうと、共同キッチンに入り、冷蔵庫を開ける。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカ。ジャア、ボクガツクリマスネ。ボクワソウイウト、キョウドウキッチンニハイリ、レイゾウコオアケル。",
      "extra_delay": 8,
      "transition_delay": 8,
      "audio_duration": 8.137074829931972,
      "audio_file": "slide_106.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.106.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_106.wav",
      "no_voice": false
    },
    {
      "slide_index": 107,
      "text": "そして、二人の視線を感じながら、思考を働かせて夕飯を作る。\nそして、数十分程度で完成すると、パックご飯とともに出す。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、フタリノシセンオカンジナガラ、シコウオハタラカセテユウハンオツクル。ソシテ、スウジュウフンテイドデカンセイスルト、パックゴハントトモニダス。",
      "extra_delay": 11.439999580383,
      "transition_delay": 11.439999580383,
      "audio_duration": 10.943265306122449,
      "audio_file": "slide_107.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.107.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_107.wav",
      "no_voice": false
    },
    {
      "slide_index": 108,
      "text": "「できましたよ…。二人ともどうしたんですか？」\n僕は、二人の思考の分析と予測をしながらいう。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "デキマシタヨ。フタリトモドウシタンデスカ。ボクワ、フタリノシコウノブンセキトヨソクオシナガライウ。",
      "extra_delay": 8.140000343323,
      "transition_delay": 8.140000343323,
      "audio_duration": 7.650453514739229,
      "audio_file": "slide_108.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.108.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_108.wav",
      "no_voice": false
    },
    {
      "slide_index": 109,
      "text": "「いや、何でもないわ。それじゃ、いただきます。」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "イヤ、ナンデモナイワ。ソレジャ、イタダキマス。",
      "extra_delay": 4.369999885559,
      "transition_delay": 4.369999885559,
      "audio_duration": 3.832018140589569,
      "audio_file": "slide_109.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.109.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_109.wav"
    },
    {
      "slide_index": 110,
      "text": "「いただきますなのだぜ…」",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "イタダキマスナノダゼ",
      "extra_delay": 2.039999961853,
      "transition_delay": 2.039999961853,
      "audio_duration": 1.544512471655329,
      "audio_file": "slide_110.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.110.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_110.wav"
    },
    {
      "slide_index": 111,
      "text": "僕は、食事をする二人を見ながら、今日を振り返る。レミリアたちにお仕置きを受けてから、彼女たちの様子が変化した。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ショクジオスルフタリオミナガラ、キョウオフリカエル。レミリアタチニオシオキオウケテカラ、カノジョタチノヨウスガヘンカシタ。",
      "extra_delay": 9.670000076294,
      "transition_delay": 9.670000076294,
      "audio_duration": 9.177619047619048,
      "audio_file": "slide_111.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.111.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_111.wav"
    },
    {
      "slide_index": 112,
      "text": "僕は、なぜこのような変化が起きたのかを解析する。僕の行動は、次々とこの家に住む女性たちとセックスするだけだった。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ナゼコノヨウナヘンカガオキタノカオカイセキスル。ボクノコウドウワ、ツギツギトコノイエニスムジョセイタチトセックススルダケダッタ。",
      "extra_delay": 10.35000038147,
      "transition_delay": 10.35000038147,
      "audio_duration": 9.850340136054422,
      "audio_file": "slide_112.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.112.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 8,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_112.wav"
    },
    {
      "slide_index": 113,
      "text": "ただ、一つ異なる点はといえば、コストとタイムを抑え、自滅するのを防ぎながら、節約セックスしたくらいだ。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "タダ、ヒトツコトナルテンワトイエバ、コストトタイムオオサエ、ジメツスルノオフセギナガラ、セツヤクセックスシタクライダ。",
      "extra_delay": 9.159999847412,
      "transition_delay": 9.159999847412,
      "audio_duration": 8.63859410430839,
      "audio_file": "slide_113.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.113.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/自主規制ピー音.mp3",
      "se_offset": 5.5,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_113.wav",
      "no_voice": false
    },
    {
      "slide_index": 114,
      "text": "だけども、その過程のどこかに彼女たちが変化する要因があったのだと考える。そして、その要因は僕の行動にある…。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ダケドモ、ソノカテイノドコカニカノジョタチガヘンカスルヨウインガアッタノダトカンガエル。ソシテ、ソノヨウインワボクノコウドウニアル。",
      "extra_delay": 9.829999923706,
      "transition_delay": 9.829999923706,
      "audio_duration": 9.332630385487528,
      "audio_file": "slide_114.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.114.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_114.wav"
    },
    {
      "slide_index": 115,
      "text": "だが、僕は頭をフル回転して解析しても、特に明確な答えは見つからなかった。ふと二人を見ると、食器が空なのに気づく。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ダガ、ボクワアタマオフルカイテンシテカイセキシテモ、トクニメイカクナコタエワミツカラナカッタ。フトフタリオミルト、ショッキガカラナノニキズク。",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 10.516417233560091,
      "audio_file": "slide_115.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.115.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_115.wav"
    },
    {
      "slide_index": 116,
      "text": "「ご飯、食べ終わったんですね。」僕はそういうと、二人が空にした食器を共同キッチンに運び、後片付けをする。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ゴハン、タベオワッタンデスネ。ボクワソウイウト、フタリガカラニシタショッキオキョウドウキッチンニハコビ、アトカタズケオスル。",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 8.938934240362812,
      "audio_file": "slide_116.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.116.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_116.wav"
    },
    {
      "slide_index": 117,
      "text": "そして、後片付けが終わると、ふと向こうにポケベルを忘れていったことを思い出し、霊夢たちにその在処を尋ねる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、アトカタズケガオワルト、フトムコウニポケベルオワスレテイッタコトオオモイダシ、レームタチニソノアリカオタズネル。",
      "extra_delay": 1,
      "transition_delay": 1,
      "audio_duration": 8.441972789115646,
      "audio_file": "slide_117.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.117.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_117.wav"
    },
    {
      "slide_index": 118,
      "text": "「あんたのポケベルのことすっかり忘れていたわ。」\n私は、そう言い、彼のポケベルを探す。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "アンタノポケベルノコトスッカリワスレテイタワ。ワタシワ、ソウイイ、カレノポケベルオサガス。",
      "extra_delay": 7.239999771118,
      "transition_delay": 7.239999771118,
      "audio_duration": 6.742018140589569,
      "audio_file": "slide_118.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.118.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_118.wav"
    },
    {
      "slide_index": 119,
      "text": "そして、スーツケースから彼のポケベルを取り出すと彼に渡す。\n「ポケベルを無くさないように気をつけてよね…」",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソシテ、スーツケースカラカレノポケベルオトリダストカレニワタス。ポケベルオナクサナイヨウニキオツケテヨネ",
      "extra_delay": 8.270000457764,
      "transition_delay": 8.270000457764,
      "audio_duration": 7.772018140589569,
      "audio_file": "slide_119.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.119.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_119.wav"
    },
    {
      "slide_index": 120,
      "text": "「そうですね…、しっかりと自分で管理して無くさないようにします。」僕はそう言いながら、ポケベルをポッケに入れる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスネ、シッカリトジブンデカンリシテナクサナイヨウニシマス。ボクワソウイイナガラ、ポケベルオポッケニイレル。",
      "extra_delay": 8.60000038147,
      "transition_delay": 8.60000038147,
      "audio_duration": 8.100770975056689,
      "audio_file": "slide_120.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.120.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_120.wav"
    },
    {
      "slide_index": 121,
      "text": "「それで、霊夢さんたちは、これからどうしますか？」\n僕はそう尋ねる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソレデ、レームサンタチワ、コレカラドウシマスカ。ボクワソウタズネル。",
      "extra_delay": 5.889999866486,
      "transition_delay": 5.889999866486,
      "audio_duration": 5.389795918367347,
      "audio_file": "slide_121.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.121.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_121.wav"
    },
    {
      "slide_index": 122,
      "text": "「少しばかし、夜の風でも浴びてこようかしら…」\n私は彼にそう返す。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "スコシバカシ、ヨルノカゼデモアビテコヨウカシラ。ワタシワカレニソウカエス。",
      "extra_delay": 6.170000076294,
      "transition_delay": 6.170000076294,
      "audio_duration": 5.674512471655329,
      "audio_file": "slide_122.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.122.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_122.wav"
    },
    {
      "slide_index": 123,
      "text": "「それなら、風邪をひかないように気をつけてくださいね。\nこっちは向こうの気温とは異なりますから。」",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソレナラ、カゼオヒカナイヨウニキオツケテクダサイネ。コッチワムコウノキオントワコトナリマスカラ。",
      "extra_delay": 7.460000038147,
      "transition_delay": 7.460000038147,
      "audio_duration": 6.961972789115646,
      "audio_file": "slide_123.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.123.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_123.wav"
    },
    {
      "slide_index": 124,
      "text": "「わかったわ。ほら、魔理沙も一緒にいきましょ。」\n私はそう言い、魔理沙を誘う。",
      "notes": "",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワカッタワ。ホラ、マリサモイッショニイキマショ。ワタシワソウイイ、マリサオサソウ。",
      "extra_delay": 6.94000005722,
      "transition_delay": 6.94000005722,
      "audio_duration": 6.439501133786848,
      "audio_file": "slide_124.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.124.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_124.wav"
    },
    {
      "slide_index": 125,
      "text": "「わかったのだぜ。」\n私はそう返すと、霊夢と一緒に外に出た。",
      "notes": "",
      "character": "魔理沙",
      "voice": "f2",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワカッタノダゼ。ワタシワソウカエスト、レームトイッショニソトニデタ。",
      "extra_delay": 5.639999866486,
      "transition_delay": 5.639999866486,
      "audio_duration": 5.144512471655329,
      "audio_file": "slide_125.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.125.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": null,
      "se_offset": 0,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_125.wav"
    },
    {
      "slide_index": 126,
      "text": "僕はそれから、自分の部屋に戻り、入浴を済ますと、ベッドから異臭を感じ、さっと掛け布団を外すと浴室に運ぶ。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワソレカラ、ジブンノヘヤニモドリ、ニュウヨクオスマスト、ベッドカライシュウオカンジ、サットカケブトンオハズストヨクシツニハコブ。",
      "extra_delay": 9.939999580383,
      "transition_delay": 9.939999580383,
      "audio_duration": 9.437619047619048,
      "audio_file": "slide_126.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.126.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/衣擦れ2.mp3",
      "se_offset": 8,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_126.wav"
    },
    {
      "slide_index": 127,
      "text": "そして、入浴が終わる際に抜いた浴槽の栓を再びつけて、蛇口をひねて水を出し、洗剤と掛け布団を浴槽に入れる。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソシテ、ニュウヨクガオワルサイニヌイタヨクソウノセンオフタタビツケテ、ジャグチオヒネテミズオダシ、センザイトカケブトンオヨクソウニイレル。",
      "extra_delay": 9.880000114441,
      "transition_delay": 9.880000114441,
      "audio_duration": 19.08,
      "audio_file": "slide_127.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/スライド画像/交換夫婦（22話目）/交換夫婦（22話目）.127.jpeg",
      "is_enabled": true,
      "effect": "none",
      "quality_enhance": true,
      "sound_effect": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/動画用/音楽/効果音/水道の水を出す.mp3",
      "se_offset": 3,
      "is_skipped": false,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/交換夫婦/音声/交換夫婦（22話目）/slide_127.wav"
    },
    {
      "slide_index": 128,
      "text": "そのまま、枕とマットレスも入れ込むと、僕は、頭の中で時間を計算してから、乾燥と自動栓抜きのタイマーをセットし、部屋に戻る。",
      "notes": "",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソノママ、マクラトマットレスモイレコムト、ボクワ、アタマノナカデジカンオケイサンシテカラ、カンソウトジドウセンヌキノタイマーオセットシ、ヘヤニモドル。",
      "extra_delay": 11.409999847412,
      "transition_delay": 11.409999847412,
      "audio_duration": 10.91045351473923,
      "audio_file": "slide_128.wav",
