    {
      "slide_index": 5,
      "text": "「そうですか…でも、こうでもしないと、地上に落ちそうで…」",
      "notes": "（操夢）「そうですか…でも、こうでもしないと、地上に落ちそうで…」",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ソウデスカデモ、コウデモシナイト、チジョウニオチソウデ",
      "extra_delay": 0,
