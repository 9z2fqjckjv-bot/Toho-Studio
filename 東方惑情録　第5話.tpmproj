      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 8.19451247165533,
      "audio_file": "slide_002.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/東方惑情録/スライド画像/東方惑情録　第5話/東方惑情録　第5話.002.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 1.5,
      "video_duration": null,
      "is_enabled": true,
      "animation_duration": null,
      "sound_effects": [],
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/東方惑情録/音声/東方惑情録　第5話/slide_002.wav",
