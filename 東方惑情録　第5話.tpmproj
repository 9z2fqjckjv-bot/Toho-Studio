    {
      "slide_index": 4,
      "text": "「操夢…私の胸を掴んでる…」",
      "notes": "（フラン）「操夢…私の胸を掴んでる…」",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソームワタシノムネオツカンデル",
      "extra_delay": 0,
