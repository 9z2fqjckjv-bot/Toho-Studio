      "no_voice": false,
      "is_skipped": false
    },
    {
      "slide_index": 3,
      "text": "彼は、箒に跨ると、腕を伸ばし、私に抱きつく。そして、その腕が私の胸に当たる。",
      "notes": "（フラン）彼は、箒に跨ると、腕を伸ばし、私に抱きつく。そして、その腕が私の胸に当たる。",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "カレワ、ホウキニマタガルト、ウデオノバシ、ワタシニダキツク。ソシテ、ソノウデガワタシノムネニアタル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
