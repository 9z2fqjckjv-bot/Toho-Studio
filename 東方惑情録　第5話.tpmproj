      "_cacheBuster": 1787816655674,
      "sound_effects": []
    },
    {
      "slide_index": 55,
      "text": "僕は、そこまで聞いて、ここにくるまでの流れを思い出す。そして、ある疑問が浮かぶ。",
      "notes": "（操夢）僕は、そこまで聞いて、ここにくるまでの流れを思い出す。そして、ある疑問が浮かぶ。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ソコマデキイテ、ココニクルマデノナガレオオモイダス。ソシテ、アルギモンガウカブ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
