    },
    {
      "slide_index": 2,
      "text": "私は、そこで彼に手を伸ばす。すると、彼は、うまく私の手を掴み、箒になんとかまたがる。",
      "notes": "（フラン）私は、そこで彼に手を伸ばす。すると、彼は、うまく私の手を掴み、箒になんとかまたがる。",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシワ、ソコデカレニテオノバス。スルト、カレワ、ウマクワタシノテオツカミ、ホウキニナントカマタガル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
