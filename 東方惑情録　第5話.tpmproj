      "sound_effects": []
    },
    {
      "slide_index": 56,
      "text": "「あの、僕とフランは戦闘しましたか？」",
      "notes": "（操夢）「あの、僕とフランは戦闘しましたか？」",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "アノ、ボクトフランワセントウシマシタカ",
