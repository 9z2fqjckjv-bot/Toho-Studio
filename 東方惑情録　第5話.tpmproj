  "scenes": [
    {
      "slide_index": 1,
      "text": "私は、ふと後ろを見ると、彼が箒からぶら下がっている状態になっていることに気づく。",
      "notes": "（フラン）私は、ふと後ろを見ると、彼が箒からぶら下がっている状態になっていることに気づく。",
      "character": "フラン",
      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシワ、フトウシロオミルト、カレガホウキカラブラサガッテイルジョウタイニナッテイルコトニキズク。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
