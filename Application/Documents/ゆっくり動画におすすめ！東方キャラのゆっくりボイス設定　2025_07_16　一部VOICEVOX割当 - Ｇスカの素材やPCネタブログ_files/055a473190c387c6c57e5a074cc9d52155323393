/* 段落ごとの上下余白と行間の調整 */
.entry-content p {
  margin-top: 0;
  margin-bottom: 0.5em; /* 段落の下に少し空きを作る */
  line-height: 1.6;      /* 行間を少しゆったりさせる */
}

/* 文字間を広げる */
p {
  /* 単位は任意で設定してください */
