}

/* 記事タイトル */
.entry-title {
/* font-size: 20px; */
  margin-top: 0.1em;
  margin-bottom: 0.1em; 
  padding: 15px 10px;
  background-color: #A0D9FF;
  border-bottom: 4px solid #ccc;
}

/* 記事の文字色 */
.entry-content {
    color: #000000;
}

/* 目次のデザイン関連 */
.entry-content .table-of-contents {
    position:relative;
    margin-left: 0;
    padding: 15px 10px 15px 55px; /* 枠内の余白(上右下左) */
    font-size: 100%; /* 文字の大きさ */
    font-weight:bold;
    list-style-type:decimal; /*数字以外が良ければ変更 */
    background:#fff;
    border-top:40px solid #277efa; /* 「この記事の目次」周りの色 */
    border-left:2px solid #277efa; /* 線の太さ */
    border-right:2px solid #277efa;
    border-bottom:2px solid #277efa;
    line-height: 200%; /* 行間 */
    border-radius: ６px; /* 角丸にしない場合は不要 */
    color:#444; /* 数字（マーク色変更） */
}
/* 目次を目立たせる */
.entry-content .table-of-contents::before {
    font-family: 'blogicon';
    content: "\f700  目次";
    display: block;
    font-size: 130%;
    font-weight: bold;
    position: absolute;
    top: -40px;/*上からの位置調整*/
    left: 20px; /*左からの位置調整*/
    color: #fff !important;
}

