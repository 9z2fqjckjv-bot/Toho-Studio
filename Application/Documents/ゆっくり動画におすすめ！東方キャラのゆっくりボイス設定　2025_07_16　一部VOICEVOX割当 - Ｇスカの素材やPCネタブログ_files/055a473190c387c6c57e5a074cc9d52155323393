/*リンクリスト*/
.Linklist {
  display: block; /* デフォルトは'none'なので、開閉できるように変更 */
  margin: 0; /* 余白を0に設定 */
  padding: 0; /* 余白を0に設定 */
}

.Linklist summary {
  cursor: pointer; /* カーソルをポインタに変更 */
  padding: 0.5em; /* 上下左右に1emの余白を設定 */
  background-color: #69AEFC; /* 背景色を設定 */
  font-weight: bold; /* 文字を太字にする */
}

.Linklist ul {
  list-style: none; /* デフォルトのリストマーカーを非表示 */
  margin: 0; /* 余白を0に設定 */
  padding: 0; /* 余白を0に設定 */
}

.Linklist li {
  margin-bottom: 0.1em; /* 各リストアイテムの下に余白を設定 */
}

