/*説明文のスタイル*/
#blog-title #blog-description {
  text-align: left;
  font-family: "Meiryo UI";
  font-size: 20px;
}

/*見出しサイズの変更　h3が大見出し　h4が中見出し*/
.entry-content h4{
font-size: 100%;
color: #2D5EFF;
}

/* 特大見出し（H2）を豪華な辞書風にする */
.entry-content h2 {
    color: #ffffff; /* 濃い背景で見えやすいように、文字色を白にします */
    font-size: 24px;
    padding: 0.2em 0.5em; /* 上下左右に上品な余白を持たせる */
    border-radius: 4px; /* 四隅をほんの少しだけ丸めて上品に */
    
    /* 上下を暗く、中央を明るくするグラデーション（青ベース） */
    background: linear-gradient(
        to bottom,
        #0f1950 0%,   /* 一番上のさらに暗いネイビー */
        #1a2a80 50%,  /* 中央のメインネイビー（ご提案の色） */
        #0f1950 100%  /* 一番下のさらに暗いネイビー */
    );
    
    /* さらに本のような立体感を出すための薄い影（お好みで） */
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 
                0 2px 4px rgba(0,0,0,0.15);
}

/* 大見出し（H3）を豪華な辞書風にする */
.entry-content h3 {
    color: #ffffff; /* 濃い背景で見えやすいように、文字色を白にします */
    font-size: 24px;
    padding: 0.2em 0.5em; /* 上下左右に上品な余白を持たせる */
    border-radius: 4px; /* 四隅をほんの少しだけ丸めて上品に */
    
    /* 上下を暗く、中央を明るくするグラデーション（青ベース） */
    background: linear-gradient(
        to bottom,
        #1c31cc 0%,   /* 一番上の暗い部分（#475dffを上品に暗くした青） */
        #475dff 50%,  /* 中央の明るい部分（主役の青） */
        #1c31cc 100%  /* 一番下の暗い部分（#475dffを上品に暗くした青） */
    );
    
    /* さらに本のような立体感を出すための薄い影（お好みで） */
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 
                0 2px 4px rgba(0,0,0,0.15);
}

/* 記事フォントの大きさ　世界標準は16px */
.entry-content p {font-size: 18px;}

/* スマホ用記事フォントの大きさ　世界標準は16px */
@media screen and (max-width: 480px){.entry-content p {font-size: 16px;}}

