      "id" : "CE71AD3B-2F0A-448B-AD00-851F9C156CC0",
      "backgroundName" : "2026-10-26_19-50.png",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、ふと気がつくと、そこには服が敗れた状態で、寝ているさとりの姿があった。そして、部屋の隅には、泣きながら眠るこいしの姿があった。",
      "characterName" : "操夢",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/2026-10-26_19-50-28.png",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 23",
      "seVolume" : 1,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.023.jpeg",
      "duration" : 10.28
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/弱った寝顔.png",
      "voiceDuration" : 9.038684807256235,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "slideTitle" : "スライド #24",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "seStartTimeOffset" : 7.36,
      "id" : "5BD9C742-4C2B-4246-81B7-A95ADF88BB91",
      "backgroundName" : "2026-10-26_19-50.png",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、それを頭で理解すると同時に、とてつもない恐怖心に襲われ、そのままずるずると後ずさる。すると、部屋の扉が開く。",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/ドアを開ける3.mp3",
