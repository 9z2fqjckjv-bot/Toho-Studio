    },
    {
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕はふとこいしの方を見ると、彼女には恐怖の表情を浮かべていた。僕は、そこで瞬時にこいしの前に立つ。",
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/2026-10-26_19-50-28.png",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/パジャマ恐怖.png",
      "voiceDuration" : 7.388684807256236,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "voice2StartTimeOffset" : 0,
      "id" : "69A935D5-8568-48F9-9258-B7090836FD1D",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.015.jpeg",
      "duration" : 7.388684807256236,
      "animationName" : "なし",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-10-26_19-50.png",
