      "telop" : "「あら、紅夢さん、どうしたんですか？私は妹を連れて帰るだけですよ。それとも…私がどうかしたのですか？」",
      "characterName" : "古明地さとり",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/2026-10-26_19-50-28.png",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/恐怖笑い.png",
      "voiceDuration" : 6.356984126984127,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_古明地さとり.wav",
      "voice2StartTimeOffset" : 0,
      "id" : "C47FEB1C-20B8-4D86-BF03-10CB68BFB36F",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.016.jpeg",
      "duration" : 6.356984126984127,
      "animationName" : "なし",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-10-26_19-50.png",
