      "title" : "シーン 19",
      "seVolume" : 1,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.019.jpeg",
      "duration" : 7.143038548752834
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/恐怖笑い.png",
      "voiceDuration" : 5.931179138321996,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_古明地さとり.wav",
      "slideTitle" : "スライド #20",
      "voiceCharacter" : "古明地さとり",
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "seStartTimeOffset" : 0,
      "id" : "E872EC8B-97D8-479D-B3CA-ABB96AAF3209",
      "backgroundName" : "2026-10-26_19-50.png",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "telop" : "「私は、古明地さとりですよ。あなたこそ、さっきから苦しそうにしてますけど？ほら、帰るわよこいし。」",
      "characterName" : "古明地さとり",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/2026-10-26_19-50-28.png",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 20",
      "seVolume" : 1,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.020.jpeg",
      "duration" : 5.931179138321996
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/恐怖笑い.png",
      "voiceDuration" : 7.283242630385487,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "slideTitle" : "スライド #21",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "seStartTimeOffset" : 0,
      "id" : "95DCAA4B-451D-4FF1-A489-6C05EBF510EC",
      "backgroundName" : "2026-10-26_19-50.png",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、彼女がこいしに手を伸ばすと、押さえ込んでいたものが浮き上がり、意識が途切れると、彼女に襲いかかった。",
      "characterName" : "操夢",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/2026-10-26_19-50-28.png",
