      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.021.jpeg",
      "duration" : 7.283242630385487
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/永琳.psd",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "5秒",
      "bgmName" : "BGM: nc97759_【東方アレンジ】千年幻想郷【ピアノとか笛】",
      "slideTitle" : "スライド #22",
      "animationDuration" : 5,
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "seStartTimeOffset" : 0,
      "id" : "7FB9E942-5A17-4391-924A-A181792FB535",
      "backgroundName" : "2026-10-26_19-50.png",
      "telop" : "主人公の担当医\n主人公の彼が抱える特殊な体つき について把握している担当医。妹 紅の母であり、彼から見ると祖母 にあたる。彼の複雑な体内構造を 心配し、文に前任校の調査を依頼 した。定期的に診察を行う傍ら、貴重な研究対象として彼を学園の手が届く範囲にいさせるよう隠岐奈に要望している。\n八意永琳",
      "characterName" : "射命丸文",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/2026-10-26_19-50-28.png",
      "bgmAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc97759_【東方アレンジ】千年幻想郷【ピアノとか笛】.mp3",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.25773633677991137,
      "title" : "シーン 22",
      "seVolume" : 1,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第25話_0e3b7087ae\/元女子校の日常　第25話_0e3b7087ae.022.jpeg",
      "duration" : 5
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/弱った寝顔.png",
      "voiceDuration" : 10.28,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
