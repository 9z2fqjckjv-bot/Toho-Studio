{
  "scenes" : [
    {
      "id" : "4EE184C9-DBA3-46EF-83F8-C17B375D2633",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 1",
      "voiceDuration" : 8.547369614512471,
      "telop" : "東方Project二次創作ポッドキャスト　Powerd by zuyasi\n第1回　zuyasi’sPodcast\n「こころ」　夏目漱石",
      "duration" : 9.14736961451247,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #1",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav"
    },
    {
      "id" : "98B5B019-ACD2-4774-AFD3-D1B0CEA0F837",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 2",
      "voiceDuration" : 2.938684807256236,
      "telop" : "私はその人を常に「先生」と呼んでいた。",
      "duration" : 3.538684807256236,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #2",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav"
    },
    {
      "id" : "D3BEF168-6D2C-46F5-A881-2B1AEB9EEF7D",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 3",
      "voiceDuration" : 3.5452154195011336,
      "telop" : "だからここでもただ先生と書くだけで本名は打ち明けない。",
      "duration" : 4.145215419501134,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #3",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav"
    },
    {
      "id" : "6FC3100A-F3EC-4C32-B316-D494114CA201",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 4",
      "voiceDuration" : 4.9321541950113374,
      "telop" : "これは世間を憚る遠慮というよりも、\nその方が私にとって自然だからである。",
      "duration" : 5.532154195011337,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav"
    },
    {
      "id" : "1F710BDF-E194-4912-8DE0-291025E9A97A",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 5",
      "voiceDuration" : 4.610430839002268,
      "telop" : "私はその人の記憶を呼び起こすごとに、\nすぐ「先生」といいたくなる。",
      "duration" : 5.210430839002267,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #5",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav"
    },
    {
      "id" : "4A1AA6A8-B1F7-4109-B80C-0E08E6C4FD74",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 6",
      "voiceDuration" : 2.449546485260771,
      "telop" : "筆を執っても心持は同じ事である。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #6",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav"
    },
    {
      "id" : "F1AB5D86-14A2-42C1-AB3C-86E4C206DE1F",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 7",
      "voiceDuration" : 3.1408616780045353,
      "telop" : "よそよそしい頭文字などはとても使う気になれない。",
      "duration" : 3.7408616780045354,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #7",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav"
    },
    {
      "id" : "70DC5912-4A45-4F55-8AB7-09D0069F7F72",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 8",
      "voiceDuration" : 3.0060770975056688,
      "telop" : "私が先生と知り合いになったのは鎌倉である。",
      "duration" : 3.606077097505669,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #8",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav"
    },
    {
      "id" : "B9885C15-8126-4945-89A4-C77CF82F04D6",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 9",
      "voiceDuration" : 2.7723809523809524,
      "telop" : "その時私はまだ若々しい書生であった。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav"
    },
    {
      "id" : "30B85C74-D447-4015-98B4-8C518E5FD4A1",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 10",
      "voiceDuration" : 8.838684807256236,
      "telop" : "暑中休暇を利用して海水浴に行った友達からぜひ来いという端書を受け取ったので、私は多少の金を工面して、出掛ける事にした。",
      "duration" : 9.438684807256235,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #10",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav"
    },
    {
      "id" : "3F6E899C-D015-4472-A8B9-AE7B53CB5210",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 11",
      "voiceDuration" : 2.956077097505669,
      "telop" : "私は金の工面に二、三日を費やした。",
      "duration" : 3.556077097505669,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #11",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"
    },
    {
      "id" : "3FDB2C47-4664-4828-9764-8124A3E5B199",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 12",
      "voiceDuration" : 8.044126984126985,
      "telop" : "ところが私が鎌倉に着いて三日と経たないうちに、私を呼び寄せた友達は、急に国元から帰れという電報を受け取った。",
      "duration" : 8.644126984126984,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #12",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav"
    },
    {
      "id" : "61B2494F-7350-41B6-8CB0-A56081B28883",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 13",
      "voiceDuration" : 5.015850340136055,
      "telop" : "電報には母が病気だからと断って\nあったけれども友達はそれを信じなかった。",
      "duration" : 5.615850340136054,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #13",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav"
    },
    {
      "id" : "2245C909-C5C9-4DE2-A546-0C442B373009",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 14",
      "voiceDuration" : 4.469115646258503,
      "telop" : "友達はかねてから国元にいる親たちに\n勧まない結婚を強いられていた。",
      "duration" : 5.069115646258503,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #14",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav"
    },
    {
      "id" : "C1427D15-963F-4205-B93A-F21589C90D86",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 15",
      "voiceDuration" : 4.156077097505669,
      "telop" : "彼は現代の習慣からいうと結婚するにはあまり年が若過ぎた。",
      "duration" : 4.756077097505669,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #15",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav"
    },
    {
      "id" : "B9E5F7B9-E871-4B41-93EE-8481B58DCF47",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 16",
      "voiceDuration" : 2.476734693877551,
      "telop" : "それに肝心の当人が気に入らなかった。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #16",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav"
    },
    {
      "id" : "A3AAEF0D-01A1-4572-BBE6-1B3631A19B74",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 17",
      "voiceDuration" : 5.645215419501134,
      "telop" : "それで夏休みに当然帰るべきところを、\nわざと避けて東京の近くで遊んでいたのである。",
      "duration" : 6.245215419501133,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #17",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav"
    },
    {
      "id" : "02F99B29-3097-4993-B7E7-8FB774485EB8",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 18",
      "voiceDuration" : 3.1256462585034015,
      "telop" : "彼は電報を私に見せてどうしようと相談をした。",
      "duration" : 3.7256462585034016,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #18",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav"
    },
    {
      "id" : "C50D9795-7689-4114-9B55-071C20284018",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 19",
      "voiceDuration" : 2.2158503401360545,
      "telop" : "私にはどうしていいか分らなかった。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #19",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav"
    },
    {
      "id" : "AE1B4B2C-487A-480F-9114-8E5242F0F9F8",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 20",
      "voiceDuration" : 4.659342403628118,
      "telop" : "けれども実際彼の母が病気であるとすれば\n彼は固より帰るべきはずであった。",
      "duration" : 5.259342403628118,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #20",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav"
    },
    {
      "id" : "CF959F27-8099-4130-9EFF-A811199ECE65",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 21",
      "voiceDuration" : 2.22891156462585,
      "telop" : "それで彼はとうとう帰る事になった。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #21",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav"
    },
    {
      "id" : "71060FEA-A0D1-4364-9B73-376FC3257382",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 22",
      "voiceDuration" : 2.4473696145124717,
      "telop" : "せっかく来た私は一人取り残された。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #22",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav"
    },
    {
      "id" : "C09ED89B-F6E5-453A-8BFB-5B10D31B9FF4",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 23",
      "voiceDuration" : 9.469115646258503,
      "telop" : "学校の授業が始まるにはまだ大分日数があるので鎌倉におってもよし、帰ってもよいという境遇にいた私は、当分元の宿に留まる覚悟をした。",
      "duration" : 10.069115646258503,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #23",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav"
    },
    {
      "id" : "8EC933AE-F251-4C01-AB4F-F2CA747D3D7B",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 24",
      "voiceDuration" : 10.518027210884354,
      "telop" : "友達は中国のある資産家の息子で金に不自由のない男であったけれども、学校が学校なのと年が年なので、生活の程度は私とそう変りもしなかった。",
      "duration" : 11.118027210884353,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #24",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav"
    },
    {
      "id" : "E2426D3E-3492-40B3-A304-78F355D5A1E2",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 25",
      "voiceDuration" : 5.458253968253969,
      "telop" : "したがって一人ぼっちになった私は別に\n恰好な宿を探す面倒ももたなかったのである。",
      "duration" : 6.058253968253968,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #25",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav"
    },
    {
      "id" : "CCF0375B-E2AF-4106-9C0F-50A95098F41A",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 26",
      "voiceDuration" : 2.559342403628118,
      "telop" : "宿は鎌倉でも辺鄙な方角にあった。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #26",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav"
    },
    {
      "id" : "F90D13A0-CCE5-47DD-8E8A-F90D99EEEE6C",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 27",
      "voiceDuration" : 5.946303854875284,
      "telop" : "玉突きだのアイスクリームだのというハイカラなものには長い畷を一つ越さなければ手が届かなかった。",
      "duration" : 6.546303854875283,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #27",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav"
    },
    {
      "id" : "0E6B6C57-8E62-4166-94E7-A146DC4DAD01",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 28",
      "voiceDuration" : 2.1039002267573697,
      "telop" : "車で行っても二十銭は取られた。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #28",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav"
    },
    {
      "id" : "3B5E8702-72CB-40A7-AF25-4C5E7F7DFEBE",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 29",
      "voiceDuration" : 4.564761904761904,
      "telop" : "それに海へはごく近いので海水浴を\nやるには至極便利な地位を占めていた。",
      "duration" : 5.164761904761904,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #29",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav"
    },
    {
      "id" : "4BC4684F-7CCE-40AB-8D3A-278140D03E48",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 30",
      "voiceDuration" : 2.316938775510204,
      "telop" : "私は毎日海へはいりに出掛けた。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #30",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav"
    },
    {
      "id" : "A6281735-6780-455F-8F68-6112E8E3F828",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 31",
      "voiceDuration" : 10.308253968253968,
      "telop" : "古い燻ぶり返った藁葺の間を通り抜けて磯へ下りると、この辺にこれほどの都会人種が住んでいるかと思うほど、避暑に来た男や女で砂の上が動いていた。",
      "duration" : 10.908253968253968,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #31",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav"
    },
    {
      "id" : "7670CEE0-7387-4831-8BC4-73DAE1B2971A",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 32",
      "voiceDuration" : 4.515850340136055,
      "telop" : "ある時は海の中が銭湯のように黒い頭で\nごちゃごちゃしている事もあった。",
      "duration" : 5.115850340136054,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #32",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav"
    },
    {
      "id" : "F829053D-B957-42C4-8B5C-490F469AC960",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 33",
      "voiceDuration" : 11.144126984126984,
      "telop" : "その中に知った人を一人ももたない私も、こういう賑やかな景色の中に裹まれて、砂の上に寝そべってみたり、膝頭を波に打たしてそこいらを跳ね廻るのは愉快であった。",
      "duration" : 11.744126984126984,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #33",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav"
    },
    {
      "id" : "8E3868B3-7A05-4BB3-AEF3-43882C49EFCA",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 34",
      "voiceDuration" : 3.749546485260771,
      "telop" : "私は実に先生をこの雑沓の間に見付け出したのである。",
      "duration" : 4.349546485260771,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #34",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav"
    },
    {
      "id" : "D6E69B20-2FE2-43F2-9155-2F5809A6B8F7",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 35",
      "voiceDuration" : 2.5463038548752834,
      "telop" : "その時海岸には掛茶屋が二軒あった。",
      "duration" : 3.5,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #35",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav"
    },
    {
      "id" : "F9CE5CD8-B914-4D11-8FBD-75BB8CA8F715",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 36",
      "voiceDuration" : 3.434331065759637,
      "telop" : "私はふとした機会からその一軒の方に行き慣れていた。",
      "duration" : 4.034331065759637,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #36",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav"
    },
    {
      "id" : "5775BA2C-463F-4397-B96E-877FEB17DD17",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 37",
      "voiceDuration" : 11.247369614512472,
      "telop" : "長谷辺に大きな別荘を構えている人と違って、各自に専有の着換場を拵えていないここいらの避暑客には、ぜひともこうした共同着換所といった風なものが必要なのであった。",
      "duration" : 11.847369614512472,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #37",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav"
    },
    {
      "id" : "50B9BA5B-40EE-4C22-935F-7725395D6DE9",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 38",
      "voiceDuration" : 10.171292517006803,
      "telop" : "彼らはここで茶を飲み、ここで休息する外に、ここで海水着を洗濯させたり、ここで鹹はゆい身体を清めたり、ここへ帽子や傘を預けたりするのである。",
      "duration" : 10.771292517006803,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #38",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav"
    },
    {
      "id" : "94FD51B9-B8B1-4683-BDFB-BA413F8040C2",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 39",
      "voiceDuration" : 8.1278231292517,
      "telop" : "海水着を持たない私にも持物を盗まれる恐れはあったので、\n私は海へはいるたびにその茶屋へ一切を脱ぎ棄てる事にしていた。",
      "duration" : 8.7278231292517,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #39",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav"
    },
    {
      "id" : "E18150F7-F45B-45BA-84B2-7E2159714448",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "title" : "シーン 40: 提供",
      "voiceDuration" : 13.535419501133786,
      "telop" : "このどうがは、あおぞらぶんこじょうのなつめそうせきのしょうせつ「こころ」およびとうほうぷろじぇくとをげんさくとし、がぞうしゅってんはあっぷるくりえいたーすたじおで、せいさくきょうりょくにぐろーくぼっと、せいさくしゃはずやしでおとどけしました。",
      "duration" : 14.135419501133786,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #40",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav"
    }
  ],
