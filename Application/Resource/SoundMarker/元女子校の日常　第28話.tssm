      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_パチュリー・ノーレッジ.wav",
      "pitch" : 115
    },
    {
      "voiceSymbol" : "カ'ノジョワ、ソ'ー\/イッテ、テ'オ\/コマネ'_ク。ボ'クワ、カ'ノジョノ\/ソ'バニ+タ'_ツ。スルト、カ'ノジョワ\/ナ'ニカノ\/ビ'ンオ\/テ'ニ+ト'リ、セツメーオ\/ハジメル。",
      "voiceTriggerEnabled" : false,
      "duration" : 8.972380952380952,
      "sceneIndex" : 71,
      "fadeOutDuration" : 0,
