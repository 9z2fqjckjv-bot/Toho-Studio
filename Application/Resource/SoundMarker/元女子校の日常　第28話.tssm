      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "「んっ…」僕は、ふと目が覚めると、窓から光が差し込んでいた。\n僕は、ふと動こうとすると、違和感に気がつく。\n東方Project二次創作作品",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "title" : "シーン 1"
    },
    {
      "id" : "9A6B7768-83A3-4FBE-90DA-C45A7DDB2E22",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "duration" : 8.65281179138322,
      "bgmStartTimeOffset" : 0,
