      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.041.jpeg",
      "bgmStartTimeOffset" : 0,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0
    },
