      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_レミリア・スカーレット.wav",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "「えっ、あなたがパチュリーがいない間、代わりに教員になるって、どういうこと？あなた教員資格はないんでしょ？」",
      "voiceDuration" : 7.12907029478458,
      "characterName" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "duration" : 7.12907029478458,
      "slideTitle" : "スライド #41",
