      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "すると、それから10分ほどで、彼女は元に戻り、背もたれを起こす。「もう大丈夫ですか、博士？」僕はそう、彼女に聞く。",
      "voiceDuration" : 9.177823129251701,
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 9.177823129251701,
