      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "僕はその箱を開け、中身を取り出して、彼女に飲ませる。",
      "voiceDuration" : 3.8843310657596373,
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 3.8843310657596373,
