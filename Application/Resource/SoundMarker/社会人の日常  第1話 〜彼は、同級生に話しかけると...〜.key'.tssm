      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "僕はすぐに、目的のものが入った箱を見つけ、\n手に取ると、彼女の元に向かう。",
      "voiceDuration" : 5.649546485260771,
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 5.649546485260771,
      "slideTitle" : "スライド #31",
