      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.031.jpeg",
      "bgmStartTimeOffset" : 0,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0
    },
    {
      "id" : "F828A9C6-693C-4589-BF25-C58C0E01B98A",
      "title" : "シーン 32",
      "backgroundName" : "5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg",
      "voiceCharacter" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第1話 〜彼は、同級生に話しかけると...〜\/パチュリー（大口影）.png",
      "bgmVolume" : 0.7,
