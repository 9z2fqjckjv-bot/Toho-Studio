      "transitionName" : "なし",
      "duration" : 8.318027210884354,
      "slideTitle" : "スライド #40",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.040.jpeg",
      "bgmStartTimeOffset" : 0,
