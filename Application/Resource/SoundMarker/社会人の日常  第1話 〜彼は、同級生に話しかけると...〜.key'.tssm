      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "「ええ、教員資格は取ってませんよ。ただ、学校側は、たとえ資格がなくとも、代替手段で臨時教員になって欲しいと…。」",
      "voiceDuration" : 8.697369614512471,
      "characterName" : "操夢",
