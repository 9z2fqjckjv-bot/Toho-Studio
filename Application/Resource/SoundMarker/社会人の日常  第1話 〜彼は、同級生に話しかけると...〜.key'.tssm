      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "telop" : "彼女はそういうと、突如地面に倒れ込み、ぜぇぜぇとした荒い息遣いをし始めた。そして、僕は、薬品棚の方に向かう。",
      "voiceDuration" : 8.666938775510204,
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.666938775510204,
      "slideTitle" : "スライド #30",
