      "bgmVolume" : 0.7
    },
    {
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "title" : "シーン 9",
      "animationName" : "なし",
      "telop" : "彼女はそう言いながら、僕の服をそっと掴む。僕は、それに気づかずに、ふわふわしながら感じる感触に身を任せるのだった。",
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "duration" : 9.20063492063492,
      "voiceCharacter" : "操夢",
      "id" : "17E54A22-3F96-4489-A8F9-1546920CAA8C",
