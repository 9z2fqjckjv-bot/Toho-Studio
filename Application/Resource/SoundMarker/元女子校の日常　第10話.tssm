      "title" : "シーン 59",
      "animationName" : "なし",
      "telop" : "「そうか…。彼に一言だけ、伝言してくれないか…？」",
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_霧雨魔理沙.wav",
      "duration" : 4.994489795918367,
      "voiceCharacter" : "霧雨魔理沙",
