      "title" : "シーン 39",
      "animationName" : "なし",
      "telop" : "僕は、その名刺を受け取ると、僕の名前を彼女に伝える。\nすると、彼女はどうやら、その名前を見知っているようだった。",
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
