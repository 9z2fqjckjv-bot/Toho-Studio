      "audioTrack" : "track_voice_reimu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 60",
      "animationName" : "なし",
      "telop" : "「何なの、伝言って？」私はそう言って、耳を立てて聞く。",
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_博麗霊夢.wav",
      "duration" : 5.809478458049886,
      "voiceCharacter" : "博麗霊夢",
      "id" : "9FA25D15-890D-4DD9-83B1-ED9E08386385",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0,
      "seVolume" : 1,
      "voice2StartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.060.jpeg",
      "slideTitle" : "スライド #60",
      "voiceDuration" : 5.209478458049887,
      "bgmVolume" : 0.7
    },
    {
      "transitionName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 61",
      "animationName" : "なし",
      "telop" : "「気を悪くしたのなら、すまない。これが、私が考えられる最善策と彼のための言葉なんだ。だから、彼にそう伝えてくれ。」",
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_霧雨魔理沙.wav",
      "duration" : 11.114489795918367,
      "voiceCharacter" : "霧雨魔理沙",
      "id" : "12C1133C-EDD3-48F4-B39B-D8DA2F8FE1EE",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0,
      "seVolume" : 1,
      "voice2StartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "characterName" : "霧雨魔理沙",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.061.jpeg",
      "slideTitle" : "スライド #61",
      "voiceDuration" : 10.514489795918367,
      "bgmVolume" : 0.7
    },
    {
      "transitionName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 62",
      "animationName" : "なし",
