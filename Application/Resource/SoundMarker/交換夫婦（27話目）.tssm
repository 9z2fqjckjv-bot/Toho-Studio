  "scenes" : [
    {
      "id" : "4ADA32A6-D5E7-4190-BB5E-27706EB49024",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_霧雨魔理沙.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png",
      "title" : "シーン 1",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 9.484489795918368,
      "characterName" : "霧雨魔理沙",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.001.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_marisa",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #1",
      "voiceDuration" : 8.884489795918368,
      "voiceCharacter" : "霧雨魔理沙",
      "telop" : "私たちがこの部屋に戻ってくると、霊夢たちがなぜか、怒っていた。「私たちがいない間に、何があったんだ？」\n今回の迷シーン"
    },
    {
      "id" : "C57F7FEC-A9A7-41E8-8E58-D62F10CB1636",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png",
      "title" : "シーン 2",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 9.111995464852606,
      "characterName" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.002.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #2",
      "voiceDuration" : 8.511995464852607,
      "voiceCharacter" : "博麗霊夢",
      "telop" : "「彼ったら、私たちが寝ている隙に、ささっと向こうに行ったのよ。私たちに、あんな体験させておいて…」"
    },
    {
      "id" : "483C5EB6-ECB1-4CBA-96C1-61C47BBEE2C8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_射命丸文.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/射命丸文\/射命丸文\/赤面\/文（怒る）.png",
      "title" : "シーン 3",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 8.571587301587302,
      "characterName" : "射命丸文",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.003.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #3",
      "voiceDuration" : 7.971587301587301,
      "voiceCharacter" : "射命丸文",
      "telop" : "「そうですよ。私たちに何も言わずに、東京に行ってしまった彼には、一言でもいいから、私たちを起こして欲しかったです…」"
    },
    {
      "id" : "73EAD1CE-04A9-4E9A-82F1-1677DB5CD683",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png",
      "title" : "シーン 4",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 5.064489795918367,
      "characterName" : "霧雨魔理沙",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.004.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_marisa",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #4",
      "voiceDuration" : 4.464489795918367,
      "voiceCharacter" : "霧雨魔理沙",
      "telop" : "私は、そんなことを言う二人に、ふっと笑いが漏れてしまう。"
    },
    {
      "id" : "882927BE-18C5-4689-85EA-A61E3F897DFB",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png",
      "title" : "シーン 5",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 4.711995464852607,
      "characterName" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.005.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #5",
      "voiceDuration" : 4.111995464852607,
      "voiceCharacter" : "博麗霊夢",
      "telop" : "「なんで、あんたは笑ってるのよ、それに、みんなも…」"
    },
    {
      "id" : "F14D50AC-BB44-4A8D-AAE0-C7CBB162C8F7",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png",
      "title" : "シーン 6",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 7.818231292517006,
      "characterName" : "霧雨魔理沙",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.006.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_marisa",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #6",
      "voiceDuration" : 7.2182312925170065,
      "voiceCharacter" : "霧雨魔理沙",
      "telop" : "「何だか、二人が駄々こねる子どもにそっくりだなって、\n感じたらふと、笑いが込み上げてくるぜ…」"
    },
    {
      "id" : "44625471-DBA4-4698-A0CE-CF3E13F848E3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_霧雨魔理沙.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（驚く）.png",
      "title" : "シーン 7",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 7.161995464852607,
      "characterName" : "霧雨魔理沙",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.007.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_marisa",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #7",
      "voiceDuration" : 6.5619954648526075,
      "voiceCharacter" : "霧雨魔理沙",
      "telop" : "すると、二人は「あっ」と声を出して驚く。\n「どうしたんだ、急に声出して驚いて…」"
    },
    {
      "id" : "E2A94AD0-6523-4730-987B-E5553C4CBEED",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_博麗霊夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/射命丸文\/射命丸文\/赤面\/文（困る）.png",
      "title" : "シーン 8",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 3.916984126984127,
      "characterName" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.008.jpeg",
