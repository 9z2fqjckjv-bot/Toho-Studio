      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.740861678004535,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.092.jpeg",
