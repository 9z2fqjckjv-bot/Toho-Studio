      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #80",
      "telop" : "「ええ、結構溜まってます。それと、こんな夜中に霊夢さんたちに電話かけるのは好ましくはないので…」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav",
      "voiceDuration" : 6.85172335600907
    },
    {
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.081.jpeg",
      "audioTrack" : "track_voice__DD8F",
      "id" : "DFC2CDCF-A7E5-47D2-AB34-04ABB6A58051",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.12546485260771,
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 81",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #81",
      "telop" : "「そうですか、それで、彼女たちにはどう伝えます？」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_ナレーション.wav",
      "voiceDuration" : 3.5254648526077097
    },
    {
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.082.jpeg",
      "audioTrack" : "track_voice_soumu",
      "id" : "348D1CFD-56B1-4106-AE96-55C81EF2C19D",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.376734693877552,
      "voiceCharacter" : "操夢",
      "title" : "シーン 82",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #82",
      "telop" : "「彼女たちには、お昼の飛行機の予約とって、ポケベルにチケット送ったので、それを使って乗ってくれと言ってくれますか？」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav",
      "voiceDuration" : 7.776734693877551
    },
    {
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.083.jpeg",
      "audioTrack" : "track_voice__DD8F",
      "id" : "3FB06565-3C02-42D9-ABEE-EDC98A117870",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.197006802721088,
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 83",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #83",
      "telop" : "「そうですか、承知しました。では、失礼します。」\n私はそう言うと、通話を切る。そして、操作盤を触る。",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_ナレーション.wav",
      "voiceDuration" : 8.597006802721088
    },
    {
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.084.jpeg",
      "audioTrack" : "track_voice__DD8F",
      "id" : "093C3721-3988-420B-A0A8-CB32C6ACE910",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.898208616780045,
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 84",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #84",
      "telop" : "確かに、彼の言っていた通り、彼女たちの名前で座席がとってあるようだった。「しかもこれ…トップシート…」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_ナレーション.wav",
      "voiceDuration" : 7.2982086167800455
    },
    {
      "animationName" : "なし",
      "id" : "3E31E1C1-DB5D-4EB0-AEF0-7E6EDBA8F0E6",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション",
      "voiceDuration" : 8.411904761904761,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.085.jpeg",
      "title" : "シーン 85",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_ナレーション.wav",
      "slideTitle" : "スライド #85",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "トップシートはYJAの中で最も運転室に近く、幅も広い、豪華で高価な席だ。「一体この出費はどこから…」",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__DD8F",
      "duration" : 9.011904761904761
    },
    {
      "animationName" : "なし",
      "id" : "98CBA355-56A7-4477-9263-307E320B0CA7",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "博麗霊夢",
      "voiceDuration" : 9.023242630385488,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.086.jpeg",
      "title" : "シーン 86",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_博麗霊夢.wav",
      "slideTitle" : "スライド #86",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "そして、あることを思い出す。そして、操作盤で調べると、霊夢さんが競馬で儲けたお金が充てがわれているようだった。",
      "characterName" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.623242630385487
    },
    {
      "animationName" : "なし",
      "id" : "E5CEE3E7-AF30-4F6D-B7AE-BDA87A23B402",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション",
      "voiceDuration" : 6.232018140589569,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.087.jpeg",
      "title" : "シーン 87",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_ナレーション.wav",
      "slideTitle" : "スライド #87",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "私は、その始末を見て思わず、笑いをこぼす。\n「彼女の…自業自得ね…」っと。",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__DD8F",
      "duration" : 6.832018140589569
    },
    {
      "animationName" : "なし",
      "id" : "B1F7704A-E6F0-426F-B4F6-2DBDE6056870",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション",
      "voiceDuration" : 4.273673469387755,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.088.jpeg",
      "title" : "シーン 88",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_ナレーション.wav",
      "slideTitle" : "スライド #88",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "そして、私は、操作盤から離れると、自室に向かった。",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__DD8F",
      "duration" : 4.873673469387755
    },
    {
      "title" : "シーン 89: 次回予告",
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "slideTitle" : "スライド #89",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.089.jpeg",
      "telop" : "次回予告",
      "characterName" : "博麗霊夢",
