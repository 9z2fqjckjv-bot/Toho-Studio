      "audioTrack" : "track_voice_reimu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #8",
      "voiceDuration" : 3.316984126984127,
      "voiceCharacter" : "博麗霊夢",
      "telop" : "「なんだか、恥ずかしいわ…、彼がいないと…」"
    },
    {
      "backgroundName" : "単色背景",
      "duration" : 3,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.009.jpeg",
      "transitionName" : "なし",
      "title" : "シーン 9: 東方Project二次創作 powerd by zuyasi　※前回の内容とは一部異なります。",
      "slideTitle" : "スライド #9",
      "telop" : "交換夫婦",
      "characterName" : "博麗霊夢",
      "id" : "E2B4E708-33EB-40B1-8265-D68177D7CA20",
      "animationName" : "なし"
    },
    {
      "id" : "CC1CC2E5-73AD-4D0B-A798-313483E7FBE7",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "title" : "シーン 10",
      "transitionName" : "なし",
      "animationName" : "なし",
      "duration" : 6.616938775510204,
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.010.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #10",
      "voiceDuration" : 6.016938775510204,
      "voiceCharacter" : "操夢",
      "telop" : "僕は、霊夢が寝静まった後、操作盤を触り続ける。"
    },
    {
      "slideTitle" : "スライド #11",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "今、僕はこの国の、いや、\nこの世の中の仕組みを一から書き換えている。",
      "title" : "シーン 11",
      "voiceDuration" : 4.899546485260771,
      "id" : "937916D1-A1A6-4AF5-B057-C24FBE3DBDF4",
      "duration" : 5.499546485260771,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.011.jpeg",
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"
    },
    {
      "slideTitle" : "スライド #12",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "僕は、文と霊夢の二人の寝顔を時折眺めながら、ふと考える。\nある種の覚悟を、僕は決めなければならない…。",
      "title" : "シーン 12",
      "voiceDuration" : 7.808253968253968,
      "id" : "C1B70A10-6A19-4EEC-852F-F85E8251B7EE",
      "duration" : 8.408253968253968,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.012.jpeg",
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav"
    },
    {
      "slideTitle" : "スライド #13",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "すると、誰かが部屋に入ってくる。",
      "title" : "シーン 13",
