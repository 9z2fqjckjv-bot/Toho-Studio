      "slideTitle" : "スライド #63"
    },
    {
      "slideTitle" : "スライド #64",
      "duration" : 7.583242630385487,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "telop" : "僕と彼女はそれから、今後のことを話し合っていた。\nその話し合いをしているうちに、日は沈んでしまった。",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "操夢",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.064.jpeg",
      "animationName" : "なし",
      "title" : "シーン 64",
      "transitionName" : "なし",
      "id" : "658779DE-D081-4076-8754-E088BA0000E8",
      "voiceDuration" : 6.9832426303854875,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "slideTitle" : "スライド #65",
      "duration" : 6.314761904761904,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "telop" : "気がつけば、時刻は夜の9時を超えていた。\n「こんな夜分にまで、ありがとうございました。」",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "操夢",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.065.jpeg",
      "animationName" : "なし",
      "title" : "シーン 65",
      "transitionName" : "なし",
      "id" : "477008F6-EA0D-4F6B-BB02-A7C1C01CFF92",
      "voiceDuration" : 5.714761904761905,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "slideTitle" : "スライド #66",
      "duration" : 7.91750566893424,
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "characterName" : "八雲紫",
      "telop" : "「いえいえ、貴方のご提案に、賛同させていただくことができ、ありがたいのこちらです。」私は、そう彼に返す。",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "八雲紫",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_八雲紫.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.066.jpeg",
      "animationName" : "なし",
      "title" : "シーン 66",
      "transitionName" : "なし",
      "id" : "896A7880-D119-4D79-96CF-1CAD13CC1E09",
      "voiceDuration" : 7.31750566893424,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "slideTitle" : "スライド #67",
      "duration" : 5.8278231292517,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "telop" : "「それで、すでに条件として掲示していた、\n居住要件は満たせているでしょうか？」",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "操夢",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.067.jpeg",
      "animationName" : "なし",
      "title" : "シーン 67",
      "transitionName" : "なし",
      "id" : "BC06AB4E-5352-4B4B-8E38-A107368F0305",
      "voiceDuration" : 5.227823129251701,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "slideTitle" : "スライド #68",
      "duration" : 9.40795918367347,
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "characterName" : "八雲紫",
      "telop" : "「ええ、つい先ほど、小休憩中に連絡があり、私の手下たちは、皆撤退したとの、報告が上がってますので、ご安心ください。」",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "八雲紫",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_八雲紫.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.068.jpeg",
      "animationName" : "なし",
      "title" : "シーン 68",
      "transitionName" : "なし",
      "id" : "869686F6-6E9E-4EC5-9EAA-85CACEF0CD64",
      "voiceDuration" : 8.80795918367347,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "slideTitle" : "スライド #69",
      "duration" : 6.43,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "telop" : "「そうですか…、ご対応ありがとうございます。\nそれで、これにて失礼させていただきます。」",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "操夢",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.069.jpeg",
      "animationName" : "なし",
      "title" : "シーン 69",
      "transitionName" : "なし",
      "id" : "6DA5E114-4CE1-45AE-A558-7594FB03433C",
      "voiceDuration" : 5.83,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "slideTitle" : "スライド #70",
      "duration" : 3.649546485260771,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "telop" : "僕はそう言うと、あの家に戻るために部屋を出た。",
      "backgroundName" : "nc196986_書斎(夜2).png",
      "voiceCharacter" : "操夢",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.070.jpeg",
      "animationName" : "なし",
      "title" : "シーン 70",
      "transitionName" : "なし",
      "id" : "96A41DD7-A9E3-4DDD-B2CA-0BBD620CF371",
      "voiceDuration" : 3.049546485260771,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc196986_書斎(夜2).png"
    },
    {
      "title" : "シーン 71",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #71",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.071.jpeg",
      "telop" : "視点が再び変わり…",
      "characterName" : "ナレーション",
      "duration" : 3.5,
      "transitionName" : "なし",
      "id" : "446FCCE4-CB8B-457F-ACFD-9DA569F9FD13"
    },
    {
      "slideTitle" : "スライド #72",
      "duration" : 9.423922902494331,
      "audioTrack" : "track_voice__DD8F",
      "characterName" : "ナレーション",
      "telop" : "私は、彼女たちに、部屋を割り振り、この部屋を去った後、しばし考え込んでいた。「彼が、あそこまで急成長するとは…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_ナレーション.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.072.jpeg",
      "animationName" : "なし",
      "title" : "シーン 72",
      "transitionName" : "なし",
      "id" : "67E3867F-A44F-4DFE-8207-57EBBA7CC8B7",
      "voiceDuration" : 8.823922902494331,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "slideTitle" : "スライド #73",
      "duration" : 9.423922902494331,
      "audioTrack" : "track_voice__DD8F",
      "characterName" : "ナレーション",
      "telop" : "私は、彼女たちに、部屋を割り振り、この部屋を去った後、しばし考え込んでいた。「彼が、あそこまで急成長するとは…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_ナレーション.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.073.jpeg",
      "animationName" : "なし",
      "title" : "シーン 73",
      "transitionName" : "なし",
      "id" : "B8679255-2E33-4612-84F4-A7675AB50C05",
      "voiceDuration" : 8.823922902494331,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "slideTitle" : "スライド #74",
      "duration" : 9.434875283446711,
      "audioTrack" : "track_voice__DD8F",
      "characterName" : "ナレーション",
      "telop" : "そして、操作盤を触り、彼の情報を開く。いずれ彼は、彼女たちにとっても、この国にとっても欠かせない存在になる…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_ナレーション.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.074.jpeg",
      "animationName" : "なし",
      "title" : "シーン 74",
      "transitionName" : "なし",
      "id" : "14AA7829-FE09-410A-B890-171FCB639968",
      "voiceDuration" : 8.834875283446712,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.075.jpeg",
      "audioTrack" : "track_voice__DD8F",
      "id" : "C0776F1C-2436-4843-B052-459283831BC4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/MaterialStudio\/AI_SE_電話の着信音_1791373515_120.wav",
      "duration" : 7.907959183673469,
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 75",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #75",
      "telop" : "そう感じさせるには、十分に値する情報量が、そこには表示されていた。すると、着信が入る。",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_ナレーション.wav",
      "voiceDuration" : 7.30795918367347,
      "seName" : "[SE] AI_SE_電話の着信音_1791373515_120.wav"
    },
    {
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.076.jpeg",
      "audioTrack" : "track_voice__DD8F",
      "id" : "9102A74C-ACDB-4464-A30B-39E25F14DFD2",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.5,
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 76",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #76",
      "telop" : "「彼の番号から着信です、出ますか？」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_ナレーション.wav",
      "voiceDuration" : 2.7604308390022676
    },
    {
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.077.jpeg",
      "audioTrack" : "track_voice_soumu",
      "id" : "CBF2DAF6-BE91-4510-AD4F-896E95B95562",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.85390022675737,
      "voiceCharacter" : "操夢",
      "title" : "シーン 77",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #77",
      "telop" : "「ええ、出て。」私がそう言い、着信に出ると、彼の声がする。\n「操夢さん、今どこにいますか？」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_操夢.wav",
      "voiceDuration" : 7.25390022675737
    },
    {
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.078.jpeg",
      "audioTrack" : "track_voice_soumu",
      "id" : "685D04CA-25C9-453A-B8A9-2C39822E880A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.049546485260771,
      "voiceCharacter" : "操夢",
      "title" : "シーン 78",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #78",
      "telop" : "「あの、交渉の後、無事に帰宅できたので、霊夢さんたちに、家に帰れるようになったと、伝えてほしくて。」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav",
      "voiceDuration" : 7.449546485260771
    },
    {
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.079.jpeg",
      "audioTrack" : "track_voice__DD8F",
      "id" : "7AB82AFD-BE2F-472A-A402-6F81E1773D11",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.290589569160997,
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 79",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #79",
      "telop" : "「そうですか、それで、何か疲労とかは感じますか？」",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_ナレーション.wav",
      "voiceDuration" : 3.6905895691609976
    },
    {
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.080.jpeg",
      "audioTrack" : "track_voice_soumu",
      "id" : "D2E9C9A9-28A4-49A2-990F-724121D79054",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
