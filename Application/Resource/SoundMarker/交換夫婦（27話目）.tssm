      "slideTitle" : "スライド #90",
      "transitionName" : "なし",
      "backgroundName" : "リビング（日中）.jpeg",
      "telop" : "僕は、その後よく眠り、一人目が覚めると、自室で朝食と身支度を済ませ、共同スペースに降りてくる。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "duration" : 7.8278231292517
    },
    {
      "animationName" : "なし",
      "id" : "027A9B7B-8995-464C-B049-C88038D1C20F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 4.027823129251701,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.091.jpeg",
      "title" : "シーン 91",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav",
      "slideTitle" : "スライド #91",
      "transitionName" : "なし",
      "backgroundName" : "リビング（日中）.jpeg",
      "telop" : "そして、ぼーっとしているのも暇だと感じ、ふらっと外に出る。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "duration" : 4.6278231292517
    },
    {
      "animationName" : "なし",
