      "id" : "5529A5E8-B80C-4CD1-AD8B-12A291A73C3B",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.030.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "characterName" : "にとり",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "duration" : 9.698684807256235,
      "slideTitle" : "スライド #30",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_にとり.wav",
      "title" : "シーン 30",
      "voiceCharacter" : "にとり",
      "telop" : "「紫様、例のFaxにある条件、本当に従うのですか？」\n私は、先ほどまでの電話を終えて、彼女にそう問いかける。",
      "voiceDuration" : 9.098684807256236,
      "animationName" : "なし"
    },
    {
      "id" : "2ACD9EB7-EE25-4B82-9A85-BF1E197B42E2",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.031.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "characterName" : "八雲紫",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "duration" : 3.609546485260771,
      "slideTitle" : "スライド #31",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_八雲紫.wav",
      "title" : "シーン 31",
      "voiceCharacter" : "八雲紫",
      "telop" : "「ええ、そうよ。それが何か言いたいのかしら？」",
      "voiceDuration" : 3.009546485260771,
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 32",
      "transitionName" : "なし",
      "voiceCharacter" : "にとり",
      "id" : "C7D462AB-2767-4EC1-9167-802AA7EC169B",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "telop" : "「その条件に従ったら、彼の支配下に入ることに許諾したことになりますよ。それで、よろしいのですか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_にとり.wav",
      "characterName" : "にとり",
      "duration" : 8.081292517006803,
      "slideTitle" : "スライド #32",
      "voiceDuration" : 7.4812925170068025,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.032.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 33",
      "transitionName" : "なし",
      "voiceCharacter" : "八雲紫",
      "id" : "2BA582DC-611B-4E5E-BF0E-EBEC3A0F10A0",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "telop" : "「それで、何かダメなことでもあるのかしら？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_八雲紫.wav",
      "characterName" : "八雲紫",
      "duration" : 3.5,
      "slideTitle" : "スライド #33",
      "voiceDuration" : 2.675578231292517,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.033.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 34",
      "transitionName" : "なし",
      "voiceCharacter" : "にとり",
      "id" : "197B327A-1D38-488C-9598-0549674483A6",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "telop" : "「確かにあの文書には、ゆかりん党の公約を実現すると、書いてありますが、彼がその公約を実現する保証はありませんよ。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_にとり.wav",
      "characterName" : "にとり",
      "duration" : 9.12439909297052,
      "slideTitle" : "スライド #34",
      "voiceDuration" : 8.524399092970521,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.034.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 35",
      "transitionName" : "なし",
      "voiceCharacter" : "にとり",
      "id" : "D26B05B4-70B0-447D-8B74-DE77909150E4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "telop" : "「私の立ち位置でこんなことを申し上げるのは失礼ですが、はっきり言って、条件に対する対価が良すぎる気がしますよ。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_にとり.wav",
      "characterName" : "にとり",
      "duration" : 8.441541950113379,
      "slideTitle" : "スライド #35",
      "voiceDuration" : 7.8415419501133785,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.035.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 36",
      "transitionName" : "なし",
      "voiceCharacter" : "八雲紫",
      "id" : "86C27A36-1B74-4884-A207-3FB62D1BE5E3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "telop" : "「確かにそうね…でも、世論が傾いてしまった今、私たちにできることっていうのは、これくらいしかないわよ。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_八雲紫.wav",
      "characterName" : "八雲紫",
      "duration" : 7.480884353741496,
      "slideTitle" : "スライド #36",
      "voiceDuration" : 6.8808843537414965,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.036.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 37",
      "transitionName" : "なし",
      "voiceCharacter" : "にとり",
      "id" : "56E76A44-B241-4827-96F3-184B7D9B7179",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "telop" : "「確かに、そうですね…、でもはっきり言って、私は信用できませんよ、彼の条件は。十分な覚悟が入りますよ。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_にとり.wav",
      "characterName" : "にとり",
      "duration" : 9.097006802721088,
      "slideTitle" : "スライド #37",
      "voiceDuration" : 8.497006802721089,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.037.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 38",
      "transitionName" : "なし",
      "voiceCharacter" : "にとり",
      "id" : "2B299F39-14DC-4ECD-BEB8-BEEC2C869BD1",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "telop" : "「何てたって、私の押し売りで、パソコンを数週間前に送りつけた元顧客ですから…、その彼があんな条件を出すとは…」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_にとり.wav",
      "characterName" : "にとり",
      "duration" : 8.819160997732427,
      "slideTitle" : "スライド #38",
      "voiceDuration" : 8.219160997732427,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.038.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 39",
      "transitionName" : "なし",
      "voiceCharacter" : "八雲紫",
      "id" : "684AEC4F-593E-461D-AA54-588457EF18D5",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "telop" : "「何か、忘れていることはないかしら、にとり。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_八雲紫.wav",
      "characterName" : "八雲紫",
      "duration" : 3.6415192743764173,
      "slideTitle" : "スライド #39",
      "voiceDuration" : 3.0415192743764172,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.039.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 40",
      "transitionName" : "なし",
      "voiceCharacter" : "にとり",
      "id" : "E069B5EA-4B1D-4389-8EBC-A3C8EB2BCE84",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "telop" : "「それも承知の上ですよ。何より彼の存在には、島送りにした彼女も絡んでますから、理解した上で、ですよ。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_にとり.wav",
      "characterName" : "にとり",
      "duration" : 8.816054421768706,
      "slideTitle" : "スライド #40",
      "voiceDuration" : 8.216054421768707,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.040.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 41",
      "transitionName" : "なし",
      "voiceCharacter" : "八雲紫",
      "id" : "FCF3323C-6CEA-4509-A8EE-57EB29123136",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "telop" : "「そうね…」私がそういうと、戸がノックされる。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_八雲紫.wav",
      "characterName" : "八雲紫",
      "duration" : 3.5812925170068026,
      "slideTitle" : "スライド #41",
      "voiceDuration" : 2.9812925170068025,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.041.jpeg",
      "animationName" : "なし"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "voiceDuration" : 7.337959183673469,
      "voiceCharacter" : "にとり",
      "transitionName" : "なし",
      "telop" : "「私は、紫様が、どうなっても知りませんからね…」\n私はそう彼女に言い残すと、部屋から出ていった。",
      "id" : "386F3D03-0C0C-4C08-8123-59EB5F0CBD46",
      "animationName" : "なし",
      "duration" : 7.937959183673469,
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 42",
      "slideTitle" : "スライド #42",
      "characterName" : "にとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.042.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_にとり.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg",
      "voiceDuration" : 7.475578231292517,
      "voiceCharacter" : "八雲紫",
      "transitionName" : "なし",
      "telop" : "すると、彼女と入れ替わるように、藍が入ってくる。\nそして、彼女のその言葉に、深呼吸をすると、部屋を出た。",
      "id" : "9A2FF0EA-6D6E-4A4E-8E8F-15A6EC0D8F0D",
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲藍\/八雲藍(バトルっぽい)\/赤面\/藍（困る）.png",
      "duration" : 8.075578231292518,
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc222578_会議室1-2.jpg",
      "title" : "シーン 43",
      "slideTitle" : "スライド #43",
      "characterName" : "八雲紫",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.043.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_八雲紫.wav"
    },
    {
      "voiceDuration" : 8.769115646258504,
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕が、東京の某所に入ると、ある部屋に案内され、そこで、待たされる。そして、数分程度でその人物が入ってくる。",
      "id" : "3C9F006E-53A8-485F-A84A-10DCD0B9B9F5",
      "animationName" : "なし",
      "duration" : 9.369115646258503,
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc196984_書斎(夕).png",
      "title" : "シーン 44",
      "slideTitle" : "スライド #44",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.044.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav"
    },
    {
      "voiceDuration" : 2.23,
      "voiceCharacter" : "八雲紫",
      "transitionName" : "なし",
      "telop" : "「ようこそ…と言った方がいいかしら…？」",
      "id" : "D8291F7B-0842-4CDD-8956-FD2123CE521B",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "animationName" : "なし",
      "duration" : 3.5,
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc196984_書斎(夕).png",
      "title" : "シーン 45",
      "slideTitle" : "スライド #45",
      "characterName" : "八雲紫",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.045.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_八雲紫.wav"
    },
    {
      "voiceDuration" : 5.373469387755102,
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「いえ、定型の挨拶は不要ですよ…総理。」\n僕は、そう彼女に返す。",
      "id" : "69DB07B8-4563-4601-B5C9-2D8E73CAF4AA",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "animationName" : "なし",
      "duration" : 5.9734693877551015,
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc196984_書斎(夕).png",
      "title" : "シーン 46",
      "slideTitle" : "スライド #46",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.046.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav"
    },
    {
      "voiceDuration" : 3.4241043083900227,
      "voiceCharacter" : "八雲紫",
      "transitionName" : "なし",
      "telop" : "「そう、それじゃあ、早速本題を聞かせてくれるかしら？」",
      "id" : "3EA858DD-4E4C-481F-A475-1A97D91CA678",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png",
      "animationName" : "なし",
      "duration" : 4.024104308390022,
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc196984_書斎(夕).png",
      "title" : "シーン 47",
      "slideTitle" : "スライド #47",
      "characterName" : "八雲紫",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.047.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_八雲紫.wav"
    },
    {
      "voiceDuration" : 7.022380952380952,
      "voiceCharacter" : "操夢",
