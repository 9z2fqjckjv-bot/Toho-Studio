  "scenes" : [
    {
      "title" : "シーン 1: @zuyasi　東方Project二次創作作品",
      "duration" : 6,
      "characterName" : "博麗霊夢",
      "id" : "096A0FFC-130A-4630-95D0-1EF77CAA2398",
      "backgroundName" : "単色背景",
      "animationName" : "バウンス",
      "transitionName" : "なし",
      "telop" : "幼き日の夢",
      "slideTitle" : "スライド #1",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.001.jpeg",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第14話_default\/slide_001_anim.m4v"
    },
    {
      "id" : "16638CA9-5E99-4F47-BDE6-BD5A907E7D8C",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 2",
      "telop" : "僕は、霊夢に渡された箱に入っていた弾を手に持ち、軽く振る。\nそして、その音を確認すると、弾を詰めて、部屋を出る。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.002.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg",
      "characterName" : "操夢",
      "backgroundName" : "nc467347_和室【フリー素材あそび】.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #2",
      "animationName" : "なし",
      "duration" : 9.456077097505668,
      "voiceDuration" : 8.856077097505668,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav"
    },
    {
      "id" : "50866962-75B5-4F48-8714-7123A4C2FB4E",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 3",
      "telop" : "僕が外に出ると、紫がそこにいた。\n「霊夢さんは、どうしたんですか？」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.003.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #3",
      "animationName" : "なし",
      "duration" : 5.521292517006803,
      "voiceDuration" : 4.921292517006803,
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_003_操夢.wav"
    },
    {
      "id" : "A4346C5F-E014-4840-947F-E48255EF1E26",
      "voiceCharacter" : "八雲紫",
      "transitionName" : "なし",
      "title" : "シーン 4",
      "telop" : "「彼女なら、そこにいるわよ。」\n私は、そう言いながら、指を刺す。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.004.jpeg",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "slideTitle" : "スライド #4",
      "animationName" : "なし",
      "duration" : 5.188775510204081,
      "voiceDuration" : 4.588775510204082,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_八雲紫.wav"
    },
    {
      "id" : "FF6AB079-013D-4335-8F69-D84BB522D387",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 5",
      "telop" : "僕は、霊夢の方を見る。一瞬だが、手と足を縛られているように見えた。そして、紫が迫るのを感じ取り、神経を集中させる。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.005.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #5",
      "animationName" : "なし",
      "duration" : 10.0756462585034,
      "voiceDuration" : 9.475646258503401,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav"
    },
    {
      "id" : "88AE0AA4-F32D-46FB-86E4-C3E51B13DFAB",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 6",
      "telop" : "僕は、彼女に襲われる直前に、口を塞ぐ。そして、\n一瞬だけ、塞いだ手をどけ、弾を彼女の口内に打ち込む。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.006.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #6",
      "animationName" : "なし",
      "duration" : 9.123469387755101,
      "voiceDuration" : 8.523469387755101,
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_006_操夢.wav"
    },
    {
      "id" : "8F661843-915E-4EB3-B210-6E13F5643A50",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3",
      "title" : "シーン 7",
      "telop" : "すると、紫は倒れ込み、気絶した。僕は、霊夢の方に駆け寄る。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.007.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #7",
      "seName" : "SE: 倒れる",
      "animationName" : "なし",
      "duration" : 5.7647619047619045,
      "voiceDuration" : 5.164761904761905,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav"
    },
    {
      "id" : "4DA97C8A-BB66-4499-A6C8-9E216AF9CF19",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 8",
      "telop" : "僕は、霊夢のもとに来ると、彼女の状態を確認する。\nそして、彼女の肩に、勢いよく手で叩く。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.008.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #8",
      "animationName" : "なし",
      "duration" : 8.116938775510205,
      "voiceDuration" : 7.516938775510204,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav"
    },
    {
      "id" : "8769F24F-246A-47E4-87A9-C544CE94F4DA",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "title" : "シーン 9",
      "telop" : "「ありがとう、操夢。おかげで金縛りが解けたわ…」\n私はそう返す。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.009.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #9",
      "animationName" : "なし",
      "duration" : 6.3119954648526075,
      "voiceDuration" : 5.711995464852608,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_博麗霊夢.wav"
    },
    {
      "id" : "5B4D482E-2B0B-47AD-8E08-D79CA9FC54A6",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 10",
      "telop" : "「紫さんの容体が気になりますか？」僕はそう彼女に尋ねる。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.010.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #10",
      "animationName" : "なし",
      "duration" : 5.027823129251701,
      "voiceDuration" : 4.427823129251701,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav"
    },
    {
      "id" : "9ADB386E-5A44-4860-8FAA-7168C0A30720",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "title" : "シーン 11",
      "telop" : "「ええ…、金縛りにされたけど…、気になって…。」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.011.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #11",
      "animationName" : "なし",
      "duration" : 4.055736961451247,
      "voiceDuration" : 3.455736961451247,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav"
    },
    {
      "id" : "E80DA3ED-335A-4046-A9D5-58EE4DEF5C46",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ1.mp3",
      "title" : "シーン 12",
      "telop" : "僕は、彼女がそう言うと、そっと背中に周り頭を撫でる。\n「大丈夫ですよ、一時的な衝撃で、いずれ目が覚めますから。」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.012.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #12",
      "seName" : "[SE] 衣擦れ1.mp3",
      "animationName" : "なし",
      "duration" : 9.188684807256235,
      "voiceDuration" : 8.588684807256236,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav"
    },
    {
      "id" : "DC0FA4B5-77CF-4E8E-9C34-8D2D9AD016DD",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ1.mp3",
      "title" : "シーン 13",
      "telop" : "「そう…」\n私は、なんだか羞恥心が刺激されるような感覚を味わう。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.013.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #13",
      "seName" : "[SE] 衣擦れ1.mp3",
      "animationName" : "なし",
      "duration" : 6.014489795918367,
      "voiceDuration" : 5.414489795918367,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_博麗霊夢.wav"
    },
    {
      "id" : "64C7D29F-B6DE-4555-B5EC-028D18AE858F",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ1.mp3",
      "title" : "シーン 14",
      "telop" : "「それで、これから、霊夢さんはどうしますか？」\n僕は、彼女の頭を撫でながら、そう尋ねる。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.014.jpeg",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #14",
      "seName" : "[SE] 衣擦れ1.mp3",
      "animationName" : "なし",
      "duration" : 7.279999999999999,
      "voiceDuration" : 6.68,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav"
    },
    {
      "id" : "66DA6658-3D08-41C5-A001-C5FCFC134393",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ1.mp3",
      "title" : "シーン 15",
      "telop" : "「ねぇ、操夢…」\n私は、勇気を振り絞り、彼の方に振り返る。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.015.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #15",
      "seName" : "[SE] 衣擦れ1.mp3",
      "animationName" : "なし",
      "duration" : 6.074489795918367,
      "voiceDuration" : 5.474489795918367,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_博麗霊夢.wav"
    },
    {
      "id" : "9B2AC5DB-49F1-4008-9225-70C15A36ADA7",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "title" : "シーン 16",
      "telop" : "「私と…」私がその言葉を言うと、彼は微笑む。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.016.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #16",
      "animationName" : "なし",
      "duration" : 4.846984126984126,
      "voiceDuration" : 4.246984126984127,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav"
    },
    {
      "id" : "1C8652F3-C464-4369-B0BB-678DDE18E87E",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "title" : "シーン 17",
      "telop" : "「いいですよ、霊夢さん。」僕は、そう彼女に返す。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.017.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #17",
      "animationName" : "なし",
      "duration" : 4.525646258503401,
      "voiceDuration" : 3.9256462585034013,
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_017_博麗霊夢.wav"
    },
    {
      "id" : "EC16B92A-C7DE-4086-B79E-DC92EBC73EBD",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "title" : "シーン 18",
      "telop" : "「ありがとう…」ふと私は、そう呟く。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.018.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #18",
      "animationName" : "なし",
      "duration" : 3.8344897959183672,
      "voiceDuration" : 3.234489795918367,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_博麗霊夢.wav"
    },
    {
      "id" : "BFEB6529-4004-4B59-BCBD-2BE052C2D744",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 19",
      "telop" : "「ただ、その前に、僕がここに来た目的を果たしますね…。\nそれまでの間、ここで待っててくれますか？」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.019.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png",
      "characterName" : "操夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #19",
      "animationName" : "なし",
      "duration" : 7.7995464852607705,
      "voiceDuration" : 7.199546485260771,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav"
    },
    {
      "id" : "128CD867-910C-41E1-8EDF-596365D574AE",
      "voiceCharacter" : "博麗霊夢",
      "transitionName" : "なし",
      "title" : "シーン 20",
      "telop" : "「ええ、もちろん。」私は、そう返すと、彼は去っていった。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.020.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73543_【背景素材】守矢神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "スライド #20",
      "animationName" : "なし",
      "duration" : 5.768231292517006,
      "voiceDuration" : 5.168231292517007,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_博麗霊夢.wav"
    },
    {
      "animationDuration" : 3,
      "animationNote" : "表示時間：3秒",
      "id" : "95650797-C5E5-40BC-99EC-ADC96CB0D378",
      "transitionName" : "なし",
      "title" : "シーン 21",
      "telop" : "最終回予告…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.021.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #21",
      "animationName" : "なし",
      "duration" : 3
    },
    {
      "id" : "0E2DEAB9-9A41-4474-A2FC-39251305E273",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 22",
      "telop" : "僕は、守谷神社を離れると、とある施設の一室に入っていた。\nこの施設は、紅魔館の図書館で文献を見つけ出した施設だ。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.022.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #22",
      "animationName" : "なし",
      "duration" : 9.469115646258503,
      "voiceDuration" : 8.869115646258503,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav"
    },
    {
      "id" : "5ABAA59E-D751-411D-AD87-C753C74A8304",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 23",
      "telop" : "そして、僕は、その施設に溜まっていた埃を、換気して外に出すと、操作盤の前に立ち、ここに来た目的を徐々に果たしていく。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.023.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #23",
      "animationName" : "なし",
      "duration" : 9.58,
      "voiceDuration" : 8.98,
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_023_操夢.wav"
    },
    {
      "id" : "22A0B01E-B217-4212-892B-6575A43D14BC",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "title" : "シーン 24",
      "telop" : "そして、それを成し遂げると、紫が現れるのだった。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第14話_f60c3cede5\/第14話_f60c3cede5.024.jpeg",
