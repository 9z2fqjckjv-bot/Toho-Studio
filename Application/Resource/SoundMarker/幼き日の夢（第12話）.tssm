      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "duration" : 7.053900226757369,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.017.jpeg",
      "telop" : "「わかりました、じゃあ、レミリアさんたちが、皆向こうで、寝ているので、少し待っててください。」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png"
    },
    {
      "voiceCharacter" : "操夢",
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
