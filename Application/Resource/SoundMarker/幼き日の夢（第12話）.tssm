      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "slideTitle" : "第16スライド",
      "telop" : "「ええ、お願いします…」\n私は、彼の言葉に対して、手短に返す。",
      "voiceCharacter" : "十六夜咲夜",
      "title" : "シーン 16",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png",
      "duration" : 5.006190476190476,
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "id" : "E1AF6512-C4BD-4D85-A824-85658CAF9726",
      "voiceDuration" : 4.406190476190476,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.016.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_十六夜咲夜.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第17スライド",
      "telop" : "「わかりました、じゃあ、レミリアさんたちが、皆向こうで、寝ているので、少し待っててください。」",
      "voiceCharacter" : "操夢",
      "title" : "シーン 17",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png",
      "duration" : 7.053900226757369,
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "id" : "C8465DA3-97B1-4481-BB34-BDE41C73CF37",
      "voiceDuration" : 6.453900226757369,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.017.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第18スライド",
      "telop" : "僕はそういうと、咲夜とすれ違い、食堂に向かう。",
      "voiceCharacter" : "操夢",
      "title" : "シーン 18",
      "duration" : 4.25172335600907,
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "id" : "9D52E64D-2F66-4EB6-85B7-A96C5E5440D7",
      "voiceDuration" : 3.6517233560090703,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.018.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav"
    },
    {
      "backgroundName" : "nc196979_食堂(昼).png",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第19スライド",
      "telop" : "僕は、そういうと、食堂にやってくる。そして、２つのコップを取り出して、紅茶を注ぎ込むと、コップを持ち、戻っていく。",
      "voiceCharacter" : "操夢",
      "title" : "シーン 19",
      "duration" : 9.258253968253968,
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "id" : "F72A9F6C-DD5C-4C75-AA80-8B43D0A56636",
      "voiceDuration" : 8.658253968253968,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.019.jpeg"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第20スライド",
      "telop" : "僕が、図書館に戻ると、テーブルにコップを置き、咲夜を呼ぶ。",
      "voiceCharacter" : "操夢",
      "title" : "シーン 20",
      "duration" : 4.9039002267573695,
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "id" : "6A00BC43-0834-415A-94D1-1BC8D09469B5",
      "voiceDuration" : 4.30390022675737,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.020.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第21スライド",
      "telop" : "「それで、ここ最近は彼女たちの様子はどうでしたか？」\n僕は、一瞬、寝ているレミリアたちに目を向けてから、いう。",
      "voiceCharacter" : "操夢",
      "title" : "シーン 21",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
      "duration" : 8.566938775510204,
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "id" : "16A178C9-1A1E-4775-9B56-A4235C42AE27",
      "voiceDuration" : 7.966938775510204,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.021.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "slideTitle" : "第22スライド",
      "telop" : "「ここ最近は、フラン様が、ご乱心になる回数や、その威力が、これまでより凄まじいものでして…」",
      "voiceCharacter" : "十六夜咲夜",
      "title" : "シーン 22",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
      "duration" : 6.5088888888888885,
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "id" : "C05499FA-FAFC-4C33-8CE4-1C445191FCAB",
      "voiceDuration" : 5.908888888888889,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.022.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_十六夜咲夜.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第23スライド",
      "telop" : "「何か、心当たりとかはありますか？」\n僕は、念の為に、彼女に尋ねる。",
      "voiceCharacter" : "操夢",
      "title" : "シーン 23",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
      "duration" : 6.3691156462585035,
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "id" : "AE009E33-4B29-46D0-A3D7-8DE3C1539995",
      "voiceDuration" : 5.769115646258504,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.023.jpeg",
