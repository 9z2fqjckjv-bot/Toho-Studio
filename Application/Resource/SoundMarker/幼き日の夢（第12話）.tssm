      "transitionName" : "クロスディゾルブ",
      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第15スライド",
      "telop" : "「何か、飲み物を持ってきて、休憩にしますか？」",
      "voiceCharacter" : "操夢",
      "title" : "シーン 15",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png",
