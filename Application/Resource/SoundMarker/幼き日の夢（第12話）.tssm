      "animationName" : "なし",
      "characterName" : "操夢",
      "slideTitle" : "第25スライド",
      "telop" : "「そうですか…」僕は、そう言いながら、これからのプランを頭の中に構築していく。そして、その内容を彼女に話すのだった。",
      "voiceCharacter" : "操夢",
      "title" : "シーン 25",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
      "duration" : 9.389773242630385,
