  "scenes" : [
    {
      "duration" : 3,
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第12話_432572eca5\/slide_001_anim.m4v",
      "id" : "D94877B6-6B33-4D34-B20D-353CDB77E7C7",
      "animationName" : "バウンス",
      "backgroundName" : "単色背景",
      "transitionName" : "クロスディゾルブ",
      "slideTitle" : "スライド #1",
      "characterName" : "博麗霊夢",
      "title" : "シーン 1: @zuyasi　東方Project二次創作作品",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.001.jpeg",
      "telop" : "幼き日の夢"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "C79E2DD4-1EA6-438B-A9DA-6BD4155E351D",
      "title" : "シーン 2",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc213186_紅魔館ロビー.jpeg",
      "slideTitle" : "スライド #2",
      "voiceDuration" : 10.424489795918367,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav",
      "duration" : 11.024489795918367,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.002.jpeg",
      "telop" : "私は、紫が立ち去り、ただ一人、紅魔館の玄関に取り残された。\nそして、しばらく経ち、ここに来た目的を思い出す。"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "7700E813-5B41-4C7D-B2C4-199900FDD09D",
      "title" : "シーン 3",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc213186_紅魔館ロビー.jpeg",
      "slideTitle" : "スライド #3",
      "voiceDuration" : 6.094489795918367,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_博麗霊夢.wav",
      "duration" : 6.694489795918367,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.003.jpeg",
      "telop" : "「彼は…どこかしら…」\n私はそう呟きながら、彼の姿を探し始める。"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "B960AA4B-3FA2-4361-AB5E-7AF20D94CDDB",
      "title" : "シーン 4",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #4",
      "voiceDuration" : 8.265736961451248,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_博麗霊夢.wav",
      "duration" : 8.865736961451248,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.004.jpeg",
      "telop" : "そして、玄関から見て正面の大きな扉を開け、中に入る。\nだが、その空間には誰もいなかった。"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "83CBA43E-A07E-429B-8B11-761028B6A70E",
      "title" : "シーン 5",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc196979_食堂(昼).png",
      "slideTitle" : "スライド #5",
      "voiceDuration" : 9.461995464852608,
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav",
      "duration" : 10.061995464852608,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.005.jpeg",
      "telop" : "そして、食堂にやってくる。だが、彼の姿はない。\n私は、その足取りのまま、大図書館の方へと向かう。"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "4CF77017-AE43-4D1D-AA1E-C80A02BF1F26",
      "title" : "シーン 6",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #6",
      "voiceDuration" : 7.569478458049887,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_博麗霊夢.wav",
      "duration" : 8.169478458049888,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.006.jpeg",
      "telop" : "私が大図書館に来ると、そこは暗闇が広がっていた。\nだが私は、そのまま足を進める。"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "8EFF0894-A5A0-4527-B365-96EC24B7A317",
      "title" : "シーン 7",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #7",
      "voiceDuration" : 2.4194784580498867,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav",
      "duration" : 3.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.007.jpeg",
      "telop" : "すると、誰かと肩がぶつかる。"
    },
    {
      "voiceCharacter" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "animationName" : "なし",
      "id" : "3B9D9304-5F4E-460C-9F46-7227D4EBEC4B",
      "title" : "シーン 8",
      "characterName" : "十六夜咲夜",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #8",
      "voiceDuration" : 7.392993197278911,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_十六夜咲夜.wav",
      "duration" : 7.992993197278911,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.008.jpeg",
      "telop" : "私は、彼に依頼され、図書館の見回りをしていると、誰かと肩がぶつかり、時を止めて確認すると、そこには彼女がいた。"
    },
    {
      "voiceCharacter" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "animationName" : "なし",
      "id" : "6F27E822-B1F1-4485-8B2A-06B1F158810B",
      "title" : "シーン 9",
      "characterName" : "十六夜咲夜",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #9",
      "voiceDuration" : 5.517981859410431,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_十六夜咲夜.wav",
      "duration" : 6.11798185941043,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.009.jpeg",
      "telop" : "私は、彼に言われたことを思い出し、彼女をそっと抱き上げると、そのまま紅魔館の外に向かう。"
    },
    {
      "voiceCharacter" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "animationName" : "なし",
      "id" : "BA9F46DF-529C-4856-ABCF-03942CC4E872",
      "title" : "シーン 10",
      "characterName" : "十六夜咲夜",
      "backgroundName" : "nc73544_【背景素材】紅魔館.jpg",
      "slideTitle" : "スライド #10",
      "voiceDuration" : 6.897687074829932,
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_十六夜咲夜.wav",
      "duration" : 7.497687074829932,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.010.jpeg",
      "telop" : "そして、外まで来ると、彼女を門扉の外で降ろす。\n私は、そのまま寂しく微笑むと、図書館に戻っていった。"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "id" : "C060D9AB-0F89-4718-8E3C-795D81F96222",
      "title" : "シーン 11",
      "characterName" : "博麗霊夢",
      "backgroundName" : "nc73544_【背景素材】紅魔館.jpg",
      "slideTitle" : "スライド #11",
      "voiceDuration" : 10.641995464852608,
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav",
      "duration" : 11.241995464852607,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.011.jpeg",
      "telop" : "私は、ハッと気がつくと、そこは紅魔館の門扉の前だった。\n「なぜ、私を外に出すの…咲夜…」私はそう呟くのだった。"
    },
    {
      "voiceCharacter" : "操夢",
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "animationName" : "なし",
      "id" : "8AF62AD8-EF76-4CA2-B06F-6C241EC283AA",
      "title" : "シーン 12",
      "characterName" : "操夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #12",
      "voiceDuration" : 7.475646258503401,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "duration" : 8.0756462585034,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.012.jpeg",
      "telop" : "「誰かが、図書館に入ってきたのですか？」\n僕は、彼女の表情から、思考を推測し、そう尋ねる。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png"
    },
    {
      "voiceCharacter" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "animationName" : "なし",
      "id" : "8CEB385C-2EC5-45DE-9A45-3D672995326F",
      "title" : "シーン 13",
      "characterName" : "十六夜咲夜",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
