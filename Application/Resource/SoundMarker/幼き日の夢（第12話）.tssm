    {
      "voiceType" : "女声1 (標準)",
      "pan" : -0.2,
      "isReversed" : false,
      "voiceSymbol" : "ワタシワ、ムラ'サキガ\/タ_チサリ、タ'ダ_ヒトリ、コーマ'カンノ\/ゲ'ンカンニ\/トリノコサ'レタ。ソ_シテ、シバ'ラ_ク+タ'_チ、ココニ\/キ'タ\/モ_クテキオ\/オモイダ'_ス。",
      "volume" : 1,
      "id" : "9F5928C5-08F5-40C3-A416-BD3CCE7390EC",
      "name" : "[博麗霊夢] 私は、紫が立ち去り、ただ一人、紅魔館の玄関に取り残された。そして、しばらく経ち、ここに来た目的を思い出す。",
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav",
