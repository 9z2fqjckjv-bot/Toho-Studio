      "id" : "DD1ED76E-C7A4-405B-94B7-38B385731C8D",
      "title" : "シーン 18",
      "characterName" : "操夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #18",
