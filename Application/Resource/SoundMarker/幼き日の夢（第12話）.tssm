      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "slideTitle" : "第24スライド",
      "telop" : "「いえ、特には…」",
      "voiceCharacter" : "十六夜咲夜",
      "title" : "シーン 24",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
      "duration" : 3.5,
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "id" : "23DD2A0E-19FA-4EDD-B0F5-40139064460B",
      "voiceDuration" : 1.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.024.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_十六夜咲夜.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg",
