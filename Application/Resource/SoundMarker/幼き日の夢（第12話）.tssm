      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "duration" : 4.25172335600907,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.018.jpeg",
      "telop" : "僕はそういうと、咲夜とすれ違い、食堂に向かう。"
    },
    {
      "voiceCharacter" : "操夢",
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "animationName" : "なし",
      "id" : "A0C219E0-1416-4049-AAC0-7D18C265EE89",
      "title" : "シーン 19",
      "characterName" : "操夢",
      "backgroundName" : "nc196979_食堂(昼).png",
      "slideTitle" : "スライド #19",
      "voiceDuration" : 8.658253968253968,
      "transitionName" : "クロスディゾルブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "duration" : 9.258253968253968,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.019.jpeg",
      "telop" : "僕は、そういうと、食堂にやってくる。そして、２つのコップを取り出して、紅茶を注ぎ込むと、コップを持ち、戻っていく。"
    },
    {
      "voiceCharacter" : "操夢",
      "audioTrack" : "track_voice_%E6%93%8D%E5%A4%A2",
      "animationName" : "なし",
      "id" : "D56B1AE4-A879-422E-AE70-304B176C6719",
      "title" : "シーン 20",
      "characterName" : "操夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.pxd",
      "slideTitle" : "スライド #20",
      "voiceDuration" : 4.30390022675737,
