      "isReversed" : false,
      "voiceSymbol" : "、\/カ'レワ、ド'コカシラ、ワタシワ\/ソ'ー\/ツブヤキナ'ガラ、カ'レノ\/ス'ガタオ\/サガ_シハジメ'ル。",
      "volume" : 1,
