      "pan" : -0.2,
      "isReversed" : false,
      "voiceSymbol" : "ソ_シテ、ゲ'ンカンカラ\/ミ'テ\/ショーメ'ンノ\/オ'ーキナ\/トビラオ+アケ、ナ'カニ\/ハ'イル。ダ'ガ、ソノ\/クーカンニ'ワ\/ダ'レモ\/イナ'カッタ。",
      "volume" : 1,
