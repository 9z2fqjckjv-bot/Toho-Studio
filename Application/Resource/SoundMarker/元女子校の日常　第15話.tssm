      "transitionName" : "なし",
      "title" : "シーン 37"
    },
    {
      "telop" : "フランに視点が写り…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.038.jpeg",
