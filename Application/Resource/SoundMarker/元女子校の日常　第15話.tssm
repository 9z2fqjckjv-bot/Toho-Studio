      "id" : "D2F64DF7-F4E1-43F3-A7D7-1293F812F8B2",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #41",
      "seVolume" : 1,
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "title" : "シーン 41"
    },
    {
      "telop" : "「フラン、よく聞いて、ちょうだい。今すぐに、彼を探して。だけど、日付が変わる前に見つけ出せなかったら、報告して。」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.042.jpeg",
