      "bgmVolume" : 0.7,
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/霊夢（余裕）.png",
