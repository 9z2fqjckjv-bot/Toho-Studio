      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_フランドール・スカーレット.wav",
