    },
    {
      "title" : "シーン 5",
      "animationName" : "なし",
      "characterName" : "フランドール・スカーレット",
      "telop" : "「私こそ…よろしくお願いします…」\n私は彼のプロポーズに、そう改まった口調で返すのだった。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.005.jpeg",
      "voiceDuration" : 7.725736961451247,
      "slideTitle" : "第5スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
