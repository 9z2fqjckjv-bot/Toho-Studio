    },
    {
      "title" : "シーン 10",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は「入ってどうぞ」と返す。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.010.jpeg",
      "voiceDuration" : 1.9539002267573695,
      "slideTitle" : "第10スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 3.5,
      "id" : "DA96EF15-90DE-416F-B91A-C8E77BE76DCE",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav"
    },
    {
      "title" : "シーン 11",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "すると、入ってきたのは以前に、検査の担当だった人だった。\n「たしか、妹紅さんでしたっけ…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.011.jpeg",
      "voiceDuration" : 6.566938775510204,
      "slideTitle" : "第11スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.166938775510204,
      "id" : "75B71F79-ECE9-475C-B941-91A2FEDBB862",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"
    },
    {
      "title" : "シーン 12",
      "animationName" : "なし",
      "characterName" : "藤原妹紅",
      "telop" : "「ああ、そうだ。なぜ君は、またここにきたんだい？」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.012.jpeg",
      "voiceDuration" : 3.5724943310657595,
      "slideTitle" : "第12スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅",
      "duration" : 4.172494331065759,
      "id" : "A004B329-CF15-4C0E-8D85-89050D31C368",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_妹紅.wav"
    },
    {
      "title" : "シーン 13",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「ちょっとした事情で貧血で倒れてしまって…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.013.jpeg",
      "voiceDuration" : 2.8463038548752833,
      "slideTitle" : "第13スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 3.5,
      "id" : "D7C417CA-4DAE-40EE-838C-B6E96085E6B2",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav"
    },
    {
      "title" : "シーン 14",
      "animationName" : "なし",
      "characterName" : "藤原妹紅",
      "telop" : "「そうか…、とりあえず、永琳に、起きたっていうから、そのままベッドの上で大人しく、待っててくれ。」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.014.jpeg",
