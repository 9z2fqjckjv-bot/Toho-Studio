    },
    {
      "title" : "シーン 103",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「どういたしまして。」\nそれから、僕は彼女が泣き止むまで頭を撫で続けた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.103.jpeg",
