    },
    {
      "title" : "シーン 47",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「ええ、今朝病院で検査を受けたら、\n退院許可が出たので、そのまま帰ってきました。」",
      "backgroundName" : "咲夜（驚く）.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.047.jpeg",
