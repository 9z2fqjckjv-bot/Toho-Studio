      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav"
    },
    {
      "title" : "シーン 48",
      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "telop" : "「そうですか…、それで昼食は…？」",
      "backgroundName" : "咲夜（困る）.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.048.jpeg",
