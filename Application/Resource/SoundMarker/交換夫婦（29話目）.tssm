      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアノブをひねる1.mp3",
      "characterName" : "操夢",
      "telop" : "「レミリアさん、開けますね。」僕はそう言い、ドアノブを捻る。",
      "seName" : "SE: ドアノブをひねる1",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.091.jpeg",
      "voiceDuration" : 4.30390022675737,
      "slideTitle" : "第91スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.9039002267573695,
      "id" : "0700913C-88FC-451A-AEE8-97E515CD9D2E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav"
    },
    {
      "title" : "シーン 92",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕が、その部屋の玄関ドアを開け、中に入ると、そこには、見たことのない様子で笑うレミリアの姿があった。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.092.jpeg",
      "voiceDuration" : 7.459342403628118,
      "slideTitle" : "第92スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.059342403628118,
      "id" : "8C9ABD62-EEF6-46FB-8891-684FB8F918D9",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_操夢.wav"
    },
    {
      "title" : "シーン 93",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "そして、彼女の後ろではパチュリーと咲夜が倒れ込んでおり、血飛沫が玄関ホールに飛び散っていた。「レミリアさん…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.093.jpeg",
      "voiceDuration" : 7.332154195011338,
      "slideTitle" : "第93スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.9321541950113374,
      "id" : "C6E65899-1140-44A3-B933-84A93E8481E7",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_093_操夢.wav"
    },
    {
      "title" : "シーン 94",
      "animationName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "「どうしたのよ、操夢。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.094.jpeg",
      "voiceDuration" : 1.5775736961451248,
      "slideTitle" : "第94スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.5,
      "id" : "6A9B4653-A55A-45AC-BC67-A5EB76C28297",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_レミリア・スカーレット.wav"
    },
    {
      "title" : "シーン 95",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「なぜ、あの二人を襲ったのですか、所々壁やドアに傷や凹みを見られますし、もしかして…」僕はそこまで言い、思いつく。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.095.jpeg",
      "voiceDuration" : 8.523469387755101,
      "slideTitle" : "第95スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.123469387755101,
      "id" : "789CD824-6FD9-483F-BFF6-FE537702937F",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_操夢.wav"
    },
    {
      "title" : "シーン 96",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「僕は、人を平気で傷つけて、部屋を傷つける、野蛮な女性は好みませんよ…」僕は、彼女が冷静になれるようにそう悟す。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.096.jpeg",
      "voiceDuration" : 8.908253968253968,
      "slideTitle" : "第96スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.508253968253968,
      "id" : "D4AE230F-BC5E-4616-80A5-DDADD7CF0694",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_096_操夢.wav"
    },
    {
      "title" : "シーン 97",
      "animationName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "私は、彼にそう言われ、ふとハッとする。\nそして、あるものが込み上げてくる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.097.jpeg",
      "voiceDuration" : 5.123401360544218,
      "slideTitle" : "第97スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 5.7234013605442176,
      "id" : "10E41E94-5B20-47CB-944D-6B9F0E66BB55",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_097_レミリア・スカーレット.wav"
    },
    {
      "title" : "シーン 98",
      "animationName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "「私は、私は、ただあなたに…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.098.jpeg",
      "voiceDuration" : 2.492154195011338,
      "slideTitle" : "第98スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.5,
      "id" : "21888C88-0DA8-474E-A847-289C40D0D884",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_レミリア・スカーレット.wav"
    },
    {
      "title" : "シーン 99",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、そっと彼女を抱きしめると、泣きながら、\nそう呟く彼女の頭を、何も言わずにただ撫でる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.099.jpeg",
      "voiceDuration" : 6.766938775510204,
      "slideTitle" : "第99スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
