      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_フランドール・スカーレット.wav"
    },
    {
      "title" : "シーン 6",
      "animationName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "私は、ふと玄関を開けると、向こうでは、彼が指輪をフランに渡しているところだった。「うっ…」私はすぐに玄関を閉じる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.006.jpeg",
      "voiceDuration" : 8.101995464852608,
      "slideTitle" : "第6スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
