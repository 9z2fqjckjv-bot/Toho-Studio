      "slideTitle" : "第15スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 3.5,
      "id" : "C97541DA-C148-4B83-81D7-897B3221FC61",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav"
    },
    {
      "title" : "シーン 16",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕がそういうと、その人は去っていった。\n僕は、ふと窓から外見る。「今日は、月がよく見えるな…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.016.jpeg",
      "voiceDuration" : 7.061519274376417,
      "slideTitle" : "第16スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.661519274376417,
      "id" : "A42C59E5-32C9-4AF1-A715-018071FA3C1F",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav"
    },
    {
      "title" : "シーン 17",
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "characterName" : "操夢",
      "telop" : "そんなことを僕は、そう呟く。\nすると、病室の扉が再びノックされ、誰かが入ってくる。",
      "seName" : "SE: 木のドアをノック1",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.017.jpeg",
      "voiceDuration" : 7.061519274376417,
      "slideTitle" : "第17スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.661519274376417,
      "id" : "883CA6B0-944F-47B4-AB67-D2D37D9D4188",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav"
    },
    {
      "title" : "シーン 18",
      "animationName" : "なし",
      "characterName" : "八意永琳",
      "telop" : "「こんばんは、操夢さん。体調は大丈夫ですか？」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.018.jpeg",
      "voiceDuration" : 4.007301587301587,
      "slideTitle" : "第18スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳",
      "duration" : 4.607301587301587,
      "id" : "D9F78151-00FE-4F01-AFBC-22A9B3C7B533",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_永琳.wav"
    },
    {
      "title" : "シーン 19",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「ええ、倒れた時に比べたら、良くなりました。」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.019.jpeg",
      "voiceDuration" : 3.2778231292517006,
      "slideTitle" : "第19スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 3.8778231292517007,
      "id" : "BEAB732D-EF9E-42FA-95A8-124F0AC365CC",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav"
    },
    {
      "title" : "シーン 20",
      "animationName" : "なし",
      "characterName" : "八意永琳",
      "telop" : "「そう、ならよかったです。とりあえず、今晩は安静にしてください。日が昇り出したら、再び声をかけますから。」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.020.jpeg",
      "voiceDuration" : 8.94172335600907,
      "slideTitle" : "第20スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳",
      "duration" : 9.54172335600907,
      "id" : "06314DEE-75F3-4915-9426-AA982C4AC480",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_永琳.wav"
    },
    {
      "title" : "シーン 21",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "彼女はそういうと、部屋は静まり返る。\nそして、僕はふと夕方のフランとの会話を思い出す。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.021.jpeg",
      "voiceDuration" : 6.2995464852607705,
      "slideTitle" : "第21スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 6.89954648526077,
      "id" : "1DB7CAAC-9D5E-47D1-814E-52AC933C84C3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav"
    },
    {
      "title" : "シーン 22",
      "animationName" : "なし",
      "characterName" : "フランドール・スカーレット",
      "telop" : "「お姉様が言ってたんだけど、私たちは、その制度がなくなるなら、実家に戻るって…」私は、言いたいことを言えずにそう話す。",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.022.jpeg",
      "voiceDuration" : 9.988231292517007,
      "slideTitle" : "第22スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 10.588231292517007,
      "id" : "0D1E0071-CD2E-4C59-929E-58824AC7D511",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav"
    },
    {
      "title" : "シーン 23",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「…、フランさんは、僕が誰かを選ぶなら…、いや、この質問は控えた方がいいですね…それで他には？」",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.023.jpeg",
      "voiceDuration" : 6.5908616780045355,
      "slideTitle" : "第23スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.190861678004535,
      "id" : "8AAF241E-035A-46C0-9328-A9014655054B",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav"
    },
    {
      "title" : "シーン 24",
      "animationName" : "なし",
      "characterName" : "フランドール・スカーレット",
      "telop" : "「私は…、それより、久々に血を飲ませてくれない？」",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.024.jpeg",
      "voiceDuration" : 4.104489795918368,
      "slideTitle" : "第24スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 4.704489795918367,
      "id" : "0A220981-4794-45DE-86FD-15B0D9F19E94",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_フランドール・スカーレット.wav"
    },
    {
      "title" : "シーン 25",
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/噛みつく.mp3",
      "characterName" : "操夢",
      "telop" : "「いいですよ。」僕はそう言うと、そっと彼女に背を向ける。\nすると、彼女がゆっくりと噛みつき、僕の血を吸い始める。",
      "seName" : "[SE] 噛みつく.mp3",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.025.jpeg",
      "voiceDuration" : 8.316938775510204,
      "slideTitle" : "第25スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 8.916938775510204,
      "id" : "A2EDDE54-91D1-47B3-B54C-E772B30BEE0C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav"
    },
    {
      "title" : "シーン 26",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "そして、吸い終わると、僕は、ゆっくりと振り返り、彼女を見る。\n「それで、僕をここに呼んだ理由は…」",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.026.jpeg",
      "voiceDuration" : 7.043038548752834,
      "slideTitle" : "第26スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.643038548752834,
      "id" : "A8CF0DA3-2702-4F48-A7FC-7F844F17F8F7",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav"
    },
    {
      "title" : "シーン 27",
      "animationName" : "なし",
      "characterName" : "フランドール・スカーレット",
      "telop" : "「操夢…私と…」",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.027.jpeg",
      "voiceDuration" : 1.6794784580498867,
      "slideTitle" : "第27スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 3.5,
      "id" : "F074074B-68A9-4117-96AF-73D004D3CD9E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_フランドール・スカーレット.wav"
    },
    {
      "title" : "シーン 28",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「少しだけ、待っててもらえませんか、その返事…」\n僕は、予想通りの言葉に、そう返す。",
      "backgroundName" : "nc301378_一人部屋２（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.028.jpeg",
      "voiceDuration" : 6.519115646258504,
      "slideTitle" : "第28スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.1191156462585035,
      "id" : "67303F14-56A5-491C-82D3-2B2513DA9137",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav"
    },
    {
      "title" : "シーン 29",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "あのときは、ああ返した。そして、再び考える。もし、彼女たちの中から1人選ぶのならば…もっと考慮すべきことはあるが…",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.029.jpeg",
      "voiceDuration" : 9.119115646258503,
      "slideTitle" : "第29スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 9.719115646258503,
      "id" : "83D80334-27D3-4446-B52C-4FB511A2F7A8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav"
    },
    {
      "title" : "シーン 30",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「やっぱり、僕の初めてだったフランかな…」\n僕はそう呟く。僕の意見は決まりかけていた。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.030.jpeg",
      "voiceDuration" : 6.4386848072562355,
      "slideTitle" : "第30スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.038684807256235,
      "id" : "446C141E-651F-402A-956D-A1798E967C51",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav"
    },
    {
      "title" : "シーン 31",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "そして、その意見を後押しするための理由を考える。「霊夢さんは、魔理沙さんにお願いして、あの癖を直せば大丈夫…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.031.jpeg",
      "voiceDuration" : 7.862607709750567,
      "slideTitle" : "第31スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 8.462607709750568,
      "id" : "B3CD0DE7-DC58-4AE8-83C0-48B8B976FBB1",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav"
    },
    {
      "title" : "シーン 32",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「こいしさんとさとりさんは、特に問題はない…」\nそこまで考えて、フランたちのことを考える。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.032.jpeg",
      "voiceDuration" : 6.256077097505669,
      "slideTitle" : "第32スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 6.856077097505668,
      "id" : "211A772A-DAD6-4EDD-8ABE-DBDA7996CFF3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav"
    },
    {
      "title" : "シーン 33",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「フランさんたちは、定期的に血液の供給が必要…、そして尚且つ、フランさんは夕方に…、僕に告白をした…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.033.jpeg",
      "voiceDuration" : 7.860430839002268,
      "slideTitle" : "第33スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 8.460430839002267,
      "id" : "6EABE82E-73A1-4906-8ED4-6A672DE51AD9",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav"
    },
    {
      "title" : "シーン 34",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、そこまで考えると、フランの告白を拒絶する必要はなかった、「レミリアさんたちは…まぁ、何とかなるか…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.034.jpeg",
      "voiceDuration" : 7.791950113378685,
      "slideTitle" : "第34スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 8.391950113378686,
      "id" : "03BBA2F2-C131-445B-807F-BE28142D2863",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav"
    },
    {
      "title" : "シーン 35",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、そう独り言を呟き、そして、決心する。\n「退院したら、フランさんに返事を返さないと…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.035.jpeg",
      "voiceDuration" : 7.00390022675737,
      "slideTitle" : "第35スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.60390022675737,
      "id" : "8BAC0290-2AF0-4BA3-874F-A7BE74171C58",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav"
    },
    {
      "title" : "シーン 36",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕はそう呟くと、ゆっくりと枕に頭を預け、そのまま目を閉じる。すると、疲れが取れてなかったのか、そのまま寝落ちした。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.036.jpeg",
      "voiceDuration" : 8.827823129251701,
      "slideTitle" : "第36スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 9.427823129251701,
      "id" : "6E191CD8-54C8-4770-A651-21DC13F21863",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.037.jpeg",
      "animationName" : "なし",
      "slideTitle" : "第37スライド",
      "telop" : "翌朝になり…",
      "transitionName" : "なし",
      "duration" : 3,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "DDF05A5B-A49A-4394-82FB-4F13C2C7BFE6",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 37"
    },
    {
      "title" : "シーン 38",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、ふと目が覚めると、窓から朝日が差し込んでいた。\nそして、大きく伸びをすると、あくびをする。",
      "backgroundName" : "nc256896_病室-昼.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.038.jpeg",
      "voiceDuration" : 6.977823129251701,
      "slideTitle" : "第38スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 7.5778231292517,
      "id" : "DE94A5BB-C482-4A77-8BEB-169FE43BA5B5",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav"
    },
    {
      "title" : "シーン 39",
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "characterName" : "操夢",
      "telop" : "すると、誰かが部屋をノックして、入ってくる。",
      "seName" : "SE: 木のドアをノック1",
      "backgroundName" : "nc256896_病室-昼.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.039.jpeg",
      "voiceDuration" : 3.123469387755102,
      "slideTitle" : "第39スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 3.723469387755102,
      "id" : "E19D5653-F861-4F32-81F3-86EE539A2530",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav"
    },
    {
      "title" : "シーン 40",
      "animationName" : "なし",
      "characterName" : "八意永琳",
      "telop" : "「おはようございます、昨晩はよく眠れましたか？」",
      "backgroundName" : "nc256896_病室-昼.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.040.jpeg",
      "voiceDuration" : 3.5581179138321994,
      "slideTitle" : "第40スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳",
      "duration" : 4.158117913832199,
      "id" : "69272C5A-61A7-42C0-8090-93C225ED443A",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_永琳.wav"
    },
    {
      "title" : "シーン 41",
      "animationName" : "なし",
      "characterName" : "八意永琳",
      "telop" : "「ええ、よく眠りました。体調もかなり良くなりました。」",
      "backgroundName" : "nc256896_病室-昼.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.041.jpeg",
      "voiceDuration" : 4.391859410430839,
      "slideTitle" : "第41スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳",
      "duration" : 4.9918594104308385,
      "id" : "7FEFE09B-1466-4FB3-AB52-BE8FB5C4D35D",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_永琳.wav"
    },
    {
      "title" : "シーン 42",
      "animationName" : "なし",
      "characterName" : "八意永琳",
      "telop" : "「そうですか…、これから検査のために、廊下に担当者を待機させてますから、その人から検査を受けてください。」",
      "backgroundName" : "nc256896_病室-昼.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.042.jpeg",
      "voiceDuration" : 8.063786848072562,
      "slideTitle" : "第42スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳",
      "duration" : 8.663786848072561,
      "id" : "5CB1A149-8C71-488A-A338-91CAB5C8EA6C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_永琳.wav"
    },
    {
      "title" : "シーン 43",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "彼女はそういうと、挨拶を済まし、去っていった。僕は、ゆっくりとベッドから降り、病室を出ると、検査を受けるのだった。",
      "backgroundName" : "nc256896_病室-昼.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.043.jpeg",
      "voiceDuration" : 8.443038548752835,
      "slideTitle" : "第43スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 9.043038548752834,
      "id" : "4F841D17-B5AC-4204-BB0C-76AC937B5F55",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.044.jpeg",
      "animationName" : "なし",
