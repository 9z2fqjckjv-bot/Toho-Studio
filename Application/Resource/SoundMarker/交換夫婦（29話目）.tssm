      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_パチュリー・ノーレッジ.wav"
    },
    {
      "title" : "シーン 83",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "だが、彼女は私の問いかけには反応せず、血が飛び散っているその玄関で、私に襲いかかってくる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.083.jpeg",
