      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "5A0EABCA-CA58-4B60-BB64-F1AC583B4BFC",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 104"
    },
    {
      "title" : "シーン 105",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "それから僕は、自室に戻り、この家を出るための準備を進めていた。そして短期間だが、世話になった家に感謝して部屋を出る。",
      "backgroundName" : "一人部屋３（夕方）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.105.jpeg",
      "voiceDuration" : 8.569115646258503,
      "slideTitle" : "第105スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "duration" : 9.169115646258502,
      "id" : "3F0E02EE-CC05-46AD-A0DF-CC03338E7AC1",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_105_操夢.wav"
    },
    {
      "title" : "シーン 106",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "そして、夕日が照らす共同スペースで、僕たちは、それぞれ一言ずつ述べる。そして、この家に残る人と去る人で分かれる。",
      "backgroundName" : "リビング（夕方）.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.106.jpeg",
      "voiceDuration" : 8.645215419501135,
      "slideTitle" : "第106スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg",
      "duration" : 9.245215419501134,
      "id" : "C20B7ACF-443F-4046-B696-483ECEB35357",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_106_操夢.wav"
    },
    {
      "title" : "シーン 107",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "そして、その家を去った僕とフラン、レミリア、パチュリー、咲夜の5人は、彼女たちの実家で新しい生活が始まろうとしていた。",
