    },
    {
      "title" : "シーン 49",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「帰りの道中に駅そば食べてきたので、大丈夫ですよ。」",
      "backgroundName" : "咲夜（困る）.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.049.jpeg",
      "voiceDuration" : 3.788684807256236,
      "slideTitle" : "第49スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
