      "id" : "F1F59CA1-2DC7-4578-B7AD-0F9C54D9ACE8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_099_操夢.wav"
    },
    {
      "title" : "シーン 100",
      "animationName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "「私は…バカね…こんなことしたっていいことはないのに…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.100.jpeg",
      "voiceDuration" : 3.6713151927437644,
      "slideTitle" : "第100スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.2713151927437645,
      "id" : "4E663305-29E8-40E6-B796-F81719CCF2F5",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_100_レミリア・スカーレット.wav"
    },
    {
      "title" : "シーン 101",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「そんなことはないですよ、この共同生活で、心のうちに密めていたものが溢れただけですよ、それに僕はここにいるし…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.101.jpeg",
      "voiceDuration" : 7.897369614512471,
      "slideTitle" : "第101スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.497369614512472,
      "id" : "731E44BB-FF63-44C9-B4FA-E58E07A5281D",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_101_操夢.wav"
    },
    {
      "title" : "シーン 102",
      "animationName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "「そうね…そうよね…、でも…ありがとう、操夢。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.102.jpeg",
      "voiceDuration" : 3.3546485260770975,
      "slideTitle" : "第102スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.9546485260770976,
      "id" : "3680920F-9CB7-4FEA-836B-2E1506531BB4",
