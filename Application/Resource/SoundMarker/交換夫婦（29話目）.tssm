      "id" : "7C8B1866-31A0-4C33-B698-54640165ED45",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "title" : "その頃咲夜は…"
    },
    {
      "title" : "シーン 62",
      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "telop" : "私は、彼が上に上がっていくその様子を見て、決心がついたのだとわかる。そして、その後から上からの物音が響く。",
      "backgroundName" : "リビング（日中）.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.062.jpeg",
      "voiceDuration" : 6.931791383219955,
      "slideTitle" : "第62スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "voiceCharacter" : "十六夜咲夜",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "duration" : 7.531791383219955,
      "id" : "659E1ADB-1FB4-4651-958B-E304AD2FAF6F",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_十六夜咲夜.wav"
    },
    {
      "title" : "シーン 63",
      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "telop" : "「この音から聞こえるとして…お嬢様の部屋…」私はそう呟くと、この生活では使ってなかった能力で、時間を止める。",
      "backgroundName" : "リビング（日中）.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.063.jpeg",
      "voiceDuration" : 7.112879818594104,
      "slideTitle" : "第63スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "voiceCharacter" : "十六夜咲夜",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "duration" : 7.712879818594104,
      "id" : "7BB5F516-972A-4CA3-8AE1-55768ED2258F",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_十六夜咲夜.wav"
    },
    {
      "title" : "シーン 64",
      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "telop" : "そして、時間を止めると、そのまま彼女の部屋に直行する。",
      "backgroundName" : "リビング（日中）.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.064.jpeg",
      "voiceDuration" : 6.931791383219955,
      "slideTitle" : "第64スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "voiceCharacter" : "十六夜咲夜",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "duration" : 7.531791383219955,
      "id" : "42665C2B-7645-4502-9350-5FC175204800",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_十六夜咲夜.wav"
    },
    {
      "title" : "シーン 65",
      "animationName" : "なし",
      "characterName" : "十六夜咲夜",
      "telop" : "すると、案の定、お嬢様が、泣き喚いていた。\n私は、そんな彼女の後ろにたち、そっと頭を撫でる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.065.jpeg",
      "voiceDuration" : 6.6347845804988665,
      "slideTitle" : "第65スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "voiceCharacter" : "十六夜咲夜",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
