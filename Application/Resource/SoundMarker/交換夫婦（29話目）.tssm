    },
    {
      "title" : "シーン 69",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "「だれか、もし彼にいなくなってほしくないなら、積極的に行動しなさいと、飛行機で告げたのに…」私はそう愚痴をこぼす。",
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
