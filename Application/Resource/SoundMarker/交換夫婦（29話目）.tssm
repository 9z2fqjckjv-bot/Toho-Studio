    {
      "title" : "シーン 78",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "「そうね…、彼と離れたくないなら、積極的に動くべきよ。」\n私がそういうと、後ろで寝てたフランの目が覚めた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.078.jpeg",
      "voiceDuration" : 6.50390022675737,
      "slideTitle" : "第78スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.10390022675737,
      "id" : "ECB2395B-1EBE-451F-B00A-5F24CA295FFB",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_パチュリー・ノーレッジ.wav"
    },
    {
      "title" : "シーン 79",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "「まぁ、きっと、咲夜が慰めに行っているでしょう…」\n私はそういうと、読みかけの本を読む。",
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.079.jpeg",
      "voiceDuration" : 5.08530612244898,
      "slideTitle" : "第79スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg",
      "duration" : 5.68530612244898,
      "id" : "B83E201E-582A-4A0F-8FBC-B928B3CEE48C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_パチュリー・ノーレッジ.wav"
    },
    {
      "title" : "シーン 80",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "だが、彼女の親友としてその態度はどうなのだ、と心の中のもう一人の私が、問いかけてくる。「確かに、動くべきかしら…」",
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.080.jpeg",
      "voiceDuration" : 7.464331065759637,
      "slideTitle" : "第80スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg",
      "duration" : 8.064331065759637,
      "id" : "78D8EF73-A357-4B29-845C-2E13AB3B6B09",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_パチュリー・ノーレッジ.wav"
    },
    {
      "title" : "シーン 81",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "だが、そう考えていると、レミリアの部屋から嫌な音が聞こえ、\n私は、いてもたってもいられずに、彼女の部屋に向かう。",
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.081.jpeg",
      "voiceDuration" : 6.499342403628118,
      "slideTitle" : "第81スライド",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg",
      "duration" : 7.099342403628118,
      "id" : "B1C0DC68-73DE-4586-A1FC-5AA227CB0731",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_パチュリー・ノーレッジ.wav"
    },
    {
      "title" : "シーン 82",
      "animationName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "そこには、光のない目で笑う彼女と、その後ろで目を瞑り、倒れ込んでいる咲夜の姿があった。「あんた…何をしてるの…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.082.jpeg",
