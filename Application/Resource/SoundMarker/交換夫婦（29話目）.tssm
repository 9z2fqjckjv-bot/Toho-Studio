      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅",
      "duration" : 6.939160997732426,
      "id" : "FF015815-4B01-490F-995B-20E7E1283D81",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_妹紅.wav"
    },
    {
      "title" : "シーン 15",
      "animationName" : "なし",
      "characterName" : "操夢",
      "telop" : "「分かりました…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（29話目）_17e04be8fd\/交換夫婦（29話目）_17e04be8fd.015.jpeg",
