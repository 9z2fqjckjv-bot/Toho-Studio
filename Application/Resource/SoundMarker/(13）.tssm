    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "「夜咲さん…、氷水を入れた袋を持ってきて、僕の頭を冷やしてくれますか…？」僕は、オーバヒートの状態でそういう。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.031.jpeg",
