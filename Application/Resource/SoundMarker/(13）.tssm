      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "「私は…、私は…」私は、そう言いながら、恐怖に包まれる。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.018.jpeg",
