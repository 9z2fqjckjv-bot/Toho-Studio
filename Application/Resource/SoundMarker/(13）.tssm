      "seVolume" : 0.85,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceStartTimeOffset" : 0,
      "characterName" : "ナレーション",
      "telop" : "それから時間がたち…",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "animationNote" : "表示時間：1.5秒",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.013.jpeg",
      "id" : "7F2F563A-8DCB-4EA4-B6BE-D823029A3D0B",
      "voice2StartTimeOffset" : 0,
      "animationDuration" : 1.5,
      "duration" : 1.5,
      "title" : "シーン 13",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "seVolume" : 1,
      "slideTitle" : "スライド #13",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "「んっ…」私は、ふと目が覚めると、そこはフレラの部屋だった。\nすると、なんとなく嫌な感じがし、ふと周りを見る。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.014.jpeg",
      "voiceDuration" : 9.363242630385487,
      "id" : "02BFDF89-0659-4CA0-A161-FE6C4C83237A",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.363242630385487,
      "title" : "シーン 14",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #14",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "すると、そこには、苦しそうに寝込む彼の姿があった。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
