      "characterName" : "フランドール・スカーレット",
      "telop" : "私は、ふとそこで、今朝見てた夢を思い出す…",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.016.jpeg",
