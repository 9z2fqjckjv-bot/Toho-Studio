{
  "version" : "2.0",
  "scenes" : [
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "あれから、1週間ほど経ち、この屋敷から離れる日になった。\n東方Project二次創作作品",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.001.jpeg",
