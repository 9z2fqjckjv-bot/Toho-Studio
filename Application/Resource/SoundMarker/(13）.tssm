      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "僕は、起き上がると、そのまま食堂に向かう。\n作成者：zuyasi",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.002.jpeg",
      "voiceDuration" : 3.1365079365079365,
      "id" : "FDFC9C27-9470-4C10-AF05-649D9236D590",
      "voice2StartTimeOffset" : 0,
      "duration" : 3.1365079365079365,
      "title" : "シーン 2",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #2",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "そして、食堂に着くと、フレラが朝食の配膳をしていた。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.003.jpeg",
      "voiceDuration" : 4.021292517006803,
      "id" : "79F3152D-37A2-42E4-8E1C-FD6F8FE3C63D",
      "voice2StartTimeOffset" : 0,
      "duration" : 4.021292517006803,
      "title" : "シーン 3: そして、食堂に着くと、フレラが朝食の配膳をしていた。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc196979_食堂(昼).png",
      "animationName" : "なし",
      "slideTitle" : "スライド #3",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "「おはよう、朝食がちょうどできたよ。」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.004.jpeg",
      "voiceDuration" : 2.8144897959183672,
      "id" : "C812B0A4-74BC-4E8C-8DC3-3EB05DDED1EE",
      "voice2StartTimeOffset" : 0,
      "duration" : 2.8144897959183672,
      "title" : "シーン 4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc196979_食堂(昼).png",
      "animationName" : "なし",
      "slideTitle" : "スライド #4",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "seName" : "SE: 爆発1",
      "telop" : "それから、フレラは、まだ食堂に来てない人たちを呼びに行った。だが、爆発音が、ある部屋から、急に鳴り出す。\n彷徨う二人　第13話\n彼は、屋敷をさる日に食堂に来ると、爆発音がなり…",
      "bgmVolume" : 0.7,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/爆発1.mp3",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.005.jpeg",
      "voiceDuration" : 8.05063492063492,
      "id" : "4F22E16B-F6A6-45E1-98FE-D93DC275E975",
      "voice2StartTimeOffset" : 0,
      "duration" : 8.05063492063492,
      "title" : "シーン 5",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc196979_食堂(昼).png",
      "animationName" : "なし",
      "slideTitle" : "スライド #5",
      "seVolume" : 0.85,
      "seStartTimeOffset" : 4.53,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "僕が、爆発音がした部屋に来ると、フレラの服が所々破け、フランは、狂っているような状態で余裕の表情をしていた。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.006.jpeg",
      "voiceDuration" : 8.464761904761906,
      "id" : "FEE238FC-33D9-4664-8E7F-F16983B09AEC",
      "voice2StartTimeOffset" : 0,
      "duration" : 8.464761904761906,
      "title" : "シーン 6",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #6",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "僕は、フランが何か言い始めるのを感じ、\nフレラを退けると、フランの目の前に立つ。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.007.jpeg",
      "voiceDuration" : 5.740861678004535,
      "id" : "2AE38A37-3155-4CA2-B7BE-8D6D0A955766",
      "voice2StartTimeOffset" : 0,
      "duration" : 5.740861678004535,
      "title" : "シーン 7",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #7",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "seName" : "SE: 重いキック1",
      "telop" : "だが、彼女がある言葉を言い放つと、強い衝撃が僕の全身を覆い、悲鳴を上げるように、痛み出す。だが、僕は立ち続ける。",
      "bgmVolume" : 0.7,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いキック1.mp3",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.008.jpeg",
      "voiceDuration" : 9.101723356009071,
      "id" : "E1F9568B-9E7F-40B2-B78D-421DF53F43FF",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.101723356009071,
      "title" : "シーン 8",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #8",
      "seStartTimeOffset" : 2.64,
      "seVolume" : 0.85,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "seName" : "SE: 重いパンチ1",
      "telop" : "僕は、再び彼女が言葉を言い放つ前に、強烈なビンタをする。\nだが、そのビンタとともに、衝撃を全身に受ける。",
      "bgmVolume" : 0.7,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いパンチ1.mp3",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.009.jpeg",
      "voiceDuration" : 8.45390022675737,
      "id" : "8A4DA80E-EEDF-4281-B31D-5C5F87315F9C",
      "voice2StartTimeOffset" : 0,
      "duration" : 8.45390022675737,
      "title" : "シーン 9",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #9",
      "seStartTimeOffset" : 3.24,
      "seVolume" : 0.85,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "seName" : "SE: 倒れる",
      "telop" : "僕は、フレラに目で逃げ出すように合図を送り、彼女が逃げると、それを確認してから、彼女を押し倒す。",
      "bgmVolume" : 0.7,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/倒れる.mp3",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.010.jpeg",
      "voiceDuration" : 6.973469387755102,
      "id" : "6AE5593F-C2D9-45F7-9D62-B9D511ECDE15",
      "voice2StartTimeOffset" : 0,
      "duration" : 6.973469387755102,
      "title" : "シーン 10",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #10",
      "seStartTimeOffset" : 5.92,
      "seVolume" : 0.85,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "seName" : "SE: 重いパンチ1",
      "telop" : "だが、彼女は、それでも動じず、僕が再びビンタをすると同時に、3度目の衝撃を僕は、全身に受ける。",
      "bgmVolume" : 0.7,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いパンチ1.mp3",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.011.jpeg",
      "voiceDuration" : 7.675646258503401,
      "id" : "E65F94AA-D172-4F2A-A66C-15F164CA5689",
      "voice2StartTimeOffset" : 0,
      "duration" : 7.675646258503401,
      "title" : "シーン 11",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #11",
      "seStartTimeOffset" : 2.6,
      "seVolume" : 0.85,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "seName" : "SE: 軽いパンチ1",
      "telop" : "僕は、痛む全身を締め付けながら、なんとか腕を上げると、残っている力を全て込めて、彼女の首筋に当て、気絶した。",
      "bgmVolume" : 0.7,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/軽いパンチ1.mp3",
      "transitionName" : "なし",
