      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "八雲紫",
      "voiceStartTimeOffset" : 0,
      "characterName" : "八雲紫",
      "telop" : "「…」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.019.jpeg",
      "voiceDuration" : 0.5,
      "id" : "7D6B6E26-B889-45C9-8617-BB6CDC3278F3",
      "voice2StartTimeOffset" : 0,
      "duration" : 0.5,
      "title" : "シーン 19",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_八雲紫.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #19",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "私は、ふとハッと現実に意識が戻ると、彼は何かを呟いていた。\n「どうしたの？何か言いたいなら、起きてよ…。」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.020.jpeg",
      "voiceDuration" : 9.301995464852608,
      "id" : "FE97F68B-F956-45A7-B140-6428B8E26885",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.301995464852608,
      "title" : "シーン 20",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #20",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "私は、そう言いながら、ふと彼を見ると違和感に気づく。\n私は、それを見つけると、彼を抱え、ある部屋に運び出した。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.021.jpeg",
      "voiceDuration" : 9.656984126984128,
      "id" : "F84253B9-3E6C-4196-AECF-7F19088E5D82",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.656984126984128,
      "title" : "シーン 21",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #21",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceStartTimeOffset" : 0,
      "characterName" : "ナレーション",
      "telop" : "彼の目が覚めると…",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "animationNote" : "表示時間：1.5秒",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.022.jpeg",
      "id" : "DEDFEDC6-DAD4-4C87-BF73-4A6019460E25",
      "voice2StartTimeOffset" : 0,
      "animationDuration" : 1.5,
      "duration" : 1.5,
      "title" : "シーン 22",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "seVolume" : 1,
      "slideTitle" : "スライド #22",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "「んっ…」僕はふと目が覚めると、そこは一時的に僕に割り当てられた、寝室だった。すると誰かの声がし、その方を見る。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.023.jpeg",
      "voiceDuration" : 8.587596371882086,
      "id" : "2A409089-065B-4A8A-BDC9-F99CAA21FA8C",
      "voice2StartTimeOffset" : 0,
      "duration" : 8.587596371882086,
      "title" : "シーン 23",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #23",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "そこには、彼女の姿があった。だが、彼女の名前を思い出そうとすると、頭に熱が籠る。そして、1分ほどで思い出す。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.024.jpeg",
      "voiceDuration" : 9.257165532879819,
      "id" : "6007B774-A4CA-4AA4-904A-0D0F0FE43BE7",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.257165532879819,
      "title" : "シーン 24",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #24",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "十六夜咲夜",
      "voiceStartTimeOffset" : 0,
      "characterName" : "十六夜咲夜",
      "telop" : "「体調は良くなりましたか？」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.025.jpeg",
      "voiceDuration" : 1.5458956916099773,
      "id" : "A27D123F-2882-4FBE-B03A-37A99ABB03F8",
      "voice2StartTimeOffset" : 0,
      "duration" : 1.5458956916099773,
      "title" : "シーン 25",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_十六夜咲夜.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #25",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "「良いとは言えないと思います…、それより…」僕は、そう言いながら、ある名前を頭に熱が籠りながら、思い出そうとする。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.026.jpeg",
      "voiceDuration" : 7.862607709750567,
      "id" : "C4C7EA4D-3FA7-417A-A84A-F843BBDFE25B",
      "voice2StartTimeOffset" : 0,
      "duration" : 7.862607709750567,
      "title" : "シーン 26",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #26",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "「…フランさんは…、どこにいますか？」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.027.jpeg",
      "voiceDuration" : 2.073469387755102,
      "id" : "4AFA24CF-8D0F-4924-BB5C-B0472A02600A",
      "voice2StartTimeOffset" : 0,
      "duration" : 2.073469387755102,
      "title" : "シーン 27",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #27",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "十六夜咲夜",
      "voiceStartTimeOffset" : 0,
      "characterName" : "十六夜咲夜",
      "telop" : "「彼女なら、朝食をとった後、そのままこの屋敷を、\n去っていったと妹様が、言ってましたけど…」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.028.jpeg",
      "voiceDuration" : 5.899591836734694,
      "id" : "410D1EA7-75D8-49E2-A366-40EC49065F29",
      "voice2StartTimeOffset" : 0,
      "duration" : 5.899591836734694,
      "title" : "シーン 28",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_十六夜咲夜.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #28",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "「…えっ…。」僕は、そう返しながら、考える。だが、それは僕の頭にさらに熱を籠らせる。僕は、それをできるだけ抑え込む。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.029.jpeg",
      "voiceDuration" : 9.547369614512471,
      "id" : "5B901430-05A4-4A1A-83BE-8FDFF4AB22C7",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.547369614512471,
      "title" : "シーン 29",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
