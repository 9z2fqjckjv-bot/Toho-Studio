      "voiceStartTimeOffset" : 0,
      "characterName" : "十六夜咲夜",
      "telop" : "「分かりました…」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.032.jpeg",
      "voiceDuration" : 0.8813832199546485,
      "id" : "53E0868B-E4DD-4849-9675-C735F481842D",
      "voice2StartTimeOffset" : 0,
      "duration" : 0.8813832199546485,
      "title" : "シーン 32",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_十六夜咲夜.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #32",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "telop" : "僕はそれから、彼女が氷水を入れた袋を頭に乗せてもらうと、\n熱が籠りすぎた、熱々の頭を冷やしていくのだった。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.033.jpeg",
      "voiceDuration" : 8.10281179138322,
      "id" : "52A25752-F9D3-4CED-9CBD-149B5D4D60A7",
      "voice2StartTimeOffset" : 0,
      "duration" : 8.10281179138322,
      "title" : "シーン 33",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #33",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "一方でフランは…",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.034.jpeg",
      "voice2StartTimeOffset" : 0,
      "id" : "5CA4D460-E763-4511-87D8-732CFA8192D9",
      "duration" : 2.5,
      "title" : "シーン 34: 一方でフランは…",
      "audioTrack" : "track_voice_char_narration",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "seVolume" : 1,
      "slideTitle" : "スライド #34",
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "私は、目が覚めるやいなや、彼の苦しそうな表情を見て、ものすごい罪悪感と恐怖に包まれ、そのまま屋敷を飛び出した。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.035.jpeg",
      "voiceDuration" : 9.551995464852608,
      "id" : "86692547-6FEC-40C8-BD61-F0100552574A",
      "voice2StartTimeOffset" : 0,
      "duration" : 9.551995464852608,
      "title" : "シーン 35",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #35",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "そして、彼の暗い寝顔で、なぜ幻想郷を出たのかを思い出した。\n最初の頃は、その理由を思い出せず、姉妹喧嘩だと考えていた。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.036.jpeg",
      "voiceDuration" : 10.626984126984127,
      "id" : "A500AF8E-1621-4E4C-B4BF-ABD3EC391F7D",
      "voice2StartTimeOffset" : 0,
      "duration" : 10.626984126984127,
      "title" : "シーン 36",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #36",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "だが、彼のあの表情を見て、はっきりと思い出してしまった。\n「私は…、幻想郷から追放された…」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.037.jpeg",
      "voiceDuration" : 7.963242630385488,
      "id" : "034DF765-0E0C-4E34-A57D-1197433C8E8D",
      "voice2StartTimeOffset" : 0,
      "duration" : 7.963242630385488,
      "title" : "シーン 37",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #37",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "私は、そう呟くと、誰かの気配を感じる…。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.038.jpeg",
      "voiceDuration" : 3.841995464852608,
      "id" : "81E662DF-307D-4708-9C7B-BD19ABD7ACC7",
      "voice2StartTimeOffset" : 0,
      "duration" : 3.841995464852608,
      "title" : "シーン 38",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #38",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "八雲紫",
      "voiceStartTimeOffset" : 0,
      "characterName" : "八雲紫",
      "telop" : "「ようやく見つけ出したわ…。」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.039.jpeg",
      "voiceDuration" : 1.4603174603174602,
      "id" : "204A499F-3714-4636-B30B-650A4280AC8D",
      "voice2StartTimeOffset" : 0,
      "duration" : 1.4603174603174602,
      "title" : "シーン 39",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_八雲紫.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #39",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/紫（困り）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "私が、その気配のほうを見ると、そこには紫がいた。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.040.jpeg",
      "voiceDuration" : 4.339478458049887,
      "id" : "DA9E469B-5318-4FA2-B74D-2590832C160B",
      "voice2StartTimeOffset" : 0,
      "duration" : 4.339478458049887,
      "title" : "シーン 40",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #40",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/紫（困り）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "八雲紫",
      "voiceStartTimeOffset" : 0,
      "characterName" : "八雲紫",
      "telop" : "「フラン…、幻想郷からあなたを追放した私が言うのもおかしいけど…、幻想郷に戻ってきてくれないかしら？」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.041.jpeg",
      "voiceDuration" : 6.481383219954648,
      "id" : "EF4F3BA7-4587-439D-AD93-744C19BFC1E7",
      "voice2StartTimeOffset" : 0,
      "duration" : 6.481383219954648,
      "title" : "シーン 41",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_八雲紫.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #41",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/紫（困り）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "telop" : "「えっ？」私は、彼女の発言に思わずそう返す。",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.042.jpeg",
      "voiceDuration" : 4.506984126984127,
      "id" : "4A4256FC-1E7B-49B3-927A-F108BA76FAA8",
      "voice2StartTimeOffset" : 0,
      "duration" : 4.506984126984127,
      "title" : "シーン 42",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #42",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/紫（困り）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "八雲紫",
      "voiceStartTimeOffset" : 0,
      "characterName" : "八雲紫",
      "telop" : "「いま、幻想郷では異変が起きているのよ…。その解決には、フランの存在を欠かせないのよ…。追放についてお詫びするわ…」",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_13）_184fd90a2b\/_13）_184fd90a2b.043.jpeg",
