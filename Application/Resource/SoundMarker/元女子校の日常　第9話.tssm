    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「おいしい！」私は、思わずそう声を発する。",
      "id" : "DD8D69A4-3E0F-449C-9A43-FE058F57060B",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
