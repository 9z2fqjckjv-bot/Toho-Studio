      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.073.jpeg",
      "title" : "シーン 72: シーン 73",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "voiceDuration" : 4.197369614512471,
      "duration" : 4.797369614512471,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #73",
      "telop" : "私はそれから、あっという間にごはんを食べ切ると彼を見る。\n「ねぇ、さっき買ってきたワインとグラスを出してくれない？」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "id" : "2CAA9724-FCA4-4F09-BC04-5EE4206E9F6A",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.074.jpeg",
      "title" : "シーン 73: シーン 74",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
      "voiceDuration" : 8.191995464852608,
      "duration" : 8.791995464852608,
      "voiceCharacter" : "フランドール・スカーレット"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav",
      "slideTitle" : "スライド #74",
      "telop" : "「いいですよ。ちょっと待ってください。」僕はそう言い、冷蔵庫にしまったワインを取り出してグラスに注ぐ。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
