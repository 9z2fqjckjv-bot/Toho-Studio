    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「そうだね…。」私はそう言い、今度は冷ましてから食べる。",
      "id" : "D19EB551-BC67-4593-B726-0F71C5E2734A",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
