      "slideTitle" : "スライド #20",
      "telop" : "「そう…」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "316B26FA-92ED-47E3-AFA5-A76FE827D89A",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.021.jpeg",
      "title" : "シーン 20: シーン 21",
      "voiceDuration" : 1.5,
      "duration" : 2.5,
      "voiceCharacter" : "フランドール・スカーレット"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "slideTitle" : "スライド #21",
      "telop" : "僕は、その彼女の表情を見ると、なんだか断るのは、申し訳なく感じてくる。「散歩とは違いますが…僕の用事に付き合ってくれませんか…？」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "DEC876FF-B9AA-46BE-BC86-9EE2A8965081",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.022.jpeg",
      "title" : "シーン 21: シーン 22",
