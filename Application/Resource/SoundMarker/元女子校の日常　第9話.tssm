    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、そっと息子の部屋の扉を開けて、中を覗く。すると、彼女が言っていた女性が、スヤスヤとベッドで寝ていた。",
      "id" : "9ECCA3CA-43B3-4719-AB5B-501A22CCACDD",
      "backgroundName" : "一人部屋３（夜・照明OFF）.jpg",
      "animationName" : "なし",
      "title" : "シーン 106",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 9.304489795918368,
      "slideTitle" : "スライド #106",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）叡智シーンのみ\/後ろ手すやすや頬照り寝顔.png",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 9.904489795918368,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_106_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
