    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "フランと彼が家に着くと…",
      "id" : "DC7184D6-02B6-4AF3-A906-F4B9E714D53E",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "title" : "シーン 63: フランと彼が家に着くと…",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "slideTitle" : "スライド #63",
      "seVolume" : 1,
