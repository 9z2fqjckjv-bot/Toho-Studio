    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そういうと、彼女は席を立ち、僕の隣に立つと、頬に何かが触れる感触がする。その途端に、強烈な恥ずかしさを僕は覚える。",
      "id" : "5D78322B-30C8-45B5-9C76-F449126CB950",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 76",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 9.347369614512472,
      "slideTitle" : "スライド #76",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
