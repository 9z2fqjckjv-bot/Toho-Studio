      ],
      "duration" : 6.050634920634921,
      "startTime" : 9.209999999999999,
      "pitch" : 115,
      "text" : "そして、ふと周りを見ると、父が困惑しながら、ひたすらにそのビームを避けている様子だった。",
      "volume" : 1,
      "fadeOutDuration" : 0,
      "name" : "[サブ] そして、ふと周りを見ると、父が困惑しながら、ひたすらにそのビームを避けている様子だった。",
      "voiceTriggerOffset" : 0,
      "isCutOffOnSceneEnd" : true,
      "isReversed" : false,
      "trackId" : "track_voice_sub",
