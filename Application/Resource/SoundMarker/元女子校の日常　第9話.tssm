    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「ふっ。」僕は、彼女のその仕草に思わず笑ってしまう。",
      "id" : "3923DCDD-E368-48A8-A58E-73AD9C965C9F",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
