    {
      "slideTitle" : "スライド #63",
      "telop" : "フランと彼が家に着くと…",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "id" : "2A5347E5-33FB-4391-BC6F-AA7A3A814AFF",
