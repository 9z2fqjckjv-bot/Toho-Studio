      "type" : "Voice",
      "voiceSymbol" : "ソ_シテ、_フト\/マワリオ\/ミ'ルト、_チチ'ガ\/コンワ_クシナ'ガラ、_ヒタスラニ\/ソノ\/ビ'ームオ\/サ'ケテイル\/ヨースダ'ッタ。",
      "fadeInDuration" : 0,
      "sceneRelativeStartTime" : 0,
      "pan" : 0,
