      "slideTitle" : "スライド #19",
      "telop" : "「いや、今用事を思い出したので、\nそれを済ませたら、家に帰ります。」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
