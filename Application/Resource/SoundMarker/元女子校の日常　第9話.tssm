    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "二人が家に着くと…",
      "id" : "634D2707-CEC5-495D-A7DC-FD252EE09345",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "title" : "シーン 104: 二人が家に着くと…",
