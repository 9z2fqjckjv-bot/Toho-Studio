      "seVolume" : 1,
      "duration" : 3,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.104.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」",
      "id" : "C3B42520-B5BD-4920-A80C-5CD2D26FD5E3",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 105",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 10.068231292517007,
      "slideTitle" : "スライド #105",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 10.668231292517007,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_105_博麗霊夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
