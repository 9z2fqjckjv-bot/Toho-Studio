      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav",
      "slideTitle" : "スライド #32",
      "telop" : "「フランさんは、夕飯はもう食べましたか？」\n僕はそう彼女に聞く。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
