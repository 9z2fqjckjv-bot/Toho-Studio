    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、私と彼の部屋に入ると、紅夢がベッドの片方で寝ていた。私は、それを確認すると、リビングで待つ彼女の元に戻る。",
      "id" : "5CBABD27-1E1B-47B5-B162-C2A6C7BA9AED",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 107",
