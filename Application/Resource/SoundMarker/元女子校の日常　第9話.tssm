      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.053.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「ようやく思い出せたか…、それで、今でも…はあるの？」",
      "id" : "54A443DC-5FEC-465B-A2D6-98F4525DE425",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 54",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 4.289478458049887,
      "slideTitle" : "スライド #54",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 4.8894784580498865,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.054.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "僕は、そう彼女に聞かれ、一瞬迷う。彼女に初恋してからは、ずっと男子だけに囲まれて育ったので、別の恋をしていなかった。",
      "id" : "91A9183B-611A-4179-9F74-DC1636B03A45",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 55",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 9.237596371882086,
      "slideTitle" : "スライド #55",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 9.837596371882086,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.055.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「ええ、変わってませんよ…。」\n僕は、少し恥ずかしさを覚えながら、そう彼女に返すのだった。",
      "id" : "DF11B614-3ABB-48C6-BF20-E885C17F71FC",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 56",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 6.363673469387755,
      "slideTitle" : "スライド #56",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 6.9636734693877544,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.056.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "その頃、妹紅と魔理沙は…",
      "id" : "EA412784-45F3-48AF-8B75-49E514DDC496",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "title" : "シーン 57: その頃、妹紅と魔理沙は…",
      "voiceStartTimeOffset" : 0,
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #57",
      "seVolume" : 1,
      "duration" : 3,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.057.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私は、一瞬の隙があれから、時々でき、その度に彼女のビームの餌食になっていた。いつの間にか、息も切れかけている。",
      "id" : "F1F88177-39DE-49C0-9ABA-8E7A3BAB360F",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 58",
      "voiceStartTimeOffset" : 0,
      "characterName" : "妹紅",
      "voiceDuration" : 8.38498866213152,
      "slideTitle" : "スライド #58",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "seVolume" : 1,
      "duration" : 8.984988662131519,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_妹紅.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "妹紅",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.058.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "あと数発のビームを喰らえば、倒れ込むのは確実な、その状況で、彼女に反撃もできずに、私は、それを避け続けた。",
      "id" : "829BCC4A-0068-45AE-BF1A-60C7FD6E8A6F",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 59",
      "voiceStartTimeOffset" : 0,
      "characterName" : "妹紅",
      "voiceDuration" : 8.289160997732425,
      "slideTitle" : "スライド #59",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "seVolume" : 1,
      "duration" : 8.889160997732425,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_妹紅.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "妹紅",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.059.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "すると、突如彼女が、これまでとは異なり、手に力を込め始める。「次のビームを食らったら、終わりだな…」",
      "id" : "7B599463-069A-4754-A7AC-6616DFA2C168",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 60",
      "voiceStartTimeOffset" : 0,
      "characterName" : "妹紅",
      "voiceDuration" : 7.139160997732426,
      "slideTitle" : "スライド #60",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "seVolume" : 1,
      "duration" : 7.739160997732426,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "妹紅",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.060.jpeg"
    },
    {
      "seStartTimeOffset" : 3.57,
      "telop" : "そして、これまでより高火力のビームを受け終わると、\n私は、その場に倒れ込んだ。",
      "id" : "CDD73DB8-757A-4647-B903-7BA48395FCE8",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 61",
      "voiceStartTimeOffset" : 0,
      "characterName" : "妹紅",
      "voiceDuration" : 5.126666666666667,
      "slideTitle" : "スライド #61",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3",
      "seVolume" : 0.85,
      "duration" : 5.726666666666667,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_妹紅.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "妹紅",
      "seName" : "SE: 倒れる",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.061.jpeg"
    },
    {
      "seStartTimeOffset" : 3.3,
      "telop" : "私は、彼が倒れ込むとその隙をつき、彼女の背後に立つ。\nそして、彼女の首筋に強力な打撃を与えて、気絶させるのだった。",
      "id" : "49255DAC-685D-4051-B310-0AAE1BCF1EDC",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
