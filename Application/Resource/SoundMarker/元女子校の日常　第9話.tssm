      "duration" : 10.388684807256235,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #22",
      "telop" : "「ありがとう！」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "65A25B6B-2FE3-4389-B3D4-AC8AD5B323A6",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.023.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "title" : "シーン 22: シーン 23",
      "voiceDuration" : 1.5,
      "duration" : 2.5,
      "voiceCharacter" : "フランドール・スカーレット"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "slideTitle" : "スライド #23",
      "telop" : "僕は、そう彼女が笑うと、どこかで見たことのあるようなその表情に、過去を思い出しながら、一緒に歩き始めた。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "F64B4662-C15F-43BA-9E3F-39635B4D12C9",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.024.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "title" : "シーン 23: シーン 24",
      "voiceDuration" : 7.656077097505669,
      "duration" : 8.256077097505669,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_美鈴.wav",
      "slideTitle" : "スライド #24",
      "telop" : "私が、その場所につき、そっと影から覗くと、一方の男女は戦い、もう一方の男女は一緒にどこかに歩き出していた。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "0B129A30-4712-44DC-B167-5F045D45BEAF",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.025.jpeg",
      "title" : "シーン 24: シーン 25",
      "voiceDuration" : 5.582721088435374,
      "duration" : 6.182721088435374,
      "voiceCharacter" : "美鈴"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_美鈴.wav",
      "slideTitle" : "スライド #25",
      "telop" : "「一体、何があったんでしょうか…」私は、そう呟く。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "2237EAEB-74D9-41CF-B7E4-868DAC8B84E2",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.026.jpeg",
      "title" : "シーン 25: シーン 26",
      "voiceDuration" : 2.6998185941043085,
      "duration" : 3.2998185941043086,
      "voiceCharacter" : "美鈴"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_美鈴.wav",
      "slideTitle" : "スライド #26",
      "telop" : "だが、歩き出した二人の方は、あっという間に姿が消え、残ったのは、元学園生の霧雨魔理沙とある男性だけだった。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "4B9D5937-2FDE-4A4C-958A-A6EAAD699DFD",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.027.jpeg",
      "title" : "シーン 26: シーン 27",
      "voiceDuration" : 5.554421768707483,
      "duration" : 6.154421768707483,
      "voiceCharacter" : "美鈴"
    },
    {
      "slideTitle" : "スライド #27",
      "telop" : "歩き始めたフランと彼は…",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "id" : "6994A455-DF7B-4B0F-8397-D7B684BFCE52",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "characterName" : "フランドール・スカーレット",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.028.jpeg",
      "title" : "シーン 27: シーン 28",
      "duration" : 3.5
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav",
      "slideTitle" : "スライド #28",
      "telop" : "僕とその女性、フランさんはあるスーパーに寄って行った。\n冷蔵庫がスカスカなために、買い出しにやって来た。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "id" : "E2EE98E1-DE54-49E5-9865-687932A5C7E3",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.029.jpeg",
      "title" : "シーン 28: シーン 29",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceDuration" : 6.9354195011337865,
      "duration" : 7.535419501133786,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "slideTitle" : "スライド #29",
      "telop" : "「そういえば、フランさんって、過去に僕と会ってましたか？」\n僕は、過去の記憶を確かめるために、彼女にそう尋ねる。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "id" : "E3DF9202-FBD4-4C69-B55E-500E71FCECD6",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.030.jpeg",
      "title" : "シーン 29: シーン 30",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceDuration" : 8.10281179138322,
      "duration" : 8.702811791383219,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #30",
      "telop" : "「さあ、どうだろうね。あなたは、思い出せるかしら…」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
