    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」",
      "id" : "CB59F35F-2948-4B0A-A7A0-A940AEA9FB78",
      "backgroundName" : "nc256639_警察署（夜）.jpg",
      "animationName" : "なし",
