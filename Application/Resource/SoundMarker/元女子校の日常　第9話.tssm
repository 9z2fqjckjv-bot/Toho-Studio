    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "あれから、レジで僕が財布を忘れたので、彼女が立て替えて、家に帰ってくると、パックごはんをレンチンする。",
      "id" : "C0C7B2A2-08D1-4DFF-ACC0-B7912157E9A3",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 64",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 7.082154195011338,
      "slideTitle" : "スライド #64",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 7.6821541950113374,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.064.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、レンチンが終わると、蓋を開け、その上に鯖の味噌煮缶とチーズをそのままのせて、再びレンチンする。",
      "id" : "E718B784-BBD8-4344-802F-5CDA540343B7",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 65",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 7.227823129251701,
      "slideTitle" : "スライド #65",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 7.8278231292517,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.065.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "それから、手袋をつけて、レンチンした料理を取り出し、彼女が座っている食卓に運ぶ。「できましたよ、フランさん。」",
      "id" : "D711AA1B-7A20-4A75-914D-7DC5FFD53F47",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 66",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.062607709750568,
      "slideTitle" : "スライド #66",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 8.662607709750567,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
