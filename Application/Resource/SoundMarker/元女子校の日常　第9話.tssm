      "speed" : 100,
      "type" : "Voice",
      "voiceSymbol" : "ワタシガ、テ'レビニ\/ウツ'ッテ+イタ\/バショニ\/ク'ルト、ソコデ'ワ、カ'ノジョガ\/ホーキニ\/マタガ'ッテ,ウ_ツホオ\/トビマワリナ'ガラ、ビ'ームオ\/シュ'ーイニ\/ハナ'ッテ+イタ。",
      "fadeInDuration" : 0,
      "sceneRelativeStartTime" : 0,
      "pan" : 0,
      "waveformPoints" : [
        1,
        1,
        1,
        0.6485717,
        0.8305511,
        1,
        0.55490416,
