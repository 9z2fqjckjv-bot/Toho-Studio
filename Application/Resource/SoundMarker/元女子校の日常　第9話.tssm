    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "結果的に、私は、彼女のビームを避けて、戦うことになってしまい、だんだんと周りのビル群に影響が出始めていった。",
      "id" : "4722C83E-32AD-4BB5-B1FF-5631B4125173",
      "backgroundName" : "nc247230_都会の街中（夕方）.jpg",
      "animationName" : "なし",
