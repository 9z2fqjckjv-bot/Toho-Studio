      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.016.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「くっ…」私には、息子にサインを送る余裕もなく、\n彼女からやってくるビームを再び、避け始めた。」",
      "id" : "DCDA01E6-D24A-4D87-A84C-CF0E3E881B84",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 17",
      "voiceStartTimeOffset" : 0,
      "characterName" : "妹紅",
      "voiceDuration" : 6.718321995464852,
      "slideTitle" : "スライド #17",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "seVolume" : 1,
      "duration" : 7.318321995464852,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_妹紅.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "妹紅",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.017.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「それで、どう。私と一緒に夜の街をお散歩する？」",
      "id" : "7FCBBA14-2B3A-4CBF-B5A3-CFFC4FAB30C9",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 18",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 4.504489795918367,
      "slideTitle" : "スライド #18",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 5.104489795918367,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.018.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「いや、今用事を思い出したので、\nそれを済ませたら、家に帰ります。」",
      "id" : "EFAFE3AB-C657-49E0-B783-9ADEBC460A4A",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 19",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 4.6539002267573695,
      "slideTitle" : "スライド #19",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 5.253900226757369,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.019.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「そう…」",
      "id" : "57EA075A-D664-4893-ADC1-38DD8CF33F8F",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 20",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 1.5,
      "slideTitle" : "スライド #20",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 2.5,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.020.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "僕は、その彼女の表情を見ると、なんだか断るのは、申し訳なく感じてくる。「散歩とは違いますが…僕の用事に付き合ってくれませんか…？」",
      "id" : "E2F6733F-644B-4071-A543-8E2BDBC7C3CA",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 21",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 9.788684807256235,
      "slideTitle" : "スライド #21",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 10.388684807256235,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.021.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「ありがとう！」",
      "id" : "BCC9C7A2-FFED-415A-B885-DFFE89064857",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 22",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 1.5,
      "slideTitle" : "スライド #22",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 2.5,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.022.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "僕は、そう彼女が笑うと、どこかで見たことのあるようなその表情に、過去を思い出しながら、一緒に歩き始めた。",
      "id" : "6652B4B1-5027-44D8-8857-44F98D2B2141",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 23",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 7.656077097505669,
      "slideTitle" : "スライド #23",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 8.256077097505669,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.023.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私が、その場所につき、そっと影から覗くと、一方の男女は戦い、もう一方の男女は一緒にどこかに歩き出していた。",
      "id" : "2163F658-EF11-4097-8F2D-78D0D0006208",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 24",
      "voiceStartTimeOffset" : 0,
      "characterName" : "美鈴",
      "voiceDuration" : 5.582721088435374,
      "slideTitle" : "スライド #24",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "seVolume" : 1,
      "duration" : 6.182721088435374,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_美鈴.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "美鈴",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.024.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「一体、何があったんでしょうか…」私は、そう呟く。",
      "id" : "981578F5-0314-4EE7-9B91-09B827CFD429",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 25",
      "voiceStartTimeOffset" : 0,
      "characterName" : "美鈴",
      "voiceDuration" : 2.6998185941043085,
      "slideTitle" : "スライド #25",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "seVolume" : 1,
      "duration" : 3.2998185941043086,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_美鈴.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "美鈴",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.025.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "だが、歩き出した二人の方は、あっという間に姿が消え、残ったのは、元学園生の霧雨魔理沙とある男性だけだった。",
      "id" : "ED7FA540-4B24-466D-81D7-D5112CFFD290",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 26",
      "voiceStartTimeOffset" : 0,
      "characterName" : "美鈴",
      "voiceDuration" : 5.554421768707483,
      "slideTitle" : "スライド #26",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "seVolume" : 1,
      "duration" : 6.154421768707483,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_美鈴.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "美鈴",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.026.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "歩き始めたフランと彼は…",
      "id" : "58D331B4-9C7A-4DE4-A4E5-61B0CF845C11",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 27",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "slideTitle" : "スライド #27",
      "seVolume" : 1,
      "duration" : 3.5,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.027.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "僕とその女性、フランさんはあるスーパーに寄って行った。\n冷蔵庫がスカスカなために、買い出しにやって来た。",
      "id" : "94505A63-22F3-4BFA-86A8-2BBD6665549C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 28",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 6.9354195011337865,
      "slideTitle" : "スライド #28",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 7.535419501133786,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.028.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「そういえば、フランさんって、過去に僕と会ってましたか？」\n僕は、過去の記憶を確かめるために、彼女にそう尋ねる。",
      "id" : "D1F51527-CC8E-4133-B3E1-7924B49E8B8D",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 29",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.10281179138322,
      "slideTitle" : "スライド #29",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 8.702811791383219,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.029.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「さあ、どうだろうね。あなたは、思い出せるかしら…」",
      "id" : "F2FE39F7-6B3D-4109-86EA-FE6820664C34",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 30",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 4.301995464852608,
      "slideTitle" : "スライド #30",
