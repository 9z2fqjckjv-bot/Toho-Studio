      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #37",
      "telop" : "「どうしようかな…、あなたは何か得意な料理でもあるの？」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
