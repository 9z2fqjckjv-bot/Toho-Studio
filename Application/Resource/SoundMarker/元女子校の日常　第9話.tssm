    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「そんなに焦らなくて大丈夫ですよ、ご飯は逃げませんから。」",
      "id" : "810D773A-63E9-4FFB-BABA-AC7A376B0B8D",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
