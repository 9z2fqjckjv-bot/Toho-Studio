      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #18",
      "telop" : "「それで、どう。私と一緒に夜の街をお散歩する？」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "B6D291CC-FB30-40FE-BC27-72B9DAB66595",
