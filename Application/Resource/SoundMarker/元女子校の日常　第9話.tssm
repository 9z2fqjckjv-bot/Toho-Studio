  "version" : "2.0",
  "scenes" : [
    {
      "seStartTimeOffset" : 0,
      "telop" : "私が、テレビに映っていた場所に来ると、そこでは、彼女が箒に跨って空を飛び回りながら、ビームを周囲に放っていた。\n東方Project二次創作作品",
      "id" : "B4EC348A-80C9-456D-8266-E948EE2F364A",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 1",
      "voiceStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceDuration" : 8.61,
      "slideTitle" : "スライド #1",
      "audioTrack" : "track_voice_sub",
      "seVolume" : 1,
      "duration" : 9.209999999999999,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_サブ.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.001.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、ふと周りを見ると、父が困惑しながら、\nひたすらにそのビームを避けている様子だった。\n作成者：zuyasi",
      "id" : "C68E1DE7-D150-4CC4-A695-5805B2908EC4",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 2",
      "voiceStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceDuration" : 6.050634920634921,
      "slideTitle" : "スライド #2",
      "audioTrack" : "track_voice_sub",
      "seVolume" : 1,
      "duration" : 6.6506349206349205,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_サブ.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.002.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。",
      "id" : "504DD18F-7B7D-48FF-B0C5-256965B36554",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 3: すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。",
      "voiceStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceDuration" : 8.961519274376418,
      "slideTitle" : "スライド #3",
      "audioTrack" : "track_voice_sub",
      "seVolume" : 1,
      "duration" : 9.561519274376417,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_サブ.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.003.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "だが、空腹に抗えるわけでもなく、私はある飲食店に入った。\n制作ソフト及び協力\nGemini\nTohoStuido",
      "id" : "311494AE-B0E5-43E6-9C33-85F171DF2329",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 4",
      "voiceStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceDuration" : 4.574557823129251,
      "slideTitle" : "スライド #4",
      "audioTrack" : "track_voice_sub",
      "seVolume" : 1,
      "duration" : 5.174557823129251,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_サブ.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.004.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "元女子校の日常",
      "id" : "A99DF8F2-1702-4FA9-9FD7-12D6C4D80865",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "title" : "シーン 5: 東方Project二次創作作品　Powerd By zuyasi　※久々の100スライド越えの122スライドです。",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "slideTitle" : "スライド #5",
      "seVolume" : 1,
      "duration" : 3,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.005.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「んっ…」僕は、ふと気がつくと、そこは夜の街中だった。\nそして、ふと周りを見渡していると、魔理沙さんと父が見える。",
      "id" : "7122C701-DE21-41A2-A6AD-B5E8D89170B5",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 6",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.546303854875283,
      "slideTitle" : "スライド #6",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 9.146303854875283,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.006.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "ふともう一度見ると、魔理沙さんはビームを父やビルに向かって乱射するように放ち、父はそれを困った表情で避けていた。",
      "id" : "58398A90-1D79-4D96-8142-AC21B7244095",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 7",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 7.690430839002268,
      "slideTitle" : "スライド #7",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 8.290430839002267,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.007.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "すると、後ろから僕の肩が叩かれる。その方向に振り向くと、この前、夜の学校の廊下で会った女性だった。「こんばんは。」",
      "id" : "BEC1F99F-013B-4422-A710-FFD096C62E8B",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 8",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.887596371882086,
      "slideTitle" : "スライド #8",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 9.487596371882086,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.008.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「こんばんは。こんなところで、どうしたの？」",
      "id" : "2A9362C5-2905-4896-A931-44E47855A510",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 9",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 3.486984126984127,
      "slideTitle" : "スライド #9",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 4.0869841269841265,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.009.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「えっと…」僕はそう言い、なぜ自分がこんな場所に来たかを思い出そうとするが、思い出せない。「分からないです…」",
      "id" : "829DBEEE-8CA8-460C-95CE-AF7F0B86F34B",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 10",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 7.307165532879819,
      "slideTitle" : "スライド #10",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 7.9071655328798185,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.010.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「そう、それより、あなたは、これから、何かの予定はある？」",
      "id" : "FBADC252-AB8C-4D5E-9B51-FCFFEF3832CC",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 11",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 4.814489795918368,
      "slideTitle" : "スライド #11",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 5.414489795918367,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.011.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「えっと…ないです…」",
      "id" : "D0D1AC8C-02F0-4887-9B1E-CAEBC8B792F7",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 12",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 1.5,
      "slideTitle" : "スライド #12",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 2.5,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.012.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「そう、なら私と一緒に、夜の街を歩いてみない？」",
      "id" : "CFDF5DA9-A232-421D-8453-AD7CD3DB1B9B",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 13",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 4.176984126984127,
      "slideTitle" : "スライド #13",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 4.776984126984127,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.013.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「えっと…」僕は、彼女からの誘いに、どう返そうか考えていると、誰かがビルに激突し、僕はその方を見る。",
      "id" : "589519B7-F199-4598-95A2-F154D926BC78",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 14",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 7.824557823129251,
      "slideTitle" : "スライド #14",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 8.424557823129252,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.014.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「痛てぇ…、ついよそ見をしちまったぜ…」私は、彼女からのビームが来ているのにも関わらず、逆ナンを受けている息子を見た。",
      "id" : "F1D37D2B-E1DC-4C56-B7C5-7FD2D91BB723",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "title" : "シーン 15",
      "voiceStartTimeOffset" : 0,
      "characterName" : "妹紅",
      "voiceDuration" : 7.67249433106576,
      "slideTitle" : "スライド #15",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "seVolume" : 1,
      "duration" : 8.27249433106576,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_妹紅.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "妹紅",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.015.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「二ヒヒィ、まだまだ足りないぜ…。」",
      "id" : "098FDAB8-22AF-49CF-85D9-A32FB9BCED14",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
