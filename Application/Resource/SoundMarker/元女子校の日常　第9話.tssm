      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_011_操夢.wav",
      "slideTitle" : "スライド #11",
      "telop" : "「そう、それより、あなたは、これから、何かの予定はある？」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "A1349245-A7CA-4CFE-ABDE-482E68AE933B",
