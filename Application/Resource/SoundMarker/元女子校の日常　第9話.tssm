    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "あれから、数時間程度の間、私は彼女からのビームを避け続けていたが、それでもビームを喰らい、気づけば倒れてしまった。",
      "id" : "AECB1065-188C-4095-BF0B-71C5DA6B9946",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
