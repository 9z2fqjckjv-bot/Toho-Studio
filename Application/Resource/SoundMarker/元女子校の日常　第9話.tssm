    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、サバ味噌煮缶とチーズ、パックご飯をカゴに入れて歩く。\nそして、去り際に、ふりかけが目に入り、それもカゴに入れる。",
      "id" : "CE4D18B9-5D2E-4EB5-BC69-D084D2AD580A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 41",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.634331065759637,
      "slideTitle" : "スライド #41",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 9.234331065759637,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
