      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.039.jpeg",
      "title" : "シーン 38: シーン 39",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceDuration" : 6.462607709750567,
      "duration" : 7.062607709750567,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #39",
      "telop" : "「そう…、なら…リゾットはどう？」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
