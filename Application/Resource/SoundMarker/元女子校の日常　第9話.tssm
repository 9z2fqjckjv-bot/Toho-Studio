    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、目が覚めてからは、ここで時折警官と話したり、考え事をしたりしていた。そして、彼と息子の今の様子が気になる。",
      "id" : "E8D73389-A42D-4AB2-8E46-B81555D19B99",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 96",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
