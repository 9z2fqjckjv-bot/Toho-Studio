    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「どう、私からのキスは？」",
      "id" : "447F957B-2DD6-44A8-809F-EF5C75C470D1",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 77",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceDuration" : 2.194489795918367,
      "slideTitle" : "スライド #77",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "duration" : 2.794489795918367,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_フランドール・スカーレット.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.077.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "彼女はワインを飲みながら、そう僕に聞く。\n「えっと…」僕は返すべき言葉が分からず、戸惑ってしまう。",
      "id" : "CE34D3DA-F028-47FB-AB65-0BBF7376146B",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 78",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 6.835419501133787,
      "slideTitle" : "スライド #78",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 7.4354195011337865,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.078.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "僕は、わずかに彼女と帰宅したことを、後悔した。だが、それよりも、彼女の表情やその声が頭の中に入り込んでくる。",
      "id" : "B8249E52-10E6-4B1E-A35D-29A8C100CBA9",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 79",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.890861678004535,
      "slideTitle" : "スライド #79",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 9.490861678004535,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.079.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「…少しばかし、恥ずかしいです…」僕は、そう返すのだった。",
      "id" : "C895427C-50F9-4972-9A76-15BD14D39F6D",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 80",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 4.174557823129252,
      "slideTitle" : "スライド #80",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 4.774557823129252,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.080.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "その頃、霊夢は…",
      "id" : "20F57908-9224-4D6D-BA3E-FDA817F3CBE1",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "title" : "シーン 81: その頃、霊夢は…",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #81",
      "seVolume" : 1,
      "duration" : 3,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.081.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私は、この取調室でふと今朝のことを思い出していた。",
      "id" : "1C9A0494-4371-4B94-9F89-097BEDA1C1A2",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 82",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 4.366984126984127,
      "slideTitle" : "スライド #82",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 4.966984126984126,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_博麗霊夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.082.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私は、家を出てから、魔理沙の家に着くと、彼女は、ため息をつきながら、どこか暗く感じる表情をしていた。",
      "id" : "64EF3230-C222-4795-ABA0-106D7A7988FE",
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "animationName" : "なし",
      "title" : "シーン 83",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 8.756984126984127,
      "slideTitle" : "スライド #83",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 9.356984126984127,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.083.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私が、彼女にそんな表情をしている理由を問うと、昨晩の就寝時に、やけ酒をしていると、ふと不思議な声が聞こえたという。",
      "id" : "64A7D24F-28DF-4977-903D-3A587DCF2046",
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "animationName" : "なし",
      "title" : "シーン 84",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 9.694489795918367,
      "slideTitle" : "スライド #84",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 10.294489795918366,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.084.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、気がつけば、赤信号の横断歩道を渡っており、彼が止めなければ、きっとあのまま車に轢かれていたという。",
      "id" : "2783AAD5-BC46-4916-8B35-A15C861FA8CE",
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "animationName" : "なし",
      "title" : "シーン 85",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 8.569478458049886,
      "slideTitle" : "スライド #85",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 9.169478458049886,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.085.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "私は、その症状が時折彼女に現れることを知っていて、だが、出来事が起きてから、翌朝には記憶から消えることを知っていた。",
      "id" : "A7300CFB-2C39-4EED-B84E-850060484278",
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "animationName" : "なし",
      "title" : "シーン 86",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 10.046984126984126,
      "slideTitle" : "スライド #86",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 10.646984126984126,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.086.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "だが、彼女はあの後も、悪夢に悩まされていて、今日1日を無事に過ごせるかが不安だというので、励まし、私は仕事に向かった。",
      "id" : "8050DD7B-1D39-4331-B20C-577C56AB6D16",
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "animationName" : "なし",
      "title" : "シーン 87",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 10.403242630385488,
      "slideTitle" : "スライド #87",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 11.003242630385488,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.087.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "それから、時が進み、夕陽がさしていた頃、\n彼女が突如として私が勤めている神社に現れた。",
      "id" : "374A331E-D7B9-45F6-BA65-463C9F83ADB0",
      "backgroundName" : "nc73538_【背景素材】博麗神社.pxd",
      "animationName" : "なし",
      "title" : "シーン 88",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 7.804489795918367,
      "slideTitle" : "スライド #88",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 8.404489795918368,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_博麗霊夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc73538_【背景素材】博麗神社.pxd",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.088.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "すると、彼女は、私にあることを聞いてくる。それは、以前の彼女なら気にすることもなかったはずの内容だった。",
      "id" : "450F5AE0-5777-4F3B-8BC1-74F4D8D1E3CD",
      "backgroundName" : "nc73538_【背景素材】博麗神社.pxd",
      "animationName" : "なし",
      "title" : "シーン 89",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 8.965736961451247,
      "slideTitle" : "スライド #89",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 9.565736961451247,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_博麗霊夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc73538_【背景素材】博麗神社.pxd",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.089.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "今考えれば、それはある予兆だったのだとわかる。\nだが、その時の私は、再度、励ます程度で済ませてしまった。",
      "id" : "61E4A77A-8DAD-4D5A-9223-C6FAF6F4738A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.pxd",
      "animationName" : "なし",
      "title" : "シーン 90",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 9.343242630385488,
      "slideTitle" : "スライド #90",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 9.943242630385488,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_博麗霊夢.wav",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc73538_【背景素材】博麗神社.pxd",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.090.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "一応励ましたものの、様子が気になった私は、神社を早く出て、彼女を再度見ると、顔色が先ほどよりも悪くなっていた。",
      "id" : "29F3C974-A225-4681-9F4C-A148D031D256",
      "backgroundName" : "nc247230_都会の街中（夕方）.jpg",
      "animationName" : "なし",
      "title" : "シーン 91",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 9.796984126984126,
      "slideTitle" : "スライド #91",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 10.396984126984126,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.091.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、彼女は、ある言葉を私にいう。私は、その言葉に思わず彼女を平手打ちし、なぜそんなことを言うのかと問いただす。",
      "id" : "5E2140A7-F408-4129-BBF5-F03680EC3A86",
      "backgroundName" : "nc247230_都会の街中（夕方）.jpg",
      "animationName" : "なし",
      "title" : "シーン 92",
      "voiceStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceDuration" : 10.066984126984128,
      "slideTitle" : "スライド #92",
      "audioTrack" : "track_voice_reimu",
      "seVolume" : 1,
      "duration" : 10.666984126984127,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_博麗霊夢.wav",
      "transitionName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.092.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "すると、彼女は、謎に笑い出し、だんだんと様子が変わっていき、まるで悩みなどなかったように笑うと、ビームを出した。",
      "id" : "C9386A87-0E9D-4702-8471-E90563F152CA",
      "backgroundName" : "nc247230_都会の街中（夕方）.jpg",
