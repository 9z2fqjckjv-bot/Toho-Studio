      ],
      "duration" : 10.068231292517007,
      "startTime" : 696.1364625850338,
      "pitch" : 100,
      "text" : "私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」",
      "volume" : 1,
      "fadeOutDuration" : 0,
      "name" : "[博麗霊夢] 私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」",
      "voiceTriggerOffset" : 0,
      "isCutOffOnSceneEnd" : true,
      "isReversed" : false,
      "trackId" : "track_voice_reimu",
