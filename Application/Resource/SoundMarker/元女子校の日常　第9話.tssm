      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.066.jpeg"
    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「ありがとう、紅夢くん。」私はそう言い、彼から箸を受け取ると、そのまま熱々の料理を口に頬張る。",
      "id" : "233BA7F4-46AD-4AF3-8B54-D80734334DF1",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "animationName" : "なし",
      "title" : "シーン 67",
      "voiceStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
