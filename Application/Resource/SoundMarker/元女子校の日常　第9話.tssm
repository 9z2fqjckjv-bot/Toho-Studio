    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「あっち…」私はそう言いながら、口をハフハフさせる。",
      "id" : "F622112A-5573-424E-9226-DA8D8D78D8D7",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
