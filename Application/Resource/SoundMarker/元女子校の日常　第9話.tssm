      "id" : "5A6B9885-A706-4C3F-9898-832913EF2073",
      "seVolume" : 0.85,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/グラスにワインを注ぐ.mp3",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.075.jpeg",
      "title" : "シーン 74: シーン 75",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
