  "version" : "2.0",
  "scenes" : [
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_サブ.wav",
      "slideTitle" : "スライド #1",
      "telop" : "私が、テレビに映っていた場所に来ると、そこでは、彼女が箒に跨って空を飛び回りながら、ビームを周囲に放っていた。\n東方Project二次創作作品",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "C5CE9625-E471-4286-B208-C4F0E63E0F73",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_sub",
      "characterName" : "サブ",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.001.jpeg",
      "title" : "シーン 1",
      "voiceDuration" : 8.61,
      "duration" : 9.209999999999999,
      "voiceCharacter" : "サブ"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_サブ.wav",
      "slideTitle" : "スライド #2",
      "telop" : "そして、ふと周りを見ると、父が困惑しながら、\nひたすらにそのビームを避けている様子だった。\n作成者：zuyasi",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "EC557C6F-9235-48DF-BF58-97488D005788",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_sub",
      "characterName" : "サブ",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.002.jpeg",
      "title" : "シーン 2",
      "voiceDuration" : 6.050634920634921,
      "duration" : 6.6506349206349205,
      "voiceCharacter" : "サブ"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_サブ.wav",
      "slideTitle" : "スライド #3",
      "telop" : "すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "125C75F0-6699-451B-BB34-27A6E9684C35",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_sub",
      "characterName" : "サブ",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.003.jpeg",
      "title" : "シーン 3: すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。",
      "voiceDuration" : 8.961519274376418,
      "duration" : 9.561519274376417,
      "voiceCharacter" : "サブ"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_サブ.wav",
      "slideTitle" : "スライド #4",
      "telop" : "だが、空腹に抗えるわけでもなく、私はある飲食店に入った。\n制作ソフト及び協力\nGemini\nTohoStuido",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "2675FCDE-3490-4980-A673-F63445C9C648",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_sub",
      "characterName" : "サブ",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.004.jpeg",
      "title" : "シーン 4",
      "voiceDuration" : 4.574557823129251,
      "duration" : 5.174557823129251,
      "voiceCharacter" : "サブ"
    },
    {
      "slideTitle" : "スライド #5",
      "telop" : "元女子校の日常",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "id" : "F173123A-EDEF-44AA-8DEC-D0153C29062E",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.005.jpeg",
      "title" : "シーン 5: 東方Project二次創作作品　Powerd By zuyasi　※久々の100スライド越えの122スライドです。",
      "duration" : 3
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "slideTitle" : "スライド #6",
      "telop" : "「んっ…」僕は、ふと気がつくと、そこは夜の街中だった。\nそして、ふと周りを見渡していると、魔理沙さんと父が見える。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "EF33347F-D420-4687-8AD9-37855CBDD46A",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.006.jpeg",
      "title" : "シーン 6",
      "voiceDuration" : 8.546303854875283,
      "duration" : 9.146303854875283,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "slideTitle" : "スライド #7",
      "telop" : "ふともう一度見ると、魔理沙さんはビームを父やビルに向かって乱射するように放ち、父はそれを困った表情で避けていた。",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "51F70788-D5E5-449F-8F52-A2BD86BB30BF",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.007.jpeg",
      "title" : "シーン 7",
      "voiceDuration" : 7.690430839002268,
      "duration" : 8.290430839002267,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "slideTitle" : "スライド #8",
      "telop" : "すると、後ろから僕の肩が叩かれる。その方向に振り向くと、この前、夜の学校の廊下で会った女性だった。「こんばんは。」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "C0355E9D-46B6-4353-A65E-CF38B87A046C",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.009.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "title" : "シーン 8: シーン 9",
      "voiceDuration" : 8.887596371882086,
      "duration" : 9.487596371882086,
      "voiceCharacter" : "操夢"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #9",
      "telop" : "「こんばんは。こんなところで、どうしたの？」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "A8C0E411-497A-4652-9E8E-2E945DAE7006",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.010.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
      "title" : "シーン 9: シーン 10",
      "voiceDuration" : 3.486984126984127,
      "duration" : 4.0869841269841265,
      "voiceCharacter" : "フランドール・スカーレット"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "slideTitle" : "スライド #10",
      "telop" : "「えっと…」僕はそう言い、なぜ自分がこんな場所に来たかを思い出そうとするが、思い出せない。「分からないです…」",
      "backgroundName" : "nc247232_都会の街中（夜）.jpg",
      "animationName" : "なし",
      "id" : "A6D215BB-07A7-4A55-871A-E48005F1F6F7",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.011.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
