    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "「フランさんは、夕飯はもう食べましたか？」\n僕はそう彼女に聞く。",
      "id" : "E1630703-863D-48FB-82FB-04E4111CE25B",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 32",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 4.5778231292517,
      "slideTitle" : "スライド #32",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "duration" : 5.1778231292517,
