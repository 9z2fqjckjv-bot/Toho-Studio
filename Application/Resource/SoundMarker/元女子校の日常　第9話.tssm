    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "そして、卵売り場に向かい、卵を手に取る。ふと、振り返ると、彼女の姿が見えなかった。僕は、彼女を探す。",
      "id" : "B33DFBDF-77E9-42BD-B008-11AA909A28F5",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
