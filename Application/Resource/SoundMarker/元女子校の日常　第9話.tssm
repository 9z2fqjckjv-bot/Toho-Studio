    },
    {
      "seStartTimeOffset" : 0,
      "telop" : "僕は、その彼女の表情を見て、僕がそれを思い出すまでは、答えなささそうなので、献立を考え、食材を見ていく。",
      "id" : "79DE8838-1996-4F98-A8A1-630091A4D618",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "title" : "シーン 31",
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceDuration" : 8.266938775510203,
      "slideTitle" : "スライド #31",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png",
