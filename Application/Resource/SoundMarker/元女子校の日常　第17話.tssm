      "voice2StartTimeOffset" : 0,
      "id" : "CFE4F237-EC12-40E3-8399-F86246FE6D6F",
      "title" : "シーン 67",
      "seVolume" : 1,
      "telop" : "そこには、なぜか、頬照りながら困るこいしと、ため息をつくさとりの姿があった。「二人とも、どうしたんですか？」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav",
