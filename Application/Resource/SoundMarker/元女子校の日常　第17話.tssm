      "id" : "2875D096-E3FE-451E-BFF6-FF70E3E020FE",
      "title" : "シーン 60",
      "seVolume" : 1,
      "telop" : "「それで、これからどうする？」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_古明地こいし.wav",
