    },
    {
      "voiceDuration" : 6.423469387755102,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #68",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.068.jpeg",
