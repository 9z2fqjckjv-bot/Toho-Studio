      "title" : "シーン 70",
      "seVolume" : 1,
      "telop" : "「ええ、分かったわ…、それじゃあ、行ってくるわね…」\n私はそう言うと、本屋を見に行った。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_アリス・マーガトロイド.wav",
