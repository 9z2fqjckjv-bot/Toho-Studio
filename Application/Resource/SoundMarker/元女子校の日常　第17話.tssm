      "id" : "4FC57CF2-6BDD-458F-BDCD-39F4C4A6C106",
      "title" : "シーン 81",
      "seVolume" : 1,
      "telop" : "「ありがとう…！」\n私はそう言うと、早速、そのお店に入って行った。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_古明地こいし.wav",
