      "id" : "CED1944E-385F-4A68-A59B-4EEE8A02B340",
      "title" : "シーン 80",
      "seVolume" : 1,
      "telop" : "「えっ、こいし。本気でくじ引きをするの？紅夢さんも、\n無理にお金を出そうとしなくて、大丈夫ですよ。」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_古明地さとり.wav",
