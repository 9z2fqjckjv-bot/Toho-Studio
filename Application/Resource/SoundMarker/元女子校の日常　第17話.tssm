      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #65",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.065.jpeg",
      "transitionName" : "なし",
