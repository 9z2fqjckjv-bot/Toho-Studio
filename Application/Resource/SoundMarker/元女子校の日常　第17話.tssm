      "id" : "CB45B2FF-4790-46F2-8B98-F019251BE038",
      "title" : "シーン 38",
      "seVolume" : 1,
      "telop" : "「紅夢、大丈夫？顔が青ざめてるよ…。」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_フランドール・スカーレット.wav",
