      "id" : "252D1889-4821-42DA-909D-72F88299B86C",
      "title" : "シーン 65",
      "seVolume" : 1,
      "telop" : "「班長がこう言うのあれかもだけど…、本屋を見にいってても大丈夫かしら…」私は、そう彼に、尋ねる。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_アリス・マーガトロイド.wav",
