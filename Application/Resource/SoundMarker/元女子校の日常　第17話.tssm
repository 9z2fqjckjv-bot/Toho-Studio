      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "duration" : 10.561995464852608,
      "characterName" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 10.585736961451246,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #40",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.040.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "15EEE504-9B93-4CB3-8998-B8499490C424",
      "title" : "シーン 40",
      "seVolume" : 1,
      "telop" : "「本当に、大丈夫なの？何か、あるなら私に相談してね…」\n私は、彼にそう言うと、病室を去り、家に帰っていった。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_フランドール・スカーレット.wav",
