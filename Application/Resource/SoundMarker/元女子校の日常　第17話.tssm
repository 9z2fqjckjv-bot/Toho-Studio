      "id" : "F96AA572-9E6C-4666-AB67-7E378AD0FF24",
      "title" : "シーン 30",
      "seVolume" : 1,
      "telop" : "「少しばかし、悪い夢を見ていただけですよ…」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav",
