      "id" : "92476781-E95E-4989-B77A-B3E7793149F6",
      "title" : "シーン 68",
      "seVolume" : 1,
      "telop" : "だが、互いに何も言わず、気まずい空気になってしまう。\n僕は仕方なく、アリスの方を向く。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav",
