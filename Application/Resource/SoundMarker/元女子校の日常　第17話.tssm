      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "2CE8AF63-A72A-4CEF-8B2D-7860344A0554",
      "title" : "シーン 56",
      "seVolume" : 1,
      "telop" : "僕は、場の空気が気まずくなるのを感じ、流れを変えようと、3人に提案する。「とりあえず、ショッピングモールに行きませんか？」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "duration" : 9.114761904761904,
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 5.718344671201814,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #57",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.057.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "FF9EC19F-5791-40F3-90DC-9CF2140FAF10",
      "title" : "シーン 57",
      "seVolume" : 1,
      "telop" : "「とりあえず、その予定だったし、そうしましょ。」\nそれから、私たちは、ショッピングモールに向かって歩く。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_アリス・マーガトロイド.wav",
