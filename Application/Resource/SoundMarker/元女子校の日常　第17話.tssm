      "id" : "A33A872A-FF49-42B6-BDBF-752E86F62801",
      "title" : "シーン 92",
      "seVolume" : 1,
      "telop" : "内容は、学校側で決めたメンバーで数日間の間、家以外の場所で1日を過ごし、与えられた課題をこなすと言うものだった。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_操夢.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.996303854875283,
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg"
    },
    {
      "voiceDuration" : 7.7995464852607705,
