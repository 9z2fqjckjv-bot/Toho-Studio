      "id" : "EDA691B5-4303-4195-ADFC-4DB36A3D9124",
      "title" : "シーン 39",
      "seVolume" : 1,
      "telop" : "僕は、彼女の声掛けで我に帰る。「あっ…お弁当美味しかったです…」僕は、自分の思考を悟られないように、そう誤魔化す。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_フランドール・スカーレット.wav",
