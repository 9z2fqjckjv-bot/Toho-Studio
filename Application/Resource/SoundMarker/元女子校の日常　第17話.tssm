      "audioTrack" : "track_voice_soumu",
      "duration" : 5.186507936507936,
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 1.633061224489796,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #62",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.062.jpeg",
