      "id" : "B213402E-61C7-47F5-B8C3-D87527FF703E",
      "title" : "シーン 61",
      "seVolume" : 1,
      "telop" : "僕はそう彼女に聞かれ、考える。すると、アリスが話し出す。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
