      "id" : "C2ADC5E5-D8F6-465B-ACCF-45FF3DC95059",
      "title" : "シーン 55",
      "seVolume" : 1,
      "telop" : "「確かに、アリスさんの言うとおり…」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_古明地こいし.wav",
