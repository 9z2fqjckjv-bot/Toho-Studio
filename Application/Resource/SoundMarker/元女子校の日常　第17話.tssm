      "title" : "シーン 66",
      "seVolume" : 1,
      "telop" : "僕は、彼女にそう聞かれ、ふと二人の方を見る。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
