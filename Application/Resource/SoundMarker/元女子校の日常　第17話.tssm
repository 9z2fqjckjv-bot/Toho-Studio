      "id" : "FD3C8C6C-286F-4BF5-A34F-CD686A0F8955",
      "title" : "シーン 62",
      "seVolume" : 1,
      "telop" : "「私は、本屋に行きたいわ…。」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_アリス・マーガトロイド.wav",
