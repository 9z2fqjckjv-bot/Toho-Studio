      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "duration" : 2.515986394557823,
      "characterName" : "古明地さとり",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 5.001088435374149,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #53",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.053.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "7FE5FCFA-163D-461B-8A60-DE4D25CE2D7E",
      "title" : "シーン 53",
      "seVolume" : 1,
      "telop" : "「私が考えていたよりも、お台場を選んだ人が多いみたい…」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_古明地こいし.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "古明地こいし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "duration" : 5.601088435374149,
      "characterName" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 6.1873015873015875,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #54",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.054.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "D0D58901-795C-4398-ACF2-26A600536698",
      "title" : "シーン 54",
      "seVolume" : 1,
      "telop" : "「電車に乗っていてわかってるとは思いますが、新宿とかなら、この倍以上の人がいるから、それと比べたらすいてるわよ。」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_アリス・マーガトロイド.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
