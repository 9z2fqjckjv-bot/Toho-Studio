      "title" : "シーン 76",
      "seVolume" : 1,
      "telop" : "「紅夢…、そのお店で洋服を見てきてもいい？」",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_古明地こいし.wav",
