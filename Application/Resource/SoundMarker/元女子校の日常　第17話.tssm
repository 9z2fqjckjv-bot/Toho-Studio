      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "duration" : 6.318344671201814,
      "characterName" : "アリス・マーガトロイド",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 8.55172335600907,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #58",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.058.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "89A5A4E4-33E8-4A7F-ACF0-6553C49EC7C3",
      "title" : "シーン 58",
      "seVolume" : 1,
      "telop" : "僕たちは、それから駅から数分程度歩き、ショッピングモールにやってきた。明日から大型連休だからか、そこそこ人がいた。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
