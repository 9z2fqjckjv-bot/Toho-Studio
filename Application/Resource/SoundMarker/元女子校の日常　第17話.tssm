      "id" : "C62B7C3B-3F09-4152-9FD6-43C31F1C6ED5",
      "title" : "シーン 93",
      "seVolume" : 1,
      "telop" : "僕は、前の学校であった泊まりを含む行事の参加を、全て見送っていた。それを踏まえての試験だと記載されていた…。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_操夢.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.399546485260771,
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg"
    },
    {
