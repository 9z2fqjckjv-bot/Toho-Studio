    },
    {
      "voiceDuration" : 4.864399092970522,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #63",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.063.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "0D4E5B29-21FD-4ED9-ADF6-1F2467367335",
      "title" : "シーン 63",
      "seVolume" : 1,
      "telop" : "「こいし、さっきからどうしたの？」\n私は、こいしがそっぽを向いていたので、そう声をかける。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_古明地さとり.wav",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "古明地さとり",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "duration" : 5.464399092970521,
      "characterName" : "古明地さとり",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "voiceDuration" : 5.1171201814058955,
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #64",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.064.jpeg",
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "id" : "7B1FF41E-5BAC-4163-9F97-100FB190F980",
      "title" : "シーン 64",
      "seVolume" : 1,
      "telop" : "「えっ？」私は、彼女にそう声をかけられ、驚く。",
      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_古明地こいし.wav",
