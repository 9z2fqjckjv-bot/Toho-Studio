      "animationName" : "なし",
      "id" : "0769AE0E-E9C7-460D-8996-40B8ED61345C",
      "voiceCharacter" : "十六夜咲夜",
      "duration" : 3.5,
      "telop" : "「どうしたんですか…そんな表情をして。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_十六夜咲夜.wav",
      "slideTitle" : "スライド #77",
      "title" : "シーン 77"
    },
    {
      "characterName" : "操夢",
      "backgroundName" : "リビング（夕方）.jpeg",
      "voiceDuration" : 6.599546485260771,
      "transitionName" : "なし",
