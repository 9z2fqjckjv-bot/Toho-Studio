  "totalDuration" : 444.8299092970522,
  "scenes" : [
    {
      "title" : "シーン 1",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は、ふと目が覚めると、そこは学校の保健室だった。\n東方Project二次創作作品",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav",
      "slideTitle" : "スライド #1",
      "voiceDuration" : 3.8723809523809525,
      "audioTrack" : "track_voice_soumu",
      "id" : "A06673B1-FC61-42BE-B81E-BD7025303092",
      "duration" : 4.472380952380952
    },
    {
      "title" : "シーン 2",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "ふと隣を見ると彼女がすやすやと気持ちよさそうに眠っていた。\n作成者：zuyasi",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "slideTitle" : "スライド #2",
      "voiceDuration" : 4.03063492063492,
      "audioTrack" : "track_voice_soumu",
      "id" : "1541AC3D-4E6D-44DD-AD8E-61A642893955",
      "duration" : 4.63063492063492
    },
    {
      "title" : "シーン 3: 僕は、彼女を起こさないように、そっとベッドから降りる。",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は、彼女を起こさないように、そっとベッドから降りる。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "単色背景",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "slideTitle" : "スライド #3",
      "voiceDuration" : 3.5865079365079366,
      "audioTrack" : "track_voice_soumu",
      "id" : "96A79BB6-EC24-46FD-9358-DCC5800B878A",
      "duration" : 4.186507936507937
    },
    {
      "title" : "シーン 4",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "animationName" : "なし",
      "telop" : "「んっ…」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "voiceCharacter" : "古明地こいし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地こいし.wav",
      "slideTitle" : "スライド #4",
      "voiceDuration" : 1.5,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "id" : "227B7F61-6CDC-49F5-8961-915553559BA5",
      "duration" : 3.5
    },
    {
      "title" : "シーン 5",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "animationName" : "なし",
      "telop" : "「ここは…、どこ…、あなたは…だれ…?」\n私は、そう私を見てくる彼に尋ねる。",
      "voiceCharacter" : "古明地こいし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav",
      "slideTitle" : "スライド #5",
      "voiceDuration" : 3.6682312925170066,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "id" : "21527716-A0F0-4C94-B7E4-D67411BB9806",
      "duration" : 4.268231292517006
    },
    {
      "title" : "シーン 6",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「ここは、学校の保健室で、僕が覚えているのは、こいしさんとエンドレスランをしていて、途中で倒れる直前まで…です。」",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "slideTitle" : "スライド #6",
      "voiceDuration" : 8.266938775510203,
      "audioTrack" : "track_voice_soumu",
      "id" : "A16AF4CA-A186-41E9-B25E-90DE0319DA4B",
      "duration" : 8.866938775510203
    },
    {
      "title" : "シーン 7",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "animationName" : "なし",
      "telop" : "「えっと…あなたは、エンドレスランの途中で私を、お姫様抱っこした、紅夢さんですか？」私は、目覚めた頭でそう問う。",
      "voiceCharacter" : "古明地こいし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_古明地こいし.wav",
      "slideTitle" : "スライド #7",
      "voiceDuration" : 5.550136054421769,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "id" : "F03B0286-4C4E-403F-ACF5-80777E4A3572",
      "duration" : 6.150136054421768
    },
    {
      "title" : "シーン 8",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「それで…合ってます…」僕がそう言うと、なんとも言えない空気感が、保健室を包み込む。すると、扉が開く。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "slideTitle" : "スライド #8",
      "voiceDuration" : 8.095215419501134,
      "audioTrack" : "track_voice_soumu",
      "id" : "3695F29B-282B-4336-8962-21C29C77431A",
      "duration" : 8.695215419501134,
      "seName" : "[SE] 教室の戸を開ける.mp3"
    },
    {
      "title" : "シーン 9",
      "transitionName" : "なし",
      "characterName" : "萃香",
      "animationName" : "なし",
      "telop" : "「あんたたち、昨日のエンドレスランで、過去最低の記録を生み出したそうじゃないか…、その話、詳しく聞かせなさい。」",
      "voiceCharacter" : "萃香",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_萃香.wav",
      "slideTitle" : "スライド #9",
      "voiceDuration" : 5.8363265306122445,
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "id" : "B8488D60-1C26-49EF-A434-B39BCAF132A1",
      "duration" : 6.436326530612244
    },
    {
      "title" : "シーン 10",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「えっと…」僕は、その強面の彼女に、怖気付いてしまう。\nだが、勇気を出して言う、「それは…どう言う意味ですか？」",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "slideTitle" : "スライド #10",
      "voiceDuration" : 8.213673469387755,
      "audioTrack" : "track_voice_soumu",
      "id" : "24D809BD-6F44-4CD8-A81C-0378F688D44C",
      "duration" : 8.813673469387755
    },
    {
      "title" : "シーン 11",
      "transitionName" : "なし",
      "characterName" : "萃香",
      "animationName" : "なし",
      "telop" : "「美鈴から、聞いた話だと、途中からそこの彼女を、抱っこして走ったそうじゃないか？私だったら、そうはさせなかったぞ。」",
      "voiceCharacter" : "萃香",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_萃香.wav",
      "slideTitle" : "スライド #11",
      "voiceDuration" : 6.781315192743764,
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "id" : "7CE8B486-4EA9-4BF9-8C1C-F46E84174C1A",
      "duration" : 7.381315192743764
    },
    {
      "title" : "シーン 12",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕たちはそれから、その女性の説教を、\nチャイムがなるまで聞かされるのだった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "slideTitle" : "スライド #12",
      "voiceDuration" : 4.9419501133786845,
      "audioTrack" : "track_voice_soumu",
      "id" : "3C7038FD-6B90-46F5-9E71-3FBEAD87E7E8",
      "duration" : 5.541950113378684
    },
    {
      "slideTitle" : "スライド #13",
      "id" : "6578CF88-A917-4B3B-9F95-44A1AC13EC1B",
      "duration" : 3,
      "transitionName" : "なし",
      "backgroundName" : "単色背景",
      "animationName" : "なし",
      "telop" : "元女子校の日常",
      "characterName" : "博麗霊夢",
      "title" : "シーン 13: 東方Project二次創作作品　Powerd By zuyasi"
    },
    {
      "title" : "シーン 14",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕が、彼女の説教を聞き終えてから、教室に来ると、\nすでに1時間目が始まるまであと1分だった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav",
      "slideTitle" : "スライド #14",
      "voiceDuration" : 6.915850340136054,
      "audioTrack" : "track_voice_soumu",
      "id" : "A4846036-9B59-467A-B006-D076E32D29BE",
      "duration" : 7.515850340136054
    },
    {
      "title" : "シーン 15",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "そして、机に来ると、教科書の束が置いてあった。そして、付箋が机に貼られていて、今日の1時間目は現代文だった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "slideTitle" : "スライド #15",
      "voiceDuration" : 8.521292517006803,
      "audioTrack" : "track_voice_soumu",
      "id" : "1BE44EB2-F667-4729-8CCB-EAD62922DA2F",
      "duration" : 9.121292517006802
    },
    {
      "title" : "シーン 16",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "それから、僕の元女子校生活３日目が始まった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "slideTitle" : "スライド #16",
      "voiceDuration" : 3.6332426303854874,
      "audioTrack" : "track_voice_soumu",
      "id" : "8AC3585E-09AF-47BE-849D-1790620A2616",
      "duration" : 4.2332426303854875
    },
    {
      "slideTitle" : "スライド #17",
      "id" : "69E52A88-1251-4A95-A20D-18973DD74183",
      "duration" : 3.5,
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "telop" : "それから時間が進み…",
      "characterName" : "ナレーション",
      "title" : "シーン 17"
    },
    {
      "title" : "シーン 18",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕が、午前中の授業を終えると、\nふと、昼食がないことを思い出す。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "slideTitle" : "スライド #18",
      "voiceDuration" : 4.8278231292517,
      "audioTrack" : "track_voice_soumu",
      "id" : "90B3C8FE-E9F5-4195-B596-5F21032DFD3E",
      "duration" : 5.4278231292517
    },
    {
      "title" : "シーン 19",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "そこで、ふとさとりの姿を探す。\nだが、彼女は教室にはいなかった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "slideTitle" : "スライド #19",
      "voiceDuration" : 5.148458049886622,
      "audioTrack" : "track_voice_soumu",
      "id" : "3A1D9C8A-562B-486B-8CAB-F359E9FEDB9C",
      "duration" : 5.748458049886621
    },
    {
      "title" : "シーン 20",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "仕方なく、僕は廊下に出て歩いていると、\nふと向こうから、誰かがやってくる。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav",
      "slideTitle" : "スライド #20",
      "voiceDuration" : 5.108253968253968,
      "audioTrack" : "track_voice_soumu",
      "id" : "A86825BC-3074-4F72-A5B8-0D2A8B19EF2F",
      "duration" : 5.708253968253968
    },
    {
      "title" : "シーン 21",
      "transitionName" : "なし",
      "characterName" : "東風谷早苗",
      "animationName" : "なし",
      "telop" : "「おや、藤原さんですか、ちょうどよかった。あなた宛の荷物が来てたので、ちょうど渡そうとしてたところですよ。」",
      "voiceCharacter" : "東風谷早苗",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_東風谷早苗.wav",
      "slideTitle" : "スライド #21",
      "voiceDuration" : 7.042222222222223,
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "id" : "F7EFB1C9-040E-4F8C-8817-29E60600743F",
      "duration" : 7.642222222222222
    },
    {
      "title" : "シーン 22",
      "transitionName" : "なし",
      "characterName" : "東風谷早苗",
      "animationName" : "なし",
      "telop" : "「これ、魔理沙と名乗る女性から、預かった荷物です。」\n私はそう言うと、彼にそれを渡す。",
      "voiceCharacter" : "東風谷早苗",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_東風谷早苗.wav",
      "slideTitle" : "スライド #22",
      "voiceDuration" : 6.116371882086168,
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "id" : "36B78CA0-447A-4B49-9B9F-7BD464318410",
      "duration" : 6.716371882086167
    },
    {
      "title" : "シーン 23",
      "transitionName" : "なし",
      "characterName" : "東風谷早苗",
      "animationName" : "なし",
      "telop" : "「では、私は、この後用があるので、ここで失礼します。」\n私はそう言うと、そのまま歩き出した。",
      "voiceCharacter" : "東風谷早苗",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_東風谷早苗.wav",
      "slideTitle" : "スライド #23",
      "voiceDuration" : 6.6761904761904765,
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "id" : "091EC76B-4C4E-4E55-86E3-78CBFD2BA599",
      "duration" : 7.276190476190476
    },
    {
      "title" : "シーン 24",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は、彼女に渡された荷物を持って、自席に戻ると、荷物を包んでいた風呂敷を時中を見ると、小瓶と弁当と紙があった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "slideTitle" : "スライド #24",
      "voiceDuration" : 8.610430839002268,
      "audioTrack" : "track_voice_soumu",
      "id" : "8680044F-8C59-4A11-9C5C-ECDC2805A547",
      "duration" : 9.210430839002267
    },
    {
      "title" : "シーン 25",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は、その紙を見る。そこには、寄り道がてら、母から僕の弁当を受け取って、事務室に届けたことともう一つあった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav",
      "slideTitle" : "スライド #25",
      "voiceDuration" : 8.534331065759638,
      "audioTrack" : "track_voice_soumu",
      "id" : "1DF7ADDB-E629-46E3-8109-AF54D92ACC41",
      "duration" : 9.134331065759637
    },
    {
      "title" : "シーン 26",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "それは、この小瓶には試験薬が入っていて、それを飲めば、きっと僕の役に立つから飲んでみなさいと言う文章だった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav",
      "slideTitle" : "スライド #26",
      "voiceDuration" : 7.45281179138322,
      "audioTrack" : "track_voice_soumu",
      "id" : "B4D9298B-F5B4-41F1-A3F9-CAA0C7C6583F",
      "duration" : 8.05281179138322
    },
    {
      "title" : "シーン 27",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は、その小瓶を手に取り眺める。そこには水に近い色合いの液体と、牛乳の色をした液体が入っていた。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav",
      "slideTitle" : "スライド #27",
      "voiceDuration" : 7.490861678004535,
      "audioTrack" : "track_voice_soumu",
      "id" : "277E6A36-8296-4E90-876D-36FAEF1F7B5B",
      "duration" : 8.090861678004535
    },
    {
      "title" : "シーン 28",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕はとりあえず、割れないように小瓶をどかすと、弁当を食べる。\nそして、弁当を数十分で食べ切ると、再び瓶を手に取る。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav",
      "slideTitle" : "スライド #28",
      "voiceDuration" : 8.545215419501133,
      "audioTrack" : "track_voice_soumu",
      "id" : "2E0E1D5E-FB3C-4B29-913E-E0AE981A7AB8",
      "duration" : 9.145215419501133
    },
    {
      "title" : "シーン 29",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕が、その瓶をぼーっと眺めていると、\n誰かが教室に入り、僕の席に駆け寄ってくる。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "slideTitle" : "スライド #29",
      "voiceDuration" : 6.058253968253968,
      "audioTrack" : "track_voice_soumu",
      "id" : "AC2D3C12-3111-436A-8DA9-A9F4D120137D",
      "duration" : 6.658253968253968,
      "seName" : "SE: 教室の戸を開ける"
    },
    {
      "title" : "シーン 30",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「あんた、これ、どこで手に入れたの？」\n私は、彼からその瓶を取り上げ、そう尋ねる。",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #30",
      "voiceDuration" : 5.1407482993197275,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "ED620C74-926B-4C8E-B582-5AC4C05D6B5B",
      "duration" : 5.740748299319727
    },
    {
      "title" : "シーン 31",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「えっと…母の知人からです…」\n僕は、ビクビクしながらそう答える。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "slideTitle" : "スライド #31",
      "voiceDuration" : 4.672380952380952,
      "audioTrack" : "track_voice_soumu",
      "id" : "BE564F25-FE63-4A1B-B255-4ECD4F27602B",
      "duration" : 5.272380952380952
    },
    {
      "title" : "シーン 32",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「その知人の名前は？」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #32",
      "voiceDuration" : 1.5,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "9DDF0488-6F82-4333-A2F8-B1756EA817A2",
      "duration" : 3.5
    },
    {
      "title" : "シーン 33",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「魔理沙…霧雨魔理沙さんです。」",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "slideTitle" : "スライド #33",
      "voiceDuration" : 2.282154195011338,
      "audioTrack" : "track_voice_soumu",
      "id" : "0BFC0234-B660-4E66-8F2D-23312307B55C",
      "duration" : 3.5
    },
    {
      "title" : "シーン 34",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「いいわね、これはまだ、世に出てない代物なの。ここの大学院の薬を扱う学科で研究中の実験薬なの。あんた、分かってる？」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #34",
      "voiceDuration" : 8.090748299319728,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "D51F9C09-12BF-420E-AF7C-04F9BCD2CD9C",
      "duration" : 8.690748299319727
    },
    {
      "title" : "シーン 35",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「えっと…、何を言いたんですか…？」",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "slideTitle" : "スライド #35",
      "voiceDuration" : 2.0115192743764174,
      "audioTrack" : "track_voice_soumu",
      "id" : "CD0D7C01-F65C-476D-A22D-D89F90BA7BD5",
      "duration" : 3.5
    },
    {
      "title" : "シーン 36",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「これは、実験薬。服用した結果、どのような症状が出るかもわからない。そんなリスキーな薬をあんたは持ってたのよ。」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #36",
      "voiceDuration" : 6.992925170068027,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "B201CFCA-B24F-45A4-B941-F7F35E9ACF80",
      "duration" : 7.5929251700680265
    },
    {
      "title" : "シーン 37",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「後で、担任に連絡入れるから、とりあえず、私についてきなさい。大学院で研究中の様子を見て、しっかり学びなさい。」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #37",
      "voiceDuration" : 7.309659863945578,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "77D53DBD-9366-4094-913A-7D6C114C8162",
      "duration" : 7.909659863945578
    },
    {
      "title" : "シーン 38",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "彼女は矢継ぎ早にそう僕に言うと、歩き出す。\n僕は、慌ててその跡を、追いかけていくのだった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "slideTitle" : "スライド #38",
      "voiceDuration" : 6.67891156462585,
      "audioTrack" : "track_voice_soumu",
      "id" : "7E96A402-45CB-441F-A06F-D43630BBBA20",
      "duration" : 7.27891156462585
    },
    {
      "slideTitle" : "スライド #39",
      "id" : "3039881B-A0A2-462B-8B05-0630327D5153",
      "duration" : 3.5,
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "telop" : "彼が彼女についていくと…",
      "characterName" : "ナレーション",
      "title" : "シーン 39"
    },
    {
      "title" : "シーン 40",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕がそれから、彼女と共に、大学院のある研究室に来た。\nすると、誰かが、僕の元に駆け寄ってくる。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "slideTitle" : "スライド #40",
      "voiceDuration" : 7.982154195011338,
      "audioTrack" : "track_voice_soumu",
      "id" : "E3018B68-E31C-49E2-B64D-A4B5BC507108",
      "duration" : 8.582154195011338
    },
    {
      "title" : "シーン 41",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "animationName" : "なし",
      "telop" : "私は、急にやってきた博士に驚くと共に、細々と一緒にきた、男子に声をかける。「君、大丈夫？」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #41",
      "voiceDuration" : 6.274512471655329,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "id" : "7D1811B3-9172-4D08-8E4F-B383EADD9CB7",
      "duration" : 6.874512471655328
    },
    {
      "title" : "シーン 42",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「えっと…、あなたは…誰ですか…？」",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
      "slideTitle" : "スライド #42",
      "voiceDuration" : 2.2789115646258504,
      "audioTrack" : "track_voice_soumu",
      "id" : "7064BC8B-98D9-4828-9ABA-D2EB0D9E1D7B",
      "duration" : 3.5
    },
    {
      "title" : "シーン 43",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "animationName" : "なし",
      "telop" : "「私は、アリス・マーガトロイド。ここの大学院生。」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #43",
      "voiceDuration" : 3.0893197278911564,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "id" : "C2799C58-558F-4923-9923-93E3EB4FC97F",
      "duration" : 3.6893197278911565
    },
    {
      "title" : "シーン 44",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「そうですか…」僕は、そう呟くと、すこし足がふらつく。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav",
      "slideTitle" : "スライド #44",
      "voiceDuration" : 4.10172335600907,
      "audioTrack" : "track_voice_soumu",
      "id" : "47476585-1A7C-47CD-AE53-6DD9DAC91D9E",
      "duration" : 4.70172335600907
    },
    {
      "title" : "シーン 45",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "animationName" : "なし",
      "telop" : "私は、今にも倒れ込みそうな彼に、椅子を差し出す。\n「君、大丈夫なの？具合が悪いなら、帰ったほうがいいわよ。」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #45",
      "voiceDuration" : 6.706145124716553,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "id" : "6F8B2BC5-35C5-4001-A555-29AD46B69C2A",
      "duration" : 7.3061451247165525
    },
    {
      "title" : "シーン 46",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「彼を帰さないで、アリス。彼、さっきあなたたちが研究と開発途中の試験薬が入った瓶を、手に持ってみてたんだから。」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #46",
      "voiceDuration" : 6.9517233560090705,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "C1BA0524-1C33-495A-A9E3-15ED59DE60C5",
      "duration" : 7.55172335600907
    },
    {
      "title" : "シーン 47",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "animationName" : "なし",
      "telop" : "「そうですか、パチュリー博士…。」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #47",
      "voiceDuration" : 1.6573015873015873,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "id" : "7AABF965-E525-46A1-9099-DBA02518E203",
      "duration" : 3.5
    },
    {
      "title" : "シーン 48",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「それで、あんたは本当に、\nあの瓶を魔理沙っていう人からもらったのかしら？」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #48",
      "voiceDuration" : 3.973469387755102,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "2A2EF469-3A71-425E-A950-B269F097D82F",
      "duration" : 4.573469387755102
    },
    {
      "title" : "シーン 49",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "「ええ、そうです…。間違いではないです…」",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav",
      "slideTitle" : "スライド #49",
      "voiceDuration" : 2.8669387755102043,
      "audioTrack" : "track_voice_soumu",
      "id" : "BF8F7FC1-BE58-4A45-BE91-1E7A4BF643F0",
      "duration" : 3.5
    },
    {
      "title" : "シーン 50",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "animationName" : "なし",
      "telop" : "「そう。なら、アリス、あんたも手伝ってちょうだい。」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_パチュリー・ノーレッジ.wav",
      "slideTitle" : "スライド #50",
      "voiceDuration" : 2.999659863945578,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "id" : "FAAEBC40-4E55-42AC-AD04-EBE9077390E8",
      "duration" : 3.599659863945578
    },
    {
      "title" : "シーン 51",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "animationName" : "なし",
      "telop" : "「ええ、わかりました…。」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #51",
      "voiceDuration" : 1.5,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "id" : "3E7068AD-100C-49D4-9748-FB06737CA241",
      "duration" : 3.5
    },
    {
      "title" : "シーン 52",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "彼女たちは、それから、その瓶を持って奥に向かった。僕は、「ふぅ。」と一息つき、「今日は災難だな…」と呟く。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "slideTitle" : "スライド #52",
      "voiceDuration" : 8.485419501133787,
      "audioTrack" : "track_voice_soumu",
      "id" : "00F5E72B-23ED-487C-AF50-4D875A5799F5",
      "duration" : 9.085419501133787
    },
    {
      "title" : "シーン 53",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "でも、前の学校に比べれば、幾分かマシな気がするこの環境で、これからを過ごさないと…そう、僕は考えた。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
      "slideTitle" : "スライド #53",
      "voiceDuration" : 7.8756462585034015,
      "audioTrack" : "track_voice_soumu",
      "id" : "0EF443B0-C06F-4A14-9DFC-8DC7AD2DFB78",
      "duration" : 8.475646258503401
    },
    {
      "title" : "シーン 54",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は、そこでふと瓶の中身を考える…。今思い出せば、魔理沙さんが、あのように小瓶を渡すのは、昔からだった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "slideTitle" : "スライド #54",
      "voiceDuration" : 8.076734693877551,
      "audioTrack" : "track_voice_soumu",
      "id" : "72DEAA44-ABCC-4A83-A4CF-77417D535A65",
      "duration" : 8.67673469387755
    },
    {
      "title" : "シーン 55",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕が、ふと思い出したのは、僕が、小学校低学年くらいの時だった。そのとき、父が自転車を押しながら、その横を歩いていた。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc244107_コンビニ（夜）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav",
      "slideTitle" : "スライド #55",
      "voiceDuration" : 9.463673469387755,
      "audioTrack" : "track_voice_soumu",
      "id" : "6D7EE958-327A-477B-BDFF-E3DDD99081D3",
      "duration" : 10.063673469387755
    },
    {
      "title" : "シーン 56",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "そして、急に父がふらつき、ばたりと、自転車が倒れる。そして、父を見ると、父の体に傷がついていた。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc244107_コンビニ（夜）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav",
      "slideTitle" : "スライド #56",
      "voiceDuration" : 7.947369614512471,
      "audioTrack" : "track_voice_soumu",
      "id" : "9CFDE3B2-FD27-451C-81EC-7BA601038B94",
      "duration" : 8.547369614512471
    },
    {
      "title" : "シーン 57",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "そんな父を、僕は無理やり引っ張って起こそうとするが、小さな体では、少し持ち上げる程度になってしまう。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc244107_コンビニ（夜）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav",
      "slideTitle" : "スライド #57",
      "voiceDuration" : 6.9321541950113374,
      "audioTrack" : "track_voice_soumu",
      "id" : "873A8218-A108-4A5D-8B9F-01C2F82D8174",
      "duration" : 7.532154195011337
    },
    {
      "title" : "シーン 58",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "すると、ちょうど彼女がやってきて、おどいた様子でこちらに聞いてくる。何を聞いたかは忘れたが、彼女は、小瓶を取り出す。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc244107_コンビニ（夜）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "slideTitle" : "スライド #58",
      "voiceDuration" : 8.351723356009071,
      "audioTrack" : "track_voice_soumu",
      "id" : "37E77FF4-16DF-4700-9FDD-8061319626A2",
      "duration" : 8.95172335600907
    },
    {
      "title" : "シーン 59",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "そして、彼女は、そのまま、その小瓶の液体を父に飲ませると、彼女は、僕の目を覆い隠す。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc244107_コンビニ（夜）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav",
      "slideTitle" : "スライド #59",
      "voiceDuration" : 6.797369614512472,
      "audioTrack" : "track_voice_soumu",
      "id" : "9B9475AE-4309-42CA-BC61-535DE8DDC33F",
      "duration" : 7.397369614512471
    },
    {
      "title" : "シーン 60",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "彼女が、僕の目から手を離し、僕がみたときには、普通にそこに立って、困っていた父の姿がそこにあった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc244107_コンビニ（夜）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav",
      "slideTitle" : "スライド #60",
      "voiceDuration" : 7.606077097505669,
      "audioTrack" : "track_voice_soumu",
      "id" : "A3068BC0-70F0-477B-B9B2-E8C00763D986",
      "duration" : 8.20607709750567
    },
    {
      "title" : "シーン 61",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "それからは、ときどき魔理沙さんが、僕に小瓶を持ってくるようになり、僕に密かに渡してくるようになった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
      "slideTitle" : "スライド #61",
      "voiceDuration" : 6.8375963718820865,
      "audioTrack" : "track_voice_soumu",
      "id" : "79568C61-8721-4B60-85BE-C44A0B7C768E",
      "duration" : 7.437596371882086
    },
    {
      "title" : "シーン 62",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "僕は両親から小遣いを一切もらったことはなく、日常的な収入と言えるのは、魔理沙さんから渡された小瓶を飲んで、もらえる小銭だけだった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "slideTitle" : "スライド #62",
      "voiceDuration" : 9.324557823129252,
      "audioTrack" : "track_voice_soumu",
      "id" : "9F159492-7B03-49A9-817F-68F95816C36D",
      "duration" : 9.924557823129252
    },
    {
      "title" : "シーン 63",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "ふとそこまで考えた思い出し、ポケットを漁る、するとさっきの紙を見る。そこには飲めば、1000円札を一枚渡すとあった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav",
      "slideTitle" : "スライド #63",
      "voiceDuration" : 8.35063492063492,
      "audioTrack" : "track_voice_soumu",
      "id" : "08348D52-BF3B-4EF5-9214-74895C43BEF7",
      "duration" : 8.95063492063492
    },
    {
      "title" : "シーン 64",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "animationName" : "なし",
      "telop" : "そして、今回の収入源が消えたことに、ため息を吐く僕だった。",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "slideTitle" : "スライド #64",
      "voiceDuration" : 4.491950113378685,
      "audioTrack" : "track_voice_soumu",
      "id" : "A57E5FCA-DF3A-4076-805E-80288E4DF4A0",
      "duration" : 5.091950113378685
    },
    {
      "slideTitle" : "スライド #65",
      "id" : "8B037251-3415-4873-8404-C0CF87286868",
      "duration" : 15,
      "seName" : "SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～",
      "transitionName" : "なし",
