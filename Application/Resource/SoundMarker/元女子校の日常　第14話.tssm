      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 4.279705215419501,
      "seVolume" : 1,
      "duration" : 4.8797052154195,
      "title" : "シーン 15",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.016.jpeg",
      "telop" : "彼女はそういうと、去っていた。\n僕は、きょとんとしながら、ふと我に帰り、職員室に向かう。",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "1EB1EF68-1ADD-4FAA-B3F9-D09FC1F55E3C",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "操夢",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "voiceCharacter" : "操夢",
