      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "古明地さとり",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
