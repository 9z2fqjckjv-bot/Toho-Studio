      "id" : "F395BCE4-336C-4328-95E8-8762A8A8150F",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #26",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_十六夜咲夜.wav",
