      "telop" : "「ええ…、でも僕は、ある意味、慣れっこですよ…」",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "咲夜（微笑）.png",
      "id" : "071F14F0-F6DA-4304-8E26-93D5B56120E0",
