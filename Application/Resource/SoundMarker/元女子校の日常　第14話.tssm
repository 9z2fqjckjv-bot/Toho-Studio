      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 6.882698412698413,
      "seVolume" : 1,
      "duration" : 7.482698412698412,
      "title" : "シーン 7",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.008.jpeg",
      "telop" : "「女子は、噂に敏感で、何でもかんでもすぐに広まるので、気をつけないと、後々面倒ごとに巻き込まれちゃいますよ。」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
