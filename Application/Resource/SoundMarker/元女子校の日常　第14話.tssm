      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「ええ…、でも僕は、ある意味、慣れっこですよ…」",
      "duration" : 3.788684807256236,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 27",
      "voiceDuration" : 3.188684807256236,
      "characterName" : "操夢",
      "id" : "F660F24C-51BC-48E6-81FF-95BAAAF56CA4",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #27",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「そう言える理由は？」",
      "duration" : 2.5,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 28",
      "voiceDuration" : 1.5,
      "characterName" : "十六夜咲夜",
      "id" : "D51063A6-74B1-4176-A94A-F59DF27ACDC0",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #28",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「その内容話すと、少なくとも1時間は必要ですけど、\nそれでも聞きたいですか？」",
      "duration" : 6.14954648526077,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 29",
      "voiceDuration" : 5.5495464852607705,
      "characterName" : "操夢",
      "id" : "FEBEFF93-D804-42FE-BCC4-42AC32A8D980",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #29",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「ええ、あなたの心身にかかる事柄ですから、\nぜひ、聞かせてください。」",
      "duration" : 4.760680272108843,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 30",
      "voiceDuration" : 4.160680272108843,
      "characterName" : "十六夜咲夜",
      "id" : "4121D24B-B5ED-49E3-A73C-A0C177CD9122",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #30",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕は、彼女の意思を確認すると、過去を思い返しながら話す。",
      "duration" : 4.956077097505669,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 31",
      "voiceDuration" : 4.356077097505669,
      "characterName" : "操夢",
      "id" : "07134730-F320-4FE9-89A6-D9CBECF12E01",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #31",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「それで、あなたはこの学校に転校して、良かったですか？」",
      "duration" : 3.9903854875283447,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 32",
      "voiceDuration" : 3.3903854875283446,
      "characterName" : "十六夜咲夜",
      "id" : "19E45386-94F4-4852-9276-083572C8BDC3",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #32",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「ええ、前の学校と比べると、かなり良いです。母に、母の母校に転校したいと言って、良かったと僕は思っています。」",
      "duration" : 9.035419501133786,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 33",
      "voiceDuration" : 8.435419501133786,
      "characterName" : "操夢",
      "id" : "829474F6-4E47-4B62-82E9-5D1F1A931AFB",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #33",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「そうですか…、ところで話の節々から、あなたの記憶には、欠けているところがありますが、何か心当たりはありますか？」",
      "duration" : 7.437482993197278,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 34",
      "voiceDuration" : 6.837482993197279,
      "characterName" : "十六夜咲夜",
      "id" : "9604A81D-A628-4FCF-8A76-56687D45F947",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #34",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「…正直に言って分からないです。小さかった頃は、それこそ些細な違いで、記憶が欠け始めたのは、中学からですから…」",
      "duration" : 9.010430839002268,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 35",
      "voiceDuration" : 8.410430839002268,
      "characterName" : "操夢",
      "id" : "0E614D2A-1E90-4E51-B27F-5650D5AE4BE3",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #35",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「…ただ、証拠を出せというのなら、僕のこの身体が、それを示してます…、正直にいうと人様には見せたくないですが…」",
      "duration" : 8.562607709750568,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 36",
      "voiceDuration" : 7.962607709750567,
      "characterName" : "操夢",
      "id" : "11EC5FA8-233E-4463-8E98-8FFBCCFB7F28",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #36",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「そうですか…。ところで、あなたは、この間の模試を受けている時の様子と、午後の1500m走の様子を見たいですか？」",
      "duration" : 7.684580498866213,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 37",
      "voiceDuration" : 7.084580498866213,
      "characterName" : "十六夜咲夜",
      "id" : "CEB49288-8403-42C2-97D2-D15C866E68B4",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #37",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「えっ？」僕は、彼女の急な質問に、そう返してしまう。",
      "duration" : 5.021292517006803,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 38",
      "voiceDuration" : 4.421292517006803,
      "characterName" : "操夢",
      "id" : "CDE78ADE-2316-4E17-8F59-9AAE2033B893",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #38",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「もし、見たいのなら、教員用のPCにデータが保存されているので、お見せできますが…、どうしますか？」",
      "duration" : 6.484897959183673,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 39",
      "voiceDuration" : 5.884897959183673,
      "characterName" : "十六夜咲夜",
      "id" : "C0822A67-9F70-49BE-8D02-523ED1622686",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #39",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「えっと…」僕はふと迷う。確かに、こないだの気を失っている間に、自分が何をしてかを見たいが、見たくない気持ちもある。",
      "duration" : 9.161519274376417,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 40",
      "voiceDuration" : 8.561519274376417,
      "characterName" : "操夢",
      "id" : "5E390A04-B0F5-4F09-B76B-B8B24448A09F",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #40",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「いや、いいです…」僕は、それから彼女にそう返す。",
      "duration" : 4.30390022675737,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 41",
      "voiceDuration" : 3.7039002267573697,
      "characterName" : "操夢",
      "id" : "916A850E-F681-4E58-A7A8-D62B64EE89BE",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #41",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「そうですか…、最後に一つだけ、こないだ渡した例の遠足に関する条件ですが、無事に満たしましたよ、では失礼。」",
      "duration" : 7.439591836734693,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 42",
      "voiceDuration" : 6.8395918367346935,
      "characterName" : "十六夜咲夜",
      "id" : "2B56268F-9488-44AA-B430-CCB3CDB77C79",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #42",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "彼女はそういうと、部屋をさっていった。僕は、ゆっくりと立ちあがろうとすると、突如として頭痛が走り、床に崩れ落ちる。",
      "duration" : 9.061519274376417,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 43",
      "voiceDuration" : 8.461519274376418,
      "characterName" : "操夢",
