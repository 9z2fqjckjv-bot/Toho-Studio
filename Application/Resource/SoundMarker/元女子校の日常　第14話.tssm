    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.029.jpeg",
      "telop" : "「その内容話すと、少なくとも1時間は必要ですけど、\nそれでも聞きたいですか？」",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "咲夜（微笑）.png",
      "id" : "9D814AE2-4A5C-48B3-AA21-0A8E2CD347D7",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "操夢",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
