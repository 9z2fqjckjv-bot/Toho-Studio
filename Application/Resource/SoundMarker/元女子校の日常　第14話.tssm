      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #29",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 5.5495464852607705,
      "seVolume" : 1,
      "duration" : 6.14954648526077,
      "title" : "シーン 29",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png"
    },
    {
      "transitionName" : "なし",
