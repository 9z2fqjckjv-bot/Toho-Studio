    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "そして、僕の様子を見に戻ってきた彼女を、\n一瞬見ると、そのまま気を失うのだった。",
      "duration" : 5.6492970521541945,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 44",
      "voiceDuration" : 5.049297052154195,
      "characterName" : "十六夜咲夜",
      "id" : "36AF7F3F-F1D6-4738-A167-724C30528649",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #44",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_十六夜咲夜.wav",
      "backgroundName" : "咲夜（驚く）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "彼がふと気がつくと…",
      "duration" : 2.5,
      "animationName" : "なし",
      "animationDuration" : 1.5,
      "seStartTimeOffset" : 0,
      "title" : "シーン 45",
      "characterName" : "ナレーション",
      "id" : "93C9952F-859E-4FD0-91F8-9E5859972EA9",
      "slideTitle" : "スライド #45",
      "animationNote" : "表示時間：1.5秒",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕はふと気がつくと、そこはトイレだった。\nそして、手を洗ってから、トイレを出る。",
      "duration" : 6.411519274376417,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 46",
      "voiceDuration" : 5.811519274376417,
      "characterName" : "操夢",
      "id" : "1E3C7EBD-224D-47A2-AC84-1AC53A5C6C33",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #46",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "そして、学校の廊下を歩いているときに、ふと午後は、全校集会だったことを思い出す。そして、僕は体育館に向かう。",
      "duration" : 9.058253968253968,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 47",
      "voiceDuration" : 8.458253968253969,
      "characterName" : "操夢",
      "id" : "69E42B48-97B5-4953-927E-D1F05F50791B",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #47",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕が体育館に来ると、すでにほとんどの生徒や児童が集まっているようだった。僕は、ふと周りを見渡し、ある列に入る。",
      "duration" : 8.957165532879818,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 48",
      "voiceDuration" : 8.357165532879819,
      "characterName" : "操夢",
      "id" : "E2624AE5-ABE9-49D1-8FD5-30EAB61B719F",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #48",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "それから、数時間の間、遠足の説明を聞くのだった。",
      "duration" : 4.565850340136055,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 49",
      "voiceDuration" : 3.9658503401360545,
      "characterName" : "操夢",
      "id" : "F6856284-3D89-49C5-803B-89ECCAA021ED",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #49",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "説明会が終わり…",
      "duration" : 2.5,
      "animationName" : "なし",
      "animationDuration" : 1.5,
      "seStartTimeOffset" : 0,
      "title" : "シーン 50",
      "characterName" : "ナレーション",
      "id" : "80EA3371-3565-4B8C-A6A2-54FA84A04022",
      "slideTitle" : "スライド #50",
      "animationNote" : "表示時間：1.5秒",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "説明会が終わると、各自が教室に戻り、担任が入ってくる。",
      "duration" : 5.10390022675737,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 51",
      "voiceDuration" : 4.50390022675737,
      "characterName" : "操夢",
      "id" : "72F0F116-2CB6-4371-9AAB-497B38CA7C5D",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #51",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕は、朝と同じように礼と挨拶をして、数分程度の短い週例を終えると、そのまま、学校の校門に向かう。",
      "duration" : 8.366938775510205,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 52",
      "voiceDuration" : 7.766938775510204,
      "characterName" : "操夢",
      "id" : "5304C85B-EC17-46CC-893D-4813344E5FD0",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #52",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕が、学校の校門に来ると、ある車が門の前に止まっていた。\nすると、中からフランが降りてくる。",
      "duration" : 7.732154195011337,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 53",
      "voiceDuration" : 7.132154195011338,
      "characterName" : "操夢",
      "id" : "76392529-6478-4BB0-9ACC-320B353F3371",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #53",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「学校、お疲れ様、紅夢。とりあえず、車に乗って。」",
      "duration" : 5.7982312925170065,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 54",
      "voiceDuration" : 5.198231292517007,
      "characterName" : "フランドール・スカーレット",
      "id" : "314EC1D7-E99B-4A6C-9DC3-51E7946E5CDD",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideTitle" : "スライド #54",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕は、彼女にそう言われ、車に乗ると、数十分で高速に入る。\n「あの、フランさん、どこに行くのですか？」",
      "duration" : 8.386507936507936,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 55",
      "voiceDuration" : 7.786507936507936,
      "characterName" : "フランドール・スカーレット",
      "id" : "07B843AA-8CD6-46B4-972C-3E759914E32A",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #55",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「それは、向こうに着くまで秘密。」",
      "duration" : 3.2419954648526077,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 56",
      "voiceDuration" : 2.6419954648526076,
      "characterName" : "フランドール・スカーレット",
      "id" : "120D4801-256B-41B0-8361-6EEEA4A13249",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideTitle" : "スライド #56",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_フランドール・スカーレット.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕は彼女にそう返され、前に向き直る。それから、僕はフランの隣の助手席で、ただぼーっと車窓を眺めるのだった。",
      "duration" : 8.915850340136053,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 57",
      "voiceDuration" : 8.315850340136054,
      "characterName" : "フランドール・スカーレット",
      "id" : "FFC3F47A-C7A9-4184-8667-65EA0670B51D",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #57",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "seVolume" : 0.2505859375,
      "bgmVolume" : 0.7,
      "telop" : "ご視聴ありがとうございました！",
