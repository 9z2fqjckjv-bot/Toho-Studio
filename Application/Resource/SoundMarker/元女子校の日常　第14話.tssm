    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「ちなみに、その間の記憶は、まったくありませんか？」",
      "duration" : 3.7115873015873015,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 26",
      "voiceDuration" : 3.1115873015873015,
