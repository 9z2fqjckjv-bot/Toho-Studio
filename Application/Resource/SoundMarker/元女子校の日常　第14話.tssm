      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #2",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 2.564761904761905,
      "seVolume" : 1,
      "duration" : 3.164761904761905,
      "title" : "シーン 2",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "transitionName" : "なし",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "telop" : "「紅夢さん、あなた学内で、有名人になってますよ。」",
      "id" : "C43800C0-4954-44D7-AE81-49F9789282D8",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "古明地さとり",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "slideTitle" : "スライド #3",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 3.0151927437641723,
      "seVolume" : 1,
      "duration" : 3.6151927437641724,
      "title" : "シーン 3: 「紅夢さん、あなた学内で、有名人になってますよ。」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.003.jpeg"
    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.004.jpeg",
      "telop" : "「えっ…」僕はそう呟き、なぜ自分が有名人になったかを考える。そして、彼女に聞く。「なぜですか…？」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "CD008CA1-7447-4052-846E-48464B78F1D1",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "操夢",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #4",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.756077097505669,
      "seVolume" : 1,
      "duration" : 8.356077097505668,
      "title" : "シーン 4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.005.jpeg",
      "telop" : "「本来なら大学受験に使われるような高難度の問題が入り混じった模試で満点を取り、文武両道な転校生が学内にいると…」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "2B8A8B00-5EA8-495A-870D-84A3DFDADBEA",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "古明地さとり",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "slideTitle" : "スライド #5",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 6.750884353741497,
      "seVolume" : 1,
      "duration" : 7.350884353741496,
      "title" : "シーン 5",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.006.jpeg",
      "telop" : "「教員側も驚愕しているっていう噂と共に、生徒の間でも話題になってますよ。それこそ遠足と学校行事よりも…」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "DF28C944-3F4C-4E32-B4B1-71873C9A7A96",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "古明地さとり",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "slideTitle" : "スライド #6",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 6.397596371882086,
      "seVolume" : 1,
      "duration" : 6.997596371882086,
      "title" : "シーン 6",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.007.jpeg",
      "telop" : "「私が聞いた限りだと、あなたは1500mを数分で走り切った後に受けた模試で100点が出た、転校生だと言われてますよ。」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
