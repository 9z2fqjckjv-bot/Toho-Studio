      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "すると、さとりがこちらに駆け寄ってくる。\n作成者：zuyasi",
      "duration" : 3.164761904761905,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 2",
      "voiceDuration" : 2.564761904761905,
      "characterName" : "操夢",
      "id" : "93572452-0FC7-42F0-BA38-46A316F3EA1A",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #2",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%81%95%26%E3%82%8A",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「紅夢さん、あなた学内で、有名人になってますよ。」",
      "duration" : 4.368979591836735,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 3: 「紅夢さん、あなた学内で、有名人になってますよ。」",
      "voiceDuration" : 3.7689795918367346,
      "characterName" : "さ&り",
      "id" : "BE90ACA4-7CFE-43E5-A1D8-4E6FDB793ABE",
      "voiceCharacter" : "さ&り",
      "slideTitle" : "スライド #3",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_さ&り.wav",
      "backgroundName" : "単色背景",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「えっ…」僕はそう呟き、なぜ自分が有名人になったかを考える。そして、彼女に聞く。「なぜですか…？」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "duration" : 8.356077097505668,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 4",
      "voiceDuration" : 7.756077097505669,
      "characterName" : "操夢",
      "id" : "31FBB2AC-7F86-4201-998D-CF2CF1CC3616",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #4",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%81%95%26%E3%82%8A",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「本来なら大学受験に使われるような高難度の問題が入り混じった模試で満点を取り、文武両道な転校生が学内にいると…」",
      "duration" : 9.017369614512472,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 5",
      "voiceDuration" : 8.417369614512472,
      "characterName" : "さ&り",
      "id" : "F16DB9F4-1D9D-4F51-87A1-32F6B466E722",
      "voiceCharacter" : "さ&り",
      "slideTitle" : "スライド #5",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_さ&り.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%81%95%26%E3%82%8A",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「教員側も驚愕しているっていう噂と共に、生徒の間でも話題になってますよ。それこそ遠足と学校行事よりも…」",
      "duration" : 8.596984126984127,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 6",
      "voiceDuration" : 7.996984126984127,
      "characterName" : "さ&り",
      "id" : "3110E6FD-8F56-4091-8792-CCCC96F5DDA5",
      "voiceCharacter" : "さ&り",
      "slideTitle" : "スライド #6",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_さ&り.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%81%95%26%E3%82%8A",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「私が聞いた限りだと、あなたは1500mを数分で走り切った後に受けた模試で100点が出た、転校生だと言われてますよ。」",
      "duration" : 9.203356009070294,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 7",
      "voiceDuration" : 8.603356009070295,
      "characterName" : "さ&り",
      "id" : "206C6BC7-29EF-4E1C-8B6E-AE7298A07D63",
      "voiceCharacter" : "さ&り",
      "slideTitle" : "スライド #7",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_さ&り.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E3%81%95%26%E3%82%8A",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「女子は、噂に敏感で、何でもかんでもすぐに広まるので、気をつけないと、後々面倒ごとに巻き込まれちゃいますよ。」",
      "duration" : 8.448979591836736,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 8",
      "voiceDuration" : 7.848979591836735,
      "characterName" : "さ&り",
      "id" : "68AE541D-F1A9-48FF-BF73-7AC9B8C7E731",
      "voiceCharacter" : "さ&り",
      "slideTitle" : "スライド #8",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_さ&り.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「えっと…」\n僕は、彼女から聞いたその内容に困惑するのだった。",
      "duration" : 5.066938775510204,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 9",
      "voiceDuration" : 4.466938775510204,
      "characterName" : "操夢",
      "id" : "775BF0E0-AC89-4066-B32D-53070D24C6A7",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #9",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "元女子校の日常",
      "duration" : 2.5,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 10: 東方Project二次創作作品　Powerd By zuyasi",
      "characterName" : "操夢",
      "id" : "9AEA6358-66A3-4788-A531-DE12A9D20621",
      "slideTitle" : "スライド #10",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "それから、さとりは自席に戻り、しばらくすると、教室の扉がチャイムと同時に開く。そして、担任が入ってくる。",
      "duration" : 8.85390022675737,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 11",
      "voiceDuration" : 8.25390022675737,
      "characterName" : "操夢",
      "id" : "EE60F346-8BCE-4625-A224-714E8D929BCF",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #11",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕はいつものように、素早く立ち上がり、クラスメイトと同じタイミングで礼と挨拶をすると、彼女の合図で座る。",
      "duration" : 7.921292517006802,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 12",
      "voiceDuration" : 7.321292517006802,
      "characterName" : "操夢",
      "id" : "2C3F96CB-55C3-457C-B2DD-59719441417D",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #12",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「それでは、朝礼を始めます。今日は、テスト返却の後は、遠足に向けた、全校集会なので昼食後速やかに移動するように。」",
      "duration" : 9.60156462585034,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 13",
      "voiceDuration" : 9.00156462585034,
      "characterName" : "東風谷早苗",
      "id" : "44340CC3-30C0-41A7-BC81-3AB7BF097508",
      "voiceCharacter" : "東風谷早苗",
      "slideTitle" : "スライド #13",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_東風谷早苗.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「それと藤原さんは、今学園内で流れている情報の真意を確かめるので、朝礼後、速やかに職員室を訪ねるように。」",
      "duration" : 8.385351473922903,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 14",
      "voiceDuration" : 7.785351473922902,
      "characterName" : "東風谷早苗",
      "id" : "912F93FF-5E36-4817-87BD-A23E2FA5939A",
      "voiceCharacter" : "東風谷早苗",
      "slideTitle" : "スライド #14",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_東風谷早苗.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「今日の連絡は以上です。今日も1日、勉学を励みましょう。」",
      "duration" : 4.900090702947845,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 15",
      "voiceDuration" : 4.300090702947846,
      "characterName" : "東風谷早苗",
      "id" : "04E09265-B7A5-4585-9B3B-772431F47F23",
      "voiceCharacter" : "東風谷早苗",
      "slideTitle" : "スライド #15",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_東風谷早苗.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "彼女はそういうと、去っていた。\n僕は、きょとんとしながら、ふと我に帰り、職員室に向かう。",
      "duration" : 7.2995464852607705,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 16",
      "voiceDuration" : 6.699546485260771,
      "characterName" : "操夢",
      "id" : "E5C30ECF-AE1C-4DE1-80E8-989CD631E378",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #16",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "そして、僕が職員室に来ると、ある女性がやってくる。",
      "duration" : 4.3756462585034015,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 17",
      "voiceDuration" : 3.7756462585034014,
      "characterName" : "操夢",
      "id" : "04B269C7-ADE3-4FC2-AC3B-5B146A239CB2",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #17",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「藤原さん、早速ですが、別室に移動して、あなたの話を聞かせてもらうので、私の後についてきてください。」",
      "duration" : 7.327891156462584,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 18",
      "voiceDuration" : 6.727891156462585,
      "characterName" : "十六夜咲夜",
      "id" : "E81415FD-C22C-4DCF-A0B4-FF5C37A30C02",
      "voiceCharacter" : "十六夜咲夜",
      "slideTitle" : "スライド #18",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_十六夜咲夜.wav",
      "backgroundName" : "咲夜（微笑）.png",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_soumu",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "僕がそう言われ、やってきたのは被服室だった。",
      "duration" : 3.6267346938775513,
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "title" : "シーン 19",
      "voiceDuration" : 3.0267346938775512,
      "characterName" : "操夢",
      "id" : "B0EF8ABB-88FE-4557-B52C-4CB8A75FFB92",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #19",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0
    },
    {
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "telop" : "「それで、こないだの体力テスト、どうでしたか？」",
