      "duration" : 9.344489795918367,
      "seVolume" : 1,
      "title" : "シーン 46",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.046.jpeg",
      "telop" : "「さて、あんたの初めてを誰が取るかの抽選に、受かったことだし、早速始めましょうよ…」私はそう彼に言う。",
