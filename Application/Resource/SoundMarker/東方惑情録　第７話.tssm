      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.043.jpeg",
