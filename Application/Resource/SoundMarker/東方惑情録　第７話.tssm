      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.041.jpeg",
      "voiceCharacter" : "博麗霊夢",
      "voiceStartTimeOffset" : 0,
      "telop" : "「どんな言い分言ったって無駄よ、皆に迷惑をかけたのは、\nあんただっていうことは変わらないからね。」",
      "seVolume" : 1,
      "slideTitle" : "スライド #41",
      "id" : "00610E32-B168-4DFA-900A-98BDAB50AEF6",
      "duration" : 7.509478458049887,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_博麗霊夢.wav",
      "characterName" : "博麗霊夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 41",
      "voiceDuration" : 6.909478458049887,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_reimu",
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.042.jpeg",
      "voiceCharacter" : "博麗霊夢",
      "voiceStartTimeOffset" : 0,
      "telop" : "「とにかく、あんたと霖之助と、にとりには罰を与えるわよ、さぁ、あの3人に、罰を与えましょうか。」",
      "seVolume" : 1,
      "slideTitle" : "スライド #42",
      "id" : "48FD4AAF-07EF-4C6A-BE23-37E7C7F363AA",
      "duration" : 8.766984126984127,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_博麗霊夢.wav",
      "characterName" : "博麗霊夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 42",
