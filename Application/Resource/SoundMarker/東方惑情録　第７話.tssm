      "voiceStartTimeOffset" : 0,
      "characterName" : "にとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.017.jpeg",
      "slideTitle" : "スライド #17",
      "title" : "シーン 17",
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_017_にとり.wav",
      "voiceCharacter" : "にとり",
      "duration" : 8.24201814058957,
      "animationName" : "なし",
      "voiceDuration" : 7.6420181405895695,
      "backgroundName" : "nc467347_和室【フリー素材あそび】.jpg",
      "seStartTimeOffset" : 0,
      "telop" : "「その機械を動かすには、大きな電力がないと動かせず、発電所から直に電気を供給する必要があったんだ。」",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg"
    },
    {
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_博麗霊夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg",
      "transitionName" : "なし",
      "voiceDuration" : 8.316984126984128,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 18",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc467347_和室【フリー素材あそび】.jpg",
      "telop" : "「まさか、その機械を動かしたら、あんな空気が出たなんて言わないわよね？」私は、そう彼女を問い詰める。",
      "seVolume" : 1,
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #18",
      "animationName" : "なし",
      "id" : "8179A025-4DBC-49E0-95E3-129EBC079D79",
      "duration" : 8.916984126984127,
      "audioTrack" : "track_voice_reimu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.018.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png"
    },
    {
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_019_にとり.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg",
      "transitionName" : "なし",
      "voiceDuration" : 8.153446712018141,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 19",
      "voiceCharacter" : "にとり",
      "backgroundName" : "nc467347_和室【フリー素材あそび】.jpg",
      "telop" : "「そうさ、その機械を発電所の設備に直付けで起動したら、なんでかわかんないけど、轟音立てながら、煙が出たんだ。」",
      "seVolume" : 1,
      "characterName" : "にとり",
      "slideTitle" : "スライド #19",
      "animationName" : "なし",
      "id" : "7C639C01-624D-491A-A12D-79265D8AECA1",
      "duration" : 8.75344671201814,
      "audioTrack" : "track_voice_%E3%81%AB%E3%81%A8%E3%82%8A",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.019.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png"
    },
    {
      "seStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_博麗霊夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg",
      "transitionName" : "なし",
      "voiceDuration" : 5.821995464852607,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 20",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc467347_和室【フリー素材あそび】.jpg",
      "telop" : "「それで、もし仮にその機械に原因があるなら、\nその機械は処分したのよね？」",
