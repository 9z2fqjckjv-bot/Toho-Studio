      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 44",
      "voiceDuration" : 8.694126984126983,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.045.jpeg",
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "telop" : "そして僕は、その後、霊夢と共に博麗神社に住むことになり、時折、紅魔館や地霊殿と行ったり来たりしながらすごすのだった。",
      "seVolume" : 1,
      "slideTitle" : "スライド #45",
      "id" : "FFAD5CFA-7540-40BD-8C1C-3261D484D66A",
      "duration" : 9.568027210884354,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav",
