      "voiceDuration" : 2.612108843537415,
      "bgmStartTimeOffset" : 0,
      "telop" : "「そうですか…」私は、仕方なく納得する。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #59",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.060.jpeg",
