      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.923469387755102,
      "bgmStartTimeOffset" : 0,
      "telop" : "そして、頭をそっと優しく撫でていると、彼女は気持ちよさそうに、そのまま寝落ちした。すると、あくびが出てくる。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #28",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.029.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.14845804988662,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
