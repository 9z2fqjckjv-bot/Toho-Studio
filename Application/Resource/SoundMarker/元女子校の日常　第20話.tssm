      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.599546485260771,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕はふと目が覚めると、部屋の時計を確認する。時計には、午後4時と表示されていた。「昼寝しすぎたな…」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #31",
