      "duration" : 7.145215419501134,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 19",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "51FD3D98-6930-415D-9A1B-7EE5950CD20F",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.145215419501134,
      "bgmStartTimeOffset" : 0,
      "telop" : "「分かりました。それじゃあ、買ってきますね。」\n僕はそう言うと、一度おろしたバックを背負い、部屋を出た。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #19",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.020.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 1.5,
      "voice2StartTimeOffset" : 0,
      "transitionName" : "なし",
      "characterName" : "ナレーション",
      "bgmVolume" : 0.7,
      "title" : "シーン 20",
      "animationName" : "なし",
      "id" : "41FB3846-B948-4876-992B-64E2A9B8CF8D",
      "seVolume" : 1,
      "animationNote" : "表示時間：1.5秒",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "bgmStartTimeOffset" : 0,
      "telop" : "彼が買い出しから戻ると…",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #20",
      "seStartTimeOffset" : 0,
      "animationDuration" : 1.5
    },
    {
