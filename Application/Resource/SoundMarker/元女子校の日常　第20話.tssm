      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_古明地こいし.wav",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
