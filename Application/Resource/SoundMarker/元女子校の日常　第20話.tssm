      "title" : "シーン 42",
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png",
      "animationName" : "なし",
      "id" : "01BA117E-5681-42C3-A53A-1E7333D23A6C",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.695215419501134,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、彼女が発したその言葉にさとりとともに驚く。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #42",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.043.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.185986394557823,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_古明地さとり.wav",
      "transitionName" : "なし",
      "characterName" : "古明地さとり",
      "voiceCharacter" : "古明地さとり",
      "title" : "シーン 43",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "BDD36C92-C40B-4A96-B91A-2F76072D266C",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceDuration" : 8.185986394557823,
      "bgmStartTimeOffset" : 0,
      "telop" : "私は、彼女が私よりも、彼を選んだことに、複雑な感情が湧き上がる。悔しい、嫉妬、欲望…私は感情の波に飲まれそうだった。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #43",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.044.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.0613832199546485,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_古明地さとり.wav",
      "transitionName" : "なし",
      "characterName" : "古明地さとり",
      "voiceCharacter" : "古明地さとり",
      "title" : "シーン 44",
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（不満）.png",
      "animationName" : "なし",
      "id" : "233E747F-27EE-4AFF-A735-E077B19F4BA7",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceDuration" : 3.0613832199546485,
      "bgmStartTimeOffset" : 0,
      "telop" : "「とりあえず、一旦外に出て、国際通りを歩きましょ。」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #44",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.045.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.1778231292517005,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 45",
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（不満）.png",
      "animationName" : "なし",
      "id" : "AF325D95-B796-4F24-8AEE-442C45564711",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.1778231292517005,
      "bgmStartTimeOffset" : 0,
      "telop" : "「そうですね…、ついでに夜のお店も探しますか…。」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #45",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.046.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 5.8939909297052155,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_古明地さとり.wav",
      "transitionName" : "なし",
      "characterName" : "古明地さとり",
      "voiceCharacter" : "古明地さとり",
      "title" : "シーン 46",
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png",
      "animationName" : "なし",
      "id" : "221DF7C5-8531-4834-8193-CF45E704B977",
