      "voiceDuration" : 4.78469387755102,
      "bgmStartTimeOffset" : 0,
      "telop" : "「それじゃあ、出かけますか…」\n私は、二人の反応に呆れ、そのまま外に出るのだった。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #49",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.050.jpeg",
