      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 6.993038548752835,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 21",
      "bgmVolume" : 0.7,
      "seName" : "SE: 自主規制ピー音",
      "animationName" : "なし",
      "id" : "7FF22B82-8DE1-4A04-8B9C-630F6AFC0894",
      "seVolume" : 2,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 6.993038548752835,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、買い出しから戻ると、バックから〇〇〇〇チュそばを取り出し、給湯ポットから、お湯を入れて、蓋をする。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #21",
      "seStartTimeOffset" : 2.31
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.022.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.434331065759638,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 22",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "8DC0812F-AE63-4CF2-8D7A-23A99986C187",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.434331065759638,
      "bgmStartTimeOffset" : 0,
      "telop" : "そして、数分程度待ち、容器の上に、箸を乗せて、そっともち、彼女に、手渡す。「熱いので気をつけてください。」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #22",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.023.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.915192743764172,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_古明地こいし.wav",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "title" : "シーン 23",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "3489FA85-333B-4B39-9C3C-14C98A290A35",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "voiceDuration" : 4.915192743764172,
      "bgmStartTimeOffset" : 0,
      "telop" : "「ありがとう…、じゃあ、いただきます…。」\n私は、そう言って、冷ましながらそれを食べる。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #23",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.024.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.395215419501134,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 24",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "1E002A44-F661-4A8C-97EF-EB087A68F49D",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.395215419501134,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、彼女が食べ始めたのを見ると、バックから油みそが入ったポーク玉子おむすびと天ぷらを取り出して、食べる。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #24",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.025.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.147369614512471,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 25",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "1313DB38-B33B-4A08-8091-3F520D5A7627",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.147369614512471,
      "bgmStartTimeOffset" : 0,
      "telop" : "そして、昼食を済ますと、彼女に沖縄そばの感想を聞く。\n「どうでしたか、初めての沖縄そばは…？」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #25",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.026.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 6.849160997732426,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_古明地こいし.wav",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "title" : "シーン 26",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "EF3B6073-60C6-42C4-A02D-166AC489C0FE",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "voiceDuration" : 6.849160997732426,
      "bgmStartTimeOffset" : 0,
      "telop" : "「美味しかった…」私は、お腹が満たされると、眠たくなる。\nそして、私は無意識のうちに彼の服を手で引っ張る…。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #26",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.027.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.656077097505669,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 27",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "CD9C184F-BF68-4BB2-B9A1-C0FF02B1553E",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.656077097505669,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、僕の服を引っ張る彼女を見て、彼女をベッドに横たわらせると、自分自身も同じベッドの隣で横になる。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #27",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.028.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.923469387755102,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 28",
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/気持ちの良い寝顔.png",
