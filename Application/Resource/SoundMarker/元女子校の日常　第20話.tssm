      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.128458049886621,
      "bgmStartTimeOffset" : 0,
      "telop" : "彼女はそう言って、あるメニューを指差す。それは、アグー豚100%のハンバークにご飯とドリンクバーがついたセットだった。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #65",
