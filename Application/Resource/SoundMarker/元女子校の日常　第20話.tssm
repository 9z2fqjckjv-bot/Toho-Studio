      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceDuration" : 5.8939909297052155,
      "bgmStartTimeOffset" : 0,
      "telop" : "「夜のお店？どういう意味ですか、それ？」\n私は、彼の発言に対して、そう思わずつぶやいてしまう。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #46",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.047.jpeg",
