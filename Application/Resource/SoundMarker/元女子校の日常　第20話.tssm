      "voiceDuration" : 3.114036281179138,
      "bgmStartTimeOffset" : 0,
      "telop" : "「私は…、今日はそんなに長居せず、ホテルに戻りたいわ。」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #53",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.054.jpeg",
