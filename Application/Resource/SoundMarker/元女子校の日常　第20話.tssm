      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.4865079365079366,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕たちがそう話していると、ある交差点を通りかける。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #60",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.061.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.531065759637188,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 61",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "C0FD44AD-53D6-4B3A-9354-66F346C7022D",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.531065759637188,
      "bgmStartTimeOffset" : 0,
      "telop" : "そして、コンビニの上にあるお店に僕たちは入って行った。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #61",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.062.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.976734693877551,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 62",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "39119DAF-A216-4535-80E5-1E7F664FE613",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.976734693877551,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕たちが、そのお店に入っていくと、そこはファミレスだった。",
