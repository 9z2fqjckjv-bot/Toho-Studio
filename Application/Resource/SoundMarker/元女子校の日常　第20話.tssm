      "voiceDuration" : 3.474512471655329,
      "bgmStartTimeOffset" : 0,
      "telop" : "「夜ご飯食べるお店じゃないの？」\n私は、そう彼に聞く。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #47",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.048.jpeg",
