      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.2212925170068027,
      "bgmStartTimeOffset" : 0,
      "telop" : "「ええ、そうですよ。それじゃあ、行きますか？」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #48",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.049.jpeg",
