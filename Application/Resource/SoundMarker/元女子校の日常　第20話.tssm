      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 6.60172335600907,
      "bgmStartTimeOffset" : 0,
      "telop" : "「分かりました…」ちょっと湯船の方見てきますね。\n僕はそう言うと、もう一度、浴室に入る。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #6",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.007.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.965850340136054,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
