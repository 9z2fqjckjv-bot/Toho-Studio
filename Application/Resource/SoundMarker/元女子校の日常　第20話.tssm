      "slideTitle" : "スライド #62",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.063.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 6.788684807256236,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 63",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "EB267738-DFD7-4765-8678-83769C344FB7",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 6.788684807256236,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、席に着くとメニューをテーブルに広げる。\nすると、一目散に、こいしがある料理に目をつける。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #63",
