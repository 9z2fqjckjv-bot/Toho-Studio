      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "B146DA1E-90F9-4230-9348-A35FE45470C7",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 4.234331065759637,
      "bgmStartTimeOffset" : 0,
      "telop" : "するとさとりとアリスの頬が頬照る。\n「二人とも、どうしました？」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #67",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.068.jpeg",
