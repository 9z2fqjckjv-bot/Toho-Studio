      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 4.697369614512471,
      "bgmStartTimeOffset" : 0,
      "telop" : "「そうですか…、それなら、\n僕が勝手に買ってきても、大丈夫ですか…？」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #17",
      "seStartTimeOffset" : 0
    },
    {
