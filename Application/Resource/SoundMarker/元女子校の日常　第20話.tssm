      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.14845804988662,
      "bgmStartTimeOffset" : 0,
      "telop" : "そして、彼女の頭を優しくトントンと手を当てながら、そのまま瞼が重たくなって行き、彼女のそばでそのまま眠るのだった。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #29",
      "seStartTimeOffset" : 0
    },
    {
