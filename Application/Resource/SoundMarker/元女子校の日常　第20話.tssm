      "title" : "シーン 51",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "1B8EDBBD-8059-40F9-B90E-84D372C759D8",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.766938775510203,
      "bgmStartTimeOffset" : 0,
      "telop" : "それから僕たちは、国際通りを散策していると、夕日が差し込む時間帯になっていた。僕は、3人にどんなお店がいいか聞く。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #51",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.052.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.7039002267573697,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 52",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "54ED93E4-2AA7-4CB1-835F-8129FBB3EFF0",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.7039002267573697,
      "bgmStartTimeOffset" : 0,
      "telop" : "「アリスさんは、この通り沿いなら、どのお店がいいですか？」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #52",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.053.jpeg",
