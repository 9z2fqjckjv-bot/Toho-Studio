      "voiceDuration" : 1.067392290249433,
      "bgmStartTimeOffset" : 0,
      "telop" : "「それで、いいよ…」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #18",
      "seStartTimeOffset" : 0
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.019.jpeg",
