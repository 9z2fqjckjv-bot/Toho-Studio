      "duration" : 3.8712925170068027,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "title" : "シーン 66",
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "id" : "BF21B874-C980-4C12-A400-899228614F34",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.8712925170068027,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、彼女のその反応に思わず、フッと笑いが漏れる。",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #66",
      "seStartTimeOffset" : 0
    },
    {
