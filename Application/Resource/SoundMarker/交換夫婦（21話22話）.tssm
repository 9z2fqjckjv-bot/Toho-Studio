04693,0.85082394,0.7275604,1,0.9765472,1,0.6877685,0.9727386,0.87189025,0.70823973,0.83178097,0.701297,0.9186645,0.96452636,0.6219909,0.5858886,1,0.69748837,0.71196896,1,0.9997955],"playbackRate":1,"isLooping":false,"trackId":"track_voice__B740","id":"48BD50E2-EDC2-4063-969D-7165516C32AE","character":"操夢","colorHex":"#1ABC9C","voiceType":"中性","name":"[操夢] 僕は、二人の表情から何が起きたのかを分析すると、ある予測と傾向が浮かび上がる。それは、警告でもあった。","type":"Voice","fadeOutDuration":0},{"pitch":115,"pan":-0.2,"speed":100,"startTime":1030.5614965986395,"duration":7.821995464852607,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_164_操夢.wav","isReversed":false,"voiceSymbol":"ダ'ガ、ボ'クワ、ナ'ニモ\/イワズ'ニ、レミリアオ\/ダ_キカカエ'ルト、ジ_シツノ\/ベ'ッドニ\/ハコビ、フ'ランモ\/ハコビコ'ンダ。","volume":1,"fadeInDuration":0,"sceneIndex":164,"text":"だが、僕は、何も言わずに、レミリアを抱き抱えると、自室のベッドに運び、フランも運び込んだ。","waveformPoints":[0.9778564,0.9179901,0.78790283,1,0.47583616,0.6275848,0.9759918,0.48730162,0.66567075,1,0.7712799,0.96393126,0.94004816,0.77282715,0.5118591,0.75894165,0.7452545,0.8310272,0.57156676,0.44354245,0.79722595,0.8342804,0.6916565,0.8988281],"playbackRate":1,"isLooping":false,"trackId":"track_voice__B740","id":"A2769B3D-068F-4382-9FC1-5091830C87FD","character":"操夢","colorHex":"#1ABC9C","voiceType":"中性","name":"[操夢] だが、僕は、何も言わずに、レミリアを抱き抱えると、自室のベッドに運び、フランも運び込んだ。","type":"Voice","fadeOutDuration":0},{"pitch":115,"pan":-0.2,"speed":100,"startTime":1038.9834920634921,"duration":5.004489795918367,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_165_操夢.wav","isReversed":false,"voiceSymbol":"、+ジャ'ー、ハジメマ'スネ。ボ'クワ\/ソ'ー\/イウト、レミリアオ\/モチアゲル。","volume":1,"fadeInDuration":0,"sceneIndex":165,"text":"「じゃあ、始めますね。」僕はそういうと、レミリアを持ち上げる。","waveformPoints":[0.12,0.8518951,0.8751037,0.12,0.9362396,0.5531189,0.5251098,0.45076293,0.5021393,0.12,0.12,0.82095027,1,0.58664244,0.49995726,0.8587188,0.8933136,0.7325592,0.55664974,1,1,0.9319549,0.60179746,0.632782],"playbackRate":1,"isLooping":fa