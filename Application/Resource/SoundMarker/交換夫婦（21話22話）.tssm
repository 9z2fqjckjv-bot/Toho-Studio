      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.021.jpeg"
    },
    {
      "telop" : "僕は、二人の表情から何が起きたのかを分析すると、ある予測と傾向が浮かび上がる。それは、警告でもあった。\n※察しのいい人にはPCが見えます。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.957165532879818,
      "audioTrack" : "track_voice__66B3",
      "title" : "シーン 22",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #22",
      "id" : "9B6CF7BD-0620-408B-9DF8-938CFD880A46",
