      "duration" : 7.393038548752834,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.023.jpeg"
    },
    {
      "telop" : "「じゃあ、始めますね。」\n僕はそういうと、レミリアを持ち上げる。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/寝室の窓際のベッド｜みんちりえ\/寝室の窓際のベッド（日中・青）.jpg",
