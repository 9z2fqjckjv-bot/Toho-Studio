    },
    {
      "telop" : "「私も…お願い…操夢…」\n※察しのいい人にはPCが見えます。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_フランドール・スカーレット.wav",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 2.536984126984127,
      "audioTrack" : "track_voice__6B67",
      "title" : "シーン 21",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideTitle" : "スライド #21",
      "id" : "78B24547-49AF-4BF1-BCE9-33615636E8BE",
