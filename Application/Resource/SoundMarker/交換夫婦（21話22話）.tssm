      "characterName" : "操夢"
    },
    {
      "telop" : "彼女たちはそう言うと、フランが僕の洋服を勝手に脱がし、\nそのままレミリアは下着姿になり、僕の棒を加える。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.007.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "animationName" : "バウンス",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/一人部屋３｜みんちりえ\/一人部屋３（日中）.jpg",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/slide_007_anim.m4v",
      "voiceDuration" : 7.4452154195011335,
      "audioTrack" : "track_voice__66B3",
      "animationNote" : "アニメーション:12.35秒",
      "transitionName" : "クロスディゾルブ",
      "title" : "シーン 7",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #7",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3",
      "seName" : "[SE] 飲む.mp3",
      "id" : "66477108-C8C6-44D0-9F5E-658835D51CE8",
      "animationDuration" : 12.35,
      "duration" : 12.35,
      "backgroundName" : "一人部屋３（日中）.jpg",
      "characterName" : "操夢"
    },
    {
      "telop" : "だが僕は、彼女が何度も当ててくる器の弱点を把握し、\nそこに焦点を当てて突つく。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.008.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "animationName" : "バウンス",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/一人部屋３｜みんちりえ\/一人部屋３（日中）.jpg",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/slide_008_anim.m4v",
      "voiceDuration" : 5.843038548752834,
      "audioTrack" : "track_voice__66B3",
      "animationNote" : "アニメーション:10秒",
      "transitionName" : "クロスディゾルブ",
      "title" : "シーン 8",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #8",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3",
      "seName" : "[SE] 飲む.mp3",
      "id" : "A723AE6F-ECDE-4D0B-998B-217A4480D1B6",
      "animationDuration" : 10,
      "duration" : 10,
      "backgroundName" : "一人部屋３（日中）.jpg",
      "characterName" : "操夢"
    },
    {
      "telop" : "「まぁ、いいわ。とりあえず、続けるわよ。」\n私はそう言って、先ほどよりも早く動く。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.009.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_レミリア・スカーレット.wav",
      "animationName" : "バウンス",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/一人部屋３｜みんちりえ\/一人部屋３（日中）.jpg",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/slide_009_anim.m4v",
      "voiceDuration" : 6.17281179138322,
      "audioTrack" : "track_voice__D8BB",
      "animationNote" : "アニメーション:10秒",
      "transitionName" : "クロスディゾルブ",
      "title" : "シーン 9",
      "voiceCharacter" : "レミリア・スカーレット",
      "slideTitle" : "スライド #9",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3",
      "seName" : "[SE] 飲む.mp3",
      "id" : "59E9C0B1-372D-48CE-A955-F3314181BAF4",
      "animationDuration" : 10,
      "duration" : 10,
      "backgroundName" : "一人部屋３（日中）.jpg",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "telop" : "「じゃあ、始めるね。」\n私はそう言うと彼の棒を器で咥えて、動き出す。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.010.jpeg",
