C9E","character":"博麗霊夢","colorHex":"#E74C3C","voiceType":"女声1 (標準)","name":"[博麗霊夢] 「操夢のポケベルは？」","type":"Voice","fadeOutDuration":0},{"pitch":100,"pan":0.2,"speed":100,"startTime":62.854376417233574,"duration":3.540748299319728,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_霧雨魔理沙.wav","isReversed":false,"voiceSymbol":"、\/ソームノ\/ポケベルワ、オ_キテ'ガミト\/イッショニ\/ア'ッタ。","volume":1,"fadeInDuration":0,"sceneIndex":13,"text":"「操夢のポケベルは、置き手紙と一緒にあった。」","waveformPoints":[0.12,0.12,0.65400696,0.6192138,0.61742854,0.86661375,0.8013122,0.79996336,0.7804443,1,0.7952423,0.12,0.750769,0.5351074,0.9701995,0.84566647,0.7968292,0.71165156,0.34658203,0.7246643,1,0.98666376,0.8989074,0.9741272],"playbackRate":1,"isLooping":false,"trackId":"track_voice_marisa","id":"D3002327-516A-4ED5-9077-3245A2E152AF","character":"霧雨魔理沙","colorHex":"#F1C40F","voiceType":"女声2 (高め)","name":"[霧雨魔理沙] 「操夢のポケベルは、置き手紙と一緒にあった。」","type":"Voice","fadeOutDuration":0},{"pitch":100,"pan":-0.2,"speed":100,"startTime":66.9951247165533,"duration":3.7844897959183674,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav","isReversed":false,"voiceSymbol":"、\/ワカ'ッタワ。ソ'ラカラ\/カ'レオ\/イッショニ\/サガシマショ'。","volume":1,"fadeInDuration":0,"sceneIndex":14,"text":"「分かったわ。空から彼を一緒に探しましょ。」","waveformPoints":[0.12,1,1,1,1,1,0.941159,0.12,0.12,0.18392333,0.78758544,0.9425079,0.96639097,0.91453856,1,0.641391,0.7863159,0.7485077,1,0.98229975,0.7202209,0.70308226,0.74834895,0.86411434],"playbackRate":1,"isLooping":false,"trackId":"track_voice_reimu","id":"364903C6-0DD4-4880-A38C-BEA6CF58A01C","character":"博麗霊夢","colorHex":"#E74C3C","voiceType":"女声1 (標準)","name":"[博麗霊夢] 「分かったわ。空から彼を一緒に探しましょ。」","type":"Voice","fadeOutDuration":0},{"pitch":100,"pan":0.2,"speed":100,"startTime":71.37961451247168,"duration":4.741995464852608,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_霧雨魔理沙.wav","isReversed":fa