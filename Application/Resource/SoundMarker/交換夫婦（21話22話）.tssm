,0.7932983,0.8864502,0.6464691,0.60858154,1,1,0.6846344,0.59906006,1,1,0.94282526,0.82955927,0.9957885,0.7343048,0.669519,0.83721614,0.7535461,0.7856018],"playbackRate":1,"isLooping":false,"trackId":"track_voice__433F","id":"81D729C7-E90A-4EDF-96C0-EFA0CCF84BC9","character":"レミリア・スカーレット","colorHex":"#E67E22","voiceType":"女声2 (高め)","name":"[レミリア・スカーレット] 「あんた、、なんでこんなすぐに私の敏感なところを突けるのかしら？」","type":"Voice","fadeOutDuration":0},{"pitch":115,"pan":-0.2,"speed":100,"startTime":770.6831746031748,"duration":6.159478458049887,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_126_操夢.wav","isReversed":false,"voiceSymbol":"、\/ソレワ、アナ'タノ\/カラダガ\/サ_シシメ'_シテマスヨ。ボ'クワ\/カ'ノジョノ\/_シテキニ\/ソ'ー\/カ'エ_ス。","volume":1,"fadeInDuration":0,"sceneIndex":126,"text":"「それは、あなたの体が指し示してますよ。」僕は彼女の指摘にそう返す。","waveformPoints":[0.12,0.6377807,1,0.90485835,0.8525299,1,1,0.85522765,1,0.5735107,0.6389709,0.46187133,0.6083832,0.44243163,0.12,0.825592,0.9430633,0.7797302,0.5938629,0.5921173,0.5372894,0.60973203,0.9229492,0.16718139],"playbackRate":1,"isLooping":false,"trackId":"track_voice__B740","id":"1410772E-E7AD-45E7-B31F-98DA6B333B7E","character":"操夢","colorHex":"#1ABC9C","voiceType":"中性","name":"[操夢] 「それは、あなたの体が指し示してますよ。」僕は彼女の指摘にそう返す。","type":"Voice","fadeOutDuration":0},{"pitch":150,"pan":0.2,"speed":80,"startTime":777.4426530612247,"duration":8.897619047619047,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_127_レミリア・スカーレット.wav","isReversed":false,"voiceSymbol":"、\/エ'ッ？ワタシワ\/ソ'ー\/ツブヤキナ'ガラ、_シタオ+ミ'ル。ワタシワ\/ソレオ\/ミ'ルト、オドロ'イテ+シマウ。","volume":1,"fadeInDuration":0,"sceneIndex":127,"text":"「えっ？」私はそう呟きながら、下を見る。私はそれを見ると、驚いてしまう。","waveformPoints":[0.605249,0.67955625,0.12,1,1,1,0.7662811,0.9704376,0.8908935,0.8377716,0.52023005,1,0.77703243,0.43350524,0.78215027,1,1,1,0.6622192,0.95056146,0.9133087,1,0.70859677,0.47341612],"playbackRate":1,"isLooping":false,"trackId":"track_voice__433F","id":"8B6096BE-0AD2-487C-9E0E-4924AC480728","character":"レミリア・スカーレット","colorHex":"#E67E22","voiceType":"女声2 (高め)","name":"[レミリア・スカーレット] 「えっ？」私はそう呟きながら、下を見る。私はそれを見ると、驚いてしまう。","type":"Voice","fadeOutDuration":0},{"pitch":150,"pan":0.2,"speed":80,"startTime":786.9402721088438,"duration":9.265487528344671,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_128_レミリア・スカーレット.wav","isReversed":false,"voiceSymbol":"、+マ'ー、イ'イワ。トリア'エズ、ツズケル'ワヨ。ワタシワ\/ソ'ー\/イッテ、サ_キホド'ヨリモ\/ハヤ'ク\/ウゴ'_ク。","volume":1,"fadeInDuration":0,"sceneIndex":128,"text":"「まぁ、いいわ。とりあえず、続けるわよ。」私はそう言って、先ほどよりも早く動く。","waveformPoints":[0.36360168,0.48345336,0.49182433,1,0.2776306,0.90485835,0.9247345,0.49912414,0.36582336,0.82055354,1,0.6793579,0.12,1,1,0.82713926,0.63694763,0.64218444,0.88791806,1,0.7437866,0.9947967,0.84380186,0.5392334],"playbackRate":1,"isLooping":false,"trackId":"track_voice__433F","id":"3D8C4F2F-3B2B-456D-ADE9-EAAF5DCFE532","character":"レミリア・スカーレット","colorHex":"#E67E22","voiceType":"女声2 (高め)","name":"[レミリア・スカーレット] 「まぁ、いいわ。とりあえず、続けるわよ。」私はそう言って、先ほどよりも早く動く。","type":"Voice","fadeOutDuration":0},{"pitch":150,"pan":0.2,"speed":80,"startTime":796.8057596371885,"duration":10.000748299319728,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_129_レミリア・スカーレット.wav","isReversed":false,"voiceSymbol":"ダ'ガ、ワタシノ\/ウツワワ、サ'ラニ\/ハンノーオ\/シメ'_ス。ダ'ガ、ドージニ\/ナ'ント+ナ'_ク、ココチヨ'イ\/カンショクガ+スル。","volume":1,"fadeInDuration":0,"sceneIndex":129,"text":"だが、私の器は、さらに反応を示す。だが、同時になんとなく、心地よい感触がする。","waveformPoints":[1,0.9569091,1,0.6542053,1,1,1,1,0.97646785,0.60945433,0.13318175,0.12,1,0.95897216,0.9667877,0.6722168,0.8806579,0.50578916,0.7118103,0.91192013,0.81849056,0.84193724,0.9066833,0.8117462],"playbackRate":1,"isLooping":false,"trackId":"track_voice__433F","id":"490DA54A-DD97-4DBA-B6FD-BE58BFAF1F6C","character":"レミリア・スカーレット","colorHex":"#E67E22","voiceType":"女声2 (高め)","name":"[レミリア・スカーレット] だが、私の器は、さらに反応を示す。だが、同時になんとなく、心地よい感触がする。","type":"Voice","fadeOutDuration":0},{"pitch":100,"pan":-0.2,"speed":115,"startTime":807.4065079365083,"duration":4.688730158730158,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_130_フランドール・スカーレット.wav","isReversed":false,"voiceSymbol":"、\/オアネサマ、ワタシニ'モ\/カ'レオ\/タ_シカメサセ'テ、ワタシワ、ソ'ー\/ツブヤ'_ク。","volume":1,"fadeInDuration":0,"sceneIndex":130,"text":"、「お姉様、私にも彼を確かめさせて、」私は、そう呟く。","waveformPoints":[0.12,1,0.8028595,0.78825986,0.49729916,0.957782,0.8028595,0.68665767,0.6581726,0.9591705,0.8608215,0.7598938,1,0.7043121,0.65091246,0.12,1,0.54689026,1,0.12,0.5912048,0.64067686,0.7598938,0.24113159],"playbackRate":1,"isLooping":false,"trackId":"track_voice__CD1E","id":"411475A7-FEA0-4D87-942A-D2840C95006E","character":"フランドール・スカーレット","colorHex":"#E74C3C","voiceType":"ロボット","name":"[フランドール・スカーレット] 、「お姉様、私にも彼を確かめさせて、」私は、そう呟く。","type":"Voice","fadeOutDuration":0},{"pitch":150,"pan":0.2,"speed":80,"startTime":812.6952380952384,"duration":8.350748299319728,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_131_レミリア・スカーレット.wav","isReversed":false,"voiceSymbol":"、\/ワカ'ッタワ、ソレジャ、カ'レオ\/セメオトシナサ'イ。ワタシワ\/ソ'ー\/イウト、ベ'ッドカラ\/オ'リタ。","volume":1,"fadeInDuration":0,"sceneIndex":131,"text":"「分かったわ、、それじゃ、彼を攻め落としなさい、。」私はそう言うと、ベッドから降りた。","waveformPoints":[0.49686277,1,1,1,0.72898865,0.86415404,0.8900207,0.9883697,0.92005306,0.89010006,0.906842,0.95028377,0.74370724,0.12,1,1,1,0.7816345,0.9532196,0.27671814,0.883197,0.9505218,1,1],"playbackRate":1,"isLooping":false,"trackId":"track_voice__433F","id":"3256DEF7-42DF-491C-8358-B49FF6579E8C","character":"レミリア・スカーレット","colorHex":"#E67E22","voiceType":"女声2 (高め)","name":"[レミリア・スカーレット] 「分かったわ、、それじゃ、彼を攻め落としなさい、。」私はそう言うと、ベッドから降りた。","type":"Voice","fadeOutDuration":0},{"pitch":100,"pan":-0.2,"speed":115,"startTime":821.6459863945581,"duration":4.98124716553288,"audioFilePath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_132_フランドール・スカーレット.wav","isReversed":false,"voiceSymbol":"、+ジャ'ー、ハジ