    },
    {
      "telop" : "「ねぇ、操夢…、もう一回私を…いい気持ちにして…」\n※察しのいい人にはPCが見えます。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_レミリア・スカーレット.wav",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 3.556734693877551,
      "audioTrack" : "track_voice__D8BB",
      "title" : "シーン 20",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "レミリア・スカーレット",
      "slideTitle" : "スライド #20",
