      "characterName" : "操夢"
    },
    {
      "telop" : "僕はふと気がつくと、レミリアとフランの二人が部屋に入ってきた。だが、なんとなく二人の様子に違和感を覚える。\n※察しのいい人にはPCが見えます。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg",
