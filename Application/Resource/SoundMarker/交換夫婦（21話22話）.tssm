      "characterName" : "操夢"
    },
    {
      "telop" : "そして、彼女の器のある部分を突くようにする。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.012.jpeg",
