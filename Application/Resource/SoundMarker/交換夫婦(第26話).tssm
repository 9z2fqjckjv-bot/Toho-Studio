      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.047.jpeg",
      "title" : "シーン 47",
      "duration" : 9.043038548752834,
      "animationName" : "なし",
      "telop" : "「僕は、政党を作ることはしません。だから内閣が崩壊しても、それは実質的なことで他者から見たら、変わりません。」",
      "slideTitle" : "スライド #47",
      "characterName" : "操夢",
      "backgroundName" : "咲夜ごくり.png",
      "voiceDuration" : 8.443038548752835
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav",
      "id" : "792F2ED8-E988-4174-8EF4-772B2EC4E502",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.048.jpeg",
      "title" : "シーン 48",
      "duration" : 7.832154195011338,
      "animationName" : "なし",
      "telop" : "「ですが、僕はこの国のシステムを直接操作、変更することで政党不要な新たな仕組みを築き上げます…」",
      "slideTitle" : "スライド #48",
      "characterName" : "操夢",
      "backgroundName" : "咲夜ごくり.png",
      "voiceDuration" : 7.232154195011338
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav",
      "id" : "90FAF742-6D9E-4817-B7E9-23784A212190",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.049.jpeg",
      "title" : "シーン 49",
      "duration" : 8.064761904761905,
      "animationName" : "なし",
      "telop" : "「おそらく、僕の同胞がいるので、その人たちで丸ごとシステムを操ることで、実権を直接握り締めます…」",
      "slideTitle" : "スライド #49",
      "characterName" : "操夢",
      "backgroundName" : "咲夜ごくり.png",
      "voiceDuration" : 7.464761904761905
    },
    {
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_050_操夢.wav",
