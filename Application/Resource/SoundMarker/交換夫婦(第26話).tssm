      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.032.jpeg",
      "title" : "シーン 32",
      "duration" : 5.575646258503401,
      "animationName" : "なし",
      "telop" : "すると、霊夢のポケットから音が鳴る。\n僕は、霊夢に目で合図を送る。",
      "slideTitle" : "スライド #32",
      "characterName" : "操夢",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 4.975646258503401
    },
