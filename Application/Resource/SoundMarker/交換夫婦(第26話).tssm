      "duration" : 3.667414965986395,
      "animationName" : "バウンス",
      "telop" : "私がそういうと、彼女は戸を開け、入ってくる。",
      "slideTitle" : "スライド #26",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
