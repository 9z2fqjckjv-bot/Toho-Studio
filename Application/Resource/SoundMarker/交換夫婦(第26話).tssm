      "title" : "シーン 85",
      "duration" : 7.43984126984127,
      "animationName" : "なし",
      "telop" : "橙はそう言うと、Faxで印刷された用紙を渡す。\nその用紙には、彼が提示したある内容が記されていた。",
      "slideTitle" : "スライド #85",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.83984126984127
    },
    {
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "id" : "F174752D-4019-4021-AA88-136E79303D68",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_八雲紫.wav",
