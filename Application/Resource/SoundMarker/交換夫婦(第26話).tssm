      "id" : "2C78786A-D0A0-4C6D-8009-055BB95E516C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_にとり.wav",
      "voiceCharacter" : "にとり",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.024.jpeg",
      "title" : "シーン 24",
      "duration" : 4.572131519274376,
      "animationName" : "なし",
      "telop" : "「にとりです。今、中に入っても大丈夫でしょうか？」",
      "slideTitle" : "スライド #24",
      "characterName" : "にとり",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
