      "title" : "シーン 20",
      "duration" : 7.072585034013605,
      "animationName" : "なし",
      "telop" : "私は、彼の依頼を聞き、「わかりました」と返すと、その場を離れ、みとりと共にその部屋に向かっていった。",
      "slideTitle" : "スライド #20",
      "characterName" : "射命丸文",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 6.472585034013606
    },
    {
      "audioTrack" : "track_voice_soumu",
      "id" : "8563D45E-5918-44ED-AD5F-F05930C33EC4",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
