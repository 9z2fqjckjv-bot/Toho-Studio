      "title" : "シーン 31",
      "duration" : 7.675646258503401,
      "animationName" : "なし",
      "telop" : "僕たちが、その画面…東京の某所カメラ映像を見ていると、\nそのカメラに映っている人物が電話をかける。",
      "slideTitle" : "スライド #31",
      "characterName" : "操夢",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 7.075646258503402
    },
