      "title" : "シーン 28",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "「どこから不正アクセスされてるの？」",
      "slideTitle" : "スライド #28",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
