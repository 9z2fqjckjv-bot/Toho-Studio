      "title" : "シーン 83",
      "duration" : 4.798412698412698,
      "animationName" : "なし",
      "telop" : "私たちがそんな話をしていると、\n誰かが部屋の戸を叩き入ってくる。",
      "slideTitle" : "スライド #83",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 4.198412698412699
    },
    {
      "audioTrack" : "track_voice_%E6%A9%99",
      "id" : "F3C9F3D6-3BD5-4B01-969E-7BE85E56FAE1",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_橙.wav",
