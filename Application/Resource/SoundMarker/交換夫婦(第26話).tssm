      "title" : "シーン 50",
      "duration" : 8.219115646258503,
      "animationName" : "なし",
      "telop" : "「ですので、紫さんたちを魔理沙さんたちから見たときは、これまで通りの状態なので、気にする必要なないですよ…」",
      "slideTitle" : "スライド #50",
      "characterName" : "操夢",
      "backgroundName" : "咲夜ごくり.png",
      "voiceDuration" : 7.523469387755102
