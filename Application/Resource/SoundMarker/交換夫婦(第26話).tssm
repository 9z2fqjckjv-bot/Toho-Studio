      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.043.jpeg",
      "title" : "シーン 43",
      "duration" : 3.8984126984126983,
      "animationName" : "なし",
      "telop" : "「もしかして、そこまであなたは考えて実行したの？」",
      "slideTitle" : "スライド #43",
      "characterName" : "レミリア・スカーレット",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 3.2984126984126982
    },
    {
