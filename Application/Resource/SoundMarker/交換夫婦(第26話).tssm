      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.021.jpeg",
      "title" : "シーン 21",
      "duration" : 5.525646258503401,
      "animationName" : "なし",
      "telop" : "僕は、二人がいなくなると、\n操作盤の前に立ち、ある画面を表示する。",
      "slideTitle" : "スライド #21",
      "characterName" : "操夢",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 4.925646258503401
    },
    {
