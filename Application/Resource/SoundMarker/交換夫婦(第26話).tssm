      "title" : "シーン 54",
      "duration" : 7.197369614512471,
      "animationName" : "なし",
      "telop" : "「霊夢さんは過去の馬券の購入歴について、\n聞きたいことがありますから、僕とこの部屋に残りますよ。」",
      "slideTitle" : "スライド #54",
      "characterName" : "操夢",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 6.597369614512472
