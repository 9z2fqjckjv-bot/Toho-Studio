      "title" : "シーン 77",
      "duration" : 5.03798185941043,
      "animationName" : "なし",
      "telop" : "すると、再び戸がノックされる。私は「どうぞ。」と返す。",
      "slideTitle" : "スライド #77",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
