      "title" : "シーン 30",
      "duration" : 8.871746031746031,
      "animationName" : "なし",
      "telop" : "私は、そこで唾を飲む。すると、彼女はヒソヒソとその内容を語った。それを聞いた私は、ある人物に電話をかけた。",
      "slideTitle" : "スライド #30",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 8.271746031746032
    },
    {
      "audioTrack" : "track_voice_soumu",
      "id" : "24A36665-AE1B-46D2-BB70-4B438C192C21",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
