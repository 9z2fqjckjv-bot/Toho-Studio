      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.044.jpeg",
      "title" : "シーン 44",
      "duration" : 8.98,
      "animationName" : "なし",
      "telop" : "「いえ、ここまで完璧に推測ができれば、もっと素早い行動ができる様になりますよ。いずれは…そうなるかも知れませんが…」",
      "slideTitle" : "スライド #44",
      "characterName" : "操夢",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 8.38
    },
    {
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "id" : "AFE113B6-34C6-4ECE-A90B-24242CEEC1FE",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
