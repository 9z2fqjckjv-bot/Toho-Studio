      "title" : "シーン 19",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "そして僕は、文に記事の作成を依頼する。",
      "slideTitle" : "スライド #19",
      "characterName" : "操夢",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 2.821292517006803
    },
    {
