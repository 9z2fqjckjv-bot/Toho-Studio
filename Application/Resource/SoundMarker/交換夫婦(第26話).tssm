      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.086.jpeg",
      "title" : "シーン 86",
      "duration" : 6.9957596371882085,
      "animationName" : "なし",
      "telop" : "「蘭、橙、覚悟はできているかしら…。」\n私は、そう二人、そして自らにも、問いかけた。",
      "slideTitle" : "スライド #86",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
