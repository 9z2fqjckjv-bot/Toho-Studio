      "title" : "シーン 84",
      "duration" : 4.047165532879818,
      "animationName" : "なし",
      "telop" : "「紫しゃま、さっき、沖縄からこんな文書が届いて…」",
      "slideTitle" : "スライド #84",
      "characterName" : "橙",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
