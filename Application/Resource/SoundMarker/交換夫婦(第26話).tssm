      "title" : "シーン 53",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "「えっと…私は…」",
      "slideTitle" : "スライド #53",
      "characterName" : "博麗霊夢",
      "backgroundName" : "咲夜困り顔.png",
