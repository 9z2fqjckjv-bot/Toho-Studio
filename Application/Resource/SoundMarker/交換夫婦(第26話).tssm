      "title" : "シーン 57",
      "duration" : 7.490861678004535,
      "animationName" : "なし",
      "telop" : "「さて、あなたがこれまで購入した馬券の内容と金額、購入日時について１から教えてもらいますか…」",
      "slideTitle" : "スライド #57",
      "characterName" : "操夢",
