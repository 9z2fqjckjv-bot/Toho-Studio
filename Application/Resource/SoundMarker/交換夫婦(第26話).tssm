      "duration" : 6.016938775510204,
      "sceneIndex" : 88,
      "colorHex" : "#3498DB",
      "voiceSymbol" : "ボ'クワ、アヤ'ト\/レ'ームガ\/ス'ヤスヤ\/ネテイル\/ヨコデ、コノ+クニ、イ'ヤ\/ヨ'ノ\/_シクミオ\/イチ'カラ\/_ツクリカ'エテ+イタ。",
      "fadeInDuration" : 0,
      "volume" : 1,
      "character" : "操夢",
