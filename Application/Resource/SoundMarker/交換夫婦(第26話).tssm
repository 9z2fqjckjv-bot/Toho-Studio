      "title" : "シーン 9",
      "duration" : 8.47891156462585,
      "animationName" : "なし",
      "telop" : "「僕も、驚いてますよ…きっと、みとりさんからの電話が来なければ、あの研究所内で全員追っ手に捕まってました。」",
      "slideTitle" : "スライド #9",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.8789115646258505
