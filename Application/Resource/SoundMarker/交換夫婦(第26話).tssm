      "title" : "シーン 51",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "「そう…」",
      "slideTitle" : "スライド #51",
      "characterName" : "レミリア・スカーレット",
      "backgroundName" : "咲夜困り顔.png",
