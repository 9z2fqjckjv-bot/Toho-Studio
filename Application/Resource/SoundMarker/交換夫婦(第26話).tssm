      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.045.jpeg",
      "title" : "シーン 45",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "「じゃあ、紫たちは、このままだと…」",
      "slideTitle" : "スライド #45",
      "characterName" : "レミリア・スカーレット",
      "backgroundName" : "咲夜困り顔.png",
      "voiceDuration" : 2.5046485260770974
    },
    {
