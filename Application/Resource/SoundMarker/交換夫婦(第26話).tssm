    },
    {
      "audioTrack" : "track_voice_%E8%98%AD",
      "id" : "F72F3B01-E9C1-4EE9-A05A-68641C18D8F0",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_蘭.wav",
      "voiceCharacter" : "蘭",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
