      "title" : "シーン 25",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "「ええ、どうぞ。」",
      "slideTitle" : "スライド #25",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
