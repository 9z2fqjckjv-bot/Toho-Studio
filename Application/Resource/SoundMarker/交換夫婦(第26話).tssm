      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_八雲紫.wav",
      "startTime" : 476.6832426303854,
      "voiceType" : "女声2 (高め)",
      "isCutOffOnSceneEnd" : true,
      "playbackRate" : 1,
      "speed" : 96,
      "name" : "[八雲紫] 「ええ、そうなるわね。きっと私たちの見てない隙に、買収されたのよ…、巨漢党の置き土産である彼にね…」",
      "duration" : 6.982380952380953,
      "sceneIndex" : 81,
      "colorHex" : "#00CEC9",
      "voiceSymbol" : "、+エー、ソ'ー\/ナ'ルワネ。キット\/ワタ_シタ'チノ\/ミ'テ\/ナ'イ\/_スキニ、バイシューサレタ'ノヨ、キョカントーノ\/オキミ'ヤゲデ+ア'ル\/カ'レニネ、",
      "fadeInDuration" : 0,
      "volume" : 1,
      "character" : "八雲紫",
      "pitch" : 127
    },
