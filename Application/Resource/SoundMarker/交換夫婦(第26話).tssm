      "title" : "シーン 76",
      "duration" : 8.967414965986395,
      "animationName" : "なし",
      "telop" : "私が、霊夢に電話をかけ、この問題は…異変だと言い、解決するように指示を出したが、一向に不正アクセスは実行され続ける。",
      "slideTitle" : "スライド #76",
      "characterName" : "八雲紫",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 8.367414965986395
    },
    {
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "id" : "BFB842DB-2863-4792-B595-8B0AF143138E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_八雲紫.wav",
      "voiceCharacter" : "八雲紫",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
