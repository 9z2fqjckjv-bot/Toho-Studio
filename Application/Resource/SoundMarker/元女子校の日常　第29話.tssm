      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png",
      "id" : "E6BA2D51-B1FC-4EA7-8744-A3C7C9C06172",
      "title" : "シーン 36",
      "transitionName" : "なし",
      "telop" : "私は彼が帰ると、ある彼のデータを眺めていた。実は、さっき見せた脳波のデータはダミーで、本当は違うデータを取っていた。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.39546485260771,
      "duration" : 8.39546485260771,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_永琳.wav"
    },
    {
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "characterName" : "永琳",
      "backgroundName" : "nc166698_病院の診察室.png",
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #37",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.037.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png",
      "voice2StartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png",
      "id" : "16CA330B-1740-4357-8DA9-38A47C725BFB",
      "title" : "シーン 37",
      "transitionName" : "なし",
      "telop" : "「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.445850340136055,
      "duration" : 8.445850340136055,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_永琳.wav"
    },
    {
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "characterName" : "永琳",
      "backgroundName" : "nc166698_病院の診察室.png",
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #38",
