      "title" : "シーン 35",
      "transitionName" : "なし",
      "telop" : "「分かりました…」僕はそういうと、病室に戻っていった。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 3.824557823129252,
      "duration" : 3.824557823129252,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav"
    },
    {
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "characterName" : "永琳",
      "backgroundName" : "nc166698_病院の診察室.png",
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #36",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.036.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png",
