      "title" : "シーン 29",
      "transitionName" : "なし",
      "telop" : "「そう…」私は、そう言いながら、彼にあるものを見せる。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 3.739795918367347,
      "duration" : 3.739795918367347,
