      "id" : "0573E7A3-1410-4D33-9600-0552FB4732F8",
      "title" : "シーン 1",
      "transitionName" : "なし",
      "telop" : "僕は、ふと気がつくと、そこは暗闇が広がる空間だった。\nすると、遠くで誰かが戦っている音が聞こえる。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.665850340136054,
      "duration" : 7.665850340136054,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav",
      "seName" : "[SE] 打撃1.mp3"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #2",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.002.jpeg",
      "seVolume" : 0.85,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃1.mp3",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png",
      "voice2StartTimeOffset" : 0,
      "id" : "D9F3E504-6649-4C73-921B-D8A7C343E214",
      "title" : "シーン 2",
      "transitionName" : "なし",
      "telop" : "その音は、だんだんとこちらに近づいてきくる。\nそして、だんだんと暗闇に慣れて見えたのは、女性の姿だった。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.596303854875283,
      "duration" : 7.596303854875283,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "seName" : "[SE] 打撃1.mp3"
    },
    {
      "audioTrack" : "track_voice_sub",
      "characterName" : "サブ",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "サブ",
      "slideTitle" : "スライド #3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.003.jpeg",
      "seVolume" : 0.85,
      "seStartTimeOffset" : -7.596303854875283,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃1.mp3",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png",
      "voice2StartTimeOffset" : 0,
      "id" : "A93F9BED-B9C2-45C3-94C2-C2D5930D87ED",
      "title" : "シーン 3",
      "transitionName" : "なし",
      "telop" : "「今すぐ、私の背中に隠れなさい。」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 2.78,
      "duration" : 2.78,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_サブ.wav",
      "seName" : "[SE] 打撃1.mp3"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #4",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.004.jpeg",
      "seVolume" : 0.85,
      "seStartTimeOffset" : -10.376303854875285,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃1.mp3",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png",
      "voice2StartTimeOffset" : 0,
      "id" : "AA14C3EB-5E89-42B9-8C08-5375E0A7998A",
      "title" : "シーン 4",
      "transitionName" : "なし",
      "telop" : "彼女がそういうと、僕は無意識のうちに、彼女の背中に隠れる。\nなぜだかわからないが、彼女が母である霊夢に見えていた。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.40390022675737,
      "duration" : 8.40390022675737,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "seName" : "[SE] 打撃1.mp3"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #5",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.005.jpeg",
      "seVolume" : 0.85,
      "seStartTimeOffset" : 1.89,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃7.mp3",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png",
      "voice2StartTimeOffset" : 0,
      "id" : "C1C1DC5F-6AAB-4296-AFED-3CF098751701",
      "title" : "シーン 5",
      "transitionName" : "なし",
      "telop" : "すると、彼女は暗闇から鋭い攻撃を受ける。\nそして、ぐちゃりと何か飛び散る。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 5.745215419501133,
      "duration" : 5.745215419501133,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "seName" : "SE: 打撃7"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #6",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.006.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png",
      "voice2StartTimeOffset" : 0,
      "id" : "97DB792C-069C-4E54-B923-877EF18C4569",
      "title" : "シーン 6",
      "transitionName" : "なし",
      "telop" : "僕は、それが血だとわかると、彼女から離れようとする。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 3.78,
      "duration" : 3.78,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav"
    },
    {
      "audioTrack" : "track_voice_sub",
      "characterName" : "サブ",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "サブ",
      "slideTitle" : "スライド #7",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.007.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png",
      "voice2StartTimeOffset" : 0,
      "id" : "AD28D073-B621-4322-A064-AF59679E54BD",
      "title" : "シーン 7",
      "transitionName" : "なし",
      "telop" : "「逃げるな、目の前の景色を目に焼き付けなさい…\nそうじゃないと次は、あなたの番になるわよ。」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 6.0147619047619045,
      "duration" : 6.0147619047619045,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_サブ.wav"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.008.jpeg",
      "seVolume" : 0.85,
      "seStartTimeOffset" : 2.46,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃7.mp3",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png",
      "voice2StartTimeOffset" : 0,
      "id" : "A2B03778-1531-4CD3-9E95-7DD1A6252A65",
      "title" : "シーン 8",
      "transitionName" : "なし",
      "telop" : "彼女がそう言いながら、僕を庇い、再び攻撃を受ける。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 3.8756462585034015,
      "duration" : 3.8756462585034015,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "seName" : "SE: 打撃7"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #9",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.009.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png",
      "voice2StartTimeOffset" : 0,
      "id" : "31192E1F-DA85-4BB5-B9FA-521AB5F3461F",
      "title" : "シーン 9",
      "transitionName" : "なし",
      "telop" : "するとまた血が飛び散り、今度はその相手の姿が一瞬見える。\n「えっ…」そして、ある姿と重なる。「魔理沙さん…」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.9865079365079366,
      "duration" : 7.9865079365079366,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #10",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.010.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png",
      "voice2StartTimeOffset" : 0,
      "id" : "15F2BE5A-DC78-4DB4-8DA0-366D418452DF",
      "title" : "シーン 10",
      "transitionName" : "なし",
      "telop" : "僕は、そう思わず呟いていると、遠くの方から誰かが僕の声を叫んでいるような感じがして、だんだんと視界が暗転した。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.241519274376417,
      "duration" : 8.241519274376417,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav"
    },
    {
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "slideTitle" : "スライド #11",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.011.jpeg",
