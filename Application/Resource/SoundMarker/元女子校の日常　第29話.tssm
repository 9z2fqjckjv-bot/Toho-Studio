      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png",
      "id" : "A09F420E-6EEC-4949-B429-67C88134C622",
      "title" : "シーン 32",
      "transitionName" : "なし",
      "telop" : "「そうですか…、それで、何かわかるんですか？」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 3.0039002267573696,
      "duration" : 3.0039002267573696,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav"
    },
    {
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "characterName" : "永琳",
      "backgroundName" : "nc166698_病院の診察室.png",
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #33",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.033.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png",
      "voice2StartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png",
      "id" : "C0692CD4-7C25-47E3-B9B6-A38320B93FA3",
      "title" : "シーン 33",
      "transitionName" : "なし",
      "telop" : "「そうね…、簡潔にいうなら、あなたの落ち着き度合いを確認するためよ。まぁ、そんなことは気にしなくていいわ。」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.123741496598639,
      "duration" : 7.123741496598639,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav"
    },
    {
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "characterName" : "永琳",
      "backgroundName" : "nc166698_病院の診察室.png",
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #34",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.034.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png",
      "voice2StartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png",
      "id" : "5818A01B-B0BE-4E59-B2EA-CEACD6F990E1",
      "title" : "シーン 34",
      "transitionName" : "なし",
      "telop" : "「とりあえず、今日の診察はここまでにしましょう、学校には早退と伝えてあるから、病室に戻って休んでなさい。」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.344421768707483,
      "duration" : 7.344421768707483,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_永琳.wav"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
