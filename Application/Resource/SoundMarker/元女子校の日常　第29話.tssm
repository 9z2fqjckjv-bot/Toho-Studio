      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #12",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.012.jpeg",
