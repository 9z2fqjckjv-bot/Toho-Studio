      "id" : "5F69E81C-0E59-48F5-813B-C59B2CA7EA3B",
      "title" : "シーン 38",
      "transitionName" : "なし",
      "telop" : "実は、それは彼の出生に関わる秘密情報でもあり、しかもその情報を以前、彼を担当してた医者からは聞いてないものだった。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.219501133786848,
      "duration" : 8.219501133786848,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_永琳.wav"
    },
