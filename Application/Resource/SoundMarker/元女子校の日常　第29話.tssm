      "id" : "420AA19E-7712-4182-ABDD-FD1AD35CA647",
      "title" : "シーン 73",
      "transitionName" : "なし",
      "telop" : "「そんなことは、もうどうだっていいの、\nそれにあなたが病院にいるうちに、決着がついたし。」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.432040816326531,
