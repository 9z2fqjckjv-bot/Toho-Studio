    {
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "characterName" : "永琳",
      "backgroundName" : "nc166698_病院の診察室.png",
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #31",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.031.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png",
      "voice2StartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png",
      "id" : "44656FD0-21A9-4CE9-B414-46760BE209F6",
      "title" : "シーン 31",
      "transitionName" : "なし",
      "telop" : "「ええ。実は、あなたがあの研究室で倒れた後、\nすぐに病室に運ばれて、あなたの脳波をとっていたの。」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.237959183673469,
      "duration" : 7.237959183673469,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_永琳.wav"
    },
    {
      "audioTrack" : "track_voice_soumu",
