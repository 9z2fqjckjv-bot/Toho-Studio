      "id" : "6A61661B-34D0-4E23-94EA-650780392533",
      "title" : "シーン 74",
      "transitionName" : "なし",
      "telop" : "「それじゃあ、僕はどうなるんですか？」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 2.2539002267573696,
      "duration" : 2.2539002267573696,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav"
    },
    {
