      "title" : "シーン 80",
      "transitionName" : "なし",
      "telop" : "「じゃあ、母の神社はどうなるんですか？」",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 2.4973696145124715,
      "duration" : 2.4973696145124715,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav"
    },
