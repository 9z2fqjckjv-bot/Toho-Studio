      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ涙目驚き頬照り.png",
      "voice2StartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png",
      "id" : "99B6F0E8-032C-4F85-BEA2-07C93D836894",
      "title" : "シーン 12",
      "transitionName" : "なし",
      "telop" : "「んっ…」僕は誰かの叫び声で目が覚める。\nそこには、頬照った状態で泣いているこいしの姿があった。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.074557823129251,
