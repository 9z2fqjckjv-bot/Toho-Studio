      "id" : "038B91BB-074F-42FC-AC3A-FE77246F9A2A",
      "title" : "シーン 78",
      "transitionName" : "なし",
      "telop" : "「えっと…、それじゃあ…」僕がそう呟いていると、フランがベッドの上にある机に、婚姻届と藤原と書かれたハンコを出す。",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.10281179138322,
      "duration" : 8.10281179138322,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav"
    },
    {
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideTitle" : "スライド #79",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.079.jpeg",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png",
