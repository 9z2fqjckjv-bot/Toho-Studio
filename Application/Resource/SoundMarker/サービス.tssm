    {
      "id": "CE10E17A-2C75-4315-BC67-67B1587E0769",
      "title": "シーン 6",
      "duration": 33.683,
      "slideTitle": "第6スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "続いて、フリーサービスに付帯するオプション料金についてです。 スタッフの移動代金は原則実費となりますが、お客様の自家用車で送迎いただく「Let's Go Car's !」をご利用いただければ移動費用を無料に抑えることが可能です。 急ぎの移動には「Let's Go TAXI!」を、その他作業に必要な道具代金や宿泊代金の実費、他サービスとの併用オプションなども明瞭に規定しております。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.006.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_006_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 32.683,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "DF58137A-4171-40A5-963D-5F5CEF749364",
      "title": "シーン 7",
      "duration": 7.627,
      "slideTitle": "第7スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "続きまして、2つ目のメインサービスである「アシスタントサービス」についてご説明いたします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.007.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_007_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 6.627,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "B5D7BDA2-0ABC-4549-A9BE-0DEE8B437DEE",
      "title": "シーン 8",
      "duration": 26.21775,
      "slideTitle": "第8スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "アシスタントサービスは、「何でも屋」のメインサービスの中で最もハイグレードな対人中心のサービスです。 1時間あたり2,000円からご利用可能で、人と人との対話やパーソナルな寄り添いが求められる場面に最適です。 なお、法人向けの接客業などについては、別途ご用意している「ビジネスアシスタントサービス」をご利用いただきます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.008.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_008_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 25.21775,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "ED3982D3-EA5A-4E68-82FE-9EDB5545A643",
      "title": "シーン 9",
      "duration": 24.46775,
      "slideTitle": "第9スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "事例としては、日常のちょっとした相談相手や話し相手、一時的な友人役としての同行、プライベートな秘書や身の回りのお世話、私的な作業代行や自治会関連の代行作業などが挙げられます。 単なる作業代行にとどまらず、人の心や生活に深く寄り添うパートナーとして柔軟に対応いたします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.009.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_009_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 23.46775,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "20F97412-778A-489B-8007-CDAC04F4D078",
      "title": "シーン 10",
      "duration": 21.18025,
      "slideTitle": "第10スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "アシスタントサービスの料金表です。 対人コミュニケーションや個別対応の高いスキルを要するため、1時間2,000円をベースとし、日・週・月ごとのパッケージプランを設定しています。 継続的・長期的なご依頼にも対応できる透明性の高い料金構造となっております。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.010.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_010_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 20.18025,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "C7CADBE1-E863-4103-BF0A-DD236C597A53",
      "title": "シーン 11",
      "duration": 16.027,
      "slideTitle": "第11スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "オプション体系はフリーサービスと同様、実費交通費を基本とし、送迎による節約オプション「Let's Go Car's !」や、サービス品質を担保する「サービス保証」などをご用意しております。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.011.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_011_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 15.027,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "792B1C03-FD6D-4A0F-942B-4209124E821A",
      "title": "シーン 12",
      "duration": 10.4045,
      "slideTitle": "第12スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "ここで、「何でも屋」の持続可能性とスタッフの生活を支える独自制度、「割増料金手当」について詳しく解説いたします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.012.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_012_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 9.4045,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "92AA3D25-34A1-4548-817C-143DAF993582",
      "title": "シーン 13",
      "duration": 37.58425,
      "slideTitle": "第13スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "割増料金手当は、「何でも屋」で活動するパートナーの生活の質を確実に守り、高品質なサービスを維持するための制度です。 単身世帯、夫婦世帯、子育て世帯など、世帯形態ごとの最低手取り・標準手取り年収基準を明確に定めています。 基本料金を月割・単位換算した際にこの基準に満たない場合、差額を補填する形でオプションが適用されます。 なお、「何でも屋基金」の資本基金等へ高額参加いただいている場合は免除規定もございます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.013.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_013_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 36.58425,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "D3C1DC8D-873D-49A4-9DF8-1D782BF397D2",
      "title": "シーン 14",
      "duration": 7.417,
      "slideTitle": "第14スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "3つ目のメインサービスは、法人・各種組織向けの「ビジネスアシスタントサービス」です。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.014.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_014_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 6.417,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "1E991545-D47E-4B86-BB32-6126AEBC674D",
      "title": "シーン 15",
      "duration": 21.17275,
      "slideTitle": "第15スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "ビジネスアシスタントサービスは、企業・団体・教育機関・自治体などを対象としています。 事務・経理などのバックオフィスから、土木現場の雑工、工場作業、デジタル化推進まで、1時間あたり1,500円からの料金体系で事業活動を直接支援いたします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.015.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_015_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 20.17275,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "E061BAEF-67A1-4268-AE54-A590659DF594",
      "title": "シーン 16",
      "duration": 22.2395,
      "slideTitle": "第16スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "事例といたしましては、デスクワーク全般、マンション・ビルの管理、清掃や雑用、現場の作業員、NanndemoyaCloudを活用したIT・デジタル化の推進、コールセンター業務、徒歩デリバリー、店舗端末やセルフレジの管理など、人手不足に悩む現場を多角的にサポートします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.016.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_016_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 21.2395,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "3FAFF7D5-A1C7-4532-80A0-A8A5BB496996",
      "title": "シーン 17",
      "duration": 17.77525,
      "slideTitle": "第17スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "こちらがビジネスアシスタントサービスの料金体系です。 時間単位でのスポット派遣から、長期的な業務委託・プロジェクト単位の月額プランまで、法人の業務量に合わせて効率的にご活用いただける設計となっています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.017.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_017_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 16.77525,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "F0CB60F5-6730-492D-B32E-81C0CE3DE14A",
      "title": "シーン 18",
      "duration": 16.512,
      "slideTitle": "第18スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "本サービスでは通常の移動費等に加え、すべての企業様が平等に支援を受けられるよう「ビジネスアシスタントオプション」が必須項目として設定されています。個別のご要望に応じて柔軟にお見積もりいたします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.018.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
