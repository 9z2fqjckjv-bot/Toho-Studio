      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "A3B0ADD1-3DDA-4297-A13F-54E60B33D4D9",
      "title": "シーン 26",
      "duration": 11.85275,
      "slideTitle": "第26スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "ここからは、「何でも屋」をより便利にお得にご活用いただくためのプラットフォーム、「NanndemoyaCloud」と「Nanndemoya365」をご紹介します。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.026.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_026_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 10.85275,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "E879478E-894E-4E4D-AB0C-00CA329E81FB",
      "title": "シーン 27",
      "duration": 17.82275,
      "slideTitle": "第27スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "NanndemoyaCloudは、「何でも屋」の独自通貨や利用履歴の管理、各種業務効率化ツールをご利用いただける総合クラウドプラットフォームです。 お手元のスマートフォンやPCからいつでも簡単にご利用状況をご確認いただけます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.027.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_027_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 16.82275,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "DE562BE6-11B6-4057-8126-42E557827F1E",
      "title": "シーン 28",
      "duration": 16.76525,
      "slideTitle": "第28スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "Nanndemoya365は、5つのメインサービスをサブスクリプション形式で毎月定額利用できるサービスです。 定期的なお掃除や見守り、日常のパートナーとしての継続利用に大変おすすめのプランです。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.028.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_028_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 15.76525,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "048069E9-F7A3-465B-9E2F-5A52E6DF57B5",
      "title": "シーン 29",
      "duration": 10.1345,
      "slideTitle": "第29スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "続いて、メインサービスを補完し、より豊かな生活と社会貢献を実現する「その他のサービス」についてご紹介します。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.029.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_029_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 9.1345,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "544281FE-0005-40B0-B111-870FE38226A6",
      "title": "シーン 30",
      "duration": 15.25025,
      "slideTitle": "第30スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "そのひとつが「ライフイベント支援」制度です。 人生の重大な転機において、経済的な理由から夢や機会を諦めることがないよう、「何でも屋」が資金を贈与・支援する画期的な仕組みです。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.030.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_030_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 14.25025,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "17CB34A6-71EA-41B2-B7D1-754475DC2CC9",
      "title": "シーン 31",
      "duration": 13.6495,
      "slideTitle": "第31スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "支援対象は、結婚・妊娠・出産・育児・初等中等教育・大学進学、さらには障がいをお持ちのお子様の医療・教育費まで、人生の主要なステージを網羅しています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.031.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_031_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 12.6495,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "60798315-A8C7-4581-B445-8DAF4022B534",
      "title": "シーン 32",
      "duration": 19.93325,
      "slideTitle": "第32スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "本支援は相互の信頼関係を前提とするため、明確な人生設計があること、資金使途の合致、身元や信用の確認、クラウドへの登録など、15項目の要件を定めています。透明性と公平性を重んじた審査を行っております。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
