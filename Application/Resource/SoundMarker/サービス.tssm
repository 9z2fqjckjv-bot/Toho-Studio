      "sceneRelativeStartTime": 0.0,
      "duration": 6.16,
      "audioFilePath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_003_ナレーション.wav",
      "voiceSymbol": "マ'ズワ、ニチジョーノ/サマ'ザマナ/サ'ギョーオ/オテ'ツダイ+スル,フリーサ'ービスニ/ツ'イテ/ゴアンナ'イ+シマ'_ス。",
      "sceneIndex": 3,
