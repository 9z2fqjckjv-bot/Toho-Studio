      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "F08EC086-76FB-4DF6-9B38-0D1617C84E3B",
      "title": "シーン 25",
      "duration": 17.9045,
      "slideTitle": "第25スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "オプションとしては、交通費や品質保証に加え、お子様やシニアの方への「プレゼント・贈り物オプション」や、ご自宅に滞在してサポートする「住み込みサービス」など、家族のような温かい支援を可能にするメニューを取り揃えています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.025.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_025_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 16.9045,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
