      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.043.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_043_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 9.8245,
      "bgmAudioPath": null,
