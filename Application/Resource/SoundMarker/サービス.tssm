    },
    {
      "id": "7076EBED-191C-45FB-948A-5130640F89FF",
      "title": "シーン 43",
      "duration": 10.8245,
      "slideTitle": "第43スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "何でも屋ハウス基金は、後述する拠点物件の整備費用に充てられ、支援者には完全無料利用チケットなどの特典が付与されます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
