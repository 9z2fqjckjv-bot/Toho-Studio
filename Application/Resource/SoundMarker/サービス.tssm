    {
      "id": "1A5A35EF-5940-436B-9655-6A6BCF25B07D",
      "title": "シーン 5",
      "duration": 30.885,
      "slideTitle": "第5スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "こちらはフリーサービスの基本料金およびプレミアム料金の体系表です。 1時間・3時間・6時間・12時間といった短時間利用から、日単位・週単位・月単位の継続利用まで柔軟なプランをご用意しています。 まとまった時間や期間でのご利用ほど割安になる料金設計となっており、突発的な作業から日常的な定期サポートまで状況に合わせて最適な形態をお選びいただけます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.005.jpeg",
