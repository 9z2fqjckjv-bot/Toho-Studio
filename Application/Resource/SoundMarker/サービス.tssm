    {
      "id": "702260B5-B3DF-4DBA-BFC0-87D78DFD74AE",
      "title": "シーン 19",
      "duration": 8.8445,
      "slideTitle": "第19スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "続いて、世代別の特化型サービスである「子ども向けサービス」と「シニアサービス」についてご説明します。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.019.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_019_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 7.8445,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "CEF2A222-2EF9-4BB8-AA8D-64B734BE217B",
      "title": "シーン 20",
      "duration": 19.6385,
      "slideTitle": "第20スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "子ども向けサービスは、子育て世帯を全力で応援するため、5つのメインサービスの中で最もリーズナブルな1時間あたり500円から設定されています。 保護者様の負担軽減やお子様の健やかな成長をサポートすることを最優先としています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.020.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_020_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 18.6385,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "94C2D209-940D-4C80-BC1B-3621B4CCAD2A",
      "title": "シーン 21",
      "duration": 18.4695,
      "slideTitle": "第21スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "シニアサービスも同様に、1時間500円からの低価格でご提供しています。 ご高齢の方々の日常生活の補助、通院や散歩の付き添い、孤独感を解消するための話し相手など、安心・安全なシニアライフを支えます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.021.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_021_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 17.4695,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "8C03523C-07F5-4A1E-99C0-B797B20A04DF",
      "title": "シーン 22",
      "duration": 15.707,
      "slideTitle": "第22スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "子ども向けサービスでは、遊び相手や宿題のサポート、習い事や学校への送迎、留守番時の見守り、食事補助や添い寝など、親御様の手が回らない日常のケアを総合的にお手伝いします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.022.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_022_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 14.707,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "E2352801-A85A-456D-9056-93BCB2B1A125",
      "title": "シーン 23",
      "duration": 16.9695,
      "slideTitle": "第23スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "シニアサービスでは、通院やお墓参りへの同行、買い物代行、散歩のお供、スマートフォンの操作案内や、ご自宅での住み込みサポートまで、高齢者お一人おひとりの生活スタイルに寄り添った支援を行います。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.023.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_023_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 15.9695,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "22424DA9-897F-43CA-BC93-EA345EEC171E",
      "title": "シーン 24",
      "duration": 15.94275,
      "slideTitle": "第24スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "こちらが両サービス共通の料金表です。 1時間500円という低負担からスタートでき、長時間の見守りや定期的な訪問でも無理なく継続してご利用いただける料金体系を実現しています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.024.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_024_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 14.94275,
      "bgmAudioPath": null,
