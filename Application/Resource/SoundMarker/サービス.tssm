    {
      "id": "667BD6F6-8AF2-46CE-955B-BDF404E2A96B",
      "name": "[ナレーション] この動画では、「何でも屋」が手掛ける各種サービスの内容をご説明いたします。",
      "type": "Voice",
      "character": "ナレーション",
      "text": "この動画では、「何でも屋」が手掛ける各種サービスの内容をご説明いたします。",
      "voiceType": "中性",
      "speed": 100,
      "pitch": 100,
      "volume": 1.0,
      "pan": 0.0,
      "playbackRate": 1.0,
      "isLooping": false,
      "isReversed": false,
