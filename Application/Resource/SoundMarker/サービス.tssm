    },
    {
      "id": "13C7E3F5-081D-4919-9F7F-8EFB284C1C7E",
      "title": "シーン 3",
      "duration": 26.57275,
      "slideTitle": "第3スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "フリーサービスは、「何でも屋」が提供する5つのメインサービスの中で、中間価格帯に位置づけられるサービスです。 主に道具を用いた作業全般を中心としており、1時間あたり1,000円からご利用いただけます。 さらに「マルチサービスオプション」をご活用いただくことで、アシスタントサービスなど他のサービスとの同時併用も可能となっています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.003.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_003_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 25.57275,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "A74BCCAA-7B3E-42BF-A76A-C9D353A749E0",
      "title": "シーン 4",
      "duration": 29.5445,
      "slideTitle": "第4スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "具体的な対応事例がこちらです。 清掃や家事、DIY作業、道具を用いた使用人業務のほか、お買い物代行やお留守番・ペットの見守りや散歩代行など、日常のあらゆる軽作業・実作業をカバーします。 また、「何でも屋ハウス」ご利用者様限定の別荘管理なども承っております。道具を使う実務作業全般は、まずこのフリーサービスにお任せください。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.004.jpeg",
