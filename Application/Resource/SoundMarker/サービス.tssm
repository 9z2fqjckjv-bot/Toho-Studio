    {
      "id": "064DFCBD-E51F-4C30-A6CF-995B57F91B57",
      "title": "シーン 2",
      "duration": 6.712,
      "slideTitle": "第2スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "まず最初にご紹介するのは、メインサービスのひとつである「フリーサービス」です。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
