    {
      "id": "E1655BDE-C7D1-46ED-AADD-890092403F72",
      "title": "シーン 33",
      "duration": 14.166,
      "slideTitle": "第33スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "支援を受けた方には、将来的に「何でも屋」のパートナーとして地域にサービスを提供していただくなど、恩送りのサイクルで持続可能な助け合いのコミュニティを形成していきます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.033.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_033_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 13.166,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "783D4432-5710-48B6-BA09-1F9494E584D5",
      "title": "シーン 34",
      "duration": 9.2845,
      "slideTitle": "第34スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "次に、事業の運営基盤と設備を支えるクラウドファンディング型の仕組み、「何でも屋基金」についてご説明します。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.034.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_034_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 8.2845,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "C6EA195D-11F0-4DE3-8196-2CBE8E17B06C",
      "title": "シーン 35",
      "duration": 12.17025,
      "slideTitle": "第35スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "日常生活・事業維持費基金は、サービスの安定的な継続と日々の活動費を支えるためのもので、目標金額を100万円に設定しています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.035.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_035_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 11.17025,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "D3401D52-22FF-4FCE-BD5D-AE1F0C8E1A18",
      "title": "シーン 36",
      "duration": 11.67775,
      "slideTitle": "第36スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "広告基金は、「何でも屋」の認知拡大と新規利用者の獲得を図るプロモーション活動を目的としており、目標金額は50万円です。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.036.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_036_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 10.67775,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "07C70E62-3B1A-4E5F-A79B-F06DEFE2AEDE",
      "title": "シーン 37",
      "duration": 19.9135,
      "slideTitle": "第37スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "スマートフォン基金は、現場スタッフの業務用端末（DIGNO SX5）を導入するための基金です。 目標額は1人あたり5万円で、参加金額に対して100%分のベースパッククレジットを還元するお得なボーナスが設定されています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.037.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_037_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 18.9135,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
