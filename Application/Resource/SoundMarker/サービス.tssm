    },
    {
      "id": "FBC1D90F-97A8-4D3B-8325-13C81953C6E0",
      "title": "シーン 52",
      "duration": 7.362,
      "slideTitle": "第52スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "ここからは、各種サービスをご利用いただく際のお支払い方法についてご説明いたします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.052.jpeg",
