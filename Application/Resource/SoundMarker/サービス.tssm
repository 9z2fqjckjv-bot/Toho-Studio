      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "64FEDCD9-AE34-4B3B-8353-120046819AC9",
      "title": "シーン 44",
      "duration": 8.126999999999999,
      "slideTitle": "第44スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "ここからは、遊休不動産を価値ある拠点へと再生する「何でも屋ハウス」について解説します。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.044.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_044_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 7.127,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "28957F17-8B0E-437E-BE72-D63A0B98DAF3",
      "title": "シーン 45",
      "duration": 17.9545,
      "slideTitle": "第45スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "何でも屋ハウスは、使われていない別荘や空き家、更地をご提供いただき、その査定額に応じた「ベースパッククレジット」をお客様に還元する仕組みです。遊休資産を有効活用し、新しい経済価値を創出します。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.045.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_045_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 16.9545,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "DB897458-7CDD-442C-AAB4-A35DBFCCA4F1",
      "title": "シーン 46",
      "duration": 12.4645,
      "slideTitle": "第46スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "物件提供者様には、固定資産の管理負担軽減だけでなく、「何でも屋」サービスの特別優待や優先利用権など、多彩な特典が付与されます。",
      "audioTrack": "track_voice_char_narration",
