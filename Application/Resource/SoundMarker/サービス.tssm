    {
      "id": "927E8B0F-1F13-451E-8E7D-FE7416B2FB65",
      "title": "シーン 51",
      "duration": 26.4665,
      "slideTitle": "第51スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "限定コンテンツの配信、財務情報の透明性を担保するクイックビュー、基本料金で最高品質を提供するプレミアチケット、Google MeetによるWeb相談、超速便のクイックカム、資産形成のベースパック＋、お荷物お運び、デバイス配送、中古買取など、多彩な周辺サービスで生活を丸ごとバックアップします。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.051.jpeg",
