    },
    {
      "id": "1DAE3DE2-8BB7-4C2A-94E0-DC29905D6F5C",
      "title": "シーン 42",
      "duration": 15.90025,
      "slideTitle": "第42スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "こちらは先ほどご紹介したライフイベント支援の原資となる基金です。将来的にあらゆる困難に直面する方々を包括的に救済できるよう、壮大なビジョンとして目標1兆円を掲げています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.042.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath": null,
      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_042_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 14.90025,
