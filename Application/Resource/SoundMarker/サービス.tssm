      "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_053_ナレーション.wav",
      "voiceCharacter": "ナレーション",
      "voiceDuration": 18.72025,
      "bgmAudioPath": null,
      "bgmName": null,
      "bgmStartTimeOffset": 0.0,
      "bgmVolume": 0.0,
      "seAudioPath": null,
      "seName": null,
      "seStartTimeOffset": 0.0,
      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "AB143938-4D78-4DB5-A51B-790AE9A99272",
      "title": "シーン 54",
      "duration": 13.8745,
      "slideTitle": "第54スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "現金でのお支払いは、請求書の通りにお釣りが出ないようご準備いただきます。トラブル防止のため封筒等にまとめてお渡しいただき、スタッフより領収書を発行いたします。",
