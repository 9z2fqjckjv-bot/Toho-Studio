    {
      "id": "2886DA18-EF22-40EE-A303-CA13856178B8",
      "name": "[ナレーション] まずは、日常の様々な作業をお手伝いするフリーサービスについてご案内します。",
      "type": "Voice",
      "character": "ナレーション",
      "text": "まずは、日常の様々な作業をお手伝いするフリーサービスについてご案内します。",
      "voiceType": "中性",
      "speed": 100,
      "pitch": 100,
      "volume": 1.0,
      "pan": 0.0,
      "playbackRate": 1.0,
      "isLooping": false,
      "isReversed": false,
      "fadeInDuration": 0.0,
      "fadeOutDuration": 0.0,
