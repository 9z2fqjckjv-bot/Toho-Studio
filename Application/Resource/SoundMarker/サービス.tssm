      "seVolume": 0.0,
      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "1C9429CD-5933-410B-9114-915CF68B9EEA",
      "title": "シーン 38",
      "duration": 18.06525,
      "slideTitle": "第38スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "電動三輪車基金は、環境に優しく小回りの利く移動手段を確保するための基金です。目標金額は21万円で、片道200km圏内のお客様に移動代金無料券を付与する特典をご用意しています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
