      "voiceStartTimeOffset": 0.0
    },
    {
      "id": "C400BE73-B48E-4BDC-B5CF-3872ED2698CE",
      "title": "シーン 53",
      "duration": 19.72025,
      "slideTitle": "第53スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "こちらは決済手段の比較表です。 現金、銀行振込、PayPal、ベースパッククレジット、ベースパック、送金決済のそれぞれで対応可能な料金項目を一覧にまとめております。用途に合わせて最適な手段をお選びいただけます。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.053.jpeg",
      "videoPath": null,
      "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
