    },
    {
      "id": "14EA0FF1-7B9D-4CA6-B009-0D7974837B4B",
      "title": "シーン 41",
      "duration": 10.79525,
      "slideTitle": "第41スライド",
      "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
      "characterName": "ナレーション",
      "telop": "資本基金は、事業の長期的な安定性と社会的信用を担保するための土台として、1,000万円を目標に設定しています。",
      "audioTrack": "track_voice_char_narration",
      "animationName": "なし",
      "transitionName": "なし",
      "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/サービス_cfc5f25fdd/サービス_cfc5f25fdd.041.jpeg",
