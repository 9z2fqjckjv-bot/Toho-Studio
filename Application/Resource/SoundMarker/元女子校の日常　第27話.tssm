      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.047.jpeg",
