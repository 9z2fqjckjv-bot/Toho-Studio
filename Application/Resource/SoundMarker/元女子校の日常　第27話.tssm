      "slideTitle" : "スライド #63",
      "voiceCharacter" : "古明地こいし",
      "title" : "シーン 63",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "id" : "9FFA7AE8-17A7-433A-8D36-63239F71413C",
      "voiceDuration" : 3.197233560090703,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_古明地こいし.wav",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "telop" : "「あんた、今まで私を騙してたの！」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.064.jpeg",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第27話\/パジャマ頬照り赤らみ怒り.png",
