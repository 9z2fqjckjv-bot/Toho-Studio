      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "telop" : "僕は、彼女の突如の変化に戸惑いながらも、そっとキスをする。",
      "audioTrack" : "track_voice_soumu"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.061.jpeg",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第27話\/パジャマ頬照り赤らみ驚き.png",
      "characterName" : "操夢",
      "bgmStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "duration" : 8.225646258503401,
      "slideTitle" : "スライド #61",
      "voiceCharacter" : "操夢",
      "title" : "シーン 61",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "id" : "D8B14C49-15CB-4DC5-88BB-8D7CB10973BF",
      "voiceDuration" : 8.225646258503401,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "telop" : "すると、彼女の全身が頬照ったように赤みを帯び、固まってしまう。僕は、その彼女の手を取り、ある存在を示す。",
      "audioTrack" : "track_voice_soumu"
    },
    {
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いパンチ2.mp3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.062.jpeg",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第27話\/パジャマ頬照り赤らみ怒り.png",
      "characterName" : "操夢",
