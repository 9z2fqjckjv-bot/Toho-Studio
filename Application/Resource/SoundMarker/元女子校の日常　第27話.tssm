      "voiceStartTimeOffset" : 0,
      "id" : "21C8EED9-FDD9-4BF9-90A2-0736F48E8FA0",
      "animationNote" : "5秒",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "voice2StartTimeOffset" : 0,
      "bgmName" : "BGM: Mellotron Flute森近霖之助テーマ曲_1"
    },
    {
      "bgmStartTimeOffset" : 0,
      "telop" : "僕はふと気がつくと、そこは食堂だった。すると、こいしが驚いた様子で僕を見る。「どうしたんですか、こいしさん？」",
      "duration" : 8.085419501133787,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav",
      "seStartTimeOffset" : 0,
