      "slideTitle" : "スライド #62",
      "voiceCharacter" : "操夢",
      "title" : "シーン 62",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "id" : "9C00B2B8-B03D-4A3B-A26D-D62599C02E2E",
      "voiceDuration" : 8.486507936507936,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "seVolume" : 1.5078125,
      "voiceStartTimeOffset" : 0,
      "telop" : "すると、彼女はますます赤く染まっていき、僕を押し倒したことを疑うくらいになっていた。だが、彼女は強烈なビンタをする。",
      "audioTrack" : "track_voice_soumu"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.063.jpeg",
