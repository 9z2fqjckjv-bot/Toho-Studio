    {
      "bgmStartTimeOffset" : 0,
      "telop" : "「確かにあなたのいうとおりね…。\nとりあえず、夕飯にしましょうか。」",
      "duration" : 4.183832199546485,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_レミリア・スカーレット.wav",
