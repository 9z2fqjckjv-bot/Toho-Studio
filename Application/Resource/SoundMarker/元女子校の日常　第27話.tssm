      "voiceDuration" : 8.30607709750567,
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "telop" : "「いえ、僕は戸籍上は男ですが、医者からは生まれつき、女性と男性、双方の臓器や体の部位があるって言われたんです。」",
      "audioTrack" : "track_voice_soumu"
    },
    {
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_古明地こいし.wav",
