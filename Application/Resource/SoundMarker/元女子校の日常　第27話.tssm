      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voice2StartTimeOffset" : 0
    },
    {
      "bgmStartTimeOffset" : 0,
      "telop" : "彼女はそう言い、部屋をさると、私も出る。そして、食事が終わると霊の如く、全身に衝撃が入り、彼が出てくるのだった。",
      "duration" : 9.059342403628118,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_サブ.wav",
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #48",
      "title" : "シーン 48",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.048.jpeg",
      "characterName" : "サブ",
      "animationName" : "なし",
      "backgroundName" : "nc107556_紅魔的館内.jpg",
      "transitionName" : "なし",
      "voiceCharacter" : "サブ",
      "voiceDuration" : 9.059342403628118,
      "bgmVolume" : 0.7,
      "voiceStartTimeOffset" : 0,
      "id" : "483277E6-38D2-4F92-911F-903D9A190531",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "audioTrack" : "track_voice_sub",
      "voice2StartTimeOffset" : 0
    },
    {
      "bgmStartTimeOffset" : 0,
      "telop" : "？\n霊夢の母に霖之助と呼ばれていた。そして、後継に困る彼女に、後継を手配するともに、地下底国グループの内部分裂の情報、謎の封筒を手渡していた。そして、霊夢に封筒の中身が賄賂ではないかと聞かれると、賄賂ではないと言っていた。謎多き人物。\n？",
      "duration" : 5,
      "animationDuration" : 5,
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第27話\/黒影.png",
      "seVolume" : 1,
      "slideTitle" : "スライド #49",
      "title" : "シーン 49",
