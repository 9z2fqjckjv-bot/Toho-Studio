      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "telop" : "「もういい、あんたに私の気持ちを分からせるわ。」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第27話_cb0f3f8728\/元女子校の日常　第27話_cb0f3f8728.060.jpeg",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/頬照り小口開け.png",
