      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0
    },
    {
      "id" : "11105830-7E0C-445A-815D-93ECC1A8BFA9",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第27話\/nc230674_観覧車の中（夕方）.jpg",
      "seName" : "SE: 軽いパンチ1",
      "voiceStartTimeOffset" : 0,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/軽いパンチ1.mp3",
      "voiceDuration" : 4.406077097505669,
      "characterName" : "サブ",
      "telop" : "そして、彼女が少女を手で掴みかけると、私はその手を叩く。\nすると、彼女の動作が止まり、表情が変わる。",
      "voice2Duration" : 3.2560770975056688,
      "backgroundName" : "nc230674_観覧車の中（夕方）.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第27話\/帽子のみ涙あわわ.png",
