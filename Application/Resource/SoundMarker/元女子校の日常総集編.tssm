      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg",
      "telop" : "そして、気がつけば、赤信号の横断歩道を渡っており、彼が止めなければ、きっとあのまま車に轢かれていたという。",
      "voiceCharacter" : "博麗霊夢",
      "duration" : 8.569478458049886,
      "title" : "シーン 622",
      "slideTitle" : "スライド #622",
      "characterName" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.622.jpeg",
      "voiceDuration" : 8.569478458049886,
      "seVolume" : 1
    },
    {
