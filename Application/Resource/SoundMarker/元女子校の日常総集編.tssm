      "telop" : "僕は彼女にそう返され、前に向き直る。それから、僕はフランの隣の助手席で、ただぼーっと車窓を眺めるのだった。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 9.563242630385487,
      "title" : "シーン 969",
      "slideTitle" : "スライド #969",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.969.jpeg",
      "voiceDuration" : 9.563242630385487,
      "seVolume" : 1
    },
    {
      "id" : "F6E6E0BE-9DF8-4CE5-8CC4-8DE500388E3E",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_970_操夢.wav",
