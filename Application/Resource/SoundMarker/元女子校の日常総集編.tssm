      "voiceDuration" : 4.769501133786848,
      "telop" : "「ええ、分かったわ…、それじゃあ、行ってくるわね…」\n私はそう言うと、本屋を見に行った。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
