      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_288_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "ペーストされた画像.tiff",
