      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_969_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
