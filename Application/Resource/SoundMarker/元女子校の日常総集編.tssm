      "id" : "F452CF73-032C-482B-AFF3-863E6AD25A56",
      "title" : "シーン 1177",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1177",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1177.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.286507936507936,
      "telop" : "そして、店内には、きっとその場所で使うことを想定されている洋服がずらりと並んでいた。そこまで見ると、視線を戻す。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
