      "voiceDuration" : 3.366984126984127,
      "telop" : "「ありがとうございます。」私はそう返す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
