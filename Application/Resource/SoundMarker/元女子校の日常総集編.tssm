      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "永琳が言うには、彼は貴重な研究対象だから、学園から話さずに、学校側の手が届く範囲でいさせたいとの要望だった。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 8.660725623582767,
      "title" : "シーン 1574",
      "slideTitle" : "スライド #1574",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1574.jpeg",
      "voiceDuration" : 8.660725623582767,
      "seVolume" : 1
    },
    {
      "id" : "6B7194A0-2C76-43F7-8421-689B0FDB962C",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1575_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "私は、彼が貴重な人物であることは認識していたが、それほど重要性の高い人物だとは、正直に言って感じてなかった。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 8.607596371882087,
      "title" : "シーン 1575",
      "slideTitle" : "スライド #1575",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1575.jpeg",
      "voiceDuration" : 8.607596371882087,
      "seVolume" : 1
    },
    {
      "id" : "7DD52053-9897-4E43-905C-06026507BAB1",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1576_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "私は、一通り永琳の意見を聞き終えると、こいしの方に再度、切り替える。すると、彼女は、これは戦いだと、言ってきた。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 9.121020408163265,
      "title" : "シーン 1576",
      "slideTitle" : "スライド #1576",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1576.jpeg",
      "voiceDuration" : 9.121020408163265,
      "seVolume" : 1
    },
    {
      "id" : "F65E5B22-ED00-4901-A5D3-FBE680826714",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1577_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "そして、彼女は控えめだったが、もし彼女たちの要請に応じられないなら、学園の資金提供などの協力は打ち切ると言ってきた。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 8.534149659863946,
      "title" : "シーン 1577",
      "slideTitle" : "スライド #1577",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1577.jpeg",
      "voiceDuration" : 8.534149659863946,
      "seVolume" : 1
    },
    {
      "id" : "F1D418AB-E5FE-4340-9B27-79EC6718CF01",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1578_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "どうやらすでに、彼女の両親がトップに鎮座する地下底国グループの意見を聞き取り、グループの見解になったそうだった。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 7.774058956916099,
      "title" : "シーン 1578",
      "slideTitle" : "スライド #1578",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1578.jpeg",
      "voiceDuration" : 7.774058956916099,
      "seVolume" : 1
    },
    {
      "id" : "57835C07-4403-47BE-B6E7-ED7A1FFE2DCE",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1579_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "地下底国グループは、その名の通り、この社会の土台や裏側を幅広く、汎用的に事業を展開し支える巨大組織である。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 8.490408163265306,
      "title" : "シーン 1579",
      "slideTitle" : "スライド #1579",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1579.jpeg",
      "voiceDuration" : 8.490408163265306,
      "seVolume" : 1
    },
    {
      "id" : "6F2F4F39-47A1-4C16-AE34-6A77524E3BC6",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1580_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "彼女は、今までその名では行動することはなかった。\n学校生活とグループでの完全な使い分けをしていたのだ。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 7.454875283446712,
      "title" : "シーン 1580",
      "slideTitle" : "スライド #1580",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1580.jpeg",
      "voiceDuration" : 7.454875283446712,
      "seVolume" : 1
    },
    {
      "id" : "27779CDB-FA26-4447-8F53-C7C52E713DCF",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1581_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "そんな彼女の裸を運悪く見てしまった彼を発端に、彼女は今まであえて潜めていたグループを使い始めたことに、私は驚いた。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 8.687165532879819,
