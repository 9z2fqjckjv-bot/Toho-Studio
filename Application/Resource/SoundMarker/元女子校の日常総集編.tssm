      "voiceDuration" : 3.702562358276644,
      "telop" : "「その書面を挟んでいるボールペンで、サインを頂けるかしら。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
