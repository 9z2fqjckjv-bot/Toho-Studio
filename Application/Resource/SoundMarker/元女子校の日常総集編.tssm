      "seVolume" : 1,
      "voiceDuration" : 8.176984126984127,
      "telop" : "「なぁ、お前は、どう思う、今の私を見て…」\n私は、誰もいない部屋で、そう誰かに語りかける。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
