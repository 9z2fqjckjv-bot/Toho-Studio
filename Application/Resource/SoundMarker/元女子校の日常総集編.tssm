      "seVolume" : 1,
      "voiceDuration" : 8.550748299319729,
      "telop" : "「きっと…」私は、そう言うと、ふと後ろから声が聞こえる。\n誰もいないはずの空間からは、声が聞こえる。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
