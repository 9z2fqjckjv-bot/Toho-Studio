      "voiceDuration" : 3.8270521541950115,
      "telop" : "「もういい、あんたに私の気持ちを分からせるわ。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
