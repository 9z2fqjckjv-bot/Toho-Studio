    },
    {
      "id" : "B3A40D6F-7FA3-4949-9D98-33F48992238C",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_134_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。",
      "voiceCharacter" : "八意永琳",
      "duration" : 5.903537414965986,
      "title" : "シーン 134",
      "slideTitle" : "スライド #134",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.134.jpeg",
      "voiceDuration" : 5.903537414965986,
      "seVolume" : 1
    },
    {
      "id" : "B1FFAEB4-6F81-4861-A53B-D551A003340A",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_135_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。",
      "voiceCharacter" : "八意永琳",
      "duration" : 10.509183673469387,
      "title" : "シーン 135",
      "slideTitle" : "スライド #135",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.135.jpeg",
      "voiceDuration" : 10.509183673469387,
      "seVolume" : 1
    },
    {
      "id" : "832AFB24-C2A6-469B-B7DD-2CE845B7204D",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_136_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。",
      "voiceCharacter" : "八意永琳",
      "duration" : 8.210839002267575,
      "title" : "シーン 136",
      "slideTitle" : "スライド #136",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.136.jpeg",
      "voiceDuration" : 8.210839002267575,
      "seVolume" : 1
    },
    {
      "id" : "AA5C0873-E53B-4BAB-898C-58066995EC69",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_137_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。",
      "voiceCharacter" : "八意永琳",
      "duration" : 9.902108843537414,
      "title" : "シーン 137",
      "slideTitle" : "スライド #137",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.137.jpeg",
      "voiceDuration" : 9.902108843537414,
      "seVolume" : 1
    },
    {
      "id" : "EB633CAA-A5D7-49F5-9DBD-1645B2E098A0",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_138_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…",
      "voiceCharacter" : "八意永琳",
      "duration" : 9.371814058956916,
      "title" : "シーン 138",
      "slideTitle" : "スライド #138",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.138.jpeg",
      "voiceDuration" : 9.371814058956916,
      "seVolume" : 1
    },
    {
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "id" : "06280859-9E27-4656-BE77-D43165C8A010",
      "seStartTimeOffset" : 0.3,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_139_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。",
      "voiceCharacter" : "八意永琳",
      "duration" : 8.214489795918368,
      "title" : "シーン 139",
      "slideTitle" : "スライド #139",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "seName" : "SE: 木のドアをノック1",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.139.jpeg",
      "voiceDuration" : 8.214489795918368,
      "seVolume" : 0.85
    },
    {
      "id" : "B74E0A7D-F945-482A-816A-28AD4E9637AE",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_140_射命丸文.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。",
      "voiceCharacter" : "射命丸文",
      "duration" : 7.111587301587302,
      "title" : "シーン 140",
      "slideTitle" : "スライド #140",
      "characterName" : "射命丸文",
      "audioTrack" : "track_voice_char_EF7A",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.140.jpeg",
      "voiceDuration" : 7.111587301587302,
      "seVolume" : 1
    },
    {
      "id" : "535B6AC3-ABDB-483D-800C-2B35A4B3D848",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_141_射命丸文.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」",
      "voiceCharacter" : "射命丸文",
      "duration" : 8.62358276643991,
      "title" : "シーン 141",
      "slideTitle" : "スライド #141",
      "characterName" : "射命丸文",
      "audioTrack" : "track_voice_char_EF7A",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.141.jpeg",
      "voiceDuration" : 8.62358276643991,
      "seVolume" : 1
    },
    {
      "id" : "90FAD8AD-1BC0-4868-9770-6BDEF4C50AF5",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_142_射命丸文.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」",
      "voiceCharacter" : "射命丸文",
      "duration" : 7.600181405895691,
      "title" : "シーン 142",
      "slideTitle" : "スライド #142",
      "characterName" : "射命丸文",
      "audioTrack" : "track_voice_char_EF7A",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.142.jpeg",
      "voiceDuration" : 7.600181405895691,
      "seVolume" : 1
    },
    {
      "id" : "A779C864-8653-479A-B1E4-D0966A62F84F",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_143_射命丸文.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「それと、息子さんの言ってたことは全て事実だそうですよ。」",
      "voiceCharacter" : "射命丸文",
      "duration" : 3.6015873015873017,
      "title" : "シーン 143",
      "slideTitle" : "スライド #143",
      "characterName" : "射命丸文",
      "audioTrack" : "track_voice_char_EF7A",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.143.jpeg",
      "voiceDuration" : 3.6015873015873017,
      "seVolume" : 1
    },
    {
      "id" : "5011836F-9EC6-4022-AC11-D4895D6EE1C8",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_144_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。",
      "voiceCharacter" : "八意永琳",
      "duration" : 8.235374149659863,
      "title" : "シーン 144",
      "slideTitle" : "スライド #144",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.144.jpeg",
      "voiceDuration" : 8.235374149659863,
      "seVolume" : 1
    },
    {
      "id" : "72885777-FDEF-4335-9313-0CF3DC0C7C6D",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（余裕）.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_145_射命丸文.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「代金、確かにいただきました。それでは、またのご利用を。」",
      "voiceCharacter" : "射命丸文",
      "duration" : 4.105578231292517,
      "title" : "シーン 145",
      "slideTitle" : "スライド #145",
      "characterName" : "射命丸文",
      "audioTrack" : "track_voice_char_EF7A",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.145.jpeg",
      "voiceDuration" : 4.105578231292517,
      "seVolume" : 1
    },
    {
      "id" : "5C33B97E-48A9-48F5-9C69-6162AF6D2526",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_146_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」",
      "voiceCharacter" : "八意永琳",
      "duration" : 7.0875963718820865,
      "title" : "シーン 146",
      "slideTitle" : "スライド #146",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.146.jpeg",
      "voiceDuration" : 7.0875963718820865,
      "seVolume" : 1
    },
    {
      "id" : "1CE1EC5F-E91A-437E-BA17-A7A8E2B7F896",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_147_八意永琳.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。",
      "voiceCharacter" : "八意永琳",
      "duration" : 8.360249433106576,
      "title" : "シーン 147",
      "slideTitle" : "スライド #147",
      "characterName" : "八意永琳",
      "audioTrack" : "track_voice_char_F1CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.147.jpeg",
      "voiceDuration" : 8.360249433106576,
      "seVolume" : 1
    },
    {
      "id" : "ED34555E-09CF-4A3F-957C-E599D96925D2",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "animationDuration" : 1.5,
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "animationNote" : "表示時間:1.5秒",
      "telop" : "彼に視点が戻り…",
      "duration" : 1.5,
      "title" : "シーン 148: 彼に視点が戻り…",
      "slideTitle" : "スライド #148",
      "characterName" : "操夢",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.148.jpeg",
      "seVolume" : 1
    },
    {
      "id" : "29775F15-E64C-4238-BC9C-C9BC7FD32604",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_149_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…",
      "voiceCharacter" : "操夢",
      "duration" : 9.281065759637189,
      "title" : "シーン 149",
      "slideTitle" : "スライド #149",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.149.jpeg",
      "voiceDuration" : 9.281065759637189,
      "seVolume" : 1
    },
    {
      "id" : "0E8D11FE-59C0-4C5F-9812-838C7CF12370",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_150_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。",
      "voiceCharacter" : "操夢",
      "duration" : 8.397369614512472,
      "title" : "シーン 150",
      "slideTitle" : "スライド #150",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.150.jpeg",
      "voiceDuration" : 8.397369614512472,
      "seVolume" : 1
    },
    {
      "id" : "FD739CED-6D67-4410-86C3-A545B1DF89E9",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_151_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。",
      "voiceCharacter" : "操夢",
      "duration" : 8.261519274376417,
      "title" : "シーン 151",
      "slideTitle" : "スライド #151",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.151.jpeg",
      "voiceDuration" : 8.261519274376417,
      "seVolume" : 1
    },
    {
      "id" : "92A4ED78-83DE-42E1-A94E-799944821539",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_152_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。",
      "voiceCharacter" : "操夢",
      "duration" : 8.697369614512471,
      "title" : "シーン 152",
      "slideTitle" : "スライド #152",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.152.jpeg",
      "voiceDuration" : 8.697369614512471,
      "seVolume" : 1
    },
    {
      "id" : "D0FA6252-4C89-4D35-96C9-72AB8715EBA0",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_153_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。",
      "voiceCharacter" : "操夢",
      "duration" : 8.525646258503402,
      "title" : "シーン 153",
      "slideTitle" : "スライド #153",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.153.jpeg",
      "voiceDuration" : 8.525646258503402,
      "seVolume" : 1
    },
    {
      "id" : "5C0BB5E1-ACF6-426F-82DC-E2F452910835",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_154_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。",
      "voiceCharacter" : "操夢",
      "duration" : 7.856077097505669,
      "title" : "シーン 154",
      "slideTitle" : "スライド #154",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.154.jpeg",
      "voiceDuration" : 7.856077097505669,
      "seVolume" : 1
    },
    {
      "id" : "5EA4D403-5954-44D0-9121-A3A98F94E7BE",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_155_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。",
      "voiceCharacter" : "操夢",
      "duration" : 6.240861678004535,
      "title" : "シーン 155",
      "slideTitle" : "スライド #155",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.155.jpeg",
      "voiceDuration" : 6.240861678004535,
      "seVolume" : 1
    },
    {
      "id" : "DBD6BEDD-8E47-4C89-B519-1680447ABEE5",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_156_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。",
      "voiceCharacter" : "操夢",
      "duration" : 8.803900226757369,
      "title" : "シーン 156",
      "slideTitle" : "スライド #156",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.156.jpeg",
      "voiceDuration" : 8.803900226757369,
      "seVolume" : 1
    },
    {
      "id" : "BA3A09C1-5D28-430D-A8FB-93F0C4ECD1BF",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_157_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "教室の前の方（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg",
      "telop" : "僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…",
      "voiceCharacter" : "操夢",
      "duration" : 8.601723356009071,
      "title" : "シーン 157",
      "slideTitle" : "スライド #157",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
