      "bgmStartTimeOffset" : 0,
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_779_レミリア・スカーレット.wav",
