      "voiceDuration" : 6.5843310657596374,
      "telop" : "僕は、はっと気がつくと、元の位置に戻る。\nすると、二人は頬照った状態で固まっていた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
