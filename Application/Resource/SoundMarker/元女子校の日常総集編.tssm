      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_112_操夢.wav",
      "id" : "B754AF9C-F1AB-4883-85DA-931EEF440B26",
      "title" : "シーン 112",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #112",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.112.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.504988662131519,
      "telop" : "彼女はそう言うと、そのまま何かを呟きながら、去っていった。\n僕は、その場でしゃがみ込んで、休みを取る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ColabGPU_1791199901_67118.png",
      "bgmVolume" : 0.7,
      "duration" : 6.422380952380952,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_113_操夢.wav",
      "id" : "27B453F1-3D98-4F38-8E40-15E1968EEDF3",
      "title" : "シーン 113",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #113",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.113.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 6.422380952380952,
      "telop" : "すると、走ってた時には感じなかった痛みが僕を襲う。\nどうやら、無理強いをしていたようだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ColabGPU_1791199901_67118.png",
      "bgmVolume" : 0.7,
      "duration" : 8.239773242630385,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_114_操夢.wav",
      "id" : "5A898AEF-CCEB-417E-AE53-D4C71E65A7D0",
      "title" : "シーン 114",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #114",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.114.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.239773242630385,
      "telop" : "だが、彼女の言葉は事実を述べているだけなので、何もいえず、ただ一人、校庭で俯きながら、考え込む僕だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ColabGPU_1791199901_67118.png",
      "bgmVolume" : 0.7,
      "duration" : 5.761519274376417,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_115_操夢.wav",
      "id" : "55F1E220-E300-4645-AA89-5F3CB7832DB5",
      "title" : "シーン 115",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #115",
