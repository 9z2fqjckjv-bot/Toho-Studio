      "voiceDuration" : 4.197369614512471,
      "telop" : "「ふっ。」僕は、彼女のその仕草に思わず笑ってしまう。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
