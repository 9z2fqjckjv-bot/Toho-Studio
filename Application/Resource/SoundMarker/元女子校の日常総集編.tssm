      "characterName" : "操夢",
      "id" : "F30A7DF2-2C9C-40AF-ADAA-228107369D54",
      "title" : "シーン 349: 文が彼を抱え、彼の家に着くと…",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "表示時間:1.5秒",
