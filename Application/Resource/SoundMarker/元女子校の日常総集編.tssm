      "voiceDuration" : 8.218027210884355,
      "telop" : "僕は、その名刺を受け取ると、僕の名前を彼女に伝える。\nすると、彼女はどうやら、その名前を見知っているようだった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
