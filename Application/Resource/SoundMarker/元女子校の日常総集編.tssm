      "voiceDuration" : 6.164761904761905,
      "telop" : "すると、教室の扉が開き、彼女が僕の席にやってくる。\n「あの、どうしたんですか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
