      "voiceDuration" : 3.284331065759637,
      "telop" : "僕は、彼女にそう聞かれ、ふと二人の方を見る。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc230307_ショッピングモール.jpg",
      "bgmVolume" : 0.7,
      "duration" : 7.789773242630385,
      "bgmStartTimeOffset" : 0,
