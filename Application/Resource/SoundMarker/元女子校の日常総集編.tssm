      "seVolume" : 1,
      "voiceDuration" : 9.090748299319728,
      "telop" : "昨晩、彼女が図書館に行った後、私とお姉様は、もともとこの屋敷に住んでいた咲夜たちとの飲み会に向かった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
