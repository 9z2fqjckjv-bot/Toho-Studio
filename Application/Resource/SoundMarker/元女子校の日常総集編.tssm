      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_351_射命丸文.wav",
      "id" : "3C2688A2-2492-4B15-8353-415E6757D727",
      "title" : "シーン 351",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_EF7A",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #351",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.351.jpeg",
