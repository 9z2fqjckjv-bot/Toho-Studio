      "bgmVolume" : 0.7,
      "duration" : 6.690861678004535,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_131_操夢.wav",
      "id" : "8105D15B-D3B2-475E-8AEA-8FD8BB917F32",
      "title" : "シーン 131",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #131",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.131.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 6.690861678004535,
      "telop" : "彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
