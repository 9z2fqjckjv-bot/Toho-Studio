      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2030.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png",
      "voiceDuration" : 8.646303854875283,
      "telop" : "彼女はそういうと、僕が何かを言い出す前に、この瓶の中にある液体を飲ませてくる。そして僕は、意識が闇に落ちるのだった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "duration" : 7.75281179138322,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2031_操夢.wav",
      "id" : "D817F7F6-6AF9-4405-AA5F-7131DF6BCC6D",
      "title" : "シーン 2031",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2031",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2031.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.75281179138322,
      "telop" : "僕は、ふと気がつくと、そこは暗闇が広がる空間だった。\nすると、遠くで誰かが戦っている音が聞こえる。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "duration" : 7.596303854875283,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2032_操夢.wav",
      "id" : "7851DBBF-F1D1-4975-9C78-631939ABD3D1",
      "title" : "シーン 2032",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2032",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2032.jpeg",
      "voiceDuration" : 7.596303854875283,
      "telop" : "その音は、だんだんとこちらに近づいてきくる。\nそして、だんだんと暗闇に慣れて見えたのは、女性の姿だった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "duration" : 2.78,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2033_サブ.wav",
      "id" : "3797E1BA-A455-4DFE-A3EB-246E476001A2",
      "title" : "シーン 2033",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2033",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2033.jpeg",
      "voiceDuration" : 2.78,
      "telop" : "「今すぐ、私の背中に隠れなさい。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
