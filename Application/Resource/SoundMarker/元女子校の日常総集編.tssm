      "voiceDuration" : 6.174580498866213,
      "telop" : "「それじゃあ、後は、よろしくお願いします。」\n私はそういうと、彼をそっと下ろし、その場をさった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
