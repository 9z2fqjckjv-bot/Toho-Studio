      "seVolume" : 1,
      "voiceDuration" : 8.636507936507936,
      "telop" : "僕は昼食と歯磨きを済ますと、フランと僕の二人部屋で一人、ベッドに座り、休んでいた。すると部屋の扉がノックされる。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
