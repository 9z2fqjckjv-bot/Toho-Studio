      "voiceDuration" : 7.388684807256236,
      "seVolume" : 1
    },
    {
      "id" : "AB07BED0-C4CE-4196-945C-9757B2BE3DE6",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖笑い.png",
