      "id" : "5B6029DC-B86E-434F-B2BE-A0B8A46DBF26",
      "title" : "シーン 1952",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1952",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1952.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ不満.png",
      "voiceDuration" : 5.567392290249433,
      "telop" : "「何、それどういうこと？あんたは男と女、どっちなの？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "bgmVolume" : 0.7,
