      "voiceDuration" : 11.094489795918367,
      "telop" : "私はその内容に驚く。そして考えこむ。それから数分程度の間の後、告げる。「それでは、息子の今後については頼みます。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
