      "voiceDuration" : 2.0380725623582765,
      "seVolume" : 1
    },
    {
      "id" : "AF6BC388-7092-4F1B-AAFC-0C978823D4D5",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png",
