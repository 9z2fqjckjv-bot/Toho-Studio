      "telop" : "僕が、玄関に出ると、そこには知らない女性が立っていた。\n「あの、あなたは、誰ですか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
