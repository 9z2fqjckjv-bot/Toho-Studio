      "seVolume" : 1,
      "voiceDuration" : 7.722380952380952,
      "telop" : "今日は、彼女に今晩は病院で過ごすように言われ、フランたちのところには戻らず、そのまま明日登校することになった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
