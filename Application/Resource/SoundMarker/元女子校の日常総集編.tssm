      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "telop" : "僕はそれから、家に着くと、誰も家にいないことに気づく。\n「母さんと父さんはどうしたんだろう…。」",
      "voiceCharacter" : "操夢",
      "duration" : 6.216938775510204,
      "title" : "シーン 475",
      "slideTitle" : "スライド #475",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.475.jpeg",
      "voiceDuration" : 6.216938775510204,
