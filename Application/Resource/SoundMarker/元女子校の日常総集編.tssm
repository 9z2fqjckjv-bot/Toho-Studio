      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "僕は、それが血だとわかると、彼女から離れようとする。",
      "voiceCharacter" : "操夢",
      "duration" : 3.78,
      "title" : "シーン 2036",
      "slideTitle" : "スライド #2036",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2036.jpeg",
      "voiceDuration" : 3.78,
      "seVolume" : 1
    },
    {
      "id" : "EA9704E3-F1CF-44D0-85BA-0C68ED33E45B",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png",
