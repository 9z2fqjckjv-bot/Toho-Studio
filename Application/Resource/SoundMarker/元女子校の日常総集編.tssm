      "voiceDuration" : 6.116371882086168,
      "telop" : "「これ、魔理沙と名乗る女性から、預かった荷物です。」\n私はそう言うと、彼にそれを渡す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 6.6761904761904765,
      "bgmStartTimeOffset" : 0,
      "characterName" : "東風谷早苗",
      "voiceCharacter" : "東風谷早苗",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
