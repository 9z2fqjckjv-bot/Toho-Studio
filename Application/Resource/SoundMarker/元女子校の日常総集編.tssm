      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png",
      "voiceDuration" : 9.013242630385488,
      "telop" : "私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
