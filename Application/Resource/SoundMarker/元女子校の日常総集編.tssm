      "voiceDuration" : 8.222380952380952,
      "telop" : "僕は、何かをぶつぶついう二人を置いて、最初の注文をする。頼んだのは、ハンバークセットと鉄火丼定食だった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
