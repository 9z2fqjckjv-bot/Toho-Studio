      "backgroundName" : "ペーストされた画像.tiff",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "telop" : "僕はそう呟きながら、家の玄関を鍵を使って開ける。",
      "voiceCharacter" : "操夢",
      "duration" : 3.6626077097505667,
      "title" : "シーン 476",
      "slideTitle" : "スライド #476",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.476.jpeg",
      "voiceDuration" : 3.6626077097505667,
      "seVolume" : 1
    },
    {
      "id" : "89BCAAFB-022D-4014-98F6-E15ECEAAB4A6",
      "seStartTimeOffset" : 0,
