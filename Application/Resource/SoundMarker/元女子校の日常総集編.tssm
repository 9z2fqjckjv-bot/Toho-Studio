      "voiceDuration" : 6.423469387755102,
      "telop" : "だが、互いに何も言わず、気まずい空気になってしまう。\n僕は仕方なく、アリスの方を向く。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc230307_ショッピングモール.jpg",
      "bgmVolume" : 0.7,
      "duration" : 3.684331065759637,
