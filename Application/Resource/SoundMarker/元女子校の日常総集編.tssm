      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png",
      "voiceDuration" : 8.45063492063492,
      "telop" : "僕はそう言うと、バックからあるものを2つ取り出す。それは、黒色のアイマスクだった。そして、それを一つ彼女につける。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image65.jpeg",
