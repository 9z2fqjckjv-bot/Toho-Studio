      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.973.jpeg",
      "voiceDuration" : 5.033242630385487,
      "seVolume" : 1
    },
    {
