      "voiceDuration" : 8.516938775510203,
      "telop" : "「ふっ…」僕は、彼女の言動に思わず、そう笑い出してしまう。\n「あれ…酔ってないつもりだけど、酒が回ってきたのかな…」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
