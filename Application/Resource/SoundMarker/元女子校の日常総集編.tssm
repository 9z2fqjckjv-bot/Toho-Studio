      "seVolume" : 1,
      "voiceDuration" : 7.2365079365079366,
      "telop" : "僕は、そのラベルを剥がそうと、爪を立てるが、がっしりと拍子にラベルがしがみついていて、剥がすことができない。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
