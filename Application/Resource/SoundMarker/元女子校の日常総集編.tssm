      "voiceDuration" : 7.789773242630385,
      "telop" : "そこには、なぜか、頬照りながら困るこいしと、ため息をつくさとりの姿があった。「二人とも、どうしたんですか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc230307_ショッピングモール.jpg",
      "bgmVolume" : 0.7,
