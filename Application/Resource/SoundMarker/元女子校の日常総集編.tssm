      "voiceDuration" : 8.416938775510204,
      "telop" : "「でも僕は…」僕はそう言いかけ、ハッとする。なぜなら、高校生の時なら、真っ先にそうなった言い訳を言っていたからだ。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
