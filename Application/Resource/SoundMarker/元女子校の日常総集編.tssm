      "seVolume" : 1,
      "voiceDuration" : 7.2680272108843536,
      "telop" : "そして、僕は本の表紙にある著者名を見る。\nよく見ると、それは元の名前の上に、ラベルが貼ってあった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
