      "voiceDuration" : 8.436507936507937,
      "telop" : "僕はそう言われ、どう返すべきかわからず、黙ってしまう…。\nすると、彼女がある女子を呼び、その女子は僕の反対側に立つ。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "2026-10-04_16-42.png",
