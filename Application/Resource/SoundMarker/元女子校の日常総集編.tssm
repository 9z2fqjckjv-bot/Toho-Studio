      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png",
      "voiceDuration" : 7.783083900226758,
      "telop" : "「これは、遠足ノートです。あなたたちの班は、遠足にかかる費用が、全額学校負担になってますので、確認してください。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
