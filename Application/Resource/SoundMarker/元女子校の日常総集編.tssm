      "voiceDuration" : 3.9237414965986392,
      "telop" : "「えへへ、私、お兄ちゃんと抱き合って寝れた…。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
