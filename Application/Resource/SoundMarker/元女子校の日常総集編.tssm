      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_854_操夢.wav",
      "id" : "CE10E452-0F0E-4ECA-A29D-DF8A423A8EA6",
      "title" : "シーン 854",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #854",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.854.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png",
      "voiceDuration" : 5.308253968253968,
      "telop" : "「全国財閥高統一模試ですよ。」\n僕はそういうと、勉強を再開した。\n元女子校の日常\n〜彼が図書館で勉強していると、フランが話しかけてきて…〜",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
