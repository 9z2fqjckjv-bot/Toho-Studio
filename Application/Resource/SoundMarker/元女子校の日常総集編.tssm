      "telop" : "その内容を要約すると、今現在、このお店で一定金額以上の利用をすると、金額に応じたくじ引きができるとあった。",
      "voiceCharacter" : "操夢",
      "duration" : 8.181065759637189,
      "title" : "シーン 1175",
      "slideTitle" : "スライド #1175",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1175.jpeg",
      "voiceDuration" : 8.181065759637189,
      "seVolume" : 1
    },
    {
      "id" : "8AFB8C9E-CCCE-4797-B62C-56B997B16269",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1176_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg",
