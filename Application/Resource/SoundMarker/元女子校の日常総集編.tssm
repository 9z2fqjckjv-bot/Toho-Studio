      "seVolume" : 1,
      "voiceDuration" : 7.0082312925170065,
      "telop" : "私は、彼が立ち去ると、「あの声は、いったい誰の声だったんだろう…」っと、そう呟きながら、家に帰るのだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
