      "seVolume" : 1,
      "voiceDuration" : 10.068231292517007,
      "telop" : "私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "一人部屋３（夜・照明OFF）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 9.304489795918368,
      "bgmStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（夜・照明OFF）.jpg",
