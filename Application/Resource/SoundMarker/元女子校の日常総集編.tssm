      "seVolume" : 1,
      "voiceDuration" : 8.181065759637189,
      "telop" : "その内容を要約すると、今現在、このお店で一定金額以上の利用をすると、金額に応じたくじ引きができるとあった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.446303854875284,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1176_操夢.wav",
