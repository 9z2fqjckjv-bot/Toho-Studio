      "voiceDuration" : 2.589591836734694,
      "telop" : "「ほら、こいし、私と一緒に家に戻りましょ。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
