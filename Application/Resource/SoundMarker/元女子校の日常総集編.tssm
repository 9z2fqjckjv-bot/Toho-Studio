      "voiceDuration" : 6.943038548752835,
      "telop" : "「いいですよ。ちょっと待ってください。」僕はそう言い、冷蔵庫にしまったワインを取り出してグラスに注ぐ。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
