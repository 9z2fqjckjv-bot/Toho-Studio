      "title" : "シーン 2151",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2151",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2151.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り不満.png",
      "voiceDuration" : 10.031473922902494,
      "telop" : "「はぁ？何言ってるの、あんた。言っておくけど、私は二人の下のお世話なんてしないから、あんた一人でしてね。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "bgmVolume" : 0.7,
      "duration" : 7.373469387755102,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
