      "title" : "シーン 1786",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1786",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1786.jpeg",
