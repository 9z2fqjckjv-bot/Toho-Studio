      "bgmStartTimeOffset" : 0,
      "characterName" : "隠岐奈",
      "voiceCharacter" : "隠岐奈",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1587_隠岐奈.wav",
      "id" : "D7D49F61-E3AF-467D-964E-3437105F7C7D",
      "title" : "シーン 1587",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_85A1",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1587",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1587.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 4.893219954648526,
      "telop" : "だが、これから始まるであろう、\nその戦いに不安を覚える、私だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
