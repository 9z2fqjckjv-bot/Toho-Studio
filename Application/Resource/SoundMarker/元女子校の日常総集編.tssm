      "telop" : "「私がフランにいう資格は、ないかもしれないけど、少しばかし、アルコールの自己管理くらい、出来たらどうかしら？」",
      "voiceCharacter" : "レミリア・スカーレット",
      "duration" : 7.073401360544218,
      "title" : "シーン 836",
      "slideTitle" : "スライド #836",
      "characterName" : "レミリア・スカーレット",
      "audioTrack" : "track_voice_char_30CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.836.jpeg",
      "voiceDuration" : 7.073401360544218,
      "seVolume" : 1
    },
    {
      "id" : "EFB85796-3D99-43AE-BAC5-9FCF5A3BDFE7",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（弱る）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_837_フランドール・スカーレット.wav",
