      "voiceDuration" : 7.110430839002268,
      "telop" : "僕たちは、それから観覧車に乗るまでの空気感が一気になくなり、ただ静けさと気まずさだけに包まれていた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc230674_観覧車の中（夕方）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.169115646258504,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
