      "slideTitle" : "スライド #1519",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1519.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.646303854875283,
      "telop" : "そして、彼女をそっと抱え上げると、浴室の段差に気をつけながら、中に入っていき、そのまま彼女の入浴を補助するのだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image65.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.35390022675737,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1520_操夢.wav",
      "id" : "6124AA05-191F-4738-99DB-9014EC6E8510",
      "title" : "シーン 1520",
      "voice2StartTimeOffset" : 0,
