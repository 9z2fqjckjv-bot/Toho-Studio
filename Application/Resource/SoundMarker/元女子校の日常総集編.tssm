      "voiceDuration" : 7.740861678004535,
      "telop" : "だが、立とうとした習慣に大きな揺れがきて、僕は思わず、前のめりに倒れ、フランと間に手をつくように倒れ込む。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
