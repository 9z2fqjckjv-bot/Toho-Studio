      "seVolume" : 1
    },
    {
      "id" : "594ABC9E-0C0D-4951-A386-8F01FE189549",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1569_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "私が、昨日、残業で職務をこなしていると、一本の電話が入る。\nそれを知らせにきた、萃香はいかにも面倒そうな顔をしていた。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 9.184263038548753,
      "title" : "シーン 1569",
      "slideTitle" : "スライド #1569",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1569.jpeg",
      "voiceDuration" : 9.184263038548753,
      "seVolume" : 1
    },
    {
      "id" : "90B4A83E-BC5A-4B85-A3F1-5BBA05613E3F",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png",
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "私は、彼女の言葉を受けると、内線を繋ぎ、相手の声を聞く。\nその声は、中等部の女子生徒、古明地こいしの声だった。",
      "duration" : 9.20968253968254,
      "title" : "シーン 1570",
      "slideTitle" : "スライド #1570",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1570.jpeg",
      "seVolume" : 1
    },
    {
      "id" : "527D44D3-2525-4DDA-93A2-E0448EFA5A00",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1571_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "私は、電話越しに彼女が起こっていることを感じ、なぜ起こっているのかと聞く。すると例の彼が、彼女の裸を見たと言う。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 8.503832199546485,
      "title" : "シーン 1571",
      "slideTitle" : "スライド #1571",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1571.jpeg",
      "voiceDuration" : 8.503832199546485,
      "seVolume" : 1
    },
    {
      "id" : "F0D08C46-78CC-48CD-8AE3-72B2D69D90A4",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1572_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "私と萃香は驚きながらも、相手の話を聞く。すると、彼女はある衝撃的な発言を言ってきた。私は、その内容に困惑する。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 9.934784580498865,
      "title" : "シーン 1572",
      "slideTitle" : "スライド #1572",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1572.jpeg",
      "voiceDuration" : 9.934784580498865,
      "seVolume" : 1
    },
    {
      "id" : "052D58D9-B7F0-4D91-90AF-04CEBB9D09A2",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1573_隠岐奈.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-11-10_17-38.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png",
      "telop" : "だが、すぐに永琳からの電話も飛んできて、\n私はこいしの電話を保留にし、そちらに切り替える。",
      "voiceCharacter" : "隠岐奈",
      "duration" : 6.302902494331065,
      "title" : "シーン 1573",
      "slideTitle" : "スライド #1573",
      "characterName" : "隠岐奈",
      "audioTrack" : "track_voice_char_85A1",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1573.jpeg",
      "voiceDuration" : 6.302902494331065,
      "seVolume" : 1
    },
    {
      "id" : "53073FE1-8483-42E3-9E89-6F4C16721FCF",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1574_隠岐奈.wav",
