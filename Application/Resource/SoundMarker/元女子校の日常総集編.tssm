      "id" : "70AF516D-CEE2-4217-8282-66A054EFC663",
      "title" : "シーン 1142",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1142",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1142.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲れた顔.png",
      "voiceDuration" : 10.585736961451246,
      "telop" : "「本当に、大丈夫なの？何か、あるなら私に相談してね…」\n私は、彼にそう言うと、病室を去り、家に帰っていった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "bgmVolume" : 0.7,
      "duration" : 8.75172335600907,
      "bgmStartTimeOffset" : 0,
