      "voiceDuration" : 4.926507936507937,
      "telop" : "「もういいわ…、この旅行が終わったら、\nあんたを奪い取るんだから…。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
