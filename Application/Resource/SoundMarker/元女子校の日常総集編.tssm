      "seVolume" : 1,
      "voiceDuration" : 7.839478458049887,
      "telop" : "その言葉に皆は、謝り、少しばかし空気が暗くなりかけてたところに、赤ワインとお通しが出てくる。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
