      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.884.jpeg",
      "voiceDuration" : 8.425646258503402,
      "seVolume" : 1
    },
    {
