      "seVolume" : 1,
      "voiceDuration" : 8.909342403628118,
      "telop" : "僕は、届けられた弁当が入った包みを開く。すると、弁当箱と共に、メモ書きが載せてあった。『何かあったら言ってね…』",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
