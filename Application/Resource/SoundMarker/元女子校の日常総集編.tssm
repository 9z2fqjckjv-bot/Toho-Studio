      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "animationNote" : "表示時間:1.5秒",
      "telop" : "彼の目が覚めると…",
      "duration" : 1.5,
      "title" : "シーン 355: 彼の目が覚めると…",
      "slideTitle" : "スライド #355",
      "characterName" : "操夢",
