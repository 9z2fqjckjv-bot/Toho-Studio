      "seVolume" : 1,
      "voiceDuration" : 8.25172335600907,
      "telop" : "僕は、フランに連れられて、とある山間のキャンプ場に来ていた。そして、僕は、彼女にキャンプ用品を持ってきたかを聞く。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
