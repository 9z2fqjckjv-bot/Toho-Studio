      "voiceDuration" : 3.4027210884353742,
      "seVolume" : 1
    },
    {
      "id" : "39E91895-36C3-40CC-B6D7-F8C6C071CFCA",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1283_操夢.wav",
