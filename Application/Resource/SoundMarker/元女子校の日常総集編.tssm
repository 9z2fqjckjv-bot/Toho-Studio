      "voiceDuration" : 3.684331065759637,
      "telop" : "「いいですよ。ただ、昼食は一緒に取りませんか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
