      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "id" : "7A1862A7-F2D7-4C0C-B58B-2FEF5CD30908",
      "title" : "シーン 133: 附属病院のある診察室では…",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "表示時間:1.5秒",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #133",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.133.jpeg",
      "seVolume" : 1,
      "telop" : "附属病院のある診察室では…",
      "animationDuration" : 1.5,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
