      "voiceDuration" : 3.9973696145124715,
      "telop" : "僕は、彼女にそう言われ、見よう見まねで挨拶とお辞儀をする。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
