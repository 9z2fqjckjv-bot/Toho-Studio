      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恥ずかしい顔.png",
      "voiceDuration" : 6.445736961451247,
      "telop" : "「自分の部屋にこもって、少し考えてきてもいい？」\n私は、そう彼女に聞く。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
