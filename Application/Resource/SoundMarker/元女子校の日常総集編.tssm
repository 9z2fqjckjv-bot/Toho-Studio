      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc107556_紅魔的館内.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "telop" : "私はそこで、「しまった」とつぶやく。だが、\nそう呟いている間にも、フランはこちらに攻撃をしてくる。",
      "voiceCharacter" : "レミリア・スカーレット",
      "duration" : 6.7588208616780046,
      "title" : "シーン 838",
      "slideTitle" : "スライド #838",
      "characterName" : "レミリア・スカーレット",
      "audioTrack" : "track_voice_char_30CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.838.jpeg",
      "voiceDuration" : 6.7588208616780046,
      "seVolume" : 1
    },
    {
      "id" : "1B8F260C-EF1F-43FA-8D93-0ED207AD47D0",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_839_レミリア・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc107556_紅魔的館内.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "telop" : "私は、彼女の攻撃を避けながら、あるものを探す。\nすると、ハッと思い出し、その場所に向かい、疾走する。",
      "voiceCharacter" : "レミリア・スカーレット",
      "duration" : 7.6754875283446715,
