      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "bgmVolume" : 0.7,
      "duration" : 4.321292517006802,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_132_操夢.wav",
      "id" : "581B2B43-14BE-4D9A-A751-4AA28C55FA14",
      "title" : "シーン 132",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #132",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.132.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 4.321292517006802,
      "telop" : "僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
