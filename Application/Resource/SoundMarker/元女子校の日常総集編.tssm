      "seVolume" : 1,
      "voiceDuration" : 8.037596371882087,
      "telop" : "それは、ちょくちょく語尾に「だぜ。」という特徴的な口癖が書かれていることだった。そこで、僕はふと思い出す。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "bgmVolume" : 0.7,
