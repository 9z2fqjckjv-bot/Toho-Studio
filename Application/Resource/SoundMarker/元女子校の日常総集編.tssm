      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/泣き笑い.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2117_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "ペーストされた画像.tiff",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "telop" : "僕が校門を出ると、そこには頬が赤らみ、涙を見せるフランの姿があった。「なんで、泣いているんですか。」",
      "voiceCharacter" : "操夢",
      "duration" : 7.307165532879819,
      "title" : "シーン 2117",
      "slideTitle" : "スライド #2117",
      "characterName" : "操夢",
