      "title" : "シーン 1176",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1176",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1176.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.446303854875284,
      "telop" : "そして、あたりの中に、旅行券が含まれていた。くじ引きは、今日までで、行き先は…僕が、見知っている場所だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.286507936507936,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg",
