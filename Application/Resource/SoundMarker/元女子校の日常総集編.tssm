      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1918_古明地さとり.wav",
      "id" : "0020CB99-BD51-4665-8DEB-40E8519F5829",
      "title" : "シーン 1918",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_C52B",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1918",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1918.jpeg",
