      "duration" : 8.063242630385487,
      "title" : "シーン 1485",
      "slideTitle" : "スライド #1485",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1485.jpeg",
      "voiceDuration" : 8.063242630385487,
      "seVolume" : 1
    },
