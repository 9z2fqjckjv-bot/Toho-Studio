      "title" : "シーン 2152",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2152",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2152.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り不満.png",
      "voiceDuration" : 7.373469387755102,
      "telop" : "「もしかして、こいし…、やけ酒してた？」\n僕は、彼女が普段呼びない呼び方で、僕を呼んだのでそう聞く。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "bgmVolume" : 0.7,
      "duration" : 5.28562358276644,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
