      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg",
