      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1702_操夢.wav",
      "id" : "AB1F6929-7F12-48B1-87FA-102503058085",
      "title" : "シーン 1702",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1702",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1702.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.193038548752835,
      "telop" : "それも、ご令嬢は以前から、次期グループの長に適した婿養子を取ることが決まっていて、その候補の名前は不明となっていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image76.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 9.236507936507936,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1703_操夢.wav",
      "id" : "311AE120-9D9E-46F2-8348-8B892D5D1116",
      "title" : "シーン 1703",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1703",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1703.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 9.236507936507936,
      "telop" : "だが、その発表では、目的人物が決まったとされ、そして、紅魔建設や学園で同タイミングでの発表から、憶測がされていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image76.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.49845804988662,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1704_操夢.wav",
      "id" : "7A1A9DCD-60C7-43C9-9EEE-3EB37DF422E4",
      "title" : "シーン 1704",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1704",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1704.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.49845804988662,
      "telop" : "だが、そのテレビの報道を見る限り、あくまで噂程度だった。\nそれでも、僕はなんとなく、自分の将来を不安に感じた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image76.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.158253968253968,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1705_操夢.wav",
      "id" : "D4D33923-7262-47AE-949B-7DE209CD5A31",
      "title" : "シーン 1705",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1705",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1705.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.158253968253968,
      "telop" : "すると、報道の内容が、グールプの今までの流れとこいしやさとりが小さかった頃のことがピックアップされていく。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image76.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.585419501133787,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1706_操夢.wav",
      "id" : "066BCF35-DF5F-4AF1-BD6D-C98CAAE23D93",
      "title" : "シーン 1706",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1706",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1706.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.585419501133787,
      "telop" : "僕は、その報道を集中して見てたからか、アリスが肩を叩くまで、彼女が入浴を終えたことに気が付かなかった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "duration" : 5,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "id" : "CE6EBF43-087E-4125-9748-A97EA0AA7757",
      "title" : "シーン 1707: 東風谷早苗（主人公がいるクラスの担任）",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "5秒",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1707",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1707.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png",
      "seVolume" : 1,
      "telop" : "東風谷早苗（主人公がいるクラスの担任）",
      "animationDuration" : 5,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.771292517006803,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1708_操夢.wav",
      "id" : "A728DE65-43FD-42C4-9EBF-5311F9B528F9",
      "title" : "シーン 1708",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1708",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1708.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り笑い.png",
      "voiceDuration" : 7.771292517006803,
      "telop" : "僕が入浴を終えると、僕とアリスは、寝るための布団を敷き談笑をしていた。すると、いきなり部屋の扉が開く。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.098458049886622,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1709_操夢.wav",
      "id" : "817E5E80-C6AB-44F0-BA71-622C9F2872D0",
      "title" : "シーン 1709",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1709",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1709.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png",
      "voiceDuration" : 8.098458049886622,
      "telop" : "そして入ってきたのは、暗い影と涙があるこいしだった。\n彼女は入ってくるや否や、ドアを急いで閉めて、鍵をかける。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.43,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1710_操夢.wav",
      "id" : "457490AC-BEA6-441B-B42A-7C2C51F1CDA5",
      "title" : "シーン 1710",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1710",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1710.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png",
      "voiceDuration" : 7.43,
      "telop" : "すると、廊下の方からドンドンとドアを叩く音がする。\nそして、こいしは僕に抱きつき、泣きながら言葉を出す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 4.589501133786848,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1711_古明地こいし.wav",
      "id" : "CEFD0B22-F189-4E4A-A195-073BAA31F7C4",
      "title" : "シーン 1711",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1711",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1711.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 4.589501133786848,
      "telop" : "「お兄ちゃん…、助けて…、お姉ちゃんが…、お姉ちゃんが…。」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.843038548752835,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1712_操夢.wav",
      "id" : "FC0842C2-E524-4FC0-B2B3-A3381FCBF61A",
      "title" : "シーン 1712",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1712",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1712.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.843038548752835,
      "telop" : "彼女が小さくそう呟きがなら、ひたすら泣き、僕は事態を把握する。廊下の人物は、扉を叩く代わりにをこじ開けようとする。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.147369614512471,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1713_操夢.wav",
      "id" : "25BE5951-9214-4161-837B-3AFAD523677A",
      "title" : "シーン 1713",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1713",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1713.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.147369614512471,
      "telop" : "僕は、ここはこいしの頭をそっと撫でて、少しだけ落ち着かせると、部屋の電話を取り、ロビーに電話をかける。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.193038548752835,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1714_操夢.wav",
      "id" : "40B149F6-7153-477D-AB46-26981CABAB3E",
      "title" : "シーン 1714",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1714",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1714.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.193038548752835,
      "telop" : "それから、さらに時間が経ち、こいしがそのまま泣き疲れて、僕の腕の中で眠り出した頃には、廊下は静かになっていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.362607709750567,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1715_操夢.wav",
      "id" : "A2D14780-3479-418A-870E-EAC28B460E33",
      "title" : "シーン 1715",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1715",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1715.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.362607709750567,
      "telop" : "僕は、こいしをベッドで寝かせ、アリスもいつの間にか就寝していることを知ると、部屋の電話である場所に電話をかける。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 1.9942403628117913,
      "bgmStartTimeOffset" : 0,
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1716_レミリア・スカーレット.wav",
      "id" : "CB30F088-ECE9-4D47-BCC6-AA6FBEBE92FF",
      "title" : "シーン 1716",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_30CA",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1716",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1716.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 1.9942403628117913,
      "telop" : "「もしもし、どちら様ですか？」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image77.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.6289115646258505,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1717_操夢.wav",
      "id" : "603BBEA4-6C11-44A2-806F-01E4E9F36943",
      "title" : "シーン 1717",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1717",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1717.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.6289115646258505,
      "telop" : "「レミリアさん…、僕からのお願いを聞いてくれませんか…。」\n僕はそう言い始め、今までの出来事をそのまま伝えていった。",
