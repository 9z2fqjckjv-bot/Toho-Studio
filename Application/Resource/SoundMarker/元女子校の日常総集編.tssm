      "voiceDuration" : 5.91,
      "telop" : "「えっ、こいし。本気でくじ引きをするの？紅夢さんも、\n無理にお金を出そうとしなくて、大丈夫ですよ。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
