      "seVolume" : 1,
      "voiceDuration" : 9.112403628117914,
      "telop" : "これは、注射器で、その中には、ある人物の血液が入っていた。\nその人物は、今、彼が元いた家に住んでいる女性のものだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
