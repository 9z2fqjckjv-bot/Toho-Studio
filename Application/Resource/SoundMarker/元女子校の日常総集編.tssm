      "voiceCharacter" : "先代の巫女",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg",
