      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ不満.png",
      "voiceDuration" : 7.714761904761905,
      "telop" : "「性別の判断基準は分かりませんが、僕は小さい頃から男として今まで、生きてきましたよ、記憶の限りでは。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
