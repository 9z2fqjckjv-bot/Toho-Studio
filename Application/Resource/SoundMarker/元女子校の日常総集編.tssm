      "voiceDuration" : 6.29390022675737,
      "telop" : "「ねぇ、紅夢…。あれを見て…」\n私はそう言いながら、あるものを指差す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg",
      "bgmVolume" : 0.7,
