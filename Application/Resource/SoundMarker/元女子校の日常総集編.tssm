      "title" : "シーン 2150",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2150",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2150.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png",
      "voiceDuration" : 6.675646258503401,
      "telop" : "「こいし…、ちょっと手伝って、酔いが回って、アレを漏らしちゃったお二人さんを、浴室に連行するから。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "bgmVolume" : 0.7,
      "duration" : 10.031473922902494,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg",
