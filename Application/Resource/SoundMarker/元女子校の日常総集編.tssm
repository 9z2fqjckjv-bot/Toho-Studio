      "id" : "B1D0DDAD-BD11-485A-9F72-3F6C6A6963A4",
      "title" : "シーン 355: 彼の目が覚めると…",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "表示時間:1.5秒",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #355",
