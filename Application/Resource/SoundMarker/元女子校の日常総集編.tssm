      "voiceDuration" : 5.222380952380952,
      "telop" : "「えっ？」僕は、そう返すと、\n彼女は黙って、僕をベッドに押し倒す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
