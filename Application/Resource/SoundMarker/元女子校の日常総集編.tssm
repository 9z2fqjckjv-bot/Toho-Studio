      "slideTitle" : "スライド #511",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.511.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 4.926734693877551,
      "telop" : "彼女はそういうと、去っていった。\n僕は、ひとまず、リビングに戻る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 6.888684807256236,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_512_操夢.wav",
      "id" : "AB5C887E-7E9A-4BE5-9B0D-E9D882FC47F6",
      "title" : "シーン 512",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #512",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.512.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 6.888684807256236,
      "telop" : "そして、食卓に座るとテレビをつける。\n僕は、その映像を見ているうちに、全身に痛みが走る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.493038548752834,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_513_サブ.wav",
      "id" : "A56D7F1C-22F8-4149-8E77-F35183D8852A",
      "title" : "シーン 513",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #513",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.513.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.493038548752834,
      "telop" : "そこには、ある女性が、街中にビームを撃ちまくる映像と、彼女との戦いに負けたのか、警察署で休む母が映っていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.02673469387755,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_514_サブ.wav",
      "id" : "11D31D04-B758-4BE8-9C48-359B33C3E62C",
      "title" : "シーン 514",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #514",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.514.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.02673469387755,
      "telop" : "今、テレビで流れている映像を見ると、父とその女性が戦っている様子が流れていたが、父はビームを避けているだけだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 7.290861678004535,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_515_サブ.wav",
      "id" : "4443ACA0-6203-4CE4-9C19-B2BB530EF50C",
      "title" : "シーン 515",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #515",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.515.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.290861678004535,
      "telop" : "きっと彼が、この映像をしっかりと目に焼き付ければ、冷静に考えて、母が映っていた警察署に向かうだろう。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.121292517006802,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
