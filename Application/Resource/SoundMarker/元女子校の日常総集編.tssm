      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1440_フランドール・スカーレット.wav",
