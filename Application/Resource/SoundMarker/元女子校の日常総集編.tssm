      "title" : "シーン 59",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1B13",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #59",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.059.jpeg",
