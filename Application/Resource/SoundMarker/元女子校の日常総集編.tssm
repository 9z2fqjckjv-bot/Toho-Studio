      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc107556_紅魔的館内.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "telop" : "私は、お姉様の指摘通りなので、頭を抱えて考える。だが、だんだんとオーバヒートしているような感覚がしてくる。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 9.454489795918366,
      "title" : "シーン 837",
      "slideTitle" : "スライド #837",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.837.jpeg",
      "voiceDuration" : 9.454489795918366,
      "seVolume" : 1
    },
    {
      "id" : "94130A7A-F708-4648-9988-7B4A3AC2CE44",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_838_レミリア・スカーレット.wav",
