      "bgmStartTimeOffset" : 0,
      "characterName" : "隠岐奈",
      "voiceCharacter" : "隠岐奈",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1586_隠岐奈.wav",
      "id" : "D772C87D-8E3B-41C3-85C6-A21D9A40A44C",
      "title" : "シーン 1586",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_85A1",
