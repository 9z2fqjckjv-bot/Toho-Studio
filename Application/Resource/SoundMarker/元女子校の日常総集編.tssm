      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "telop" : "そして、自室に戻ってくると、少し目に見えぬ埃が溜まっていたので、軽くを掃除機をかける。そして、ふと両親の部屋に向かう。",
      "voiceCharacter" : "操夢",
      "duration" : 8.919115646258504,
      "title" : "シーン 386",
      "slideTitle" : "スライド #386",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
