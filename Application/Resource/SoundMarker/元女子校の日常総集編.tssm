      "title" : "シーン 2153",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2153",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2153.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png",
      "voiceDuration" : 5.28562358276644,
      "telop" : "「くっ…、一人で寂しくて、お酒で濁してたのよ、私…」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
