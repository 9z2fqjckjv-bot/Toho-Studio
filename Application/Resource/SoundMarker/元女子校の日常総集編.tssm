      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "telop" : "「ふっ…」僕は、それを見て思わずそう吹いてしまう。確かに、この人の言うとおり、僕の取り柄は勉学だけだからだ。",
      "voiceCharacter" : "操夢",
      "duration" : 8.012607709750567,
      "title" : "シーン 359",
      "slideTitle" : "スライド #359",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.359.jpeg",
      "voiceDuration" : 8.012607709750567,
      "seVolume" : 1
    },
