      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_389_操夢.wav",
      "id" : "1DBB0DEA-248E-4E35-A622-A23FC9A33B3F",
      "title" : "シーン 389",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #389",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.389.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.49845804988662,
      "telop" : "そして、そこに冷蔵庫がスカスカなのを記して、机に残すと、僕は、自室で身なりを整えてから、学校に向かうのだった。",
      "voiceStartTimeOffset" : 0,
