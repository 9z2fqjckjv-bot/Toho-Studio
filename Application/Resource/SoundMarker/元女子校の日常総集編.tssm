      "bgmStartTimeOffset" : 0,
      "backgroundName" : "96ADD4DE-3714-521D-BE06-732A989A7431.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg",
      "telop" : "私は、この取調室でふと今朝のことを思い出していた。",
      "voiceCharacter" : "博麗霊夢",
      "duration" : 4.366984126984127,
      "title" : "シーン 619",
      "slideTitle" : "スライド #619",
      "characterName" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.619.jpeg",
      "voiceDuration" : 4.366984126984127,
      "seVolume" : 1
    },
    {
      "id" : "F8E0DDA9-8B2E-4E46-AB75-E516DBAE9B7D",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_620_博麗霊夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg",
      "telop" : "私は、家を出てから、魔理沙の家に着くと、彼女は、ため息をつきながら、どこか暗く感じる表情をしていた。",
      "voiceCharacter" : "博麗霊夢",
      "duration" : 8.756984126984127,
      "title" : "シーン 620",
      "slideTitle" : "スライド #620",
      "characterName" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.620.jpeg",
      "voiceDuration" : 8.756984126984127,
      "seVolume" : 1
    },
    {
      "id" : "308AB73D-35E7-46BF-A09D-C9B64FBFDA77",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_621_博麗霊夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg",
      "telop" : "私が、彼女にそんな表情をしている理由を問うと、昨晩の就寝時に、やけ酒をしていると、ふと不思議な声が聞こえたという。",
      "voiceCharacter" : "博麗霊夢",
      "duration" : 9.694489795918367,
      "title" : "シーン 621",
      "slideTitle" : "スライド #621",
      "characterName" : "博麗霊夢",
      "audioTrack" : "track_voice_reimu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.621.jpeg",
      "voiceDuration" : 9.694489795918367,
      "seVolume" : 1
    },
    {
      "id" : "886B8F27-6869-479D-92B3-D305347B7A36",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_622_博麗霊夢.wav",
