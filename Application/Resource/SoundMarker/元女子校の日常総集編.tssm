      "seVolume" : 1,
      "voiceDuration" : 8.543650793650794,
      "telop" : "フランが、そう言って去ると、私は「はぁ」とため息をつく。\nそして、同時に、これがきっかけで二人が…と考えるのだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.34954648526077,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_539_サブ.wav",
      "id" : "E66496A8-114D-4B8A-8B22-94A10D3DA0F1",
      "title" : "シーン 539",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #539",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.539.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霧雨魔理沙7.jpg",
      "voiceDuration" : 8.34954648526077,
      "telop" : "私が、テレビに映っていた場所に来ると、そこでは、彼女が箒に跨って空を飛び回りながら、ビームを周囲に放っていた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 6.050634920634921,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_540_サブ.wav",
      "id" : "04136A1D-BC60-41E3-8BDD-7FC51E8DF227",
      "title" : "シーン 540",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #540",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.540.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（困る）.png",
      "voiceDuration" : 6.050634920634921,
      "telop" : "そして、ふと周りを見ると、父が困惑しながら、\nひたすらにそのビームを避けている様子だった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.961519274376418,
      "bgmStartTimeOffset" : 0,
      "characterName" : "サブ",
      "voiceCharacter" : "サブ",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_541_サブ.wav",
      "id" : "09614E17-310F-4C34-9328-69E2EA8A474C",
      "title" : "シーン 541",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_CC3E",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #541",
