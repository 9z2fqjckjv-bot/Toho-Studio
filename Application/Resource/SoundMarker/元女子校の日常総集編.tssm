      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #286",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.286.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.534331065759638,
      "telop" : "僕は、その紙を見る。そこには、寄り道がてら、母から僕の弁当を受け取って、事務室に届けたことともう一つあった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 7.522380952380952,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_287_操夢.wav",
      "id" : "25F2F16E-F422-4481-9341-9FAE7BFBC3EE",
      "title" : "シーン 287",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #287",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.287.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.522380952380952,
      "telop" : "それは、この小瓶には試験薬が入っていて、それを飲めば、きっと僕の役に立つから飲んでみなさいと言う文章だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 7.490861678004535,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_288_操夢.wav",
      "id" : "819B012D-34D5-4F73-B53B-D12C731A9BD4",
      "title" : "シーン 288",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #288",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.288.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.490861678004535,
      "telop" : "僕は、その小瓶を手に取り眺める。そこには水に近い色合いの液体と、牛乳の色をした液体が入っていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.545215419501133,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_289_操夢.wav",
      "id" : "521697A4-E9AA-41AF-9E5C-2C49E04588E6",
      "title" : "シーン 289",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #289",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.289.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.545215419501133,
      "telop" : "僕はとりあえず、割れないように小瓶をどかすと、弁当を食べる。\nそして、弁当を数十分で食べ切ると、再び瓶を手に取る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
