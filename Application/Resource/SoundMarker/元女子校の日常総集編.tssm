      "voiceDuration" : 8.756984126984127,
      "telop" : "私は、家を出てから、魔理沙の家に着くと、彼女は、ため息をつきながら、どこか暗く感じる表情をしていた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc238754_一人部屋（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 9.694489795918367,
      "bgmStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg",
