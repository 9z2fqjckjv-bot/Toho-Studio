      "seVolume" : 1,
      "voiceDuration" : 8.60063492063492,
      "telop" : "僕は、朝がやってくると、病室で朝食をとり、そのまま教室に入った。そして、席に着き、身の回りを整える。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
