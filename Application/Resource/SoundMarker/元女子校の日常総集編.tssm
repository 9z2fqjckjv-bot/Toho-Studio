      "voiceDuration" : 4.439773242630386,
      "seVolume" : 1
    },
    {
      "id" : "739FEFA5-A7F5-4655-B40C-CEBD5295083E",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2116_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "ペーストされた画像.tiff",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "telop" : "それから卒業式を終えた僕たちは、教室に戻る。そして僕は、担任からの一言と終礼が終わると、校門に向かう。",
