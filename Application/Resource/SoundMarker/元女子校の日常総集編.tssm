      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png",
      "voiceDuration" : 9.31047619047619,
      "telop" : "「私は…」私はそう言いかけて、言葉が止まる。\nそして、ふと彼とエンドレスランをした日のことを思い出す…。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 10.14750566893424,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1340_古明地こいし.wav",
      "id" : "B7BA5663-1D73-4BDD-B2E3-2773A2EF1236",
      "title" : "シーン 1340",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1340",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1340.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 10.14750566893424,
      "telop" : "私たちが、走り始めてから、最初の校門を出て曲がるまでは、\n特に問題なく、比較的にスムーズに走れていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc367698_住宅街２（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 11.650272108843538,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1341_古明地こいし.wav",
      "id" : "60625397-89DB-4BA2-8F86-0457E87A4004",
      "title" : "シーン 1341",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1341",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1341.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 11.650272108843538,
      "telop" : "だが、1kmあたりを過ぎると、だんだんと、彼と私のペースに翳りが見え始め、後方にいた美鈴先生がその問題を指摘する。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc367698_住宅街２（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 10.726235827664398,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1342_古明地こいし.wav",
      "id" : "F37A9081-FB4F-42E2-BCAE-EBE55603347D",
      "title" : "シーン 1342",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1342",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1342.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 10.726235827664398,
      "telop" : "そこまでは、単純に走って疲れて、歩いているだけ、だった。\nだが、歩き始めて少し経つと、彼が急に走り出す。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc367698_住宅街２（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 11.539773242630385,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1343_古明地こいし.wav",
      "id" : "51C0F4DB-5196-46E0-8895-1CB6A693F738",
      "title" : "シーン 1343",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1343",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1343.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 11.539773242630385,
      "telop" : "私は、慌てて彼について行こうとすると、彼の手がぶつかる。\n私はあのときドキッとし、そして、口走り、そのまま走り出す。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc240173_住宅街（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 10.744195011337869,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1344_古明地こいし.wav",
      "id" : "D4ACDF0A-B9A3-4BF6-AA96-AF016B7BBCA7",
      "title" : "シーン 1344",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1344",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1344.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 10.744195011337869,
      "telop" : "だが、さらに1kmがたつと、今度は足元にある石ころにこける。\nそして、次の瞬間には、彼に抱っこされていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc240173_住宅街（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 10.158548752834466,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1345_古明地こいし.wav",
      "id" : "3D491CCA-3DB3-4933-B12F-A2556376EBCE",
      "title" : "シーン 1345",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1345",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1345.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 10.158548752834466,
      "telop" : "それからだろうか…、私は、今までの学校生活では全くと言っていいほど、感じなかった気持ちが心から湧き出していた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
