      "voiceDuration" : 8.70172335600907,
      "telop" : "僕はそう言われ、一瞬断ろうかと思ったが、雰囲気的に難しいと感じ、全身の力を抜いて、脱力する。「それじゃあ…」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "bgmVolume" : 0.7,
