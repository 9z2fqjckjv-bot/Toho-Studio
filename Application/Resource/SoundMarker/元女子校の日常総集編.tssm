      "voiceDuration" : 8.426984126984127,
      "telop" : "「ありがとう、それじゃあ、気持ち良くしてあげる。」\n私はそういい、彼の服を脱がすと、自らも服を脱いだ。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "2026-10-25_16-14.pxd",
      "bgmVolume" : 0.7,
      "duration" : 7.532154195011338,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_796_操夢.wav",
