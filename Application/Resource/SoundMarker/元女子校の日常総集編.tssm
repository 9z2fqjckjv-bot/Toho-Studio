      "slideTitle" : "スライド #1586",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1586.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.648004535147392,
      "telop" : "私は、彼女が地下底国グループの令嬢であることは、把握していたつもりだったが、今回の出来事で、それを実感させられた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
