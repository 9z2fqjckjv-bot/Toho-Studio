      "voiceDuration" : 7.074557823129251,
      "telop" : "すると、そこには頬が赤らみ、驚いているフランがいた。\n「あっ、しまった…」僕は、ふとそう呟く。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
