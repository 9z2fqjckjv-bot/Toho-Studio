      "slideTitle" : "スライド #279",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.279.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 4.8278231292517,
      "telop" : "僕が、午前中の授業を終えると、\nふと、昼食がないことを思い出す。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 5.148458049886622,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_280_操夢.wav",
      "id" : "41C406CB-9D4D-4C3D-BB08-3C80425A8F7B",
      "title" : "シーン 280",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #280",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.280.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 5.148458049886622,
      "telop" : "そこで、ふとさとりの姿を探す。\nだが、彼女は教室にはいなかった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 5.108253968253968,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_281_操夢.wav",
      "id" : "20ED76A5-4145-4715-A0AB-74D1069F6DE4",
      "title" : "シーン 281",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #281",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.281.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 5.108253968253968,
      "telop" : "仕方なく、僕は廊下に出て歩いていると、\nふと向こうから、誰かがやってくる。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 7.042222222222223,
      "bgmStartTimeOffset" : 0,
      "characterName" : "東風谷早苗",
      "voiceCharacter" : "東風谷早苗",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_282_東風谷早苗.wav",
      "id" : "092F509F-0F9C-42A4-82DB-83714C07E686",
      "title" : "シーン 282",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_D32F",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #282",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.282.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png",
      "voiceDuration" : 7.042222222222223,
      "telop" : "「おや、藤原さんですか、ちょうどよかった。あなた宛の荷物が来てたので、ちょうど渡そうとしてたところですよ。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 6.116371882086168,
      "bgmStartTimeOffset" : 0,
      "characterName" : "東風谷早苗",
      "voiceCharacter" : "東風谷早苗",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_283_東風谷早苗.wav",
      "id" : "FFEE4074-1304-4B42-9B80-6039483F149A",
      "title" : "シーン 283",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_D32F",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #283",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.283.jpeg",
