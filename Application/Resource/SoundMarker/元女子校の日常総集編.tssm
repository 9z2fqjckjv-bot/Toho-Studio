      "id" : "70743B55-1CFB-4392-BFE3-DD115811F253",
      "title" : "シーン 517: その頃、ある場所では…",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "表示時間:1.5秒",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #517",
