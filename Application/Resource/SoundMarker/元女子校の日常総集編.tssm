      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1283.jpeg",
      "voiceDuration" : 8.303900226757369,
      "seVolume" : 1
    },
    {
      "id" : "66379755-01B2-446E-BA5E-F93DDE7EF758",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1284_古明地こいし.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg",
      "telop" : "「そういえば、アリスさんは、飛行機に乗るのは初めてですか？」僕は、ふと気になったので、彼女にそう尋ねる。",
      "voiceCharacter" : "古明地こいし",
      "duration" : 9.675124716553288,
      "title" : "シーン 1284",
      "slideTitle" : "スライド #1284",
