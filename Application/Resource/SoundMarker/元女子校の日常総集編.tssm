      "characterName" : "アリス・マーガトロイド",
      "voiceCharacter" : "アリス・マーガトロイド",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1514_アリス・マーガトロイド.wav",
      "id" : "11604D42-6B39-4ABF-95BC-17EADE190A58",
      "title" : "シーン 1514",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2DB3",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1514",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1514.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 1.4037414965986394,
      "telop" : "「ちょっと、何するのよ。」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image65.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.458253968253969,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1515_操夢.wav",
      "id" : "1EC5585C-EE77-40D2-88E6-2A70A7C662CB",
      "title" : "シーン 1515",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1515",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1515.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.458253968253969,
      "telop" : "「こういう時のために、向こうで買ったんですよ。互いにアイマスクを被れば、僕が浴室の中でアリスさんの体を支えますから…」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image65.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.049546485260771,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1516_操夢.wav",
      "id" : "7C2371AE-B27B-4F08-BEE3-4AE6627D4EC1",
      "title" : "シーン 1516",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1516",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1516.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.049546485260771,
      "telop" : "「ただ、触覚だけはどうにもならないので、そこは我慢してください。何より怪我なく、お風呂に入れるのが一番ですから。」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image65.jpeg",
      "bgmVolume" : 0.7,
