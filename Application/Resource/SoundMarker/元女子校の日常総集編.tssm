      "voiceDuration" : 5.1539002267573695,
      "telop" : "僕がそう尋ねるが、返答はなく、\n代わりに彼女は僕をベッドの上に押し倒す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "bgmVolume" : 0.7,
