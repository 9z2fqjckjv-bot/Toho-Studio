      "title" : "シーン 788",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #788",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.788.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png",
      "voiceDuration" : 2.786984126984127,
      "telop" : "「あら、目が覚めたの、紅夢くん…。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
