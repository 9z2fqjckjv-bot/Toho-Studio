      "voiceDuration" : 9.503854875283446,
      "telop" : "「そんなことどうだっていいわ、あなたが私をその気にさせたんだから。何かあっても、絶対に責任とってよね。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
