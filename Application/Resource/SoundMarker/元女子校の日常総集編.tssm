      "audioTrack" : "track_voice_char_30CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2170.jpeg",
