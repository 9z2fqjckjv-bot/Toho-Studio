      "voiceDuration" : 8.166938775510204,
      "telop" : "「確かに、アリスさんのいう通りです。それで、どうします？\n海中道路を渡った先に、タコスのお店がありますが？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image59.jpeg",
