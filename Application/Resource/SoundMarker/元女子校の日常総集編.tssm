      "voiceDuration" : 5.499705215419501,
      "telop" : "私は、彼にそう聞かれ、少しばかし考えてからいう。\n「今食べちゃうと、お昼が食べられなくなるわね…」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image59.jpeg",
