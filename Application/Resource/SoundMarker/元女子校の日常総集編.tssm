      "telop" : "「えっと…」私はそう言われ、記憶を遡る。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 3.715736961451247,
      "title" : "シーン 828",
      "slideTitle" : "スライド #828",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.828.jpeg",
      "voiceDuration" : 3.715736961451247,
      "seVolume" : 1
    },
    {
      "id" : "AA72CAC5-6108-452A-B631-59BA853AFC6C",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_829_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg",
      "telop" : "昨晩、彼女が図書館に行った後、私とお姉様は、もともとこの屋敷に住んでいた咲夜たちとの飲み会に向かった。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 9.090748299319728,
      "title" : "シーン 829",
      "slideTitle" : "スライド #829",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.829.jpeg",
      "voiceDuration" : 9.090748299319728,
      "seVolume" : 1
    },
    {
      "id" : "CB187C24-24DE-4AFF-8BB4-2F722176718E",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_830_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg",
      "telop" : "すると、始まってからすぐに、パチュリーが私に、祝いの言葉を告げる。その後、順々に言葉を聞き終えていく。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 8.951995464852608,
      "title" : "シーン 830",
      "slideTitle" : "スライド #830",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.830.jpeg",
      "voiceDuration" : 8.951995464852608,
      "seVolume" : 1
    },
    {
      "id" : "88015133-37BB-458C-A5BD-0D7D2FE32AC1",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_831_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg",
      "telop" : "私は、彼女たちからの祝いの言葉に少し困惑する。\nなぜなら、彼との結婚が決まったわけではないからだ。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 8.616984126984127,
      "title" : "シーン 831",
      "slideTitle" : "スライド #831",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.831.jpeg",
      "voiceDuration" : 8.616984126984127,
      "seVolume" : 1
    },
    {
      "id" : "DE1A71DB-F538-461B-8028-7FF097D195E2",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_832_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "咲夜（困る）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png",
      "telop" : "すると、咲夜が私になぜ、困っているかを聞いてくる。\n私が戸惑っていると、お姉様がそのことを伝える。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 8.709478458049887,
      "title" : "シーン 832",
      "slideTitle" : "スライド #832",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.832.jpeg",
      "voiceDuration" : 8.709478458049887,
      "seVolume" : 1
    },
    {
      "id" : "E85CD4E6-FB51-4015-AD7D-2814BA61CC0D",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_833_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "咲夜（弱る）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（弱る）.png",
      "telop" : "その言葉に皆は、謝り、少しばかし空気が暗くなりかけてたところに、赤ワインとお通しが出てくる。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 7.839478458049887,
      "title" : "シーン 833",
      "slideTitle" : "スライド #833",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.833.jpeg",
      "voiceDuration" : 7.839478458049887,
      "seVolume" : 1
    },
    {
      "id" : "30532810-9CB9-4A4A-9DA1-FDEC31DD5BBB",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_834_フランドール・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "咲夜（弱る）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（弱る）.png",
      "telop" : "そして、それからしばらく経つと、お酒だけ飲んでいた私とお姉様は…、私はその先を思い出そうとするが、思い出せない。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 9.334489795918367,
      "title" : "シーン 834",
      "slideTitle" : "スライド #834",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.834.jpeg",
      "voiceDuration" : 9.334489795918367,
      "seVolume" : 1
    },
    {
      "id" : "B989ADBE-85DC-420E-8C0C-FAD25D199B98",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（弱る）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_835_レミリア・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc107556_紅魔的館内.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg",
      "telop" : "「確かに、あの時は、私とフランだけすでに食事を済ませて、酒だけをのが、原因なのは分かっている、けど…」",
      "voiceCharacter" : "レミリア・スカーレット",
      "duration" : 7.692154195011338,
      "title" : "シーン 835",
      "slideTitle" : "スライド #835",
      "characterName" : "レミリア・スカーレット",
      "audioTrack" : "track_voice_char_30CA",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.835.jpeg",
      "voiceDuration" : 7.692154195011338,
      "seVolume" : 1
    },
    {
      "id" : "64F10879-9ED9-44EB-AB7A-1CDB141B47A6",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（弱る）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_836_レミリア・スカーレット.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc107556_紅魔的館内.jpg",
