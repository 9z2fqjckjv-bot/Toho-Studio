      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "彼女がそう言いながら、僕を庇い、再び攻撃を受ける。",
      "voiceCharacter" : "操夢",
      "duration" : 3.8756462585034015,
      "title" : "シーン 2038",
      "slideTitle" : "スライド #2038",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "seName" : "SE: 打撃7",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2038.jpeg",
      "voiceDuration" : 3.8756462585034015,
      "seVolume" : 0.85
    },
    {
      "id" : "1B1C680B-715D-4808-9B95-424628AEBE5E",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2039_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "するとまた血が飛び散り、今度はその相手の姿が一瞬見える。\n「えっ…」そして、ある姿と重なる。「魔理沙さん…」",
      "voiceCharacter" : "操夢",
      "duration" : 7.9865079365079366,
      "title" : "シーン 2039",
      "slideTitle" : "スライド #2039",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2039.jpeg",
      "voiceDuration" : 7.9865079365079366,
      "seVolume" : 1
    },
    {
      "id" : "BB09E95C-ADC7-4965-B16E-720A26F9443A",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2040_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "僕は、そう思わず呟いていると、遠くの方から誰かが僕の声を叫んでいるような感じがして、だんだんと視界が暗転した。",
      "voiceCharacter" : "操夢",
      "duration" : 8.241519274376417,
      "title" : "シーン 2040",
      "slideTitle" : "スライド #2040",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
