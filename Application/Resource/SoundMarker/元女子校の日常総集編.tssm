      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2041_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc256896_病室-昼.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png",
      "telop" : "「んっ…」僕は誰かの叫び声で目が覚める。\nそこには、頬照った状態で泣いているこいしの姿があった。",
      "voiceCharacter" : "操夢",
