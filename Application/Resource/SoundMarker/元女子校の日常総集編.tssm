      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #753",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.753.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png",
      "voiceDuration" : 8.121292517006802,
      "telop" : "私はふと考える、この機を逃せば、2度とこの書面を見れない気がした。そして、ペンを手に取ると、サインをして返す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc196982_食堂(夜2).png",
      "bgmVolume" : 0.7,
      "duration" : 5.356734693877551,
      "bgmStartTimeOffset" : 0,
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png",
