      "seVolume" : 1,
      "telop" : "一方でフランは…",
      "animationDuration" : 1.5,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
