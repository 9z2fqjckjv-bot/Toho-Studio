      "voiceDuration" : 6.7851700680272105,
      "telop" : "「ふとさっき、私が廊下を歩いていたら、彼が倒れたんですよ。それで、彼、叩いたら起きますかね…」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 4.899591836734694,
      "bgmStartTimeOffset" : 0,
      "characterName" : "射命丸文",
      "voiceCharacter" : "射命丸文",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
