      "duration" : 9.681995464852609,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_410_フランドール・スカーレット.wav",
      "id" : "3A0B3A36-5430-42EE-828F-8AAF65FB3563",
      "title" : "シーン 410",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #410",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.410.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 9.681995464852609,
      "telop" : "私は、自分の部屋に戻ると、再び10年前、試験的な取り組みで、ある幼稚園のクラスの担当をしてたときを思い出す。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "bgmVolume" : 0.7,
      "duration" : 10.153990929705216,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_411_フランドール・スカーレット.wav",
      "id" : "B41DD10A-8945-49A2-9EF8-DD58ACE953C9",
      "title" : "シーン 411",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #411",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.411.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 10.153990929705216,
      "telop" : "私は、10年前、日々の解体工事にくる文句で溜まった疲労を癒そうとお姉様がいい、ある幼稚園のクラスを任されたときだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "bgmVolume" : 0.7,
      "duration" : 9.606984126984127,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_412_フランドール・スカーレット.wav",
      "id" : "F2A4BED1-B707-4FF7-BCDC-F968DE9A685A",
      "title" : "シーン 412",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #412",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.412.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 9.606984126984127,
      "telop" : "その幼稚園は、著名な男子校の幼稚部に属する幼稚園で、その名の通り男児だけのクラスのみで、全体が構成されていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.474489795918368,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_413_フランドール・スカーレット.wav",
      "id" : "A9549C0A-60D8-426A-833C-135BE541096C",
      "title" : "シーン 413",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #413",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.413.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.474489795918368,
      "telop" : "私たちは、それとは対照的な女子校出身だったので、\nそれと比べて意外とその日々は新鮮味を感じていた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "bgmVolume" : 0.7,
      "duration" : 4.0607482993197275,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_414_フランドール・スカーレット.wav",
      "id" : "13F28AD2-C580-4EE8-94F0-7041B10F972C",
      "title" : "シーン 414",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #414",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.414.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 4.0607482993197275,
      "telop" : "事の発端は、ある劇の発表をしていたときだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "bgmVolume" : 0.7,
      "duration" : 11.103242630385488,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_415_フランドール・スカーレット.wav",
      "id" : "6CBEA750-E71D-461A-A115-A0E5087A30BC",
      "title" : "シーン 415",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #415",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.415.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 11.103242630385488,
      "telop" : "それは、事前に収録し、編集した劇の動画を上映する形での発表だった。そして、その発表途中に、部屋を飛び出る男児が出る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg",
      "bgmVolume" : 0.7,
      "duration" : 9.446984126984127,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_416_フランドール・スカーレット.wav",
      "id" : "3D6DA1B4-0BD1-4F46-BF0B-9A2B0818CC90",
      "title" : "シーン 416",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #416",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.416.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-08-28_19-07.png",
      "voiceDuration" : 9.446984126984127,
      "telop" : "私が、その男児の後を追いかけると、遠くには、その男児は言っておらず、周囲をキョロキョロしながら、私に目線を当てる。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg",
      "bgmVolume" : 0.7,
      "duration" : 5.301995464852608,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_417_フランドール・スカーレット.wav",
      "id" : "D6DE2F25-ACC1-46CF-BC88-67D8E3DE2AAD",
      "title" : "シーン 417",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #417",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.417.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-08-28_19-07.png",
      "voiceDuration" : 5.301995464852608,
      "telop" : "すると、彼は、私の方を真正面に見つめ、ある言葉を告げる。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg",
      "bgmVolume" : 0.7,
      "duration" : 4.440748299319728,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_418_フランドール・スカーレット.wav",
      "id" : "C44E6FFA-6196-48A8-9332-13C8BF0A4BF5",
      "title" : "シーン 418",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
