      "title" : "シーン 1764",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1764",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1764.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.904988662131519,
      "telop" : "あれから、僕たちは家に帰り、レミリアとフランにいろいろと説明をしていると、あっという間に時間が過ぎ、夕飯時になった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
