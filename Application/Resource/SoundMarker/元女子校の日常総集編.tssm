      "title" : "シーン 40",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_D32F",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #40",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.040.jpeg",
