      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "すると、彼女は暗闇から鋭い攻撃を受ける。\nそして、ぐちゃりと何か飛び散る。",
      "voiceCharacter" : "操夢",
      "duration" : 5.745215419501133,
      "title" : "シーン 2035",
      "slideTitle" : "スライド #2035",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "seName" : "SE: 打撃7",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2035.jpeg",
      "voiceDuration" : 5.745215419501133,
      "seVolume" : 0.85
    },
    {
      "id" : "B399B57E-2A57-4A26-815F-E8400BD6B910",
      "seStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png",
