      "title" : "シーン 1440",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1440",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1440.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 2.846984126984127,
      "telop" : "「ねぇ、紅夢、今は何してるの？」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image60.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 7.7365079365079366,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1441_操夢.wav",
      "id" : "D767B7EF-8E42-4775-BD98-5F448683C528",
      "title" : "シーン 1441",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1441",
