      "id" : "1EC2E275-D306-40AD-A2A5-AD508A8503CE",
      "title" : "シーン 643",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_reimu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #643",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.643.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手すやすや頬照り寝顔.pxd",
      "voiceDuration" : 9.304489795918368,
      "telop" : "そして、そっと息子の部屋の扉を開けて、中を覗く。すると、彼女が言っていた女性が、スヤスヤとベッドで寝ていた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
