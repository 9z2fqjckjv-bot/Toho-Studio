      "seVolume" : 1,
      "voiceDuration" : 9.159478458049886,
      "telop" : "なぜ、そうしたのか、私にはまだ、完全には把握しきれてないし、この気持ちの正体もいまだに、どっちかわからない。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
