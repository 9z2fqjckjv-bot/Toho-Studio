      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_290_操夢.wav",
      "id" : "B2F5E92D-B968-4E61-BFF5-8846E382EB42",
      "title" : "シーン 290",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #290",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.290.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 6.058253968253968,
      "telop" : "僕が、その瓶をぼーっと眺めていると、\n誰かが教室に入り、僕の席に駆け寄ってくる。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
