      "voiceDuration" : 2.466938775510204,
      "telop" : "「それで、こいしさんは…、どうですか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc352037_ホテルの廊下1.jpg",
