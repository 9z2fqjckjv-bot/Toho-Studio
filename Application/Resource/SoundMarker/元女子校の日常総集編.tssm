      "seVolume" : 1,
      "voiceDuration" : 5.714761904761905,
      "telop" : "彼女がそう呟くと、保留音がなる。\nすると、浴室の扉が開く音がする。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
