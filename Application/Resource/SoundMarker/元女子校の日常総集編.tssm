      "telop" : "彼女はそういうと、去っていった。\n僕は、ひとまず、リビングに戻る。",
      "voiceCharacter" : "操夢",
      "duration" : 4.926734693877551,
      "title" : "シーン 511",
      "slideTitle" : "スライド #511",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
