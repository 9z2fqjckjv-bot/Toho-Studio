      "voiceDuration" : 5.279478458049887,
      "telop" : "「それなら、宣戦布告されたわよ、\n地下底国グループのご令嬢に。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
