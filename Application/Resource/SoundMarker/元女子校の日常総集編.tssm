      "voiceDuration" : 5.313197278911565,
      "telop" : "「ついさっき、あなたのお弁当が届けられたので…」\n私はそう言いながら、受け取った弁当を置く。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
