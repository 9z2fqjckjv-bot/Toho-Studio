      "seVolume" : 1,
      "voiceDuration" : 6.291950113378685,
      "telop" : "僕は、強めに彼女の頬を叩くと、彼女は意識を取り戻し、\nなんとかことなきを得るのだった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
