      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ怒り.png",
      "voiceDuration" : 8.486507936507936,
      "telop" : "すると、彼女はますます赤く染まっていき、僕を押し倒したことを疑うくらいになっていた。だが、彼女は強烈なビンタをする。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "bgmVolume" : 0.7,
      "duration" : 3.197233560090703,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
