      "seVolume" : 1,
      "voiceDuration" : 10.165736961451247,
      "telop" : "「はぁ」私は、ため息をつきながら、神社の敷地を箒で掃いていた。ため息が出る理由は、巨大組織の令嬢からの電話だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "bgmVolume" : 0.7,
      "duration" : 5.754444444444444,
      "bgmStartTimeOffset" : 0,
      "characterName" : "先代の巫女",
      "voiceCharacter" : "先代の巫女",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg",
