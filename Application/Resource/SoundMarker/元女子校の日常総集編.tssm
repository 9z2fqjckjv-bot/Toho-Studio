      "voiceDuration" : 5.003854875283447,
      "telop" : "「ふぅん…、まぁいいわ…、\nあなたを奪うことには変わりはないのだから。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
