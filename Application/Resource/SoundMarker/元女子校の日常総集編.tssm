      "audioTrack" : "track_voice_char_53C6",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1147",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1147.jpeg",
