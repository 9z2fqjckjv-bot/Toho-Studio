      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1778_古明地さとり.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "2026-10-26_19-50.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png",
      "telop" : "「あら、紅夢さん、どうしたんですか？私は妹を連れて帰るだけですよ。それとも…私がどうかしたのですか？」",
