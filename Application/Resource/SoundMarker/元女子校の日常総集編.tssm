      "id" : "31BE6245-211F-446A-9F52-4FB1233CF99C",
      "title" : "シーン 1590",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2CB2",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1590",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1590.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png",
      "voiceDuration" : 5.754444444444444,
      "telop" : "「ほら、ため息なんかついてないで、チャチャっとやったらどうなのよ、霊夢」私はそう、箒を持っている娘の霊夢に言う。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
