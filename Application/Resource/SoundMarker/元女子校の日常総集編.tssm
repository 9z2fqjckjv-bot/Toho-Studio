      "voiceDuration" : 4.440748299319728,
      "telop" : "その彼の行動に対して私は、一言返す程度だった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 10.299478458049887,
