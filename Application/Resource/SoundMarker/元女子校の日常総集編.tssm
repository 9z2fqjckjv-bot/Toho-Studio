      "seVolume" : 1,
      "voiceDuration" : 7.7365079365079366,
      "telop" : "「えっ…？」僕は、その問いに思わずそう返してしまう。\n「確か、昨日、留守電を残していったはずなんですけど…」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image60.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 1.9394784580498867,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1442_フランドール・スカーレット.wav",
