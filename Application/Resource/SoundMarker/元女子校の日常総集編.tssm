      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1136.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.4354195011337865,
      "telop" : "僕は、彼女が病室を出ると、早速そのお弁当を開ける。\nそして、そのお弁当をよく味わって食べていった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "bgmVolume" : 0.7,
      "duration" : 8.85390022675737,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png",
