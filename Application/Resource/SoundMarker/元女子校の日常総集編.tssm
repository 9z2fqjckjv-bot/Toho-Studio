      "bgmStartTimeOffset" : 0,
      "backgroundName" : "ColabGPU_1791195025_33546.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png",
      "telop" : "「ええ、前の学校と比べると、かなり良いです。母に、母の母校に転校したいと言って、良かったと僕は思っています。」",
      "voiceCharacter" : "操夢",
      "duration" : 8.435419501133786,
      "title" : "シーン 946",
      "slideTitle" : "スライド #946",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.946.jpeg",
      "voiceDuration" : 8.435419501133786,
      "seVolume" : 1
    },
    {
      "id" : "BA2B852E-1FA6-4A55-BE86-A12D75E6A5BB",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png",
