      "voiceDuration" : 5.900272108843537,
      "telop" : "「ありがとう…！」\n私はそう言うと、早速、そのお店に入って行った。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
