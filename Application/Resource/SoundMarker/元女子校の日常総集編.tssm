      "title" : "シーン 800",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #800",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.800.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 9.348027210884354,
      "telop" : "僕は、ふとフランの方を見ると、彼女は依然として裸のまますやすやと眠っていた。僕は、そのまま戸惑っていると、扉が開く。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
