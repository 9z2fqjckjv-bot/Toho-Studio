      "voiceDuration" : 8.461519274376418,
      "telop" : "「まぁ、いいや。とにかく、アレを漏らしたお二人さんの介護、手伝って、それが済んだら、思う存分頭を撫でてあげるから。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
