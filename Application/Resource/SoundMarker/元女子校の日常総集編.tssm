      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg",
      "telop" : "僕は、ふと暇になり、テレビをつける。すると、テレビでは地下底国グループが突如、発表したご令嬢の今後について流れていた。",
      "voiceCharacter" : "操夢",
      "duration" : 9.064761904761905,
      "title" : "シーン 1701",
      "slideTitle" : "スライド #1701",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1701.jpeg",
      "voiceDuration" : 9.064761904761905,
      "seVolume" : 1
    },
    {
