      "telop" : "「いや、手伝わなくていいよ。そこらへんで座って、待ってて。」",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 5.033242630385487,
      "title" : "シーン 973",
      "slideTitle" : "スライド #973",
