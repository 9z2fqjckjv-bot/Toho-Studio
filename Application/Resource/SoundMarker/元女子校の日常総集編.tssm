    },
    {
      "id" : "1B617A64-9A5A-44CE-A76B-EA8E59275906",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり驚き後ろ手.png",
