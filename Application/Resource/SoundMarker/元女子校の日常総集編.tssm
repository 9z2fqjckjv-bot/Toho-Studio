      "backgroundName" : "nc352037_ホテルの廊下1.jpg",
      "bgmVolume" : 0.7,
      "duration" : 3.1171201814058955,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1346_古明地こいし.wav",
      "id" : "B5F6883F-2157-4194-96C9-729267B15D5C",
      "title" : "シーン 1346",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2B53",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1346",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1346.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png",
      "voiceDuration" : 3.1171201814058955,
      "telop" : "私は、ふと意識が現実に戻ると、彼が困った表情で、私の名前を読んでいた。「私は…紅夢と…」私は、続けて言葉を放つ。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc352037_ホテルの廊下1.jpg",
      "bgmVolume" : 0.7,
      "duration" : 5.495396825396825,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地さとり",
      "voiceCharacter" : "古明地さとり",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1347_古明地さとり.wav",
      "id" : "5706D5DF-A43A-4FD0-B09E-F947B33218AA",
      "title" : "シーン 1347",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_C52B",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1347",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1347.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png",
      "voiceDuration" : 5.495396825396825,
      "telop" : "「こいし…、一体どんな変化があったのよ…」\n私は、妹が発した予想外なその言葉に、そう返す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
