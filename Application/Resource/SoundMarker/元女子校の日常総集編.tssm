      "voiceDuration" : 4.056077097505669,
      "telop" : "「えっ…？」僕がそう返すと、もう一度彼女はビンタをする。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
