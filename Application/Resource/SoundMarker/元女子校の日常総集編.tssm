      "voiceDuration" : 6.3778231292517,
      "telop" : "僕はふと、彼女の吐息が酒臭いことに気がつく。「…フランさん、どれだけお酒を飲みましたか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "2026-10-26_19-50.png",
