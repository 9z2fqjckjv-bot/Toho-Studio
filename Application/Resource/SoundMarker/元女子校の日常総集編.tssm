      "backgroundName" : "image53.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg",
      "telop" : "僕は、フランに連れられて、とある山間のキャンプ場に来ていた。そして、僕は、彼女にキャンプ用品を持ってきたかを聞く。",
      "voiceCharacter" : "操夢",
      "duration" : 8.25172335600907,
      "title" : "シーン 970",
      "slideTitle" : "スライド #970",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.970.jpeg",
      "voiceDuration" : 8.25172335600907,
      "seVolume" : 1
    },
    {
      "id" : "F401E4B3-8FF1-415D-9B49-6A11BAA7A6D4",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_971_フランドール・スカーレット.wav",
