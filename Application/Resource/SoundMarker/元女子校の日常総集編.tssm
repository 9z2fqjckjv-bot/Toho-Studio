      "voiceDuration" : 2.9378684807256237,
      "telop" : "「あの、いいんですか？こいしさんだけはしゃいでしまって。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
