      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2040.jpeg",
      "voiceDuration" : 8.241519274376417,
      "seVolume" : 1
    },
    {
      "id" : "EA7F8829-9CEA-411F-9F02-CDE66444F92C",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/やられ涙目驚き頬照り.png",
