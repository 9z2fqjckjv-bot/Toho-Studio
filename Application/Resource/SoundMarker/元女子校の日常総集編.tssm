      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1138_操夢.wav",
      "id" : "3450FF70-8B6D-4492-9B21-065B73003A46",
      "title" : "シーン 1138",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1138",
