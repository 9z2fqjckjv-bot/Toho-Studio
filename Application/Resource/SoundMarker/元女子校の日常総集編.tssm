      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア苦笑.png",
      "voiceDuration" : 5.448412698412699,
      "telop" : "「いいわよ、あなたの将来に関わる、\n大事なことなんだから、ちゃんと考えてきなさい。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 8.342154195011338,
      "bgmStartTimeOffset" : 0,
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff",
