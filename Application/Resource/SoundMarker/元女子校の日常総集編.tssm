      "audioTrack" : "track_voice_char_53C6",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.945.jpeg",
      "voiceDuration" : 3.3903854875283446,
      "seVolume" : 1
    },
    {
      "id" : "A22F59AB-86DB-45CA-ABFF-AFA47413A63F",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_946_操夢.wav",
