      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2033_サブ.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "「今すぐ、私の背中に隠れなさい。」",
      "voiceCharacter" : "サブ",
      "duration" : 2.78,
      "title" : "シーン 2033",
      "slideTitle" : "スライド #2033",
      "characterName" : "サブ",
      "audioTrack" : "track_voice_char_CC3E",
      "bgmVolume" : 0.7,
      "seName" : "[SE] 打撃1.mp3",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2033.jpeg",
      "voiceDuration" : 2.78,
      "seVolume" : 0.85
    },
    {
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃1.mp3",
      "id" : "29F6840E-6925-43CC-959B-722E915EB261",
      "seStartTimeOffset" : -10.376303854876824,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2034_操夢.wav",
      "voiceStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "telop" : "彼女がそういうと、僕は無意識のうちに、彼女の背中に隠れる。\nなぜだかわからないが、彼女が母である霊夢に見えていた。",
      "voiceCharacter" : "操夢",
      "duration" : 8.40390022675737,
      "title" : "シーン 2034",
      "slideTitle" : "スライド #2034",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "seName" : "[SE] 打撃1.mp3",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2034.jpeg",
      "voiceDuration" : 8.40390022675737,
      "seVolume" : 0.85
    },
    {
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/打撃7.mp3",
      "id" : "8F8EA937-2C4F-4A06-81C0-52C969FEEFA7",
      "seStartTimeOffset" : 1.89,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png",
      "animationName" : "なし",
