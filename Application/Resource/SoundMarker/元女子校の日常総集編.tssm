      "id" : "CB187C24-24DE-4AFF-8BB4-2F722176718E",
      "title" : "シーン 830",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #830",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.830.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png",
      "voiceDuration" : 8.951995464852608,
      "telop" : "すると、始まってからすぐに、パチュリーが私に、祝いの言葉を告げる。その後、順々に言葉を聞き終えていく。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.616984126984127,
      "bgmStartTimeOffset" : 0,
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_831_フランドール・スカーレット.wav",
      "id" : "88015133-37BB-458C-A5BD-0D7D2FE32AC1",
      "title" : "シーン 831",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #831",
