      "seVolume" : 1,
      "voiceDuration" : 7.675646258503401,
      "telop" : "僕は、あれから魔法使い入門編の本を、読んでいる際にふと思いつき、僕とフランの部屋からノートとペンを持ってきた。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "bgmVolume" : 0.7,
      "duration" : 7.686507936507937,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1826_操夢.wav",
      "id" : "B1302D53-A049-4E08-A8FC-FA507C9801BA",
      "title" : "シーン 1826",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1826",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1826.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.686507936507937,
      "telop" : "そして、本の内容をもとに、自分なりにノートを書き込んでいく。そして、ふと本を読んでいて、あることに気がつく。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.037596371882087,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1827_操夢.wav",
