      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg",
