      "seVolume" : 1,
      "voiceDuration" : 10.690748299319727,
      "telop" : "私は、ふとその封筒の宛名を見る。そこには、私と夫の名前があり、差出人には…ある建設会社の代表の名前があった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
