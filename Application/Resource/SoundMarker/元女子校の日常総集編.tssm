      "seVolume" : 1,
      "voiceDuration" : 4.006077097505669,
      "telop" : "「こいし、古明地こいしさんですよ。それがどうしたんですか？」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
