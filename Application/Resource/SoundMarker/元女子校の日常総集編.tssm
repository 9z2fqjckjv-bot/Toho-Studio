      "voiceDuration" : 7.495850340136054,
      "telop" : "すると、僕はある嫌な予感がする。そこで僕は、食事前にパチュリーからもらっていたある液体を二人に飲ます。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.547369614512471,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2145_操夢.wav",
      "id" : "F56ED7EC-EA55-4C6E-90CA-D368F31AC64B",
      "title" : "シーン 2145",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2145",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2145.jpeg",
