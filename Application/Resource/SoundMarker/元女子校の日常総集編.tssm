      "voiceDuration" : 4.978231292517007,
      "telop" : "「分かった…」私は通話を切ると、彼の姿を探し始めた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
