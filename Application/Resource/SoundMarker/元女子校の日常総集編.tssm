      "id" : "57C8559B-0A02-4BA2-9235-F14DD59D00FE",
      "title" : "シーン 278: それから時間が進み…",
      "voice2StartTimeOffset" : 0,
      "animationNote" : "表示時間:1.5秒",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #278",
