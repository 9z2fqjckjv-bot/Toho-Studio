      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1517_操夢.wav",
      "id" : "BB64F52E-BEBA-4389-AC53-04E2DDA106E6",
      "title" : "シーン 1517",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1517",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1517.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 2.4017233560090703,
      "telop" : "僕はそう言いながら、アイマスクを被る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
