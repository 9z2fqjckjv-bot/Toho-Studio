      "id" : "FD70AE6B-5CD7-4E50-B89D-849952DCB96F",
      "title" : "シーン 1285",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_2DB3",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1285",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1285.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png",
      "voiceDuration" : 2.8959410430839,
      "telop" : "「いや、学校での修学旅行で何度か、乗ったわ…。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
