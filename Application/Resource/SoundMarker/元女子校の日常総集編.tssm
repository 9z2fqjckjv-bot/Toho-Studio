      "voiceDuration" : 8.869478458049887,
      "telop" : "「紅夢、どこにいるの？聞こえたら返事して…」私は、暗い夜の森でそう呼びかけながら、彼の姿を探す。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
