      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png",
      "voiceDuration" : 3.8844897959183675,
      "telop" : "「はぁ、そんなことくらい分かってるわよ、言わずとも。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
