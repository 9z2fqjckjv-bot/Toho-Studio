      "voiceDuration" : 8.142154195011338,
      "telop" : "「確かに、でもあなたは大丈夫なの？文脈から察するに、あなたの存在に関する情報が、向こうに流れるみたいだけど？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
