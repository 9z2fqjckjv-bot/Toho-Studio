      "telop" : "そして、食卓に座るとテレビをつける。\n僕は、その映像を見ているうちに、全身に痛みが走る。",
      "voiceCharacter" : "操夢",
      "duration" : 6.888684807256236,
      "title" : "シーン 512",
      "slideTitle" : "スライド #512",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.512.jpeg",
      "voiceDuration" : 6.888684807256236,
      "seVolume" : 1
    },
