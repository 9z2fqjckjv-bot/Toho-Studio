      "audioTrack" : "track_voice_reimu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.635.jpeg",
      "voiceDuration" : 9.013242630385488,
      "seVolume" : 1
    },
