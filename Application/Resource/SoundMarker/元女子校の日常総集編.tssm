      "seVolume" : 1,
      "voiceDuration" : 1.9394784580498867,
      "telop" : "「えっ…、ちょっと待ってて。」",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image60.jpeg",
      "bgmVolume" : 0.7,
