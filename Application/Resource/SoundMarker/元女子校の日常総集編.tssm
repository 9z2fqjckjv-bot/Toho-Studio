      "voiceDuration" : 7.845215419501134,
      "telop" : "僕たちは、そんな話をしていると、玄関のチャイムが鳴る。\nすると、扉が開き、さとりとこいしが入ってきた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "image68.jpeg",
      "bgmVolume" : 0.7,
      "duration" : 8.216938775510204,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1540_操夢.wav",
