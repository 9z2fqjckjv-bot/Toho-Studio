      "duration" : 8.40390022675737,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2034_操夢.wav",
      "id" : "29F6840E-6925-43CC-959B-722E915EB261",
      "title" : "シーン 2034",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2034",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2034.jpeg",
      "voiceDuration" : 8.40390022675737,
      "telop" : "彼女がそういうと、僕は無意識のうちに、彼女の背中に隠れる。\nなぜだかわからないが、彼女が母である霊夢に見えていた。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "duration" : 5.745215419501133,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2035_操夢.wav",
      "id" : "8F8EA937-2C4F-4A06-81C0-52C969FEEFA7",
      "title" : "シーン 2035",
