      "bgmStartTimeOffset" : 0,
      "backgroundName" : "image53.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg",
      "telop" : "「もちろん、持ってきたよ。」私はそう言い、車からテントなどのキャンプ用品を取り出し、テントの設営をする。",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 8.641995464852608,
      "title" : "シーン 971",
      "slideTitle" : "スライド #971",
      "characterName" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_char_1A94",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.971.jpeg",
      "voiceDuration" : 8.641995464852608,
      "seVolume" : 1
    },
    {
      "id" : "D75962F5-BBE5-4D9E-A28B-CB039D7B1F50",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png",
