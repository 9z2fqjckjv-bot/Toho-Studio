      "voiceDuration" : 5.541133786848072,
      "telop" : "「班長がこう言うのあれかもだけど…、本屋を見にいってても大丈夫かしら…」私は、そう彼に、尋ねる。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "nc230307_ショッピングモール.jpg",
