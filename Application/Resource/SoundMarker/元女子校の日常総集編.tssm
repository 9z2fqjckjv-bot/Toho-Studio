      "audioTrack" : "track_voice_char_D32F",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.343.jpeg",
      "voiceDuration" : 7.8960090702947845,
      "seVolume" : 1
    },
    {
