      "seVolume" : 1,
      "voiceDuration" : 3.733832199546485,
      "telop" : "私は、二人がいるキャンプ場に来ると、森の中に入る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
