      "id" : "47795C4B-26F8-41DB-B6AA-2F3B8682967F",
      "title" : "シーン 422",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_char_1A94",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #422",
