      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1438.jpeg",
      "voiceDuration" : 7.9865079365079366,
      "seVolume" : 1
    },
