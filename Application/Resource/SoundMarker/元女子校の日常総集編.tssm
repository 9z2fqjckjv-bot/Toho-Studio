      "voiceDuration" : 8.817687074829932,
      "telop" : "そして、最後にはこの4つ巴の戦いは、旅行が終わったら、即時に始まると高圧的に宣言し、その電話は途切れたのだった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg",
