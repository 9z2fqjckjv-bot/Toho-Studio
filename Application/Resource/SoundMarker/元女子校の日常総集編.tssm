      "voiceDuration" : 4.262607709750567,
      "telop" : "「分かった。」\n僕がそういうと、彼女はそのまま家を出ていった。",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "リビング（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 7.069115646258504,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "id" : "EBFAA67B-90B9-40F4-913C-4AE93480FB19",
      "title" : "シーン 10",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #10",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.010.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 7.069115646258504,
      "telop" : "僕は、それから数分も経たずに、朝食を食べ切ると、そのまあ流しに食器を入れ、ささっと洗剤で洗う。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "リビング（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 3.2756462585034014,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "id" : "42F59D6B-DF2C-482A-B69B-C236CBE80848",
      "title" : "シーン 11",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #11",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.011.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 3.2756462585034014,
      "telop" : "そして、洗い物が終わると、自分の部屋に戻る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "一人部屋３（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 8.869115646258503,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "id" : "D89A3A69-0929-4574-BD0E-278BCB137FFC",
      "title" : "シーン 12",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #12",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.012.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 8.869115646258503,
      "telop" : "そして、部屋に戻ると、新品の学校の制服を取り出し、ささっと着替える。そして、デスクをチラリと見ると、ある写真が写る。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "一人部屋３（日中）.jpg",
      "bgmVolume" : 0.7,
      "duration" : 9.37891156462585,
      "bgmStartTimeOffset" : 0,
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav",
      "id" : "4EB79851-3A16-40DE-9103-F075E0A652E4",
      "title" : "シーン 13",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #13",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.013.jpeg",
      "seVolume" : 1,
      "voiceDuration" : 9.37891156462585,
      "telop" : "その写真には、巫女服の霊夢と、僕の父である妹紅、そして、僕の3人が写っていた。この時の僕はまだ、小学生だった。",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "一人部屋３（日中）.jpg",
