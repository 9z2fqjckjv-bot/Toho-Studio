      "telop" : "そして、時計を見ると、深夜帯だということに気がつく。\nそして、同時に机の上にメモ書きがあることに気づく。",
      "voiceCharacter" : "操夢",
      "duration" : 7.582154195011338,
      "title" : "シーン 357",
      "slideTitle" : "スライド #357",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
