      "voiceDuration" : 2.0278231292517006,
      "telop" : "「あの、何が言いたいんですか？」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "ペーストされた画像.tiff",
      "bgmVolume" : 0.7,
      "duration" : 6.82546485260771,
      "bgmStartTimeOffset" : 0,
      "characterName" : "アリス・マーガトロイド",
      "voiceCharacter" : "アリス・マーガトロイド",
