      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_775_博麗霊夢.wav",
