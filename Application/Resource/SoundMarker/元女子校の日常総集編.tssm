      "title" : "シーン 1951",
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1951",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1951.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ怒り.png",
      "voiceDuration" : 8.30607709750567,
      "telop" : "「いえ、僕は戸籍上は男ですが、医者からは生まれつき、女性と男性、双方の臓器や体の部位があるって言われたんです。」",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "backgroundName" : "01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
      "bgmVolume" : 0.7,
      "duration" : 5.567392290249433,
      "bgmStartTimeOffset" : 0,
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg",
