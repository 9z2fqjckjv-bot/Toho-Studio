      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg",
