      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 8",
      "id" : "D3B70082-F026-4F3F-84C1-83AEEA3F71B2",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.009.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.819115646258504,
      "duration" : 7.819115646258504,
      "voiceCharacter" : "操夢",
      "telop" : "「今日と、帰る日の前日は、国際通り沿いのホテルなので、今日は南部中心ですが、アリスさんは希望はありますか？」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
