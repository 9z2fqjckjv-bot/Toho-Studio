      "id" : "D1CA2B38-5E3A-42BA-92BD-6803D718ED7E",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.046.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.221292517006802,
      "duration" : 8.221292517006802,
      "voiceCharacter" : "操夢",
      "telop" : "「少しばかし、風邪を引いたかも…しれません。とりあえず、国際通りに行きませんか？そしたら、ちょうどお昼だし…」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
