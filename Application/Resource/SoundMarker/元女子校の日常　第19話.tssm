      "duration" : 4.503832199546485,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3",
      "voiceCharacter" : "アリス・マーガトロイド",
      "telop" : "「あの二人にも聞いてこなくちゃね…」\n私はそう言うと、二人の方に向かって歩こうとする。",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seName" : "[SE] 海岸1.mp3",
      "slideTitle" : "スライド #30",
      "seVolume" : 0.1530708016074449,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_アリス・マーガトロイド.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 30",
      "id" : "DE4DD487-FCB9-425D-A9A8-9AC159DCBA04",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.031.jpeg",
      "seStartTimeOffset" : -68.64836734693877,
      "voiceDuration" : 8.893038548752834,
      "duration" : 8.893038548752834,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3",
      "voiceCharacter" : "操夢",
      "telop" : "僕は、彼女が二人の方に向かおうとすると、手で静止する。だが、その際に、彼女はバランスを崩し、海の方に倒れ込む。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seName" : "[SE] 海岸1.mp3",
      "slideTitle" : "スライド #31",
      "seVolume" : 0.1530708016074449,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 31",
      "id" : "5952ECAB-0EF7-4F42-A4DA-32F5AA503F07",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3",
      "seName" : "[SE] 海岸1.mp3",
      "seVolume" : 0.1530708016074449,
      "telop" : "僕は、彼女が海水に濡れさせないように、彼女を止めるように動く。すると、彼女が僕の腕に寄りかかるように倒れる。",
      "voiceCharacter" : "操夢",
      "voice2StartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.032.jpeg",
      "bgmAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/衣擦れ2.mp3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "bgmName" : "BGM: 衣擦れ2",
      "transitionName" : "なし",
      "slideTitle" : "スライド #32",
      "voiceDuration" : 7.988684807256236,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav",
      "title" : "シーン 32",
      "bgmVolume" : 2,
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 7.56,
      "animationName" : "なし",
      "duration" : 7.988684807256236,
      "id" : "ADB325BF-8A9E-4D1C-AB2C-C35106481123",
      "seStartTimeOffset" : -77.5414058956916
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.033.jpeg",
      "seStartTimeOffset" : -85.53009070294785,
      "voiceDuration" : 7.443038548752835,
      "duration" : 7.443038548752835,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3",
      "voiceCharacter" : "操夢",
      "telop" : "僕はふと気がつくと、足の太ももあたりまで、海水に使った状態になり、その状態で彼女を抱き抱えていた。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seName" : "[SE] 海岸1.mp3",
      "slideTitle" : "スライド #33",
      "seVolume" : 0.1530708016074449,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 33",
      "id" : "84689FA9-450C-478A-ABD4-71374EA40423",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.034.jpeg",
      "seStartTimeOffset" : -92.97312925170068,
      "voiceDuration" : 8.632154195011339,
      "duration" : 8.632154195011339,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3",
      "voiceCharacter" : "操夢",
      "telop" : "彼女は、今の状況を把握したのか、一気に頬が赤く染まる。\n僕は、そんな彼女に、こんな状況になったことを謝る。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seName" : "[SE] 海岸1.mp3",
      "slideTitle" : "スライド #34",
      "seVolume" : 0.1530708016074449,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 34",
      "id" : "867F544B-7A0B-4FEE-B8B3-2475B8677063",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.035.jpeg",
