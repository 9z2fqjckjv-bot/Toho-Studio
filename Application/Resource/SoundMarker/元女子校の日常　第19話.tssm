      "title" : "シーン 53",
      "id" : "D9C0ACB8-1D4E-4622-B1E6-77FC17AC7D2E",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.054.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 3.8908616780045353,
      "duration" : 3.8908616780045353,
      "voiceCharacter" : "操夢",
      "telop" : "「ええ、僕の希望はないので、三人で決めてもらえますか？」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #54",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 54",
      "id" : "158085DE-D159-463A-B805-1FE9628D3C49",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.055.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 4.3059410430839,
      "duration" : 4.3059410430839,
      "voiceCharacter" : "アリス・マーガトロイド",
      "telop" : "「私は、さとりさんとこいしさんが、\n一緒の部屋がいいなら、それで構わないけど…」",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #55",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_アリス・マーガトロイド.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 55",
      "id" : "DD83BEBF-C4CB-4AF1-B461-4F67C0B15D23",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.056.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 2.446984126984127,
      "duration" : 2.446984126984127,
      "voiceCharacter" : "古明地さとり",
      "telop" : "「私は、できるだけこいしと同じ部屋がいいわ…」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #56",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_古明地さとり.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 56",
      "id" : "1C0F0E60-5C1B-4A23-AB10-0F0B622F7CE6",
      "characterName" : "古明地さとり",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.057.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 2.466938775510204,
      "duration" : 2.466938775510204,
      "voiceCharacter" : "操夢",
      "telop" : "「それで、こいしさんは…、どうですか？」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #57",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 57",
      "id" : "C31FA2BE-0A6D-4B76-8F0C-5468641EE1E9",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.058.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 5.825668934240363,
      "duration" : 5.825668934240363,
      "voiceCharacter" : "古明地こいし",
      "telop" : "「私は…」私はそう言いかけて、言葉が止まる。\nそして、ふと彼とエンドレスランをした日のことを思い出す…。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #58",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 58",
      "id" : "C2D1E5AD-BABA-4AE6-9693-FC380EA14C60",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.059.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 6.348820861678004,
      "duration" : 6.348820861678004,
      "voiceCharacter" : "古明地こいし",
      "telop" : "私たちが、走り始めてから、最初の校門を出て曲がるまでは、\n特に問題なく、比較的にスムーズに走れていた。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #59",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 59",
      "id" : "A351A14B-B02E-415E-B818-D4251FEA0A1E",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.060.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.288049886621315,
      "duration" : 7.288049886621315,
      "voiceCharacter" : "古明地こいし",
      "telop" : "だが、1kmあたりを過ぎると、だんだんと、彼と私のペースに翳りが見え始め、後方にいた美鈴先生がその問題を指摘する。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #60",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 60",
      "id" : "6CB241F6-68D7-45C3-A48B-2511B06EC235",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.061.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 6.709183673469388,
      "duration" : 6.709183673469388,
      "voiceCharacter" : "古明地こいし",
      "telop" : "そこまでは、単純に走って疲れて、歩いているだけ、だった。\nだが、歩き始めて少し経つと、彼が急に走り出す。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #61",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 61",
      "id" : "EE6D76CC-0C7F-41F7-B3A6-3AE6D385B972",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.062.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.218979591836734,
      "duration" : 7.218979591836734,
      "voiceCharacter" : "古明地こいし",
      "telop" : "私は、慌てて彼について行こうとすると、彼の手がぶつかる。\n私はあのときドキッとし、そして、口走り、そのまま走り出す。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #62",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 62",
      "id" : "AD8110B7-4A3A-4E1A-B537-11FBAE2AC2BE",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.063.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 6.721746031746032,
      "duration" : 6.721746031746032,
      "voiceCharacter" : "古明地こいし",
      "telop" : "だが、さらに1kmがたつと、今度は足元にある石ころにこける。\nそして、次の瞬間には、彼に抱っこされていた。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #63",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 63",
      "id" : "BE80F333-55F0-402B-84BA-1806AEB8618C",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.064.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 6.355714285714286,
      "duration" : 6.355714285714286,
      "voiceCharacter" : "古明地こいし",
      "telop" : "それからだろうか…、私は、今までの学校生活では全くと言っていいほど、感じなかった気持ちが心から湧き出していた。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #64",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 64",
      "id" : "89A19C83-5DDA-4670-BC1F-4F4A922EE30D",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.065.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.401655328798187,
      "duration" : 8.401655328798187,
      "voiceCharacter" : "古明地こいし",
      "telop" : "私は、ふと意識が現実に戻ると、彼が困った表情で、私の名前を読んでいた。「私は…紅夢と…」私は、続けて言葉を放つ。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #65",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_古明地こいし.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 65",
      "id" : "070982B2-A2EE-422B-AF1B-0C1A33A61DCA",
      "characterName" : "古明地こいし",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.066.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 5.495396825396825,
      "duration" : 5.495396825396825,
      "voiceCharacter" : "古明地さとり",
      "telop" : "「こいし…、一体どんな変化があったのよ…」\n私は、妹が発した予想外なその言葉に、そう返す。",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #66",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_古明地さとり.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 66",
      "id" : "A7937E5D-A9EE-4B36-B857-D75214AC9D98",
      "characterName" : "古明地さとり",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.067.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.010430839002268,
      "duration" : 8.010430839002268,
      "voiceCharacter" : "操夢",
      "telop" : "僕は、こいしの発言に驚きながらも、念の為に、他の二人に確認をとる。「それで、部屋割りはどうしますか？」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
