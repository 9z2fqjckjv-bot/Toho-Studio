      "seStartTimeOffset" : 0,
      "voiceDuration" : 6.8691156462585035,
      "duration" : 6.8691156462585035,
      "voiceCharacter" : "操夢",
      "telop" : "「そうなんですね…、僕は小学生くらいまでは、\n家族で何度か、飛行機に乗って沖縄に行ってましたが…。」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #4",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 4",
      "id" : "81B75EA0-F304-4F27-8A7F-BD2B6A5876AF",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.005.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.00172335600907,
      "duration" : 8.00172335600907,
      "voiceCharacter" : "操夢",
      "telop" : "僕たちが、そんな会話をしていると、機内アナウンスで扉が閉まったことが知らされ、それから少しずつ飛行機は動き始めた。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #5",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 5",
      "id" : "0C67BEF3-5D36-43F3-AE74-77FCFD78209A",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
