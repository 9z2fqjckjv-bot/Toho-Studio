      "voiceDuration" : 7.756077097505669,
      "duration" : 7.756077097505669,
      "voiceCharacter" : "操夢",
      "telop" : "「じゃあ、誰と寝るかは、夕食後に決めるとして、とりあえず今は、僕とこいしさん、さとりさんとアリスさんでいいですか？」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
