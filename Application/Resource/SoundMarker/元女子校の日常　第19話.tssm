    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.070.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 3.456077097505669,
      "duration" : 3.456077097505669,
      "voiceCharacter" : "操夢",
      "telop" : "「今日の昼食は、各自で準備でも構いませんか？」",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #70",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 70",
      "id" : "AAF832E5-9D67-4574-96BE-4E1CB11B9288",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.071.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.054580498866213,
      "duration" : 7.054580498866213,
      "voiceCharacter" : "古明地さとり",
      "telop" : "「それで、構いませんよ。とりあえず、紅夢さんの、風邪を治すのが、先ですし…、ただこいしの発言にも…答えてくれますか？」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #71",
      "transitionName" : "なし",
