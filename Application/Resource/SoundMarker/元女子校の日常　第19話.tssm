      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.048.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 3.1006349206349206,
      "duration" : 3.1006349206349206,
      "voiceCharacter" : "操夢",
      "telop" : "僕たちは、それから、国際通りに向かった。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
