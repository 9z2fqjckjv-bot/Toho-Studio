      "voiceCharacter" : "アリス・マーガトロイド",
      "telop" : "「あの、降ろしてもらえませんか、紅夢さん…」",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "animationName" : "なし",
