      "isCutOffOnSceneEnd" : true,
      "volume" : 1,
      "isReversed" : false,
      "voiceSymbol" : "、\/キョ'ーノ\/チューショクワ、カ'クジデ\/ジュ'ンビデモ\/カマイマセ'ンカ？",
