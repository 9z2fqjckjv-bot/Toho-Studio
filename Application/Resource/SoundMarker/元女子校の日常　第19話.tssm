      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 35",
      "id" : "9E509223-AE1C-4E10-9491-DBF10C7FFF84",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.036.jpeg",
