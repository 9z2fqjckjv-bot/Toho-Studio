    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.002.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.6278231292517,
      "duration" : 7.6278231292517,
      "voiceCharacter" : "古明地こいし",
      "telop" : "「そういえば、アリスさんは、飛行機に乗るのは初めてですか？」僕は、ふと気になったので、彼女にそう尋ねる。\n作成者：zuyasi",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
