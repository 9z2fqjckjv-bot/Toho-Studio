      "title" : "シーン 28",
      "id" : "66D255A0-3B89-4068-BFF3-9E3D9C6B3807",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.029.jpeg",
