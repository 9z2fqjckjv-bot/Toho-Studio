      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_アリス・マーガトロイド.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "title" : "シーン 3: 「いや、学校での修学旅行で何度か、乗ったわ…。」",
      "id" : "CA213D22-6F71-484D-8481-C935DDDAA431",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
