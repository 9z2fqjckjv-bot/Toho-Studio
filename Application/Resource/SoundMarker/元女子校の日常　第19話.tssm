      "slideTitle" : "スライド #48",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 48",
      "id" : "24E2B53D-9E3C-4C8E-9318-9D6731AC5351",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.049.jpeg",
      "seStartTimeOffset" : 0,
      "duration" : 3,
      "telop" : "彼らが国際通りに着くと…",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #49",
      "transitionName" : "なし",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "title" : "シーン 49: 彼らが国際通りに着くと…",
      "id" : "E401D66D-9642-49F8-A65D-291A6C9DD4FE",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.050.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.219115646258503,
      "duration" : 7.219115646258503,
      "voiceCharacter" : "操夢",
      "telop" : "僕たちはそれから、今日と帰る日の前日に泊まるホテルの駐車場に車を停めて、駐車場の中を歩いていた。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #50",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 50",
      "id" : "55C0A53D-153F-4A9F-AD6F-F8F1BD06E63A",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.051.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.373469387755103,
      "duration" : 8.373469387755103,
      "voiceCharacter" : "操夢",
      "telop" : "そして、ホテルのフロントに来ると、旅行券のコピーと、身分証を見せる。すると、部屋のキーカードを受け取り、歩き出す。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #51",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 51",
      "id" : "517C2658-ADEE-4F24-B05B-69895B2E75AD",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.052.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 7.810430839002268,
      "duration" : 7.810430839002268,
      "voiceCharacter" : "操夢",
      "telop" : "「それで、部屋2つありますが、部屋割りはどうしますか？」\n僕は、そうさとり、こいし、アリスの3人に尋ねる。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
