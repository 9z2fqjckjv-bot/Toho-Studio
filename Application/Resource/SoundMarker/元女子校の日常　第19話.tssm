      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 71",
      "id" : "2406EB0D-A3A2-434A-AFD7-E8B449957B54",
      "characterName" : "古明地さとり",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.072.jpeg",
