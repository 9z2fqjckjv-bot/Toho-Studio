      "bgmStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "title" : "シーン 6: 東方Project二次創作作品　Powerd By zuyasi",
      "id" : "1087D098-FB1A-4E1F-9F4C-1218288313ED",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.007.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.577823129251701,
      "duration" : 8.577823129251701,
      "voiceCharacter" : "操夢",
      "telop" : "僕たちは、沖縄につき、空港を出ると、すでに手配済みだったレンタカーに乗り込む。昨日のホテルで手続きは既に済ませた。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #7",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 7",
      "id" : "F3A5528C-B482-45A4-A7D0-7D8FE67D676A",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.008.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 1.7940362811791384,
      "duration" : 1.7940362811791384,
      "voiceCharacter" : "アリス・マーガトロイド",
      "telop" : "「それで、これからどこに向かうの？」",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #8",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_アリス・マーガトロイド.wav",
