      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 43",
      "id" : "E6B34A93-031D-43B4-A650-021DA6EEA5C8",
      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.044.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.745215419501134,
      "duration" : 8.745215419501134,
      "voiceCharacter" : "操夢",
      "telop" : "それから、海中道路を一度渡り切り、Uターンして戻る。\nその最中、彼女が、心配そうな声で、僕に話しかける。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1,
      "slideTitle" : "スライド #44",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav",
