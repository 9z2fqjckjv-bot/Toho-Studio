      "characterName" : "操夢",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.042.jpeg",
      "seStartTimeOffset" : -143.63968253968255,
      "voiceDuration" : 8.549546485260771,
      "duration" : 8.549546485260771,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3",
      "voiceCharacter" : "操夢",
      "telop" : "すると、彼女は足早に車に戻って行った。「えっ…」\n僕は、そう呟いてから、再びくしゃみをすると、車に戻った。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
