      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.003.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 2.8959410430839,
      "duration" : 2.8959410430839,
      "voiceCharacter" : "アリス・マーガトロイド",
      "telop" : "「いや、学校での修学旅行で何度か、乗ったわ…。」",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
