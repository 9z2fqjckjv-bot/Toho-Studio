      "duration" : 8.934331065759638,
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/車のエンジンをかける1.mp3",
      "voiceCharacter" : "操夢",
      "telop" : "僕は、車に戻ると、元々座っていた助手席に座り、シートベルトを締める。そして、彼女はそれから車のエンジンをつける。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
