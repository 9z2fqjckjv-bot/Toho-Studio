      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_アリス・マーガトロイド.wav",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 68",
      "id" : "52D7225E-841E-4F2E-A195-502ED77F1BB0",
      "characterName" : "アリス・マーガトロイド",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第19話_37b78f5790\/元女子校の日常　第19話_37b78f5790.069.jpeg",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 8.773469387755101,
      "duration" : 8.773469387755101,
      "voiceCharacter" : "操夢",
      "telop" : "僕は、アリスのその指摘で思い出す。「確かにそうですね…」\n僕は、そう言いながら、考える。だが、くしゃみが再び出る。",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
