      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "フランドール・スカーレット",
      "telop" : "「紅夢、しっかりして！このことは、あなたの妻である私の責任でもあるし、そこら辺はちゃんと責任を果たすから！」",
      "voiceCharacter" : "フランドール・スカーレット",
      "id" : "4602B298-A681-4D9C-8108-695FDA37737F",
      "voice2StartTimeOffset" : 0,
