      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav",
      "voiceDuration" : 8.510430839002268,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "すると、こいしが僕に抱きつく形で眠っていた。そして、ふと昨晩の記憶を思い出そうとしていると、誰かの視線を感じる。",
      "voiceCharacter" : "操夢",
      "id" : "5DAB960A-D350-4EFC-8166-EAFCF0292E86",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/帽子なしバトルっぽい目閉じ口閉じ.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
