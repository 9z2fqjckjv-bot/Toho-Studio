      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「まぁ、いいや。とにかく、アレを漏らしたお二人さんの介護、手伝って、それが済んだら、思う存分頭を撫でてあげるから。」",
      "voiceCharacter" : "操夢",
      "id" : "327D1AAB-B685-4078-AD47-C68BAB16DA7E",
      "voice2StartTimeOffset" : 0,
