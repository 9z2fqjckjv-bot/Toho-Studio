      "duration" : 5.646303854875283,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.033.jpeg",
      "bgmStartTimeOffset" : 0,
      "bgmName" : "BGM: video",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "大学院まで完走した24歳。",
      "voice2StartTimeOffset" : 0,
      "id" : "4CC41AC0-FA07-4DD6-A324-A5FF029332FB",
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png",
      "duration" : 5,
      "title" : "シーン 32: 大学院まで完走した24歳。",
      "bgmAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/video.mp4",
      "slideTitle" : "スライド #32",
      "animationName" : "なし",
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.25621307237813884
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.034.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "voiceDuration" : 7.550634920634921,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は食事を終えて、夜の10時ごろに、酔いが全身に巡り巡って、赤くになったレミリアとフランを連れて帰ってきた。",
      "voiceCharacter" : "操夢",
      "id" : "D2E6DCDC-3D09-4C61-B607-7478CE0E7971",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/よったニヤケ顔.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 33: シーン 34",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #33",
      "animationName" : "なし",
      "duration" : 7.550634920634921,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.035.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav",
      "voiceDuration" : 7.495850340136054,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "すると、僕はある嫌な予感がする。そこで僕は、食事前にパチュリーからもらっていたある液体を二人に飲ます。",
      "voiceCharacter" : "操夢",
      "id" : "97A1A3CD-458B-438B-BDBC-B8DCD075A60E",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/よったニヤケ顔.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 34: シーン 35",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #34",
      "animationName" : "なし",
      "duration" : 7.495850340136054,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.036.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "voiceDuration" : 8.547369614512471,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "そして、その予感は見事に的中し、二人は料理が口に逆走しなかったはいいものの、二人の下にはある液体が垂れ流れていた。",
      "voiceCharacter" : "操夢",
      "id" : "854F2EAB-A4C7-418E-B720-C12AC987A055",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/よったニヤケ顔.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 35: シーン 36",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #35",
      "animationName" : "なし",
      "duration" : 8.547369614512471,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.037.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_パチュリー・ノーレッジ.wav",
      "voiceDuration" : 6.11922902494331,
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "「これ、あなたが開発した、アルコール排出促進剤。\n二人が酔い潰れそうだったら、その前に飲ませて。」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "id" : "49600702-B648-415A-8E26-173479591BAA",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg",
      "title" : "シーン 36: シーン 37",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "slideTitle" : "スライド #36",
      "animationName" : "なし",
      "duration" : 6.11922902494331,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.038.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_パチュリー・ノーレッジ.wav",
      "voiceDuration" : 5.534557823129251,
      "backgroundName" : "nc228271_居酒屋の個室.jpg",
      "transitionName" : "なし",
      "characterName" : "パチュリー・ノーレッジ",
      "telop" : "「ただし、ゲロを吐くことはないけど、その代わりにアルコールがそのまま混じったアレがスカートから出てくるから。」",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "id" : "E1573E39-7EA6-4452-A68B-53577B93FD4F",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg",
      "title" : "シーン 37: シーン 38",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "slideTitle" : "スライド #37",
      "animationName" : "なし",
      "duration" : 5.534557823129251,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.039.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "voiceDuration" : 8.040430839002267,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、自分たちがアレを出していることに気がつかない二人をじっと見る…。ちなみにその薬の別名は、赤ちゃん薬だった。",
      "voiceCharacter" : "操夢",
      "id" : "D448ACB9-0472-48FF-BA46-B200A24ACEF6",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/よったニヤケ顔.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 38: シーン 39",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #38",
      "animationName" : "なし",
      "duration" : 8.040430839002267,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.040.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_古明地こいし.wav",
      "voiceDuration" : 4.28562358276644,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "telop" : "「ねぇ、二人を素っ裸にして、何する気なの？」",
      "voiceCharacter" : "古明地こいし",
      "id" : "7951415A-CE9D-44AB-BBAF-ED2EF34C7982",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/頬照りジト目あわわ.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 39: シーン 40",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "slideTitle" : "スライド #39",
      "animationName" : "なし",
      "duration" : 4.28562358276644,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.041.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "voiceDuration" : 6.675646258503401,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「こいし…、ちょっと手伝って、酔いが回って、アレを漏らしちゃったお二人さんを、浴室に連行するから。」",
      "voiceCharacter" : "操夢",
      "id" : "E86D6858-5403-45B4-829D-4C3021E4B4D6",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/頬照りジト目あわわ.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 40: シーン 41",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #40",
      "animationName" : "なし",
      "duration" : 6.675646258503401,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.042.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地こいし.wav",
      "voiceDuration" : 10.031473922902494,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "telop" : "「はぁ？何言ってるの、あんた。言っておくけど、私は二人の下のお世話なんてしないから、あんた一人でしてね。」",
      "voiceCharacter" : "古明地こいし",
      "id" : "310F3368-4FA6-475B-A852-1A16BEDA2C4F",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/パジャマ頬照り不満.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 41: シーン 42",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "slideTitle" : "スライド #41",
      "animationName" : "なし",
      "duration" : 10.031473922902494,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.043.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
      "voiceDuration" : 7.373469387755102,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「もしかして、こいし…、やけ酒してた？」\n僕は、彼女が普段呼びない呼び方で、僕を呼んだのでそう聞く。",
      "voiceCharacter" : "操夢",
      "id" : "443A4834-2FCD-4C90-9BBF-E95EB9F995B5",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/パジャマ頬照り不満.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 42: シーン 43",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #42",
      "animationName" : "なし",
      "duration" : 7.373469387755102,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.044.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_古明地こいし.wav",
      "voiceDuration" : 5.28562358276644,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "telop" : "「くっ…、一人で寂しくて、お酒で濁してたのよ、私…」",
      "voiceCharacter" : "古明地こいし",
      "id" : "2B660DF9-7810-409F-BFF7-DE852A20AFF3",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
