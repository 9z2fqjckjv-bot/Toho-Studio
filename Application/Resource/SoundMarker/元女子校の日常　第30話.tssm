    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.058.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_古明地こいし.wav",
      "voiceDuration" : 9.473469387755102,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "古明地こいし",
      "telop" : "「私は、お兄ちゃんと一緒に過ごしていれば、安心できるし、いっぱい甘えて、頼れるから、それでいいと思うよ。」",
      "voiceCharacter" : "古明地こいし",
      "id" : "E28865F8-74DD-4683-A789-AEFE980025EF",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 57: シーン 58",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "slideTitle" : "スライド #57",
      "animationName" : "なし",
      "duration" : 9.473469387755102,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.059.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "voiceDuration" : 8.101723356009071,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、こいしの言葉にどこか安心感を覚える。別にこいしが好きなんじゃない、ただその安心という言葉の響きがいいのだ…。",
      "voiceCharacter" : "操夢",
      "id" : "B6851FF1-E4DF-4428-A449-92FEE54CFF24",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 58: シーン 59",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #58",
      "animationName" : "なし",
      "duration" : 8.101723356009071,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.060.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav",
      "voiceDuration" : 7.401723356009071,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、自分自身のフランやこいしに対する気持ちや考え方がわからなくなり、困っていると、レミリアの声がする。",
      "voiceCharacter" : "操夢",
      "id" : "E5485E3C-38B1-44D7-B858-04FBEFD8B644",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 59: シーン 60",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #59",
      "animationName" : "なし",
      "duration" : 7.401723356009071,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.061.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_レミリア・スカーレット.wav",
      "voiceDuration" : 7.415079365079365,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "「ねぇ、あなたとこいしは互いの存在に依存する共依存じゃないかしら…、もしあなたが彼女の発言に安心してたらだけど…」",
      "voiceCharacter" : "レミリア・スカーレット",
      "id" : "E3433B16-EE1D-4322-9864-2427ADA5B09A",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/影あり驚き後ろ手.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 60: シーン 61",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "slideTitle" : "スライド #60",
      "animationName" : "なし",
      "duration" : 7.415079365079365,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.062.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
      "voiceDuration" : 8.757165532879819,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、レミリアの発言に、なぜか納得してしまった。そして、こうつぶやく。「確かに、レミリアさんの意見が正しいです…」",
      "voiceCharacter" : "操夢",
      "id" : "61C25C9A-F881-4046-B4C0-B79BC498736A",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/影あり驚き後ろ手.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 61: シーン 62",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #61",
      "animationName" : "なし",
      "duration" : 8.757165532879819,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.063.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "voiceDuration" : 8.473469387755102,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "それから、四人の間には、これまでに感じたことのない冷たく気まずい空気が漂い出す。そして、沈黙の時間が流れる。",
      "voiceCharacter" : "操夢",
      "id" : "E5ADEA73-9C60-44DF-9175-F84BC893AE86",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/影あり驚き後ろ手.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 62: シーン 63",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #62",
      "animationName" : "なし",
      "duration" : 8.473469387755102,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.064.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_レミリア・スカーレット.wav",
      "voiceDuration" : 7.054648526077098,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "レミリア・スカーレット",
      "telop" : "「それで、これからどうするの？あなたの意見を聞かせてもらえないかしら…。じゃないと来月からの予定が狂うのよ。」",
      "voiceCharacter" : "レミリア・スカーレット",
      "id" : "1671D07E-2A96-43CD-AFE0-71C1B98917CD",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/影あり驚き後ろ手.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 63: シーン 64",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "slideTitle" : "スライド #63",
      "animationName" : "なし",
      "duration" : 7.054648526077098,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.065.jpeg",
