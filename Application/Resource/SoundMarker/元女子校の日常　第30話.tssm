      "characterName" : "操夢",
      "telop" : "そして、彼女は僕に駆け寄ってくると、僕にビンタをした。",
      "voiceCharacter" : "操夢",
      "id" : "F21F8190-8BEF-4404-A8DA-EBB427827B44",
