      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "すると、そこには頬が赤らみ、驚いているフランがいた。\n「あっ、しまった…」僕は、ふとそう呟く。",
      "voiceCharacter" : "操夢",
      "id" : "B61D0D83-592F-4D76-AD27-717B52012A60",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png",
