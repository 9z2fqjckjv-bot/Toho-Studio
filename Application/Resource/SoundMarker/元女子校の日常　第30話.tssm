      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #6",
      "animationName" : "なし",
      "duration" : 8.390861678004535,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.007.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "voiceDuration" : 7.307165532879819,
      "backgroundName" : "ペーストされた画像.tiff",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕が校門を出ると、そこには頬が赤らみ、涙を見せるフランの姿があった。「なんで、泣いているんですか。」",
      "voiceCharacter" : "操夢",
      "id" : "C45FFDC7-7979-41FA-A001-68B7AB0E8B4F",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/泣き笑い.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff",
      "title" : "シーン 7",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #7",
      "animationName" : "なし",
      "duration" : 7.307165532879819,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.008.jpeg",
