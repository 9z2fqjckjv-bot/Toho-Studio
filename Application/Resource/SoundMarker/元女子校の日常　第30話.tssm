      "voiceDuration" : 7.316938775510204,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「僕は…、この関係が壊れるのは嫌で、フランさんと離婚したくない…、でも、これは僕の単なるわがままですよ…。」",
      "voiceCharacter" : "操夢",
      "id" : "7523A5F5-6669-4428-9C35-41A3CB7DB2D9",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
