      "backgroundName" : "2026-10-04_16-42.png",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "それから卒業式を終えた僕たちは、教室に戻る。そして僕は、担任からの一言と終礼が終わると、校門に向かう。",
      "voiceCharacter" : "操夢",
      "id" : "42A33107-2AE4-43DB-892F-F84D8981E41A",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png",
