      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「確かにフランのいう通りですね…、このままだといけないのは僕も分かっているので、誰にも依存しないようにしますよ…」",
      "voiceCharacter" : "操夢",
      "id" : "FF782136-D38D-4084-8E30-7AF63FDC0BA8",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
