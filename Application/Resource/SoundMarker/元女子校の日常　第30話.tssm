      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「ふっ…」僕は、彼女の言動に思わず、そう笑い出してしまう。\n「あれ…酔ってないつもりだけど、酒が回ってきたのかな…」",
      "voiceCharacter" : "操夢",
      "id" : "6ED235B8-0A00-4CAA-A660-C0925AE7917E",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
