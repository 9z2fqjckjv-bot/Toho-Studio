      "backgroundName" : "ペーストされた画像.tiff",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「そうですか…、とりあえず、帰りませんか？」\n僕がそう聞くと、彼女は頷き、僕たちは帰宅する。",
      "voiceCharacter" : "操夢",
