      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.068.jpeg",
