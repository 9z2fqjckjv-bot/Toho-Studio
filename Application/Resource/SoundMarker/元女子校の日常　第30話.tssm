      "animationName" : "なし",
      "duration" : 7.316938775510204,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第30話_2da2fb8867\/元女子校の日常　第30話_2da2fb8867.066.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav",
      "voiceDuration" : 8.238684807256236,
      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いパンチ1.mp3",
      "characterName" : "操夢",
      "telop" : "僕は、それからしばらくの間、冷えた笑いに溢れかえる。\nだが、フランが僕の頬を強く叩き、僕はハッと我に帰る。",
      "voiceCharacter" : "操夢",
      "id" : "EC231DE2-8A06-4E30-97C6-C242DDA816A1",
      "voice2StartTimeOffset" : 0,
