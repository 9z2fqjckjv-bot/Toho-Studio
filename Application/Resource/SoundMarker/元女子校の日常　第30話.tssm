      "backgroundName" : "nc213186_紅魔館ロビー.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「んっ…」僕はふと目が覚めると、そこは家の玄関ホールだった。そして、ある感触がし、ふとそれを見る。",
      "voiceCharacter" : "操夢",
      "id" : "0EC037CE-DFE1-4737-BC00-BC3904B8F4EF",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg",
      "title" : "シーン 49: シーン 50",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #49",
      "animationName" : "なし",
      "duration" : 7.348458049886621,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
