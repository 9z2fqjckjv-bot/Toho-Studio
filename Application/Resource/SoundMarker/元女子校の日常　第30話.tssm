      "backgroundName" : "nc107556_紅魔的館内.jpg",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "「ええ、そうですね。」それから僕とレミリアとフランは、\n食事に出かけていくのだった。",
      "voiceCharacter" : "操夢",
      "id" : "0057E5EF-84B2-4D8D-9EA3-6DC6B2A52E32",
      "voice2StartTimeOffset" : 0,
