      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 25",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "id" : "5B052108-B662-43E4-97C5-32D7C134EE3E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_フランドール・スカーレット.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「知りたいですか…？」\n僕はそう洗い物をしながら、尋ねる。",
      "voiceDuration" : 4.010430839002267,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #26",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.026.jpeg",
