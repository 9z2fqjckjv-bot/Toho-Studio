      "duration" : 3.5,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 17",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "id" : "EB2493E1-B803-4D71-955C-D5560FE584E5",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_フランドール・スカーレット.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「わかりました、それでは僕は先に、向こうで待ってますね。」",
      "voiceDuration" : 3.98,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #18",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.018.jpeg",
      "duration" : 4.58,
      "characterName" : "操夢",
      "title" : "シーン 18",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "15F023D2-B9B0-432F-9E91-F0B944B0817C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕は、リビングに来ると、キッチンに向かい、冷凍庫から冷凍ご飯を出すと、レンジにかけ、その間に醤油とお椀を２つ取り出す。",
      "voiceDuration" : 8.595215419501134,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #19",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.019.jpeg",
      "duration" : 9.195215419501134,
      "characterName" : "操夢",
      "title" : "シーン 19",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "C02EDC54-F33F-447C-8649-B25FFF377A0A",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "そして、レンチンが終わると、ご飯をお椀に入れ、冷蔵庫から卵を取り出し、卵を割って、ご飯に乗せ、醤油をかける。",
      "voiceDuration" : 8.141950113378686,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #20",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.020.jpeg",
      "duration" : 8.741950113378685,
      "characterName" : "操夢",
      "title" : "シーン 20",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "908E940F-0891-4CEB-8A57-126CFED36D39",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "そして、出来上がった卵かけご飯をテーブルに置くと、箸を取り出し、乗せる。そこまで終わると、ちょうどよく彼女も来た。",
      "voiceDuration" : 8.339342403628118,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #21",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.021.jpeg",
      "duration" : 8.939342403628117,
      "characterName" : "操夢",
      "title" : "シーン 21",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "2D7FE2D1-28D3-42D9-A21C-F07BBD219B99",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "私がリビングに来ると、すでに食卓には朝食があった。\n「…朝ごはん…作ってくれてありがとう…」",
      "voiceDuration" : 7.230748299319728,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #22",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.022.jpeg",
      "duration" : 7.830748299319728,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 22",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "id" : "FA21184E-E3BD-4858-B1A9-47904A5AB481",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "彼女の言葉にニコッと笑みを僕は返し、挨拶を済ませて、卵かけご飯を体内に放り込み始める。それは、５分少々で終わった。",
      "voiceDuration" : 9.274557823129252,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #23",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.023.jpeg",
      "duration" : 9.874557823129251,
      "characterName" : "操夢",
      "title" : "シーン 23",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "F21AA693-AC89-4A8B-92BF-E261C4BF09EC",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "そして、フランのお椀を見ると、彼女も食べきっているようで、僕はお椀と箸を全てキッチンのシンクに入れ、洗い物をする。",
      "voiceDuration" : 7.8408616780045355,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #24",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.024.jpeg",
      "duration" : 8.440861678004536,
      "characterName" : "操夢",
      "title" : "シーン 24",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "E6ACEE49-D8DA-4405-B706-FC560A849084",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc268704_リビング２（日中）.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「ねぇ、昨晩…私は何を君にしたの…？」",
      "voiceDuration" : 3.606984126984127,
      "backgroundName" : "nc268704_リビング２（日中）.jpg",
      "slideTitle" : "スライド #25",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.025.jpeg",
