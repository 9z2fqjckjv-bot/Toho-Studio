  "scenes" : [
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "私は、その夜、血が飲みたくなり、真夜中の夜道を出歩いてた。\nそんな中、向こうにふと、人影が見えてくる。\n東方Project二次創作作品",
      "voiceDuration" : 9.399478458049886,
      "backgroundName" : "nc367700_住宅街２（夜・照明ON）.pxd",
      "slideTitle" : "スライド #1",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.001.jpeg",
      "duration" : 9.999478458049886,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 1",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_フランドール・スカーレット.wav",
      "id" : "C6114DD5-80A5-424C-94DF-745AE45D174F"
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/効果音\/噛みつく.mp3",
      "telop" : "私は、その人影に密かに近づき、\nその人の背中にピタッとつくと、その人の首筋に噛み付く。\n作成者：zuyasi",
      "voiceDuration" : 8.066984126984128,
      "backgroundName" : "nc367700_住宅街２（夜・照明ON）.pxd",
      "slideTitle" : "スライド #2",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.002.jpeg",
      "duration" : 8.666984126984127,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 2",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_フランドール・スカーレット.wav",
      "id" : "38DBB396-78E3-443B-853E-4B8D85433ADE",
      "seName" : "SE: 噛みつく"
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "だが、その人…彼からふと笑い声が漏れる…「なんで…笑っているの…」",
      "voiceDuration" : 5.449478458049887,
      "backgroundName" : "nc367700_住宅街２（夜・照明ON）.pxd",
      "slideTitle" : "スライド #3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.003.jpeg",
      "duration" : 6.049478458049887,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 3: だが、その人…彼からふと笑い声が漏れる…\n「なんで…笑っているの…」",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_フランドール・スカーレット.wav",
      "id" : "A646BCD4-2A5A-4E49-B1A9-CED182D69463"
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "私がそう彼に問うと、彼は、あることを呟く。\n作成ソフト\nKeynote\nTohoStudio",
      "voiceDuration" : 3.941995464852608,
      "backgroundName" : "nc367700_住宅街２（夜・照明ON）.pxd",
      "slideTitle" : "スライド #4",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.004.jpeg",
      "duration" : 4.541995464852608,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 4",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav",
      "id" : "443841EA-32F8-4EC1-A1DA-13A351E55616"
    },
    {
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「今更ですけど、僕の血は飲まない方が、身のためですよ。」\n僕は、血が出ていく感覚に身を包まれながら、そう呟いた。",
      "voiceDuration" : 8.55607709750567,
      "backgroundName" : "nc367700_住宅街２（夜・照明ON）.pxd",
      "slideTitle" : "スライド #5",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.005.jpeg",
      "duration" : 9.15607709750567,
      "characterName" : "操夢",
      "title" : "シーン 5",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "id" : "6B71321F-AC04-4E8E-B18B-BB22165EA3F9"
    },
    {
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "そう彼は呟くと、フラフラとした状態になる。私は、このままだと、彼が頭を打つかもと感じ…勝手に体が動き、彼を支えた。",
      "voiceDuration" : 11.164489795918367,
      "backgroundName" : "nc367700_住宅街２（夜・照明ON）.pxd",
      "slideTitle" : "スライド #6",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.006.jpeg",
      "duration" : 11.764489795918367,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 6",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_フランドール・スカーレット.wav",
      "id" : "5762FE89-9AB3-4076-AA04-E28F8C1870BA"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.007.jpeg",
      "slideTitle" : "スライド #7",
      "transitionName" : "なし",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/1話目_66104b0c58\/slide_007_anim.m4v",
      "characterName" : "博麗霊夢",
      "duration" : 3,
      "title" : "シーン 7: 東方Project二次創作　Powerd By zuyasi",
      "backgroundName" : "単色背景",
      "animationName" : "バウンス",
      "telop" : "吸血鬼の私と変わり者の君",
      "id" : "9959E5DF-CB7D-498C-9375-8B2D7D136AD2"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「んっ…」\n私はふと目が覚めると、そこはベッドの上だった。",
      "voiceDuration" : 4.520748299319728,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.008.jpeg",
      "duration" : 5.120748299319728,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 8",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "id" : "C4C9E68F-5CD5-4F9D-84F6-57C697778AE8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕は、ふと先ほど目覚めたベッドのある部屋に戻ると、\n彼女に名前を聞く。「名前はなんですか？」",
      "voiceDuration" : 6.449546485260771,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #9",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.009.jpeg",
      "duration" : 7.0495464852607705,
      "characterName" : "操夢",
      "title" : "シーン 9",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "E40574D3-FE86-42AE-B5F9-1FF38EA0A29A",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「私の名前…、フランドールスカーレット、フランでいいよ。」",
      "voiceDuration" : 4.220748299319728,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #10",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.010.jpeg",
      "duration" : 4.820748299319727,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 10",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "id" : "CCE7927E-C2D7-4D63-AE33-8C343BF924A1",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_フランドール・スカーレット.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「僕のことは…、『君』とでも呼んでください。」",
      "voiceDuration" : 2.716938775510204,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #11",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.011.jpeg",
      "duration" : 3.5,
      "characterName" : "操夢",
      "title" : "シーン 11",
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "id" : "DD8F6D8E-2E43-4EF2-B038-0502AFA50C15",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「そう…、ここは私の部屋だけど…なんで君がいるの？」",
      "voiceDuration" : 4.149478458049886,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #12",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/1話目_66104b0c58\/1話目_66104b0c58.012.jpeg",
      "duration" : 4.749478458049886,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 12",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "animationName" : "なし",
      "id" : "3BFADC35-0BBF-4BB0-85CE-0F4CC3E5818D",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_フランドール・スカーレット.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「フランさんは、昨晩の真夜中に通りすがりの僕に、\n噛みついて…血を吸ったのを覚えてますか？」",
      "voiceDuration" : 6.271292517006803,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #13",
