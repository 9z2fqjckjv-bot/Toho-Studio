      "transitionName" : "なし",
      "telop" : "「あら、目が覚めましたか、さっき、\n連れの女性が、出口の方に走って行きましたよ。」",
      "slideTitle" : "スライド #8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_古明地さとり.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd",
