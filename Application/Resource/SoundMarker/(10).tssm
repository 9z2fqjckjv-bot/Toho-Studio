      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.004.jpeg",
      "transitionName" : "なし",
      "telop" : "「あれ、私はなんでこんなところに…」\nそう呟きながら、ふと隣を見る。\n作成ソフト\nKeynote\nTohoStudio",
      "slideTitle" : "スライド #4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 5.674489795918367,
      "duration" : 6.274489795918367
    },
    {
      "characterName" : "フランドール・スカーレット",
      "animationName" : "なし",
      "title" : "シーン 5",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "7CAD6A31-A8B2-4F98-A987-4BC70EE17C48",
      "voiceCharacter" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.005.jpeg",
      "transitionName" : "なし",
      "telop" : "そして私は、彼の姿を見て、ふと全てを思い出す。\n「ごめん…」私はそう呟くと、ベッドから降り、部屋を出た。",
      "slideTitle" : "スライド #5",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_フランドール・スカーレット.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 9.349478458049887,
      "duration" : 9.949478458049887
    },
