      "transitionName" : "なし",
      "telop" : "そして、ふと横を見る。すると、そこにはすやすや眠るフランの寝顔があった。僕は、彼女を起こさないように起き上がる。\n作成者：zuyasi",
      "slideTitle" : "スライド #2",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 8.226734693877551,
      "duration" : 8.826734693877551
    },
    {
      "characterName" : "フランドール・スカーレット",
      "animationName" : "なし",
      "title" : "シーン 3: 「んっ…」私は、そう呟きながら、目が覚める。",
      "backgroundName" : "単色背景",
      "id" : "14521BD4-3782-473C-90BA-1DE172A95E3D",
      "voiceCharacter" : "フランドール・スカーレット",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.003.jpeg",
      "transitionName" : "なし",
      "telop" : "「んっ…」私は、そう呟きながら、目が覚める。",
      "slideTitle" : "スライド #3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_フランドール・スカーレット.wav",
      "voiceDuration" : 4.129478458049887,
      "duration" : 4.729478458049886
    },
    {
      "characterName" : "フランドール・スカーレット",
      "animationName" : "なし",
      "title" : "シーン 4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
