      "slideTitle" : "スライド #49",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「もし、あなたが彼女を抱いたまま、前に進めば、特別に、二人とも完走したことにしましょう、それでいいですか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_美鈴.wav",
      "duration" : 5.905963718820861,
      "animationName" : "なし",
