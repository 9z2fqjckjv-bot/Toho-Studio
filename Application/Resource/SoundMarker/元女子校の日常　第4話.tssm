      "title" : "シーン 68",
      "voiceDuration" : 7.245215419501133,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/打撃1.mp3"
    },
    {
      "id" : "B2828364-CB86-4C0B-B2F3-E4A55409FE08",
      "slideTitle" : "スライド #69",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「私の妹が、あなたにご迷惑かけたようで申し訳ありません。」\n私は、そう彼女に返す。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_レミリア・スカーレット.wav",
      "duration" : 7.065079365079365,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.069.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 69",
      "voiceDuration" : 6.465079365079365,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "96D6FB17-0471-4FCE-A10C-CE4DF81DBF8E",
      "slideTitle" : "スライド #70",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「いえいえ、迷惑ではありませんよ、彼女が暴走する前に、食い止めることができましたから。それで、あなたたちの名前は…」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_070_レミリア・スカーレット.wav",
      "duration" : 8.598412698412698,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.070.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 70",
      "voiceDuration" : 8.351723356009071,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "620DDB93-B988-4710-82C2-AF76B087B387",
      "slideTitle" : "スライド #71",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「私の名前は、レミリア・スカーレット、その妹の名前はフランドール・スカーレットと言います。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_レミリア・スカーレット.wav",
      "duration" : 6.1748979591836735,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.071.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 71",
      "voiceDuration" : 5.574897959183674,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "28A57350-CFCE-4E5C-A632-B2A54E24206A",
      "slideTitle" : "スライド #72",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「ご存知かもしれませんが、彼女は建物を一言で破壊できる才の持ち主で、私たちは紅魔建設を営んでいます。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_レミリア・スカーレット.wav",
      "duration" : 8.290068027210884,
