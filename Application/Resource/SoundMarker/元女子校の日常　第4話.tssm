      "title" : "シーン 52",
      "characterName" : "ナレーション"
    },
    {
      "id" : "8EF512A5-D2D7-4D0D-AB30-196CEFEA13FA",
      "slideTitle" : "スライド #53",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕はふと目が覚めると、そこは学校の保健室だった。僕は、ゆっくりとベッドから降りると、隣に人が寝てることに気づく。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
