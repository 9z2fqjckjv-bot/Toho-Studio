      "slideTitle" : "スライド #65",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「それじゃあ、いただっきまーす！」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
