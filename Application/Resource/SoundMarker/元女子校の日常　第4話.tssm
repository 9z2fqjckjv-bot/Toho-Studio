  "scenes" : [
    {
      "id" : "44E474A2-0E91-41C0-A43B-18F5625AFB9C",
      "slideTitle" : "スライド #1",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「ん…」僕はふと目が覚めると、\n朝日が登り、窓から日光が差し込んでいた。\n東方Project二次創作作品",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav",
      "duration" : 5.786507936507936,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.001.jpeg",
      "backgroundName" : "nc256896_病室-昼.png",
      "title" : "シーン 1",
      "voiceDuration" : 5.186507936507937,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "CCE02213-6F26-4169-B9EB-12D9E808BD45",
      "slideTitle" : "スライド #2",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "そして、僕は大きく背伸びしてあくびをすると、誰かが部屋の戸を叩く。「入ってきて大丈夫ですよ。」僕はそう返す。\n作成者：zuyasi",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "duration" : 8.6756462585034,
      "animationName" : "なし",
      "seName" : "SE: 木のドアをノック1",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.002.jpeg",
      "backgroundName" : "nc256896_病室-昼.png",
      "title" : "シーン 2",
      "voiceDuration" : 8.0756462585034,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3"
    },
    {
      "id" : "D6A92701-02DB-4A70-AD65-F5041B7A333B",
      "slideTitle" : "スライド #3",
      "voiceCharacter" : "てゐ",
      "transitionName" : "なし",
      "telop" : "「今朝は、よく眠れましたか、こうむさん。？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_てゐ.wav",
      "duration" : 3.1222902494331066,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.003.jpeg",
      "backgroundName" : "nc256896_病室-昼.png",
      "title" : "シーン 3: 「今朝は、よく眠れましたか、紅夢さん。？」",
      "voiceDuration" : 2.5222902494331065,
      "audioTrack" : "track_voice_%E3%81%A6%E3%82%90",
      "characterName" : "てゐ"
    },
    {
