      "slideTitle" : "スライド #83",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「ええ分かりました。」\n私はそういうと、フランを抱え、レミリアについていった。",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_083_フランドール・スカーレット.wav",
      "duration" : 6.553242630385487,
