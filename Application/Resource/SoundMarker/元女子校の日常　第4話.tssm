      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「そうですか。」僕はそう返し、呼吸を整えながら、ペースを彼女に合わせてあげていく。するとペースが少し上がっていく。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "duration" : 8.916938775510204,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.043.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 43",
      "voiceDuration" : 8.316938775510204,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
