      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 53",
      "voiceDuration" : 8.496303854875283,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "122FE77C-F098-40CC-B1D3-8E66B0B153B8",
      "slideTitle" : "スライド #54",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "彼女は、恥ずかしいそうな表情の状態で寝ていた。\n僕は、彼女を起こさないようにそっと保健室を出る。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "duration" : 7.664761904761904,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.054.jpeg",
