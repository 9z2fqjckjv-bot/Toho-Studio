      "duration" : 5.049478458049887,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.059.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 59",
      "voiceDuration" : 4.449478458049887,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット"
    },
    {
