      "slideTitle" : "スライド #4",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「はい。それで、これから検査…ですか？」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "duration" : 3.790861678004535,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.004.jpeg",
      "backgroundName" : "nc256896_病室-昼.png",
      "title" : "シーン 4",
      "voiceDuration" : 3.190861678004535,
      "audioTrack" : "track_voice_soumu",
