      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「それで…」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_レミリア・スカーレット.wav",
      "duration" : 3.5,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.076.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 76",
      "voiceDuration" : 1.5,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "6E59E33F-45B6-4049-A716-FFAB1C4EE294",
      "slideTitle" : "スライド #77",
      "voiceCharacter" : "ナレーション",
      "transitionName" : "なし",
      "telop" : "「秘密保持契約で、口外は厳禁って言ったところですか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_ナレーション.wav",
      "duration" : 4.525646258503401,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.077.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 77",
      "voiceDuration" : 3.9256462585034013,
      "audioTrack" : "track_voice__1882",
      "characterName" : "ナレーション"
    },
    {
      "id" : "A3D14084-39DF-4149-8E1A-F42F75B5A188",
      "slideTitle" : "スライド #78",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「ええ、今この場で、口頭による契約成立とみなしていただき、今後、この事実が口外控えていただけますか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_レミリア・スカーレット.wav",
      "duration" : 7.954648526077097,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.078.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 78",
      "voiceDuration" : 7.3546485260770975,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "453F7567-457F-40B9-85E5-05F4DB543C3E",
      "slideTitle" : "スライド #79",
      "voiceCharacter" : "ナレーション",
      "transitionName" : "なし",
      "telop" : "「承知しました、それで、この学園に来たのは、単純な深夜徘徊ではありませんよね。妹さんが入口を破壊してるだろうし…」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_ナレーション.wav",
      "duration" : 9.360430839002268,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.079.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 79",
      "voiceDuration" : 8.760430839002268,
      "audioTrack" : "track_voice__1882",
      "characterName" : "ナレーション"
    },
    {
      "id" : "EDF21E2B-2A7F-4322-B871-67B738280EFF",
      "slideTitle" : "スライド #80",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「ええ、これから、私は、妹が破壊した入口を修復するための手筈を取る予定です。それで、あなたはどうしますか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_レミリア・スカーレット.wav",
      "duration" : 8.70673469387755,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.080.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 80",
      "voiceDuration" : 8.10673469387755,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "4662DF89-EEDC-429A-9383-5A8D5E93AB5C",
      "slideTitle" : "スライド #81",
      "voiceCharacter" : "ナレーション",
      "transitionName" : "なし",
      "telop" : "「そのついでに、食事の用意もできないでしょうか、私、今日、\nいや昨日のお昼から、何も食べてないんです。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_ナレーション.wav",
      "duration" : 8.040861678004536,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.081.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 81",
      "voiceDuration" : 7.440861678004535,
      "audioTrack" : "track_voice__1882",
      "characterName" : "ナレーション"
    },
    {
      "id" : "7C0B4083-920E-4459-90F0-3488263F2302",
      "slideTitle" : "スライド #82",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「分かりました、それくらいはお安いご用です。では、私と一緒に、その妹を抱えてきていただけますでしょうか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_レミリア・スカーレット.wav",
      "duration" : 8.085895691609977,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.082.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 82",
      "voiceDuration" : 7.4858956916099775,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
