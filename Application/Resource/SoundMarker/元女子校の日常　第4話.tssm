      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕に抱っこされたこいしを見ると、恥ずかしいそうに身を丸くしていた。僕は、前を向き、再び走り始めた。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav",
      "duration" : 8.08,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.051.jpeg",
