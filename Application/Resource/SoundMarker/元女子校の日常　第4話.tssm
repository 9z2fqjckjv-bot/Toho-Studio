      "duration" : 4.795215419501133,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.064.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 64",
      "voiceDuration" : 4.1952154195011335,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
