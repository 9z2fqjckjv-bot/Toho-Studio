    },
    {
      "id" : "046315D7-9D73-4D48-BA2D-320FCE8BC038",
      "slideTitle" : "スライド #58",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「こんばんは…、あなたは…誰ですか…こんな夜中に、学校の式内を歩ける人なんてごくわずかのはずなんですけど…」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "duration" : 8.20390022675737,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.058.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 58",
      "voiceDuration" : 7.60390022675737,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "7CC7A3E9-45FD-4CED-9A80-A803EF32FAB9",
      "slideTitle" : "スライド #59",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「私が、なんで夜中にこんな場所にいるか、知りたいの？」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
