      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕はふと、手に何かが当たり、ふと視線をこいしに移すと、彼女が頰てっていた。「どうしたんですか、こいしさん？」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "duration" : 8.012607709750567,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.041.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 41",
      "voiceDuration" : 7.412607709750567,
