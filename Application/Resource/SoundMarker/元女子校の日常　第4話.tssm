      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "レミリア・スカーレット"
    },
    {
      "id" : "51DFF7DC-C588-4033-80B3-8E1B576ED0E6",
      "slideTitle" : "スライド #74",
      "voiceCharacter" : "ナレーション",
      "transitionName" : "なし",
      "telop" : "「お二人さんは吸血鬼で、時折妹さんが暴走するっという感じですか。それで、この学園の卒業生ですか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_ナレーション.wav",
      "duration" : 8.519115646258504,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.074.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 74",
      "voiceDuration" : 7.919115646258503,
      "audioTrack" : "track_voice__1882",
      "characterName" : "ナレーション"
    },
    {
      "id" : "0E513945-A213-4B65-9B3C-F0EA92A5E4D4",
      "slideTitle" : "スライド #75",
      "voiceCharacter" : "レミリア・スカーレット",
      "transitionName" : "なし",
      "telop" : "「ええ、よくご存知で。あなたのいうとおり私たちは、吸血鬼で、その詳細は公ではありませんの。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_レミリア・スカーレット.wav",
      "duration" : 7.41922902494331,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.075.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 75",
      "voiceDuration" : 6.8192290249433105,
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
