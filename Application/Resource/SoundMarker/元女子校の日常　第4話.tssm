      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「ほら、そこの二人、ささっと準備体操済ませて、スタートラインに立ちなさい。もうすぐ始まりますから。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_美鈴.wav",
