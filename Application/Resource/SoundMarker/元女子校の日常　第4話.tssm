      "title" : "シーン 60",
      "voiceDuration" : 3.413673469387755,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "0CF4077B-3058-4793-8E10-E0B3039DF064",
      "slideTitle" : "スライド #61",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「それなら、教えてあげる。実はね…」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
