      "title" : "シーン 62",
      "voiceDuration" : 5.918027210884354,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "F11BC13B-161C-47E4-8DD1-C59C32CE6057",
      "slideTitle" : "スライド #63",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "「それじゃあ、あなたの血、ちょうだい。」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_フランドール・スカーレット.wav",
      "duration" : 3.5,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.063.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 63",
      "voiceDuration" : 2.7394784580498865,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
