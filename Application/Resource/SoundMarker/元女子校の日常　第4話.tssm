      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.023.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 23",
      "voiceDuration" : 7.532154195011338,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "D10CBB88-D41C-4C95-B921-14F506C79295",
      "slideTitle" : "スライド #24",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "エンドレスランのルールは一言で言えば、その場に倒れるまで走り続ける、または歩き続ける無限長距離走らしい。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "duration" : 7.747369614512471,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.024.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 24",
      "voiceDuration" : 7.147369614512471,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "119604C4-F802-495B-8C4C-A87AFC36880F",
      "slideTitle" : "スライド #25",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕は、病み上がりの体に負担がかからないか心配だった。\nすると、昨日僕が倒れるまで走らせた彼女が来る。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav",
      "duration" : 8.224557823129253,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.025.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 25",
      "voiceDuration" : 7.624557823129252,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "F692FD2B-EDB1-4155-8D2E-C5178376E0BE",
      "slideTitle" : "スライド #26",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「藤原さんは初めてのエンドレスランで、こいしさんと同等程度の体力ですから、二人のペースを合わせて走りましょうか。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_美鈴.wav",
      "duration" : 5.7,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.026.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 26",
      "voiceDuration" : 5.0882086167800455,
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴"
    },
    {
      "id" : "CDDAB3A2-EDB0-4448-885D-0A9991AE253A",
      "slideTitle" : "スライド #27",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「お二人さんのペースは、きっと最後尾になりますから、私がお二人さんの後ろを走る形でサポートしましょう。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_美鈴.wav",
      "duration" : 5.389183673469387,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.027.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 27",
      "voiceDuration" : 4.789183673469387,
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴"
    },
    {
      "id" : "92EC84E9-8103-4D0D-A08C-23DD36F5BD3F",
      "slideTitle" : "スライド #28",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「ですが、だからと言って気を抜いたり、だらけたら体を叩きますから、走る力が尽きても、歩いて前に進んでくださいね。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_美鈴.wav",
      "duration" : 6.086439909297051,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.028.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 28",
      "voiceDuration" : 5.486439909297052,
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴"
    },
    {
      "id" : "411FD84D-27EA-4AE5-BF9F-693859DC0855",
      "slideTitle" : "スライド #29",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕はふと、彼女にそう言われ、こいしの方を見る。\n彼女は苦笑いを浮かべていた。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "duration" : 6.086507936507936,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.029.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 29",
      "voiceDuration" : 5.4865079365079366,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "68E420A3-1DB9-4B5E-9E61-4487ADE8D671",
      "slideTitle" : "スライド #30",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "だが、僕たちを置き去りにするように、開始の合図である笛が鳴り響くと、ゾロゾロと女子の大群が動き、僕たちも動き始めた。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav",
      "duration" : 9.112607709750566,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.030.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 30",
      "voiceDuration" : 8.512607709750567,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "81B6EC9F-E22C-45BD-9112-6B35E7202AE4",
      "slideTitle" : "スライド #31",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "そして、僕たちが走り始めて、数分経つと、ぞろぞろと、前方の大群が校門を抜けて、複数の方向に分散していく。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "duration" : 9.3256462585034,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.031.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 31",
      "voiceDuration" : 8.725646258503401,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "640C8185-F1EE-4DB7-97FF-50BF409DBB37",
      "slideTitle" : "スライド #32",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「校門をでたら、右に曲がって、進んでください。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_美鈴.wav",
      "duration" : 3.5,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.032.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 32",
      "voiceDuration" : 2.3236281179138323,
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴"
    },
    {
      "id" : "9D8974DC-0065-40B0-9BC5-25C1B89B9A7F",
      "slideTitle" : "スライド #33",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕たちは、それから、1kmくらい走ると、住宅街に入り、その中を進んでいた。だが、こいしと僕は走り続けるのに限界が来る…",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "duration" : 10.662607709750567,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.033.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 33",
      "voiceDuration" : 10.062607709750568,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "016F9B97-A5D6-4994-8BEB-C2D9F3FB7807",
      "slideTitle" : "スライド #34",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕がふと、隣を見ると、汗ばむ彼女の姿があった。ふと足を見ると、彼女も走り続けるのには限界が来ているようだった。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav",
      "duration" : 9.319115646258503,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.034.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 34",
      "voiceDuration" : 8.719115646258503,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "7C017FDF-DC20-4016-ACC7-5CC5ABF4F287",
      "slideTitle" : "スライド #35",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "「走り続けるのが厳しいなら、歩いても構いませんから、止まってないで前にすすまないと、学校に戻るときには夜中ですよ。」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_美鈴.wav",
      "duration" : 6.105804988662131,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.035.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 35",
      "voiceDuration" : 5.505804988662131,
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴"
    },
    {
      "id" : "BE240ECC-470B-41A8-9830-63EB751177FB",
      "slideTitle" : "スライド #36",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "美鈴",
      "transitionName" : "なし",
      "telop" : "私がそういうと、二人は走るのを諦め、歩き始める。\n「また、走れるようになったら走ってもらいますからね。」",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_美鈴.wav",
      "duration" : 5.643786848072562,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.036.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 36",
      "voiceDuration" : 5.043786848072562,
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "characterName" : "美鈴"
    },
    {
      "id" : "1732F5D4-991E-45E3-BE71-B16CCCBB9AAE",
      "slideTitle" : "スライド #37",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "「わかってますよ…それくらい…」\n僕はそう言いながら、再び、こいしの方を見る。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "duration" : 5.990861678004535,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.037.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 37",
      "voiceDuration" : 5.390861678004535,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "3A661EBD-EE09-4FED-9CEC-E30065AA084D",
      "slideTitle" : "スライド #38",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "彼女は、細かく息を吐きながら、歩き続ける。僕は、ふと僕の歩くペースと彼女のペースのずれに気づき、少し遅く歩く。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "duration" : 9.432154195011337,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.038.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 38",
      "voiceDuration" : 8.832154195011338,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "97EDA759-F9CE-44DA-987E-C6D99F661F48",
      "slideTitle" : "スライド #39",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "僕も、彼女と同様に息を細かく吐いていたことに気づき、深く息をすると、早歩き寄りの速度で再び走り始める。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "duration" : 8.629999999999999,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.039.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 39",
      "voiceDuration" : 8.03,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢"
    },
    {
      "id" : "B1A654D3-C27E-4B13-A290-7588171761F6",
      "slideTitle" : "スライド #40",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "古明地こいし",
      "transitionName" : "なし",
      "telop" : "私は、いきなり走り始めた彼に、待ってと言い、そのまま手を出す。すると、次の瞬間、彼と私の手が触れ合う。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_古明地こいし.wav",
      "duration" : 5.9753968253968255,
