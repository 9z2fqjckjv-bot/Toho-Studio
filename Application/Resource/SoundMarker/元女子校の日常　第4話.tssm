      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.061.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 61",
      "voiceDuration" : 3.2494784580498868,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット"
    },
    {
      "id" : "462FFB3B-419B-4D6C-B9FB-D2752B97E6CE",
      "slideTitle" : "スライド #62",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "彼女はそういうと、僕にあることを耳打ちする。\n僕はその事実に衝撃を受けるのだった。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
