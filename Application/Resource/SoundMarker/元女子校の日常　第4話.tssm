      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.065.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 65",
      "voiceDuration" : 2.234489795918367,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット"
    },
    {
      "id" : "727517A5-EB30-470A-B243-0E3D2A49AAFC",
      "slideTitle" : "スライド #66",
      "voiceCharacter" : "操夢",
      "transitionName" : "なし",
      "telop" : "彼女はそういうと、僕に噛みつき、血を吸い取っていく。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "duration" : 4.15172335600907,
      "animationName" : "なし",
      "seName" : "SE: 噛みつく",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.066.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 66",
      "voiceDuration" : 3.55172335600907,
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/噛みつく.mp3"
    },
    {
      "id" : "E4C01E00-16BB-436B-83BA-AFE47AC02F33",
      "slideTitle" : "スライド #67",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "私は、彼の血を吸い始めると、今までになかった独特な感覚に襲われていき、何かが変わっていく気がする。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_フランドール・スカーレット.wav",
      "duration" : 9.156984126984126,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.067.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "title" : "シーン 67",
      "voiceDuration" : 8.556984126984126,
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "characterName" : "フランドール・スカーレット"
    },
    {
      "id" : "D75FC0C6-844C-441C-A122-B3D2F473B9B2",
      "slideTitle" : "スライド #68",
      "voiceCharacter" : "フランドール・スカーレット",
      "transitionName" : "なし",
      "telop" : "私は、彼女が豹変していくのがわかると、\nその間の隙をつき、彼女の首に、腕を勢いよくぶつける。",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png",
