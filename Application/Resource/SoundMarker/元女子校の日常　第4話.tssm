      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.073.jpeg",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
