      "voiceCharacter" : "古明地こいし",
      "transitionName" : "なし",
      "telop" : "「いえ、なんでもありません、とりあえず、走りましょう。」\n私は、緊張して、そう口走り、走り始める。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_古明地こいし.wav",
      "duration" : 5.536167800453514,
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.042.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
