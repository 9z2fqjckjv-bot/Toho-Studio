      "backgroundName" : "image80.jpeg",
      "animationName" : "なし",
      "title" : "シーン 8",
      "id" : "F0BB977D-9769-4E1A-8CA2-B72782E4B6FE",
      "slideTitle" : "スライド #8",
      "voice2StartTimeOffset" : 0,
      "duration" : 7.9104308390022675,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、なんだか彼女に試練を与えられているような気がしなくもなかった。だが、彼女の意図は、いまだにわからなかった。",
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.9104308390022675,
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第4話_〜彼が研究室で作業をしていると上海が来て___〜_a84fec6e43\/社会人の日常__第4話_〜彼が研究室で作業をしていると上海が来て___〜_a84fec6e43.008.jpeg",
      "bgmStartTimeOffset" : 0
    },
    {
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第3話 〜彼が研究室で作業をしていると上海が来て...〜\/フラン（不満）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第4話 〜彼が研究室で作業をしていると上海が来て...〜\/image80.jpeg",
      "transitionName" : "なし",
