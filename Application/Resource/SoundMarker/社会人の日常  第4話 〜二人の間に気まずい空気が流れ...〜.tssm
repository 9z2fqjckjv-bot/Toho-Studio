      "voice2StartTimeOffset" : 0,
      "duration" : 7.719115646258503,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕はそこである提案を思いつくが、レミリアの話を思い出し、言い止まる。そして僕は、代わりにバックから瓶を出す。",
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.719115646258503,
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第4話_〜彼が研究室で作業をしていると上海が来て___〜_a84fec6e43\/社会人の日常__第4話_〜彼が研究室で作業をしていると上海が来て___〜_a84fec6e43.009.jpeg",
      "bgmStartTimeOffset" : 0
    },
