      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "telop" : "「思っていたよりも、日差しが強いや…」",
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceDuration" : 2.916984126984127,
      "seStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第4話_〜彼が研究室で作業をしていると上海が来て___〜_a84fec6e43\/社会人の日常__第4話_〜彼が研究室で作業をしていると上海が来て___〜_a84fec6e43.004.jpeg",
      "bgmStartTimeOffset" : 0
    },
    {
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第3話 〜彼が研究室で作業をしていると上海が来て...〜\/フラン（弱る）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第4話 〜彼が研究室で作業をしていると上海が来て...〜\/image81.jpeg",
