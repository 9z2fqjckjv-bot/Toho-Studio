      "id" : "C258B76D-8D53-426E-8431-9C6466F0D578",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_パチュリー・ノーレッジ.wav",
      "title" : "シーン 4",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.004.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 4.697709750566893,
      "telop" : "制作ソフト及び協力\nGemini\nTohoStuido\n「それで、あなたはこの話、どう思う？」私はそう彼に、聞く。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #4"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 7.312607709750567,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "6D709007-D289-4B61-AFD0-40BED3D91B56",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "title" : "シーン 5",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.005.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 7.912607709750566,
      "telop" : "「もしかしたら、フランさんが元々いた世界は、本来ならもうこの存在しないはずの、世界なのかもしれません…」\n彷徨う二人　第12話\nパチュリーはフランの記憶と実際の記録の矛盾を彼に伝え…",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #5"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 3.7321541950113377,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "C49B24B5-29C1-4B59-B503-67A9E2CB3E59",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "title" : "シーン 6",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.006.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 4.332154195011338,
      "telop" : "「どうします？この内容について、調べてみますか？」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
