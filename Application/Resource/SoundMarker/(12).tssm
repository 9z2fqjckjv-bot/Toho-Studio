      "transitionName" : "なし",
      "id" : "3886A3FE-E124-4907-980C-EB131C9B9114",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "title" : "シーン 3: 画像出典（敬称略）\nニコニコモンズ\nみんちりえ\nAppleCreatorStudio",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.003.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 8.544126984126985,
      "telop" : "僕は、彼女に言われたページには、先祖の日記があった。そして、その内容とフレラが聞いた内容が矛盾してるという。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #3"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 4.097709750566893,
