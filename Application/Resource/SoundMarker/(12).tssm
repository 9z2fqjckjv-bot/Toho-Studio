    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 7.412607709750567,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "CC0E4ACC-3471-4792-9EAA-250A4F8E3C60",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_031_操夢.wav",
      "title" : "シーン 31",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.031.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 8.012607709750567,
      "telop" : "「夜咲さんが、しばしの休暇をとるので、その間は、ここにいますよ。それで、他にはなにかありますか？」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #31"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 3.085532879818594,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "8D6E7EAF-898B-4E38-8D4D-77B397F075D7",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_パチュリー・ノーレッジ.wav",
      "title" : "シーン 32",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.032.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 3.6855328798185942,
      "telop" : "「いや、ないわ。それよりフランの方を、見てきたら？」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #32"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 6.651723356009071,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "39760225-B36C-43AA-B1DA-2430611D481D",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "title" : "シーン 33",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.033.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 7.25172335600907,
      "telop" : "「分かりました、それじゃ、そのレポートはさっき見せてもらった本と同じ場所にしまってから、いってきます。」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #33"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 5.1820634920634925,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "95A80B1A-7D17-4063-A0A9-469AEDF06532",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_パチュリー・ノーレッジ.wav",
      "title" : "シーン 34",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.034.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 5.782063492063492,
      "telop" : "「そう、じゃあ、あとは任せるわ…。」\n私がそういうと、彼はその本とレポートをしまいにいった。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #34"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 6.295963718820862,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "349BF1E4-9AE5-4619-9409-D510CE474156",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_パチュリー・ノーレッジ.wav",
      "title" : "シーン 35",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.035.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 6.895963718820862,
      "telop" : "「はぁ…」私はため息をつく。おそらくあのレポートにあった実態不明の結界は、博麗大結界を指すのだろう。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #35"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 6.9445578231292515,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "FF8B1D6C-FBBC-4D72-A5EA-E037D522E244",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_パチュリー・ノーレッジ.wav",
      "title" : "シーン 36",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.036.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 7.544557823129251,
      "telop" : "博麗大結界があるということは、霊夢や神社もあり、幻想郷がいまだにある証拠になる。だが、やはりどこか矛盾している。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #36"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 6.609773242630386,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "BD11A9D2-04DC-47F5-83C4-434F89064E36",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_パチュリー・ノーレッジ.wav",
      "title" : "シーン 37",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.037.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 7.209773242630385,
      "telop" : "確かに、彼の先祖が書いた日記の内容は正しかったが、なぜ幻想郷がいまだにあるのかという理由づけにはならなかった。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #37"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 7.511292517006803,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "F8E2F316-116C-41B0-8808-99C66BB1387B",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_パチュリー・ノーレッジ.wav",
      "title" : "シーン 38",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.038.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 8.111292517006802,
      "telop" : "そして、フランがなぜこっちにやってきたのかも、謎だ。それにしても、私たちは、この世界に来るときに、何か忘れた気がする。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #38"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 6.084761904761905,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "00888229-4F1F-4E0E-9B78-4A59E72A31FF",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_パチュリー・ノーレッジ.wav",
      "title" : "シーン 39",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.039.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 6.6847619047619045,
      "telop" : "この曖昧な記憶と矛盾を解決するには、時間がまだまだかかりそうだった。「私は、いつまで生きられるかしら…」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "slideTitle" : "スライド #39"
    },
