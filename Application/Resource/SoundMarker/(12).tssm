      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 3.757596371882086,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "221F4B8C-AAB4-4239-8BA8-4EF548FC7E08",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_パチュリー・ノーレッジ.wav",
      "title" : "シーン 40",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.040.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceStartTimeOffset" : 0,
      "duration" : 4.357596371882086,
      "telop" : "そう呟きながら、私は、静かになった図書館で過ごすのだった。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
