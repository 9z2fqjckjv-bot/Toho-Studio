      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "サブ",
      "voiceStartTimeOffset" : 0,
      "duration" : 9.932154195011337,
      "telop" : "「移転先の施設との接続を確立しています…、接続状況を確認中です…、接続テストを実行しています…、応答を確認中です…」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #17"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 8.447369614512471,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "97190E25-EEAC-47C4-9A5C-B194C563E9B6",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_018_サブ.wav",
