      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 3.2473696145124715,
      "telop" : "僕は、ある質問を円球に送信する。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #15"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 7.4386848072562355,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "59856AB1-ADC8-4F40-B1AD-EE5AA751DB07",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_サブ.wav",
      "title" : "シーン 16",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.016.jpeg",
      "animationName" : "なし",
      "audioTrack" : "track_voice_sub",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "サブ",
      "voiceStartTimeOffset" : 0,
      "duration" : 8.038684807256235,
      "telop" : "「施設の移転先を調べています…、移転先の詳細情報を確認しています…、過去のシステムログを読み出しています…。」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #16"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 9.332154195011338,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "7ECCBFCD-BFBB-4434-9DC7-F70E72A9423E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_サブ.wav",
      "title" : "シーン 17",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.017.jpeg",
