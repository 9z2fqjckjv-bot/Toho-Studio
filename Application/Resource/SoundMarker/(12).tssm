      "voiceDuration" : 7.68,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "1D54DD68-6EC3-4623-BF08-1B7F4FFCF204",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_サブ.wav",
      "title" : "シーン 22",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.022.jpeg",
