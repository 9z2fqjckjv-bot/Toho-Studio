      "voiceCharacter" : "操夢",
      "voiceStartTimeOffset" : 0,
      "duration" : 9.456077097505668,
      "telop" : "僕が、その内容を確認すると、確かにフランが元いた場所の近くにある発電所から応答を見た。そして、円球に指示を出す。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #19"
    },
    {
      "voice2StartTimeOffset" : 0,
      "voiceDuration" : 9.55607709750567,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "id" : "79D12AE0-2311-4E19-9CD3-C387FE98A098",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_サブ.wav",
      "title" : "シーン 20",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "サブ",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_12__8c43ebca77\/_12__8c43ebca77.020.jpeg",
