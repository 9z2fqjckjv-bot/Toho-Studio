      "voice2StartTimeOffset" : 0,
      "telop" : "私は、息子を部屋から追い出すと、「はぁ」とため息をつく。\n「今日のことが、彼にバレなければいいのだけど…」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #23",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_博麗霊夢.wav",
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "5694F842-EF69-4114-844E-EC2B68CCF8CD",
      "title" : "シーン 23",
      "duration" : 8.666984126984127,
      "audioTrack" : "track_voice_reimu",
