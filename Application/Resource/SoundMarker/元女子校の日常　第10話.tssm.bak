      "voice2StartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 55",
      "telop" : "「そうか…、それより…彼はどうだ？」",
      "audioTrack" : "track_voice_marisa",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_霧雨魔理沙.wav",
