      "bgmStartTimeOffset" : 0,
      "id" : "3287FD29-9933-4385-A86C-349F4842291F"
    },
    {
      "transitionName" : "なし",
      "seStartTimeOffset" : 0,
      "telop" : "私は、彼に自らの胸を触らせた後、そっと彼の頭を胸に埋める。\n「ほら、もっと力を抜いて…、リラーックス、リラーックス。」",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav",
      "slideTitle" : "スライド #8",
      "backgroundName" : "一人部屋３（夜・照明OFF）.pxd",
      "voiceDuration" : 10.384489795918368,
      "duration" : 10.984489795918368,
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "フランドール・スカーレット",
      "title" : "シーン 8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.008.jpeg",
