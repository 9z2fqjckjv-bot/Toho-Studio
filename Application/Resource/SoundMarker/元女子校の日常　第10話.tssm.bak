      "voice2StartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 51",
      "telop" : "私は、ふと目が覚めると、そこは病院だった。\nすると、誰かが入ってくる。",
      "audioTrack" : "track_voice_marisa",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_霧雨魔理沙.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "bgmVolume" : 0.7,
      "slideTitle" : "スライド #51",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.051.jpeg",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceCharacter" : "霧雨魔理沙",
      "seStartTimeOffset" : 0,
      "voiceDuration" : 6.425736961451247,
