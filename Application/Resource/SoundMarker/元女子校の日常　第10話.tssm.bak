      "seVolume" : 1,
      "characterName" : "操夢",
      "title" : "シーン 7",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.007.jpeg",
