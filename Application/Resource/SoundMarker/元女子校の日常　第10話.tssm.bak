      "voice2StartTimeOffset" : 0,
      "telop" : "「とりあえず、今はいいわ。それより鏡見てきなさい。」",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #22",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_博麗霊夢.wav",
