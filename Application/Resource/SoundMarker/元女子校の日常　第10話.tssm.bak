    },
    {
      "transitionName" : "なし",
      "seStartTimeOffset" : 0,
      "telop" : "「…僕は、どっちでも大丈夫ですよ…」僕は、どこかふわふわしたような、だが確かに感じるその感触を味わう。",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
