      "voice2StartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 50: 一方、魔理沙は…",
      "telop" : "一方、魔理沙は…",
      "backgroundName" : "単色背景",
      "bgmVolume" : 0.7,
      "slideTitle" : "スライド #50",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.050.jpeg",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
