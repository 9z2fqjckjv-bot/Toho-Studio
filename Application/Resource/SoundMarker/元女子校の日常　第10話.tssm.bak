      "id" : "5B511122-0592-421C-B1A2-C4F53B02D593",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 52",
      "telop" : "「あんた、大丈夫だったの？」",
      "audioTrack" : "track_voice_reimu",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_博麗霊夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "bgmVolume" : 0.7,
      "slideTitle" : "スライド #52",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.052.jpeg",
