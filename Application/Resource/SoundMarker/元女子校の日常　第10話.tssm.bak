      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #15",
      "telop" : "「んっ…」僕はふと目が覚める。そして、ぼんやりと目の前を見る。そして、ふと手が目の前に触れる。「あれ…この感触…」",
      "duration" : 9.334331065759637,
      "voice2StartTimeOffset" : 0,
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.015.jpeg",
