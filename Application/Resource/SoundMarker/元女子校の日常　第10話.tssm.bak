      "voiceCharacter" : "博麗霊夢",
      "voiceDuration" : 4.530748299319728,
      "slideTitle" : "スライド #24",
      "audioTrack" : "track_voice_reimu",
      "telop" : "私はそう一人、ぼさっと呟くと、リビングに降りていった。",
      "seVolume" : 1,
      "bgmVolume" : 0.7,
      "animationName" : "なし",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.024.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
