      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話ショート_f4472210ed\/元女子校の日常　第10話ショート_f4472210ed.011.jpeg",
      "characterName" : "博麗霊夢",
      "animationName" : "なし",
