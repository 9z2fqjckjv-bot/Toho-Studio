      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "telop" : "僕は、彼女にそう言われ、息を吐きながら、脱力する。すると、彼女が僕の背中に手を回し、唇をそっとくっつける。",
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "duration" : 9.414761904761905,
      "voiceDuration" : 8.814761904761905,
      "voice2StartTimeOffset" : 0,
      "seStartTimeOffset" : 0
    },
    {
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "一人部屋３（夜・照明OFF）.pxd",
      "slideTitle" : "第5スライド",
      "id" : "74A04391-D1B7-429C-A841-D1F3FB53EFF0",
      "voiceCharacter" : "操夢",
      "title" : "シーン 5",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話ショート_f4472210ed\/元女子校の日常　第10話ショート_f4472210ed.005.jpeg",
