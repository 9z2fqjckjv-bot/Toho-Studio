      "slideTitle" : "第8スライド",
      "id" : "E21175F5-74FD-463F-903A-940518948B82",
      "voiceCharacter" : "フランドール・スカーレット",
      "title" : "シーン 8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話ショート_f4472210ed\/元女子校の日常　第10話ショート_f4472210ed.008.jpeg",
