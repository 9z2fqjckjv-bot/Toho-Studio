      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "telop" : "すると、彼女が僕の手を握り、そっと彼女の胸に当てる。",
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "duration" : 4.608253968253968,
