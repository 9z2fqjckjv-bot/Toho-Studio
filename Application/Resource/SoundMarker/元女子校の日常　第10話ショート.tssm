      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmStartTimeOffset" : 0,
      "backgroundName" : "一人部屋３（夜・照明OFF）.pxd",
      "slideTitle" : "第9スライド",
      "id" : "2274D316-E447-4756-9C7D-B847BF28E1B7",
      "voiceCharacter" : "操夢",
      "title" : "シーン 9",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話ショート_f4472210ed\/元女子校の日常　第10話ショート_f4472210ed.009.jpeg",
      "characterName" : "操夢",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "telop" : "彼女はそう言いながら、僕の服をそっと掴む。僕は、それに気づかずに、ふわふわしながら感じる感触に身を任せるのだった。",
      "transitionName" : "なし",
