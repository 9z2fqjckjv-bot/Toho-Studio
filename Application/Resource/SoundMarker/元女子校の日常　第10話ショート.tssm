      "voiceCharacter" : "操夢",
      "title" : "シーン 4",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話ショート_f4472210ed\/元女子校の日常　第10話ショート_f4472210ed.004.jpeg",
