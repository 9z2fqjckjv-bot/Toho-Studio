      "voiceCharacter" : "妹紅",
      "title" : "シーン 10",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話ショート_f4472210ed\/元女子校の日常　第10話ショート_f4472210ed.010.jpeg",
      "characterName" : "藤原妹紅",
      "animationName" : "なし",
      "telop" : "「だからよ…」私は、そう妻である彼女に、仕事終わりの飲み会での愚痴をお酒片手に話す。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_妹紅.wav",
