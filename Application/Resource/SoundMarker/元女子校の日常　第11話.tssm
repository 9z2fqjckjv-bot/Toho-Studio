      "id" : "8AD7BE62-78FE-44EA-98D1-B4A5D0691AC1",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "「さてと…」私はそう言いながら、一息つくと、適当な本棚を眺めながら、図書館を歩き回るのだった。",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.3375963718820865,
