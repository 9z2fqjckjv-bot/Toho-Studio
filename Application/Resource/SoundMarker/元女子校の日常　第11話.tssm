      "title" : "シーン 58",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_ca8b4f2504\/元女子校の日常　第11話_ca8b4f2504.058.jpeg",
      "characterName" : "博麗霊夢",
      "voice2StartTimeOffset" : 0,
      "id" : "326ACA5B-EDEB-4EF6-B632-71657D977DED",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "即日夜間速達は、高い料金と引き換えに、夕方から夜にかけて出せば、日付が変わる前に届くと言うものだ。",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 9.014489795918367,
      "seVolume" : 1
    },
