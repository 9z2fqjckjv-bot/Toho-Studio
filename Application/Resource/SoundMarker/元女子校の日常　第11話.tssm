      "transitionName" : "なし",
      "bgmStartTimeOffset" : 0,
      "telop" : "その頃、彼が元いた家では…",
      "backgroundName" : "単色背景",
      "seVolume" : 1
    },
    {
      "slideTitle" : "スライド #55",
      "voiceCharacter" : "博麗霊夢",
