      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_ca8b4f2504\/元女子校の日常　第11話_ca8b4f2504.057.jpeg",
