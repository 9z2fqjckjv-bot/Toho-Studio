      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "「ここが、図書館。取り出した本は、元の位置に戻してよ。」\n私は、そう言うと、私と彼の部屋に戻っていった。",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 9.850748299319728,
