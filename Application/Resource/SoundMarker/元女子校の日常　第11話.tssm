      "id" : "F9D24066-0C35-474D-88B8-B2BF9A22A80E",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "私は、家に帰ってくるとため息をつく。例の騒動を鎮静化させる代わりに、魔理沙の面倒を私と彼で見ることになったからだ。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 10.071995464852607,
      "seVolume" : 1
    },
    {
      "slideTitle" : "スライド #56",
      "voiceCharacter" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_博麗霊夢.wav",
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "audioTrack" : "track_voice_reimu",
      "duration" : 7.681995464852608,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 56",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_ca8b4f2504\/元女子校の日常　第11話_ca8b4f2504.056.jpeg",
