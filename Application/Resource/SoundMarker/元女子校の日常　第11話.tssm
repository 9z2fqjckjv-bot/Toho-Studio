      "id" : "324D89BD-D046-4982-B6FE-8E8F8538708E",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "「私の母校は昔から何も変わってないわね…」\n私がそう呟いていると、インターホンが鳴る。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 7.081995464852608,
      "seVolume" : 1
    },
    {
