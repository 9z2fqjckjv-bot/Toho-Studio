      "id" : "AF7EBBB9-5C62-427A-8759-EBB12C480D81",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "私が外に出ると、書留郵便物の受け渡しだった。しかも、発送日時が数時間前になっていて、即日夜間速達の印があった。",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 11.339478458049886,
      "seVolume" : 1
    },
    {
      "slideTitle" : "スライド #58",
      "voiceCharacter" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_博麗霊夢.wav",
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.614489795918367,
