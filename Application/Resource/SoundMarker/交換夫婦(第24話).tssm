      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 20",
      "telop" : "僕はそれから、会見を見ていたが、だんだんとそれどころではないと考え、そして、ひっそりとみとりの研究室に来た。"
    },
    {
      "animationName" : "なし",
