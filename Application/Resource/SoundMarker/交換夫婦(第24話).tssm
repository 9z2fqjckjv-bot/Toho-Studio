      "voiceCharacter" : "八雲紫",
      "title" : "シーン 1",
      "telop" : "私が、記者会見中ふと、周りを見ると、橙が私に視線を向けていることに気がつき、彼女に小声で言う。「どうしたのよ、橙。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E6%A9%99",
      "duration" : 7.960702947845805,
      "id" : "29A8DCEB-2086-4DE3-848C-738F836A1E98",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.360702947845805,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.002.jpeg",
      "characterName" : "橙",
      "slideTitle" : "スライド #2",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
