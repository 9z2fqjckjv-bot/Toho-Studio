      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 27",
      "telop" : "「解析が完了しました。プロンプト一つで、システムを操作できます。次は、どうしましょうか？」"
