      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.020.jpeg",
