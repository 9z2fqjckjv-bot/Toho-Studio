      "voiceCharacter" : "橙",
      "title" : "シーン 2",
      "telop" : "「えっと…円球機械室を見回りしたものが、誰かが、円球の権限を乗っ取り、遠隔操作しているって…騒いでいて…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "duration" : 7.155986394557822,
      "id" : "38C4170D-A09D-41D8-BF74-6A1B68A6153C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.3986167800453515,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.003.jpeg",
      "characterName" : "八雲紫",
      "slideTitle" : "スライド #3",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
