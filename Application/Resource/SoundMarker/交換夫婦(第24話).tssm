      "voiceCharacter" : "八雲紫",
      "title" : "シーン 3",
      "telop" : "私は、その一言に嫌な予感し、\n橙に会見の続きを任せて、そのまま円球機械室に向かう。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 11.091995464852607,
      "id" : "185A3DED-D045-4AE9-B4D4-6B029FB761E9",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 10.491995464852607,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.004.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 4",
      "telop" : "私は、ただ部屋に一人残され、何気なく、霊夢に話しかける。\n「なぁ、霊夢…お前が競馬で大儲けしたってのは本当なのか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 10.016984126984127,
      "id" : "BE212793-238E-49A9-B2B4-AFF89245336F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.416984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.005.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #5",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 5",
      "telop" : "「確かに…共同口座のお金と早苗の奇跡の力で、がっぽり儲けたのは、本当なのよ…、でもちょっとして出来心で…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 9.926984126984127,
      "id" : "6705354C-22E0-4135-A047-F3BC4BF4E389",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.326984126984128,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.006.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #6",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 6",
      "telop" : "「そうか…、操夢が言ってた話だと、過去の口座の入出金を調べていたら、何回か不審な履歴があったと言ってたのだぜ…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 7.005736961451247,
      "id" : "BE26DA22-15C7-430B-83B8-E68B5A23E673",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.405736961451248,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.007.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #7",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 7",
      "telop" : "私は、その指摘を受け、ズキズキと心に何かが刺さる…。\n「えっと…、それは…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 5.861995464852607,
      "id" : "32859BD1-E005-48A6-8BC2-BE4F6CC2A8A1",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 5.261995464852608,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.008.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #8",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 8",
      "telop" : "「なあ、一つ聞きたいんだけど、\n霊夢の収入が少ないと感じるのは…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.669115646258502,
      "id" : "1C4345B9-8CCD-42AE-BB37-689A50AAC6B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.069115646258503,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.009.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 9",
      "telop" : "「ええ、あの問題の続報になるかもしれないですが、文さんにはあの記者会見の内容の否定と、協力のお願いをしたくて…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 5.289591836734694,
      "id" : "5F41FE43-042B-4252-B947-91E880586334",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 4.689591836734694,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.010.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #10",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 10",
      "telop" : "「お願い…もし、内密な話なのであれば、\nそちらにお伺いしましょうか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.619115646258503,
      "id" : "5C044360-401D-4BA4-A6C0-9BDD97790C01",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.019115646258504,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.011.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #11",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 11",
      "telop" : "「いえ、あの家は、しばらく手放す予定なので、文さんでお願いを話せればいいかと…」僕は、ボソボソと呟くように言う。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 4.1355782312925164,
      "id" : "67B188B3-EF19-4FD1-BB20-D92816299592",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 3.535578231292517,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.012.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #12",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 12",
      "telop" : "「わかりました…それで、話し合いは、今夜にしますか？」"
    },
