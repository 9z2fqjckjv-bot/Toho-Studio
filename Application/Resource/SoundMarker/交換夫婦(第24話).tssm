      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 22",
      "telop" : "そして僕は操作盤を触り、会見途中からあのPCで会話していた、この円球に直接、文章を…いや、プログラムを送る。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice__E1DB",
      "duration" : 8.632154195011337,
