      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.50390022675737,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.015.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #15",
      "backgroundName" : "一人部屋３（日中）.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 15",
      "telop" : "僕は、それから、家に戻ってくると、\nポケットからポケベルを取り出し、PCに繋げて起動する。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 3.5,
      "id" : "195CD4E0-A3D8-47D5-B142-263C69B15FED",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 2.699546485260771,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.016.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #16",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 16",
      "telop" : "そして、何気なくポケベルのアプリを開く。\nFiles\nポケベル\nポケベル\nFiles\n編集\n表示\n移動\nウィンドウ\nヘルプ"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 6.290861678004535,
      "id" : "9F6157CA-60AC-4D88-8808-36E29D609310",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png",
      "voiceDuration" : 5.690861678004535,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.017.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #17",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 17",
      "telop" : "ポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルはさまざまな人々の\n「誰かと繋がりたい」という\n思いが沢山こもった製品として\n平成初期から中期にかけて\n流行した通話機能を有する機器\nであり、国会においてスマート\nフォンマナーの問題が挙げられ\n国民のスマートフォン利用を\n原則中止すると、我ら河童\nが生み出したこのポケベルが\n巨大な需要を生み出して…\npocketbell.kappa\/home\/top\n政府公認の安心国産ポケベル\nホーム\nポケベルって何？\n出来ること\n河童の技術力\nポケベル史\n政府公認とは？\nポケベルの魅力\n電話の歴史\nポケベルの性能\nポケベルの価格\n必要なもの\n固定電話は必須？\n通信機能について\nすると、右上に通知が表示され、\n僕は、その通知にカーソルを合わせてクリックする。\n操作\nWeb\nポケベル\n政府が臨時記者会見が始まる\n例の賭博問題に関する言及か…"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 9.504988662131518,
      "id" : "8C305999-3CE5-4E9F-B690-0FDB1EB45D88",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.904988662131519,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.018.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #18",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 18",
      "telop" : "ポケベル\nポケベル初回設定\nポケベル\nFiles\nえ\npocketbell.kappa\/news\/live\/movie\/miko-tobaku-info\nすると、生放送の画面に切り替わり、読み込み表記が表示される。僕は、しばらく待った後、会見放送を眺めるのだった。\n操作\nWeb\nroading…\nコメント\nroading…\n大宮巫女賭博問題に関する政府臨時記者会見\n生放送配信　映像提供：文々。新聞社"
    },
    {
      "title" : "シーン 19",
      "id" : "312462C8-9707-43EF-A83B-EA7C64436574",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.019.jpeg",
      "transitionName" : "クロスディゾルブ",
      "slideTitle" : "スライド #19",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "それから時間がたち…",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.360430839002268,
      "id" : "F012E197-FDAE-4CC3-AC80-A3679C1C3DE2",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
