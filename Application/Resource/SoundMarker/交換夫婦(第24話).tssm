      "voiceCharacter" : "ナレーション",
      "title" : "シーン 30",
      "telop" : "「承知しました、全列車に一斉停止コードを送信します…、通信中です…、コードを作成中です…、コードを送信しました…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice__E1DB",
      "duration" : 8.873469387755101,
      "id" : "C0474919-5C30-47B9-BDB6-2AFFC755C7CE",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.273469387755101,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.031.jpeg",
      "characterName" : "ナレーション",
      "slideTitle" : "スライド #31",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 31",
      "telop" : "「現状を確認中です…大宮駅付近で止まっている最寄り列車を探しています…大宮公園で現在停止中の列車があります。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 5.114761904761904,
      "id" : "F7B0F83D-E9B7-4577-A6EB-89414998E59F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 4.5147619047619045,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.032.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #32",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 32",
      "telop" : "僕は、それを聞くと、操作盤を触り、\nある人物に電話をかける…。"
    },
    {
      "title" : "シーン 33",
      "id" : "0B188165-E1A0-4E23-A34F-BFF95164759E",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.033.jpeg",
      "transitionName" : "クロスディゾルブ",
      "slideTitle" : "スライド #33",
      "duration" : 3.5,
      "animationName" : "なし",
      "telop" : "彼が発信先の人は…",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.407732426303854,
      "id" : "3F714856-497C-4270-87E9-E6163FB937AB",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.807732426303854,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.034.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #34",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 34",
      "telop" : "私は、ただ一人、手持ちのノートPC上で臨時記者会見の様子を見ていると、ふとポケベルの着信に気づく。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.5,
      "id" : "61DC56FF-47AD-4808-82AC-2A19253FE95A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 2.7094784580498867,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.035.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #35",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 35",
      "telop" : "「もしもし、操夢、どうしたの？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.15607709750567,
      "id" : "FFEF34B3-133A-4C09-A5BA-47958EA46CC5",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.556077097505669,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.036.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #36",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 36",
      "telop" : "「あんなことがあった後の電話で、こう言うのもなんですが、霊夢さんは、総理と僕だったら、どっちがいいですか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.5,
      "id" : "0511E236-B709-4EA2-8E28-573404EF9262",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 1.8919954648526076,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.037.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #37",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 37",
      "telop" : "「えっ、それってどういう？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.70390022675737,
      "id" : "D6E32C42-A785-4D3A-AFA9-2C974C4D19B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.10390022675737,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.038.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #38",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 38",
      "telop" : "「今流れている記者会見を見ればわかりますが、総理は僕のことを前面に押し出して、問題の真相は闇に封印する気です。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.5,
      "id" : "022553A0-FF45-4FDE-89C7-6257ED063B96",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 1.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.039.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #39",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 39",
      "telop" : "「それで…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.947369614512471,
      "id" : "1B4D4553-B44E-40E9-BF3D-0B1FC10BBB64",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.347369614512472,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.040.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #40",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 40",
      "telop" : "「手短に言うと、政府の味方になれば、この問題を闇に葬る代わりに、総理直々の罰が霊夢さんに降るの明確です。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.936507936507937,
      "id" : "3207790E-B70D-4A9B-88FB-B050C16FF9F2",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.336507936507937,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.041.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #41",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 41",
      "telop" : "「ですが、僕につけば、文さんと交渉して、世間を誤魔化して、これまで通り、巫女として働き、お仕置きもしません。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.495215419501134,
      "id" : "494465E0-6A41-4530-AD8C-9A63D8576FE3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.895215419501134,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.042.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #42",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 42",
      "telop" : "「両者とも、この問題を闇に葬るのには変わりませんが、霊夢さんなら、きっと僕につけば、より利にかなってますよ。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.347369614512472,
      "id" : "7DBD90A0-CB0B-44BB-8B45-92197BE3593B",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.747369614512472,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.043.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #43",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 43",
      "telop" : "「ただ一つ難点を言うなら、この騒動が鎮静になるまで、霊夢さんと必要なら魔理沙さんたちも、家には帰れません。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.469115646258503,
      "id" : "AE38CF4F-F097-4D5A-9434-90593CC25453",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.8691156462585035,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.044.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #44",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 44",
      "telop" : "「ですが、今僕がプログラムを送りつけて、文さんの協力を確実に得られれば、沈静化までそう長くはかかりません。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 9.023469387755101,
      "id" : "5ACDD38A-90D5-4A3D-AF56-0612E88F6DEC",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.423469387755102,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.045.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #45",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 45",
      "telop" : "「この難点にさえ、目を瞑れば、何も不自由なく、これまでと近い形で生活を送り続けられます。さてどうしますか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 10.431995464852607,
      "id" : "C82337AE-B566-495F-A18D-EF3008A3703F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.831995464852607,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.046.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #46",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 46",
      "telop" : "「そう…」私はそう返す…、今ここで彼について、少しの間だけ我慢すれば、これまで通りの生活を送れるが、迷いがある。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 6.836507936507936,
      "id" : "987218F6-5D76-45AB-A420-1EAC298DD362",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.2365079365079366,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.047.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #47",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 47",
      "telop" : "「霊夢さん、何か、僕のプランに問題がありますか、\nそれとも何かしらの要望がありますか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 8.589478458049888,
      "id" : "0BACDC15-9458-45BD-B975-4189BE57A0DF",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.989478458049887,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.048.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #48",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 48",
      "telop" : "私はそう言われ、考えると、ふとあの気配を感じ、\nポケベルをPCからとり耳に当てながら、飛んでいく。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 4.869478458049886,
      "id" : "0695A72D-D689-4267-91CB-4DA21B9B7A0C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc456758_空A..jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 4.269478458049886,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.049.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #49",
      "backgroundName" : "nc456758_空A..jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 49",
      "telop" : "すると、彼が何かを言い始め、それに耳を傾ける。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 3.5,
      "id" : "ECE7ADC8-C890-4B56-9B99-2B8381DCAE79",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 2.673469387755102,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.050.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #50",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 50",
      "telop" : "「霊夢さん、今、空を飛んでますか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.849478458049887,
      "id" : "CB3042D0-FEE0-44B0-AB0A-62002725F74B",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc456758_空A..jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 3.2494784580498868,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.051.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #51",
      "backgroundName" : "nc456758_空A..jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 51",
      "telop" : "「ええ、そうよ。それでどうすればいいの？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.558253968253968,
      "id" : "AC9FE598-EC0C-4F13-A49D-1645863B73C1",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.958253968253969,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.052.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #52",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 52",
      "telop" : "「今、大宮公園の列車を動かし始めたので、列車のカメラを見ながら、僕の合図で空いている扉から乗り込んでください。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.5,
      "id" : "2AC23781-FF8D-4AA5-B4DD-A4E66E5EE123",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc456758_空A..jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 1.6732426303854875,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.053.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #53",
      "backgroundName" : "nc456758_空A..jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 53",
      "telop" : "「それって、どういう…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 7.9799999999999995,
      "id" : "EBBB7FF5-B2DC-4D7C-AD41-2601B79C97EB",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.38,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.054.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #54",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 54",
      "telop" : "「今、列車の映像を見てます…」僕はそう言いながら、その列車から空に向けられているカメラの映像を確認する。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.295215419501133,
      "id" : "CA7602DC-571E-4DED-8261-7C9744C5BD95",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.6952154195011335,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.055.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #55",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 55",
      "telop" : "そして、しばらく経つと、彼女の姿が写り、\n「今です。」と言い、列車を減速させ、最寄りの扉を開く。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.935736961451246,
      "id" : "E45789F0-4E3E-44B8-A6DB-67173E0C991F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.335736961451246,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.056.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #56",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 56",
      "telop" : "私は彼の言うタイミングで、列車に乗り込むと、即座に扉がしまる。ふと周りを見ると、空気輸送していたようだった。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice__E1DB",
      "duration" : 8.869115646258503,
      "id" : "1B8BFC1C-2397-48C4-9D62-10F4C819E133",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.269115646258504,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.057.jpeg",
      "characterName" : "ナレーション",
      "slideTitle" : "スライド #57",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "title" : "シーン 57",
      "telop" : "「この列車は、臨時特別快速、甲子線直通、八王子行きです。途中の停車駅は中浦和のみとなります。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 9.666938775510204,
      "id" : "5D7F1DBE-199F-4C62-A402-8B802D882D64",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.066938775510204,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.058.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #58",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 58",
      "telop" : "僕は、列車の車内カメラで、彼女が乗り込みと同時に、扉閉め、最大限の加速を列車にさせる。「霊夢さん、聞こえますか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 4.654489795918367,
      "id" : "53472890-3EF1-4169-9D7B-8E8DA83EBCB3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 4.054489795918367,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.059.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #59",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 59",
      "telop" : "「なんだか、とんでもない速度が出てる気がするんだけど…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.399546485260771,
      "id" : "B0C3C0D8-CD3D-4D4C-8284-2F60E7F60E8B",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.7995464852607705,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.060.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #60",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 60",
      "telop" : "「今、列車は限界速度の時速150kmなので、\nここまでだったら、おそらく数十分でつきますよ。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.5,
      "id" : "D7254C9F-26FF-4835-A9CD-16DDB0DF265E",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 1.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.061.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #61",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 61",
      "telop" : "「そっ、そう…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 4.140861678004535,
      "id" : "419FAA4E-33F6-498F-9962-7A4D7349A83F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 3.540861678004535,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.062.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #62",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 62",
      "telop" : "僕はそう言いながら、家にいるフランたちにメッセージを送る。"
    },
    {
      "title" : "シーン 63: その頃フランたちは…",
      "id" : "13EFED19-C353-4EDC-9737-68B81C526DD0",
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.063.jpeg",
      "transitionName" : "クロスディゾルブ",
      "slideTitle" : "スライド #63",
      "duration" : 3,
      "animationName" : "なし",
      "telop" : "その頃フランたちは…",
      "characterName" : "フランドール・スカーレット"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "duration" : 9.869478458049887,
      "id" : "35554832-814C-4652-B5E7-FA0F06D77F47",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.269478458049887,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.064.jpeg",
      "characterName" : "フランドール・スカーレット",
      "slideTitle" : "スライド #64",
      "backgroundName" : "リビング（日中）.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_フランドール・スカーレット.wav",
      "voiceCharacter" : "フランドール・スカーレット",
      "title" : "シーン 64",
      "telop" : "私は、ふとポケベルから音がして、見ると、操夢からメッセージが来ていた。私は、その内容を他の皆に伝える。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "duration" : 10.498979591836735,
      "id" : "E0234F94-96A5-4FC5-AF9D-834348C74088",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.898979591836735,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.065.jpeg",
      "characterName" : "フランドール・スカーレット",
      "slideTitle" : "スライド #65",
      "backgroundName" : "リビング（日中）.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_フランドール・スカーレット.wav",
      "voiceCharacter" : "フランドール・スカーレット",
      "title" : "シーン 65",
      "telop" : "すると、この家に住む霊夢以外の全員に同じ文言が送られていることがわかり、私たちは、準備をすまして、家を出るのだった。"
    },
    {
      "title" : "シーン 66: 霊夢の列車が駅に止まると…",
      "id" : "4B37B12A-5F4A-4423-92B1-9F583CBD1B09",
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.066.jpeg",
      "transitionName" : "クロスディゾルブ",
      "slideTitle" : "スライド #66",
      "duration" : 3,
      "animationName" : "なし",
      "telop" : "霊夢の列車が駅に止まると…",
      "characterName" : "博麗霊夢"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 8.886984126984126,
      "id" : "4A5C693C-6BD0-4CFE-8673-8967C2DD0FC9",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.286984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.067.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #67",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 67",
      "telop" : "それから、数分経つと、途中停車駅につき、ドアが開く。\nすると、そこからフランたちが乗ってくる。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 10.284489795918367,
      "id" : "3B6D7542-9ADD-4AE3-8948-3785B38B131C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.684489795918367,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.068.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #68",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 68",
      "telop" : "「もしかした、フランたちにも彼から何か来たの？」\n私は、再び猛加速をしだす、列車に腰掛けながら、尋ねる。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 8.096984126984127,
      "id" : "A342FB87-AF11-40A3-84B6-6FEB2770F018",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.496984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.069.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #69",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 69",
      "telop" : "そして、魔理沙の姿がないことに気づく。\nすると、車内放送…ではなく彼の声が聞こえる。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.547369614512471,
      "id" : "DD67BB99-E9B9-4A99-96DD-15BBBF5B6BBD",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.947369614512471,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.070.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #70",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 70",
      "telop" : "「魔理沙さんは、ちょうど近くにいたようなので、今こっちにいますよ。どうします、マイク機能があるので会話もできますが…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 3.5,
      "id" : "2DB9FDF7-8E6D-4303-938D-B48DA58251C0",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 2.5419954648526075,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.071.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #71",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 71",
      "telop" : "「…魔理沙の声…聞かせてちょうだい…。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 7.745215419501133,
      "id" : "217C310F-6508-457E-A469-34AA941B7F99",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.145215419501134,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.072.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #72",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 72",
      "telop" : "「どうやら、霊夢さんがあなたと話したいみたいです、僕は、ちょっと席を外すので、あとはお任せしますね。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 3.5,
      "id" : "E8E4902C-9505-4BB3-8914-2A8BDCE2577C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 2.514761904761905,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.073.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #73",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 73",
      "telop" : "僕はそう言うと、その部屋から離れた。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 11.091995464852607,
      "id" : "E8BC1C14-FD93-4EEB-B86B-E9231685E3A4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 10.491995464852607,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.074.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #74",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 74",
      "telop" : "私は、ただ部屋に一人残され、何気なく、霊夢に話しかける。\n「なぁ、霊夢…お前が競馬で大儲けしたってのは本当なのか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 10.016984126984127,
      "id" : "3160D197-8D28-40D9-A5CB-4DF8372FE695",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.416984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.075.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #75",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 75",
      "telop" : "「確かに…共同口座のお金と早苗の奇跡の力で、がっぽり儲けたのは、本当なのよ…、でもちょっとして出来心で…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 9.926984126984127,
      "id" : "D579063B-106E-4527-8F2E-12971D8E9174",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.326984126984128,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.076.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #76",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 76",
      "telop" : "「そうか…、操夢が言ってた話だと、過去の口座の入出金を調べていたら、何回か不審な履歴があったと言ってたのだぜ…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 7.005736961451247,
      "id" : "03018356-0DA9-4C49-8A59-FD5DC08C0A8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.405736961451248,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.077.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #77",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 77",
      "telop" : "私は、その指摘を受け、ズキズキと心に何かが刺さる…。\n「えっと…、それは…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 5.861995464852607,
      "id" : "B4871E27-1A96-404B-BF13-2A577EE59197",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 5.261995464852608,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.078.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #78",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 78",
      "telop" : "「なあ、一つ聞きたいんだけど、\n霊夢の収入が少ないと感じるのは…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.690748299319727,
      "id" : "8F139E10-E46D-49F8-9C54-928294448466",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.090748299319728,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.079.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #79",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 79",
      "telop" : "「えっと…」私は、その空気と彼女の問いかけに、平常心を保とうとするが、保てず、どうすればいいか迷う。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_marisa",
      "duration" : 9.364489795918367,
      "id" : "4A50B0A8-3F44-4C5A-99B5-62A84BE22D4A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.764489795918367,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.080.jpeg",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #80",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_霧雨魔理沙.wav",
      "voiceCharacter" : "霧雨魔理沙",
      "title" : "シーン 80",
      "telop" : "「まぁ、これを真に受けて、これからは、しっかり生きていくならいいと、操夢は、私がここに着いた時に言ってたぜ…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.559478458049886,
      "id" : "9F129D73-450D-4252-BDC0-21F3C024970C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.959478458049887,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.081.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #81",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 81",
      "telop" : "「うぐ…」私は、魔理沙の発言にそう返すことしかできなかった。そして、彼の心意気に感謝をするのだった。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 9.620748299319727,
      "id" : "415E1C9D-FF65-43DE-963D-994522B55D82",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 9.020748299319727,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.082.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #82",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 82",
      "telop" : "だが、それは同時に、ついこないだ、全員が思い知った、\n”彼”と皆との関係性にとって、大きな転換点だった。"
    },
    {
      "title" : "シーン 83: その頃、操夢は…",
      "id" : "E96BDE2C-585A-4AAA-92D5-DA3180928B0D",
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.083.jpeg",
      "transitionName" : "クロスディゾルブ",
      "slideTitle" : "スライド #83",
      "duration" : 3,
      "animationName" : "なし",
      "telop" : "その頃、操夢は…",
      "characterName" : "操夢"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.958253968253969,
      "id" : "9E362828-4E15-41B4-AA48-1EAF934E435E",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.358253968253969,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.084.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #84",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 84",
      "telop" : "僕は、部屋から出て壁に寄りかかると、ポケベルを取り出し、ある連絡先に、電話をかける。すると、相手がすぐに出る。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 4.847369614512472,
      "id" : "F4B04898-FF52-489E-A209-26B92173375F",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 4.247369614512472,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.085.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #85",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 85",
      "telop" : "「もしもし、聞こえますか？」\n僕は声を抑えながら、そう言う。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 4.035578231292517,
      "id" : "A636D423-DFE0-4057-B08B-9EA44413CE5D",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 3.435578231292517,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.086.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #86",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 86",
      "telop" : "「ええ、どうしました？何かスクープでもあるのですか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 6.790861678004535,
      "id" : "5E56BBAD-2689-4690-A0D7-76A066224A8D",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.190861678004535,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.087.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #87",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 87",
      "telop" : "「いえ、今回はスクープではありませんが、例のスクープ記事について、ちょっとお願いがあるのですが？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 3.5,
      "id" : "66E3C93B-D8C6-496D-808F-D77FA0C8E4C7",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 2.3035827664399093,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.088.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 88",
      "telop" : "「何か、心配事でもあるのですが？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.669115646258502,
      "id" : "2E2D8D62-1C29-442B-B13F-BB9294C684F1",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.069115646258503,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.089.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #89",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 89",
      "telop" : "「ええ、あの問題の続報になるかもしれないですが、文さんにはあの記者会見の内容の否定と、協力のお願いをしたくて…」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 5.289591836734694,
      "id" : "0FF180E8-EEB2-47A3-AC58-6740A25372FE",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 4.689591836734694,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.090.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #90",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 90",
      "telop" : "「お願い…もし、内密な話なのであれば、\nそちらにお伺いしましょうか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 8.619115646258503,
      "id" : "69DBD037-4866-4B17-B244-27302B8CD3D8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.019115646258504,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.091.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #91",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 91",
      "telop" : "「いえ、あの家は、しばらく手放す予定なので、文さんでお願いを話せればいいかと…」僕は、ボソボソと呟くように言う。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 4.1355782312925164,
      "id" : "42319FD7-227C-4523-9418-A1091D49E604",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 3.535578231292517,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.092.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #92",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 92",
      "telop" : "「わかりました…それで、話し合いは、今夜にしますか？」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 3.5,
      "id" : "FEB56069-6E7A-4438-9683-473A911F4877",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 1.9039002267573697,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.093.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #93",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 93",
      "telop" : "「ええ、それでお願いします。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "duration" : 4.159591836734694,
      "id" : "33D278A8-E142-47D3-B794-8FB110FC172B",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 3.5595918367346937,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.094.jpeg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #94",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_射命丸文.wav",
      "voiceCharacter" : "射命丸文",
      "title" : "シーン 94",
      "telop" : "「承知しました。では、今晩、お待ちしてますね。」"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 7.314761904761904,
      "id" : "E032F0A3-EF61-41C5-83E2-D29BEE220B1B",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.714761904761905,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.095.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #95",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 95",
      "telop" : "「わかりました。では失礼します。」\n僕はそう言うと、通話を切る。そして、部屋に戻る。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "duration" : 7.412607709750566,
      "id" : "10B02DF7-6902-4B33-9275-8E7015D39365",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 6.812607709750567,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.096.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #96",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_096_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 96",
      "telop" : "そして、部屋に戻るとあることを思い出し、操作盤を触る。\nそして、列車が減速しているのを確認する。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "duration" : 8.321995464852607,
      "id" : "5CFABB84-6563-4232-83DD-865E2F2CA2E6",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png",
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 7.721995464852608,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.097.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #97",
      "backgroundName" : "nc374640_電車内・座席・昼.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_097_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "title" : "シーン 97",
      "telop" : "すると、少しだけ列車が揺れたあと、スピードがだんだんと落ちていき、数十秒程度で、ドアが開いた。"
    },
    {
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "id" : "922D49B5-DB49-4D58-B270-0D7CE3D4FF4B",
      "duration" : 8.607165532879819,
      "transitionName" : "クロスディゾルブ",
      "voiceDuration" : 8.007165532879819,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.098.jpeg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #98",
      "backgroundName" : "咲夜困り顔.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_操夢.wav",
      "voiceCharacter" : "操夢",
      "title" : "シーン 98",
      "telop" : "そして、それから10分程度で全員がこの部屋に出揃った。\n僕はそれから、これからの計画、プランを話し始めた。"
    },
    {
      "title" : "シーン 99: 次回予告",
      "id" : "BE376B40-9470-4D4A-A064-5D3FEB848BB1",
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.099.jpeg",
