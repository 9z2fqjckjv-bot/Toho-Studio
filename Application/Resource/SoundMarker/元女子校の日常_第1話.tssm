      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #41",
      "telop" : "「分かりました、早苗師匠。」\n私はそう返すと、彼女に言われた通りに、彼に手本を見せる。",
      "id" : "506563A0-E754-43FF-AFCA-B385D2D83DCE",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.041.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 41",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceCharacter" : "古明地さとり"
    },
