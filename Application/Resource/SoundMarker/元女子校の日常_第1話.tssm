      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #3",
      "telop" : "「ちょうど、ちょうしょくができて食べ始めたところだから、あんたも早く、席に着いてちゃちゃっと食べちゃいなさい。」",
      "id" : "DFF0808B-AA5F-484B-91E2-26324F1B9DE0",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.003.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "title" : "シーン 3: 「ちょうど、朝食ができて食べ始めたところだから、あんたも早く、席に着いてちゃちゃっと食べちゃいなさい。」",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "voiceDuration" : 4.231065759637188,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav",
      "duration" : 4.8310657596371875,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #4",
      "telop" : "「分かった…」\n僕はそういうと、目の前の卵かけご飯を食べる。",
      "id" : "44FF7A77-E9AB-4234-A029-454217850E83",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.004.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "title" : "シーン 4",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 4.0619954648526075,
      "characterName" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav",
      "duration" : 4.661995464852607,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #5",
      "telop" : "「そういえば、入学式は、親の付き添いっているの？」",
      "id" : "6BC6505E-2BB5-4B26-94CA-0344691F2FA6",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.005.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "title" : "シーン 5",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "voiceDuration" : 3.108253968253968,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "duration" : 3.708253968253968,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #6",
      "telop" : "「いや、大丈夫だから、付き添わなくていいよ。」",
      "id" : "218D47B4-BDE1-42D5-81B5-B12B02BC55A1",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.006.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "title" : "シーン 6",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 7.211995464852608,
      "characterName" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav",
      "duration" : 7.8119954648526075,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #7",
      "telop" : "「そう、じゃあ、あんたの分の食器は自分で洗いなさいね。\n私は、もう神社に向かうから。」",
      "id" : "9EC33609-8ACB-4EA6-ADE3-25926BFAA631",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.007.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "title" : "シーン 7",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "voiceDuration" : 4.288684807256236,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "duration" : 4.888684807256236,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #8",
      "telop" : "「分かった。」\n僕がそういうと、彼女はそのまま家を出ていった。",
      "id" : "4127FB86-71A1-4C16-B2B9-4003EEF72D17",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.008.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "title" : "シーン 8",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 7.273469387755102,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "duration" : 7.873469387755102,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #9",
      "telop" : "僕は、それから数分も経たずに、朝食を食べ切ると、そのまま流しに食器を入れ、ささっと洗剤で洗う。",
      "id" : "565DD6AB-2A5D-40DB-A670-F39EE1635CB0",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.009.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "title" : "シーン 9",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 3.2756462585034014,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "duration" : 3.8756462585034015,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "スライド #10",
      "telop" : "そして、洗い物が終わると、自分の部屋に戻る。",
      "id" : "D09BF3B2-1545-43DF-8B87-A23872B84AC6",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.010.jpeg",
      "backgroundName" : "リビング（日中）.jpeg",
      "title" : "シーン 10",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 8.869115646258503,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "duration" : 9.469115646258503,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg",
      "slideTitle" : "スライド #11",
      "telop" : "そして、部屋に戻ると、新品の学校の制服を取り出し、ささっと着替える。そして、デスクをチラリと見ると、ある写真が写る。",
      "id" : "7BFE3B83-D2C1-4349-BB92-EC98061FC279",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.011.jpeg",
      "backgroundName" : "一人部屋３（日中）.jpg",
      "title" : "シーン 11",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 9.45281179138322,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "duration" : 10.05281179138322,
