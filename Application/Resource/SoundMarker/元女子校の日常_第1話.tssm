      "slideTitle" : "スライド #31",
      "telop" : "「おはようございます。」",
      "id" : "4E4CBEE0-5486-4155-A943-648E33DD1DC5",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.031.jpeg",
