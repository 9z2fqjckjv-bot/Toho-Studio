      "slideTitle" : "スライド #43",
      "telop" : "僕は、彼女にそう言われ、見よう見まねで挨拶とお辞儀をする。",
      "id" : "F7C30BEC-5E00-4517-8D79-5128469D6090",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.043.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 43",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 7.4156462585034015,
      "characterName" : "東風谷早苗",
