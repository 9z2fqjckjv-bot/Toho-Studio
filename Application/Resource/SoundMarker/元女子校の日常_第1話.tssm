      "duration" : 8.809342403628117,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #45",
      "telop" : "「分かりました…」僕はそう言われ、これまでの人生を振り返る。そのうち、スイッチが入ったように、その内容を語った。",
      "id" : "1EF5364F-6CE3-43BC-9C2B-8873DFB6DCFF",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.045.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 45",
      "audioTrack" : "track_voice_soumu",
