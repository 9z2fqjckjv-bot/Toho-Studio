      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #32",
      "telop" : "その女性がそういうと、周りの女子たちが皆一斉に「おはようございます」と言い、礼をする。",
      "id" : "CCD2B88F-542B-4D63-8B00-5591237FE8C8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.032.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 32",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 5.297777777777778,
      "characterName" : "東風谷早苗",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_東風谷早苗.wav",
      "duration" : 5.897777777777778,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #33",
      "telop" : "「おや…一人…はずれものがいますね…」\n私はそう言い、その男子に目線を合わせる。",
      "id" : "DFA16852-F8B7-4415-908E-342182FC5B2D",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.033.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 33",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗"
    },
    {
      "voiceDuration" : 6.126848072562359,
      "characterName" : "東風谷早苗",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_東風谷早苗.wav",
      "duration" : 6.726848072562358,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #34",
      "telop" : "「あなたも、今日から、この学園の一員ですから、\n挨拶の練習でもしましょうか…、藤原さん。」",
      "id" : "14488B8A-A7F5-4089-BC74-6C0AB67A5641",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.034.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 34",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗"
    },
    {
      "voiceDuration" : 6.95281179138322,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "duration" : 7.55281179138322,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #35",
      "telop" : "僕はそう言われ、僕に向けての声かけだったことに気づく。\n「あの…練習って…何をすればいいんですか？」",
      "id" : "DFA225A4-2F20-44C6-87B3-E4CFDB7396FB",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.035.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 35",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 3.3775736961451246,
      "characterName" : "東風谷早苗",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_東風谷早苗.wav",
      "duration" : 3.9775736961451247,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #36",
      "telop" : "「そうですね…とりあえず、私の方に来てください。」",
      "id" : "B08A44E6-76DB-4618-9C38-5A6995399742",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.036.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 36",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗"
    },
    {
      "voiceDuration" : 8.166938775510204,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "duration" : 8.766938775510203,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #37",
      "telop" : "僕は、彼女にそう言われ、彼女の隣に立つ。\nすると、彼女が再び挨拶し、女子から挨拶と礼が返ってくる。",
      "id" : "DD5B6337-86DD-48F4-AE39-CE958DECF8EE",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.037.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 37",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 5.734444444444445,
      "characterName" : "東風谷早苗",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_東風谷早苗.wav",
      "duration" : 6.334444444444444,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #38",
      "telop" : "「彼女たちのように、あなたも私の挨拶に対して、\n挨拶とお辞儀で返すことはできますか？」",
      "id" : "3D79B508-7177-4239-851C-5F6A385907CF",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.038.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 38",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗"
    },
    {
      "voiceDuration" : 8.436507936507937,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "duration" : 9.036507936507936,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #39",
      "telop" : "僕はそう言われ、どう返すべきかわからず、黙ってしまう…。\nすると、彼女がある女子を呼び、その女子は僕の反対側に立つ。",
      "id" : "8A2D543D-1337-4F66-89FC-94D9E7A0AF77",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.039.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 39",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 7.468979591836734,
      "characterName" : "東風谷早苗",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_東風谷早苗.wav",
      "duration" : 8.068979591836735,
      "animationName" : "なし",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "スライド #40",
      "telop" : "「さとりさん、私が今から、『おはようございます。』と言いますので、彼に返しの挨拶とお辞儀の手本を見せてください。」",
      "id" : "70C0CEBB-F366-479F-B643-D99934C4EBCC",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.040.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 40",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗"
    },
    {
      "voiceDuration" : 5.283378684807256,
      "characterName" : "古明地さとり",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地さとり.wav",
      "duration" : 5.883378684807256,
