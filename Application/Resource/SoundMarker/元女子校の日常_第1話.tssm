      "title" : "シーン 2",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "voiceDuration" : 7.794489795918367,
      "characterName" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_博麗霊夢.wav",
      "duration" : 8.394489795918368,
      "animationName" : "なし",
