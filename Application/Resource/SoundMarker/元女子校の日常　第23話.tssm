      "bgmStartTimeOffset" : 0,
      "telop" : "僕とアリスがホテルに早めに戻ると、僕が提案した、\n全国展開をしているステーキハウスにやってきた。",
      "seStartTimeOffset" : 0,
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg",
      "duration" : 6.647369614512471,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.027.jpeg",
      "audioTrack" : "track_voice_soumu",
