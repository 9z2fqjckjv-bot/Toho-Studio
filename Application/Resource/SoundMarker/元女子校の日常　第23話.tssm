      "bgmVolume" : 0.7,
      "id" : "A389E52F-3487-41CC-834C-FA5EA90EFDAB",
      "bgmStartTimeOffset" : 0,
      "telop" : "僕たちは、お店に入ると券売機で、事前に注文と支払いを済ませ、テーブル席に着くと、各自でサラダやご飯などを用意する。",
      "seStartTimeOffset" : 0,
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg",
