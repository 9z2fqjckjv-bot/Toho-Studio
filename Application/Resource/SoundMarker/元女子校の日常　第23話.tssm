  "scenes" : [
    {
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 1",
      "duration" : 8.022380952380953,
      "telop" : "あれから僕たちは、朝食を間にとって、恩納村にあるホテルにお昼前に着いた。そして、アリスが車を停めに向かう。\n東方Project二次創作作品",
      "voiceDuration" : 8.022380952380953,
      "slideTitle" : "スライド #1",
      "bgmVolume" : 0.7,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.001.jpeg",
      "bgmStartTimeOffset" : 0,
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "voice2StartTimeOffset" : 0,
      "id" : "CA1EED2E-7BA5-4EFD-B9B3-69BFAE9832E2",
      "transitionName" : "なし",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image69.jpeg",
      "backgroundName" : "image69.jpeg"
    },
    {
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav",
      "backgroundName" : "image70.jpeg",
      "bgmVolume" : 0.7,
      "characterName" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #2",
      "telop" : "アリスが車を停めに行っている間、僕はチェックインの手続きを済ます。そして、ロビーのソファで休んでいる二人の元に戻る。\n作成者：zuyasi",
      "audioTrack" : "track_voice_soumu",
      "id" : "363903C3-3045-4C9D-93EC-4097608E419F",
      "seStartTimeOffset" : 0,
      "duration" : 8.09954648526077,
      "voiceDuration" : 8.09954648526077,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 2",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.002.jpeg",
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "backgroundName" : "image70.jpeg",
      "bgmVolume" : 0.7,
      "characterName" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #3",
      "telop" : "僕が二人の元に来ると、ここまでの道中やホテルに対する感想を呟いていた。「お昼ご飯までは、休憩の時間にしますか？」",
      "audioTrack" : "track_voice_soumu",
      "id" : "4EBB82E6-A721-48F7-A793-3DEE61F88809",
      "seStartTimeOffset" : 0,
      "duration" : 8.573469387755102,
      "voiceDuration" : 8.573469387755102,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 3: 僕が二人の元に来ると、ここまでの道中やホテルに対する感想を呟いていた。「お昼ご飯までは、休憩の時間にしますか？」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.003.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png",
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "voiceCharacter" : "古明地こいし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地こいし.wav",
      "backgroundName" : "image70.jpeg",
      "bgmVolume" : 0.7,
      "characterName" : "古明地こいし",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #4",
      "telop" : "「そうしようかな…」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "id" : "B7A5358F-77AA-4E2D-B167-7C81D36E82E9",
      "seStartTimeOffset" : 0,
      "duration" : 1.4265079365079365,
      "voiceDuration" : 1.4265079365079365,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 4",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.004.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png",
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "voiceCharacter" : "古明地さとり",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg",
      "voice2StartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地さとり.wav",
      "backgroundName" : "image70.jpeg",
      "bgmVolume" : 0.7,
      "characterName" : "古明地さとり",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #5",
      "telop" : "「私も、こいしと同様に休憩の時間を取りたいです…」",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "id" : "A11F3FD8-29BC-4FD6-9425-421E4BBCD518",
      "seStartTimeOffset" : 0,
      "duration" : 2.9151927437641723,
      "voiceDuration" : 2.9151927437641723,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 5",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.005.jpeg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png",
      "transitionName" : "なし"
    },
    {
      "animationName" : "なし",
      "title" : "シーン 6",
      "transitionName" : "なし",
      "id" : "E874D5A6-B083-4032-8D1A-EA1A48724A76",
      "bgmVolume" : 0.7,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.366938775510205,
      "voice2StartTimeOffset" : 0,
      "telop" : "「分かりました…」僕たちがそう話していると、アリスがやってくる。それから、僕たちは、今日から泊まる4人部屋に移動した。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.006.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "seVolume" : 1,
      "slideTitle" : "スライド #6",
      "voiceStartTimeOffset" : 0,
      "backgroundName" : "image70.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg",
      "characterName" : "操夢",
      "duration" : 8.366938775510205,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"
    },
    {
      "animationName" : "なし",
      "title" : "シーン 7: 東方Project二次創作作品　Powerd By zuyasi",
      "transitionName" : "なし",
      "id" : "D222D784-E761-4BF6-B0C5-26AC8DC49FD0",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "telop" : "元女子校の日常",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.007.jpeg",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #7",
      "backgroundName" : "単色背景",
      "characterName" : "操夢",
      "duration" : 2.5
    },
    {
      "animationName" : "なし",
      "title" : "シーン 8",
      "transitionName" : "なし",
      "id" : "188D9220-13E4-47D0-AC8D-7F74FE81E6C7",
      "bgmVolume" : 0.7,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "voiceDuration" : 8.420204081632653,
      "voice2StartTimeOffset" : 0,
      "telop" : "僕たちがそれから、泊まる部屋にやってくると、その部屋は和洋折衷の4人部屋だった。すると、後ろから驚きの声がする。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.008.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "seVolume" : 1,
      "slideTitle" : "スライド #8",
      "voiceStartTimeOffset" : 0,
      "backgroundName" : "image71.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg",
      "characterName" : "操夢",
      "duration" : 8.420204081632653
    },
    {
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #9",
      "id" : "43A9DE37-5473-422B-A368-702DE67B391D",
      "voice2StartTimeOffset" : 0,
      "telop" : "「ここは、4人部屋で、ベッドが2つに、布団が2つある部屋ですよ。それで、誰がベッドを使いますか？」僕はそう、3人に聞く。",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg",
      "bgmVolume" : 0.7,
      "title" : "シーン 9",
      "duration" : 9.623469387755103,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png",
      "bgmStartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.009.jpeg",
      "backgroundName" : "image71.jpeg",
      "voiceDuration" : 9.623469387755103,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "seVolume" : 1,
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0
    },
    {
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #10",
      "id" : "610C0A34-A280-4A13-99E4-D7EDC8F6387D",
      "voice2StartTimeOffset" : 0,
      "telop" : "「私は、どっちでもいいわよ。」",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg",
      "bgmVolume" : 0.7,
