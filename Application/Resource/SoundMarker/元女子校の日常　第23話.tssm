      "id" : "5B057DAE-F5BE-40C4-9BAF-929BEC83EDAA",
      "characterName" : "操夢",
      "voiceDuration" : 8.509342403628118,
      "title" : "シーン 25",
      "telop" : "「確かにそうですね…。とりあえず、施設に戻りますか…。」\nそれから僕たちは、ここにくる前に通った案内施設に戻った。",
      "bgmStartTimeOffset" : -11.209886621315206,
      "seStartTimeOffset" : -11.209886621315206,
      "audioTrack" : "track_voice_soumu"
    },
    {
      "animationDuration" : 5,
      "voiceStartTimeOffset" : 0,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc356864_【ジングル？】恋色マジック.mp3",
      "slideTitle" : "スライド #26",
      "transitionName" : "なし",
      "animationNote" : "5秒",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "id" : "95C657B3-9149-459B-B740-AAC921BF222D",
      "bgmStartTimeOffset" : 0,
      "telop" : "主人公の母の友人\n主人公の彼の母、博麗霊夢の友人。彼とは、霊夢を介して一緒に、カラオケに出かける仲。そして、彼に、ときどき謎の小瓶を手渡しては、それを飲ませ、対価として小遣いを与えていた。だが、ある日、突如として繁華街で暴れた彼女は、学校の命令で、彼と交代する形で霊夢と妹紅と同じ家で共に暮らすことになった。\n霧雨魔理沙",
      "seStartTimeOffset" : 0,
      "characterName" : "博麗霊夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg",
      "duration" : 5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.026.jpeg",
      "seName" : "SE: nc356864_【ジングル？】恋色マジック",
      "animationName" : "なし",
      "seVolume" : 0.85,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/霧雨魔理沙_通常.png",
      "title" : "シーン 26",
      "backgroundName" : "image72.jpeg"
    },
