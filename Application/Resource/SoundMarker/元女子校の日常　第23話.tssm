      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.002.jpeg",
