      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.045.jpeg",
      "duration" : 3.5,
      "id" : "6FD8AD2B-5318-4797-805D-AF196DA9EBD0",
      "voiceDuration" : 2.481995464852608,
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_reimu",
      "telop" : "「よかったわ、目が覚めたようで。」"
    },
    {
      "title" : "シーン 46",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_046_博麗霊夢.wav",
      "slideTitle" : "スライド #46",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.046.jpeg",
      "duration" : 3.786984126984127,
      "id" : "4E4976EE-DE54-4233-B244-5414D8AE67A9",
      "voiceDuration" : 2.7712925170068026,
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_reimu",
      "telop" : "「母さん…」\n僕は、そう彼女に返す。"
    },
    {
      "title" : "シーン 47",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_博麗霊夢.wav",
      "slideTitle" : "スライド #47",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.047.jpeg",
      "duration" : 7.901995464852607,
      "id" : "7D904409-C097-4ABB-8B96-3E33C3B525AE",
      "voiceDuration" : 7.301995464852608,
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_reimu",
      "telop" : "「あんたが、呻いてるから、私が何度も声かけたのよ…、\n私に心配かけさせないでちょうだい…」"
    },
    {
      "title" : "シーン 48",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav",
      "slideTitle" : "スライド #48",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.048.jpeg",
      "duration" : 3.5,
      "id" : "831347FC-FAAE-4405-9A69-E565F5DDDAAF",
      "voiceDuration" : 1.5,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「ご…ごめんなさい…」"
    },
    {
      "title" : "シーン 49",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_博麗霊夢.wav",
      "slideTitle" : "スライド #49",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.049.jpeg",
      "duration" : 7.739478458049886,
      "id" : "45C55C49-095D-466C-80D5-2DC61C06085A",
      "voiceDuration" : 7.1394784580498865,
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_reimu",
      "telop" : "「いいわよ、謝らなくて、とりあえず、\n今晩はゆっくりと寝て、疲労回復に努めなさいね…」"
    },
    {
      "title" : "シーン 50",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_博麗霊夢.wav",
      "slideTitle" : "スライド #50",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.050.jpeg",
      "duration" : 4.354489795918367,
      "id" : "6560E025-C9A8-49CF-A2EF-AC89D87C1C63",
      "voiceDuration" : 3.754489795918367,
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_reimu",
      "telop" : "「これから私は家に帰るから、しっかりするのよ…」"
    },
    {
      "title" : "シーン 51",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav",
      "slideTitle" : "スライド #51",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.051.jpeg",
      "duration" : 9.50281179138322,
      "id" : "8283B199-1E8D-4104-983A-B6B67D5A2689",
      "voiceDuration" : 8.90281179138322,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "audioTrack" : "track_voice_soumu",
      "telop" : "彼女は、そういうと、涙を拭いながら、病室を出ていった。\n僕は、先ほどの悪夢で疲れ込んだのか、そのまま眠りに落ちた。"
    },
    {
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #52",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "霊夢が家に帰ると…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.052.jpeg",
      "title" : "シーン 52",
      "transitionName" : "なし",
      "animationName" : "なし",
