      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 62",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_062_妹紅.wav",
      "id" : "E524B053-C1BA-4F64-99CA-94662BC92EEC",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.062.jpeg",
      "voiceDuration" : 7.5245804988662135,
      "animationName" : "なし",
      "voiceCharacter" : "妹紅",
      "telop" : "「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」"
    },
