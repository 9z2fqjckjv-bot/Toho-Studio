      "duration" : 3.5,
      "id" : "E935CD2E-0871-469D-8A1E-E9A658FA2296",
      "voiceDuration" : 1.5,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そう、それは…"
    },
    {
      "title" : "シーン 45",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_博麗霊夢.wav",
