      "id" : "8B196C64-49B8-4D56-891D-1A7CF5ADFC80",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.008.jpeg",
      "animationName" : "なし",
      "duration" : 7.618231292517007,
      "audioTrack" : "track_voice_marisa",
      "telop" : "「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」",
      "slideTitle" : "スライド #8",
      "title" : "シーン 8",
      "characterName" : "霧雨魔理沙",
      "voiceCharacter" : "霧雨魔理沙",
      "voiceDuration" : 7.018231292517007
    },
    {
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #9",
      "duration" : 5.804988662131519,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.009.jpeg",
      "audioTrack" : "track_voice_soumu",
      "title" : "シーン 9",
      "animationName" : "なし",
      "telop" : "そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」",
      "voiceDuration" : 5.20498866213152,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "transitionName" : "カラーでフェード",
      "characterName" : "操夢",
      "id" : "50F0E544-47E8-45C9-A8A3-EBC6B8DA2965"
    },
    {
      "duration" : 19,
      "id" : "08778F1C-7F02-479A-B060-7A02DC4BC529",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.010.jpeg",
      "telop" : "元女子校の日常",
      "animationName" : "バウンス",
      "characterName" : "博麗霊夢",
      "backgroundName" : "単色背景",
      "slideTitle" : "スライド #10",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第3話_c997bea981\/slide_010_anim.m4v",
      "transitionName" : "なし",
      "title" : "シーン 10: 東方Project二次創作作品　Powerd By zuyasi"
    },
    {
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #11",
      "duration" : 4.090861678004535,
      "title" : "シーン 11",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.011.jpeg",
      "animationName" : "なし",
      "telop" : "そして、それから数分程度で霊夢が部屋に入ってくる。",
      "voiceDuration" : 3.490861678004535,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "characterName" : "操夢",
      "id" : "6F6540CD-F6EE-4C05-A5AE-4C9EC8B913DC"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "slideTitle" : "スライド #12",
      "duration" : 7.355736961451247,
      "title" : "シーン 12",
      "audioTrack" : "track_voice_reimu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.012.jpeg",
      "animationName" : "なし",
      "telop" : "「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」",
      "voiceDuration" : 6.755736961451247,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav",
      "characterName" : "博麗霊夢",
      "id" : "E9AA48E1-ED29-4C1A-9989-F68505565136"
    },
    {
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #13",
      "duration" : 7.0147619047619045,
      "title" : "シーン 13",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.013.jpeg",
      "animationName" : "なし",
      "telop" : "「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。",
      "voiceDuration" : 6.414761904761905,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav",
      "characterName" : "操夢",
      "id" : "FE9D84F8-C363-4974-9E11-648F7B918CC2"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "slideTitle" : "スライド #14",
      "duration" : 4.509478458049887,
      "title" : "シーン 14",
      "audioTrack" : "track_voice_reimu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.014.jpeg",
      "animationName" : "なし",
      "telop" : "「それに…最近…魔理沙の様子が変なのよね…」",
      "voiceDuration" : 3.9094784580498865,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav",
      "characterName" : "博麗霊夢",
      "id" : "9DE37A28-58F0-461D-8FB8-EDBB73BD9857"
    },
    {
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #15",
      "duration" : 6.95172335600907,
      "title" : "シーン 15",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.015.jpeg",
      "animationName" : "なし",
      "telop" : "「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」",
      "voiceDuration" : 6.35172335600907,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "characterName" : "操夢",
      "id" : "1D5591F1-08D0-4F3F-BC84-CC974A6C7164"
    },
    {
      "voiceCharacter" : "博麗霊夢",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "slideTitle" : "スライド #16",
      "duration" : 10.784489795918367,
      "title" : "シーン 16",
      "audioTrack" : "track_voice_reimu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.016.jpeg",
      "animationName" : "なし",
      "telop" : "「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」",
      "voiceDuration" : 10.184489795918367,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav",
      "characterName" : "博麗霊夢",
      "id" : "8E75486C-516A-47E4-A62E-D8495DE0FE11"
    },
    {
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #17",
      "duration" : 7.290861678004535,
      "title" : "シーン 17",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.017.jpeg",
      "animationName" : "なし",
      "telop" : "彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。",
      "voiceDuration" : 6.690861678004535,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "characterName" : "操夢",
      "id" : "8C561330-3EAF-4301-A332-DC876D33CF45"
    },
    {
      "voiceCharacter" : "操夢",
      "slideTitle" : "スライド #18",
      "duration" : 4.921292517006802,
      "title" : "シーン 18",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.018.jpeg",
      "animationName" : "なし",
      "telop" : "僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。",
      "voiceDuration" : 4.321292517006802,
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "characterName" : "操夢",
      "id" : "3FCCED6E-80F7-443B-99B1-24DC7780A0AA"
    },
    {
      "telop" : "附属病院のある診察室では…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "duration" : 3.5,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 19",
      "id" : "87254C8C-D875-4B18-8FCC-B12FD61B5790",
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.019.jpeg",
      "slideTitle" : "スライド #19"
    },
    {
      "voiceCharacter" : "永琳",
      "slideTitle" : "スライド #20",
      "duration" : 5.556916099773242,
      "title" : "シーン 20",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.020.jpeg",
      "animationName" : "なし",
      "telop" : "私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。",
      "voiceDuration" : 4.956916099773243,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_永琳.wav",
      "characterName" : "永琳",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "id" : "C5001225-F268-46CE-A1FE-828AEE7A543E"
    },
    {
      "title" : "シーン 21",
      "voiceDuration" : 9.21374149659864,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "永琳",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "telop" : "患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。",
      "id" : "0A26E0FF-AD4D-46AF-9D22-CE5E2B8EE792",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.021.jpeg",
      "duration" : 9.81374149659864,
      "characterName" : "永琳",
      "animationName" : "なし",
      "slideTitle" : "スライド #21",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_永琳.wav"
    },
    {
      "title" : "シーン 22",
      "voiceDuration" : 7.1946031746031744,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "永琳",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "telop" : "私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。",
      "id" : "7F3D70D5-2525-4D56-9C61-D700AEE3AEF3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.022.jpeg",
      "duration" : 7.794603174603174,
      "characterName" : "永琳",
      "animationName" : "なし",
      "slideTitle" : "スライド #22",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_永琳.wav"
    },
    {
      "title" : "シーン 23",
      "voiceDuration" : 8.678934240362812,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "永琳",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "telop" : "そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。",
      "id" : "EDE1B88F-33B4-4007-BB0A-38A3DF812244",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.023.jpeg",
      "duration" : 9.278934240362812,
      "characterName" : "永琳",
      "animationName" : "なし",
      "slideTitle" : "スライド #23",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav"
    },
    {
      "title" : "シーン 24",
      "voiceDuration" : 8.215668934240362,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "永琳",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "telop" : "彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…",
      "id" : "0C8D4D45-9532-4947-987B-C1683AFE4AA8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.024.jpeg",
      "duration" : 8.815668934240362,
      "characterName" : "永琳",
      "animationName" : "なし",
      "slideTitle" : "スライド #24",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_永琳.wav"
    },
    {
      "title" : "シーン 25",
      "voiceDuration" : 7.20421768707483,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "永琳",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "telop" : "すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。",
      "id" : "79AF34E0-562A-4424-B06B-1A117233CAAA",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.025.jpeg",
      "duration" : 7.804217687074829,
      "seName" : "SE: 木のドアをノック1",
      "characterName" : "永琳",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "animationName" : "なし",
      "slideTitle" : "スライド #25",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav"
    },
    {
      "title" : "シーン 26",
      "voiceDuration" : 7.111587301587302,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "射命丸文",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "transitionName" : "なし",
      "telop" : "「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。",
      "id" : "CDCE1E9F-E35D-4772-958E-B44503AE9992",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.026.jpeg",
      "duration" : 7.7115873015873015,
      "characterName" : "射命丸文",
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png",
      "slideTitle" : "スライド #26",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_射命丸文.wav"
    },
    {
      "title" : "シーン 27",
      "voiceDuration" : 8.62358276643991,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "射命丸文",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "transitionName" : "なし",
      "telop" : "「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」",
      "id" : "114CCCCC-6099-4B5E-A829-366C98A55C6C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.027.jpeg",
      "duration" : 9.22358276643991,
      "characterName" : "射命丸文",
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png",
      "slideTitle" : "スライド #27",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_射命丸文.wav"
    },
    {
      "title" : "シーン 28",
      "voiceDuration" : 7.520181405895691,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "射命丸文",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "transitionName" : "なし",
      "telop" : "「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」",
      "id" : "C7959C8C-FE08-40D2-B1D6-31D755C6ED15",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.028.jpeg",
      "duration" : 8.120181405895691,
      "characterName" : "射命丸文",
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png",
      "slideTitle" : "スライド #28",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_射命丸文.wav"
    },
    {
      "title" : "シーン 29",
      "voiceDuration" : 3.6015873015873017,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "射命丸文",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "transitionName" : "なし",
      "telop" : "「それと、息子さんの言ってたことは全て事実だそうですよ。」",
      "id" : "8DFBE84D-E705-4723-B3BC-A86924CD03CC",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.029.jpeg",
      "duration" : 4.201587301587302,
      "characterName" : "射命丸文",
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png",
      "slideTitle" : "スライド #29",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_射命丸文.wav"
    },
    {
      "title" : "シーン 30",
      "voiceDuration" : 7.224897959183673,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "永琳",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "telop" : "「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。",
      "id" : "414AA7D7-C0E3-48FE-B1F8-F05A9C9D5805",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.030.jpeg",
      "duration" : 7.837573696145125,
      "characterName" : "永琳",
      "animationName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png",
      "slideTitle" : "スライド #30",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_030_永琳.wav"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 31",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "transitionName" : "なし",
      "duration" : 4.705578231292517,
      "id" : "2DEC7B3B-35A3-464C-A0DC-37AEB22BC459",
      "animationName" : "なし",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #31",
      "voiceCharacter" : "射命丸文",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "「代金、確かにいただきました。それでは、またのご利用を。」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.031.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_射命丸文.wav",
      "voiceDuration" : 4.105578231292517
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 32",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "duration" : 6.813832199546485,
      "id" : "2230F927-1EF6-474C-A6C7-1657D4956DBA",
      "animationName" : "なし",
      "characterName" : "永琳",
      "slideTitle" : "スライド #32",
      "voiceCharacter" : "永琳",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_永琳.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.032.jpeg",
      "voiceDuration" : 6.213832199546485
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 33",
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "transitionName" : "なし",
      "duration" : 7.929614512471655,
      "id" : "A7C65139-D5A2-46AE-BF13-0328BAB71000",
      "animationName" : "なし",
      "characterName" : "永琳",
      "slideTitle" : "スライド #33",
      "voiceCharacter" : "永琳",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.033.jpeg",
      "voiceDuration" : 7.329614512471656
    },
    {
      "telop" : "彼に視点が戻り…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "duration" : 3.5,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 34",
      "id" : "5BA4849D-4A8F-4504-960F-8D74A7707798",
      "animationName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.034.jpeg",
      "slideTitle" : "スライド #34"
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 35",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #35",
      "duration" : 10.089773242630384,
      "characterName" : "操夢",
      "id" : "0ABC7DD8-702D-489E-A53C-A2D5E149D4BF",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_035_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.035.jpeg",
      "voiceDuration" : 9.489773242630385
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 36",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #36",
      "duration" : 8.966938775510204,
      "characterName" : "操夢",
      "id" : "E5416AF0-C37C-479B-93D3-93452390778B",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.036.jpeg",
      "voiceDuration" : 8.366938775510205
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 37",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #37",
      "duration" : 8.861519274376416,
      "characterName" : "操夢",
      "id" : "1D7DCF61-9875-4C35-829D-E443CFCD9925",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.037.jpeg",
      "voiceDuration" : 8.261519274376417
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 38",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #38",
      "duration" : 9.297369614512471,
      "characterName" : "操夢",
      "id" : "8099BFE8-67E4-4C34-8876-15C79677550A",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.038.jpeg",
      "voiceDuration" : 8.697369614512471
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 39",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #39",
      "duration" : 9.125646258503401,
      "characterName" : "操夢",
      "id" : "E05BE6F5-49B7-4E4E-98F6-B73AB186CCD0",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.039.jpeg",
      "voiceDuration" : 8.525646258503402
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 40",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #40",
      "duration" : 8.45607709750567,
      "characterName" : "操夢",
      "id" : "8C82962E-CDCD-4663-BABA-CE3D59171098",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.040.jpeg",
      "voiceDuration" : 7.856077097505669
    },
    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 41",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "なし",
      "animationName" : "なし",
      "slideTitle" : "スライド #41",
      "duration" : 6.840861678004535,
      "characterName" : "操夢",
      "id" : "46D6A17B-421B-4328-8511-903EFB10BAD8",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.041.jpeg",
      "voiceDuration" : 6.240861678004535
    },
    {
      "title" : "シーン 42",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
      "slideTitle" : "スライド #42",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.042.jpeg",
      "duration" : 9.403900226757369,
      "id" : "286A26F1-EB3A-4B0C-9E0F-FDE084EAE892",
      "voiceDuration" : 8.803900226757369,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。"
    },
    {
      "title" : "シーン 43",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "slideTitle" : "スライド #43",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.043.jpeg",
      "duration" : 9.20172335600907,
      "id" : "4ADFE473-4006-43EC-B914-13CF7AA0AC3F",
      "voiceDuration" : 8.601723356009071,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…"
    },
    {
      "title" : "シーン 44",
      "transitionName" : "なし",
