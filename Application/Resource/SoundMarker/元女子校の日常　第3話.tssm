      "title" : "シーン 53",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav",
      "id" : "AF4ABA44-968F-47E7-ACAA-C3725B432E66",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.053.jpeg",
      "voiceDuration" : 4.031995464852607,
      "animationName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "telop" : "私が家に帰ってくると、すでに夫がリビングにいた。"
    },
    {
      "slideTitle" : "スライド #54",
      "duration" : 6.843333333333333,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "characterName" : "妹紅",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 54",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_妹紅.wav",
      "id" : "2D1472FC-1106-4B95-8DE5-B65C32C04938",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.054.jpeg",
      "voiceDuration" : 6.243333333333333,
      "animationName" : "なし",
      "voiceCharacter" : "妹紅",
      "telop" : "「霊夢、お前その顔どうした？」\n私は、彼女が泣いた後の表情をしていたのでそう問いかける。"
    },
    {
      "slideTitle" : "スライド #55",
      "duration" : 4.964489795918367,
      "audioTrack" : "track_voice_reimu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 55",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav",
      "id" : "956EB0B4-4C52-40FB-A89E-CCCB315A90FF",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.055.jpeg",
      "voiceDuration" : 4.3644897959183675,
      "animationName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "telop" : "「そんなことどうだっていいわ、それより、夕飯は食べたの？」"
    },
    {
      "slideTitle" : "スライド #56",
      "duration" : 3.86,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "characterName" : "妹紅",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 56",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_妹紅.wav",
      "id" : "D6C3FA10-DAC3-4538-B396-F6153F473624",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.056.jpeg",
      "voiceDuration" : 3.26,
      "animationName" : "なし",
      "voiceCharacter" : "妹紅",
      "telop" : "「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」"
    },
    {
      "slideTitle" : "スライド #57",
      "duration" : 7.335736961451246,
      "audioTrack" : "track_voice_reimu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 57",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav",
      "id" : "BF134A0B-4B24-4390-8E0B-7406FEBAD78C",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.057.jpeg",
      "voiceDuration" : 6.735736961451247,
      "animationName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "telop" : "「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。"
    },
    {
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #58",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "霊夢がお風呂を澄ますと…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.058.jpeg",
      "title" : "シーン 58",
      "transitionName" : "なし",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.5,
      "id" : "9D0BBCAA-4221-4441-A3B7-C1B5B945839B"
    },
    {
      "slideTitle" : "スライド #59",
      "duration" : 9.024489795918367,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "audioTrack" : "track_voice_reimu",
      "characterName" : "博麗霊夢",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 59",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav",
      "id" : "2877EC51-11A6-4EB2-80F2-5E90A4A3FF84",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.059.jpeg",
      "voiceDuration" : 8.424489795918367,
      "animationName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "telop" : "私がお風呂から戻ってくると、彼はビール缶をあけ、ため息をついていた。「何か現場仕事に不満でもあるの？」"
    },
    {
      "slideTitle" : "スライド #60",
      "duration" : 3.905827664399093,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "characterName" : "妹紅",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 60",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav",
      "id" : "5963F13D-6FB3-4048-9BDB-DAA802A55EF8",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.060.jpeg",
      "voiceDuration" : 3.305827664399093,
      "animationName" : "なし",
      "voiceCharacter" : "妹紅",
      "telop" : "「今日は、例の紅魔建設からの依頼だったんだけど…」"
    },
    {
      "slideTitle" : "スライド #61",
      "duration" : 12.114739229024943,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "audioTrack" : "track_voice_reimu",
      "characterName" : "博麗霊夢",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "title" : "シーン 61",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_061_博麗霊夢.wav",
      "id" : "C670EE94-62FB-4FA5-9F40-1149E5BB2BBD",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.061.jpeg",
      "voiceDuration" : 11.679727891156462,
      "animationName" : "なし",
      "voiceCharacter" : "博麗霊夢",
      "telop" : "彼はそういうと、その話を始める。特殊な力で一瞬で建造物を破壊できる女性がいる一族経営の館の解体工事中の出来事だった。"
    },
    {
      "slideTitle" : "スライド #62",
