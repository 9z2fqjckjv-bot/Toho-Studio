      "animationName" : "なし"
    },
    {
      "id" : "13C850F1-EC57-4F37-BBCB-C2B32F0FB09B",
      "telop" : "「まぁ、僕は今が、良ければそれでいいと思ってます。」",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
