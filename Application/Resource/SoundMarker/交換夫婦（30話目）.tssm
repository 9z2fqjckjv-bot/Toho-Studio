      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "ソ_シテ、ソンナ\/カイソーオ\/オワラセルト、ニモ_ツセ'ーリオ\/ハジメル。ト\/イッテ'モ、ジゼンニ\/オ'ーキナモノワ\/ハイソーズミナ'ノデ、ポケベルダケ+モ'_ツ。",
      "sceneIndex" : 3,
      "character" : "操夢",
      "isLooping" : false,
      "text" : "そして、そんな回想を終わらせると、荷物整理を始める。といっても、事前に大きなものは配送済みなので、ポケベルだけ持つ。",
      "playbackRate" : 1,
