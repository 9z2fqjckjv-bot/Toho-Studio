      "voiceType" : "女声2 (高め)",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "カ'レノ\/セ'ンゾワ、ダイダイト\/ソノ\/キオクオ\/ウケツギ、カ'レノ\/シュ'ゾクワ、セ'カイノ\/シ'_ステムト\/ハケンオ\/ニギリシ'メ、ソノ\/イッタンガ\/カ'レニ\/ナ'ッテ+イル。",
      "sceneIndex" : 63,
      "character" : "パチュリー・ノーレッジ",
      "isLooping" : false,
      "text" : "彼の先祖は、代々とその記憶を受け継ぎ、彼の種族は、世界のシステムと覇権を握り締め、その一端が彼になっている。",
      "playbackRate" : 1,
