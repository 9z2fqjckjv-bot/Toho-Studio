      "title" : "シーン 67",
      "slideTitle" : "スライド #67",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_フランドール・スカーレット.wav",
      "voiceCharacter" : "フランドール・スカーレット",
      "animationName" : "なし"
    },
    {
      "id" : "456CCB01-F8D5-4C89-8FE2-C1C9ADAB870D",
      "telop" : "「ちょっと、昔を思い出したくてね…、\nそれで、フランからどんな話を聞いていたの？」",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 4.466303854875283,
      "duration" : 5.066303854875283,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.068.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 68",
      "slideTitle" : "スライド #68",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "F6C71F44-57E0-4496-8891-77895D07A1D5",
      "telop" : "「例えばね…」\n私はそう、私の先祖であるフランから聞いた話をする。",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 5.629478458049887,
      "duration" : 6.229478458049886,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.069.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 69",
      "slideTitle" : "スライド #69",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_フランドール・スカーレット.wav",
      "voiceCharacter" : "フランドール・スカーレット",
      "animationName" : "なし"
    },
    {
      "id" : "9EE549FC-3B7F-4F53-8679-1C3FB33A3B23",
      "telop" : "私は、彼女の話を聞き、ふとさっきまで読んでいた本当の違いに気づく。幻想郷と外の世界では時間軸がずれているようだ。",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 7.353469387755102,
      "duration" : 7.953469387755102,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.070.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 70",
      "slideTitle" : "スライド #70",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "B90BE741-D641-430F-9179-9B6447FB98EC",
      "telop" : "「だとしても、おかしいわね…、\nフランは、何か日付に関することを言ってたかしら？」",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 4.462380952380952,
      "duration" : 5.062380952380952,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.071.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 71",
