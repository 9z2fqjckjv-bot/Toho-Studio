    {
      "id" : "05B97A59-0F93-4479-B9D4-1A7A56435542",
      "telop" : "僕たちは、風呂から上がると、僕の部屋で、しばし談笑をしていた。それで、共同生活よりも前の話を色々と聞く。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceDuration" : 8.438684807256235,
      "duration" : 9.038684807256235,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.037.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 37",
      "slideTitle" : "スライド #37",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "8451A86A-AF80-41BA-A850-FBCA974D3021",
      "telop" : "「それで、操夢は共同生活が始まるまではどうしてたの？」",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png",
