      "title" : "シーン 29",
      "slideTitle" : "スライド #29",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし"
    },
    {
      "id" : "67FFDC86-704A-4A22-BA7F-45F25A3A71A1",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "telop" : "僕が食事を終えて、歯を磨いた後、部屋でくつろいでると、\n再び、部屋の扉がノックされる。「どうぞ。」",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.214761904761905,
