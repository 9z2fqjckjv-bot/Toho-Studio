      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "33F26CDC-306C-4B79-9839-F90C25344036",
      "telop" : "すると、入ってきたのはフランだった。\n「どうしたんですか、そんな表情をして？」",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 5.115850340136054,
      "duration" : 5.715850340136054,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.031.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 31",
      "slideTitle" : "スライド #31",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "E23F6A16-7075-4AAF-91FB-5D2667195E5B",
      "telop" : "「操夢…一緒に、お風呂入ろう…」",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 2.7819954648526077,
