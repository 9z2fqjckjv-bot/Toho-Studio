      "voiceCharacter" : "フランドール・スカーレット",
      "animationName" : "なし"
    },
    {
      "id" : "A854BE73-4F5E-4D60-A1A6-5828F241A9DD",
      "telop" : "彼女はそう言うと、部屋をさっていった。僕は、なぜあんなことを聞いたのか気になったが、とりあえず着替えを持っていった。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.636507936507937,
