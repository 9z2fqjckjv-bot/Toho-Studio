    {
      "id" : "9B066CFE-E889-4C74-9335-9AFC019FB24B",
      "audioFilePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_079_操夢.wav",
      "voiceType" : "中性",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "ニセンナナジュウバツ'ネン、シガツ'\/マル_ヒ。ボ'クワ、シンセ'ーカツノ\/ハジマリカラ\/バツネンメノ\/ア'ル+_ヒ'、ボ'クワ、<NUMK VAL=\"2\" COUNTER=\"ネン\">マ'エニ\/テガ'ケタ\/シ'_ステムカラ\/ア'ル\/ジョーホーオ\/ニュー_シュシタ。",
      "sceneIndex" : 79,
      "character" : "操夢",
      "isLooping" : false,
      "text" : "にせんななじゅうばつ年、4月まる日。僕は、新生活の始まりからばつ年目のある日、僕は、2年前に手がけたシステムからある情報を入手した。",
