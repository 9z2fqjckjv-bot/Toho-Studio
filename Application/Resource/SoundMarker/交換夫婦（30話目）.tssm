      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.021.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 21",
      "slideTitle" : "スライド #21",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "C26568EC-7436-4D14-8FD1-4041026EADBB",
      "telop" : "「おや、今日から新たな住人になった、操夢さんですか？」",
      "characterName" : "美鈴",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 2.550068027210884,
      "duration" : 3.1500680272108843,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.022.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 22",
      "slideTitle" : "スライド #22",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "id" : "A68958B0-1D33-4463-89F1-A461FB20BF2A",
      "telop" : "「それで、あなたは…」",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 1.5,
      "duration" : 2.5,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.023.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 23",
      "slideTitle" : "スライド #23",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "22125EAD-D808-4DE6-BA6D-46589CBACA5D",
      "telop" : "「私の名前は、本美鈴です。夕食ができたので、操夢さんを食堂に案内せよと、レミリアが言ってまして…。」",
      "characterName" : "美鈴",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 5.210226757369615,
      "duration" : 5.810226757369614,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.024.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 24",
      "slideTitle" : "スライド #24",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_024_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "id" : "7CBADAB2-50D5-4381-AC55-153AF3D44A88",
      "telop" : "「そうですか…、ちょっと待ってください。」\n僕はそう言い、辺りを一瞬見渡す。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 5.121292517006803,
      "duration" : 5.721292517006803,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.025.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 25",
      "slideTitle" : "スライド #25",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "D44CFA63-67C9-46DC-8FC9-0CE6F2038D89",
      "telop" : "「今から、動いて大丈夫ですよ。」僕はそう返す。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 3.7582539682539684,
      "duration" : 4.358253968253968,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.026.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 26",
      "slideTitle" : "スライド #26",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "AAB9B2FF-51BC-470D-BC69-1AD6C25C2A90",
      "telop" : "「そうですか、それなら案内しましょう。」",
      "characterName" : "美鈴",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 1.6629024943310657,
      "duration" : 2.5,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.027.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 27",
      "slideTitle" : "スライド #27",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_027_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "id" : "ADD36300-F6B0-4311-93D2-B939E93A17AC",
      "telop" : "そして、僕が食堂に入ると、すでに夕食が配膳されていた。\nそして挨拶を済ますと、皆が食べ始めた。",
      "characterName" : "操夢",
      "backgroundName" : "nc196982_食堂(夜2).png",
      "voiceDuration" : 7.703900226757369,
      "duration" : 8.303900226757369,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.028.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav",
      "title" : "シーン 28",
      "slideTitle" : "スライド #28",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "BD402511-DCCB-458A-B612-271B38FC6A30",
      "animationDuration" : 3,
      "telop" : "それからしばらくたち…",
      "characterName" : "ナレーション",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3,
      "transitionName" : "なし",
