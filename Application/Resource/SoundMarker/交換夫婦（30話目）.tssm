      "voiceType" : "女声2 (高め)",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "、\/ド'レ\/ド'レ、ワタシワ\/サ_キホド、ヨ'ンダ\/ホ'ンオ\/モーイチド、ヨミナオ'_ス。ソコニ'ワ、カ'レノ\/セ'ンゾト\/フ'ランノ\/ケッコンセ'ーカツガ\/エガカ'レテ+イタ。",
      "sceneIndex" : 77,
