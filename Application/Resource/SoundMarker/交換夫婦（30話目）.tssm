      "animationName" : "なし"
    },
    {
      "id" : "694293DC-7F49-4F14-B32A-62EDABDCC655",
      "telop" : "「それで、あのバックアップ本で何を調べていたの？」",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 3.7394784580498865,
      "duration" : 4.339478458049887,
