      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_パチュリー・ノーレッジ.wav",
      "voiceType" : "女声2 (高め)",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "ワタシワ、カ'ノジョノ\/ハナシ'オ+キ_キ、_フト\/サ'ッキマデ\/ヨ'ンデ+イタ\/ホントーノ\/チガイニ\/キズ'_ク。ゲンソ'ーキョート\/ソ'トノ\/セ'カイデワ\/ジカ'ンジクガ\/ズ'レテイル+ヨ'ーダ。",
      "sceneIndex" : 70,
      "character" : "パチュリー・ノーレッジ",
      "isLooping" : false,
      "text" : "私は、彼女の話を聞き、ふとさっきまで読んでいた本当の違いに気づく。幻想郷と外の世界では時間軸がずれているようだ。",
