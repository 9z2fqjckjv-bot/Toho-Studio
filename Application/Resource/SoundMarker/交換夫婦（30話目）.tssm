      "voiceType" : "女声2 (高め)",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "ワタシワ\/_キカイオ'ンチダカラ、ショーサイワ\/ワカリカ'ネタガ、ソ'ー\/イウ\/コトバ'オ\/ノ'ベタ。ハカイト\/セ'ーワ\/ツ'ネニ\/_ヒト'ツ\/ナ'リ、ド'コカニ\/アリソ'ーダワ、",
      "sceneIndex" : 91,
