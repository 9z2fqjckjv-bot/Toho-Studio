      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_パチュリー・ノーレッジ.wav",
      "voiceType" : "女声2 (高め)",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "<NUMK VAL=\"21\">セ'ーキ\/ナカバ'ニ、ゲンソ'ーキョーカラ\/ソ'トノ\/セ'カイエ\/ダイイ'ドー、ソ_シテ\/<NUMK VAL=\"21\">セ'ーキノ\/コーハンニ'ワ、カ'レノ\/セ'ンゾガ\/タンジョー、ソ_シテ、サ'ラニ、ドキ'ガ\/タ'チ+イ'マ。",
