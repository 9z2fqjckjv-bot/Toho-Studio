      "voiceType" : "女声2 (高め)",
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true,
      "voiceSymbol" : "、\/チョ'ット、ムカシオ\/オモイダ_シタ'_クテネ、ソレデ、フ'ランカラ\/ド'ンナ\/ハナシ'オ\/キイテイタ'ノ？",
      "sceneIndex" : 68,
      "character" : "パチュリー・ノーレッジ",
      "isLooping" : false,
      "text" : "「ちょっと、昔を思い出したくてね…、それで、フランからどんな話を聞いていたの？」",
