      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 52",
      "slideTitle" : "スライド #52",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_レミリア・スカーレット.wav",
      "voiceCharacter" : "レミリア・スカーレット",
      "animationName" : "なし"
    },
    {
      "id" : "780CBFF1-1B16-4ADC-81DD-859C25203C23",
      "telop" : "「はい、いいですよ。それで何でしょう？」\n僕がそう尋ねると、彼女が僕の背中に回る。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.506077097505669,
      "duration" : 7.106077097505668,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.053.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 53",
      "slideTitle" : "スライド #53",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "53D65E40-0A2F-4C00-9AF8-D07A3F5D80B7",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ1.mp3",
      "telop" : "すると、僕に彼女は背後から抱きつき、\n顔を背中に埋めているが、感覚で伝わってくる。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.032154195011338,
      "seName" : "SE: 衣擦れ1",
      "duration" : 6.632154195011338,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.054.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 54",
      "slideTitle" : "スライド #54",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "53B066B0-B9F5-4F4D-99DD-CA0DE1C422C8",
      "telop" : "「私がたまに、あなたを呼んだらこうやってくれないかしら？こうしてくれると、心が温まるし、2度とはああならないから…」",
      "characterName" : "レミリア・スカーレット",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.683832199546485,
      "duration" : 8.283832199546485,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.055.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 55",
      "slideTitle" : "スライド #55",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_レミリア・スカーレット.wav",
      "voiceCharacter" : "レミリア・スカーレット",
      "animationName" : "なし"
    },
    {
      "id" : "CE7ED56D-DC30-4B06-953E-FA52ADE40CAA",
      "telop" : "「ええ、お安い御用ですよ。」僕は、そう言いながら、\n彼女の背後に回り、そっと頭を撫でる。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.723469387755102,
      "duration" : 7.323469387755102,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.056.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 56",
      "slideTitle" : "スライド #56",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "5387DB4A-7674-448C-8DF3-D089C9A6D4C3",
      "telop" : "「ありがとう、操夢。これから、私たちの一員として、\nよろしくね…、フランの…、旦那さん…」",
      "characterName" : "レミリア・スカーレット",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.429659863945578,
      "duration" : 7.029659863945578,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.057.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 57",
      "slideTitle" : "スライド #57",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_レミリア・スカーレット.wav",
      "voiceCharacter" : "レミリア・スカーレット",
      "animationName" : "なし"
    },
    {
      "id" : "32DEBBD3-0504-4B43-98FF-E1ED4134357A",
      "telop" : "「ええ、もちろん。」\n僕たちは、そう言って、新生活が始まった。",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 4.9104308390022675,
      "duration" : 5.510430839002267,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.058.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 58",
      "slideTitle" : "スライド #58",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "id" : "2B97E589-38B3-4B0F-95E9-2A4E9B084E8D",
      "animationDuration" : 3,
      "telop" : "時代が進み…\n※詳細は、彷徨う二人の5話目を参照してください。",
      "characterName" : "ナレーション",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3,
      "transitionName" : "なし",
      "animationNote" : "表示時間：3秒",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.059.jpeg",
      "title" : "シーン 59",
      "slideTitle" : "スライド #59",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし"
    },
    {
      "id" : "37EA9290-F451-4645-B872-EA53DBF08073",
      "telop" : "私は、久々にフランと対面したが、どうやらフレラとの違いは、この記録を見る限り見た目だけだった。",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 5.686621315192744,
      "duration" : 6.286621315192743,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.060.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 60",
      "slideTitle" : "スライド #60",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "CFE66778-E5C3-461A-8AC4-50EC9DD3074F",
      "telop" : "「でも、あれから少なくとも１世紀以上経ってるのよね…」\n私は、幻想郷にいた頃が遠い昔のように感じられる。",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 6.399342403628118,
      "duration" : 6.999342403628118,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.061.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 61",
      "slideTitle" : "スライド #61",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "14D87CDE-5C50-47C0-B193-AC48864FFB7F",
      "telop" : "21世紀半ばに、幻想郷から外の世界へ大移動、そして21世紀の後半には、彼の先祖が誕生、そして、さらに、時がたち今…。",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 8.507709750566894,
      "duration" : 9.107709750566894,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.062.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 62",
      "slideTitle" : "スライド #62",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "31A7703D-06E5-4916-A289-617800C0FD93",
      "telop" : "彼の先祖は、代々とその記憶を受け継ぎ、彼の種族は、世界のシステムと覇権を握り締め、その一端が彼になっている。",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 6.878140589569161,
      "duration" : 7.47814058956916,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.063.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 63",
      "slideTitle" : "スライド #63",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "E6855733-86C1-4C1A-AC63-FB8AE308D885",
      "telop" : "そして、「その記憶のバックアップ本」がこの図書館に眠っていると…、「誰が予想してたのかしら、こんな未来…。」",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 5.602154195011338,
      "duration" : 6.202154195011338,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.064.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 64",
      "slideTitle" : "スライド #64",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "803380DA-F80C-4438-BB15-C9D07F04FBE1",
      "telop" : "すると、フレラが、私のもとにやってくる。\n「フレラ、この本の山、片付けてくれるかしら？」",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 5.384988662131519,
      "duration" : 5.984988662131519,
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.065.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "title" : "シーン 65",
      "slideTitle" : "スライド #65",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_065_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "id" : "E1454990-3D1E-4FDF-AF5F-30054A36EE2A",
      "telop" : "「分かった。」私はそう言うと、その本の山を片付ける。",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 4.790748299319728,
      "duration" : 5.3907482993197275,
