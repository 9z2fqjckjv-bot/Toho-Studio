      "animationName" : "なし"
    },
    {
      "id" : "5D64285E-6CF6-4891-9961-FCFBAAC6C914",
      "telop" : "「いや、特に言ってなかった。\nただ、レミリアに追い出されたって。」",
      "characterName" : "フランドール・スカーレット",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "voiceDuration" : 5.101995464852608,
