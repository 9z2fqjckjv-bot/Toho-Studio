    {
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg",
