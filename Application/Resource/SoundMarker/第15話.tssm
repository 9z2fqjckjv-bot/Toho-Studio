      "duration" : 4.736984126984127,
      "animationName" : "なし"
    },
    {
      "telop" : "「お金が入らなくてもいいじゃないですか。こうして、二人でいつも通りの平和と、幸せを感じ取れるんだったら。」",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
