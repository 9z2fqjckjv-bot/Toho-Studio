      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 6.35172335600907,
      "transitionName" : "なし",
      "title" : "シーン 2"
    },
    {
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.003.jpeg",
      "audioTrack" : "track_voice_reimu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_博麗霊夢.wav",
