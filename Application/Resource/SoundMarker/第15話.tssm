      "audioTrack" : "track_voice__9F71",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_ナレーション.wav",
      "telop" : "「どのようなご用件か、お申し付けいただくか、\n操作盤から指示を出してください。」",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 5.85390022675737,
      "slideTitle" : "スライド #7",
      "id" : "47662F97-6983-4650-9C93-B98FA342490A",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "voiceDuration" : 5.25390022675737,
      "transitionName" : "なし",
      "title" : "シーン 7"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.008.jpeg",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "telop" : "僕は、その機械がそういうと、ここに来た目的を果たし始めた。",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.943038548752834,
      "slideTitle" : "スライド #8",
      "id" : "5099240F-9E50-4814-970C-D1DEB3F519A1",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 4.343038548752834,
      "transitionName" : "なし",
      "title" : "シーン 8"
    },
    {
      "telop" : "幼き日の夢",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第15話_default\/slide_009_anim.m4v",
      "transitionName" : "なし",
      "duration" : 6,
      "animationName" : "バウンス",
      "backgroundName" : "単色背景",
      "characterName" : "博麗霊夢",
      "id" : "CA5DED63-C480-484B-A9AC-FD934F6C4905",
      "slideTitle" : "スライド #9",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.009.jpeg",
      "title" : "シーン 9: @zuyasi　東方Project二次創作作品"
    },
    {
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.010.jpeg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "telop" : "僕は、ここに来た目的、とあるミサイルによって破滅してしまった、外の世界にこの幻想郷を広げるための行動を実行した。",
      "animationName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.085419501133787,
      "slideTitle" : "スライド #10",
      "id" : "23A521A9-CF82-4107-AA5F-B048B928BC90",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.485419501133787,
      "transitionName" : "なし",
      "title" : "シーン 10"
    },
    {
      "slideTitle" : "スライド #11",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "僕は、この幻想郷に来る前、ある実験を受けて、生き残ったもので、どうすれば、この世界を救出できるかを話し合った。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.011.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "duration" : 9.020204081632652,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 8.420204081632653,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 11",
      "id" : "B9E86E3F-2A88-4679-9466-0452C05E0C43",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #12",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "その結果、この幻想郷に賭けるしかないという結論に至り、当時、子どもの状態で実験を受けた僕が、派遣された。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.012.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "duration" : 8.841950113378685,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 8.241950113378685,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 12",
      "id" : "BEBFA9F5-6676-4699-8D5B-23E1DA0FC556",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #13",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "そして、この別世界で破滅した外の世界を覆い尽くすのが目的だった。そして、今、その目的は達成したと言えるだろう。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.013.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav",
      "duration" : 9.187596371882085,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 8.587596371882086,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 13",
      "id" : "FBAF26C5-BCF7-4049-98CA-B9F576FE9397",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #14",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "そこで、ふと僕は、あることを思い出す。\nそして、操作盤を用いて、ある指示を、円球に対して出す。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.014.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav",
      "duration" : 7.875646258503401,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 7.275646258503401,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 14",
      "id" : "6A65CB2F-9BB5-4FE4-88F5-76DB047E33AC",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #15",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "「システムのログを検索中です…、検索結果を絞り込んでいます…、アーカイブを解凍しています…、読み込み中です…」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.015.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_ナレーション.wav",
      "duration" : 7.9278231292517,
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "voiceDuration" : 7.3278231292517,
      "audioTrack" : "track_voice__9F71",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 15",
      "id" : "BCC67868-8C17-47C1-9192-8928B8362FFF",
      "voiceCharacter" : "ナレーション"
    },
    {
      "slideTitle" : "スライド #16",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "「読み込みが完了しました。ログを表示します。」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.016.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_ナレーション.wav",
      "duration" : 3.949546485260771,
      "animationName" : "なし",
      "characterName" : "ナレーション",
      "voiceDuration" : 3.349546485260771,
      "audioTrack" : "track_voice__9F71",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 16",
      "id" : "1A2F3CD9-DD27-4F14-980D-CAA9F3F61499",
      "voiceCharacter" : "ナレーション"
    },
    {
      "slideTitle" : "スライド #17",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "僕は、そのログを見て、驚く。図書館で見たときにも、薄々感じていたが、どうやら、ある時点を境に世界が分かれている。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.017.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "duration" : 9.416938775510204,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 8.816938775510204,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 17",
      "id" : "4616E5D8-894E-4CFD-88AB-7A2E1C36F95D",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #18",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "ある時点とは、この施設が機能不全に陥って、発電所が爆発したときだ…、すでにそのときには、幻想郷の住人はいなかった。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.018.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "duration" : 9.536507936507936,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 8.936507936507937,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 18",
      "id" : "B83870A7-1767-4BF6-B715-DDE898785D90",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #19",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "だが、その爆発の後、一度はいなくなったはずの住人が、再び現れている…、今、幻想郷にいる住人は、この爆発を知らない…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.019.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "duration" : 9.964761904761904,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 9.364761904761904,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 19",
      "id" : "8502B55E-221F-4F62-84FF-E97233E76249",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #20",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "telop" : "レミリアたちが言っていたが、ある日突然と、ぷつりと切れた記憶の原因が、この爆発にあるのは、決定的だと考えた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.020.jpeg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav",
      "duration" : 8.690861678004534,
      "animationName" : "なし",
      "characterName" : "操夢",
      "voiceDuration" : 8.090861678004535,
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "title" : "シーン 20",
      "id" : "9FB0F9F5-6CA2-4A0D-8ACF-3D0F86FA60D5",
      "voiceCharacter" : "操夢"
    },
    {
      "telop" : "そうだとしても…、何かがおかしい、この発電所の仕組み上、\n一度爆発してしまえば、生き物は生きられないというのに…",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "id" : "72DE0FDE-86DD-4860-93A5-3FC6D97F6486",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.734331065759637,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.021.jpeg",
      "slideTitle" : "スライド #21",
      "title" : "シーン 21",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.334331065759637,
      "animationName" : "なし"
    },
    {
      "telop" : "「一体、何が起きたというんだ…」僕は、そう呟く。\nすると、その円球が、突如として、喋り始める。",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "id" : "A83B9C31-7F9B-473E-98AE-4D416C3FB40E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.00390022675737,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.022.jpeg",
      "slideTitle" : "スライド #22",
      "title" : "シーン 22",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.60390022675737,
      "animationName" : "なし"
    },
    {
      "telop" : "僕は、その内容に唖然とする。そして、これが事実だという。\nそして、並行世界の片割れがこの世だという。",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "id" : "A913F96B-4180-4E06-82CF-4408403BE4AA",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.8778231292517,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.023.jpeg",
      "slideTitle" : "スライド #23",
      "title" : "シーン 23",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.4778231292517,
      "animationName" : "なし"
    },
    {
      "telop" : "そして、その内容を僕は、他の幻想郷の住人に、知られることはリスキーだと判断し、機密情報として、ロックするのだった。",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "characterName" : "操夢",
      "id" : "1BFEFEE5-8588-42FA-820A-749622CCEF3C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.881065759637188,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.024.jpeg",
      "slideTitle" : "スライド #24",
      "title" : "シーン 24",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.481065759637188,
      "animationName" : "なし"
    },
    {
      "telop" : "それから…",
      "transitionName" : "なし",
      "characterName" : "ナレーション",
      "id" : "1B260C9A-3CF8-481A-A829-CE0BA8B3DAA8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.025.jpeg",
      "animationNote" : "表示時間：3秒",
      "slideTitle" : "スライド #25",
      "title" : "シーン 25",
