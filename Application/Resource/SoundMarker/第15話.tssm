      "duration" : 9.495215419501134,
      "animationName" : "なし"
    },
    {
      "telop" : "「ねぇ、あんた、お賽銭が一向に入らないのだけど…」",
      "transitionName" : "なし",
      "audioTrack" : "track_voice_reimu",
      "characterName" : "博麗霊夢",
