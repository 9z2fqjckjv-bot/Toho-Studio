      "id" : "F0341DAB-90F2-4B67-8C06-7DA38A575B1D",
      "trackId" : "track_voice_reimu",
      "volume" : 1,
      "text" : "「ねぇ、あんた、お賽銭が一向に入らないのだけど…」",
      "speed" : 100,
      "pan" : -0.2,
      "name" : "[博麗霊夢] 「ねぇ、あんた、お賽銭が一向に入らないのだけど…」",
