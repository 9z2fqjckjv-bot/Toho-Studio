      "voiceCharacter" : "博麗霊夢",
      "voiceDuration" : 4.136984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.027.jpeg",
      "slideTitle" : "スライド #27",
