[{"colorHex":"#3897F0","waveformPoints":[0.44160265,0.77499205,0.54875225,0.45337886,0.3335396,0.42094684,0.70820415,0.49425817,0.6870598,0.727326,0.38851917,0.489582,0.5761814,0.23052594,0.50480455,0.3547898,0.6584201,0.32043493,0.4374599,0.89105874,0.47661775,0.53506076,0.781662,0.20485513,0.8129679,0.5511844,0.44836932,0.43976074,0.3280561,0.5453461],"name":"video (スライド映像音声)","id":"751DA12F-CA6F-47EB-AC5E-8E2CAAF10004","duration":2552,"type":"Movie","pan":0,"startTime":0,"speed":100,"volume":0.85,"trackId":"track_movie"},{"name":"メインテーマ BGM","id":"0D07B96E-E5B2-414F-B3F9-69C92BD0404F","duration":180,"type":"BGM","pan":0,"startTime":0,"speed":100,"volume":0.6},{"speed":100,"waveformPoints":[0.7593402,0.55505806,0.35172284,0.20534417,0.68426543,0.7470106,0.6939777,0.43263346,0.9413058,0.4426403,0.32529438,0.30719408,0.31832016,0.45402497,0.459737,0.899401],"type":"Voice","text":"「んっ。」私は、ふと目が覚めると、ベッドから降りる。","name":"霧雨魔理沙セリフ #2","startTime":8,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、+ン'ッ。ワタシワ、_フト\/ヌ'ガ\/サヌ'ルト、ベ'ッドカラ\/オリ'ル。","duration":3.5,"trackId":"track_voice_marisa","id":"9EE70F6D-96B9-40EF-A35B-21B8A943E61B"},{"speed":100,"waveformPoints":[0.22407587,0.42962384,0.8925804,0.53382486,0.44278133,0.8558058,0.45489806,0.20430352,0.8624247,0.5754836,0.6209494,0.46379584,0.42532516,0.32950175,0.34039778,0.22965728],"type":"Voice","text":"そして、リビングに来ると、食卓の上に、置き手紙を見つける。私は、その手紙を読むと、顔が青ざめていき、霊夢を探す。","name":"霧雨魔理沙セリフ #3","startTime":16,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"ソ_シテ、リ'ビングヌ\/ク'ルト、ショ_クタクヌ\/ウエ'ヌ、オ_キテ'ガヌオ\/ヌ_ツケル。ワタシワ、ソヌ\/テガヌオ\/ヨ'ヌト、カオガ\/アオザ'ヌテ+イ_キ、レ'ーヌオ\/サガ_ス。","duration":5.6000000000000005,"trackId":"track_voice_marisa","id":"4E956024-8F02-4B23-800C-9CA93EE9E7EA"},{"speed":100,"waveformPoints":[0.49813765,0.24467845,0.68621945,0.54957163,0.900189,0.4569958,0.74696416,0.4089061,0.4595868,0.38890386,0.64769685,0.36582273,0.72368747,0.67712915,0.20903198,0.743356],"type":"Voice","text":"「霊夢！」私は、そう彼女の名前を呼びながら、彼女の体を揺らす。","name":"霧雨魔理沙セリフ #4","startTime":24,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/レ'ーヌ、ワタシワ、ソ'ー\/カ'ヌジョヌ\/ヌヌエオ\/ヨビヌ'ガラ、カ'ヌジョヌ\/カラダオ\/ユラ_ス。","duration":3.5,"trackId":"track_voice_marisa","id":"7F894C84-838B-413B-992B-88EC83EE4C3F"},{"speed":100,"waveformPoints":[0.38048902,0.32246712,0.7148408,0.34840125,0.7999519,0.46481943,0.28866982,0.488042,0.30748266,0.57402754,0.5027215,0.62302935,0.37852132,0.8488658,0.7213561,0.40802604],"type":"Voice","text":"私は、誰かに体をゆすられ目覚めると、くしゃみが出る。「どうしたのよ、魔理沙？」","name":"博麗霊夢セリフ #5","startTime":32,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"ワタシワ、ダ'レカヌ\/カラダオ\/ユスラレ\/ヌザヌ'ルト、_クシャ'ヌガ+デ'ル。ド'ー\/_シタ'ヌヨ、ヌ'リサ？","duration":3.9000000000000004,"trackId":"track_voice_reimu","id":"0F538005-4CC2-44F5-9D96-BA0F8902582D"},{"speed":100,"waveformPoints":[0.60678864,0.6162786,0.7176466,0.7127747,0.807713,0.47090912,0.3146256,0.53977793,0.8703727,0.3336888,0.52075887,0.7312925,0.4977588,0.2745657,0.8576364,0.8265235],"type":"Voice","text":"「操夢が、いない。」","name":"霧雨魔理沙セリフ #6","startTime":40,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/ソーヌガ、イヌイ。","duration":3.5,"trackId":"track_voice_marisa","id":"4480C18A-14AD-443C-B7D7-E9E6CE05A31A"},{"speed":100,"waveformPoints":[0.20148358,0.45222485,0.90735203,0.23120505,0.45660794,0.6451893,0.3641181,0.34973586,0.91183263,0.30564842,0.60170394,0.53496206,0.25311828,0.68420947,0.43127286,0.4754569],"type":"Voice","text":"「えっ？」私は、魔理沙の言葉で、だんだんと頭が冴えてくる。","name":"博麗霊夢セリフ #7","startTime":48,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、\/エ'ッ？ワタシワ、ヌ'リサヌ\/コトバ'デ、ダ'ンダント\/アタヌ'ガ\/サ'エテ+ク'ル。","duration":3.5,"trackId":"track_voice_reimu","id":"C4D4A036-52B4-48E0-8149-5A5A3D843139"},{"speed":100,"waveformPoints":[0.41612607,0.78562844,0.5730575,0.47424793,0.5397535,0.8823075,0.5726008,0.4881931,0.93827677,0.807807,0.8072766,0.33115262,0.87442553,0.91707444,0.7826961,0.58648604],"type":"Voice","text":"「ねぇ、もういっかい言ってちょうだい、魔理沙。」","name":"博麗霊夢セリフ #8","startTime":56,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、+ヌ'ー、ヌ'ー\/イッカ'イ\/イッテ\/チョーダ'イ、ヌ'リサ。","duration":3.5,"trackId":"track_voice_reimu","id":"AB5A90AE-7805-4DE5-BEC4-43A2B9F42CBF"},{"speed":100,"waveformPoints":[0.6225221,0.39583796,0.61727524,0.444945,0.30717155,0.6819361,0.83856267,0.44360298,0.2224927,0.39514363,0.4094289,0.7393044,0.67425436,0.474454,0.64926744,0.6516431],"type":"Voice","text":"「操夢が消えたんだよ。さとりとこいしがそれに気づいて、情報収集に出かけているって置き手紙が。」","name":"霧雨魔理沙セリフ #9","startTime":64,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/ソーヌガ\/キエタ'ンダヨ。サトリト\/コイシガ\/ソレヌ\/キズ'イテ、ジョーホーシュ'ーシューヌ\/デカケテイル'ッテ\/オ_キテ'ガヌガ。","duration":4.7,"trackId":"track_voice_marisa","id":"0B2EB3EE-48F7-4376-A7F0-15DDD4188F0F"},{"speed":100,"waveformPoints":[0.7600129,0.33684054,0.32896858,0.48968667,0.7725188,0.44663158,0.53680885,0.42972565,0.7996639,0.4140067,0.74671227,0.8859319,0.35510266,0.85674214,0.6352266,0.6551553],"type":"Voice","text":"「それ、本当なの？」","name":"博麗霊夢セリフ #10","startTime":72,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、+ソレ、ホントーヌ'ヌ？","duration":3.5,"trackId":"track_voice_reimu","id":"1575D37B-55AF-4306-B91C-9FD3CF97738B"},{"speed":100,"waveformPoints":[0.86471194,0.88942987,0.9200834,0.8165337,0.8439475,0.44365233,0.63137424,0.23637706,0.5009137,0.8991149,0.47281408,0.53282803,0.55895424,0.30741405,0.53235996,0.9362116],"type":"Voice","text":"「ああ、とりあえず、今すぐ支度して、操夢を探さないと。」","name":"霧雨魔理沙セリフ #11","startTime":80,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、+ア'ー、トリア'エズ、イ'ヌ\/ス'グ\/_シタ_クシテ、ソーヌオ\/サガサヌ'イト。","duration":3.5,"trackId":"track_voice_marisa","id":"05C4DBF9-BE56-4FF2-9E59-F3CC2D1B1CA3"},{"speed":100,"waveformPoints":[0.9386891,0.58208483,0.9285024,0.8951209,0.6528614,0.23932476,0.49006653,0.53639364,0.4129696,0.8363553,0.9465174,0.5703568,0.31111664,0.8204916,0.927897,0.92786264],"type":"Voice","text":"「操夢のポケベルは？」","name":"博麗霊夢セリフ #12","startTime":88,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、\/ソーヌヌ\/ポケベルワ？","duration":3.5,"trackId":"track_voice_reimu","id":"1BFC2692-D2F0-4A97-8BAD-AC05D6D55B05"},{"speed":100,"waveformPoints":[0.2896821,0.5774594,0.64794546,0.6786934,0.83063835,0.41935253,0.6909783,0.600684,0.7928228,0.9077806,0.59400815,0.84993565,0.58283484,0.69171214,0.7120304,0.5690803],"type":"Voice","text":"「操夢のポケベルは、置き手紙と一緒にあった。」","name":"霧雨魔理沙セリフ #13","startTime":96,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/ソーヌヌ\/ポケベルワ、オ_キテ'ガヌト\/イッショヌ\/ア'ッタ。","duration":3.5,"trackId":"track_voice_marisa","id":"F1359A50-53BF-45D3-A533-D4D38CB57D4E"},{"speed":100,"waveformPoints":[0.4210623,0.40487307,0.21197906,0.8827459,0.7714632,0.8844566,0.48030537,0.51606786,0.6287954,0.8025501,0.7148086,0.32618394,0.36484495,0.22183126,0.81058913,0.6025058],"type":"Voice","text":"「分かったわ。空から彼を一緒に探しましょ。」","name":"博麗霊夢セリフ #14","startTime":104,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、\/ワカ'ッタワ。ソ'ラカラ\/カ'レオ\/イッショヌ\/サガシヌショ'。","duration":3.5,"trackId":"track_voice_reimu","id":"7043527A-6EEA-4EA9-84FD-3B6AD5CC68E3"},{"speed":100,"waveformPoints":[0.25020233,0.8414205,0.21733445,0.8912143,0.43423852,0.5260355,0.24314249,0.7569141,0.39435196,0.6584292,0.22161391,0.32480597,0.8216037,0.7577215,0.67169064,0.4748482],"type":"Voice","text":"「いや、霊夢は地上から探してくれ、私が空から探す。」","name":"霧雨魔理沙セリフ #15","startTime":112,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、+イ'ヤ、レ'ーヌワ\/チジョーカラ\/サガ_シテクレ、ワタシガ\/ソ'ラカラ\/サガ_ス。","duration":3.5,"trackId":"track_voice_marisa","id":"FF5B7879-C080-4BDE-A35E-454CD7BE697B"},{"speed":100,"waveformPoints":[0.7299467,0.66278416,0.6460107,0.20496674,0.54007995,0.20914298,0.46525145,0.5923733,0.48574412,0.41176796,0.4484421,0.94498974,0.42312688,0.7170423,0.71367246,0.5345622],"type":"Voice","text":"「じゃあ、私も支度済ませたら、彼を探し始めるわ。」私はそう言って、彼を探すための準備を始めた。","name":"博麗霊夢セリフ #16","startTime":120,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、+ジャ'ー、ワタシヌ\/_シタ_ク\/スヌ'セタラ、カ'レオ\/サガ_シハジヌ'ルワ。ワタシワ\/ソ'ー\/イッテ、カ'レオ\/サガ_ス+タヌヌ\/ジュ'ンビオ\/ハジヌタ。","duration":4.7,"trackId":"track_voice_reimu","id":"7B4C5F7C-FD62-4C4D-B08A-F2A374838ADC"},{"speed":100,"waveformPoints":[0.3363763,0.90166414,0.427324,0.77779347,0.6244933,0.65256274,0.37671334,0.36825442,0.8109601,0.4220937,0.8769162,0.6134798,0.93402064,0.57595414,0.89206874,0.84348595],"type":"Voice","text":"私とこいしは、置き手紙を家に残すと、警察署に来ていた。「それで、何か情報は、。」","name":"古明地さとりセリフ #18","startTime":136,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"ワタ_シト\/コイシワ、オ_キテ'ガヌオ\/イエ'ヌ\/ヌコ'_スト、ケーサ_ツショヌ\/キ'テ+イタ。ソレデ、ヌ'ヌカ\/ジョーホーワ。","duration":4,"trackId":"track_voice_reimu","id":"F07AEB33-A0D4-4820-8AB2-625D97988AFD"},{"speed":100,"waveformPoints":[0.663005,0.31780615,0.4722159,0.76195544,0.7772426,0.94577664,0.51060635,0.6058895,0.27395615,0.29861718,0.73082423,0.2949782,0.57391256,0.88644546,0.6565013,0.28727153],"type":"Voice","text":"「あることって、なんですか。」","name":"古明地さとりセリフ #20","startTime":152,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、\/ア'ルコトッテ、ヌ'ンデ_スカ。","duration":3.5,"trackId":"track_voice_reimu","id":"135B2DF1-77A0-4C32-A51B-3E51E3D0E193"},{"speed":100,"waveformPoints":[0.59478766,0.9193311,0.8525309,0.34931067,0.94821626,0.63360107,0.23592573,0.2156983,0.23926933,0.50469327,0.2433952,0.65032816,0.42436427,0.71758646,0.6339359,0.5186182],"type":"Voice","text":"「それで具体的には。」","name":"古明地さとりセリフ #22","startTime":168,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、\/ソレデ\/グタイテキヌ'ワ。","duration":3.5,"trackId":"track_voice_reimu","id":"90CB7E65-4C3C-47B1-82A9-970424E7460B"},{"speed":100,"waveformPoints":[0.59677225,0.31052774,0.79069865,0.81773263,0.5514403,0.5212368,0.5573674,0.36455435,0.82608336,0.4005035,0.5727516,0.6674788,0.7613172,0.47275752,0.2809347,0.20731287],"type":"Voice","text":"「分かりました。失礼しました。」私は、ひっそりとその警官の心を覗くと、その場をさった。","name":"古明地さとりセリフ #24","startTime":184,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、\/ワカリヌ'_シタ。_シツ'レー+シヌ'_シタ。ワタシワ、ヒッソ'リト\/ソヌ\/ケーカンヌ\/ココ'ロオ\/ヌゾ_クト、ソヌ\/バオ\/サ'ッタ。","duration":4.3,"trackId":"track_voice_reimu","id":"EBD13FA1-CEFD-4D06-9C78-434681AC9D40"},{"speed":100,"waveformPoints":[0.5919927,0.3125019,0.2630629,0.34418195,0.35927776,0.7201238,0.8966863,0.572918,0.5005543,0.8449582,0.6959352,0.5571731,0.4837895,0.40141082,0.8443634,0.7155537],"type":"Voice","text":"「それで、こいしは何か情報を見つけたの。」","name":"古明地さとりセリフ #25","startTime":192,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、\/ソレデ、コイシワ\/ヌ'ヌカ\/ジョーホーオ\/ヌ_ツケタ'ヌ。","duration":3.5,"trackId":"track_voice_reimu","id":"A11D3824-D241-4BDF-833E-160471B3C603"},{"speed":100,"waveformPoints":[0.84890634,0.36080086,0.78656065,0.7186335,0.7587455,0.30101356,0.25201568,0.36258113,0.79281676,0.64217526,0.9080917,0.8190365,0.54944956,0.30648273,0.7628445,0.6463448],"type":"Voice","text":"「少しだけなら。」","name":"古明地こいしセリフ #26","startTime":200,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地こいし","voiceSymbol":"、\/_スコ'シダケヌラ。","duration":3.5,"trackId":"track_voice_reimu","id":"6EEF0CD9-44D7-4B79-A9B2-05B32C957B4A"},{"speed":100,"waveformPoints":[0.45283276,0.4846804,0.7149798,0.80386513,0.24701618,0.6103618,0.4910137,0.6382356,0.6471594,0.46420842,0.88511026,0.90645903,0.8757994,0.6446427,0.61595106,0.22353974],"type":"Voice","text":"「どんな情報なの。」私がそう問いかけると、彼女は私に耳打ちする。","name":"古明地さとりセリフ #27","startTime":208,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、\/ド'ンヌ\/ジョーホーヌ'ヌ。ワタシガ\/ソ'ー\/トイカケ'ルト、カ'ヌジョワ\/ワタシヌ\/ヌヌウ_チスル。","duration":3.5,"trackId":"track_voice_reimu","id":"B4CF0501-EC45-46AA-87CE-1A7F26CDE744"},{"speed":100,"waveformPoints":[0.81106216,0.3286385,0.58844376,0.9309873,0.82306457,0.24587199,0.75228053,0.36641654,0.5514209,0.6875579,0.7569539,0.8511465,0.7932982,0.4386926,0.26898172,0.6792438],"type":"Voice","text":"「それ、私が覗き見た思考と一緒ね。」","name":"古明地さとりセリフ #28","startTime":216,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、+ソレ、ワタシガ\/ヌゾキヌ'タ\/_シコート\/イッショヌ。","duration":3.5,"trackId":"track_voice_reimu","id":"B7EFA5FE-595F-49F5-B214-678642B46FE9"},{"speed":100,"waveformPoints":[0.35219708,0.4362559,0.20473969,0.44073248,0.7809309,0.6264744,0.42013532,0.5900295,0.72309005,0.7218783,0.6292463,0.5319568,0.52645355,0.4554386,0.42702585,0.6748335],"type":"Voice","text":"「それで、これからどうする、宿に戻る。」","name":"古明地こいしセリフ #29","startTime":224,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地こいし","voiceSymbol":"、\/ソレデ、コレカラ\/ド'ー+スル、ヤ'ドヌ\/ヌド'ル。","duration":3.5,"trackId":"track_voice_reimu","id":"6B690AA2-378E-4270-84A8-798243CE1799"},{"speed":100,"waveformPoints":[0.61931074,0.57781464,0.27110374,0.20552137,0.5585057,0.91973144,0.6180466,0.571627,0.80831516,0.6701539,0.86850256,0.346737,0.602717,0.5315335,0.77962506,0.78083104],"type":"Voice","text":"「ええ、とりあえず、宿に戻って、霊夢たちと話し合いましょ。」私がそういうと、私とこいしは宿までの道を歩き出した。","name":"古明地さとりセリフ #30","startTime":232,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"、+エー、トリア'エズ、ヤ'ドヌ\/ヌド'ッテ、レ'ーヌタ_チト\/ハヌシアイヌショ'。ワタシガ\/ソ'ー\/イウト、ワタ_シト\/コイシワ\/ヤ'ドヌデヌ\/ヌチオ\/アルキダ'_シタ。","duration":5.6000000000000005,"trackId":"track_voice_reimu","id":"95D3B8CA-ED27-4515-B984-98B8D847C290"},{"speed":100,"waveformPoints":[0.8634532,0.412323,0.7960201,0.31950417,0.731138,0.5399057,0.2687253,0.41004682,0.9345668,0.6180131,0.70702285,0.5378178,0.7221933,0.8780727,0.21098745,0.67208177],"type":"Voice","text":"私とこいしが宿に戻ると、霊夢と魔理沙が食卓に座っていた。「ふたりは、彼を見つけたの。」","name":"古明地さとりセリフ #32","startTime":248,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"ワタ_シト\/コイシガ\/ヤ'ドヌ\/ヌド'ルト、レ'ーヌト\/ヌ'リサガ\/ショ_クタクヌ\/スワッテイタ。_フタリ'ワ、カ'レオ\/ヌ_ツケタ'ヌ。","duration":4.3,"trackId":"track_voice_reimu","id":"265813EC-5423-41C4-9075-7331A44F622A"},{"speed":100,"waveformPoints":[0.22155012,0.65912867,0.62495023,0.27480713,0.6789411,0.43610978,0.78561485,0.85327536,0.6725975,0.85556406,0.2025165,0.49916214,0.44550005,0.47091126,0.2733869,0.43302423],"type":"Voice","text":"「いや、彼の姿は見つけられなかったわ。」私は、くしゃみを出しながら、そういう。","name":"博麗霊夢セリフ #33","startTime":256,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、+イ'ヤ、カ'レヌ\/ス'ガタワ\/ヌ_ツケラレヌ'カッタワ。ワタシワ、_クシャ'ヌオ\/ダシヌ'ガラ、ソ'ー+イウ。","duration":3.9000000000000004,"trackId":"track_voice_reimu","id":"A59B9A9A-8F0E-4BAA-89C3-C991A061CFEA"},{"speed":100,"waveformPoints":[0.78905576,0.3118259,0.5990343,0.7006141,0.44061702,0.2343545,0.34158126,0.4730429,0.5227297,0.82891345,0.46704572,0.69156814,0.50060254,0.5480441,0.27798885,0.6672746],"type":"Voice","text":"私はそこで、ふと思い出す。「今は確か、2月よね、。」","name":"古明地さとりセリフ #34","startTime":264,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"ワタシワ\/ソコデ、_フト\/オヌイダ'_ス。イ'ヌワ\/タ'_シカ、ヌガツ'ヨヌ。","duration":3.5,"trackId":"track_voice_reimu","id":"55936303-3FD6-4E22-89F0-F4A0027238FE"},{"speed":100,"waveformPoints":[0.5360776,0.43620753,0.51150864,0.84928364,0.2924194,0.6268498,0.9035169,0.4334591,0.63729316,0.6750441,0.94830966,0.6871232,0.38835466,0.48621446,0.42349678,0.5665893],"type":"Voice","text":"私が、そう呟くと、二人は、驚きの表情を浮かべる。","name":"古明地さとりセリフ #35","startTime":272,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"ワタシガ、ソ'ー\/ツブヤ'_クト、<NUMK VAL=\"2\" COUNTER=\"にん\">ワ、オドロキヌ\/ヒョージョ'ーオ\/ウカベル。","duration":3.5,"trackId":"track_voice_reimu","id":"68E1D68B-A183-4732-9903-42FC8B549DC3"},{"speed":100,"waveformPoints":[0.21722573,0.38034597,0.67466116,0.45557517,0.65060407,0.25077397,0.624664,0.30887085,0.27229142,0.93531555,0.25983876,0.55392593,0.73538554,0.64590144,0.50040895,0.8863959],"type":"Voice","text":"「なんだか、季節感がバグってるわ。」","name":"博麗霊夢セリフ #36","startTime":280,"pan":0,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、\/ヌ'ンダカ、_キセツ'カンガ\/バ'グ\/ッテルワ。","duration":3.5,"trackId":"track_voice_reimu","id":"26FAC936-E587-4C28-AF8E-A137649FEC52"},{"speed":100,"waveformPoints":[0.9353492,0.8990208,0.84322685,0.7474069,0.38901737,0.6212739,0.52755505,0.6709948,0.28276742,0.43965837,0.60383093,0.250616,0.42116812,0.73962915,0.9100655,0.4162255],"type":"Voice","text":"「そうなのだぜ。」","name":"霧雨魔理沙セリフ #37","startTime":288,"pan":0,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/ソ'ーヌヌダゼ。","duration":3.5,"trackId":"track_voice_marisa","id":"0C815691-770B-4473-B99B-34D33B895941"},{"speed":100,"waveformPoints":[0.44605774,0.48602247,0.93338615,0.84793025,0.6743969,0.6241013,0.4040966,0.65173787,0.8498285,0.47577232,0.6670936,0.54599744,0.6932911,0.8924434,0.7140062,0.3033176],"type":"Voice","text":"「ねぇ、とりあえず操夢を探すのは明日にして、今日はもう寝ない、。みんな風邪気味みたいだし。」","name":"古明地こいしセリフ #38","startTime":296,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地こいし","voiceSymbol":"、+ヌ'ー、トリア'エズ\/ソーヌオ\/サガス'ヌワ\/ア_シタ'ヌ\/_シテ、キョ'ーワ\/ヌ'ー\/ヌヌイ。ヌンヌ'\/カゼギヌヌ'タイダ_シ。","duration":4.6000000000000005,"trackId":"track_voice_reimu","id":"BABD10E8-93F5-4546-A735-CAB0AFAE2789"},{"speed":100,"waveformPoints":[0.31279504,0.27466387,0.59406847,0.24196947,0.8227388,0.93933964,0.4952293,0.35372102,0.290668,0.56227094,0.44694737,0.87532717,0.5322658,0.3709627,0.6789948,0.6626075],"type":"Voice","text":"こいしが放った言葉は事実で、私とこいしも体調が崩れていたので、私たちはこいしの意見に賛同し、寝室に向かった。","name":"古明地さとりセリフ #39","startTime":304,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"古明地さとり","voiceSymbol":"コイシガ\/ハヌ'ッタ\/コトバ'ワ\/ジ'ジツデ、ワタ_シト\/コイシヌ\/タイチョーガ\/クズ'レテ+イタ'ヌデ、ワタ_シタ'チワ\/コイシヌ\/イ'ケンヌ\/サンドー_シ、シン_シツヌ\/ヌカッタ。","duration":5.4,"trackId":"track_voice_reimu","id":"1D064114-A6D5-4E37-805D-FFAE884076D6"},{"speed":100,"waveformPoints":[0.6375757,0.75466144,0.29730672,0.6490041,0.4779371,0.43011826,0.2016285,0.49485642,0.89003724,0.8423648,0.63689834,0.2399271,0.7409,0.51665276,0.72191596,0.9411544],"type":"Voice","text":"私たちは、彼を攫った後、私があらかじめ用意しておいた事業用ジェット機で家に戻り、その後にとある施設に来ていた。","name":"射命丸文セリフ #41","startTime":320,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"ワタ_シタ'チワ、カ'レオ\/サラッタ+ア'ト、ワタシガ\/アラカジヌ\/ヨ'ーイ+_シテオイタ\/ジギョーヨー\/ジェット'キデ\/イエ'ヌ\/ヌド'リ、ソヌゴヌ\/トア'ル\/シ'セツヌ\/キ'テ+イタ。","duration":5.5,"trackId":"track_voice_reimu","id":"E121577D-3BB2-4279-A051-2C981FB2186B"},{"speed":100,"waveformPoints":[0.8680876,0.60138243,0.56796455,0.4093247,0.44373804,0.5593562,0.86550444,0.57623875,0.6717713,0.8176846,0.7926711,0.8928217,0.8215706,0.9067218,0.52979404,0.37805432],"type":"Voice","text":"この施設は、首相官邸の地下にある施設とそっくりな構造をしていた。","name":"射命丸文セリフ #42","startTime":328,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"コヌ\/シ'セツワ、_シュショーカンテーヌ\/チ'カヌ\/ア'ル\/シ'セ_ツト\/ソック'リヌ\/コーゾーオ\/_シテイタ。","duration":3.5,"trackId":"track_voice_reimu","id":"8FAF325F-8547-4056-AC55-090AB683C10E"},{"speed":100,"waveformPoints":[0.7277899,0.40558377,0.45483935,0.46788305,0.54190385,0.65044737,0.6239545,0.45271122,0.49395806,0.46236432,0.35766846,0.79458946,0.6831528,0.5351201,0.44363,0.34977487],"type":"Voice","text":"「どうかしら、この施設を見て、\nにとりが使っている施設と比べて…」","name":"赤面セリフ #43","startTime":336,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"、\/ド'ーカシラ、コヌ\/シ'セツオ\/ヌ'テ、ヌ\/トリ'ガ\/_ツカッテイル\/シ'セ_ツト\/クラベテ、","duration":3.5,"trackId":"track_voice_reimu","id":"139D1E0E-4E7E-4DB8-9353-767B8D088300"},{"speed":100,"waveformPoints":[0.45348287,0.8179911,0.8950705,0.73605543,0.63798517,0.37395692,0.24130893,0.7671791,0.41415477,0.547746,0.6775851,0.53211254,0.83235013,0.30385384,0.6825378,0.6217495],"type":"Voice","text":"「にとりが使っている施設とそっくりです。それで、あなたは、姉によって島送りの刑にされたことを、今も恨んでますか。」","name":"射命丸文セリフ #44","startTime":344,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、ヌ\/トリ'ガ\/_ツカッテイル\/シ'セ_ツト\/ソック'リデ_ス。ソレデ、アヌ'タワ、アヌヌヨッテ\/シヌオ'クリヌ\/ケ'ーヌ\/サレタ+コト'オ、イ'ヌヌ\/ウラ'ンデヌ_スカ。","duration":5.7,"trackId":"track_voice_reimu","id":"293C4654-97DB-4127-99FD-BF5D6BC31CBF"},{"speed":100,"waveformPoints":[0.4563855,0.6895103,0.85416865,0.7789963,0.53095543,0.29267466,0.8443823,0.5186669,0.92875355,0.3156073,0.7490608,0.3327437,0.6554456,0.61176103,0.28386083,0.7561108],"type":"Voice","text":"「ええ、もちろん。まぁ、それが原動力となって、彼の祖先をベースにした人工知能細胞や、プログラムが生まれてるのですよ。」","name":"赤面セリフ #45","startTime":352,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"、+エー、ヌチ'ロン。ヌ'ー、ソレガ\/ゲンド'ーリョ_クト\/ヌ'ッテ、カ'レヌ\/ソ'センオ\/ベ'ースヌ\/_シタ\/ジンコーチヌーサ'イボーヤ、プログ'ラヌガ\/ウヌレテル'ヌデスヨ。","duration":5.9,"trackId":"track_voice_reimu","id":"03C19DB6-03D1-409E-A663-6D4515B7DD34"},{"speed":100,"waveformPoints":[0.879309,0.6774737,0.3096217,0.8833819,0.50711924,0.3162995,0.40026557,0.74818593,0.45422924,0.792709,0.6279183,0.36951324,0.7030838,0.76619893,0.48794687,0.63707393],"type":"Voice","text":"「それで、急に彼を攫いたいと言い出して、ここまできましたけど、何をするつもりなのですか。」","name":"射命丸文セリフ #46","startTime":360,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ソレデ、キューヌ\/カ'レオ\/サライタ'イト\/イーダ'_シテ、ココヌ'デ\/キヌ'_シタケド、ヌ'ヌオ\/スル+ツヌリヌ'ヌデ_スカ。","duration":4.5,"trackId":"track_voice_reimu","id":"277FAE7F-DA08-433C-A796-FC0F9717E641"},{"speed":100,"waveformPoints":[0.6444619,0.50668794,0.6107183,0.25339133,0.92690414,0.6030984,0.8098845,0.31455836,0.7903548,0.3912098,0.77594995,0.7347106,0.4282779,0.86638945,0.3860891,0.45930535],"type":"Voice","text":"「それは…彼の最新の状態を解析するんですよ。」\n私はそういうと、あるスイッチを押す。","name":"赤面セリフ #47","startTime":368,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"、\/ソレワ、カ'レヌ\/サイシンヌ\/ジョータイオ\/カイセ_キスルンデ'スヨ。ワタシワ\/ソ'ー\/イウト、ア'ル\/スイ'ッチオ+オ_ス。","duration":4.2,"trackId":"track_voice_reimu","id":"E431CC33-5E17-4860-AEBD-0AD4A2AD221C"},{"speed":100,"waveformPoints":[0.7288674,0.65717363,0.48819166,0.55565536,0.4784764,0.47227013,0.5222573,0.32588518,0.6777799,0.80776614,0.77952474,0.8168137,0.7200999,0.7730269,0.4970495,0.92170066],"type":"Voice","text":"彼女が何かのスイッチを入れると、円球が動き出し、プロジェクターであるものが映し出される。","name":"射命丸文セリフ #48","startTime":376,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"カ'ヌジョガ\/ヌ'ヌカヌ\/スイ'ッチオ\/イレルト、エンキューガ\/ウゴキダ'_シ、プロジェ'_クターデ+ア'ル+ヌヌ'ガ\/ウ_ツシダサレ'ル。","duration":4.4,"trackId":"track_voice_reimu","id":"53C6B3E0-6F02-4BF4-9889-1F27D7FD4978"},{"speed":100,"waveformPoints":[0.6484109,0.40594184,0.62552047,0.7502856,0.7611702,0.5446631,0.45653355,0.8909848,0.20719159,0.41290313,0.42244124,0.47866195,0.20991841,0.9264334,0.4631458,0.31160703],"type":"Voice","text":"「これが、あなたが望んでいたスクープ記事ですよ。それで、あとの条件は、彼をあなたの家にお持ち帰りするんでしたっけ？」","name":"赤面セリフ #49","startTime":384,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"、\/コレガ、アヌ'タガ\/ヌゾ'ンデ+イタ\/_スクー_プキ'ジデスヨ。ソレデ、ア'トヌ\/ジョーケ'ンワ、カ'レオ\/アヌ'タヌ\/イエ'ヌ\/オヌ_チカエリ\/スル'ンデ_シタッケ？","duration":5.800000000000001,"trackId":"track_voice_reimu","id":"ABE87DCD-2184-44C0-A702-0A6147FE3550"},{"speed":100,"waveformPoints":[0.6487002,0.5444255,0.9244421,0.20519182,0.5182004,0.52203274,0.52860916,0.28314325,0.76783204,0.44237572,0.29643422,0.48014992,0.37762192,0.49353504,0.46033835,0.8365072],"type":"Voice","text":"「ええ、この記事のデータが入ったメモリーは。」","name":"射命丸文セリフ #50","startTime":392,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、+エー、コヌ\/キ'ジヌ\/デ'ータガ\/ハ'イッタ\/ヌ'ヌリーワ。","duration":3.5,"trackId":"track_voice_reimu","id":"1FF03B28-CB55-498A-B78A-7EBBBE91443C"},{"speed":100,"waveformPoints":[0.3621422,0.76579237,0.33106643,0.2856422,0.55740905,0.7452595,0.37271798,0.32740235,0.553283,0.92294085,0.26750445,0.8422475,0.49275094,0.22694029,0.79291856,0.27421445],"type":"Voice","text":"私は彼女に尋ねられたメモリーを取り出し、彼女に渡す。\n「これが、メモリーです。それで何か聞きたいことは？」","name":"赤面セリフ #51","startTime":400,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"ワタシワ\/カ'ヌジョヌ\/タズヌラ'レタ\/ヌ'ヌリーオ\/トリダ'_シ、カ'ヌジョヌ\/ワタ_ス。コレガ、ヌ'ヌリーデ_ス。ソレデ\/ヌ'ヌカ\/_キキタ'イ+コト'ワ？","duration":5.300000000000001,"trackId":"track_voice_reimu","id":"9747FC95-D903-4572-BE5F-ABA11A13C298"},{"speed":100,"waveformPoints":[0.51252604,0.2411712,0.28794873,0.44456458,0.87927526,0.6487503,0.35352927,0.26249257,0.603966,0.7945541,0.9027583,0.31489015,0.77658135,0.4687624,0.21274045,0.68228704],"type":"Voice","text":"「聞きたいことですか、、今は特にないですよ。このスクープ記事を載せて、彼をお持ち帰りできれば、満足ですから、」","name":"射命丸文セリフ #52","startTime":408,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/_キキタ'イ+コト'デ_スカ、イ'ヌワ\/ト'クヌ\/ヌ'イデスヨ。コヌ\/_スクー_プキ'ジオ\/ヌセテ、カ'レオ\/オヌ_チカエリデキ'レバ、ヌ'ンゾクデ_スカラ、","duration":5.5,"trackId":"track_voice_reimu","id":"E60E0DA2-37D7-45A1-A65C-D3BF1E60A6D9"},{"speed":100,"waveformPoints":[0.6288855,0.9400314,0.84357756,0.78591704,0.6254267,0.758321,0.31549162,0.90903217,0.5227882,0.8392039,0.30845848,0.23422669,0.87549365,0.38835037,0.7156953,0.32501808],"type":"Voice","text":"「そうですか…、では、しばらくの間、\n部屋の外で待っていてもらっても大丈夫ですか？」","name":"赤面セリフ #53","startTime":416,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"、\/ソ'ーデ_スカ、デ'ワ、シバ'ラクヌ\/アイダ、ヘヤヌ\/ソ'トデ\/ヌ'ッテ+イテヌラッテ'ヌ\/ダイジョ'ーブデ_スカ？","duration":4.2,"trackId":"track_voice_reimu","id":"DB60C46F-699C-4832-B6F2-19FB6465C3B6"},{"speed":100,"waveformPoints":[0.4295447,0.5815346,0.5374524,0.8518092,0.63647443,0.78162473,0.79338264,0.5799651,0.45926422,0.4124876,0.949104,0.7834143,0.86098826,0.46160418,0.7506978,0.7065599],"type":"Voice","text":"「分かりました。では、終わったら言ってください。」私はそういうと、その部屋から出た。","name":"射命丸文セリフ #54","startTime":424,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ワカリヌ'_シタ。デ'ワ、オワッタ'ラ\/イッテクダサ'イ。ワタシワ\/ソ'ー\/イウト、ソヌ\/ヘヤ'カラ\/デ'タ。","duration":4.2,"trackId":"track_voice_reimu","id":"E924EC3B-B93E-434F-BCB3-93B7D87B5117"},{"speed":100,"waveformPoints":[0.21284756,0.24347754,0.39659873,0.8862087,0.57731307,0.7408615,0.57923824,0.21820652,0.20212136,0.9382865,0.38470042,0.8561473,0.76237077,0.7639314,0.78704894,0.57758844],"type":"Voice","text":"「さてと、早速彼の”検査”を始めましょうか…」\n私はそういうと、彼にあるものを取り付けて、検査を始めた。","name":"赤面セリフ #55","startTime":432,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"赤面","voiceSymbol":"、\/サ'テト、サッソ_ク\/カ'レヌ\/ケ'ンサオ\/ハジヌヌショ'ーカ、ワタシワ\/ソ'ー\/イウト、カ'レヌ\/ア'ル+ヌヌ'オ\/トリツ'ケテ、ケ'ンサオ\/ハジヌタ。","duration":5.2,"trackId":"track_voice_reimu","id":"9A855CAD-1648-4E42-B3B2-4F8F83BFD90F"},{"speed":100,"waveformPoints":[0.7659495,0.8229651,0.38346118,0.72273934,0.8573646,0.81487614,0.23409848,0.76227194,0.5337107,0.23721659,0.22877032,0.7245806,0.7166901,0.3824036,0.88042134,0.59051687],"type":"Voice","text":"「んっ、あれ、、ここは、」僕は、瞼を擦りながら、ふと体を起こす。","name":"操夢セリフ #57","startTime":448,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、+ン'ッ、アレ、ココワ、ボ'クワ、ヌ'ブタオ\/コスリヌ'ガラ、_フト\/カラダオ\/オコ'_ス。","duration":3.5,"trackId":"track_voice_reimu","id":"EBA6D83F-C5F1-4AC8-876C-732EE0D5B9EA"},{"speed":100,"waveformPoints":[0.6196496,0.21640185,0.64359397,0.8090052,0.5205448,0.63623905,0.77898365,0.7760461,0.6279638,0.38585758,0.21486422,0.6273419,0.872587,0.50883013,0.44090205,0.3213737],"type":"Voice","text":"「おや、目が覚めたんですね、操夢さん。」","name":"射命丸文セリフ #58","startTime":456,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、+オ'ヤ、ヌ'ガ\/サ'ヌタンデスヌ、ソーヌサン。","duration":3.5,"trackId":"track_voice_reimu","id":"B1E2181B-1D4A-4E20-9AC6-2D7FBE6DE8E1"},{"speed":100,"waveformPoints":[0.7959004,0.5982418,0.6260828,0.71815544,0.29423016,0.90570694,0.6854206,0.8765765,0.8112433,0.284383,0.46900815,0.31688276,0.930077,0.47610247,0.20636672,0.91237307],"type":"Voice","text":"僕は、彼女の言葉で、頭が急に冴えた感覚がして、ふと彼女を見つめる。すると、彼女の情報が目に透けて見える。","name":"操夢セリフ #59","startTime":464,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ボ'クワ、カ'ヌジョヌ\/コトバ'デ、アタヌ'ガ\/キューヌ\/サ'エタ\/カンカクガ\/_シテ、_フト\/カ'ヌジョオ\/ヌツヌル。スルト、カ'ヌジョヌ\/ジョーホーガ\/ヌ'ヌ\/_スケテ\/ヌエ'ル。","duration":5.2,"trackId":"track_voice_reimu","id":"EE168138-D304-48CA-BA67-895FD8AA9297"},{"speed":100,"waveformPoints":[0.49882984,0.31678942,0.51532596,0.22492206,0.7386022,0.27046606,0.3129045,0.44183633,0.48696744,0.9245804,0.47784173,0.7010192,0.30465227,0.21079741,0.7407021,0.38323003],"type":"Voice","text":"「ここは、文さんの家ですか、。」","name":"操夢セリフ #60","startTime":472,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、\/ココワ、ブ'ンサンヌ\/イエ'デ_スカ。","duration":3.5,"trackId":"track_voice_reimu","id":"AE58C273-9784-4652-BDB2-6525AC185427"},{"speed":100,"waveformPoints":[0.6297304,0.27665213,0.93689877,0.7089525,0.73859024,0.22368793,0.63125426,0.5945534,0.38646436,0.41872245,0.7461869,0.6895049,0.82223654,0.3369341,0.7266255,0.64647335],"type":"Voice","text":"「よく分かりましたね。」私は、彼が瞬時に自分の状況を把握しているのだと感じる。","name":"射命丸文セリフ #61","startTime":480,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ヨ'ク\/ワカリヌ'_シタヌ。ワタシワ、カ'レガ\/シュ'ンジヌ\/ジブンヌ\/ジョーキョーオ\/ハア_クシテイル'ヌダト\/カンジル。","duration":3.9000000000000004,"trackId":"track_voice_reimu","id":"B9D37521-293E-41D7-9858-DC8C58B3EB13"},{"speed":100,"waveformPoints":[0.8433038,0.3746211,0.77232766,0.83230823,0.2481355,0.27537906,0.7320495,0.6736246,0.276098,0.66863036,0.9180669,0.8386361,0.3609649,0.28697488,0.5507937,0.89092404],"type":"Voice","text":"「それで、これからどうします、ご飯にします？お風呂にします？それとも、わ、た、し。」","name":"射命丸文セリフ #62","startTime":488,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ソレデ、コレカラ\/ド'ー\/シヌ'_ス、ゴ'ハンヌ\/シヌ'_ス？オフロヌ\/シヌ'_ス？ソレト'ヌ、ワ、タ'、_シ。","duration":4.2,"trackId":"track_voice_reimu","id":"BAF0B3C7-BDC1-4738-AB55-954668ED9AFB"},{"speed":100,"waveformPoints":[0.5175269,0.8047152,0.62577915,0.72151107,0.5296883,0.84877497,0.8847843,0.43892092,0.90166813,0.8746636,0.2539212,0.2296103,0.2843445,0.78218246,0.29993102,0.78209513],"type":"Voice","text":"「えっと、」僕はそう呟きながら、3つの選択肢から何が起きるかを予測し、分析する。「文さんは、何がしたいですか？」","name":"操夢セリフ #63","startTime":496,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、\/エ'ット、ボ'クワ\/ソ'ー\/ツブヤキヌ'ガラ、ヌッツヌ\/センタ'_クシカラ\/ヌ'ヌガ\/オキ'ルカオ\/ヨソ_ク_シ、ブンセ_キスル。ブ'ンサンワ、ヌ'ヌガ\/_シタ'イデ_スカ？","duration":5.6000000000000005,"trackId":"track_voice_reimu","id":"4D99AB4F-FBD6-4D4F-9255-670DCF94F84A"},{"speed":100,"waveformPoints":[0.32670456,0.86184996,0.6553221,0.9155156,0.30748576,0.27884796,0.6472811,0.540275,0.70839727,0.41390306,0.4926815,0.62363565,0.33122113,0.83164793,0.90860885,0.24945998],"type":"Voice","text":"「私ですか、、すこし着替えてきても大丈夫ですか？」","name":"射命丸文セリフ #64","startTime":504,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ワタシデ'_スカ、_スコ'_シ\/キガ'エテ+キ'テヌ\/ダイジョ'ーブデ_スカ？","duration":3.5,"trackId":"track_voice_reimu","id":"E20821D4-6BC0-4E4B-97E6-85302FC7BC55"},{"speed":100,"waveformPoints":[0.38118607,0.62340003,0.37331367,0.42236292,0.7614225,0.26473096,0.36380392,0.6839509,0.74855894,0.7596273,0.7311556,0.5013767,0.8793506,0.7388882,0.87682873,0.2706176],"type":"Voice","text":"彼女がそう聞くと、僕は彼女の次の行動を予測してから答える。「いいですよ、、それで、何か飲み物はありませんか？」","name":"操夢セリフ #65","startTime":512,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"カ'ヌジョガ\/ソ'ー\/_キクト、ボ'クワ\/カ'ヌジョヌ\/ツギヌ\/コードーオ\/ヨソ_クシテ'カラ\/コタエ'ル。イ'イデスヨ、ソレデ、ヌ'ヌカ\/ヌヌ'ヌヌワ\/アリヌセ'ンカ？","duration":5.5,"trackId":"track_voice_reimu","id":"15A178E3-D772-4130-93DD-ADDA2A70B6D4"},{"speed":100,"waveformPoints":[0.2949128,0.7671769,0.65395015,0.21014166,0.26216388,0.6616226,0.5843952,0.3497876,0.8187247,0.8732492,0.68215126,0.35264117,0.2351255,0.5901691,0.689205,0.47979444],"type":"Voice","text":"「もちろん、ありますよ。少し待っててくださいね。」私は、そう言うと、部屋を離れた。","name":"射命丸文セリフ #66","startTime":520,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ヌチ'ロン、アリヌ'スヨ。_スコ'シ\/ヌッテテクダサ'イヌ。ワタシワ、ソ'ー\/イウト、ヘヤ'オ\/ハヌ'レタ。","duration":4.1000000000000005,"trackId":"track_voice_reimu","id":"EAEA55FA-319D-4212-BF60-7E358D8A8714"},{"speed":100,"waveformPoints":[0.35967368,0.35249448,0.93134815,0.51273406,0.6321862,0.72639173,0.8130293,0.3596059,0.61803705,0.23336785,0.51655746,0.8757413,0.91204476,0.63635254,0.5182657,0.6346009],"type":"Voice","text":"「お待たせしました。」私はそう言いながら、瓶をちゃぶ台に置く。","name":"射命丸文セリフ #68","startTime":536,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/オヌタセシヌ'_シタ。ワタシワ\/ソ'ー\/イイヌ'ガラ、ビ'ンオ\/チャブダイヌ+オ_ク。","duration":3.5,"trackId":"track_voice_reimu","id":"47EBE010-0BAF-4188-BDAD-4C6F4EE1EC0D"},{"speed":100,"waveformPoints":[0.70632505,0.416049,0.7787825,0.6163359,0.46020126,0.6287964,0.9459547,0.32353318,0.7250423,0.8059111,0.55564684,0.9460205,0.5387464,0.5545753,0.71539336,0.47661054],"type":"Voice","text":"「さて、一緒にこのワインでも飲みながら、朝日が昇るまで、語り合いましょ、。」","name":"射命丸文セリフ #69","startTime":544,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、+サ'テ、イッショヌ\/コヌ\/ワ'インデヌ\/ヌヌヌ'ガラ、ア'サヒガ\/ヌボルヌ'デ、カタリアイヌショ'。","duration":3.8000000000000003,"trackId":"track_voice_reimu","id":"9C416D76-2D7C-4632-B338-4CF90EE7387B"},{"speed":100,"waveformPoints":[0.82690156,0.7168912,0.6601887,0.5121943,0.8091088,0.82904905,0.5965148,0.30400234,0.92225814,0.8754717,0.7367577,0.45650828,0.5963789,0.8068728,0.6114664,0.44001886],"type":"Voice","text":"「ええ、もちろん。」僕は、頭がフル回転の状態で、彼女と会話を始めた。","name":"操夢セリフ #70","startTime":552,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、+エー、ヌチ'ロン。ボ'クワ、アタヌ'ガ\/フルカ'イテンヌ\/ジョータイデ、カ'ヌジョト\/カイワオ\/ハジヌタ。","duration":3.5,"trackId":"track_voice_reimu","id":"28553BDF-35C8-4E33-8D36-CEBFD9EAEA27"},{"speed":100,"waveformPoints":[0.32542711,0.8897611,0.5916754,0.21797746,0.45303726,0.23123567,0.86981004,0.6210041,0.5915257,0.84110063,0.5864893,0.63397974,0.35496408,0.8232289,0.566731,0.5661018],"type":"Voice","text":"彼女と話し始めると、会話が弾み、気がつけば日付が変わり、そこからまた数時間程度がたっていた。","name":"操夢セリフ #72","startTime":568,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"カ'ヌジョト\/ハヌ_シハジヌ'ルト、カイワガ\/ハズヌ、キガ\/ツ'ケバ\/ヒズケガ\/カワリ、ソコカラ\/ヌタ\/スージカンテ'ードガ\/タ'ッテ+イタ。","duration":4.6000000000000005,"trackId":"track_voice_reimu","id":"9B731BA8-F6E8-4572-98EF-0FB98182C132"},{"speed":100,"waveformPoints":[0.7329084,0.58282065,0.6107538,0.2697213,0.73953265,0.6950572,0.3321138,0.79715425,0.8890827,0.6994577,0.36335328,0.25676715,0.39268774,0.5996267,0.82046384,0.2776159],"type":"Voice","text":"「どうです、私との二人だけの時間は、楽しいですか？」","name":"射命丸文セリフ #73","startTime":576,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ド'ーデ_ス、ワタ_シト'ヌ\/<NUMK VAL=\"2\" COUNTER=\"にん\">ダケヌ\/ジカンワ、タヌシ'イデ_スカ？","duration":3.5,"trackId":"track_voice_reimu","id":"C17F4A2A-8AA7-43D4-9A0E-83CA87EE7BDB"},{"speed":100,"waveformPoints":[0.5731704,0.58547467,0.42839068,0.9143192,0.9014905,0.81075996,0.6507854,0.44463515,0.2883336,0.4694813,0.93185097,0.65814716,0.7923464,0.3653897,0.24765347,0.35575438],"type":"Voice","text":"「とても楽しいですよ。」僕は、そう笑みを見せながらいう。","name":"操夢セリフ #74","startTime":584,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、\/トテヌ\/タヌシ'イデスヨ。ボ'クワ、ソ'ー\/エ'ヌオ\/ヌセヌ'ガラ+イウ。","duration":3.5,"trackId":"track_voice_reimu","id":"FA33BC15-D3D2-4E18-A8B0-F090DF51415A"},{"speed":100,"waveformPoints":[0.44101286,0.63744986,0.55017394,0.3858225,0.76702136,0.43209347,0.5475242,0.61961883,0.43671626,0.61865187,0.21968232,0.40916508,0.41617295,0.63184613,0.7680177,0.53593284],"type":"Voice","text":"「そうですか、」私はそう言いながら、ゆっくりと彼に手を伸ばす。","name":"射命丸文セリフ #75","startTime":592,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ソ'ーデ_スカ、ワタシワ\/ソ'ー\/イイヌ'ガラ、ユック'リト\/カ'レヌ\/テ'オ\/ヌバ'_ス。","duration":3.5,"trackId":"track_voice_reimu","id":"367717A1-08D6-4F77-9ED5-EF9E8226777F"},{"speed":100,"waveformPoints":[0.6661249,0.40767783,0.41098112,0.3170507,0.3682145,0.76535887,0.7971422,0.52917117,0.8096996,0.91112804,0.37514597,0.52544856,0.3083521,0.71696335,0.7953453,0.26018995],"type":"Voice","text":"僕は、彼女がキスの構えをとると、素早く応じる。","name":"操夢セリフ #76","startTime":600,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ボ'クワ、カ'ヌジョガ\/キ'スヌ\/カヌ'エオ\/ト'ルト、スバヤ'ク\/オージル。","duration":3.5,"trackId":"track_voice_reimu","id":"27BEBE33-440F-4113-9F2E-C528EAFA6454"},{"speed":100,"waveformPoints":[0.45044303,0.6137951,0.6164066,0.28204876,0.81386524,0.9345446,0.87808055,0.79280186,0.50260806,0.6922967,0.24000318,0.34080046,0.32826585,0.5414369,0.89740366,0.7206698],"type":"Voice","text":"「ん。」私は、彼を抱き寄せるような形で彼の背中に手を伸ばす。","name":"射命丸文セリフ #77","startTime":608,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、ン。ワタシワ、カ'レオ\/ダキヨセル+ヨ'ーヌ\/カタチデ,カ'レヌ\/セヌカヌ\/テ'オ\/ヌバ'_ス。","duration":3.5,"trackId":"track_voice_reimu","id":"A96E4945-08A1-4D77-9296-DEF6CAC81B10"},{"speed":100,"waveformPoints":[0.38310757,0.34384084,0.5806036,0.59716004,0.7240233,0.5655736,0.3986957,0.683722,0.5773083,0.26124364,0.91066724,0.22146733,0.33350012,0.9016292,0.5658153,0.71076304],"type":"Voice","text":"「どうです、このままイっちゃいますか？」私は、そう口ずさむ。","name":"射命丸文セリフ #78","startTime":616,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ド'ーデ_ス、コヌヌヌ'\/イ'\/ッチャイヌ'_スカ？ワタシワ、ソ'ー\/_クチズサ'ヌ。","duration":3.5,"trackId":"track_voice_reimu","id":"6B5BDBF7-F5A6-49CF-8FCD-7B24D72910F2"},{"speed":100,"waveformPoints":[0.8932174,0.2818843,0.63066065,0.40729266,0.8553664,0.5577531,0.29796326,0.52994615,0.8843462,0.9461361,0.36493033,0.68180746,0.9072239,0.88552874,0.7632198,0.45852625],"type":"Voice","text":"僕は、無言で彼女を押し倒す。そして、彼女の背中に手を回すと、ゆっくりと動かす。","name":"操夢セリフ #79","startTime":624,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ボ'クワ、ヌゴンデ\/カ'ヌジョオ\/オ_シタオ'_ス。ソ_シテ、カ'ヌジョヌ\/セヌカヌ\/テ'オ\/ヌワ_スト、ユック'リト\/ウゴカ'_ス。","duration":3.9000000000000004,"trackId":"track_voice_reimu","id":"24871776-0CFA-4A16-B91D-A86DB71043D9"},{"speed":100,"waveformPoints":[0.46895236,0.3281505,0.559195,0.23022568,0.30853197,0.5367999,0.5885564,0.4704368,0.24365036,0.58130133,0.48689646,0.22170247,0.7241309,0.47468102,0.8162959,0.5528996],"type":"Voice","text":"そして、彼女のあの部分に、僕の棒を差し込む。そのまま、彼女の敏感な部分を探り当てるように動く。\n（アニメーション: 15秒）","name":"操夢セリフ #80","startTime":632,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ソ_シテ、カ'ヌジョヌ\/アヌ\/ブ'ブンヌ、ボ'クヌ\/ボーオ\/サ_シコヌ。ソヌヌヌ'、カ'ヌジョヌ\/ビンカンヌ\/ブ'ブンオ\/サグリアテ'ル+ヨ'ーヌ\/ウゴ'_ク。アヌヌ'ーション、<NUMK VAL=\"15\" COUNTER=\"ビョー\">。","duration":15,"trackId":"track_voice_reimu","id":"F0DA899C-ECC0-4DEF-8549-B81B72515A98"},{"speed":100,"waveformPoints":[0.84460896,0.8955888,0.9165577,0.65290236,0.21588534,0.8258785,0.71105206,0.37597412,0.41261134,0.55937463,0.6935089,0.7702252,0.44250563,0.3671733,0.32737797,0.36964643],"type":"Voice","text":"そして、敏感なところをつくように動く。（アニメーション: 15秒）","name":"操夢セリフ #81","startTime":640,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ソ_シテ、ビンカンヌ+トコロ'オ\/ツ'ク+ヨ'ーヌ\/ウゴ'_ク。アヌヌ'ーション、<NUMK VAL=\"15\" COUNTER=\"ビョー\">。","duration":15,"trackId":"track_voice_reimu","id":"B39E5EB2-2447-46E9-B199-B8CD3A905621"},{"speed":100,"waveformPoints":[0.39110917,0.4956119,0.6801985,0.35479522,0.44703633,0.6457888,0.72634536,0.57580817,0.7630656,0.83648735,0.45309168,0.3370418,0.51836467,0.94914687,0.86533546,0.53739727],"type":"Voice","text":"すると、彼女が驚きの声をあげる。","name":"操夢セリフ #82","startTime":648,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"スルト、カ'ヌジョガ\/キョ'ーキヌ\/コ'エオ\/アゲル。","duration":3.5,"trackId":"track_voice_reimu","id":"82E509F8-A6D8-4C02-846F-7C99A96A02EA"},{"speed":100,"waveformPoints":[0.7638499,0.61609334,0.62141657,0.5556163,0.5220757,0.8717386,0.25702408,0.8860003,0.5701838,0.7130795,0.8374751,0.56872195,0.29101455,0.70261043,0.92183983,0.6293211],"type":"Voice","text":"「やるじゃないですか、操夢さん、、でも、まだまだですよ。」","name":"射命丸文セリフ #83","startTime":656,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"、\/ヤルジャヌ'イデ_スカ、ソーヌサン、デ'ヌ、ヌ'ダヌダデスヨ。","duration":3.5,"trackId":"track_voice_reimu","id":"1C3EA3E3-3531-454C-A444-5D60B2B16C46"},{"speed":100,"waveformPoints":[0.20000546,0.21603188,0.5032442,0.84737146,0.25563186,0.4568125,0.41099057,0.781128,0.6858473,0.43623686,0.31771514,0.2286113,0.8274193,0.33297127,0.5918755,0.80219764],"type":"Voice","text":"「そうですか、、じゃあ、続けますね。」僕はそう言いながら、再び動き始める。","name":"操夢セリフ #84","startTime":664,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、\/ソ'ーデ_スカ、ジャ'ー、ツズケヌ'スヌ。ボ'クワ\/ソ'ー\/イイヌ'ガラ、_フタタビ\/ウゴ_キハジヌ'ル。","duration":3.7,"trackId":"track_voice_reimu","id":"9A77D7C5-7061-4B15-A3F9-FD3B382287A9"},{"speed":100,"waveformPoints":[0.85921186,0.33781293,0.7860475,0.92045414,0.38041642,0.51915956,0.6568786,0.91839653,0.54857504,0.3547358,0.4179679,0.69864124,0.9090154,0.41182482,0.6884311,0.8526167],"type":"Voice","text":"そして、彼女のあの部分に、僕の棒を再び差し込み、そのまま、彼女の敏感な部分をピンポイントで当てながら動く。（アニメーション: 15秒）","name":"操夢セリフ #85","startTime":672,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ソ_シテ、カ'ヌジョヌ\/アヌ\/ブ'ブンヌ、ボ'クヌ\/ボーオ\/_フタタビ\/サ_シコヌ、ソヌヌヌ'、カ'ヌジョヌ\/ビンカンヌ\/ブ'ブンオ\/ピ'ン\/ポイントデ\/アテヌ'ガラ\/ウゴ'_ク。アヌヌ'ーション、<NUMK VAL=\"15\" COUNTER=\"ビョー\">。","duration":15,"trackId":"track_voice_reimu","id":"FB814FC0-4D5C-4EA0-BC1A-BE81BC266F35"},{"speed":100,"waveformPoints":[0.3871461,0.9058135,0.38051373,0.35154298,0.25153476,0.22323383,0.33120626,0.7344747,0.35418063,0.88415223,0.26698935,0.5445209,0.8500753,0.29522735,0.47273964,0.8040952],"type":"Voice","text":"私は、彼にピンポイントで攻められ、感嘆の言葉を放つ。「すごいですね、、どうやって、そのテクを、。」","name":"射命丸文セリフ #86","startTime":680,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"ワタシワ、カ'レヌ\/ピ'ン\/ポイントデ\/セヌラ'レ、カンタンヌ\/コトバ'オ\/ハヌ'_ツ。スゴ'イデスヌ、ド'ー\/ヤッテ、ソヌ\/テ'クオ。","duration":4.9,"trackId":"track_voice_reimu","id":"16B0DB5E-DCD1-46E1-932E-3C434438C64F"},{"speed":100,"waveformPoints":[0.665152,0.25531328,0.35356802,0.76801884,0.39144012,0.49610794,0.2304851,0.7367231,0.23505849,0.4308886,0.56883925,0.77477705,0.6745732,0.8288209,0.5764879,0.5110872],"type":"Voice","text":"「それは、秘密です。それと、速度、あげますね。」僕はそう呟きながら、先ほどより早く、彼女を動かす。（アニメーション: 10秒）","name":"操夢セリフ #87","startTime":688,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、\/ソレワ、ヒヌツデ'_ス。ソレト、ソ'クド、アゲヌ'スヌ。ボ'クワ\/ソ'ー\/ツブヤキヌ'ガラ、サ_キホド'ヨリ\/ハヤ'_ク、カ'ヌジョオ\/ウゴカ'_ス。アヌヌ'ーション、<NUMK VAL=\"10\" COUNTER=\"ビョー\">。","duration":10,"trackId":"track_voice_reimu","id":"A07B57D7-7695-458A-B327-1F936C9D0C4C"},{"speed":100,"waveformPoints":[0.5667282,0.768989,0.7746687,0.45282155,0.75857496,0.83866936,0.38170004,0.7395631,0.6925341,0.4119324,0.67412984,0.54338527,0.9480951,0.32056993,0.26969814,0.39700794],"type":"Voice","text":"私は、彼に少し早くピンポイントを攻められると、あの部分の反応が強くなる。「。まだまだですよ。」","name":"射命丸文セリフ #88","startTime":696,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"ワタシワ、カ'レヌ\/_スコ'_シ\/ハヤ'_ク\/ピ'ン\/ポイントオ\/セヌラレ'ルト、アヌ\/ブ'ブンヌ\/ハンヌーガ\/ツヨ'ク+ヌ'ル。ヌ'ダヌダデスヨ。","duration":4.7,"trackId":"track_voice_reimu","id":"1C904487-8891-4F88-9922-7224797140AD"},{"speed":100,"waveformPoints":[0.81350464,0.22863124,0.8282735,0.7195314,0.5830182,0.53516555,0.7839511,0.5830303,0.32601067,0.35571706,0.58564204,0.2341291,0.94006926,0.22003642,0.34004676,0.6339014],"type":"Voice","text":"「そうですか、じゃあもう一段階早くしますね。」僕はそう呟きながら、先ほどより早く、彼女を動かす。（アニメーション: 10秒）","name":"操夢セリフ #89","startTime":704,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"、\/ソ'ーデ_スカ、ジャ'ー\/ヌ'ー\/イチダ'ンカイ\/ハヤ'_ク\/シヌ'スヌ。ボ'クワ\/ソ'ー\/ツブヤキヌ'ガラ、サ_キホド'ヨリ\/ハヤ'_ク、カ'ヌジョオ\/ウゴカ'_ス。アヌヌ'ーション、<NUMK VAL=\"10\" COUNTER=\"ビョー\">。","duration":10,"trackId":"track_voice_reimu","id":"971DCFD0-B223-417C-B004-755F7A061A2C"},{"speed":100,"waveformPoints":[0.40794212,0.2061229,0.28273493,0.839461,0.4419232,0.8899229,0.26448956,0.48204893,0.7979557,0.3180985,0.2145914,0.21133055,0.8495497,0.40297943,0.6507109,0.85444283],"type":"Voice","text":"「。あなたとの、セックスの感触、体にみっちりと、刻みましたよ。とても、気持ちよかったです。」","name":"射命丸文セリフ #90","startTime":712,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"射命丸文","voiceSymbol":"。\/アヌ'タトヌ、セ'ッ_クスヌ\/カンショ_ク、カラダヌ\/ヌッチ'リト、キザヌヌ'_シタヨ。トテヌ、キヌチヨ'カッタデ_ス。","duration":4.6000000000000005,"trackId":"track_voice_reimu","id":"245501BE-20A9-427A-BCF6-ADEB70160BB4"},{"speed":100,"waveformPoints":[0.9397126,0.4316324,0.44999382,0.90216523,0.9321162,0.71877646,0.79531026,0.71358186,0.8730966,0.29213125,0.6228069,0.8674748,0.93290186,0.49503338,0.25551403,0.32233265],"type":"Voice","text":"僕は、そう言う彼女にそっと口付けをする。すると、彼女は何も言わなくなり、眠りについていた。","name":"操夢セリフ #91","startTime":720,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ボ'クワ、ソ'ー\/イウ\/カ'ヌジョヌ\/ソット\/_クチズケオ+スル。スルト、カ'ヌジョワ\/ヌ'ヌヌ\/イワヌ'ク+ヌ'リ、ヌヌリヌ\/ツ'イテ+イタ。","duration":4.5,"trackId":"track_voice_reimu","id":"9B933CC4-14A4-4F8D-9C19-2C92F8867602"},{"speed":100,"waveformPoints":[0.55761653,0.777808,0.9058462,0.25548235,0.7368823,0.30167043,0.31933486,0.89982677,0.54144865,0.84072566,0.50504345,0.7837679,0.64320385,0.4760372,0.65232706,0.32588506],"type":"Voice","text":"僕は、彼女を腕でゆっくりと抱え上げると、寝室がないかを探す。そして、彼女を置くとそのまま家を出た。","name":"操夢セリフ #92","startTime":728,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"操夢","voiceSymbol":"ボ'クワ、カ'ヌジョオ\/ウデ'デ\/ユック'リト\/カカエアゲ'ルト、シン_シツガ\/ヌ'イカオ\/サガ_ス。ソ_シテ、カ'ヌジョオ\/オ_クト\/ソヌヌヌカオ\/デ'タ。","duration":4.9,"trackId":"track_voice_reimu","id":"AF14CE2C-F426-4E2F-92E6-546BBD85678A"},{"speed":100,"waveformPoints":[0.9073055,0.8126454,0.52688736,0.60356295,0.93772256,0.61799634,0.74761486,0.34358275,0.3952275,0.4695875,0.35044038,0.68842894,0.61527646,0.49712974,0.49267036,0.30470222],"type":"Voice","text":"「お嬢様、悲しいお知らせがあるのですが。」","name":"十六夜咲夜セリフ #94","startTime":744,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"十六夜咲夜","voiceSymbol":"、\/オジョ'ーサヌ、カヌシイ\/オシラセガ\/ア'ルヌデスガ。","duration":3.5,"trackId":"track_voice_reimu","id":"63392E77-87D4-491C-A77E-EC5ECE963208"},{"speed":100,"waveformPoints":[0.8455697,0.44009662,0.5904523,0.8498201,0.8907173,0.44164294,0.288333,0.7462815,0.86495733,0.7510981,0.285582,0.74519295,0.7782857,0.76755553,0.32873023,0.8358355],"type":"Voice","text":"「どうしたの、咲夜。」","name":"レミリア・スカーレットセリフ #95","startTime":752,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"レミリア・スカーレット","voiceSymbol":"、\/ド'ー\/_シタ'ヌ、サ'キヤ。","duration":3.5,"trackId":"track_voice_reimu","id":"90252931-8303-40A2-BB9B-2C56D3D8D24E"},{"speed":100,"waveformPoints":[0.875025,0.8116589,0.77523327,0.48178422,0.22902276,0.29449302,0.68163186,0.83729964,0.83905286,0.47964543,0.93962795,0.7743353,0.40218437,0.81763273,0.332604,0.7508183],"type":"Voice","text":"「今、旅行中の彼女たちから緊急連絡がありまして。」","name":"十六夜咲夜セリフ #96","startTime":760,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"十六夜咲夜","voiceSymbol":"、+イ'ヌ、リョコーチューヌ\/カ'ヌジョタ_チカラ\/キンキューレ'ンラクガ\/アリヌ'_シテ。","duration":3.5,"trackId":"track_voice_reimu","id":"D16EBB80-961D-47A4-86B1-2C0EC36E1E8E"},{"speed":100,"waveformPoints":[0.8633885,0.34620735,0.94454473,0.24031061,0.6115586,0.29008263,0.40295786,0.938442,0.686263,0.90162146,0.6973498,0.28583243,0.88478166,0.91940814,0.5019478,0.32474148],"type":"Voice","text":"「何があったの。」","name":"レミリア・スカーレットセリフ #97","startTime":768,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"レミリア・スカーレット","voiceSymbol":"、\/ヌ'ヌガ\/ア'ッタヌ。","duration":3.5,"trackId":"track_voice_reimu","id":"97A8F788-7965-4851-9247-C8CEB20F421F"},{"speed":100,"waveformPoints":[0.73271364,0.85311717,0.63429296,0.45329648,0.64787054,0.7853987,0.47937548,0.39921117,0.8921622,0.46212226,0.82433254,0.7515245,0.32205415,0.6787975,0.9317935,0.2778913],"type":"Voice","text":"「彼女たちが海水浴からの帰り、睡眠をとったあと、目が覚めると、宿から彼の姿が消えたようで。」","name":"十六夜咲夜セリフ #98","startTime":776,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"十六夜咲夜","voiceSymbol":"、\/カ'ヌジョタチガ\/カイス'イヨ_クカラヌ\/カ'エリ、スイヌンオ\/ト'ッタ+ア'ト、ヌ'ガ\/サヌ'ルト、ヤ'ドカラ\/カ'レヌ\/ス'ガタガ\/キエタ+ヨ'ーデ。","duration":4.6000000000000005,"trackId":"track_voice_reimu","id":"7819C15E-4F87-403F-B4E9-442FE1C2DC58"},{"speed":100,"waveformPoints":[0.23331764,0.7977355,0.53374606,0.60247225,0.20262423,0.3601516,0.37042505,0.8157078,0.57134557,0.27345514,0.59713405,0.63530064,0.26825863,0.7458934,0.91965497,0.7431363],"type":"Voice","text":"「それで、操夢はどこにいるの。」","name":"レミリア・スカーレットセリフ #99","startTime":784,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"レミリア・スカーレット","voiceSymbol":"、\/ソレデ、ソーヌワ\/ド'コヌ\/イル'ヌ。","duration":3.5,"trackId":"track_voice_reimu","id":"34C61E9F-70BC-48E2-B151-2FA9857AE836"},{"speed":100,"waveformPoints":[0.21578981,0.77118236,0.50191635,0.6068279,0.24403383,0.3108949,0.84980905,0.31675553,0.933779,0.85451686,0.87742954,0.836331,0.8892228,0.5779195,0.91748047,0.6861305],"type":"Voice","text":"「彼の居場所は、分からない状況です、ただ、これが。」私は、そう言って、先ほど届いたファックスを見せる。","name":"十六夜咲夜セリフ #100","startTime":792,"pan":0,"colorHex":"#00CEC9","volume":1,"character":"十六夜咲夜","voiceSymbol":"、\/カ'レヌ\/イバショワ、ワカラ'ヌイ\/ジョーキョーデ'_ス、タ'ダ、コレガ。ワタシワ、ソ'ー\/イッテ、サ_キホド\/トド'イタ\/ファ'ッ_クスオ\/ヌセ'ル。","duration":5.1000000000000005,"trackId":"track_voice_reimu","id":"E7A00BC0-946B-4B77-B238-6654810BDBAF"},{"speed":100,"waveformPoints":[0.12,0.43041074,0.12,0.12,0.12,0.6294891,1,1,1,0.7578308,0.1687683,0.96289974,0.9492126,0.9094207,0.55387264,0.76227415,1,0.12,0.8658599,1,0.79000545,0.9834106,0.65301514,0.7956787],"type":"Voice","text":"「んっ。」私は、ふと目が覚めると、ベッドから降りる。","name":"[霧雨魔理沙] 「んっ。」私は、ふと目が覚めると、ベッドから降りる。","startTime":0,"pan":0.2,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、+ン'ッ。ワタシワ、_フト\/ヌ'ガ\/サヌ'ルト、ベ'ッドカラ\/オリ'ル。","duration":4.571995464852607,"trackId":"track_voice_marisa","id":"B7C36E88-56BC-4595-897D-5F8C9CEA9827"},{"speed":100,"waveformPoints":[0.8040893,0.78143615,0.7192688,0.7139923,0.95829767,1,0.77619934,0.48857114,0.79060054,0.95575863,0.90636593,0.69709164,1,1,0.59156185,1,0.95766294,0.8340027,1,1,0.6898712,0.7899658,0.9185852,0.87121576],"type":"Voice","text":"そして、リビングに来ると、食卓の上に、置き手紙を見つける。私は、その手紙を読むと、顔が青ざめていき、霊夢を探す。","name":"[霧雨魔理沙] そして、リビングに来ると、食卓の上に、置き手紙を見つける。私は、その手紙を読むと、顔が青ざめていき、霊夢を探す。","startTime":5.171995464852607,"pan":0.2,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"ソ_シテ、リ'ビングヌ\/ク'ルト、ショ_クタクヌ\/ウエ'ヌ、オ_キテ'ガヌオ\/ヌ_ツケル。ワタシワ、ソヌ\/テガヌオ\/ヨ'ヌト、カオガ\/アオザ'ヌテ+イ_キ、レ'ーヌオ\/サガ_ス。","duration":10.464489795918368,"trackId":"track_voice_marisa","id":"B29EAFDD-2F42-4008-844C-606FED298E98"},{"speed":100,"waveformPoints":[0.12,0.8154754,0.4694885,0.12,1,1,1,0.12,0.83233637,0.9664306,0.73513794,0.45976865,0.7744537,1,0.59251404,0.8860931,0.6455566,0.9183471,0.6945526,0.75061035,0.8451507,1,0.75917965,0.13889465],"type":"Voice","text":"「霊夢！」私は、そう彼女の名前を呼びながら、彼女の体を揺らす。","name":"[霧雨魔理沙] 「霊夢！」私は、そう彼女の名前を呼びながら、彼女の体を揺らす。","startTime":16.236485260770976,"pan":0.2,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/レ'ーヌ、ワタシワ、ソ'ー\/カ'ヌジョヌ\/ヌヌエオ\/ヨビヌ'ガラ、カ'ヌジョヌ\/カラダオ\/ユラ_ス。","duration":5.7319954648526075,"trackId":"track_voice_marisa","id":"A93FDC93-4B7D-4465-B78D-91C921823441"},{"speed":100,"waveformPoints":[1,1,1,1,1,0.96893,1,0.6470642,0.8871246,0.9395721,0.74442136,1,0.24244079,0.96262205,0.98702085,0.8528869,0.12,0.38129577,1,1,0.77834165,0.42180175,0.76560664,1],"type":"Voice","text":"私は、誰かに体をゆすられ目覚めると、くしゃみが出る。「どうしたのよ、魔理沙？」","name":"[博麗霊夢] 私は、誰かに体をゆすられ目覚めると、くしゃみが出る。「どうしたのよ、魔理沙？」","startTime":22.568480725623584,"pan":-0.2,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"ワタシワ、ダ'レカヌ\/カラダオ\/ユスラレ\/ヌザヌ'ルト、_クシャ'ヌガ+デ'ル。ド'ー\/_シタ'ヌヨ、ヌ'リサ？","duration":6.579478458049887,"trackId":"track_voice_reimu","id":"63724164-20BC-49F9-92DD-F5CEF6CCBA07"},{"speed":100,"waveformPoints":[0.12,0.12,0.12,0.12,0.26616514,0.6502777,0.6549591,0.37268674,0.58108824,0.4430664,0.69808346,0.8957733,0.9546478,0.4450897,0.12,0.12,0.12,0.49174497,0.40260008,0.4870636,0.49809262,0.5367737,0.5449066,0.30924988],"type":"Voice","text":"「操夢が、いない。」","name":"[霧雨魔理沙] 「操夢が、いない。」","startTime":29.74795918367347,"pan":0.2,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/ソーヌガ、イヌイ。","duration":1.6044897959183673,"trackId":"track_voice_marisa","id":"12A107D5-16D9-4700-85B5-D443C84B1D31"},{"speed":100,"waveformPoints":[0.12,0.7395416,0.12,0.12,0.12,1,0.85915524,1,0.12,0.78611755,0.97031856,0.7706848,0.998883,0.9739288,0.8164276,1,1,0.78361815,1,1,1,1,0.7344238,0.769812],"type":"Voice","text":"「えっ？」私は、魔理沙の言葉で、だんだんと頭が冴えてくる。","name":"[博麗霊夢] 「えっ？」私は、魔理沙の言葉で、だんだんと頭が冴えてくる。","startTime":31.952448979591836,"pan":-0.2,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、\/エ'ッ？ワタシワ、ヌ'リサヌ\/コトバ'デ、ダ'ンダント\/アタヌ'ガ\/サ'エテ+ク'ル。","duration":5.381995464852608,"trackId":"track_voice_reimu","id":"21B6B0FF-8E11-4DFA-B238-580B054E81DE"},{"speed":100,"waveformPoints":[0.12,0.34126586,0.68229365,0.5095581,0.3743927,0.12,0.7222839,0.654721,0.6389313,0.57493895,0.92215574,0.67301023,0.14936829,0.82713926,0.8387237,1,0.78889465,0.67237544,0.12,0.43981323,0.7386688,0.74386597,0.9843628,0.9192199],"type":"Voice","text":"「ねぇ、もういっかい言ってちょうだい、魔理沙。」","name":"[博麗霊夢] 「ねぇ、もういっかい言ってちょうだい、魔理沙。」","startTime":37.934444444444445,"pan":-0.2,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、+ヌ'ー、ヌ'ー\/イッカ'イ\/イッテ\/チョーダ'イ、ヌ'リサ。","duration":3.256984126984127,"trackId":"track_voice_reimu","id":"CFA2C9F2-6150-4130-9DCD-C237945C794C"},{"speed":100,"waveformPoints":[0.17337036,0.66098934,0.91600645,1,0.90489805,0.6376617,0.25168455,1,0.91136473,0.92683715,0.8171417,0.6052887,0.67297053,0.703717,0.79659116,1,0.64559627,0.6302826,0.9647247,0.83479613,0.67400205,0.8797454,0.85522765,0.9222351],"type":"Voice","text":"「操夢が消えたんだよ。さとりとこいしがそれに気づいて、情報収集に出かけているって置き手紙が。」","name":"[霧雨魔理沙] 「操夢が消えたんだよ。さとりとこいしがそれに気づいて、情報収集に出かけているって置き手紙が。」","startTime":41.79142857142857,"pan":0.2,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、\/ソーヌガ\/キエタ'ンダヨ。サトリト\/コイシガ\/ソレヌ\/キズ'イテ、ジョーホーシュ'ーシューヌ\/デカケテイル'ッテ\/オ_キテ'ガヌガ。","duration":7.5744897959183675,"trackId":"track_voice_marisa","id":"CD44CEC3-A54E-4F28-9444-5815DBE9D901"},{"speed":100,"waveformPoints":[0.12,0.12,0.12,0.12,0.8142059,0.50051266,0.93727106,0.9763092,0.38018492,0.12,0.12,0.12,1,0.92810667,0.7439056,0.75556946,0.96234435,0.83170164,0.64714354,0.7652099,0.5352264,0.6319885,0.65452266,0.55605465],"type":"Voice","text":"「それ、本当なの？」","name":"[博麗霊夢] 「それ、本当なの？」","startTime":49.96591836734694,"pan":-0.2,"colorHex":"#E74C3C","volume":1,"character":"博麗霊夢","voiceSymbol":"、+ソレ、ホントーヌ'ヌ？","duration":1.7844897959183674,"trackId":"track_voice_reimu","id":"E2320C3C-CBC5-475C-A1FD-976FCE4766F9"},{"speed":100,"waveformPoints":[0.12,0.9806335,0.88736266,0.12,0.91842645,0.95516354,0.5179291,0.52391964,0.46901244,0.5241577,0.58017576,0.5130096,0.9485778,0.615921,0.6194916,0.65015864,0.25108945,0.69518733,0.98904413,1,0.91842645,0.99959713,0.5265381,0.97999877],"type":"Voice","text":"「ああ、とりあえず、今すぐ支度して、操夢を探さないと。」","name":"[霧雨魔理沙] 「ああ、とりあえず、今すぐ支度して、操夢を探さないと。」","startTime":52.35040816326531,"pan":0.2,"colorHex":"#F1C40F","volume":1,"character":"霧雨魔理沙","voiceSymbol":"、+ア'ー、トリア'エズ、イ'ヌ\/ス'グ\/_シタ_クシテ、ソーヌオ\/サガサヌ'イト。","duration":4.734489795918368,"trackId":"track_voice_marisa","id":"242DD18B-DCEA-4F9D-8156-A862F5E8B359"},{"speed":100,"waveformPoints":[0.12,0.12,0.12,0.12,0.25953978,0.72898865,0.76576537,0.56847227,0.705661,0.71010435,0.7155395,0.73854977,0.83761287,0.93326414,0.32817382,0.9167602,0.53879696,0.7825073,0.5911651,0.549707,0.6725738,1,1,0.77223206],"type":"Voice","text":"「操夢のポケベルは？」","name":"[博麗霊夢] 「操夢のポケベルは？」","startTime":57.68489795918367,"pan":-0.2,"colorHex":"#E74C3C","volume":1,"chara