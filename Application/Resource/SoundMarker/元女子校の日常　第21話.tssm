      "title" : "シーン 74",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「アリスさんは、なんで屋台村なんかに行ったんですか？」",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #74",
      "characterName" : "操夢",
