    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 2.5,
      "id" : "7D227412-DCC9-4F9E-8BA0-C0C46848AE46",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 9: 東方Project二次創作作品　Powerd By zuyasi",
      "telop" : "元女子校の日常",
      "slideTitle" : "スライド #9",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.009.jpeg",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 7.646303854875283,
      "id" : "9A738C45-048A-4F43-9829-F5D202B3881A",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image60.jpeg",
      "title" : "シーン 10",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕たちは、夕食を終えると、ホテルに戻ってきた。\nそして、今晩はこいしと僕が同じ部屋で過ごすことになった。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #10",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.010.jpeg",
      "voiceDuration" : 7.646303854875283,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 6.585419501133787,
      "id" : "FF50D466-2726-4A81-B4CC-BC6568664C10",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image60.jpeg",
      "title" : "シーン 11",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そして、とりあえず、互いに入浴を済ませることにし、\n今は、こいしが先に入っているところだった。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #11",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.011.jpeg",
      "voiceDuration" : 6.585419501133787,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.40607709750567,
      "id" : "C39356B2-56E5-432E-BF7A-954848E5C23B",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image60.jpeg",
      "title" : "シーン 12",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、暇つぶしにテレビをつける。だが、なんだかどの番組をつまらなく感じ、すぐに消すと、ベッドに腰掛けぼーっとする。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #12",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.012.jpeg",
      "voiceDuration" : 8.40607709750567,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
