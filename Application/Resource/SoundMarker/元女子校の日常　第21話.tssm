      "title" : "シーン 8",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「そうですか。」僕はそういうと、それを注文した。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #8",
      "characterName" : "操夢",
