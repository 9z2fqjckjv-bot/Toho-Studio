      "title" : "シーン 15",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、特に問題なく、了承すると通話相手が変わる。\nそして、聞こえてきたのは、フランの声だった。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #15",
      "characterName" : "操夢",
