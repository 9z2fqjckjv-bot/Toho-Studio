      "voiceDuration" : 5.295283446712018,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 2.53,
      "id" : "D6C5FC5E-19A4-4A58-956C-CB40F530C384",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/頬照り小口開け.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
