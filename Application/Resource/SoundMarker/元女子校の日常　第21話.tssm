      "voiceDuration" : 7.310430839002268,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
