      "title" : "シーン 72",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「ほら、帰りますよ…、アリスさん…。」僕は、そう言い彼女の手を取る。彼女は、特に手間取ることもなくそのまま歩き出す。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #72",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.072.jpeg",
      "voiceDuration" : 8.588684807256236,
      "voice2StartTimeOffset" : 0
    },
    {
