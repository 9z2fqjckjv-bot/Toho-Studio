      "voiceDuration" : 1.472108843537415,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.747369614512472,
      "id" : "1CBB89A3-FDCC-4A83-B3D6-63D0B0555251",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 85",
      "audioTrack" : "track_voice_soumu",
      "telop" : "彼女はそう言うと、風呂場に向かう。だが、床の段差につまづき、彼女は転けそうになる。僕は、彼女のそばに駆け寄る。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #85",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.085.jpeg",
      "voiceDuration" : 8.747369614512472,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 2.0380725623582765,
      "id" : "D50EE1CA-BB7F-4921-9900-8113DCDAD681",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_アリス・マーガトロイド.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 86",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "telop" : "「うっ…、酔いが回ってしまったのかしら…」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #86",
      "characterName" : "アリス・マーガトロイド",
