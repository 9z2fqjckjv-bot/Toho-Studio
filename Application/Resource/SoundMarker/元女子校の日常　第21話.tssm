      "id" : "F1D1A9DA-5ADC-4018-88BD-2517764BC21D",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/さとり（驚く）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_古明地こいし.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image60.jpeg",
      "title" : "シーン 55",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "telop" : "「ええそうよ…、しかも、確定ではないけど、彼には副人格があって、その人格のときに、某建設会社の嬢の許嫁になるって…」",
      "voiceCharacter" : "古明地こいし",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #55",
      "characterName" : "古明地こいし",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.055.jpeg",
      "voiceDuration" : 11.65578231292517,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 5.9209977324263035,
      "id" : "9660923C-4E46-4559-B570-EC3BC6A87C56",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/困った笑み.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_古明地さとり.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image60.jpeg",
      "title" : "シーン 56",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "telop" : "「ねぇ、もっと詳しい話を聞かせてくれない…、これは私とあなたの将来と私たちのグループに関わる出来事だから…」",
      "voiceCharacter" : "古明地さとり",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #56",
      "characterName" : "古明地さとり",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.056.jpeg",
      "voiceDuration" : 5.9209977324263035,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 11.26766439909297,
      "id" : "7E17BA59-17A0-4904-96C2-8ABC59A4960C",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/困った笑み.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_古明地こいし.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image60.jpeg",
      "title" : "シーン 57",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "telop" : "「ええ。」私は、彼が私の裸を見るまでは…、ただ甘えたい時に甘えられていた…、だが今となっては、それは過去の話だった。",
      "voiceCharacter" : "古明地こいし",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #57",
      "characterName" : "古明地こいし",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.057.jpeg",
      "voiceDuration" : 11.26766439909297,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 2.5,
      "id" : "756592F2-6DD3-4E62-A9AE-80A89D5985D1",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 58: 一方彼は…",
      "telop" : "一方彼は…",
      "slideTitle" : "スライド #58",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "単色背景",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.058.jpeg",
      "voice2StartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 6.9039002267573695,
      "id" : "0337962F-7EDB-4E22-B6D1-CD25BB422779",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/nc283172_商店街（夜）.jpg",
      "title" : "シーン 59",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、彼女が長電話をする中、なんとなく気まずくなり、\n部屋を出て、夜の国際通りを歩いていた。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #59",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "nc283172_商店街（夜）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.059.jpeg",
      "voiceDuration" : 6.9039002267573695,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 3.0973696145124716,
      "id" : "3764CE6B-4E34-44A0-BCAF-6CF2D3C443B0",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/nc283172_商店街（夜）.jpg",
      "title" : "シーン 60",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そして、しばらく歩いていると、ある予感がする。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #60",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "nc283172_商店街（夜）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.060.jpeg",
      "voiceDuration" : 3.0973696145124716,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.063242630385487,
      "id" : "10542F18-06BD-4886-A0A1-9655E337DC57",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 61",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そして、僕は国際通りから少し離れた屋台が立ち並ぶ場所に来た。そして、屋台の間の通路を歩き進んでいく。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #61",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.061.jpeg",
      "voiceDuration" : 8.063242630385487,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.094126984126984,
      "id" : "D66140BA-7ECF-4875-8C8F-5027B84495FD",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 62",
      "audioTrack" : "track_voice_soumu",
      "telop" : "すると、見事にその予感は当たり、頬照り、困った様子で、生ビールとおつまみらしきものを嗜む彼女の姿があった。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #62",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.062.jpeg",
      "voiceDuration" : 8.094126984126984,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 4.586507936507936,
      "id" : "95988192-1479-4281-BFE5-25CAECECCF66",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 63",
      "audioTrack" : "track_voice_soumu",
      "telop" : "すると、彼女は僕の存在に気がついたのか、驚いた表情をする。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #63",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.063.jpeg",
      "voiceDuration" : 4.586507936507936,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 5.194988662131519,
      "id" : "C8A886CB-D563-47D8-AA66-B3A60AD0E916",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_アリス・マーガトロイド.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 64",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "telop" : "「どうしたの…、紅夢くん…、高校生が来る場所じゃないわよ、ここは…、何か困ったことでもあったの？」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #64",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.064.jpeg",
      "voiceDuration" : 5.194988662131519,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 7.499546485260771,
      "id" : "501B8CA3-FA2D-4BFE-B6B6-C1E85C1A340B",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 65",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「アリスさん、その生ビールは何杯目ですか？」僕は、ジョッキグラスの半分ほど残っている、生ビールを見て言う。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #65",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.065.jpeg",
      "voiceDuration" : 7.499546485260771,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 5.285555555555556,
      "id" : "F733625D-C0F9-49C0-B491-5DBEC5682E1E",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_アリス・マーガトロイド.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 66",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "telop" : "「そんなことは、どうだっていいのよ…、それより彼女たちはどうしたのよ…、ここにいないならホテルにいるのでしょ？」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #66",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.066.jpeg",
      "voiceDuration" : 5.285555555555556,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.419115646258504,
      "id" : "BB86B176-C6EC-4B15-80B7-9377DA6B0043",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 67",
      "audioTrack" : "track_voice_soumu",
      "telop" : "彼女がそう言うと、カウンター越しに、お店の人が驚いた様子で僕を見る。僕は、慌てて首を横に振り、あることを聞く。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #67",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.067.jpeg",
      "voiceDuration" : 8.419115646258504,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 3.1604308390022675,
      "id" : "99A1507A-89C8-4F87-B83C-2B4F4A95E0FA",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 68",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「彼女が飲んでいるお酒は、今何杯目ですか？」",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #68",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.068.jpeg",
      "voiceDuration" : 3.1604308390022675,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.191950113378685,
      "id" : "6AE646E8-C9BC-4754-8C4E-7240219E82BE",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 69",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕がそう聞くと、その人は、ひっそりと指を立てる。\nその指は3本だった。僕は、それで価格に見当がつく。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #69",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.069.jpeg",
      "voiceDuration" : 8.191950113378685,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 5.788684807256236,
      "id" : "8C9E68D0-9895-4B1E-9E44-24C979AE3DFF",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 70",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そして、部屋から背負ってきたバックから財布を取り出す。\n「代金は、3000円ですよね…？」",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #70",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.070.jpeg",
      "voiceDuration" : 5.788684807256236,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 6.345215419501134,
      "id" : "317CA5B3-2FA9-441A-AF69-0ADB66180BAE",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg",
      "title" : "シーン 71",
      "audioTrack" : "track_voice_soumu",
      "telop" : "すると、その人は驚いた様子をするが、\nハッと気を取り直し、お金を受け取り、笑って見せた。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #71",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image67.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.071.jpeg",
      "voiceDuration" : 6.345215419501134,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
