      "title" : "シーン 14",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕が、そう言うと、相手はこのホテルのロビーにいる従業員で、フランたちがいる屋敷から電話が来て、繋げるかを聞いてきた。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #14",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.014.jpeg",
      "voiceDuration" : 7.9865079365079366,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
