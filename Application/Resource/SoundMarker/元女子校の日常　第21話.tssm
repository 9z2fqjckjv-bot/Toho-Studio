      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/nc307609_レストラン2.jpg",
      "title" : "シーン 5",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕がそう言い、二人の方を向くと、アリスが話す。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #5",
