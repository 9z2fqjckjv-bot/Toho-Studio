      "title" : "シーン 42",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「ええ、そうですけど…、それが何か…？」",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #42",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image60.jpeg",
