      "voiceDuration" : 5.006077097505669,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.341950113378685,
      "id" : "5FB7F48A-2910-45AD-BCE5-C7F977CAC389",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 89",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕はそう言うと、バックからあるものを2つ取り出す。それは、黒色のアイマスクだった。そして、それを一つ彼女につける。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #89",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.089.jpeg",
      "voiceDuration" : 8.341950113378685,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 1.4037414965986394,
      "id" : "ABD09D62-F8E9-4C10-8637-231CEC970D0F",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_アリス・マーガトロイド.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 90",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "telop" : "「ちょっと、何するのよ。」",
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #90",
      "characterName" : "アリス・マーガトロイド",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.090.jpeg",
      "voiceDuration" : 1.4037414965986394,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.458253968253969,
      "id" : "5B92F535-16C8-49E7-9405-7BE70BA15A72",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 91",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「こういう時のために、向こうで買ったんですよ。互いにアイマスクを被れば、僕が浴室の中でアリスさんの体を支えますから…」",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #91",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.091.jpeg",
      "voiceDuration" : 8.458253968253969,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.149546485260771,
      "id" : "D0A1806E-1937-4049-AB4A-E7D6F7B342B4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 92",
      "audioTrack" : "track_voice_soumu",
      "telop" : "「ただ、触覚だけはどうにもならないので、そこは我慢してください。何より怪我なく、お風呂に入れるのが一番ですから。」",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #92",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.092.jpeg",
      "voiceDuration" : 8.149546485260771,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 2.4017233560090703,
      "id" : "43B736FA-C50D-4964-A974-0FF2325CAB8E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 93",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕はそう言いながら、アイマスクを被る。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #93",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.093.jpeg",
      "voiceDuration" : 2.4017233560090703,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.910430839002268,
      "id" : "EF223D50-752B-4441-8522-5BC9F97CD37A",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 94",
      "audioTrack" : "track_voice_soumu",
      "telop" : "僕は、暗闇の中、スッと息を吸い、神経を透き済ますと、触覚だけを頼り、彼女の服を脱がせ、自分自身も服を脱ぐ。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #94",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
      "backgroundName" : "image65.jpeg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.094.jpeg",
      "voiceDuration" : 8.910430839002268,
      "voice2StartTimeOffset" : 0
    },
    {
      "transitionName" : "なし",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "duration" : 8.646303854875283,
      "id" : "FF86E054-8760-4D61-987C-00212FD631E3",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_操夢.wav",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image65.jpeg",
      "title" : "シーン 95",
      "audioTrack" : "track_voice_soumu",
      "telop" : "そして、彼女をそっと抱え上げると、浴室の段差に気をつけながら、中に入っていき、そのまま彼女の入浴を補助するのだった。",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #95",
      "characterName" : "操夢",
      "seStartTimeOffset" : 0,
