      "title" : "シーン 4",
      "audioTrack" : "track_voice_soumu",
      "telop" : "彼女がそう言って、指さしたのは、あるお菓子だった。\n「いいですよ。それで、さとりさんたちはどうします？」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "voiceCharacter" : "操夢",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #4",
      "characterName" : "操夢",
