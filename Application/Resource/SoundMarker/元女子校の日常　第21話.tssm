      "telop" : "「ねぇ、あなたがあの男子校からの転校生って、本当なの？」",
      "voiceCharacter" : "古明地こいし",
      "bgmStartTimeOffset" : 0,
      "slideTitle" : "スライド #41",
      "characterName" : "古明地こいし",
