{
  "scenes" : [
    {
      "telop" : "僕たちは、それから話し合いを進めているうちに、すでに日が暮れ、夜になっていた。ふと時計を見ると、夜の6時過ぎだった。\n東方Project二次創作作品",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav",
      "seVolume" : 1,
      "id" : "CA378C78-68F5-41FF-BD65-4B6B88CD16CD",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 1",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #1",
      "duration" : 9.181065759637187,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.001.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.581065759637188
    },
    {
      "telop" : "「それで、これで遠足のプランはバッチリですか？」\n私は、話の流れで、班長になり、皆にそう尋ねる。\n作成者：zuyasi",
      "characterName" : "アリス・マーガトロイド",
      "voiceCharacter" : "アリス・マーガトロイド",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_アリス・マーガトロイド.wav",
      "seVolume" : 1,
      "id" : "8B8D891D-11E4-40D8-B1E0-3A1BD63F400F",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 2",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #2",
      "duration" : 6.789115646258503,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.002.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.189115646258504
    },
    {
      "telop" : "「僕は、このプランでいいと思います。」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "seVolume" : 1,
      "id" : "B70054E3-D215-4368-99C5-4E6C5FC8A7A0",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 3: 「僕は、このプランでいいと思います。」",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #3",
      "duration" : 3.049546485260771,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.003.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.449546485260771
    },
    {
      "telop" : "「私も、紅夢さんの意見に同感です。」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "characterName" : "古明地さとり",
      "voiceCharacter" : "古明地さとり",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地さとり.wav",
      "seVolume" : 1,
      "id" : "40C9B4AA-F27D-4091-9F25-7CDA82D62951",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 4",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #4",
      "duration" : 2.8521995464852608,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.004.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.2521995464852607
    },
    {
      "telop" : "「私も同じ。」",
      "characterName" : "古明地こいし",
      "voiceCharacter" : "古明地こいし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav",
      "seVolume" : 1,
      "id" : "864A60D2-BE6F-4222-BEE8-7E1310A1BA3F",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 5",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #5",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.005.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.5
    },
    {
      "telop" : "「では、先に失礼しますね…」",
      "characterName" : "アリス・マーガトロイド",
      "voiceCharacter" : "アリス・マーガトロイド",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_アリス・マーガトロイド.wav",
      "seVolume" : 1,
      "id" : "D1DFBAD5-0BA9-4152-B863-E40E6B62EACC",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 6",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #6",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.006.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.7403628117913832
    },
    {
      "telop" : "アリスさんはそういうと、帰って行った。「この教室の戸締り…、僕がするので、二人は帰っていいですよ。」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "seVolume" : 1,
      "id" : "F4D0F884-0EB1-4AC6-B1C8-4EF11CD2B938",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 7",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #7",
      "duration" : 7.487596371882086,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.007.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.887596371882086
    },
    {
      "telop" : "「分かりました…、じゃあお先に失礼します…」",
      "characterName" : "古明地さとり",
      "voiceCharacter" : "古明地さとり",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_古明地さとり.wav",
      "seVolume" : 1,
      "id" : "A493BC47-73CE-40BC-8502-43901D217FD8",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 8",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #8",
      "duration" : 2.77859410430839,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.008.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.17859410430839
    },
    {
      "telop" : "そして、僕は、ただ一人残されたこの部屋で、息を吐く。そして、一度だけ深呼吸を済ますと、戸締りをして、家に帰るのだった。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "seVolume" : 1,
      "id" : "78F44A10-4936-4AA5-9DE2-2C2DA573A97E",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc378788_文化系の部室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 9",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #9",
      "duration" : 10.00281179138322,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.009.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 9.40281179138322
    },
    {
      "telop" : "元女子校の日常",
      "characterName" : "博麗霊夢",
      "seVolume" : 1,
      "id" : "726F39A2-3F1E-4A9E-9713-28A96616B50A",
      "transitionName" : "なし",
      "backgroundName" : "単色背景",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 10: 東方Project二次創作作品　Powerd By zuyasi",
      "slideTitle" : "スライド #10",
      "duration" : 3,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.010.jpeg",
      "voiceStartTimeOffset" : 0
    },
    {
      "telop" : "僕はそれから、家に着くと、誰も家にいないことに気づく。\n「母さんと父さんはどうしたんだろう…。」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "seVolume" : 1,
      "id" : "FA3A3893-88E2-499F-8A5E-14ABE65EBACC",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc235080_家（夜・灯りなし）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 11",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #11",
      "duration" : 6.816938775510204,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.011.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.216938775510204
    },
    {
      "telop" : "僕はそう呟きながら、家の玄関を鍵を使って開ける。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "seVolume" : 1,
      "id" : "C3A5FCEA-93B6-4509-BBFB-33F84EE2B6E4",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc235080_家（夜・灯りなし）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 12",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #12",
      "duration" : 4.262607709750567,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.012.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.6626077097505667
    },
    {
      "telop" : "そして、暗い玄関口に入ると、扉に鍵をかけて、自室に向かう。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav",
      "seVolume" : 1,
      "id" : "E788175A-9277-49E1-8A1B-F339AE98D538",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244644_家の玄関ホール（夜・照明OFF）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 13",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #13",
      "duration" : 5.469115646258503,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.013.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 4.8691156462585035
    },
    {
      "telop" : "僕はそれから、自室に入り、電気をつける。\nそして、荷物を下ろすと、そのままリビングに向かう。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg",
      "id" : "CF24928A-0AC4-4280-A834-869A0FE812FA",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "一人部屋３（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 14",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #14",
      "duration" : 7.375646258503401,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.014.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.775646258503401
    },
    {
      "telop" : "僕が、リビングに来ると、食卓の上に、メモ書きがあった。そこには、帰りが遅いから、一人で夕飯を済ますようにとあった。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "4E9E484E-6BD8-4CF7-A8CA-9C969CE66EEB",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 15",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #15",
      "duration" : 9.423469387755102,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.015.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.823469387755102
    },
    {
      "telop" : "そして、ふと冷蔵庫を開けて、中身を見る。\n中身は、朝見た通り、スカスカになっていた。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/冷蔵庫を開ける.mp3",
      "seVolume" : 0.85,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "5686BED5-B1AD-4B39-8302-4D38D77DBF5F",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 16",
      "seName" : "SE: 冷蔵庫を開ける",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #16",
      "duration" : 7.010430839002267,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.016.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.4104308390022675
    },
    {
      "telop" : "僕は、冷蔵庫の扉を閉めると、上の棚を開ける。\n普段なら常備しているインスタント食品もないようだった。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/冷蔵庫を閉める.mp3",
      "seVolume" : 0.85,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "668E55D6-36B1-4203-B23F-69E462AD53AA",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 17",
      "seName" : "SE: 冷蔵庫を閉める",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #17",
      "duration" : 7.850634920634921,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.017.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 7.250634920634921
    },
    {
      "telop" : "僕は、上の棚を閉めると、どうするか悩む。\nすると、インターホンが鳴る。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアチャイム2.mp3",
      "seVolume" : 0.85,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "9CC61E3A-B586-4F7C-8650-4ABECC89AAB0",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 18",
      "seName" : "SE: ドアチャイム2",
      "seStartTimeOffset" : 3.49,
      "slideTitle" : "スライド #18",
      "duration" : 5.847369614512472,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.018.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 5.247369614512472
    },
    {
      "telop" : "僕は、玄関の電気をつけて、扉を開ける。すると、刀を携えた女性が、入ってくる。「あの、どんな用でしょうか？」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "seVolume" : 1,
      "id" : "8148C8FA-3DBE-4127-B4F9-B91B3510F879",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 19",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #19",
      "duration" : 9.48,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.019.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.88
    },
    {
      "telop" : "すると、彼女はある手帳を取り出し、見せる。\nそこには、警察の紋章があった。「えっと…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav",
      "seVolume" : 1,
      "id" : "43E15818-074E-4CC6-9464-217425BAC54F",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 20",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #20",
      "duration" : 7.232154195011337,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.020.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.632154195011338
    },
    {
      "telop" : "「私は、武蔵警察署の魂魄妖夢と申します。\n実は、急用でお伺いしたいことがございまして…」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "8631F0CD-1378-4D29-BABE-B4F0B78A3BCE",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 21",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #21",
      "duration" : 6.4681179138322,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.021.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 5.8681179138322
    },
    {
      "telop" : "彼女はそう言いながら、ある写真を見せる。\nそれは…、母の友人である魔理沙さんの写真だった。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav",
      "seVolume" : 1,
      "id" : "D5DF9E44-F723-478E-9BDD-00373563919F",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 22",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #22",
      "duration" : 6.80063492063492,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.022.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.20063492063492
    },
    {
      "telop" : "「この人物をご存知ですか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "B73C1C1B-030B-49F7-8B38-605B447255FC",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 23",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #23",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.023.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.5535374149659864
    },
    {
      "telop" : "「ええ、母の友人ですが…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "seVolume" : 1,
      "id" : "C103F7DC-8AD0-415C-AEC6-BF311648629D",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 24",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #24",
      "duration" : 2.5604308390022674,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.024.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.9604308390022676
    },
    {
      "telop" : "「あなたの母親の名前を伺ってもよろしいでしょうか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "6FDF9F4C-5977-43D8-997F-ADBF37E9AE7E",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 25",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #25",
      "duration" : 3.3016553287981862,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.025.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.701655328798186
    },
    {
      "telop" : "「博麗霊夢です…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav",
      "seVolume" : 1,
      "id" : "40A6EF63-7D08-4AD1-AD17-39D0E6DE901D",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 26",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #26",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.026.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.5
    },
    {
      "telop" : "「そうですか、今朝、あなたが母親の様子を\n見ていて気がかりなことはありましたか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "41FCE441-7DEA-4762-AEAE-99B56476D12A",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 27",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #27",
      "duration" : 5.0515419501133785,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.027.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 4.451541950113379
    },
    {
      "telop" : "僕は、彼女にそう言われ、今朝のことを思い出す…",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav",
      "seVolume" : 1,
      "id" : "27315391-EB1B-428C-8639-B780F370FF06",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 28",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #28",
      "duration" : 3.8952154195011337,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.028.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.2952154195011336
    },
    {
      "telop" : "「どうしたの、母さん、そんな顔して。」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "id" : "538C4B32-2BAE-4844-935E-19F33E27E099",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 29",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #29",
      "duration" : 3.30390022675737,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.029.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.7039002267573697
    },
    {
      "telop" : "「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_博麗霊夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "id" : "AA9C9280-2722-4414-A0E0-70A3D25D9BC9",
      "audioTrack" : "track_voice_reimu",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 30",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #30",
      "duration" : 9.443242630385488,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.030.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.843242630385488
    },
    {
      "telop" : "「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "id" : "8E0D1C4C-1C2D-4417-9ED7-0EC747A065C2",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 31",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #31",
      "duration" : 8.695215419501134,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.031.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.095215419501134
    },
    {
      "telop" : "「それじゃあ、行ってくるわ…」",
      "characterName" : "博麗霊夢",
      "voiceCharacter" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_博麗霊夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "id" : "5CFE3DA2-FD70-490D-B6DF-8280F47C2052",
      "audioTrack" : "track_voice_reimu",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 32",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #32",
      "duration" : 2.8344897959183672,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.032.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.234489795918367
    },
    {
      "telop" : "「今朝、テレビで母が、友人が赤信号を横断していたというニュースを見ていて、不安だから見てくると言ってました…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "seVolume" : 1,
      "id" : "E0CC1F9E-7821-41B7-8F82-816B32064CE3",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 33",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #33",
      "duration" : 7.9778231292517,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.033.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 7.3778231292517
    },
    {
      "telop" : "「ほう…そうでしたか。それ以外には何かありましたか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "97037F1E-4B14-4B82-B965-F835697E95D6",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 34",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #34",
      "duration" : 3.7522902494331065,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.034.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.1522902494331064
    },
    {
      "telop" : "「あとは、帰りが遅くなると書かれたメモ書きくらいしか…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "seVolume" : 1,
      "id" : "75F1D246-D542-49D8-902F-0425AAA74766",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 35",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #35",
      "duration" : 4.134331065759637,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.035.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.534331065759637
    },
    {
      "telop" : "「そうですか。それで、あなたの父親はどんな様子でしたか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "97424590-7614-4EFA-B123-6ECA72B569DA",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 36",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #36",
      "duration" : 4.037482993197279,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.036.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.437482993197279
    },
    {
      "telop" : "「父は、僕が起きた時には、すでにいませんでした。」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "seVolume" : 1,
      "id" : "626BFCCA-B12A-40A5-B07D-B9E063A35DBC",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 37",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #37",
      "duration" : 4.164761904761905,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.037.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.564761904761905
    },
    {
      "telop" : "「そうですか…。承知しました。\nそれで、何かご要望はありますか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "C2060026-BB04-4371-85DE-E6FD5037F63B",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 38",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #38",
      "duration" : 4.633945578231292,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.038.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 4.033945578231292
    },
    {
      "telop" : "「要望ですか…？」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "seVolume" : 1,
      "id" : "0DD04D29-8A7B-4E1A-9768-451B33A959C6",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 39",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #39",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.039.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.5
    },
    {
      "telop" : "「ええ、私について来てくださるのなら、署にいるあなたの母親と話すこともできますが？どうしますか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "029146C1-F904-4CCC-9CED-75EE0EF76DF2",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 40",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #40",
      "duration" : 6.345827664399093,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.040.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 5.745827664399093
    },
    {
      "telop" : "「いえ…大丈夫です…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "seVolume" : 1,
      "id" : "D5A2E1A1-F953-46F7-9887-D0E627493F9F",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 41",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #41",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.041.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.556077097505669
    },
    {
      "telop" : "「それと、最後に一つだけ、お伺いしてもよろしいですか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "5471995A-1367-4817-B58F-74751D890064",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 42",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #42",
      "duration" : 3.8662358276643993,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.042.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.2662358276643992
    },
    {
      "telop" : "「どんなことですか？」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "seVolume" : 1,
      "id" : "A5ED446D-2401-42C8-8DBF-298F0879F540",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 43",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #43",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.043.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.5
    },
    {
      "telop" : "「あなたは、魔理沙さんのここ\n最近の様子について知ってますか？」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "3D9EB242-7C69-41F8-A4C2-65E2CBC7D6A6",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 44",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #44",
      "duration" : 3.9051927437641725,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.044.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.3051927437641724
    },
    {
      "telop" : "「えっと…、特にはないです…」",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav",
      "seVolume" : 1,
      "id" : "EC14CA56-1532-4AD8-98F9-492D11EB78AD",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 45",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #45",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.045.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.8615192743764173
    },
    {
      "telop" : "「承知しました。突如の訪問にご対応いただきありがとうございました。これにて、私は失礼致します。」",
      "characterName" : "魂魄妖夢",
      "voiceCharacter" : "魂魄妖夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_魂魄妖夢.wav",
      "seVolume" : 1,
      "id" : "2EF1C30F-E3E3-45FE-AC78-FF74441ACD1E",
      "audioTrack" : "track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 46",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #46",
      "duration" : 6.759160997732426,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.046.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.159160997732426
    },
    {
      "telop" : "彼女はそういうと、去っていった。\n僕は、ひとまず、リビングに戻る。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav",
      "seVolume" : 1,
      "id" : "BA3983B0-5E09-4861-A926-4F616CCC5C16",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "nc244643_家の玄関ホール（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 47",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #47",
      "duration" : 5.52673469387755,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.047.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 4.926734693877551
    },
    {
      "telop" : "そして、食卓に座るとテレビをつける。\n僕は、その映像を見ているうちに、全身に痛みが走る。",
      "characterName" : "操夢",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "B01EA0FE-C08C-4DD3-8B79-FC00EDB29EFF",
      "audioTrack" : "track_voice_soumu",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 48",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #48",
      "duration" : 7.488684807256235,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.048.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.888684807256236
    },
    {
      "telop" : "そこには、ある女性が、街中にビームを撃ちまくる映像と、彼女との戦いに負けたのか、警察署で休む母が映っていた。",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_ナレーション.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "DE59CF4A-748B-4B62-AAFC-F5B4817891BD",
      "audioTrack" : "track_voice__E5E7",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 49",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #49",
      "duration" : 9.093038548752833,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.049.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.493038548752834
    },
    {
      "telop" : "今、テレビで流れている映像を見ると、父とその女性が戦っている様子が流れていたが、父はビームを避けているだけだった。",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_ナレーション.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "CBC849F4-CDAE-4CE9-96CA-067CF057BD28",
      "audioTrack" : "track_voice__E5E7",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 50",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #50",
      "duration" : 8.62673469387755,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.050.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.02673469387755
    },
    {
      "telop" : "きっと彼が、この映像をしっかりと目に焼き付ければ、冷静に考えて、母が映っていた警察署に向かうだろう。",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_ナレーション.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "0DE7EC94-6B8D-4550-8EAD-EBB2F54A8AE1",
      "audioTrack" : "track_voice__E5E7",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 51",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #51",
      "duration" : 7.890861678004534,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.051.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 7.290861678004535
    },
    {
      "telop" : "「私は、どうすればいいのかな…」っと、そう呟きながら、ある覚悟を決め、準備を済ませると、その場所に向かった。",
      "characterName" : "ナレーション",
      "voiceCharacter" : "ナレーション",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_ナレーション.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg",
      "id" : "B6343656-C93F-48E8-B81A-AD9E52420B44",
      "audioTrack" : "track_voice__E5E7",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 52",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #52",
      "duration" : 8.721292517006802,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.052.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.121292517006802
    },
    {
      "telop" : "その頃、ある場所では…",
      "characterName" : "博麗霊夢",
      "seVolume" : 1,
      "id" : "B2FF3481-CCA0-469B-B20E-CBFD40093901",
      "transitionName" : "なし",
      "backgroundName" : "単色背景",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 53: その頃、ある場所では…",
      "slideTitle" : "スライド #53",
      "duration" : 3,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.053.jpeg",
      "voiceStartTimeOffset" : 0
    },
    {
      "telop" : "私は、ふと部屋にある小さなテレビを見ていると、とある街中の生中継映像が流れた。私は、思わず、その映像に目を見張る。",
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301379_一人部屋２（夜・照明ON）.jpg",
      "id" : "B617D141-3FA1-4728-BD58-C3356DDA4478",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc301379_一人部屋２（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 54",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #54",
      "duration" : 11.299478458049887,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.054.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 10.699478458049887
    },
    {
      "telop" : "その映像は、ビームを撃ち続ける女性と、それを避ける男性の様子が映されていた。そして、私は、ふと画面を注視する。",
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_フランドール・スカーレット.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301379_一人部屋２（夜・照明ON）.jpg",
      "id" : "BFD2540E-0B21-4A31-B2E0-FBBD3FA0E4C4",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc301379_一人部屋２（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 55",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #55",
      "duration" : 10.464489795918366,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.055.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 9.864489795918367
    },
    {
      "telop" : "すると、一瞬だけ、どこかの警察署内で休んでいる巫女が映っていた。私は、そこでハッとし、お姉様の元に向かう。",
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_フランドール・スカーレット.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301379_一人部屋２（夜・照明ON）.jpg",
      "id" : "54346E8C-C0AE-4FAF-B572-8FA9D74C01C0",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc301379_一人部屋２（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 56",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #56",
      "duration" : 10.499478458049886,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.056.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 9.899478458049886
    },
    {
      "telop" : "「お姉様！」",
      "characterName" : "フランドール・スカーレット",
      "voiceCharacter" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_フランドール・スカーレット.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "id" : "461BF544-DCDA-4E48-A68A-5C0EA175BE12",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 57",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #57",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.057.jpeg",
      "voiceStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png",
      "voiceDuration" : 1.5
    },
    {
      "telop" : "「どうしたのよ、フラン。そんな驚いた表情をして。」\n私は、そう妹に尋ねる。",
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_レミリア・スカーレット.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "id" : "F8CAC76D-76FA-4AFF-9EBE-45C12092445A",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 58",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #58",
      "duration" : 6.560907029478457,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.058.jpeg",
      "voiceStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png",
      "voiceDuration" : 5.960907029478458
    },
    {
      "telop" : "すると、彼女は衝撃的な内容を語りだす。\n私は、その内容を聞くと、ある人物に電話をかける。",
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_レミリア・スカーレット.wav",
      "seVolume" : 1,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "id" : "03C254A4-59F5-4765-91B5-73A939F89060",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 59",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #59",
      "duration" : 7.646326530612244,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.059.jpeg",
      "voiceStartTimeOffset" : 0,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png",
      "voiceDuration" : 7.0463265306122445
    },
    {
      "telop" : "私は、職員室で作業をしていると、突如として電話が鳴る。\n私は、鳴り響く電話の受話器を取るとある声が聞こえた。",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_十六夜咲夜.wav",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/電話の着信音.mp3",
      "seVolume" : 0.85,
      "id" : "BEFBCAEF-BDDD-4177-B47A-71183B5DDC75",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 60",
      "seName" : "SE: 電話の着信音",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #60",
      "duration" : 7.737482993197278,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.060.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 7.1374829931972785
    },
    {
      "telop" : "「お嬢様、その慌てた口調、何かあったんですか？」\n私は、その電話の声…レミリアに尋ねる。",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_十六夜咲夜.wav",
      "seVolume" : 1,
      "id" : "54C8C4F4-2C42-4B2E-ADD2-0E91D0FF6B87",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 61",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #61",
      "duration" : 6.70469387755102,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.061.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 6.10469387755102
    },
    {
      "telop" : "「咲夜、今すぐテレビをつけなさい。」",
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_レミリア・スカーレット.wav",
      "seVolume" : 1,
      "id" : "33CA1EFA-5DED-4C6F-84D9-2AAA6F51A32A",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 62",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #62",
      "duration" : 2.9171655328798187,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.062.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.3171655328798186
    },
    {
      "telop" : "私は、お嬢様にそう言われ、テレビをつける。すると、そこには衝撃的な映像が流れていた。「これは、どういうことですか？」",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_十六夜咲夜.wav",
      "seVolume" : 1,
      "id" : "0E0CD5B4-990C-4DC4-B919-9690A5250E91",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 63",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #63",
      "duration" : 8.219886621315192,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.063.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 7.619886621315192
    },
    {
      "telop" : "「説明している時間は、ないわ。とにかく、その場所に、誰かを急行させて、騒ぎを鎮静化させなさい。そうじゃないと…」",
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_レミリア・スカーレット.wav",
      "seVolume" : 1,
      "id" : "4675B8A0-E865-41CE-AF91-77F5EC28C76C",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 64",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #64",
      "duration" : 9.121315192743763,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.064.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 8.521315192743764
    },
    {
      "telop" : "私は、お嬢様からの命令を聞き、\n電話を終えると、ある部屋に電話をかける。",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_十六夜咲夜.wav",
      "seVolume" : 1,
      "id" : "CAE7210C-4E6D-4785-9DD7-A62A763BF3ED",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 65",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #65",
      "duration" : 5.0396825396825395,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.065.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 4.43968253968254
    },
    {
      "telop" : "「もしもし、こんな時間に電話をかけて、どうしたんですか？」",
      "characterName" : "美鈴",
      "voiceCharacter" : "美鈴",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_美鈴.wav",
      "seVolume" : 1,
      "id" : "4AFC239B-0FC8-4CC3-8381-954F86D0113C",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 66",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #66",
      "duration" : 3.187074829931973,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.066.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 2.587074829931973
    },
    {
      "telop" : "私は、そう聞く彼女に、お嬢様からの電話の内容を伝える。",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_十六夜咲夜.wav",
      "seVolume" : 1,
      "id" : "23DF6341-CF7F-4A4D-BD07-6F2F2C15EC6B",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 67",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #67",
      "duration" : 4.324285714285714,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.067.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.724285714285714
    },
    {
      "telop" : "「そうですか…、分かりました。」",
      "characterName" : "美鈴",
      "voiceCharacter" : "美鈴",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_美鈴.wav",
      "seVolume" : 1,
      "id" : "8EF056AC-BE9D-47D3-A7B1-1B99468AAB52",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 68",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #68",
      "duration" : 2.5,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.068.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 1.5
    },
    {
      "telop" : "私は、電話が切れると、お嬢様の家電にかける。",
      "characterName" : "十六夜咲夜",
      "voiceCharacter" : "十六夜咲夜",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_十六夜咲夜.wav",
      "seVolume" : 1,
      "id" : "7D0E3E39-DFF1-4C00-A311-856912744832",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "transitionName" : "なし",
      "animationName" : "なし",
      "title" : "シーン 69",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #69",
      "duration" : 3.6638775510204082,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.069.jpeg",
      "voiceStartTimeOffset" : 0,
      "voiceDuration" : 3.063877551020408
    },
    {
      "telop" : "私は、咲夜との通話を終えると、フランにいう。\n「フラン、今すぐに彼が今どこにいるか、探して来なさい。」",
      "characterName" : "レミリア・スカーレット",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_レミリア・スカーレット.wav",
