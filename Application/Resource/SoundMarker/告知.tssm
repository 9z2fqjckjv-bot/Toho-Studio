    {
      "fadeOutDuration" : 0,
      "voiceSymbol" : "ゲ'ームノ\/ゴ'ールニワ、ケッコ'ン_シキニ\/シヨ'ート\/オモイマ'_ス。ケッコ'ン_シキノ\/シ'ーンガ\/キ'タラ、エンドロ'ールオ\/ナガ'_シ、ゲームクリ'アニ\/ナリマ'_ス。",
      "sceneIndex" : 4,
