    {
      "fadeOutDuration" : 0,
      "voiceSymbol" : "ゲ'ームノ\/ナマエワ\/トーホー\/プロジェ_クトレ'ンアイ\/シュミレ'ーターデ_ス。デ'スガ、カショーノ+タメ'、ジッサイニ\/メーショーオ\/ゲ'ームノ\/リヨ'ーシャサンカラ,コーボオ\/シヨ'ート\/オモイマ'_ス。",
      "sceneIndex" : 3,
