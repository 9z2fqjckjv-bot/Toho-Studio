        0.9998352,
        0.8244018,
        0.9081115,
        1,
        0.72561646
      ],
      "voiceTriggerOffset" : 0,
      "text" : "こんな感じで、物語が進んでいき、赤の他人から見事、結婚式まで進め、ヒロインと結婚できればゲームクリアです。これで、このゲームの説明は終わりです。最後に一つだけ注意点をお伝えします。",
      "pitch" : 115,
      "colorHex" : "#3498DB",
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav",
      "speed" : 100,
      "id" : "7B016F45-D839-442F-BAAB-A68D3ABD24E5",
      "trackId" : "track_voice_soumu",
      "playbackRate" : 1,
      "isLooping" : false,
      "voiceType" : "中性",
