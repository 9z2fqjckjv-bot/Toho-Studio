    {
      "voiceSymbol" : "カ'ノジョワ\/ソ'ー\/イウト、ソノママ'\/ビョー_シツオ\/サ'ッタ。ヨ'ク\/ヨ'_ク\/カンガエ'レバ、ココワ\/ガッコーノ\/フゾクビョ'ーインダッタ。",
      "startTime" : 104.30802721088435,
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "id" : "CAE2A36A-BDAC-43C1-AE07-A075AB823F8C",
      "voiceType" : "中性",
      "pan" : 0,
      "character" : "操夢",
      "trackId" : "track_voice_soumu",
      "colorHex" : "#3498DB",
      "isLooping" : false,
      "text" : "彼女はそういうと、そのまま病室を去った。よくよく考えれば、ここは学校の附属病院だった。",
      "sceneIndex" : 17,
      "duration" : 6.690861678004535,
