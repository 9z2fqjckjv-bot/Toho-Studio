    },
    {
      "id" : "12E466B2-46EB-4B5A-9EA7-2F2647BCD180",
      "title" : "シーン 15",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "transitionName" : "なし",
      "telop" : "「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #15",
      "animationName" : "なし",
      "duration" : 6.95172335600907,
      "voiceDuration" : 6.35172335600907,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "C0A3B613-17E8-47A8-A2CE-65DA7D394DB9",
      "title" : "シーン 16",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #16",
      "animationName" : "なし",
      "duration" : 10.784489795918367,
      "voiceDuration" : 10.184489795918367,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "698BCB05-CD9E-42AB-BB1E-F0C5F7DC831B",
      "title" : "シーン 17",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "transitionName" : "なし",
      "telop" : "彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #17",
      "animationName" : "なし",
      "duration" : 7.290861678004535,
      "voiceDuration" : 6.690861678004535,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "73AF9F6A-D0D2-4467-ABB5-B68A19816BA1",
      "title" : "シーン 18",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "transitionName" : "なし",
      "telop" : "僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #18",
      "animationName" : "なし",
      "duration" : 4.921292517006802,
      "voiceDuration" : 4.321292517006802,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "animationName" : "なし",
      "duration" : 3.5,
      "title" : "シーン 19",
      "slideTitle" : "スライド #19",
      "id" : "45DB02C5-157C-4575-B902-48E8D27E0F30",
      "telop" : "附属病院のある診察室では…",
      "transitionName" : "なし"
    },
    {
      "id" : "D6569885-94B3-49AD-8302-3A3CE9649BE6",
      "title" : "シーン 20",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_永琳.wav",
      "transitionName" : "なし",
      "telop" : "私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #20",
      "animationName" : "なし",
      "duration" : 6.2569387755102035,
      "voiceDuration" : 5.656938775510204,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "742B1995-EC2C-42CC-8FB0-163106F190E2",
      "title" : "シーン 21",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_永琳.wav",
      "transitionName" : "なし",
      "telop" : "患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #21",
      "animationName" : "なし",
      "duration" : 11.109183673469387,
      "voiceDuration" : 10.509183673469387,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "AC093282-DBEF-4ED7-A2E6-470208ED8F49",
      "title" : "シーン 22",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_永琳.wav",
      "transitionName" : "なし",
      "telop" : "私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #22",
      "animationName" : "なし",
      "duration" : 8.810839002267574,
      "voiceDuration" : 8.210839002267575,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "90D03D95-872F-4139-AC4D-DAE135020F93",
      "title" : "シーン 23",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav",
      "transitionName" : "なし",
      "telop" : "そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #23",
      "animationName" : "なし",
      "duration" : 10.502108843537414,
      "voiceDuration" : 9.902108843537414,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "A13AB83D-82F5-4D93-9867-FA9772289DB9",
      "title" : "シーン 24",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_永琳.wav",
      "transitionName" : "なし",
      "telop" : "彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #24",
      "animationName" : "なし",
      "duration" : 9.971814058956916,
      "voiceDuration" : 9.371814058956916,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "C454188A-06AF-4C37-9945-A9357E052EB5",
      "title" : "シーン 25",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav",
      "seName" : "SE: 木のドアをノック1",
      "transitionName" : "なし",
      "telop" : "すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "slideTitle" : "スライド #25",
      "animationName" : "なし",
      "duration" : 8.814489795918368,
      "voiceDuration" : 8.214489795918368,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "6723E68E-6B73-4FFE-983B-896FC3777C4F",
      "title" : "シーン 26",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_射命丸文.wav",
      "transitionName" : "なし",
      "telop" : "「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #26",
      "animationName" : "なし",
      "duration" : 7.7115873015873015,
      "voiceDuration" : 7.111587301587302,
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文"
    },
    {
      "id" : "6CF07AC8-BD86-4466-915C-3AF2AC551D6B",
      "title" : "シーン 27",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_射命丸文.wav",
      "transitionName" : "なし",
      "telop" : "「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #27",
      "animationName" : "なし",
      "duration" : 9.22358276643991,
      "voiceDuration" : 8.62358276643991,
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文"
    },
    {
      "id" : "B9EC3CB0-4582-438A-B560-DB4B405D51E6",
      "title" : "シーン 28",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_射命丸文.wav",
      "transitionName" : "なし",
      "telop" : "「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #28",
      "animationName" : "なし",
      "duration" : 8.120181405895691,
      "voiceDuration" : 7.520181405895691,
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文"
    },
    {
      "id" : "B56BCFB0-CF02-4953-BCC6-884DD3C2CA96",
      "title" : "シーン 29",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_射命丸文.wav",
      "transitionName" : "なし",
      "telop" : "「それと、息子さんの言ってたことは全て事実だそうですよ。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #29",
      "animationName" : "なし",
      "duration" : 4.201587301587302,
      "voiceDuration" : 3.6015873015873017,
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文"
    },
    {
      "id" : "E2D23C8C-A3A5-4757-BDA4-40895623DF52",
      "title" : "シーン 30",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_永琳.wav",
      "transitionName" : "なし",
      "telop" : "「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #30",
      "animationName" : "なし",
      "duration" : 8.850113378684807,
      "voiceDuration" : 8.250113378684807,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "74E81DD3-1134-40B9-BEDE-9141F07D6BD2",
      "title" : "シーン 31",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_射命丸文.wav",
      "transitionName" : "なし",
      "telop" : "「代金、確かにいただきました。それでは、またのご利用を。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #31",
      "animationName" : "なし",
      "duration" : 4.705578231292517,
      "voiceDuration" : 4.105578231292517,
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文"
    },
    {
      "id" : "195AAE50-2886-42FB-911E-8A130C6FB7A0",
      "title" : "シーン 32",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_永琳.wav",
      "transitionName" : "なし",
      "telop" : "彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #32",
      "animationName" : "なし",
      "duration" : 7.687596371882086,
      "voiceDuration" : 7.0875963718820865,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "id" : "2179F14A-77C0-473D-B591-F4D6B2450C70",
      "title" : "シーン 33",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav",
      "transitionName" : "なし",
      "telop" : "私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "永琳",
      "slideTitle" : "スライド #33",
      "animationName" : "なし",
      "duration" : 8.960249433106576,
      "voiceDuration" : 8.360249433106576,
      "audioTrack" : "track_voice_%E6%B0%B8%E7%90%B3",
      "voiceCharacter" : "永琳"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "animationName" : "なし",
      "duration" : 3.5,
      "title" : "シーン 34",
      "slideTitle" : "スライド #34",
      "id" : "95F45783-0F19-4F03-AD95-0F408B41F60B",
      "telop" : "彼に視点が戻り…",
      "transitionName" : "なし"
    },
    {
      "id" : "9BCFEFCE-C6B2-4D41-83A0-896B41B36E93",
      "title" : "シーン 35",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "transitionName" : "なし",
      "telop" : "僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #35",
      "animationName" : "なし",
      "duration" : 9.885419501133786,
      "voiceDuration" : 9.285419501133786,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "CB339773-68D3-4660-8F0F-00C20DBE9FC9",
      "title" : "シーン 36",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav",
      "transitionName" : "なし",
      "telop" : "だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #36",
      "animationName" : "なし",
      "duration" : 8.966938775510204,
      "voiceDuration" : 8.366938775510205,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "844F6711-79C3-4632-899C-7EA4262FF531",
      "title" : "シーン 37",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "transitionName" : "なし",
      "telop" : "だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #37",
      "animationName" : "なし",
      "duration" : 8.861519274376416,
      "voiceDuration" : 8.261519274376417,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "FCC522AA-CA52-4B86-84BF-41D59D9C6B16",
      "title" : "シーン 38",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "transitionName" : "なし",
      "telop" : "一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #38",
      "animationName" : "なし",
      "duration" : 9.297369614512471,
      "voiceDuration" : 8.697369614512471,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "6867250A-2B3B-456C-A4A6-096937A2A084",
      "title" : "シーン 39",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "transitionName" : "なし",
      "telop" : "だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #39",
      "animationName" : "なし",
      "duration" : 9.125646258503401,
      "voiceDuration" : 8.525646258503402,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "78A16FEB-ADEE-4C79-98C6-36B8A18CD713",
      "title" : "シーン 40",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "transitionName" : "なし",
      "telop" : "そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #40",
      "animationName" : "なし",
      "duration" : 8.45607709750567,
      "voiceDuration" : 7.856077097505669,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "922C0931-9A67-4B9C-833E-89777EEE7D0F",
      "title" : "シーン 41",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "transitionName" : "なし",
      "telop" : "そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #41",
      "animationName" : "なし",
      "duration" : 6.840861678004535,
      "voiceDuration" : 6.240861678004535,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "70B98B88-EADE-4F33-BFAC-AD71A0A33CE3",
      "title" : "シーン 42",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
      "transitionName" : "なし",
      "telop" : "そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #42",
      "animationName" : "なし",
      "duration" : 9.403900226757369,
      "voiceDuration" : 8.803900226757369,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "B49ECA6F-A14D-4D0B-AE78-879563F35FFB",
      "title" : "シーン 43",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "transitionName" : "なし",
      "telop" : "僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #43",
      "animationName" : "なし",
      "duration" : 9.20172335600907,
      "voiceDuration" : 8.601723356009071,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "3CD220AF-C0FA-4E4D-8249-9BA7ABE84811",
      "title" : "シーン 44",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav",
      "transitionName" : "なし",
      "telop" : "そう、それは…",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "操夢",
      "slideTitle" : "スライド #44",
      "animationName" : "なし",
      "duration" : 3.5,
      "voiceDuration" : 1.5,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "F47C90E1-7ACD-4A9E-A4B3-BD28F8097207",
      "title" : "シーン 45",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「よかったわ、目が覚めたようで。」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #45",
      "animationName" : "なし",
      "duration" : 3.5,
      "voiceDuration" : 2.481995464852608,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "EFBCDAD9-6BC9-4C14-9E9A-03515237A413",
      "title" : "シーン 46",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「母さん…」\n僕は、そう彼女に返す。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #46",
      "animationName" : "なし",
      "duration" : 3.786984126984127,
      "voiceDuration" : 3.186984126984127,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "FDF096E3-D77A-457F-BD3C-DCAB101F410F",
      "title" : "シーン 47",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「あんたが、呻いてるから、私が何度も声かけたのよ…、\n私に心配かけさせないでちょうだい…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #47",
      "animationName" : "なし",
      "duration" : 7.901995464852607,
      "voiceDuration" : 7.301995464852608,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "518D068B-841F-4393-B48F-561B68519A68",
      "title" : "シーン 48",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav",
      "transitionName" : "なし",
      "telop" : "「ご…ごめんなさい…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #48",
      "animationName" : "なし",
      "duration" : 3.5,
      "voiceDuration" : 1.5,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "87FDC6C6-5F5E-41BF-93F2-CF29D7FE5629",
      "title" : "シーン 49",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「いいわよ、謝らなくて、とりあえず、\n今晩はゆっくりと寝て、疲労回復に努めなさいね…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #49",
      "animationName" : "なし",
      "duration" : 7.739478458049886,
      "voiceDuration" : 7.1394784580498865,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "02F73AA1-79E9-4962-9558-FE63FFA8E1D9",
      "title" : "シーン 50",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「これから私は家に帰るから、しっかりするのよ…」",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #50",
      "animationName" : "なし",
      "duration" : 4.354489795918367,
      "voiceDuration" : 3.754489795918367,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "E9D463D1-86DF-44DB-91B2-325276831E65",
      "title" : "シーン 51",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav",
      "transitionName" : "なし",
      "telop" : "彼女は、そういうと、涙を拭いながら、病室を出ていった。\n僕は、先ほどの悪夢で疲れ込んだのか、そのまま眠りに落ちた。",
      "backgroundName" : "nc256899_病室-夜-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #51",
      "animationName" : "なし",
      "duration" : 9.50281179138322,
      "voiceDuration" : 8.90281179138322,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "博麗霊夢",
      "animationName" : "なし",
      "duration" : 3.5,
      "title" : "シーン 52",
      "slideTitle" : "スライド #52",
      "id" : "E60A5858-38D3-4C60-BD1F-BBF33D9B48C6",
      "telop" : "霊夢が家に帰ると…",
      "transitionName" : "なし"
    },
    {
      "id" : "C847876B-98B4-4044-8A3A-980DE4A4C081",
      "title" : "シーン 53",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "私が家に帰ってくると、すでに夫がリビングにいた。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #53",
      "animationName" : "なし",
      "duration" : 4.631995464852607,
      "voiceDuration" : 4.031995464852607,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "CB980CE9-E6B0-43C0-A704-FA644302CE6C",
      "title" : "シーン 54",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「霊夢、お前その顔どうした？」\n私は、彼女が泣いた後の表情をしていたのでそう問いかける。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #54",
      "animationName" : "なし",
      "duration" : 6.843333333333333,
      "voiceDuration" : 6.243333333333333,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "AE29F744-2E2E-4647-8026-9A80F709E193",
      "title" : "シーン 55",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「そんなことどうだっていいわ、それより、夕飯は食べたの？」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #55",
      "animationName" : "なし",
      "duration" : 4.964489795918367,
      "voiceDuration" : 4.3644897959183675,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "0BBC84F4-CE26-4218-9CE6-15BA0A942ABB",
      "title" : "シーン 56",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #56",
      "animationName" : "なし",
      "duration" : 3.86,
      "voiceDuration" : 3.26,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "D0DECDD9-0AAD-4D82-BF43-C66D630FF310",
      "title" : "シーン 57",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #57",
      "animationName" : "なし",
      "duration" : 7.335736961451246,
      "voiceDuration" : 6.735736961451247,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "博麗霊夢",
      "animationName" : "なし",
      "duration" : 3.5,
      "title" : "シーン 58",
      "slideTitle" : "スライド #58",
      "id" : "CC1166E5-58E8-4E28-AB9F-1F0BC2D3DC27",
      "telop" : "霊夢がお風呂を澄ますと…",
      "transitionName" : "なし"
    },
    {
      "id" : "4F4F04AB-A794-4587-AE20-067FF752B3F3",
      "title" : "シーン 59",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "私がお風呂から戻ってくると、彼はビール缶をあけ、ため息をついていた。「何か現場仕事に不満でもあるの？」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #59",
      "animationName" : "なし",
      "duration" : 9.024489795918367,
      "voiceDuration" : 8.424489795918367,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "5AF5D5EC-FB87-4BE8-869C-AA6F4E1E26AB",
      "title" : "シーン 60",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「今日は、例の紅魔建設からの依頼だったんだけど…」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #60",
      "animationName" : "なし",
      "duration" : 3.905827664399093,
      "voiceDuration" : 3.305827664399093,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "543ADA5C-40AD-4194-B775-6D6BEAB52BB6",
      "title" : "シーン 61",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "彼はそういうと、その話を始める。特殊な力で一瞬で建造物を破壊できる女性がいる一族経営の館の解体工事中の出来事だった。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #61",
      "animationName" : "なし",
      "duration" : 12.114739229024943,
      "voiceDuration" : 11.514739229024944,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "9FBF584F-8B86-476F-9E32-1B29A97D65E5",
      "title" : "シーン 62",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #62",
      "animationName" : "なし",
      "duration" : 7.974580498866213,
      "voiceDuration" : 7.374580498866213,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "C36F28A8-A262-48A0-9AEB-6942798D0B49",
      "title" : "シーン 63",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #63",
      "animationName" : "なし",
      "duration" : 7.396439909297052,
      "voiceDuration" : 6.796439909297052,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "A322CF4F-C09D-4228-8761-50A3240B2F79",
      "title" : "シーン 64",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #64",
      "animationName" : "なし",
      "duration" : 7.626666666666666,
      "voiceDuration" : 7.026666666666666,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "41748E95-5FD0-4BEC-B6BB-D51328229B46",
      "title" : "シーン 65",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_妹紅.wav",
      "transitionName" : "なし",
      "telop" : "「だが、そんなことよりも、今日もこうして、霊夢のところに帰って来れて、俺は幸せ者だぜ。」私はそう笑みを浮かべる。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "妹紅",
      "slideTitle" : "スライド #65",
      "animationName" : "なし",
      "duration" : 8.468321995464853,
      "voiceDuration" : 7.868321995464853,
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅"
    },
    {
      "id" : "E8EB84B0-6B12-4CD2-9C30-D871A831850A",
      "title" : "シーン 66",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「そうね…」私は、夫のその発言こう返すことしかできなかった。そして、なんだか距離を感じてしまったのだった。",
      "backgroundName" : "リビング（夜・照明ON・カーテン閉）.jpeg",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #66",
      "animationName" : "なし",
      "duration" : 9.841995464852607,
      "voiceDuration" : 9.241995464852607,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    }
  ]
