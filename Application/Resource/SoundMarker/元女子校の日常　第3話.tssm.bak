    {
      "voiceSymbol" : "ワタシノ\/マゴ'ニ\/アタル\/カ'レワ、ツージョーナ'ラ\/カタ'ホーニ\/カタヨ'ル+ハズノ、セーホ'ルモンガ\/カ'レノ\/バアイ、ハンブ'ン\/ハンブ'ンニ\/ナ'ッテ+イル。",
      "startTime" : 137.38630385487528,
