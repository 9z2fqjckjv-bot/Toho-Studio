    {
      "voiceSymbol" : "ワタシガ\/イエ'ニ\/カ'エッテ+ク'ルト、ス'デニ\/オットガ\/リ'ビングニ\/イタ。",
      "startTime" : 365.77124716553294,
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav",
