      "speed" : 100,
      "isReversed" : false,
      "isCutOffOnSceneEnd" : true
    },
    {
      "voiceSymbol" : "、\/ソンナコトドウダッテイ'イワ、ソレヨ'リ、ユーハンワ\/タ'ベタノ？",
      "startTime" : 377.24657596371884,
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav",
