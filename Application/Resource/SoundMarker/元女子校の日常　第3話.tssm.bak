    },
    {
      "id" : "94850EB4-2602-4DC3-9EAE-3387D768BB02",
      "title" : "シーン 3: 「あなたは…魔理沙さんですか…母の友達の…」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "transitionName" : "なし",
      "telop" : "「あなたは…魔理沙さんですか…母の友達の…」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #3",
      "animationName" : "なし",
      "duration" : 3.916938775510204,
      "voiceDuration" : 3.316938775510204,
      "audioTrack" : "track_voice_soumu",
