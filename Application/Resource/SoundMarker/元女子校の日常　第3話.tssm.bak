    {
      "voiceSymbol" : "、\/レ'ーム、オマエ\/ソノ\/カオ\/ド'ー\/_シタ？ワタシワ、カ'ノジョガ\/ナイタ+ア'トノ\/ヒョージョ'ーオ\/_シテイタ'ノデ\/ソ'ー\/トイカケ'ル。",
      "startTime" : 370.40324263038553,
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_妹紅.wav",
