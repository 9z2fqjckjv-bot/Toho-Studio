    },
    {
      "id" : "DFB36546-8785-483C-A7BA-ACF761798ABF",
      "title" : "シーン 4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav",
      "transitionName" : "なし",
      "telop" : "「ああ…そうだ…。それより…」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #4",
      "animationName" : "なし",
      "duration" : 3.5,
      "voiceDuration" : 2.4344897959183673,
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙"
    },
    {
      "id" : "9944FE20-46AC-4702-A3AF-163DD12763E5",
      "title" : "シーン 5",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "transitionName" : "なし",
      "telop" : "「何か、言いたいことでもあるのですか？」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #5",
      "animationName" : "なし",
      "duration" : 3.5,
      "voiceDuration" : 2.5930385487528347,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "FE5F1EB6-A95C-4D13-AB7C-B827B5A890EA",
      "title" : "シーン 6",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav",
      "transitionName" : "なし",
      "telop" : "「お前の祖母さんが、困ってたぞ、私の孫が云々…って」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #6",
      "animationName" : "なし",
      "duration" : 5.7182312925170065,
      "voiceDuration" : 5.053242630385488,
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙"
    },
    {
      "id" : "13AF4EA0-117B-4124-81A4-10CAFE120128",
      "title" : "シーン 7",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "transitionName" : "なし",
      "telop" : "「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #7",
      "animationName" : "なし",
      "duration" : 6.6278231292517,
      "voiceDuration" : 6.027823129251701,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "740B4F42-C2DE-4C88-9A45-FD7F8D01CA9C",
      "title" : "シーン 8",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_霧雨魔理沙.wav",
      "transitionName" : "なし",
      "telop" : "「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #8",
      "animationName" : "なし",
      "duration" : 7.618231292517007,
      "voiceDuration" : 7.018231292517007,
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙"
    },
    {
      "id" : "B81D5858-DCF8-4770-9E85-0A3D979541FA",
      "title" : "シーン 9",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "transitionName" : "なし",
      "telop" : "そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #9",
      "animationName" : "なし",
      "duration" : 5.804988662131519,
      "voiceDuration" : 5.20498866213152,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "backgroundName" : "単色背景",
      "characterName" : "博麗霊夢",
      "animationName" : "バウンス",
      "duration" : 19,
      "title" : "シーン 10: 東方Project二次創作作品　Powerd By zuyasi",
      "slideTitle" : "スライド #10",
      "id" : "808EB769-6FBB-4B8E-BC32-F683413E9224",
      "telop" : "元女子校の日常",
      "transitionName" : "なし"
    },
    {
      "id" : "08870E3E-3728-4507-9C90-863EE74F3FA7",
      "title" : "シーン 11",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "transitionName" : "なし",
      "telop" : "そして、それから数分程度で霊夢が部屋に入ってくる。",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #11",
      "animationName" : "なし",
      "duration" : 4.090861678004535,
      "voiceDuration" : 3.490861678004535,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "0FE4C6C5-091D-41A8-8234-3613DBE9ECFC",
      "title" : "シーン 12",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #12",
      "animationName" : "なし",
      "duration" : 7.355736961451247,
      "voiceDuration" : 6.755736961451247,
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢"
    },
    {
      "id" : "70F6421F-FE50-48C1-9F7E-4B0C1AA80370",
      "title" : "シーン 13",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav",
      "transitionName" : "なし",
      "telop" : "「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "操夢",
      "slideTitle" : "スライド #13",
      "animationName" : "なし",
      "duration" : 7.0147619047619045,
      "voiceDuration" : 6.414761904761905,
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢"
    },
    {
      "id" : "E13DBB16-6C8E-4375-B081-65AFCA338A34",
      "title" : "シーン 14",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav",
      "transitionName" : "なし",
      "telop" : "「それに…最近…魔理沙の様子が変なのよね…」",
      "backgroundName" : "nc256897_病室-夕方-電気あり.png",
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #14",
