    },
    {
      "voiceSymbol" : "カンジャノ\/ナマエワ、フジワラ\/コーム、カ'レワ\/ウマレテ'カラ、モー_スコ'シデ\/<NUMK VAL=\"16\" COUNTER=\"ネン\">ニ+ナ'ル。ソ_シテ、カ'レノ\/ウラ'ニ\/_ヒソ'ム\/カ'ノジョワ\/デ'テ+キ'テ\/ヤ'_ク\/<NUMK VAL=\"3\" COUNTER=\"ネン\">ガ+タ'_ツ。",
      "startTime" : 126.27712018140589,
      "audioFilePath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_永琳.wav",
      "id" : "C0315478-8CFA-401E-A252-8BB895E2D43B",
