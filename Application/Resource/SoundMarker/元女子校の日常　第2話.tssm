{
  "version" : "2.0",
  "scenes" : [
    {
      "duration" : 4.283242630385487,
      "telop" : "私はふと目が覚めると、そこは学校の保健室だった。",
      "characterName" : "",
      "audioTrack" : "track_voice_reimu",
      "slideTitle" : "タイトル",
      "voiceDuration" : 3.6832426303854877,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.001.jpeg",
      "title" : "私はふと目が覚めると、そこは学校の保健室だった。",
      "id" : "17AB7DEC-1A51-42A7-823F-BD821F3F0CC9",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_博麗霊夢.wav",
      "voiceCharacter" : "博麗霊夢",
      "animationName" : "なし"
    },
    {
      "duration" : 7.073469387755102,
      "telop" : "すると、私のそばにいたのか、\n彼女が困惑した表情でここを見る。\n作成者：zuyasi",
      "characterName" : "鈴仙・優曇華院・イナバ",
      "audioTrack" : "track_voice_%E9%88%B4%E4%BB%99%E3%83%BB%E5%84%AA%E6%9B%87%E8%8F%AF%E9%99%A2%E3%83%BB%E3%82%A4%E3%83%8A%E3%83%90",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第2スライド",
      "voiceDuration" : 4.6952154195011335,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.002.jpeg",
      "title" : "シーン 2",
      "id" : "C7C6E35D-3F3C-44DD-BD7C-5853ED572C29",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_002_鈴仙・優曇華院・イナバ.wav",
      "voiceCharacter" : "鈴仙・優曇華院・イナバ",
      "animationName" : "なし"
    },
    {
      "duration" : 4.837596371882086,
      "telop" : "",
      "characterName" : "イナバ",
      "audioTrack" : "track_voice_%E3%82%A4%E3%83%8A%E3%83%90",
      "slideTitle" : "中扉",
      "voiceDuration" : 4.237596371882086,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.003.jpeg",
      "title" : "「あの…確かこのベッドには男子がいたはずなのですが…」",
      "id" : "DFC8F5E7-ACCB-4554-AE70-CA163AC9B1F3",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_イナバ.wav",
      "voiceCharacter" : "イナバ",
      "animationName" : "なし"
    },
    {
      "duration" : 11.508253968253968,
      "telop" : "「そういえば…この学校に来て、私が出るのは初めてか…。\nあなたが言っている彼は、確かにこのベッドにいましたよ。」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "characterName" : "鈴仙・優曇華院・イナバ",
      "audioTrack" : "track_voice_%E6%95%AC%E7%A7%B0%E7%95%A5",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第4スライド",
      "voiceDuration" : 7.823469387755102,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.004.jpeg",
      "title" : "シーン 4",
      "id" : "008409C9-C854-4927-AC28-444227A9044A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_004_敬称略.wav",
      "voiceCharacter" : "敬称略",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「えっと…それはどういう意味でしょう？」",
      "characterName" : "イナバ",
      "audioTrack" : "track_voice_%E3%82%A4%E3%83%8A%E3%83%90",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "第5スライド",
      "voiceDuration" : 2.624875283446712,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.005.jpeg",
      "title" : "シーン 5",
      "id" : "1FA225B5-9B5F-48DE-8C22-034ADD8CDF72",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_イナバ.wav",
      "voiceCharacter" : "イナバ",
      "animationName" : "なし"
    },
    {
      "duration" : 8.840861678004535,
      "telop" : "「まぁ、もう一度寝たら、彼の姿に戻りはしますが、それよりも、授業の方が優先ですから、教室に戻りますね。」",
      "characterName" : "鈴仙・優曇華院・イナバ",
      "audioTrack" : "track_voice_%E9%88%B4%E4%BB%99%E3%83%BB%E5%84%AA%E6%9B%87%E8%8F%AF%E9%99%A2%E3%83%BB%E3%82%A4%E3%83%8A%E3%83%90",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "第6スライド",
      "voiceDuration" : 8.240861678004535,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.006.jpeg",
      "title" : "シーン 6",
      "id" : "34E94308-3FBF-4D50-BA8A-F12C763DD940",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_鈴仙・優曇華院・イナバ.wav",
      "voiceCharacter" : "鈴仙・優曇華院・イナバ",
      "animationName" : "なし"
    },
    {
      "duration" : 4.277687074829932,
      "telop" : "「とりあえず、あなたの教室に案内しますね…」",
      "characterName" : "イナバ",
      "audioTrack" : "track_voice_%E3%82%A4%E3%83%8A%E3%83%90",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "第7スライド",
      "voiceDuration" : 3.677687074829932,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.007.jpeg",
      "title" : "シーン 7",
      "id" : "7417A4DB-049E-411E-A70D-EF31AB591712",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_イナバ.wav",
      "voiceCharacter" : "イナバ",
      "animationName" : "なし"
    },
    {
      "duration" : 3.9973696145124715,
      "telop" : "私はそう言われ、彼女と共に保健室を離れた。",
      "characterName" : "鈴仙・優曇華院・イナバ",
      "audioTrack" : "track_voice_%E9%88%B4%E4%BB%99%E3%83%BB%E5%84%AA%E6%9B%87%E8%8F%AF%E9%99%A2%E3%83%BB%E3%82%A4%E3%83%8A%E3%83%90",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideTitle" : "第8スライド",
      "voiceDuration" : 3.3973696145124714,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.008.jpeg",
      "title" : "シーン 8",
      "id" : "8AC4219E-7DD6-41AC-8E94-DAC9E7406279",
      "backgroundName" : "リビング（日中）.jpeg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_鈴仙・優曇華院・イナバ.wav",
      "voiceCharacter" : "鈴仙・優曇華院・イナバ",
      "animationName" : "なし"
    },
    {
      "characterName" : "",
      "duration" : 19,
      "slideTitle" : "タイトル",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "title" : "東方Project二次創作作品　Powerd By zuyasi",
      "telop" : "元女子校の日常",
      "animationName" : "バウンス",
      "id" : "07D0027A-2534-408E-8295-DA776B800A44",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.009.jpeg",
      "videoPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第2話_aaa2097126\/slide_009_anim.m4v",
      "voiceCharacter" : ""
    },
    {
      "duration" : 8.223469387755102,
      "telop" : "私が、彼女の案内で教室に戻ると、クラスメイトの視線が突き刺さるように飛んでくる。「まぁ…当たり前か…」",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__93E3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第10スライド",
      "voiceDuration" : 7.623469387755102,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.010.jpeg",
      "title" : "シーン 10",
      "id" : "37AF318C-6D69-4C10-938F-3873355E2AF3",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "animationName" : "なし"
    },
    {
      "duration" : 7.099773242630385,
      "telop" : "「あなた…見かけない顔ね…新入生かしら…」私は科学の講義中に突如として入ってきた彼女にそう問いかける。",
      "characterName" : "パチュリー・ノーレッジ",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第11スライド",
      "voiceDuration" : 6.499773242630385,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.011.jpeg",
      "title" : "シーン 11",
      "id" : "7E2A0BE4-A188-49B1-9D9B-57E100693AB9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "duration" : 6.285306122448979,
      "telop" : "「まぁ、そんなことどうでもいいわ。とりあえず、あなたもささっと席に着いて、私の講義を聞きなさい。」",
      "characterName" : "パチュリー・ノーレッジ",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第12スライド",
      "voiceDuration" : 5.68530612244898,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.012.jpeg",
      "title" : "シーン 12",
      "id" : "23F2BC9E-E93B-4B7B-AC4D-71B69BC245CF",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "duration" : 5.836507936507936,
      "telop" : "「わかりました。」\n私はそう返すと、窓際の真ん中にある空席に座る。",
      "characterName" : "パチュリー・ノーレッジ",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第13スライド",
      "voiceDuration" : 5.2365079365079366,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.013.jpeg",
      "title" : "シーン 13",
      "id" : "DB41CDC0-E32D-4424-851A-9D457F299FE7",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_013_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "duration" : 4.8533560090702945,
      "telop" : "「それじゃあ、続けるわね。」\n私はそう言って、科学の講義を再開した。",
      "characterName" : "パチュリー・ノーレッジ",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第14スライド",
      "voiceDuration" : 4.253356009070295,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.014.jpeg",
      "title" : "シーン 14",
      "id" : "A5066B08-1B6B-4082-AB37-A123A2529B69",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_014_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "animationName" : "なし"
    },
    {
      "characterName" : "ナレーション",
      "duration" : 3.5,
      "slideTitle" : "第15スライド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "title" : "シーン 15",
      "telop" : "それから時間が経ち…",
      "animationName" : "なし",
      "id" : "F36B1E56-81D5-448A-8977-44D865080B98",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.015.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション"
    },
    {
      "duration" : 8.386507936507936,
      "telop" : "それから数十分程度でその講義は終了した。そして、周りを見ながら、彼が持ってきた弁当を取り出し、食べる。",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__93E3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第16スライド",
      "voiceDuration" : 7.786507936507936,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.016.jpeg",
      "title" : "シーン 16",
      "id" : "311EA23F-FA1D-4358-B1C1-B9472B163756",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "animationName" : "なし"
    },
    {
      "duration" : 8.843038548752833,
      "telop" : "だが、弁当を食べ切ると同時に、全身に衝撃が走り、そのまま教室を抜け出し、ある場所…多目的トイレを探す。",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__93E3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第17スライド",
      "voiceDuration" : 8.243038548752834,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.017.jpeg",
      "title" : "シーン 17",
      "id" : "43FF892F-D46D-497F-8CD1-4F228DE35D60",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "animationName" : "なし"
    },
    {
      "duration" : 4.293038548752834,
      "telop" : "そして私は、多目的トイレに来るとその場に倒れ込んだ。",
      "characterName" : "ナレーション",
      "audioTrack" : "track_voice__93E3",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第18スライド",
      "voiceDuration" : 3.6930385487528343,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.018.jpeg",
      "title" : "シーン 18",
      "seName" : "SE: 倒れる",
      "id" : "604E397F-7BC5-44A8-976A-0549AAE7DE10",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_ナレーション.wav",
      "voiceCharacter" : "ナレーション",
      "animationName" : "なし"
    },
    {
      "duration" : 9.299546485260771,
      "telop" : "「ん…、ここは…トイレ…」僕はそう呟き、ハッと思い出す。\n「確か、10分の自己紹介で人生を話したら、気絶して…」",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第19スライド",
      "voiceDuration" : 8.699546485260772,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.019.jpeg",
      "title" : "シーン 19",
      "id" : "38B048D0-6443-4C28-B1E2-CF293C90D04C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 7.13,
      "telop" : "「とりあえず…教室に戻るか…」\n僕はそう一人呟くと、念入りに手を洗ってから、トイレを出た。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第20スライド",
      "voiceDuration" : 6.53,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.020.jpeg",
      "title" : "シーン 20",
      "id" : "2FC26156-E82C-4F19-9E32-C1D835B2451E",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 5.825646258503401,
      "telop" : "僕が教室に戻ってくると、\nさとりと呼ばれていた少女が僕に、駆け寄ってくる。",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第21スライド",
      "voiceDuration" : 5.225646258503401,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.021.jpeg",
      "title" : "シーン 21",
      "id" : "96BB2646-EEF9-4F1D-AD23-AEEE42880F3C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「あれ…どこから来たんですか？」",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第22スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png",
      "voiceDuration" : 1.5713832199546485,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.022.jpeg",
      "title" : "シーン 22",
      "id" : "85471F8F-C6A2-44E8-8D89-FD805CEC6C64",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 6.414761904761904,
      "telop" : "「えっと…」僕はそこで困惑してしまう…。\n「今はちょっと、自分の席で休みたいので….」",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第23スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png",
      "voiceDuration" : 5.814761904761904,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.023.jpeg",
      "title" : "シーン 23",
      "id" : "FDB16016-3D64-434D-86DB-326E6CE8A926",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.7070975056689344,
      "telop" : "「そうですか…、でもきっと、学園中で噂になりますよ…」",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第24スライド",
      "voiceDuration" : 3.076485260770975,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.024.jpeg",
      "title" : "シーン 24",
      "id" : "B3EACE6F-2F1C-40AA-BC62-0664B999E657",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_024_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 7.112585034013605,
      "telop" : "「そういえば、次は被服室での授業ですが、一人で大丈夫ですか？あと、数十分もせずに休み時間は終わりますが…」",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第25スライド",
      "voiceDuration" : 6.512585034013606,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.025.jpeg",
      "title" : "シーン 25",
      "id" : "0DC0803D-5228-440F-BC30-D9B260B5029C",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 6.321292517006802,
      "telop" : "「そうですか…ちょっと待っててください。」\n僕はそういうと、ささっと自席を片付ける。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第26スライド",
      "voiceDuration" : 5.721292517006803,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.026.jpeg",
      "title" : "シーン 26",
      "id" : "28A61D35-31E2-4E62-AA7D-321536232126",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「それで、被服室はどこにありますか？」",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第27スライド",
      "voiceDuration" : 2.5604308390022674,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.027.jpeg",
      "title" : "シーン 27",
      "id" : "B43B9987-F072-46D3-8C3E-94C5929B2E13",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「私が案内しますから、着いてきてください。」",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第28スライド",
      "voiceDuration" : 2.4259863945578233,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.028.jpeg",
      "title" : "シーン 28",
      "id" : "2CBCE584-5B65-4982-8757-7FD0FFB89176",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 4.2267346938775505,
      "telop" : "僕が彼女と共に被服室にくると、誰かがこちらにくる。",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第29スライド",
      "voiceDuration" : 3.626734693877551,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.029.jpeg",
      "title" : "シーン 29",
      "id" : "10182D94-3573-4E9D-9D3B-1BF2884F65D6",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_029_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 3.803378684807256,
      "telop" : "「あら、もしかして、このクラスに転入した男子ですか？」",
      "characterName" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "slideTitle" : "第30スライド",
      "voiceDuration" : 3.203378684807256,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.030.jpeg",
      "title" : "シーン 30",
      "id" : "5600521F-04D7-4FFE-A37C-F7E0ECA4AF6E",
      "backgroundName" : "咲夜（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_十六夜咲夜.wav",
      "voiceCharacter" : "十六夜咲夜",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「ええ、そうですが、なぜそんなことを…」",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "slideTitle" : "第31スライド",
      "voiceDuration" : 2.6386848072562357,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.031.jpeg",
      "title" : "シーン 31",
      "id" : "22982EDC-4D64-4209-B4D9-383D2742DB8C",
      "backgroundName" : "咲夜（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 7.0818820861678,
      "telop" : "「朝、早苗さんが見たときは、確かに男子だったはずなのに、パチュリーさんの授業に来た時には女子だった…と。」",
      "characterName" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "slideTitle" : "第32スライド",
      "voiceDuration" : 6.481882086167801,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.032.jpeg",
      "title" : "シーン 32",
      "id" : "A502B844-CDEB-445A-A2F0-2723DA15844D",
      "backgroundName" : "咲夜（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_十六夜咲夜.wav",
      "voiceCharacter" : "十六夜咲夜",
      "animationName" : "なし"
    },
    {
      "duration" : 7.721791383219954,
      "telop" : "「教員の間で、話題になってますよ。まぁ、元女子校の学園に男子生徒が来ただけでも、話題性は絶えないですが…」",
      "characterName" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "slideTitle" : "第33スライド",
      "voiceDuration" : 7.121791383219954,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.033.jpeg",
      "title" : "シーン 33",
      "id" : "488B8105-015B-4757-8324-DA4617B4BBB8",
      "backgroundName" : "咲夜（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_十六夜咲夜.wav",
      "voiceCharacter" : "十六夜咲夜",
      "animationName" : "なし"
    },
    {
      "duration" : 6.707392290249433,
      "telop" : "「とりあえず、これから家庭の授業をするので、あなたは…窓辺に座っているさとりの隣にでも座ってください。」",
      "characterName" : "十六夜咲夜",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "slideTitle" : "第34スライド",
      "voiceDuration" : 6.107392290249433,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.034.jpeg",
      "title" : "シーン 34",
      "id" : "B6A77BF5-AE19-4643-A767-1D662259BC75",
      "backgroundName" : "咲夜（微笑）.png",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_十六夜咲夜.wav",
      "voiceCharacter" : "十六夜咲夜",
      "animationName" : "なし"
    },
    {
      "duration" : 7.234195011337868,
      "telop" : "「今日は、咲夜師匠の２連無休授業ですから、あなたには…酷かもしれませんが、2時間を休憩なしで耐えるしかないですね。」",
      "characterName" : "古明地さとり",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第35スライド",
      "voiceDuration" : 6.549183673469388,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.035.jpeg",
      "title" : "シーン 35",
      "id" : "1F4BAE36-8A5C-41C1-B918-F15B7A308260",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_035_古明地さとり.wav",
      "voiceCharacter" : "古明地さとり",
      "animationName" : "なし"
    },
    {
      "duration" : 3.7984580498866216,
      "telop" : "彼女がそういい、数分程度で授業が始まった。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第36スライド",
      "voiceDuration" : 3.1984580498866215,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.036.jpeg",
      "title" : "シーン 36",
      "id" : "D8222FEF-5DBC-41A8-AC31-029E9D489D57",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "characterName" : "ナレーション",
      "duration" : 3.5,
      "slideTitle" : "第37スライド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "title" : "シーン 37",
      "telop" : "2時間休憩なし授業が終わると…",
      "animationName" : "なし",
      "id" : "2EA046CD-2C7B-4C06-9295-BEF07106B7A5",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.037.jpeg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "ナレーション"
    },
    {
      "duration" : 10.1756462585034,
      "telop" : "僕たちは、それから、2時間の間、休憩なしで、講義を受け続けると、教室に戻り、終礼が始まるまで席に座って待ち続ける。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第38スライド",
      "voiceDuration" : 9.5756462585034,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.038.jpeg",
      "title" : "シーン 38",
      "id" : "82D3E64B-D955-4163-9C57-5A4180FB2D88",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 5.0082539682539675,
      "telop" : "すると、教室の扉が開き、朝礼の時に来た女性が入る。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第39スライド",
      "voiceDuration" : 4.408253968253968,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.039.jpeg",
      "title" : "シーン 39",
      "seName" : "SE: 教室の戸を開ける",
      "id" : "F63C9D0E-A77D-4078-B9E6-362C87D2F4A6",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「皆さん、お疲れ様です。」",
      "characterName" : "東風谷早苗",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第40スライド",
      "voiceDuration" : 1.8664625850340135,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.040.jpeg",
      "title" : "シーン 40",
      "id" : "AB00EACA-7BC5-4FE8-B302-44BB156342B9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_東風谷早苗.wav",
      "voiceCharacter" : "東風谷早苗",
      "animationName" : "なし"
    },
    {
      "duration" : 8.625646258503401,
      "telop" : "彼女がそういうと、クラスメイトの女子たちは「お疲れ様です。」と一斉に返し、僕が急いで立ち、一緒に礼をする。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第41スライド",
      "voiceDuration" : 8.025646258503402,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.041.jpeg",
      "title" : "シーン 41",
      "id" : "730F9121-C08B-4778-9163-4CAEB95BDF8D",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「何か、伝えたいことがある生徒はいますか。」",
      "characterName" : "東風谷早苗",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第42スライド",
      "voiceDuration" : 2.77702947845805,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.042.jpeg",
      "title" : "シーン 42",
      "id" : "4558425A-EEC8-4ABA-8B81-C105A1712FB0",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_東風谷早苗.wav",
      "voiceCharacter" : "東風谷早苗",
      "animationName" : "なし"
    },
    {
      "duration" : 3.795215419501134,
      "telop" : "彼女がそういうと、シーンと教室が静まり返る。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第43スライド",
      "voiceDuration" : 3.195215419501134,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.043.jpeg",
      "title" : "シーン 43",
      "id" : "9CC86DDC-EA30-4AB4-8948-59660E37A6A9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 4.43360544217687,
      "telop" : "「それでは、終礼はこれで終了です。お疲れ様でした。」",
      "characterName" : "東風谷早苗",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第44スライド",
      "voiceDuration" : 3.8336054421768706,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.044.jpeg",
      "title" : "シーン 44",
      "id" : "2C50918F-296A-4C88-88A0-116049F442CB",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_東風谷早苗.wav",
      "voiceCharacter" : "東風谷早苗",
      "animationName" : "なし"
    },
    {
      "duration" : 7.39954648526077,
      "telop" : "僕は、周りの女子たちと共に立ち上がると、「お疲れ様でした。」と一斉に返し、お礼を済ませた。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第45スライド",
      "voiceDuration" : 6.7995464852607705,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.045.jpeg",
      "title" : "シーン 45",
      "id" : "0753C508-2BC3-41ED-98F4-25BB9E8266CD",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 7.458253968253968,
      "telop" : "彼女が教室からいなくなると、空気が少し和む。\nだが、そんなところにある女性が教室に入る。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第46スライド",
      "voiceDuration" : 6.858253968253968,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.046.jpeg",
      "title" : "シーン 46",
      "seName" : "SE: 教室の戸を開ける",
      "id" : "B9D70621-44CD-4ED4-A518-3ABA8A2B64EE",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_046_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 4.0843310657596374,
      "telop" : "すると、その女性は僕の席に来て、あることを言う。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第47スライド",
      "voiceDuration" : 3.4843310657596374,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.047.jpeg",
      "title" : "シーン 47",
      "id" : "8AC5ED4E-FC7E-4D0B-B139-1BD3A84C5B8D",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「藤原くん、ちょっと来てくれるかい。」",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第48スライド",
      "voiceDuration" : 1.6280498866213151,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.048.jpeg",
      "title" : "シーン 48",
      "id" : "8D046F49-572D-4ACB-86F7-853ECD1F0AFB",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 6.92891156462585,
      "telop" : "僕は、そう彼女に言われ、ささっと荷物を片すと、\n彼女が着いてきてと言うので、着いていった。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第49スライド",
      "voiceDuration" : 6.328911564625851,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.049.jpeg",
      "title" : "シーン 49",
      "id" : "C042543E-9C06-4E3A-A610-FB6EF7345EE4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 5.658253968253968,
      "telop" : "すると彼女は、校庭に出てくる。\n「あの僕は…何をこれからするんですか…」",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第50スライド",
      "voiceDuration" : 5.058253968253968,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.050.jpeg",
      "title" : "シーン 50",
      "id" : "E4E1C112-AD85-470C-A6BB-A78203B7E1E6",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 4.24344671201814,
      "telop" : "「1500m走だよ。\n準備体操を済ませたら、私に声をかけなさい。」",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第51スライド",
      "voiceDuration" : 3.6434467120181404,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.051.jpeg",
      "title" : "シーン 51",
      "id" : "DAFA90E8-9407-4BA1-B306-8A04D18916C0",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 8.747369614512472,
      "telop" : "「分かりました…」僕は、とりあえずそう返し、準備体操をする。\nそして、それが終わると、言われた通りに声をかける。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第52スライド",
      "voiceDuration" : 8.147369614512472,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.052.jpeg",
      "title" : "シーン 52",
      "id" : "CC453E23-8FE7-4B02-B3C8-C136F5C85320",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「それじゃあ、今から時間測るから、走ってみなさい。」",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第53スライド",
      "voiceDuration" : 2.4332199546485263,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.053.jpeg",
      "title" : "シーン 53",
      "id" : "A75FF83B-03C1-40A7-BFFA-E76D9CA73EBB",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 5.413673469387755,
      "telop" : "「はい…」僕はそう言うと、\n校庭に引かれた線に沿って、走り始める。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第54スライド",
      "voiceDuration" : 4.813673469387755,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.054.jpeg",
      "title" : "シーン 54",
      "id" : "F25B4B89-9199-44C8-BD8E-19D39D9C5EA0",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "characterName" : "",
      "duration" : 3,
      "slideTitle" : "中扉",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "title" : "彼が1500m走を完走すると…",
      "telop" : "",
      "animationName" : "なし",
      "id" : "63C3C417-6A71-43B3-8490-1EA9DB769AC3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.055.jpeg",
      "voiceCharacter" : ""
    },
    {
      "duration" : 6.16031746031746,
      "telop" : "「君、そこら辺の女子よりも、足が遅いんじゃないか？」\n私は、手元の腕時計を見ながら言う、あれから10分がたった。",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第56スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceDuration" : 5.56031746031746,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.056.jpeg",
      "title" : "シーン 56",
      "id" : "5D5EDB41-5C46-4B4E-A686-0A338C5FEB45",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 5.855147392290249,
      "telop" : "「これだと、女子相手に情けない男になるぞ、どうだ、もう一走りして、今度は…8分目安にするのはどうだ？」",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第57スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceDuration" : 5.255147392290249,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.057.jpeg",
      "title" : "シーン 57",
      "id" : "34E8E021-5A1E-41D2-9E6A-184F3CAB4EC7",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 9.153900226757369,
      "telop" : "「じゃあ、もう一走りしますか…」僕は、彼女の理屈が通っているように感じ、何らかのプライドが刺激されたか、そう呟く。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第58スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceDuration" : 8.314761904761905,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.058.jpeg",
      "title" : "シーン 58",
      "id" : "9E2D8D48-1847-46AD-B19B-4204701486E9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_058_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 3.5,
      "telop" : "「そうだ、その意気込みで、8分切れるように走ってみなさい。」",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第59スライド",
      "voiceDuration" : 2.729342403628118,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.059.jpeg",
      "title" : "シーン 59",
      "id" : "825D7A78-58CC-46F9-B4A2-20E966D64354",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 3.8865079365079365,
      "telop" : "僕は彼女にそう言われると、再び走り始める。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第60スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceDuration" : 3.2865079365079364,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.060.jpeg",
      "title" : "シーン 60",
      "id" : "FDBF8DBF-42B1-4E3D-9E31-D6515A0B05ED",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "characterName" : "",
      "duration" : 3,
      "slideTitle" : "中扉",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "title" : "彼がもう一走りをすると…",
      "telop" : "",
      "animationName" : "なし",
      "id" : "914DA1E8-7461-4101-8CFA-6E41CF86D358",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.061.jpeg",
      "voiceCharacter" : ""
    },
    {
      "duration" : 4.870068027210884,
      "telop" : "「さっきよりは良くなったか…」\n私は、手元の腕時計を見る。あれから9分弱が経っていた。",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第62スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceDuration" : 4.270068027210884,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.062.jpeg",
      "title" : "シーン 62",
      "id" : "44C16F63-3EE4-4550-97B8-180FBD204B72",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 5.841111111111111,
      "telop" : "「とりあえず、これで今日はおしまいにしよう、今度の体育では、同じトラックで女子と競争になるから、覚悟するのだぞ。」",
      "characterName" : "美鈴",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第63スライド",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceDuration" : 5.2411111111111115,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.063.jpeg",
      "title" : "シーン 63",
      "id" : "CE55078D-9B0B-496A-ABB1-2C991363CEB4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_美鈴.wav",
      "voiceCharacter" : "美鈴",
      "animationName" : "なし"
    },
    {
      "duration" : 8.10498866213152,
      "telop" : "彼女はそう言うと、そのまま何かを呟きながら、去っていった。\n僕は、その場でしゃがみ込んで、休みを取る。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第64スライド",
      "voiceDuration" : 7.504988662131519,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.064.jpeg",
      "title" : "シーン 64",
      "id" : "A5C7F907-EBEB-45F0-9B2D-16C3BF3E6B38",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 7.022380952380952,
      "telop" : "すると、走ってた時には感じなかった痛みが僕を襲う。\nどうやら、無理強いをしていたようだった。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第65スライド",
      "voiceDuration" : 6.422380952380952,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.065.jpeg",
      "title" : "シーン 65",
      "id" : "05E60BA4-8690-49B5-8B4B-C9391A0A527A",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 8.839773242630384,
      "telop" : "だが、彼女の言葉は事実を述べているだけなので、何もいえず、ただ一人、校庭で俯きながら、考え込む僕だった。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第66スライド",
      "voiceDuration" : 8.239773242630385,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.066.jpeg",
      "title" : "シーン 66",
      "id" : "38F1A68E-6E39-4CDC-ACE0-1AF1BBDE1C7F",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "voiceCharacter" : "操夢",
      "animationName" : "なし"
    },
    {
      "duration" : 6.361519274376417,
      "telop" : "そして、立ちあがろうとしたその時、\n僕の全身がぐらつき、そのまま倒れ込むのだった。",
      "characterName" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideTitle" : "第67スライド",
      "voiceDuration" : 5.761519274376417,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.067.jpeg",
      "title" : "シーン 67",
      "seName" : "SE: 倒れる",
