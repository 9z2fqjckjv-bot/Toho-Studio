      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg",
      "voiceCharacter" : "操夢"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/早苗（微笑）.png",
      "characterName" : "古明地さとり",
      "duration" : 5,
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "title" : "シーン 18: 主人公がいるクラスの担任",
      "slideTitle" : "スライド #18",
      "id" : "F156AE8A-D268-46F1-A0B6-B0D4BC068948",
      "bgmName" : "BGM: nc495612_【東方アレンジ】忘れられる信仰は誰の為に",
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.65,
      "seStartTimeOffset" : 0,
      "telop" : "主人公の彼が通っている学園の教員であり、彼のクラスの担任。彼が初めて学園に登校した際には、威勢のいい挨拶をしない彼を指摘し、彼を近くに呼び寄せると、挨拶とお辞儀をする練習をさせる。そして、これまでの人生を10分で語るという難題で彼を気絶させた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.018.jpeg",
      "bgmAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc495612_【東方アレンジ】忘れられる信仰は誰の為に.mp3",
      "transitionName" : "なし",
      "seVolume" : 1
    },
    {
      "voiceDuration" : 7.771292517006803,
