      "animationName" : "なし",
      "backgroundName" : "image76.jpeg",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "telop" : "僕は、ふと暇になり、テレビをつける。すると、テレビでは地下底国グループが突如、発表したご令嬢の今後について流れていた。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.012.jpeg",
      "seVolume" : 1,
