      "duration" : 5,
      "characterName" : "パチュリー・ノーレッジ",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/パチュリー真顔小口開け.png",
