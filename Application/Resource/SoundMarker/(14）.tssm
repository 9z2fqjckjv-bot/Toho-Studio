      "voiceDuration" : 6.808253968253968,
      "seVolume" : 1,
      "telop" : "彼女が水をとりに離れると、フレラがやってくる。\n「それで、向こうは、どれくらいで着くと言ってましたか？」",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(14）_c204799461\/(14）_c204799461.021.jpeg",
