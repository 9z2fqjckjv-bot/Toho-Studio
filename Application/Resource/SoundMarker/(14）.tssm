      "voice2StartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.625646258503401,
      "voiceDuration" : 8.625646258503401,
      "seVolume" : 1,
      "telop" : "僕は、そんな彼女をそっとベッドに横たわらせると、動こうとするが、彼女が僕の服をひっぱり、僕は彼女の隣で横になる。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
