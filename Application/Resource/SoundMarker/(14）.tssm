      "voiceSymbol" : "、+ネ'ー、アナ'タモ\/イッショニ\/タタカオ'ーヨ。ワタシワ、ソ'ー\/フランオ\/サソウ。",
      "character" : "フランドール・スカーレット",
      "fadeOutDuration" : 0,
      "colorHex" : "#00CEC9",
      "voiceTriggerEnabled" : false,
