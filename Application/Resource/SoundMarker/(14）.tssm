      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/image12.png",
      "backgroundName" : "image12.png",
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.189773242630386,
      "voiceDuration" : 8.189773242630386,
      "seVolume" : 1,
      "telop" : "僕がそう問いただすと、彼女はある衝撃の事実を告げる。\n僕は、それを聞くと、ベッドを飛び出し、図書館に向かった。\n彷徨う二人　第14話\n彼が、ある部屋で休んでいると、異常事態が発生し…",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(14）_c204799461\/(14）_c204799461.005.jpeg",
      "animationName" : "なし",
      "id" : "7C359838-55B5-4D12-9715-C269C8ABF6C8",
      "slideTitle" : "スライド #5",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7
    },
    {
