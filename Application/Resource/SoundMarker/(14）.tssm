      "duration" : 8.140861678004535,
      "voiceDuration" : 8.140861678004535,
      "seVolume" : 1,
      "telop" : "僕は爆発音が屋敷全体に響く中、ただ彼女の頭を無言で撫で続けていると、いつの間にか彼女は眠りについていた。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(14）_c204799461\/(14）_c204799461.057.jpeg",
