      "duration" : 7.508253968253968,
      "voiceDuration" : 7.508253968253968,
      "seVolume" : 1,
      "telop" : "僕たちが、そう話していると、彼女が戻ってくる。\n僕は、彼女からコップを受け取り、パチュリーに飲ませる。",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
