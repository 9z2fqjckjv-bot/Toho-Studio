      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "slideTitle" : "スライド #4",
      "telop" : "「どんな試験を受けるの？」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "title" : "シーン 4",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 5.308253968253968,
      "duration" : 5.908253968253968,
      "animationName" : "なし",
      "id" : "A82E4D4F-846D-46F7-A807-607AE5F42CD5",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.005.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #5",
      "telop" : "「全国財閥高統一模試ですよ。」\n僕はそういうと、勉強を再開した。\n元女子校の日常\n〜彼が図書館で勉強していると、フランが話しかけてきて…〜",
      "title" : "シーン 5",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg",
      "backgroundName" : "nc77066_【背景素材】紅魔館大図書館.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav"
    },
    {
      "title" : "シーン 6: 東方Project二次創作作品　Powerd By zuyasi",
      "duration" : 3,
      "animationName" : "なし",
      "slideTitle" : "スライド #6",
      "id" : "5C7D5643-B1DF-41B6-9945-6820E2943972",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.006.jpeg",
      "characterName" : "博麗霊夢",
      "backgroundName" : "単色背景",
      "telop" : "元女子校の日常"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 6.710430839002267,
      "duration" : 7.310430839002267,
      "animationName" : "なし",
      "id" : "58DBA7AF-19F3-495A-8B59-A5A77BBE0761",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.007.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #7",
      "telop" : "それから、あっという間に、時間が経ち、\n気がつけば転校してから、半月の程の期間が経っていた。",
      "title" : "シーン 7",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav"
    },
    {
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3",
      "voiceCharacter" : "操夢",
      "seName" : "SE: 教室の戸を開ける",
      "voiceDuration" : 10.153469387755102,
      "duration" : 10.753469387755102,
      "animationName" : "なし",
      "id" : "A3EEC469-869B-4CD5-9927-E0648E93CD78",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.008.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #8",
      "telop" : "そして、今日は、この2週間ほどで勉強した全国財閥高統一模試を受ける日だった。すると、教室の扉が開き、担任が入ってくる。",
      "title" : "シーン 8",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.927823129251701,
      "duration" : 8.5278231292517,
      "animationName" : "なし",
      "id" : "5765B451-7008-49B8-8D49-BC994035ADA7",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.009.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #9",
      "telop" : "僕は、素早く席を立ち上がり、クラスメイトに合わせた朝の挨拶をする。そして、彼女の合図とともに席に座る。",
      "title" : "シーン 9",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav"
    },
    {
      "voiceCharacter" : "東風谷早苗",
      "voiceDuration" : 8.562222222222223,
      "duration" : 9.162222222222223,
      "animationName" : "なし",
      "id" : "6C7AF412-C2D9-43D8-9364-47F046E874EE",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.010.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "slideTitle" : "スライド #10",
      "telop" : "「それでは、朝礼を始めます。今日は、毎月恒例の定期ミニテスト日です。全時限でミニテストがあるので、覚悟してください。」",
      "title" : "シーン 10",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_東風谷早苗.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.508253968253968,
      "duration" : 9.108253968253967,
      "animationName" : "なし",
      "id" : "D6F3DEA0-AD09-4C77-B29B-749C14619C49",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.011.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #11",
      "telop" : "僕は、彼女の発言に驚く。ミニテストがあるなんて聞いてなかったからだ。だが、彼女がある衝撃的な発言をする。",
      "title" : "シーン 11",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"
    },
    {
      "voiceCharacter" : "東風谷早苗",
      "voiceDuration" : 7.945555555555556,
      "duration" : 8.545555555555556,
      "animationName" : "なし",
      "id" : "960A39C1-95F0-45E9-8252-223F150C51CC",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.012.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "slideTitle" : "スライド #12",
      "telop" : "「藤原さん、あなたは今日、ミニテストの代わりに、体力測定を行いますから、このあとすぐに、萃香先生を訪ねるように。」",
      "title" : "シーン 12",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_東風谷早苗.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 3.2582539682539684,
      "duration" : 3.8582539682539685,
      "animationName" : "なし",
      "id" : "CC87981C-3617-4A13-A1FE-C15C8745C7EC",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.013.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #13",
      "telop" : "「あっ…、はい…、分かりました…」僕はそう返す。",
      "title" : "シーン 13",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav"
    },
    {
      "voiceCharacter" : "東風谷早苗",
      "voiceDuration" : 3.0212018140589567,
      "duration" : 3.621201814058957,
      "animationName" : "なし",
      "id" : "64A99D6B-018C-4A50-A22F-4E869C7A4352",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.014.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "slideTitle" : "スライド #14",
      "telop" : "「連絡は以上です。皆試験に励むように。」",
      "title" : "シーン 14",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_東風谷早苗.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.607165532879819,
      "duration" : 8.207165532879818,
      "animationName" : "なし",
      "id" : "140E21D9-468E-4B8A-9FBC-7E5AB0A255FB",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.015.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #15",
      "telop" : "彼女はそういうと、去っていった。僕は、ぼんやりとしていると、突如として、先ほど言っていた人が入ってくる。",
      "title" : "シーン 15",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 3.5696598639455783,
      "duration" : 4.169659863945578,
      "animationName" : "なし",
      "id" : "F6013FFB-B099-43D6-91E6-1BDB125F9C4C",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.016.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #16",
      "telop" : "「藤原くん、ボケっとしてないで、\nさっさと私の後に着いてきなさい。」",
      "title" : "シーン 16",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 3.15281179138322,
      "duration" : 3.75281179138322,
      "animationName" : "なし",
      "id" : "D4664AC7-66E1-42EE-AC44-AD598B1EC4B0",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.017.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #17",
      "telop" : "僕はそう彼女に言われ、後ろをついていくのだった。",
      "title" : "シーン 17",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 3.7897732426303854,
      "duration" : 4.389773242630385,
      "animationName" : "なし",
      "id" : "9D8D987C-439E-4E66-9D7E-E4CA1B89DA69",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.018.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #18",
      "telop" : "そして、彼女についていくと、やってきたのは校庭だった。",
      "title" : "シーン 18",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 2.9696598639455782,
      "duration" : 3.5696598639455783,
      "animationName" : "なし",
      "id" : "2A1B9047-A369-4055-A490-BEEBB5F70CB8",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.019.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #19",
      "telop" : "「準備体操済ませて、とりあえずグラウンドを3周しなさい。」",
      "title" : "シーン 19",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.593038548752834,
      "duration" : 8.193038548752835,
      "animationName" : "なし",
      "id" : "E899369E-246B-4E3E-88C9-D2651D7689A8",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.020.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #20",
      "telop" : "「分かりました…」僕は、彼女の有無を言わさぬ態度に、ある一種の恐ろしさを感じながら、準備体操をして走る。",
      "title" : "シーン 20",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 3.4013151927437644,
      "duration" : 4.001315192743764,
      "animationName" : "なし",
      "id" : "B0A42646-DFF4-4153-9BBA-E59E180FE4AD",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.021.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #21",
      "telop" : "「次は、樽投げだ。この酒樽を思いきっり投げ飛ばしなさい。」",
      "title" : "シーン 21",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 3.8669387755102043,
      "duration" : 4.466938775510204,
      "animationName" : "なし",
      "id" : "BC903D86-A6F0-41EE-85F7-77F09C3C728C",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.022.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #22",
      "telop" : "僕は彼女に言われるがままに、酒樽を一所懸命に投げる。",
      "title" : "シーン 22",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 2.6779818594104308,
      "duration" : 3.277981859410431,
      "animationName" : "なし",
      "id" : "17A74B7F-95C3-4E05-B3C7-C819D15607D6",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.023.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #23",
      "telop" : "「今度は、握力だ。酒樽を持ってみなさい。」",
      "title" : "シーン 23",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 5.569115646258504,
      "duration" : 6.169115646258503,
      "animationName" : "なし",
      "id" : "1320FCDF-33C7-4256-AE1F-71F34DC0FBB4",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.024.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #24",
      "telop" : "僕が、その酒樽を持つと、\n彼女はどこからともなく、酒樽をもう一つ取り出す。",
      "title" : "シーン 24",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 2.6546485260770973,
      "duration" : 3.2546485260770974,
      "animationName" : "なし",
      "id" : "C2435089-3B3F-4EC2-BC24-49061C443785",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.025.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #25",
      "telop" : "「中の酒をこぼさぬように、酒樽を持ち替えなさい。」",
      "title" : "シーン 25",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.690861678004536,
      "duration" : 9.290861678004536,
      "animationName" : "なし",
      "id" : "105BCA20-3358-4CE6-8D99-F6766C78E43E",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.026.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #26",
      "telop" : "僕は彼女が新しい酒樽を地面にそっと置くと、すでに持っていた樽を地面に置き、新しい方を持つ。すると、力がかかる。",
      "title" : "シーン 26",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.98,
      "duration" : 8.58,
      "animationName" : "なし",
      "id" : "AAF513DD-A867-4985-BFB2-617A1CB046D2",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.027.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #27",
      "telop" : "すると、彼女は、もう一つ酒樽を置くと、それも持つようにいう。僕は、慎重に手を動かして、その樽を持つ。",
      "title" : "シーン 27",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.921292517006803,
      "duration" : 8.521292517006803,
      "animationName" : "なし",
      "id" : "3B7C8DFD-B3E2-4431-999A-BAA06EFF8827",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.028.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #28",
      "telop" : "それから、僕は、握力がそこをつくまで、酒樽を何回も持たせられ、それが終わると、10分の休憩が挟まれた。",
      "title" : "シーン 28",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 5.862607709750567,
      "duration" : 6.462607709750567,
      "animationName" : "なし",
      "id" : "C221CF4D-F21A-4601-94CA-759695AE9014",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.029.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #29",
      "telop" : "それが終わると、彼女は、今度どこからか持ってきた\nメモリがついているマットを、地面に敷く。",
      "title" : "シーン 29",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 2.1346485260770973,
      "duration" : 2.7346485260770974,
      "animationName" : "なし",
      "id" : "8064FC4D-8140-4543-8332-7BA9621EDFB4",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.030.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #30",
      "telop" : "「今敷いたこのマットに向かって飛んでみなさい。」",
      "title" : "シーン 30",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.560430839002268,
      "duration" : 8.160430839002268,
      "animationName" : "なし",
      "id" : "F7E785DE-B1F3-4563-B18F-FF73B3C698B1",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.031.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #31",
      "telop" : "僕は、そう言われると、マットに向かって飛ぶ、そして、飛び終えると同時に、文句を言われ、彼女が手本を見せる。",
      "title" : "シーン 31",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 2.1179818594104307,
      "duration" : 2.717981859410431,
      "animationName" : "なし",
      "id" : "5CB8BCF5-96C1-47D9-868F-2CA9830E6B60",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.032.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #32",
      "telop" : "「今私が見せたように、飛んでみなさい。」",
      "title" : "シーン 32",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 5.073469387755102,
      "duration" : 5.673469387755102,
      "animationName" : "なし",
      "id" : "5B6C33AD-BABA-41E4-BE60-F8AF6E4D894C",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.033.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #33",
      "telop" : "僕は、彼女にそう言われ、\n彼女が本当に人なのかを疑いながら、飛ぶ。",
      "title" : "シーン 33",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.132154195011339,
      "duration" : 8.732154195011338,
      "animationName" : "なし",
      "id" : "6ADFF6E3-94AA-4C63-98B5-52F99350FAF3",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.034.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #34",
      "telop" : "それが終わると、彼女は、いきなり僕をマットの上に押し倒す。\nすると、彼女を僕の足元を押さえ込み、説明をする。",
      "title" : "シーン 34",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 2.817981859410431,
      "duration" : 3.417981859410431,
      "animationName" : "なし",
      "id" : "616603A2-D92E-4DA8-BD7A-C59BDD152101",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.035.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #35",
      "telop" : "「今から、時間を測るから、上体起こしをしなさい。」",
      "title" : "シーン 35",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 8.425646258503402,
      "duration" : 9.025646258503402,
      "animationName" : "なし",
      "id" : "4AFB6082-FAB8-4D2E-ACE8-53262639A1ED",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.036.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #36",
      "telop" : "僕は、すでに動けない状態でそう言われ、彼女が時間を測り始めると、残っている力を引き出しながら、言われた通りにする。",
      "title" : "シーン 36",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.249546485260771,
      "duration" : 7.84954648526077,
      "animationName" : "なし",
      "id" : "ECC1AC35-4A28-47D9-871D-E8E3E0BCFB34",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.037.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #37",
      "telop" : "すると、彼女は休憩だと言い、10分間の休憩が再び入る。\n彼女はその間に、マットを片す。",
      "title" : "シーン 37",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 6.146326530612245,
      "duration" : 6.746326530612245,
      "animationName" : "なし",
      "id" : "10736C96-2C05-4442-AA8C-B8834AA08AB6",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.038.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #38",
      "telop" : "「次は、反復横跳びだ、そこに立って私が時間を測り始めたら、動き出しなさい。フライングはするんじゃないぞ。」",
      "title" : "シーン 38",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.10390022675737,
      "duration" : 7.703900226757369,
      "animationName" : "なし",
      "id" : "FFFCDAA2-03A5-4182-9D61-0A12D429048B",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.039.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #39",
      "telop" : "僕は、すでに息切れが起きていたが、なんとか深呼吸で落ち着かせると、彼女の合図に合わせて、動き出す。",
      "title" : "シーン 39",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 5.0029931972789115,
      "duration" : 5.602993197278911,
      "animationName" : "なし",
      "id" : "9DEB6623-6296-4A90-AA2F-3ECB7B263294",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.040.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #40",
      "telop" : "「次は、制限時間内に、グラウンドを1周しなさい。\nそれが無事に終われば、昼休憩だ。」",
      "title" : "シーン 40",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.064761904761904,
      "duration" : 7.664761904761904,
      "animationName" : "なし",
      "id" : "AA6CC47D-A849-4EF8-9553-8506BE503D55",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.041.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #41",
      "telop" : "「…は…はい…」僕はなんとかそう返し、彼女が1分のタイマーをスタートさせると、僕は全力疾走する。",
      "title" : "シーン 41",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav"
    },
    {
      "voiceCharacter" : "萃香",
      "voiceDuration" : 4.951315192743764,
      "duration" : 5.551315192743764,
      "animationName" : "なし",
      "id" : "ADE9F46E-0AF0-4754-8F46-0783B4DD8F20",
      "characterName" : "萃香",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.042.jpeg",
      "audioTrack" : "track_voice_%E8%90%83%E9%A6%99",
      "slideTitle" : "スライド #42",
      "telop" : "「それじゃあ、30分後にまた、ここにきなさい。\nそしたら、最後に1500m走だ。」",
      "title" : "シーン 42",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_萃香.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.804557823129252,
      "duration" : 8.404557823129252,
      "animationName" : "なし",
      "id" : "B5CE9316-1280-4586-8576-81D8D02CBED6",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.043.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #43",
      "telop" : "僕は、頭の中で鐘が鳴ったようなガーンという感覚を感じながら、ふと思い出す。「荷物、教室の中だ…」",
      "title" : "シーン 43",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.75172335600907,
      "duration" : 8.351723356009071,
      "animationName" : "なし",
      "id" : "6F25492E-3CBB-448C-A7E4-5F662840EFA5",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.044.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #44",
      "telop" : "まだ、きっと校舎は試験中だから、入れない。それと、弁当を持ってきたかも忘れた。「お昼ご飯どうしよう…」",
      "title" : "シーン 44",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 2.564761904761905,
      "duration" : 3.164761904761905,
      "animationName" : "なし",
      "id" : "D549D66A-8426-48F9-B802-4C356543B263",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.045.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #45",
      "telop" : "すると、誰かがこちらに駆け寄ってくる。",
      "title" : "シーン 45",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav"
    },
    {
      "voiceCharacter" : "美鈴",
      "voiceDuration" : 1.7470748299319727,
      "duration" : 2.5,
      "animationName" : "なし",
      "id" : "3AA72CD0-084F-4F0A-BB91-5E15629ADC68",
      "characterName" : "美鈴",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.046.jpeg",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "slideTitle" : "スライド #46",
      "telop" : "「大丈夫ですか、何があったんですか？」",
      "title" : "シーン 46",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（驚く）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_美鈴.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.281065759637189,
      "duration" : 7.881065759637188,
      "animationName" : "なし",
      "id" : "9133ECD3-1618-4D2D-B430-D846E190B1A7",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.047.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #47",
      "telop" : "「…」僕は、すでにまともな言葉を発せなくなっていた。\nそして、彼女が困っているところで、気を失った。",
      "title" : "シーン 47",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav"
    },
    {
      "voiceCharacter" : "ナレーション",
      "voiceDuration" : 1.7394784580498865,
      "duration" : 2.5,
      "animationName" : "なし",
      "id" : "C3691E49-1EFD-46C2-B40F-0E6DCDA96960",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "audioTrack" : "track_voice__04C8",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.048.jpeg",
      "slideTitle" : "スライド #48",
      "telop" : "彼が再び目覚めると…",
      "title" : "シーン 48",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "animationNote" : "表示時間：1.5秒",
      "animationDuration" : 1.5,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_ナレーション.wav"
    },
    {
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.068027210884353,
      "duration" : 7.668027210884353,
      "animationName" : "なし",
      "id" : "92505A5D-F01E-45AF-8ADE-93351F690C00",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第13話_3baf10009a\/元女子校の日常　第13話_3baf10009a.049.jpeg",
      "audioTrack" : "track_voice_soumu",
      "slideTitle" : "スライド #49",
      "telop" : "「ん…」僕は目が覚めると、そこはフランとの二人部屋だった。\nすると、フランが驚き、部屋を飛び出す。",
      "title" : "シーン 49",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav"
    },
    {
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceDuration" : 2.1254875283446713,
      "duration" : 2.7254875283446713,
      "animationName" : "なし",
      "id" : "BE70C3EF-92FC-42A8-A77D-CFF07D57755B",
      "characterName" : "レミリア・スカーレット",
