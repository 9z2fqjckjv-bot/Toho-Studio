      "type" : "Voice",
      "speed" : 100,
      "voiceSymbol" : "ソレカラ、ア'ットユウマニ、ジカンガ+タ'_チ、キガ\/ツ'ケバ\/テンコー_シテ'カラ、ハン_ツキノ\/ホ'ドノ\/キ'カンガ\/タ'ッテ+イタ。",
      "volume" : 1,
      "startTime" : 23.375873015873015,
      "trackId" : "track_voice_soumu",
