      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.073.jpeg",
