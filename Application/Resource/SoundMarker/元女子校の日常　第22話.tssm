    },
    {
      "bgmAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc364900_【東方自作アレンジ】Mad【ハルトマンの妖怪少女】.mp3",
      "seStartTimeOffset" : 0,
      "transitionName" : "なし",
      "slideTitle" : "スライド #40",
      "title" : "シーン 40",
      "backgroundName" : "image68.jpeg",
      "bgmName" : "BGM: nc364900_【東方自作アレンジ】Mad【ハルトマンの妖怪少女】",
      "id" : "559B147F-C445-4AC5-AF8B-4D5EEDDB68B9",
      "telop" : "中学生\n彼とエンドレスランをしたときに、こけかけ彼に抱っこしてもらって以降、彼には今まで味わったことのない気持ちを感じている。だが、前回、裸の姿を彼に見られてしまい、彼女は彼に甘えることをやめ、態度が豹変した。ちなみに、彼のクラスメイトの古明地さとりの妹でもある。\n古明地こいし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.040.jpeg",
      "duration" : 5,
      "animationDuration" : 5,
      "animationName" : "なし",
      "seVolume" : 1,
