      "transitionName" : "なし",
      "telop" : "「あなたが、昨日、妹の裸を見たことで、私たちの中での決まりが、あなたにも適用されたんですよ、強制ではないですが…」",
      "voiceDuration" : 7.068185941043084,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
