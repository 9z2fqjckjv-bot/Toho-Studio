      "transitionName" : "なし",
      "telop" : "そこまで言うと、彼女は頬を赤らめ、数秒の間の後、言う。",
      "voiceDuration" : 4.206077097505669,
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
