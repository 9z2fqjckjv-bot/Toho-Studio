      "voiceCharacter" : "隠岐奈",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png",
      "voiceDuration" : 9.934784580498865,
      "animationName" : "なし",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png",
      "characterName" : "隠岐奈",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #55",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceCharacter" : "隠岐奈",
      "title" : "シーン 55",
      "id" : "20F22F27-738E-4FB7-AD30-E53D6BF4D67C",
      "telop" : "だが、すぐに永琳からの電話も飛んできて、\n私はこいしの電話を保留にし、そちらに切り替える。",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_隠岐奈.wav",
      "transitionName" : "なし",
      "voiceDuration" : 6.302902494331065,
      "bgmStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.055.jpeg",
      "seStartTimeOffset" : 0,
      "duration" : 6.302902494331065,
      "backgroundName" : "2026-11-10_17-38.png"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png",
      "characterName" : "隠岐奈",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #56",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceCharacter" : "隠岐奈",
      "title" : "シーン 56",
      "id" : "F30EC850-8D4B-4C77-AE4A-016680073D94",
      "telop" : "永琳が言うには、彼は貴重な研究対象だから、学園から話さずに、学校側の手が届く範囲でいさせたいとの要望だった。",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_隠岐奈.wav",
      "transitionName" : "なし",
      "voiceDuration" : 8.660725623582767,
      "bgmStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.056.jpeg",
      "seStartTimeOffset" : 0,
      "duration" : 8.660725623582767,
      "backgroundName" : "2026-11-10_17-38.png"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png",
      "characterName" : "隠岐奈",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #57",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceCharacter" : "隠岐奈",
      "title" : "シーン 57",
      "id" : "48110E78-9900-48AC-AC57-440D6CE40EAF",
      "telop" : "私は、彼が貴重な人物であることは認識していたが、それほど重要性の高い人物だとは、正直に言って感じてなかった。",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_隠岐奈.wav",
      "transitionName" : "なし",
      "voiceDuration" : 8.607596371882087,
      "bgmStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.057.jpeg",
      "seStartTimeOffset" : 0,
      "duration" : 8.607596371882087,
      "backgroundName" : "2026-11-10_17-38.png"
    },
    {
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png",
      "characterName" : "隠岐奈",
      "voiceStartTimeOffset" : 0,
      "slideTitle" : "スライド #58",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceCharacter" : "隠岐奈",
      "title" : "シーン 58",
      "id" : "49BDB296-B1A2-4471-80F9-E81C69A62F95",
      "telop" : "私は、一通り永琳の意見を聞き終えると、こいしの方に再度、切り替える。すると、彼女は、これは戦いだと、言ってきた。",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_隠岐奈.wav",
      "transitionName" : "なし",
      "voiceDuration" : 9.121020408163265,
      "bgmStartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.058.jpeg",
      "seStartTimeOffset" : 0,
