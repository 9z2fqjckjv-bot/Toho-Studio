      "transitionName" : "なし",
      "telop" : "「それに、学校側だって、あなたが欲しいから、きっとこの戦いに参戦してくるわ。あなたは、その戦いの主軸なのよ。」",
      "voiceDuration" : 10.994195011337869,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
