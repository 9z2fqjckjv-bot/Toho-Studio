      "seVolume" : 1,
      "voiceCharacter" : "隠岐奈",
      "title" : "シーン 63",
      "id" : "42167558-90E5-4095-BA46-B20B07FBFA0D",
      "telop" : "そんな彼女の裸を運悪く見てしまった彼を発端に、彼女は今まであえて潜めていたグループを使い始めたことに、私は驚いた。",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_隠岐奈.wav",
      "transitionName" : "なし",
