      "transitionName" : "なし",
      "telop" : "「あと、あなたの母親のところも、後継者の関係で、あなたを引き戻したいそうよ。だから、四つ巴の戦いなのよ…。」",
      "voiceDuration" : 10.813242630385487,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
