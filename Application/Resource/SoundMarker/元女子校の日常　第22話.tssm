      "transitionName" : "なし",
      "telop" : "「これは…、あなたの結婚相手…いや、後継をめぐる紅魔建設と私たち…、地下底国グループが戦うための文書なのよ。」",
      "voiceDuration" : 10.537006802721088,
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "animationName" : "なし",
