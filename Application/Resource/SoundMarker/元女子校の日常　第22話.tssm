      "isCutOffOnSceneEnd" : true,
      "volume" : 1,
      "voiceTriggerEnabled" : false,
      "fadeInDuration" : 0,
      "pan" : 0,
      "text" : "私が、昨日、残業で職務をこなしていると、一本の電話が入る。それを知らせにきた、萃香はいかにも面倒そうな顔をしていた。",
      "voiceTriggerOffset" : 0,
