      "voiceDuration" : 8.710430839002267,
      "transitionName" : "なし",
      "voiceCharacter" : "操夢",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg",
