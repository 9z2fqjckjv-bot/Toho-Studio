    },
    {
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "僕は、ぼーっとしているフレラを抱えると、レミノアを抱えたフランと共に、さっきまでいた部屋に、退避を始めた。",
      "id" : "2186D0C2-BCFB-415F-B540-FDE6498CFCDA",
      "transitionName" : "なし",
      "voiceDuration" : 7.3691156462585035,
      "duration" : 7.3691156462585035,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav",
      "title" : "シーン 13",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.013.jpeg",
