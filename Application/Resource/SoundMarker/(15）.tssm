    },
    {
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "それから…",
      "id" : "CBBEF214-D7E9-474F-AEC1-0B97345C3288",
      "transitionName" : "なし",
      "duration" : 3.5,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "title" : "シーン 14",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.014.jpeg",
      "characterName" : "ナレーション",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg",
      "slideTitle" : "スライド #14",
      "animationName" : "なし",
      "backgroundName" : "image64.jpeg",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "それから僕たちが退避をすると、ごろごろとロビーから形をまだ残していた壁や天井が完全に崩壊してしまった。",
      "id" : "977DFA1C-A67D-49A6-87C5-8C4EE0D463EA",
      "transitionName" : "なし",
      "voiceDuration" : 7.403469387755102,
      "duration" : 7.403469387755102,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "title" : "シーン 15",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.015.jpeg",
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png",
      "slideTitle" : "スライド #15",
      "animationName" : "なし",
      "backgroundName" : "image12.png",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "そして、雨が降り始め、フランたちは皆、\n雨に当たるのを避けて、図書館へとそのまま移動していった。",
      "id" : "52B5A562-2AE2-4BF4-B881-CEC4C55B683E",
      "transitionName" : "なし",
      "voiceDuration" : 6.850634920634921,
      "duration" : 6.850634920634921,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "title" : "シーン 16",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.016.jpeg",
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png",
      "slideTitle" : "スライド #16",
      "animationName" : "なし",
      "backgroundName" : "image12.png",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "そして、外ではごろごろと雷が鳴り始め、僕は、\nとりあえずこの部屋で、彼女の目が覚めるのを待っていた。",
      "id" : "AA343072-D95E-40D3-BD4D-4FA049E62D62",
      "transitionName" : "なし",
      "voiceDuration" : 7.232154195011338,
      "duration" : 7.232154195011338,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "title" : "シーン 17",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.017.jpeg",
      "characterName" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png",
      "slideTitle" : "スライド #17",
      "animationName" : "なし",
      "backgroundName" : "image12.png",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0
    },
    {
