      "sceneIndex" : 44,
      "fadeInDuration" : 0,
      "isReversed" : false,
      "voiceSymbol" : "アレカラ、ロ'ビーノ\/シューゼンガ\/オワッタ+コ'ロニワ、ゲンソー\/キョ'ートユウ\/コトバ'ガ\/フランカラ\/デテク'ル+コト'ワ、<NUMK VAL=\"1\" COUNTER=\"カ'イ\">タ'リトモ\/デ'テ+コ'ナカッタ。",
      "trackId" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "text" : "あれから、ロビーの修繕が終わった頃には、幻想郷という言葉がフランから出てくることは、一回たりとも出てこなかった。",
      "voiceTriggerEnabled" : false,
