      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "title" : "シーン 18",
      "audioTrack" : "track_voice_soumu",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.018.jpeg",
      "characterName" : "操夢",
