      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "すると、彼女の目が覚める。",
      "id" : "26F824F6-A106-412A-BF22-4CFEE92304CE",
      "transitionName" : "なし",
      "voiceDuration" : 1.8952154195011337,
