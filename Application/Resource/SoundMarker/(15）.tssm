      "seStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "telop" : "「あれ、私は一体何を…」\n私はふと目が覚めると、そこは彼が使っている客室だった。",
      "id" : "7694CEF8-26D3-4633-BDA0-D93D43929F0F",
      "transitionName" : "なし",
      "voiceDuration" : 5.305691609977324,
      "duration" : 5.305691609977324,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
