      "transitionName" : "なし",
      "characterName" : "霧雨魔理沙",
      "telop" : "「よう、操夢。これからどこかに行くのか？」",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.004.jpeg",
