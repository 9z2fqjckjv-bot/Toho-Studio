      "transitionName" : "なし",
      "characterName" : "操夢",
      "telop" : "僕は、何か言おうとしている彼女に、\n声を出さないようにと伝える。",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.006.jpeg",
