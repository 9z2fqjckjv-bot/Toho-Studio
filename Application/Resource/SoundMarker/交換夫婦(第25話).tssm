      "duration" : 7.782154195011337,
      "animationName" : "なし",
      "title" : "シーン 20",
      "telop" : "「名前は…伏せときますが、今晩は、この施設で泊まるための許可をとってありますから、安心してください。」",
      "id" : "C0C77C59-D392-4C91-8E9F-1E937BDB5AE6",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.1821541950113374,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "レミリア・スカーレット",
      "slideTitle" : "スライド #21",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_レミリア・スカーレット.wav",
