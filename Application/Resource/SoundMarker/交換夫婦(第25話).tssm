      "duration" : 6.610861678004535,
      "animationName" : "なし",
      "title" : "シーン 12",
      "telop" : "「確かに、レミリアと魔理沙の言う通りね。\nでも、その問題の責任を紫たちは、あなたに転嫁した。」",
      "id" : "85B0FC89-16BA-4B32-8629-E4C3EAECE647",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
