      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.011.jpeg",
      "duration" : 4.217165532879818,
      "animationName" : "なし",
      "title" : "シーン 11",
      "telop" : "「あなただけに、その問題の責任を負わせるつもりかしら…」",
      "id" : "6E0AF4D7-673A-46C8-BE75-5326C9C555FF",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceDuration" : 3.6171655328798185,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "パチュリー・ノーレッジ",
      "slideTitle" : "スライド #12",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_パチュリー・ノーレッジ.wav",
