      "title" : "シーン 47",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.047.jpeg",
