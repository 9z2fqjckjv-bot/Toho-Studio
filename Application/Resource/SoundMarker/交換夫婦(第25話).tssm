      "duration" : 7.134331065759637,
      "animationName" : "なし",
      "title" : "シーン 23",
      "telop" : "「それじゃあ、僕はその場所に行ってきますね。」\n僕はそう言うと、フロアマップを開き、部屋を出た。",
      "id" : "0B07B192-F9F2-4B63-906F-03391326C707",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 6.534331065759638,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
