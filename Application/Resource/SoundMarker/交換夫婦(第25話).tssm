      "duration" : 6.458231292517007,
      "animationName" : "なし",
      "title" : "シーン 9",
      "telop" : "「えっと…」\n私は、彼の問いかけにどう答えるべきかわからず、そう呟く。",
      "id" : "48A27687-EA20-41ED-A1B8-698188623C0E",
      "audioTrack" : "track_voice_reimu",
      "voiceDuration" : 5.858231292517007,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "霧雨魔理沙",
      "slideTitle" : "スライド #10",
      "voiceCharacter" : "霧雨魔理沙",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_霧雨魔理沙.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
