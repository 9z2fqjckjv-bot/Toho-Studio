      "id" : "99715F04-B4D0-4634-882F-5CC0535D4657",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.386507936507937,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #71",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.071.jpeg",
      "duration" : 6.108253968253968,
      "animationName" : "なし",
      "title" : "シーン 71",
      "telop" : "「彼女がそばにいた方が、理に適っているからです。」\n僕はそう、小声で返す。",
      "id" : "22CF243A-656A-4C17-8983-35EEEF029263",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 5.508253968253968,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #72",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.072.jpeg",
      "duration" : 4.515578231292517,
      "animationName" : "なし",
      "title" : "シーン 72",
      "telop" : "「んっ…ここは…」\n私は、ふと目が覚めると、そう呟く。",
      "id" : "27B147F2-ABE6-4E7A-986C-80860833F44C",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 3.915578231292517,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #73",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.073.jpeg",
      "duration" : 7.063582766439909,
      "animationName" : "なし",
      "title" : "シーン 73",
      "telop" : "すると、脳が急に覚醒したかのように、思い出す。\n「私が操夢さんに愚痴こぼしてたら…寝落ちした…」",
      "id" : "A49F812A-AA1A-4A80-A2FC-004285060259",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.4635827664399095,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #74",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.074.jpeg",
      "duration" : 5.577596371882086,
      "animationName" : "なし",
      "title" : "シーン 74",
      "telop" : "「なんだか…申し訳ないです…。」\n私は、羞恥心でそんな言葉を彼に言う。",
      "id" : "0AEA880F-5B9B-4A00-8D37-B57DD81B1616",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 4.977596371882086,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #75",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.075.jpeg",
      "duration" : 5.027823129251701,
      "animationName" : "なし",
      "title" : "シーン 75",
      "telop" : "「いえいえ、大丈夫ですよ。」\n僕はそう呟く彼女にそう返す。",
      "id" : "4AAE1D62-78FA-4DC4-A442-B39B3287934F",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 4.427823129251701,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #76",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.076.jpeg",
      "duration" : 5.640861678004534,
      "animationName" : "なし",
      "title" : "シーン 76",
      "telop" : "「これで全員、揃いましたね…。\n霊夢さんたちは、準備は万端ですか？」",
      "id" : "5961811B-351F-4608-9D04-3E55665B4471",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 5.040861678004535,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #77",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.077.jpeg",
      "seName" : "SE: nc146478_【東方アレンジ】紅の予感【東方動画BGM支援】",
      "seAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/BGM\/nc146478_【東方アレンジ】紅の予感【東方動画BGM支援】.wav",
      "duration" : 8.43,
      "animationName" : "なし",
      "title" : "シーン 77",
      "telop" : "僕がそう問いかけると、僕のポケベルから着信音が鳴る。\n僕は、すぐさま操作盤に繋げ、スピーカーにして出る。",
      "id" : "72B2E572-6531-44A9-93A9-5BD656F1E800",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.83,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #78",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.078.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 78",
      "telop" : "「もしもし、みとりさん、どうしましたか？」",
      "id" : "5AAD700C-DCFE-40E3-8BBD-228B213FD9BB",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 2.83,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "八雲紫",
      "slideTitle" : "スライド #79",
      "voiceCharacter" : "八雲紫",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_079_八雲紫.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.079.jpeg",
      "duration" : 6.338208616780045,
      "animationName" : "なし",
      "title" : "シーン 79",
      "telop" : "「操夢さん、今すぐにその研究所を出てください！\n紫からの追手が迫っています！」",
      "id" : "3A379AE9-6088-498F-BBEE-AA8AC9D8449C",
      "audioTrack" : "track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB",
      "voiceDuration" : 5.645714285714286,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #80",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.080.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 80",
      "telop" : "「それで、移動手段は？」",
      "id" : "EE3CBBEC-D082-40E2-BC07-948E2826A7FB",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 1.7278231292517008,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #81",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.081.jpeg",
      "duration" : 7.912380952380952,
      "animationName" : "なし",
      "title" : "シーン 81",
      "telop" : "「今、その研究所の屋上に専用機が待機しているので、\n今すぐに屋上から、施設を離れてください！」",
      "id" : "FA84A0DD-5CF3-4A56-B98F-88A937BB70BB",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceDuration" : 7.312380952380952,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #82",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.082.jpeg",
      "duration" : 6.048458049886621,
      "animationName" : "なし",
      "title" : "シーン 82",
      "telop" : "すると、なぜか通話が強制終了になった。\n「急いで、屋上に向かいますよ。」",
      "id" : "FA6F474A-BA07-4C3D-952C-9CDED4F840C1",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 5.4484580498866215,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #83",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.083.jpeg",
      "duration" : 7.360430839002267,
      "animationName" : "なし",
      "title" : "シーン 83",
      "telop" : "僕たちは、そこから屋上に上がると、止まっていたヘリコプターに乗り込み、僕は、運転席に座る。\n察しのいい人には乗り物が見えます…",
      "id" : "E13AF94B-C928-4088-A975-28FE22233C5E",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.760430839002267,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #84",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.084.jpeg",
      "duration" : 6.812607709750567,
      "animationName" : "なし",
      "title" : "シーン 84",
      "telop" : "そして、頭の中でヘリコプターの運転マニュアルを読み込みながら、同時にヘリコプターを離陸させる。\n察しのいい人には乗り物が見えます…",
      "id" : "8A8FA891-E48A-49AD-AC75-8168FFA447EB",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.212607709750567,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #85",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.085.jpeg",
      "duration" : 4.594126984126984,
      "animationName" : "なし",
      "title" : "シーン 85",
      "telop" : "そして、そのまま彼女の現在地…沖縄に向かうのだった。\n察しのいい人には乗り物が見えます…",
      "id" : "5862EA28-B694-4C8D-85A6-6E7F69639BC2",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 3.994126984126984,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "telop" : "次回予告",
      "duration" : 3,
      "backgroundName" : "単色背景",
      "title" : "シーン 86: 次回予告",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.086.jpeg",
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "id" : "FC9EAFF2-AA69-401E-9D8F-73B2531A7657",
      "slideTitle" : "スライド #86",
      "transitionName" : "クロスディゾルブ"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #87",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.087.jpeg",
      "duration" : 9.396303854875283,
      "animationName" : "なし",
      "title" : "シーン 87",
      "telop" : "僕たちは、沖縄の某所につくと、みとりとそこで話す。\n僕たちが離陸して数十分後に、紫からの追手が来た様だった。",
      "id" : "05064DA1-2957-48C0-9293-8E462C938B46",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 8.796303854875283,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #88",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.088.jpeg",
      "duration" : 7.856077097505668,
      "animationName" : "なし",
      "title" : "シーン 88",
      "telop" : "そこで、僕は、予定していた計画を前倒しにし、\nその場、今後を霊夢たちと話し合い、実行に移す。",
      "id" : "998CB549-9192-4055-842E-B8954AE51E67",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.256077097505669,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #89",
      "voiceCharacter" : "操夢",
