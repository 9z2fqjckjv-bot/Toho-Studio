    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #53",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.053.jpeg",
      "duration" : 4.837596371882086,
      "animationName" : "なし",
      "title" : "シーン 53",
      "telop" : "僕は、ふとポケベルを取り出す。日の出まであと数時間だった。",
      "id" : "BE6671B9-F893-4D4C-880C-285123D99634",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 4.237596371882086,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #54",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.054.jpeg",
      "duration" : 6.7169387755102035,
      "animationName" : "なし",
      "title" : "シーン 54",
      "telop" : "僕はポケベルをポケットにしまうと、そっと彼女を起こさないように近づき、彼女をゆっくりと背負う。",
      "id" : "AED03E51-54C1-4785-BB46-6551F04BDF4E",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.116938775510204,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #55",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.055.jpeg",
      "duration" : 10.164761904761905,
      "animationName" : "なし",
      "title" : "シーン 55",
      "telop" : "すると、彼女が寝言をつぶやく。僕は、そんな彼女の寝言に、小さく「そうですか…」と返すと、彼女の足に僕の腕を絡ませる。",
      "id" : "85BC3628-5076-4145-B626-D9E9D46406CB",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 9.564761904761905,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #56",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.056.jpeg",
      "duration" : 6.032154195011337,
      "animationName" : "なし",
      "title" : "シーン 56",
      "telop" : "そして、二つのスーツケースを手に取りつかむと、\nゆっくりと歩き、駅のほうに向かう。",
      "id" : "4C65E2FF-67B4-4324-B3C6-AFF81E6C771D",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 5.4321541950113374,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #57",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.057.jpeg",
      "duration" : 9.047369614512471,
      "animationName" : "なし",
      "title" : "シーン 57",
      "telop" : "そして、駅に着くと、無人の改札を通り、彼女が寝静まった後に、密かに動かしていた列車に乗り込み、出発した。",
      "id" : "F9E2CC92-DE25-49FE-9F08-7D07F700D3AB",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.447369614512471,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc260102_田舎の駅前（夜）.jpg"
    },
    {
      "telop" : "一方その頃、霊夢たちは…",
      "duration" : 3,
      "backgroundName" : "単色背景",
      "title" : "シーン 58: 一方その頃、霊夢たちは…",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.058.jpeg",
      "animationName" : "なし",
      "characterName" : "博麗霊夢",
      "id" : "8E9D68AE-2351-4F9C-A8C0-6E6A59B93A8D",
      "slideTitle" : "スライド #58",
      "transitionName" : "クロスディゾルブ"
    },
    {
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #59",
      "voiceCharacter" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.059.jpeg",
      "duration" : 5.745736961451247,
      "animationName" : "なし",
      "title" : "シーン 59",
      "telop" : "私はふと目が覚めると、そこは西東京研究所の仮眠室だった。",
      "id" : "93480742-C878-4F84-B2AD-B5697EDA9BBC",
      "audioTrack" : "track_voice_reimu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 5.145736961451247,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "博麗霊夢",
      "slideTitle" : "スライド #60",
      "voiceCharacter" : "博麗霊夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_博麗霊夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.060.jpeg",
      "duration" : 8.944489795918367,
      "animationName" : "なし",
      "title" : "シーン 60",
      "telop" : "「まだ、暗い…」ふとそうつぶやく。私が、そう言いながら、目を瞑ろうとすると、誰かが戸を叩く。",
      "id" : "402F8F12-95C8-40E8-845D-D5083FAE80AA",
      "audioTrack" : "track_voice_reimu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 8.344489795918367,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "博麗霊夢",
