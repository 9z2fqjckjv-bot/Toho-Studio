      "duration" : 6.171315192743764,
      "animationName" : "なし",
      "title" : "シーン 21",
      "telop" : "「そう…」私は、一つの懸念が浮かぶが、\n強く問いただすこともなく、そう呟く。",
      "id" : "7218E98B-C788-4990-BBF7-7E06AD90AA9C",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "voiceDuration" : 5.571315192743764,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #22",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.022.jpeg",
      "duration" : 8.564761904761905,
      "animationName" : "なし",
      "title" : "シーン 22",
      "telop" : "「レミリアさんたちが寝ている間に、戻りますから、それまで、このフロアマップを見て、部屋分けした後、休んでください。」",
      "id" : "16015B0B-6BC6-494B-B353-A11DEE9E3C8C",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.964761904761905,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #23",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
