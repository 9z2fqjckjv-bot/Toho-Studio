      "telop" : "「んっ…」",
      "id" : "75590E01-5DFD-49A2-BCDC-0FC8ACE36AC7",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 1.5,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #36",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.036.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 36",
      "telop" : "「どうします、今すぐ出てもいいですけど…」",
      "id" : "C05C3743-651F-4270-A2B9-774800A58B54",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 2.413582766439909,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #37",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.037.jpeg",
      "duration" : 5.5778231292517,
      "animationName" : "なし",
      "title" : "シーン 37",
      "telop" : "僕はそう言われ、時間を確かめる。\nだが、終電の時刻は過ぎていた。",
      "id" : "49E2F1A3-FA13-4B38-B133-378382DDC18E",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 4.977823129251701,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #38",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.038.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 38",
      "telop" : "「私の家に泊まって行きますか？」",
      "id" : "71C9E1DC-90C7-4EDF-B6C0-BD391B6D1EBB",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 1.9535827664399092,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #39",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.039.jpeg",
      "duration" : 7.638684807256236,
      "animationName" : "なし",
      "title" : "シーン 39",
      "telop" : "僕は考える、タクシーを呼べば、すぐに戻れるが、タクシーを呼ぶのには、政府の網にはまるリスクも伴う…。",
      "id" : "8C38B1B9-C35E-41E3-82EA-BEA431BD3206",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.038684807256236,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #40",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.040.jpeg",
      "duration" : 6.824557823129251,
      "animationName" : "なし",
      "title" : "シーン 40",
      "telop" : "「すでに終電は過ぎてるので、今晩は泊まって、\n明朝には向こうにつけるようにしようと思います。」",
      "id" : "74C950AB-8A0F-4DCC-ADB4-E59F244B8484",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 6.224557823129252,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #41",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.041.jpeg",
      "duration" : 7.738684807256235,
      "animationName" : "なし",
      "title" : "シーン 41",
      "telop" : "「それで、文さんは、普段記者として活動する中で、\n周りの人々に対する愚痴や不満などはありますか？」",
      "id" : "4CB7F14C-B1C4-46A8-AAF8-2E449B715EF7",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.138684807256236,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #42",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.042.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 42",
      "telop" : "「どうしてそんなことを言うのですか？」",
      "id" : "83427612-67EA-4684-BD02-D18076F78896",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 1.937596371882086,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #43",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.043.jpeg",
      "duration" : 8.132154195011339,
      "animationName" : "なし",
      "title" : "シーン 43",
      "telop" : "「明朝までには、向こうについてる必要があり、寝ていたら、きっと間に合わないので、今夜は、睡眠0ですよ。」",
      "id" : "239C6C79-FDC0-4E34-B9C3-76AEB5D257E3",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 7.532154195011338,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #44",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.044.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 44",
      "telop" : "「でも私は…」",
      "id" : "6D367F57-4329-49B6-9AB0-CE6A1AEA5D45",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 1.5,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "操夢",
      "slideTitle" : "スライド #45",
      "voiceCharacter" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.045.jpeg",
      "duration" : 9.186507936507937,
      "animationName" : "なし",
      "title" : "シーン 45",
      "telop" : "「睡眠が0時間になるのは、僕だけでいいですから、文さんは眠たかったら、寝て大丈夫ですよ。寝たら背負って移動するので。」",
      "id" : "395F4AEF-8B89-4C44-9959-41716B680AA8",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 8.586507936507937,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
