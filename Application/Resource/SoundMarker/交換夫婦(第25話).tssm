      "duration" : 9.704489795918366,
      "animationName" : "なし",
      "title" : "シーン 10",
      "telop" : "「さっきまで、乗せてたお客さんから聞いたんだが、守谷神社は、この問題には関わってないと硬い態度…だそうだぜ。」",
      "id" : "DDC7DFA2-B8E7-4635-94F6-F45517A6780D",
      "audioTrack" : "track_voice_marisa",
      "voiceDuration" : 9.104489795918367,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "レミリア・スカーレット",
      "slideTitle" : "スライド #11",
      "voiceCharacter" : "レミリア・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_レミリア・スカーレット.wav",
