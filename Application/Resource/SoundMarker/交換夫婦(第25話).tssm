      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 49",
      "telop" : "「これで、準備は万端ですか？」",
      "id" : "0C650FD7-C845-44F0-B38E-9C20472EEA59",
      "audioTrack" : "track_voice_soumu",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 2.156077097505669,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
      "characterName" : "射命丸文",
      "slideTitle" : "スライド #50",
      "voiceCharacter" : "射命丸文",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_射命丸文.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png",
