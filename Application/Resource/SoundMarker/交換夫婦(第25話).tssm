      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.018.jpeg",
      "duration" : 9.288684807256235,
      "animationName" : "なし",
      "title" : "シーン 18",
      "telop" : "「僕は、とりあえず、問題が発覚したスクープを掲載した記者に、記者会見の内容の否定と、協力をお願いする予定です。」",
      "id" : "AAAC7EBF-14DC-40DA-8691-2959E9CD6C12",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.688684807256235,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "咲夜困り顔.png"
    },
    {
      "characterName" : "レミリア・スカーレット",
      "slideTitle" : "スライド #19",
      "voiceCharacter" : "レミリア・スカーレット",
