      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_射命丸文.wav",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.046.jpeg",
      "duration" : 3.5,
      "animationName" : "なし",
      "title" : "シーン 46",
      "telop" : "「そうですか…、ちょっと待っててください。」",
      "id" : "E799650F-A18C-4B3F-9F4A-0A93F50B3C78",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voiceDuration" : 2.2615873015873014,
      "transitionName" : "クロスディゾルブ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg"
    },
    {
