      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "telop" : "「それで、どこか空き部屋はありますか？」",
      "backgroundName" : "nc73545_【背景素材】地霊殿.jpg",
      "id" : "0C67A2B0-78E4-4EBB-8A3A-23FF92A78FE5",
      "title" : "シーン 12",
      "slideTitle" : "スライド #12"
    },
    {
      "voiceDuration" : 5.096984126984127,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "古明地さとり",
