    },
    {
      "voiceDuration" : 2.7244897959183674,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 3.5,
      "characterName" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_フランドール・スカーレット.wav",
      "telop" : "「ねぇ…、あなたの血…吸ってもいい？」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "E1EB3D3D-590A-44E6-841D-93D2E425FB32",
      "title" : "シーン 23",
      "slideTitle" : "スライド #23"
    },
    {
      "voiceDuration" : 7.6191156462585035,
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "操夢",
      "duration" : 8.219115646258503,
      "characterName" : "操夢",
      "seName" : "SE: 噛みつく",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav",
      "telop" : "「いいですよ。」僕は、そういうと、ベッドに腰掛ける。\nすると、フランが僕に噛みつき、血が吸われていく。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "4B715DB2-5682-498F-9635-8BA0053623A0",
      "title" : "シーン 24",
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/噛みつく.mp3",
      "slideTitle" : "スライド #24"
    },
    {
      "voiceDuration" : 8.3356462585034,
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "操夢",
      "duration" : 8.9356462585034,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav",
      "telop" : "すると、今までうまく押さえ込んでいたあのポッキーの成分が全身を駆け巡る様な感覚にさらされ、数分後には眠りについた。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "18679012-E772-41D0-A6FC-032B32DF2324",
      "title" : "シーン 25",
      "slideTitle" : "スライド #25"
    },
    {
      "voiceDuration" : 7.254489795918367,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 7.854489795918367,
      "characterName" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_フランドール・スカーレット.wav",
      "telop" : "私は、彼の血を吸ううちに、だんだんと何かが崩れていき、\n吸血が終わるとあることを呟く。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "50851862-0E42-403E-B3B4-E7A35F1D71E1",
      "title" : "シーン 26",
      "slideTitle" : "スライド #26"
    },
    {
      "voiceDuration" : 9.011995464852607,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 9.611995464852606,
      "characterName" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_フランドール・スカーレット.wav",
      "telop" : "「えへへへ…、ねぇ…あなたに拒否権はないからね…」\n私は、そういうと、彼を跨ぐようにのると、ある行動に出た。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
