      "slideTitle" : "スライド #10"
    },
    {
      "voiceDuration" : 5.397392290249433,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "古明地さとり",
      "duration" : 5.997392290249433,
      "characterName" : "古明地さとり",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_古明地さとり.wav",
      "telop" : "「おや、今日はお連れさんがいるのですか、珍しい…」\n私は、彼が背負っている女性を見ながらそう呟く。",
      "backgroundName" : "nc73545_【背景素材】地霊殿.jpg",
