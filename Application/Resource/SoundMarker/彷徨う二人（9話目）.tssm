      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 3.5,
      "characterName" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav",
      "telop" : "「あれ…ここは…どこ…？」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "8DFD7340-C4BC-42F2-A201-0361CC7005DE",
      "title" : "シーン 18",
      "slideTitle" : "スライド #18"
    },
    {
      "voiceDuration" : 3.3365079365079366,
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "操夢",
      "duration" : 3.9365079365079367,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "telop" : "「目が覚めましたか。ここは、地底園ですよ。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "A929D04C-305F-4A53-B513-6111217ACBEE",
      "title" : "シーン 19",
      "slideTitle" : "スライド #19"
    },
    {
      "voiceDuration" : 1.5,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 3.5,
      "characterName" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav",
      "telop" : "「地底園...？」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "C521937F-CBE6-4643-AE97-385B7F547A97",
      "title" : "シーン 20",
      "slideTitle" : "スライド #20"
    },
    {
      "voiceDuration" : 8.271950113378685,
      "animationName" : "なし",
      "audioTrack" : "track_voice_soumu",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "操夢",
      "duration" : 8.871950113378684,
      "characterName" : "操夢",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav",
      "telop" : "「そうです。今から１世紀ほど前に起きたとある大地震とその後に、起こったいくつかの地震で穴が開き、できたんですよ。」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "60C6FD4B-2902-4F5D-A286-6BCA972753F0",
      "title" : "シーン 21",
      "slideTitle" : "スライド #21"
    },
    {
      "voiceDuration" : 4.086984126984127,
      "animationName" : "なし",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "transitionName" : "クロスディゾルブ",
      "voiceCharacter" : "フランドール・スカーレット",
      "duration" : 4.686984126984127,
      "characterName" : "フランドール・スカーレット",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav",
      "telop" : "「へぇ…」\n私は、そう返すと、お腹が空いてくる。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "FABBD1E8-B707-4BD1-8EA9-D82A7578DBAC",
      "title" : "シーン 22",
