      "voiceCharacter" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.011.jpeg",
      "transitionName" : "なし"
    },
    {
      "voiceDuration" : 6.806734693877551,
      "seStartTimeOffset" : 0,
