      "transitionName" : "なし"
    },
    {
      "voiceDuration" : 3.838684807256236,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
