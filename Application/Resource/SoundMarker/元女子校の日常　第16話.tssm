      "title" : "シーン 45",
      "voiceCharacter" : "レミリア・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.045.jpeg",
      "transitionName" : "なし"
    },
