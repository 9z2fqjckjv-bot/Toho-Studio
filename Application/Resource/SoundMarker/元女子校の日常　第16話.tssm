      "voiceStartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "telop" : "「私は、ここで何してたのかしら…。」\n私は、どこか記憶が抜け落ちているような感覚がし、そう言う。",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "duration" : 7.40673469387755,
      "id" : "3007E02F-979D-433B-A9C5-6F063F0B8477",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_レミリア・スカーレット.wav",
      "title" : "シーン 12",
      "voiceCharacter" : "レミリア・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.012.jpeg",
      "transitionName" : "なし"
    },
    {
      "voiceDuration" : 10.398979591836735,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "フランドール・スカーレット",
      "slideTitle" : "スライド #13",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "telop" : "「確か、夕飯食べた後、紅夢がいなくなって、探して…」私は、長い時間をかけて彼を探すとこで記憶がぷつりと消えていた。",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "duration" : 10.998979591836735,
      "id" : "47097095-17AB-4C4D-AB46-2656CE225305",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_フランドール・スカーレット.wav",
