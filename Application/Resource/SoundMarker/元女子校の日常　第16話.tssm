      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "telop" : "僕は、そのときの内容と全く同じ内容を、二人話す。",
