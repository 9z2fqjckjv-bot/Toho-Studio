      "id" : "FA7B8DFF-97DB-49EE-806E-0D88829C0B99",
      "title" : "シーン 56",
      "voiceCharacter" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.056.jpeg",
      "transitionName" : "なし"
    },
