      "title" : "シーン 40",
      "voiceCharacter" : "レミリア・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.040.jpeg",
      "transitionName" : "なし"
    },
    {
      "voiceDuration" : 8.077573696145125,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png",
      "animationName" : "なし",
      "backgroundName" : "nc196979_食堂(昼).png",
      "characterName" : "レミリア・スカーレット",
      "slideTitle" : "スライド #41",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "telop" : "私が咲夜を連れて、食堂に戻ると、そこではフランが驚きの表情をしていた。「フラン、キッチンから紅茶を出してちょうだい。」",
      "audioTrack" : "track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "duration" : 8.677573696145124,
      "id" : "B69990CA-61BD-44B1-9C19-8898E2C7F7CF",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_レミリア・スカーレット.wav",
      "title" : "シーン 41",
      "voiceCharacter" : "レミリア・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.041.jpeg",
      "transitionName" : "なし"
    },
    {
      "voiceDuration" : 6.794489795918367,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc196979_食堂(昼).png",
      "characterName" : "フランドール・スカーレット",
      "slideTitle" : "スライド #42",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "telop" : "「わかった、今からとってくるね。」\n私はそう言うと、紅茶をとりにキッチンに向かった。",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
