      "voiceCharacter" : "十六夜咲夜",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.044.jpeg",
      "transitionName" : "なし"
    },
    {
