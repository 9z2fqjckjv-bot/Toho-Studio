      "transitionName" : "なし"
    },
    {
      "voiceDuration" : 2.224285714285714,
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png",
