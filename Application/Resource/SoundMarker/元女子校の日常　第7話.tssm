      "duration" : 6.819115646258503
    },
    {
      "telop" : "すると、教室の扉が開き、さとりが早苗師匠と読んでいた女性が入ってくる。そして、僕は、女子たちの挨拶に合わせる。",
      "slideTitle" : "スライド #42",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.042.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 42",
      "id" : "159D24E4-2425-4672-AB52-E323104F2F9D",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav",
