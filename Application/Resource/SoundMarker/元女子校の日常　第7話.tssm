      "duration" : 10.046984126984126
    },
    {
      "telop" : "すると、彼は、私の方を真正面に見つめ、ある言葉を告げる。",
      "slideTitle" : "スライド #29",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.029.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
