      "duration" : 4.175646258503401
    },
    {
      "telop" : "「それで、誰かお台場に行ったことがある人は…」",
      "slideTitle" : "スライド #58",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.058.jpeg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 58",
      "id" : "AE077822-1408-4CD1-9C6D-890CC4166382",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_058_アリス・マーガトロイド.wav",
      "voiceDuration" : 2.415374149659864,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 3.015374149659864
    },
    {
      "telop" : "「僕は…昔に家族で何度か行きました…」",
      "slideTitle" : "スライド #59",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.059.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 59",
      "id" : "B6D7B0BF-A696-49E6-9E05-299773B93B16",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_059_操夢.wav",
      "voiceDuration" : 2.914761904761905,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 3.514761904761905
    },
    {
      "telop" : "「私は、名前は知っているけど行ったことはないよ…」",
      "slideTitle" : "スライド #60",
      "voiceCharacter" : "古明地こいし",
      "characterName" : "古明地こいし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.060.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 60",
      "id" : "EEFB0427-E294-428D-9FB5-4F11DEBC2874",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_060_古明地こいし.wav",
      "voiceDuration" : 4.545283446712018,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 5.145283446712018
    },
    {
      "telop" : "「私も、こいしと一緒ですよ…」",
      "slideTitle" : "スライド #61",
      "voiceCharacter" : "古明地さとり",
      "characterName" : "古明地さとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.061.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 61",
      "id" : "76BF6133-E4C8-4013-BC0B-A19CC193852B",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_古明地さとり.wav",
      "voiceDuration" : 1.7693877551020407,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 2.5
    },
    {
      "telop" : "「私は…国際展示場での発表で何度かだけ…です。」",
      "slideTitle" : "スライド #62",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.062.jpeg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 62",
      "id" : "F4D3401C-4B76-43AD-BE0E-8272A4839B33",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_アリス・マーガトロイド.wav",
      "voiceDuration" : 3.3113378684807255,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 3.9113378684807256
    },
    {
      "telop" : "「そうですか…」僕がそう言っていると、扉が開く。",
      "slideTitle" : "スライド #63",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.063.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seName" : "[SE] 教室の戸を開ける.mp3",
      "animationName" : "なし",
      "title" : "シーン 63",
      "id" : "44066A9E-BA7A-4B97-B26F-48B241594405",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav",
      "voiceDuration" : 3.499546485260771,
      "seStartTimeOffset" : 2.49,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "seVolume" : 0.85,
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "duration" : 4.099546485260771,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3"
    },
    {
      "telop" : "「おや、みなさん、お揃いのようで…」\n私はそう言いながら、ある紙を出し、机に置く。",
      "slideTitle" : "スライド #64",
      "voiceCharacter" : "十六夜咲夜",
      "characterName" : "十六夜咲夜",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.064.jpeg",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 64",
      "id" : "C6AA4C4F-79EF-4BD3-B479-E6D5885093D4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_十六夜咲夜.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "voiceDuration" : 5.068095238095238,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "seVolume" : 1,
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "duration" : 5.668095238095238
    },
    {
      "telop" : "「これは、遠足ノートです。あなたたちの班は、遠足にかかる費用が、全額学校負担になってますので、確認してください。」",
      "slideTitle" : "スライド #65",
      "voiceCharacter" : "十六夜咲夜",
      "characterName" : "十六夜咲夜",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.065.jpeg",
      "audioTrack" : "track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 65",
      "id" : "79C1CBEC-A80A-4A9D-8768-B5877F111B57",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_十六夜咲夜.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png",
      "voiceDuration" : 7.783083900226758,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "seVolume" : 1,
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "duration" : 8.383083900226758
    },
    {
      "telop" : "突如やってきて、ノートを残し、彼女が去ると、こいしたちが驚いた表情を見せる。僕も、内心驚いていた…。",
      "slideTitle" : "スライド #66",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.066.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 66",
      "id" : "3745EA4E-A85C-4EF5-82ED-A67B2C61E862",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png",
      "voiceDuration" : 7.988684807256236,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "seVolume" : 1,
      "transitionName" : "なし",
      "voiceStartTimeOffset" : 0,
      "duration" : 8.588684807256236
    },
    {
      "telop" : "「一体これは、なぜこんな待遇なのでしょう…、普通だったら、必要な費用は自前調達ですが…、学校が全額負担とは…」",
      "slideTitle" : "スライド #67",
      "voiceCharacter" : "古明地さとり",
      "characterName" : "古明地さとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.067.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 67",
      "id" : "2D8D5B6F-3BD1-4F17-B8B8-4754B13A0DB4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_古明地さとり.wav",
      "voiceDuration" : 6.498798185941043,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 7.0987981859410425
    },
    {
      "telop" : "「さぁ、わからないです…。」僕はそう言うと、ふとそのノートを取って中身を見る。そこには、ある内容が書かれていた。",
      "slideTitle" : "スライド #68",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.068.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 68",
      "id" : "9E0AF116-288D-40BD-B8D5-0FBCAE988C53",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav",
      "voiceDuration" : 7.901723356009071,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.501723356009071
    },
    {
      "telop" : "「全国財閥校統一模試…」そのノートには、僕がこの試験を遠足の2週間前に受けて、その結果が遠足に関わると書いてあった。",
      "slideTitle" : "スライド #69",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.069.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 69",
      "id" : "15845D3A-C7B4-4790-836B-51CD1F048915",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav",
      "voiceDuration" : 9.144126984126984,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 9.744126984126984
    },
    {
      "telop" : "「これ…、私たちのような偏差値や学力に加えて、\nそれなりに敷居が高い学校で生き残るための模擬試験ですよ…」",
      "slideTitle" : "スライド #70",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.070.jpeg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 70",
      "id" : "33CF38CD-2A4E-413B-A6E4-B3BC24C05499",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_アリス・マーガトロイド.wav",
      "voiceDuration" : 6.028639455782313,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 6.628639455782313
    },
    {
      "telop" : "「確か、一般的な高校入試とは、別枠の財力を持つ家の子どもが受けるやつですよね…、僕は、受けてませんが…」",
      "slideTitle" : "スライド #71",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.071.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 71",
      "id" : "5FAE134B-D209-45E2-BABB-C0E8E4762DB4",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav",
      "voiceDuration" : 7.9452154195011335,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.545215419501133
    },
    {
      "telop" : "そして、遠足以外にも、僕が受けたこの試験の結果は、彼女たちの今後も左右する可能性があると…記載されていた…。",
      "slideTitle" : "スライド #72",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.072.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 72",
      "id" : "E6CA5F66-A4B5-4E22-AA05-49702FF26ED8",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_072_操夢.wav",
      "voiceDuration" : 8.1278231292517,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.7278231292517
    },
    {
      "telop" : "「これは…実質的に、こいしさんたちの学業が、僕の試験の結果の内容によって左右する…、どんな目的でこんなことを…」",
      "slideTitle" : "スライド #73",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.073.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 73",
      "id" : "3B0FE1A2-F6B0-47FB-A1B5-D66C65A57182",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_操夢.wav",
      "voiceDuration" : 8.423469387755102,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 9.023469387755101
    },
    {
      "telop" : "「さぁ、私には分かりませんが、少なくとも、私たちの学校生活に関わるということは…確定しているみたいです…」",
      "slideTitle" : "スライド #74",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.074.jpeg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 74",
      "id" : "82101C42-90D3-4CDC-A51F-01CF50D3BD09",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_アリス・マーガトロイド.wav",
      "voiceDuration" : 6.435941043083901,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 7.0359410430839
    },
    {
      "telop" : "僕はそこから、ノートを読み進めると、遠足の流れや、予定に加え、彼女たちの学業にも関わる試験だと詳細に書かれていた。",
      "slideTitle" : "スライド #75",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.075.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 75",
      "id" : "787C6718-289E-4238-931E-59A97878C065",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav",
      "voiceDuration" : 8.888684807256237,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 9.488684807256236
    },
    {
      "telop" : "そして、最後にこう書いてあった。模擬試験は筆記による通常の試験を2週間後、そしてその他の試験を遠足後に行うと…。",
      "slideTitle" : "スライド #76",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.076.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 76",
      "id" : "CA8E4853-B30B-439E-989E-1DEAFD83EE80",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_操夢.wav",
      "voiceDuration" : 8.37891156462585,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.97891156462585
    },
    {
      "telop" : "僕は、これまでたくさんの時間を勉学に使い、励んできたきたが、ここでは、それを違った形で要求されるようだった。",
      "slideTitle" : "スライド #77",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.077.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 77",
