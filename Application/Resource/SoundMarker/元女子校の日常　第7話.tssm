      "duration" : 2.5
    },
    {
      "telop" : "彼女がそう言うと、女子たちが一斉に着席し、\n僕もそれに合わせる。すると、彼女が話し始める。",
      "slideTitle" : "スライド #44",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.044.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 44",
      "id" : "A1B7F8C0-C14D-4661-BDA2-298B28BC9F9E",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav",
      "voiceDuration" : 7.093038548752834,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 7.693038548752834
    },
    {
      "telop" : "「これから、放送で遠足に関する注意事項と、規定の放送、そして、あらかじめ決められた特定の生徒の班分け表を配ります。」",
      "slideTitle" : "スライド #45",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.045.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 45",
      "id" : "6ADC40CC-1F00-4773-BB4E-C9409077DF21",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_東風谷早苗.wav",
      "voiceDuration" : 8.402222222222223,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.002222222222223
    },
    {
      "telop" : "「特定の生徒の班分けも放送されるので、よく聞くように。」",
      "slideTitle" : "スライド #46",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.046.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 46",
      "id" : "08D349D0-FB40-47FB-95D4-5DEBF8E8E3D9",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_東風谷早苗.wav",
      "voiceDuration" : 3.756848072562358,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
