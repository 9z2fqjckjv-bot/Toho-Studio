      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 6.590861678004535
    },
    {
      "telop" : "元女子校の日常",
      "slideTitle" : "スライド #10",
      "characterName" : "博麗霊夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.010.jpeg",
