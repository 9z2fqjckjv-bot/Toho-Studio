      "duration" : 4.356848072562358
    },
    {
      "telop" : "彼女がそう言うと、校内放送が流れる。そして、その放送の最後に流れた、事前に決められた班分けに教室が、ざわつく。",
      "slideTitle" : "スライド #47",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.047.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 47",
      "id" : "F0F2083D-5ADE-4AF4-8778-729C610143FD",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav",
      "voiceDuration" : 9.010430839002268,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.610430839002268
    },
    {
      "telop" : "「静かに、放送でもあった通り、K-3組の古明地こいし、当クラスの古明地さとり、藤原紅夢、U-4組のアリス・マーガトロイドは同じ班で行動してもらいます。」",
      "slideTitle" : "スライド #48",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.048.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 48",
      "id" : "60775F06-C55F-4CB4-B544-8A7932F69D93",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_東風谷早苗.wav",
      "voiceDuration" : 10.78111111111111,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 11.38111111111111
    },
    {
      "telop" : "「今から、当クラスから該当する藤原さんと古明地さんには、放送で指定された、別室にて、話し合いを進めてもらいます。二人は帰りの支度を持っていくように。」",
      "slideTitle" : "スライド #49",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.049.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 49",
      "id" : "AEF00D6F-C3D4-40D5-B376-04B92F3E1A28",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_東風谷早苗.wav",
      "voiceDuration" : 10.562857142857142,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 11.162857142857142
    },
    {
      "telop" : "僕は、困惑しながらも、見知らぬ女子と行動するよりかは、マシかと…、そう決めて、帰りを支度を済ませ、教室を出た。",
      "slideTitle" : "スライド #50",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.050.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 50",
      "id" : "C4538338-95BA-4240-AA7D-4B27C613D73D",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav",
      "voiceDuration" : 8.299546485260771,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 8.899546485260771
    },
    {
      "telop" : "彼が別室に向かうと…",
      "slideTitle" : "スライド #51",
      "characterName" : "ナレーション",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.051.jpeg",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 51",
      "id" : "13271376-603D-43C1-9EDE-B05F8963C08E",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.5
    },
    {
      "telop" : "それから、僕が、指定された部屋にさとりと共に入ると、\nすでに、他のクラスからきた2人は、部屋で待っていた。",
      "slideTitle" : "スライド #52",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.052.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 52",
      "id" : "D6BF5BF8-D407-46CB-893E-FCEACD2D0A65",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "voiceDuration" : 7.693038548752835,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 8.293038548752834
    },
    {
      "telop" : "すると、沈黙の時間と、変な空気感が部屋を包み込む。",
      "slideTitle" : "スライド #53",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.053.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 53",
      "id" : "EAF795ED-F4AE-4A03-806A-F07DF2AD7957",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav",
      "voiceDuration" : 4.1278231292517,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 4.7278231292517
    },
    {
      "telop" : "「とりあえず、遠足のための調べ物をしませんか？」",
      "slideTitle" : "スライド #54",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.054.jpeg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 54",
      "id" : "ED24B6D4-1BB1-4358-8C93-54076A26350A",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_アリス・マーガトロイド.wav",
      "voiceDuration" : 2.673265306122449,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 3.273265306122449
    },
    {
      "telop" : "「今回の目的地は、副都心か臨海部だそうですよ。」",
      "slideTitle" : "スライド #55",
      "voiceCharacter" : "古明地さとり",
      "characterName" : "古明地さとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.055.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 55",
      "id" : "743C05C1-6052-45B3-AE9D-ABA2AC5ACD0F",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_古明地さとり.wav",
      "voiceDuration" : 2.980997732426304,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 3.580997732426304
    },
    {
      "telop" : "「藤原さんは、池袋・新宿・渋谷とお台場、どっちに行きたい？」",
      "slideTitle" : "スライド #56",
      "voiceCharacter" : "古明地こいし",
      "characterName" : "古明地こいし",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.056.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 56",
      "id" : "051AB19A-CA5E-4DFB-B439-12E368B38321",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_古明地こいし.wav",
      "voiceDuration" : 5.666848072562359,
      "seVolume" : 1,
      "backgroundName" : "nc378787_文化系の部室（夕方）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 6.266848072562358
    },
    {
      "telop" : "「僕は…、お台場が空いてそうだから、そっちがいいです…」",
      "slideTitle" : "スライド #57",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
