      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 2.5
    },
    {
      "telop" : "「何か、困ったことでもあったんですか？」",
      "slideTitle" : "スライド #3",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.003.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 3: 「何か、困ったことでもあったんですか？」",
      "id" : "CC674DAE-7777-473C-8DC9-40C5DBBED85D",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "voiceDuration" : 2.7104308390022678,
      "seVolume" : 1,
      "backgroundName" : "単色背景",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "duration" : 3.310430839002268
    },
    {
      "telop" : "「ええ、朝からあなたのことは、噂立ってますから…」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "slideTitle" : "スライド #4",
      "voiceCharacter" : "古明地さとり",
      "characterName" : "古明地さとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.004.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 4",
      "id" : "465C3384-86B6-4BFC-8810-7D5C482FE4FE",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地さとり.wav",
      "voiceDuration" : 2.7203854875283446,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.3203854875283447
    },
    {
      "telop" : "「何で、僕の噂が出たら、困るんですか？」",
      "slideTitle" : "スライド #5",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.005.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 5",
      "id" : "DE94BA39-489D-465E-AE4C-2AABC1143832",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav",
      "voiceDuration" : 3.1778231292517005,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.7778231292517006
    },
    {
      "telop" : "「それは…、今日の７限目に遠足の班を決めるからですよ…」",
      "slideTitle" : "スライド #6",
      "voiceCharacter" : "古明地さとり",
      "characterName" : "古明地さとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.006.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 6",
      "id" : "E4FCEA3D-AB80-40C9-B5B9-5BD37BE95E11",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_古明地さとり.wav",
      "voiceDuration" : 2.9877777777777776,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 3.5877777777777777
    },
    {
      "telop" : "「遠足…」僕は、そうつぶやく。そして、今まで、幼少期を除けば、遠足などの校外活動は一切してこなかったことを思い出す。",
      "slideTitle" : "スライド #7",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.007.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 7",
      "id" : "E74CD031-8A60-4EE5-9A37-EA7199501432",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav",
      "voiceDuration" : 9.800204081632653,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 10.400204081632653
    },
    {
      "telop" : "「まぁ、とりあえず、もうすぐ朝礼ですから、\n席に座ったほうがいいですよ。」",
      "slideTitle" : "スライド #8",
      "voiceCharacter" : "古明地さとり",
      "characterName" : "古明地さとり",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.008.jpeg",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 8",
      "id" : "EBF52261-D6AC-4B91-A481-62C01BD1AD7C",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_古明地さとり.wav",
      "voiceDuration" : 3.916598639455782,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 4.516598639455782
    },
    {
      "telop" : "「そうですね…」僕は、彼女に言われた通り、\n自席に座り、荷物の整理を始めた。",
      "slideTitle" : "スライド #9",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.009.jpeg",
