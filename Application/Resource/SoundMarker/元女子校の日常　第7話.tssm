      "duration" : 11.703242630385487
    },
    {
      "telop" : "私が、その男児の後を追いかけると、遠くには、その男児は言っておらず、周囲をキョロキョロしながら、私に目線を当てる。",
      "slideTitle" : "スライド #28",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.028.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seStartTimeOffset" : 0,
