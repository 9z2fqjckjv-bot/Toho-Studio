      "duration" : 5.901995464852607
    },
    {
      "telop" : "その彼の行動に対して私は、一言返す程度だった。",
      "slideTitle" : "スライド #30",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.030.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 30",
      "id" : "9939AA4E-AF20-4B1D-B7F2-030E4728C4BF",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_フランドール・スカーレット.wav",
      "voiceDuration" : 4.440748299319728,
      "seVolume" : 1,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 5.040748299319728
    },
    {
      "telop" : "今考えると、彼は、あえて発表中に部屋を飛び出ると言う、目立つ行動で私を外に出し、同年代の男児から離れたのだと思う。",
      "slideTitle" : "スライド #31",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.031.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 31",
