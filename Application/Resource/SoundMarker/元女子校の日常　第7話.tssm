      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "duration" : 9.3778231292517
    },
    {
      "telop" : "「着席してください。」",
      "slideTitle" : "スライド #43",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.043.jpeg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 43",
      "id" : "648F0557-09F1-46AF-AF7F-2DA96E771504",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_東風谷早苗.wav",
