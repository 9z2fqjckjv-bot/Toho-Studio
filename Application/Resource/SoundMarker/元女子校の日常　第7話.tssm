      "duration" : 10.256984126984127
    },
    {
      "telop" : "でも、この気持ちを確かめて、蹴りをつけないと、お姉様の仕事の手伝いで気が抜けてしまいそうだった。「どうしよう…」",
      "slideTitle" : "スライド #38",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.038.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
