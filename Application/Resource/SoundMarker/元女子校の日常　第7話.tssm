      "duration" : 3.5
    },
    {
      "telop" : "あれから、６限までの授業を無事に乗り切った僕は、\n遠足の班決めが始まる時間になっていた。",
      "slideTitle" : "スライド #41",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.041.jpeg",
      "audioTrack" : "track_voice_soumu",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 41",
      "id" : "985B26EE-F697-468F-BF4D-15C33B44E000",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav",
