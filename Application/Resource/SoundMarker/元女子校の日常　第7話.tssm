      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_フランドール・スカーレット.wav",
      "voiceDuration" : 10.299478458049887,
      "seVolume" : 1,
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg",
      "duration" : 10.899478458049886
    },
    {
      "telop" : "私が聞いたところでは、その後、彼は、勉学における成績で、常に学内トップだったとか。だが、欠けてるとこもあるとか…。",
      "slideTitle" : "スライド #32",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.032.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 32",
      "id" : "A2AE2085-BAB0-4B6D-B2A7-7DD0667B40FB",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_フランドール・スカーレット.wav",
      "voiceDuration" : 10.439478458049887,
      "seVolume" : 1,
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg",
      "duration" : 11.039478458049887
    },
    {
      "telop" : "私の母校と彼が元いた学校の学力は同等あるいは、私の母校がより高いので、中途入学のための入試難易度もそれなりに高い。",
      "slideTitle" : "スライド #33",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.033.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "title" : "シーン 33",
      "id" : "3FD20863-FC8B-450B-8470-3024F5154618",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_フランドール・スカーレット.wav",
      "voiceDuration" : 10.647732426303856,
      "seVolume" : 1,
      "backgroundName" : "nc301377_一人部屋２（日中）.jpg",
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg",
      "duration" : 11.247732426303855
    },
    {
      "telop" : "そして、あのとき…、ふとある情報を入手し、深夜帯に母校を突撃すると、情報にあった通り、彼の姿を発見した。",
      "slideTitle" : "スライド #34",
      "voiceCharacter" : "フランドール・スカーレット",
      "characterName" : "フランドール・スカーレット",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第7話_5126a3ddee\/元女子校の日常　第7話_5126a3ddee.034.jpeg",
      "audioTrack" : "track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88",
      "seStartTimeOffset" : 0,
