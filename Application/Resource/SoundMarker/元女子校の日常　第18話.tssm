      "voice2StartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "animationName" : "なし",
      "slideTitle" : "スライド #30",
      "telop" : "一方、学校では…",
      "bgmVolume" : 0.7,
      "transitionName" : "なし",
      "title" : "シーン 30: 一方、学校では…",
      "characterName" : "操夢",
      "backgroundName" : "単色背景",
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "duration" : 5.273219954648526,
      "id" : "FDF59D21-1640-4C9E-8AB5-AA081A460204",
      "telop" : "私は、一人、学園長室で作業をしていると、戸がノックされる。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_隠岐奈.wav",
      "slideTitle" : "スライド #31",
      "title" : "シーン 31",
      "transitionName" : "なし",
      "characterName" : "隠岐奈",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voiceDuration" : 4.673219954648526,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 1.44,
      "seName" : "SE: 木のドアをノック1",
      "voiceStartTimeOffset" : 0,
      "seVolume" : 0.85
    },
    {
      "duration" : 3.9739455782312927,
      "id" : "D835E4CA-DC3C-466A-AC0A-806BF94528BA",
      "telop" : "すると、ある人物の声がする。「入っていいぞ。」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_隠岐奈.wav",
      "slideTitle" : "スライド #32",
      "title" : "シーン 32",
      "transitionName" : "なし",
      "characterName" : "隠岐奈",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voiceDuration" : 3.3739455782312926,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.5,
      "id" : "714ADF90-5D27-44DA-BA7C-BD8082402D97",
      "telop" : "「美鈴か、どうした、何かあったのか？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_隠岐奈.wav",
      "slideTitle" : "スライド #33",
      "title" : "シーン 33",
      "transitionName" : "なし",
      "characterName" : "隠岐奈",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voiceDuration" : 2.8947845804988663,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 6.610226757369614,
      "id" : "B3DA2E95-1150-4917-A065-BC9BA4B29315",
      "telop" : "「学園長…、つい先ほど、先日例の彼が居候している家に、送ったカードから数時間のうちに5回ほどの入出金がありまして…」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_美鈴.wav",
      "slideTitle" : "スライド #34",
      "title" : "シーン 34",
      "transitionName" : "なし",
      "characterName" : "美鈴",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "voiceDuration" : 6.010226757369614,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "美鈴",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.5,
      "id" : "C5E7EDFB-9710-4D64-9CAE-C664D4886D01",
      "telop" : "「入出金の明細は、どうなってんだ？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_隠岐奈.wav",
      "slideTitle" : "スライド #35",
      "title" : "シーン 35",
      "transitionName" : "なし",
      "characterName" : "隠岐奈",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voiceDuration" : 2.730612244897959,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 6.3612698412698405,
      "id" : "BC0974C5-61A4-42FC-A80C-2A2E8369FDC7",
      "telop" : "「お台場のショッピングモール内の洋服店から1件、現金の引き出しと、振り込みがそれぞれ1件、ホテル関連のものが数件です。」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_美鈴.wav",
