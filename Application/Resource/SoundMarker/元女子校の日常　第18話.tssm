      "transitionName" : "なし",
      "characterName" : "美鈴",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "voiceDuration" : 5.761269841269841,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "美鈴",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
