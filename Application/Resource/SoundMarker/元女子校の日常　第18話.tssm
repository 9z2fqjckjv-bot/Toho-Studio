      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.051.jpeg",
