      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav",
      "voiceCharacter" : "操夢"
    },
    {
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "パチュリー・ノーレッジ",
      "slideTitle" : "スライド #67",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 67",
      "duration" : 3.95281179138322,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "voiceDuration" : 3.35281179138322,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_パチュリー・ノーレッジ.wav",
      "id" : "AFFCFF8C-DBFD-4FD2-9FFE-AF0DC059213E",
      "voice2StartTimeOffset" : 0,
      "telop" : "「分かったわ、だけど覚悟してね…、お金は大事に使うのよ。」"
    },
    {
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "操夢",
      "slideTitle" : "スライド #68",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 68",
      "duration" : 7.80281179138322,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "voiceDuration" : 7.20281179138322,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav",
      "id" : "A92A3B96-20E6-4183-A9A0-75DD681ABDCB",
      "voice2StartTimeOffset" : 0,
      "telop" : "彼女は、そう言うと、電話を切った。「終わりましたよ…、\nきっとこれで、説教電話はこないと…思います…。」"
    },
    {
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "アリス・マーガトロイド",
      "slideTitle" : "スライド #69",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 69",
      "duration" : 5.0377777777777775,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "voiceDuration" : 4.437777777777778,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_アリス・マーガトロイド.wav",
      "id" : "40D223DB-3689-499B-8FFA-55D21B788392",
      "voice2StartTimeOffset" : 0,
      "telop" : "「あっ…ありがとう…」\n私は、そう辿々しく言うと、彼からポケベルを受け取った。"
    },
    {
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "characterName" : "操夢",
      "slideTitle" : "スライド #70",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 70: 一方、学校では…",
      "duration" : 2.5,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "単色背景",
      "transitionName" : "なし",
      "id" : "3E7F504B-DA8D-46AA-A209-0912663D80BE",
      "voice2StartTimeOffset" : 0,
      "telop" : "一方、学校では…"
    },
    {
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "隠岐奈",
      "slideTitle" : "スライド #71",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 71",
      "duration" : 9.125714285714285,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "voiceDuration" : 8.525714285714285,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_隠岐奈.wav",
      "id" : "E76D0251-6DA2-4B20-BC50-DC39DC397F12",
      "voice2StartTimeOffset" : 0,
      "telop" : "美鈴が部屋を去った後、私がしばらくその書類を眺めていると、ふと彼の考えが伝わってくる。「なるほど、そう言うことか。」"
    },
    {
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "bgmVolume" : 0.7,
      "seVolume" : 0.85,
      "characterName" : "隠岐奈",
      "slideTitle" : "スライド #72",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 72",
      "duration" : 5.352176870748299,
      "voiceStartTimeOffset" : 0,
      "seName" : "SE: 木のドアをノック1",
      "voiceCharacter" : "隠岐奈",
      "voiceDuration" : 4.7521768707483,
      "seStartTimeOffset" : 0.3,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3",
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_隠岐奈.wav",
      "id" : "6DB79BE4-6CFC-4367-B4AB-3EE4F2D88193",
      "voice2StartTimeOffset" : 0,
      "telop" : "すると、再び部屋の扉がノックされる。\n「いいぞ、入ってきなさい。」"
    },
    {
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "美鈴",
      "slideTitle" : "スライド #73",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 73",
      "duration" : 6.185238095238095,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "美鈴",
      "voiceDuration" : 5.585238095238095,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_美鈴.wav",
      "id" : "69E3FEC4-F589-4F88-8B0F-D7C852890025",
      "voice2StartTimeOffset" : 0,
      "telop" : "「学園長…、その手元の書類の控えとデビットカードを送ったのは、あなたって本当なのですか？総理大臣からの認可は？」"
    },
    {
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "隠岐奈",
      "slideTitle" : "スライド #74",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 74",
      "duration" : 5.060204081632652,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "voiceDuration" : 4.460204081632653,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_隠岐奈.wav",
      "id" : "24F2A4C7-EF5E-4A11-9DB4-4F00FCF11AF0",
      "voice2StartTimeOffset" : 0,
      "telop" : "「えっと、それはだな…」私は、彼女の指摘に言葉が詰まる。"
    },
    {
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "美鈴",
      "slideTitle" : "スライド #75",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 75",
      "duration" : 3.5,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "美鈴",
      "voiceDuration" : 2.729342403628118,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_美鈴.wav",
      "id" : "B4DA26C3-80EA-48E9-979E-622D0ABC25E8",
      "voice2StartTimeOffset" : 0,
      "telop" : "「まさか…、認可も取らずに、独断で実行されたんですか…？」"
    },
    {
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "bgmVolume" : 0.7,
      "seVolume" : 1,
      "characterName" : "隠岐奈",
      "slideTitle" : "スライド #76",
      "bgmStartTimeOffset" : 0,
      "title" : "シーン 76",
      "duration" : 4.6959183673469385,
      "voiceStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "voiceDuration" : 4.095918367346939,
      "seStartTimeOffset" : 0,
      "animationName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_隠岐奈.wav",
      "id" : "1BFEF4DD-C31F-45A2-A28E-D9030197252E",
      "voice2StartTimeOffset" : 0,
      "telop" : "「うぐっ。」私は、彼女の言う通りで何も言えなくなる。"
    },
    {
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 77",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #77",
      "seVolume" : 1,
      "telop" : "「万が一の時には学園長の責任ですからね…、まったく…。ここ最近の学園長は彼に、固執しすぎじゃないですか…？」",
      "transitionName" : "なし",
      "id" : "05BCC47A-A83E-425A-A3A8-FA69A06BF97C",
      "voiceDuration" : 5.458934240362812,
      "animationName" : "なし",
      "duration" : 6.058934240362811,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "美鈴",
      "voiceCharacter" : "美鈴",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_美鈴.wav",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4"
    },
    {
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 78",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #78",
      "seVolume" : 1,
      "telop" : "「確かに、お前の言うとおりかも知れないな…。」",
      "transitionName" : "なし",
      "id" : "C881FAE5-E71A-4233-930E-F1AF20F0181C",
      "voiceDuration" : 2.8093650793650795,
      "animationName" : "なし",
      "duration" : 3.5,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "隠岐奈",
      "voiceCharacter" : "隠岐奈",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_隠岐奈.wav",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88"
    },
    {
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 79",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #79",
      "seVolume" : 1,
      "telop" : "「だが、彼に固執するのには、理由があるんだよ、美鈴。」",
      "transitionName" : "なし",
      "id" : "C157BD29-BCBF-4B96-BCB5-F30403975992",
      "voiceDuration" : 4.128639455782313,
      "animationName" : "なし",
      "duration" : 4.728639455782313,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "隠岐奈",
      "voiceCharacter" : "隠岐奈",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_隠岐奈.wav",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88"
    },
    {
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 80",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #80",
      "seVolume" : 1,
      "telop" : "「いったい、どんな理由ですか？」",
      "transitionName" : "なし",
      "id" : "EC1E6987-2E9E-402E-B0A4-D0E115A72C2B",
      "voiceDuration" : 1.5,
      "animationName" : "なし",
      "duration" : 3.5,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "美鈴",
      "voiceCharacter" : "美鈴",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_美鈴.wav",
      "audioTrack" : "track_voice_%E7%BE%8E%E9%88%B4"
    },
    {
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 81",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #81",
      "seVolume" : 1,
      "telop" : "「その理由は、今度教えるから。この話は、ここでやめだ。」",
      "transitionName" : "なし",
      "id" : "D672969C-0EA7-43DD-8681-55886A827B58",
      "voiceDuration" : 4.518208616780045,
      "animationName" : "なし",
      "duration" : 5.118208616780045,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "characterName" : "隠岐奈",
      "voiceCharacter" : "隠岐奈",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_隠岐奈.wav",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88"
    },
    {
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 82",
      "seStartTimeOffset" : 0,
      "slideTitle" : "スライド #82",
      "seVolume" : 1,
      "telop" : "「そうですか…、それでは失礼します…。」\n私はそう言うと、部屋を出て行った。",
      "transitionName" : "なし",
      "id" : "2A4DFC3B-B9DF-4843-A94E-4E495C99BB5D",
      "voiceDuration" : 3.4027210884353742,
