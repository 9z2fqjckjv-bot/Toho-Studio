      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.060.jpeg",
      "id" : "CF176D1B-06C8-454E-86BC-7FBC37927CDC",
      "seVolume" : 1
    },
    {
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "animationName" : "なし",
