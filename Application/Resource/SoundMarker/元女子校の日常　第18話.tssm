    {
      "pan" : 0,
      "playbackRate" : 1,
      "text" : "だが、あることを思い出し、彼女の質問に答えを出す。「長く使えて、飽きない服を選ぶといいですよ。」",
      "isLooping" : false,
      "voiceTriggerEnabled" : false,
      "voiceType" : "中性",
      "speed" : 100,
      "sceneIndex" : 4,
      "pitch" : 115,
      "startTime" : 17.13390022675737,
      "voiceSymbol" : "ダ'ガ、ア'ルコトオ\/オモイダ'_シ、カ'ノジョノ\/_シツモンニ\/コタ'エオ+ダ'_ス。ナガ'_ク\/ツカエテ、アキ'ナイ\/_フク'オ\/エラ'ブト\/イイ'デスヨ。",
      "fadeOutDuration" : 0,
      "voiceTriggerOffset" : 0,
      "volume" : 1,
