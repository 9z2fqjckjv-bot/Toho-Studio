      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.062.jpeg",
      "id" : "07097E99-98CF-4D38-824C-E33DBF39C76F",
