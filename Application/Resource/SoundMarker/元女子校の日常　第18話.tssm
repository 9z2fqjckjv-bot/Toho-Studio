      "seVolume" : 1
    },
    {
      "duration" : 10.823469387755102,
      "id" : "13FC0F7D-D2B9-432E-A09C-D909C9FEB9D9",
      "telop" : "「そう…」私は、期待していた返答が得られずにため息が出る。\nそれから、私は一人で、買う服を決めるのだった。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav",
