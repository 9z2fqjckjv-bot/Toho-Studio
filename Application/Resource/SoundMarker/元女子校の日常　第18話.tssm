      "id" : "F9D660EC-1A08-4BE5-88E8-0C034ECC811D",
      "characterName" : "アリス・マーガトロイド",
      "seVolume" : 1,
      "duration" : 7.244807256235827,
      "slideTitle" : "スライド #14",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_アリス・マーガトロイド.wav",
      "bgmStartTimeOffset" : 0,
      "telop" : "「まさか、今日中に準備して、明日の朝イチに空港集合なんて、言いませんよね…、今日は、出発日前日ですけど…。」",
      "seStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "voiceDuration" : 6.644807256235827,
      "title" : "シーン 14",
