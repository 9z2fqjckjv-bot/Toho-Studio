      "characterName" : "アリス・マーガトロイド",
      "telop" : "「これは…何ですか？」",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_アリス・マーガトロイド.wav",
