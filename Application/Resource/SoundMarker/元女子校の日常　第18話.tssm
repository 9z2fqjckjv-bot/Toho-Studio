      "slideTitle" : "スライド #51",
      "title" : "シーン 51"
    },
    {
      "telop" : "そこには、寝落ち寸前のような表情で、こくこくと頭が動いているこいしの姿があった。「今寝ちゃうと、夜眠れませんから…」",
      "transitionName" : "なし",
      "bgmStartTimeOffset" : 0,
      "duration" : 9.057165532879818,
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "voiceDuration" : 8.457165532879818,
      "characterName" : "操夢",
      "id" : "78104CCA-B3A5-4C6C-8973-9B3CB46D77B3",
      "voiceCharacter" : "操夢",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.052.jpeg",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
