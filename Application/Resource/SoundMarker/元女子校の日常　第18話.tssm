    {
      "title" : "シーン 47",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "telop" : "それから、僕たちは、ホテルに着くと、予約した四人部屋に入る。そして、入浴の順番を決めて、アリスが先に浴室に入る。",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 9.762607709750567,
      "animationName" : "なし",
      "slideTitle" : "スライド #47",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 9.162607709750567,
      "id" : "42E1A64D-5025-4949-AFC4-3715DEE8861F"
    },
    {
      "title" : "シーン 48",
      "characterName" : "古明地さとり",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_古明地さとり.wav",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceCharacter" : "古明地さとり",
      "seStartTimeOffset" : 0,
      "telop" : "「あの…女子3人と一緒の部屋で寝泊まりで…いいんですか？」",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 3.688979591836735,
      "animationName" : "なし",
      "slideTitle" : "スライド #48",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 3.088979591836735,
      "id" : "8DAA6C61-4BA1-44CB-BF1A-761CCA9E2B0D"
    },
    {
      "title" : "シーン 49",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "telop" : "「ええ、条件に見合った部屋が、ここしかなかったので…。」",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 4.266938775510204,
      "animationName" : "なし",
      "slideTitle" : "スライド #49",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 3.666938775510204,
      "id" : "0D413B39-C0BA-459A-99C5-45B010223C52"
    },
    {
      "title" : "シーン 50",
      "characterName" : "古明地さとり",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_古明地さとり.wav",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceCharacter" : "古明地さとり",
      "seStartTimeOffset" : 0,
      "telop" : "「そうですか…。それならいいんですけど…」",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 3.5,
      "animationName" : "なし",
      "slideTitle" : "スライド #50",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 2.068185941043084,
      "id" : "121DE1DA-0472-4BC8-B221-CBE61DAC1A1A"
    },
    {
      "title" : "シーン 51",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "telop" : "「それより、アリスさんの入力が終わったら、こいしさんを目覚めさせてください…」僕は、そう言いながら、こいしを見る。",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 8.060430839002267,
      "animationName" : "なし",
      "slideTitle" : "スライド #51",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 7.460430839002267,
      "id" : "5AE8D37C-BF72-4CA1-AD09-8426649D5008"
    },
    {
      "title" : "シーン 52",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "seStartTimeOffset" : 0,
      "telop" : "そこには、寝落ち寸前のような表情で、こくこくと頭が動いているこいしの姿があった。「今寝ちゃうと、夜眠れませんから…」",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 9.057165532879818,
      "animationName" : "なし",
      "slideTitle" : "スライド #52",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 8.457165532879818,
      "id" : "B327601C-A97B-45C0-BA14-0618E45DD97D"
    },
    {
      "title" : "シーン 53",
      "characterName" : "古明地さとり",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_古明地さとり.wav",
      "audioTrack" : "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
      "voiceCharacter" : "古明地さとり",
      "seStartTimeOffset" : 0,
      "telop" : "「分かりました…」私と彼がそう話していると、浴室の扉が開く。そして、妹を起こし、入浴に向かわせた。",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 7.1925850340136055,
      "animationName" : "なし",
      "slideTitle" : "スライド #53",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 6.592585034013606,
      "id" : "00B11A0C-4965-4B3A-B34A-0B60805B88A6"
    },
    {
      "title" : "シーン 54",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_アリス・マーガトロイド.wav",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "seStartTimeOffset" : 0,
      "telop" : "私は、入浴が終わると、ポケベルに着信があったことに気がつく。そして、さとりと彼の了承を得ると電話に出る。",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 6.95297052154195,
      "animationName" : "なし",
      "slideTitle" : "スライド #54",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 6.35297052154195,
      "id" : "82B4FC0E-D2B0-470B-AD8C-5038578EFCE1"
    },
    {
      "title" : "シーン 55",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_アリス・マーガトロイド.wav",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "seStartTimeOffset" : 0,
      "telop" : "「もしもし、どうしたんですか？」",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 3.5,
      "animationName" : "なし",
      "slideTitle" : "スライド #55",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 1.5932653061224489,
      "id" : "C4384F16-BAE4-43D6-9099-353B9B0AA6CD"
    },
    {
      "title" : "シーン 56",
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_パチュリー・ノーレッジ.wav",
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "voiceCharacter" : "パチュリー・ノーレッジ",
      "seStartTimeOffset" : 0,
      "telop" : "「あんたたち一体、遠足で何をしてるの？」",
      "bgmStartTimeOffset" : 0,
      "voice2StartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "duration" : 3.5,
      "animationName" : "なし",
      "slideTitle" : "スライド #56",
      "seVolume" : 1,
      "voiceStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceDuration" : 2.383469387755102,
      "id" : "B54F3409-18C8-488F-A092-81C86BD4535F"
    },
    {
      "slideTitle" : "スライド #57",
      "telop" : "「えっ？」",
      "duration" : 3.5,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "6A1334AC-075E-4318-ADBB-D50173351632",
      "title" : "シーン 57",
      "characterName" : "アリス・マーガトロイド",
      "voiceDuration" : 1.5,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_アリス・マーガトロイド.wav",
      "voiceCharacter" : "アリス・マーガトロイド"
    },
    {
      "slideTitle" : "スライド #58",
      "telop" : "僕は、彼女が困惑しているのを見て、目線で電話口を変わったほうがいいか、確認する。すると、彼女はポケベルを僕に渡す。",
      "duration" : 9.536507936507936,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "97C5050F-FEDA-42FD-8F12-E2F346141974",
      "title" : "シーン 58",
      "characterName" : "操夢",
      "voiceDuration" : 8.936507936507937,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #59",
      "telop" : "「もしもし、紅夢です…、どうしましたか？」",
      "duration" : 3.5,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "BCC69E85-8B17-4542-94FD-F94C81617B4B",
      "title" : "シーン 59",
      "characterName" : "操夢",
      "voiceDuration" : 2.806077097505669,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #60",
      "telop" : "「美鈴から聞いたわよ、あんたが居候している家に送ったデビットカードから、短時間で5件の入出金があったみたいじゃない。」",
      "duration" : 7.131519274376417,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "E83B1390-A48B-405E-887F-02C053EF92A0",
      "title" : "シーン 60",
      "characterName" : "パチュリー・ノーレッジ",
      "voiceDuration" : 6.531519274376417,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ"
    },
    {
      "slideTitle" : "スライド #61",
      "telop" : "「それで、あんたたちは、これからどうするのよ？」",
      "duration" : 3.5,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "E58E7C4E-FB62-485B-9519-B2201836BE02",
      "title" : "シーン 61",
      "characterName" : "パチュリー・ノーレッジ",
      "voiceDuration" : 2.531609977324263,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ"
    },
    {
      "slideTitle" : "スライド #62",
      "telop" : "「あれ…パチュリーさんは、知らないんですか…、例のデビットカードが送られたとき、一緒に手紙が入っていたことを…？」",
      "duration" : 7.762607709750567,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "6492E8C8-BDB8-4CA8-8B1D-582185D33328",
      "title" : "シーン 62",
      "characterName" : "操夢",
      "voiceDuration" : 7.162607709750567,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #63",
      "telop" : "「えっ？何よ手紙って…？」",
      "duration" : 3.5,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "DFCD5E6B-DF0B-4A20-9B69-99817F86963B",
      "title" : "シーン 63",
      "characterName" : "パチュリー・ノーレッジ",
      "voiceDuration" : 1.6711791383219954,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ"
    },
    {
      "slideTitle" : "スライド #64",
      "telop" : "僕は、そう彼女に聞かれ、デビットカードともに入っていた手紙というか、遠足後の試験に関する詳細を彼女に伝える。",
      "duration" : 8.558253968253968,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "AC2BFE41-EAB6-4CE2-8679-3DFB7414BC1D",
      "title" : "シーン 64",
      "characterName" : "操夢",
      "voiceDuration" : 7.958253968253969,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "voiceCharacter" : "操夢"
    },
    {
      "slideTitle" : "スライド #65",
      "telop" : "「それで、それは誰が今持ってるの？」",
      "duration" : 3.5,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "CFA6C62B-1597-41BC-A044-8F9E19FBCBA5",
      "title" : "シーン 65",
      "characterName" : "パチュリー・ノーレッジ",
      "voiceDuration" : 1.9939002267573696,
      "voiceStartTimeOffset" : 0,
      "animationName" : "なし",
      "seVolume" : 1,
      "seStartTimeOffset" : 0,
      "bgmStartTimeOffset" : 0,
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_パチュリー・ノーレッジ.wav",
      "voiceCharacter" : "パチュリー・ノーレッジ"
    },
    {
      "slideTitle" : "スライド #66",
      "telop" : "「僕のバックの中に入ってますよ。それに、その封筒の差出人は、学園長の名義で、ちょうど都合もいいので…」",
      "duration" : 8.710430839002267,
      "voice2StartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "bgmVolume" : 0.7,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "id" : "2274E393-9D09-4486-A583-D3D67D3E1249",
      "title" : "シーン 66",
      "characterName" : "操夢",
