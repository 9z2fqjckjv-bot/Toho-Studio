      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88",
      "voiceDuration" : 1.5,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "隠岐奈",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 5.598208616780045,
      "id" : "4CC4CA74-ECDE-48B2-ABE4-313CF61C91AA",
      "telop" : "「ええ、一つは立体蒲田駅近くのホテル、残りは琉球郡内の沖縄本島にあるホテルの予約になっています。」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_美鈴.wav",
