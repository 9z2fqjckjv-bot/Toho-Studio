      "animationName" : "なし",
      "bgmVolume" : 0.7,
      "telop" : "「あの…、どう言う意図ですか…、その発言は…？」",
      "transitionName" : "なし",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
