      "voice2StartTimeOffset" : 0,
      "telop" : "「もしもし、どうしたんですか？」",
      "characterName" : "アリス・マーガトロイド",
      "duration" : 1.5932653061224489,
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
