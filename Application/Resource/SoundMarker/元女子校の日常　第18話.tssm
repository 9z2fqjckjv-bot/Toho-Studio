      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.140861678004535,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 5.962879818594104,
      "id" : "430794CD-0F2F-4085-B8B1-CA0CA857DABF",
      "telop" : "「こんなところで、どうしたんですか…」\n私は、本を買い終えて、戻ってくると休んでいた3人に聞く。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #8",
      "title" : "シーン 8",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 5.362879818594104,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 8.358253968253969,
      "id" : "0087F676-B032-475A-A72A-58706E3FB8D3",
      "telop" : "「少しだけ歩き疲れたので、休憩してたんです。あと…」\n僕はそう言い、見事にくじ引きで当たった旅行券を出す。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav",
      "slideTitle" : "スライド #9",
      "title" : "シーン 9",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.758253968253968,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.5,
      "id" : "FDB9D912-C8B5-4531-970D-06896C78DDC1",
      "telop" : "「これは…何ですか？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #10",
      "title" : "シーン 10",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 1.5,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 7.43,
      "id" : "D4F5579D-CD4D-4125-B95A-D87E6CFF2F04",
      "telop" : "「アリスさんがいなくなった後、僕たちは洋服を買っていて、そのお店のくじ引きの景品でもらったんですよ。」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav",
      "slideTitle" : "スライド #11",
      "title" : "シーン 11",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 6.83,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 8.545215419501133,
      "id" : "77CBB01D-C2A9-4E3E-A1AE-4BAC58783678",
      "telop" : "「チケットは4人分ありますが、どうします、アリスさんは行きますか？もし、行かないなら、誰かを別に誘いますけど…」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "slideTitle" : "スライド #12",
      "title" : "シーン 12",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 7.9452154195011335,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 7.263356009070295,
      "id" : "AACEC13D-FA96-40E3-AE1C-536378716E7E",
      "telop" : "私は、彼が出した旅行券をよく見る。行き先は琉球郡沖縄本島とあり、そこで出発日が明日であることに気がつく。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #13",
      "title" : "シーン 13",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 6.663356009070295,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 7.244807256235827,
      "id" : "417B0CBB-0EDD-4E37-8196-6BF57F487C01",
      "telop" : "「まさか、今日中に準備して、明日の朝イチに空港集合なんて、言いませんよね…、今日は、出発日前日ですけど…。」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #14",
      "title" : "シーン 14",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 6.644807256235827,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 8.666938775510204,
      "id" : "AC5A72FD-ABAF-4F01-84BC-2B44333B5BD9",
      "telop" : "「飛行機の時間が朝6時台であることを考えると、今日は家に帰らずに、空港の近くで泊まったほうがいいと思いますよ…」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav",
      "slideTitle" : "スライド #15",
      "title" : "シーン 15",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.066938775510204,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.5,
      "id" : "FCA5DF0A-7919-476F-89A0-C3E6C0DD8787",
      "telop" : "「家には帰れないって言うことですか？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #16",
      "title" : "シーン 16",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 1.7392290249433107,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 4.10172335600907,
      "id" : "B484B075-154D-4BFE-9A2D-4C830D89020A",
      "telop" : "「ええ、そうなりますね…。それで、どうしますか？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "slideTitle" : "スライド #17",
      "title" : "シーン 17",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 3.5017233560090704,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 7.3100907029478455,
      "id" : "069848EF-20C8-4086-ADCE-818E5AD25309",
      "telop" : "私は、彼の急な誘いに、どう返すべきか迷う。\nそして、私が無言で、考えていると、彼がある発言をする。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #18",
      "title" : "シーン 18",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 6.710090702947846,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.5,
      "id" : "2644364B-7625-4B31-8D96-7FFF851C293C",
      "telop" : "「アリスさんは…、お酒は飲めますか…？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav",
      "slideTitle" : "スライド #19",
      "title" : "シーン 19",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 2.290861678004535,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 4.130090702947846,
      "id" : "304CEB6C-33CE-426C-ABA6-DD421F0C47CA",
      "telop" : "「えっ？」私は、その発言に思わず、そう返してしまう。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #20",
      "title" : "シーン 20",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 3.5300907029478457,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.5,
      "id" : "6683D863-7036-4AD7-872C-70D6B58A526A",
      "telop" : "「あの…、どう言う意図ですか…、その発言は…？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #21",
      "title" : "シーン 21",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 2.3213378684807258,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 6.871519274376417,
      "id" : "AEBD9D35-3B1F-4643-AA1A-B640060A3576",
      "telop" : "「一緒に来てくれれば…琉球郡のご当地のお酒から、好きなのを言って貰えば、僕が買うので、好きなだけ飲めますよ…」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #22",
      "title" : "シーン 22",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 6.271519274376417,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.731337868480726,
      "id" : "EB47C408-E546-4567-96D9-C09F74CE978C",
      "telop" : "「えっ…」私は、彼が出した予想外の提案に驚く。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #23",
      "title" : "シーン 23",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 3.131337868480726,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 5.792108843537415,
      "id" : "CD5B079F-B4B5-45D4-9098-69862CE1A7E2",
      "telop" : "「あの…、いいんですか…、私だけ好きなお酒を飲んでも…、あなたたちはお酒がまだ飲めない年齢だけど…？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #24",
      "title" : "シーン 24",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 5.192108843537415,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 6.685170068027211,
      "id" : "F6262914-E18D-4C1D-86A1-BC96CF93BAF9",
      "telop" : "「ええもちろん…、それに高校生と中学生だけだと、何かと不自由なので…、ひとりばかし大人がいたほうがいいですよ…」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_アリス・マーガトロイド.wav",
      "slideTitle" : "スライド #25",
      "title" : "シーン 25",
      "transitionName" : "なし",
      "characterName" : "アリス・マーガトロイド",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceDuration" : 6.085170068027211,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "アリス・マーガトロイド",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 3.6649886621315195,
