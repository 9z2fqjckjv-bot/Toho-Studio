    {
      "pan" : 0,
      "playbackRate" : 1,
      "text" : "「ねぇ、これどっちがいいと思う？」",
      "isLooping" : false,
      "voiceTriggerEnabled" : false,
      "voiceType" : "女声2 (高め)",
      "speed" : 50,
      "sceneIndex" : 2,
      "pitch" : 181,
      "startTime" : 9.30498866213152,
      "voiceSymbol" : "、+ネ'ー、コレ\/ド'ッチガ\/イ'イト\/オモ'ウ？",
      "fadeOutDuration" : 0,
      "voiceTriggerOffset" : 0,
      "volume" : 1,
