    {
      "pan" : 0,
      "playbackRate" : 1,
      "text" : "私は、彼が出した旅行券をよく見る。行き先は琉球郡沖縄本島とあり、そこで出発日が明日であることに気がつく。",
      "isLooping" : false,
      "voiceTriggerEnabled" : false,
      "voiceType" : "女声1 (標準)",
      "speed" : 110,
      "sceneIndex" : 13,
      "pitch" : 130,
      "startTime" : 80.61151927437642,
