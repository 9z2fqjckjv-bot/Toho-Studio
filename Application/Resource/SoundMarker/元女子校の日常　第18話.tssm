      "title" : "シーン 28",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.393673469387755,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "seVolume" : 1
    },
    {
      "duration" : 9.486507936507936,
      "id" : "F41E3658-506F-4B3D-8444-B463024078C6",
      "telop" : "「楽しみですか、旅行？」僕がそう聞くと、3人は頷く。\nそして、僕たちはそのまま今晩泊まるホテルに移動を始めた。",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav",
      "slideTitle" : "スライド #29",
      "title" : "シーン 29",
      "transitionName" : "なし",
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceDuration" : 8.886507936507936,
      "bgmStartTimeOffset" : 0,
      "voiceCharacter" : "操夢",
      "bgmVolume" : 0.7,
      "seStartTimeOffset" : 0,
