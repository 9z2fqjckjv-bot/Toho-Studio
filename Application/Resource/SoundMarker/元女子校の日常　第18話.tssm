    {
      "pan" : 0,
      "playbackRate" : 1,
      "text" : "「そう…」私は、期待していた返答が得られずにため息が出る。それから、私は一人で、買う服を決めるのだった。",
      "isLooping" : false,
      "voiceTriggerEnabled" : false,
      "voiceType" : "女声2 (高め)",
      "speed" : 50,
      "sceneIndex" : 5,
      "pitch" : 181,
      "startTime" : 24.750839002267572,
