      "slideTitle" : "スライド #52",
      "title" : "シーン 52"
    },
    {
      "telop" : "「分かりました…」私と彼がそう話していると、浴室の扉が開く。そして、妹を起こし、入浴に向かわせた。",
      "transitionName" : "なし",
      "bgmStartTimeOffset" : 0,
      "duration" : 7.1925850340136055,
      "seStartTimeOffset" : 0,
      "seVolume" : 1,
      "voiceDuration" : 6.592585034013606,
      "characterName" : "古明地さとり",
      "id" : "92DC35A7-C9B2-4C67-AE0E-B5DE7DBB2342",
      "voiceCharacter" : "古明地さとり",
      "voice2StartTimeOffset" : 0,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.053.jpeg",
      "animationName" : "なし",
      "voiceStartTimeOffset" : 0,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "bgmVolume" : 0.7,
