      "slideTitle" : "スライド #9",
      "voice2StartTimeOffset" : 0,
      "title" : "シーン 9",
      "characterName" : "操夢",
      "telop" : "「少しだけ歩き疲れたので、休憩してたんです。あと…」\n僕はそう言い、見事にくじ引きで当たった旅行券を出す。",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "animationName" : "なし",
