    },
    {
      "duration" : 3.5,
      "id" : "F7EC0645-AF3E-4C05-9812-22B7C2C7D6CF",
      "telop" : "「デビットカードを使ったのは誰かわかるか？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_隠岐奈.wav",
      "slideTitle" : "スライド #39",
      "title" : "シーン 39",
      "transitionName" : "なし",
