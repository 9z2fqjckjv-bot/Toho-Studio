      "startTime" : 0,
      "character" : "操夢",
      "voiceType" : "中性",
      "voiceSymbol" : "ボ'クガ、エーティーエ'ムカラ\/モド'ッテ、ヨー_フク'テンニ\/モド'ルト、コイシガ\/ア'ル\/レ'ツノ\/ヨー_フクオ\/シンケンソウナヒョウジョ'ウデ\/ナガ'メテ+イタ。ド'ー\/_シタ'ンデ_スカ？",
      "pan" : 0,
      "trackId" : "track_voice_soumu",
      "sceneIndex" : 1,
      "voiceTriggerEnabled" : false,
      "speed" : 100,
      "text" : "僕が、ATMから戻って、洋服店に戻ると、こいしがある列の洋服を真剣そうな表情で眺めていた。「どうしたんですか？」",
      "fadeOutDuration" : 0,
