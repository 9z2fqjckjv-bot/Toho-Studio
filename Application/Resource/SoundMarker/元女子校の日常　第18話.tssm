    {
      "pan" : -0.2,
      "playbackRate" : 1,
      "text" : "「えっと…」僕は、いきなりそう言われ、戸惑ってしまう。",
      "isLooping" : false,
      "voiceTriggerEnabled" : false,
      "voiceType" : "中性",
      "speed" : 100,
      "sceneIndex" : 3,
      "pitch" : 115,
      "startTime" : 12.80498866213152,
      "voiceSymbol" : "、\/エ'ット、ボ'クワ、イキナリ\/ソ'ー\/イワレ、トマド'ッテ+シマウ。",
      "fadeOutDuration" : 0,
      "voiceTriggerOffset" : 0,
      "volume" : 1,
