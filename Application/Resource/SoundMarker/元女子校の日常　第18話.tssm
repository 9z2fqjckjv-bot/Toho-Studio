      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.058.jpeg",
      "id" : "61A4D374-6C30-4DD8-8289-34A5428E892C",
      "seVolume" : 1
    },
    {
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_soumu",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 59",
      "duration" : 2.806077097505669,
      "slideTitle" : "スライド #59",
      "voiceDuration" : 2.806077097505669,
      "telop" : "「もしもし、紅夢です…、どうしましたか？」",
      "voice2StartTimeOffset" : 0,
      "characterName" : "操夢",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "voiceCharacter" : "操夢",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.059.jpeg",
      "id" : "47CC196E-3D93-4725-BB19-4F3D07687C17",
      "seVolume" : 1
    },
    {
      "seStartTimeOffset" : 0,
      "voiceStartTimeOffset" : 0,
      "audioTrack" : "track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8",
      "animationName" : "なし",
      "transitionName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav",
      "bgmStartTimeOffset" : 0,
      "bgmVolume" : 0.7,
      "title" : "シーン 60",
      "duration" : 6.531519274376417,
      "slideTitle" : "スライド #60",
      "voiceDuration" : 6.531519274376417,
      "telop" : "「美鈴から聞いたわよ、あんたが居候している家に送ったデビットカードから、短時間で5件の入出金があったみたいじゃない。」",
      "voice2StartTimeOffset" : 0,
      "characterName" : "パチュリー・ノーレッジ",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
