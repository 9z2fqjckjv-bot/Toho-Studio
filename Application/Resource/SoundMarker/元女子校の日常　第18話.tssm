      "telop" : "「ホテル？」",
      "voice2StartTimeOffset" : 0,
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_隠岐奈.wav",
      "slideTitle" : "スライド #37",
      "title" : "シーン 37",
