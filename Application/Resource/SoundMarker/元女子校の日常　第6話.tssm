      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.003.jpeg"
    },
    {
      "title" : "シーン 4",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_アリス・マーガトロイド.wav",
      "id" : "7C88CCC1-3525-40C3-A00E-5C6736F6F43E",
      "slideTitle" : "スライド #4",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 7.964421768707482,
      "telop" : "「そう…。とりあえず、博士が研究中に、寝落ちしたから、帰ってもいいわよ。あとは、私が、彼女を説得させておくから…」\n制作ソフト及び協力\nGemini\nTohoStuido",
      "voiceDuration" : 7.364421768707483,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.004.jpeg"
    },
    {
      "title" : "シーン 5",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_アリス・マーガトロイド.wav",
      "id" : "A8A4A428-9F0B-4A97-A76E-4A6C3C541294",
      "slideTitle" : "スライド #5",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 3.3096145124716556,
      "telop" : "「あと帰る前に、君の名前を聞かせてくれるかしら？」",
      "voiceDuration" : 2.7096145124716555,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.005.jpeg"
    },
    {
      "title" : "シーン 6",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav",
      "id" : "20AE82BA-1476-4186-B204-FE97478AD8EA",
      "slideTitle" : "スライド #6",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 3.1452154195011337,
      "telop" : "「僕の名前は…藤原紅夢です。」",
      "voiceDuration" : 2.5452154195011336,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.006.jpeg"
    },
    {
      "title" : "シーン 7",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_アリス・マーガトロイド.wav",
      "id" : "CD4009DE-54B0-46D9-A50A-EE472BC32B7E",
      "slideTitle" : "スライド #7",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 3.226825396825397,
      "telop" : "「もしかして、君の父親って、妹紅先輩？」",
      "voiceDuration" : 2.6268253968253967,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.007.jpeg"
    },
    {
      "title" : "シーン 8",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav",
      "id" : "77504DD3-B2CD-4676-B6C9-26B24DBA544D",
      "slideTitle" : "スライド #8",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 4.243038548752835,
      "telop" : "「そうですけど…父も、この学校出身なんですか？」",
      "voiceDuration" : 3.6430385487528345,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.008.jpeg"
    },
    {
      "title" : "シーン 9",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_アリス・マーガトロイド.wav",
      "id" : "0F05FAEC-DF56-4015-A40B-D143A27D228C",
      "slideTitle" : "スライド #9",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 7.716145124716553,
      "telop" : "「いや、私たちが以前に、著名大学院同士での交流会の時に、ある男子校の裏側の有名人だったの…、いつの間に子どもを…」",
      "voiceDuration" : 7.116145124716553,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.009.jpeg"
    },
    {
      "title" : "シーン 10",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav",
      "id" : "694934A9-CBC4-4559-8003-3111478D5F2F",
      "slideTitle" : "スライド #10",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 2.6278231292517007,
      "telop" : "「あの、何が言いたいんですか？」",
      "voiceDuration" : 2.0278231292517006,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.010.jpeg"
    },
    {
      "title" : "シーン 11",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_アリス・マーガトロイド.wav",
      "id" : "759903A3-4C56-4023-A7C5-685A9F304F8C",
      "slideTitle" : "スライド #11",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 7.42546485260771,
      "telop" : "「いや、こんな話はもういいわ、それより、君はこれから、一人で教室まで戻れるかしら？戻れないなら、案内するけど…」",
      "voiceDuration" : 6.82546485260771,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.011.jpeg"
    },
    {
      "title" : "シーン 12",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav",
      "id" : "D9C5793F-6A4D-40F7-90C5-B258F5A772C8",
      "slideTitle" : "スライド #12",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.112607709750566,
      "telop" : "「いや、一人で大丈夫です。では、失礼します。」\n僕は、そう言い立ちあがろうとすると、眩暈がする。",
      "voiceDuration" : 7.512607709750567,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.012.jpeg"
    },
    {
      "title" : "シーン 13",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_アリス・マーガトロイド.wav",
      "id" : "303C4E7D-040F-41DE-8E45-8F1B94355813",
      "slideTitle" : "スライド #13",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 5.7864399092970515,
      "telop" : "私は、彼が倒れかけるのを見て、そっと腕を出し支える。\n「君、本当に一人で大丈夫？」",
      "voiceDuration" : 5.186439909297052,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.013.jpeg"
    },
    {
      "title" : "シーン 14",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav",
      "id" : "E7767AEB-9BBC-4D1F-88B6-BCA4E0F89743",
      "slideTitle" : "スライド #14",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 9.85063492063492,
      "telop" : "「きっと、長い時間座っていたからだと思いますから、心配はいらないですよ。それでは、失礼します。」僕はそう言い、部屋を出た。",
      "voiceDuration" : 9.250634920634921,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.014.jpeg"
    },
    {
      "title" : "シーン 15: 東方Project二次創作作品　Powerd By zuyasi",
      "id" : "17EF501C-C85F-4C0E-A8D1-334E2B8E31A3",
      "slideTitle" : "スライド #15",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.015.jpeg",
      "backgroundName" : "単色背景",
      "duration" : 3,
      "characterName" : "博麗霊夢",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "元女子校の日常"
    },
    {
      "title" : "シーン 16",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav",
      "id" : "E9052CC2-47A5-4FB1-B33D-E1A739A35FBA",
      "slideTitle" : "スライド #16",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.490861678004535,
      "telop" : "僕はそれから、夜の学校を歩いていく。だが、空腹と疲労が、溜まりに溜まったこの体が、悲鳴をあげている。",
      "voiceDuration" : 7.890861678004535,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.016.jpeg"
    },
    {
      "title" : "シーン 17",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav",
      "id" : "F7432A65-6CB9-4175-A6DB-9861B88206A6",
      "slideTitle" : "スライド #17",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.09954648526077,
      "telop" : "そして、やがてその疲労は、頭にやってくる。\n「うぅ…」僕は、気絶しないように、意識を保ちながら歩く。",
      "voiceDuration" : 7.499546485260771,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.017.jpeg"
    },
    {
      "title" : "シーン 18",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav",
      "id" : "CE2795F9-7B79-45D4-B87C-AD0D5228F951",
      "slideTitle" : "スライド #18",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 7.548458049886621,
      "telop" : "そして、僕は、ある人影を見る。\nだが、僕はとうとう、その場で気を失い、倒れ込むのだった。",
      "voiceDuration" : 6.9484580498866215,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.018.jpeg"
    },
    {
      "title" : "シーン 19",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_東風谷早苗.wav",
      "id" : "88AA306B-A5F6-4B58-9424-F03EE16CE5F0",
      "slideTitle" : "スライド #19",
      "backgroundName" : "nc485835_学校の廊下（夜・照明OFF）.jpg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "duration" : 8.496009070294784,
      "telop" : "私は、突如倒れ込んだ、彼に近づき、声をかける。\nだが、反応が返らず、彼を抱え、職員室に向かう。",
      "voiceDuration" : 7.8960090702947845,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.019.jpeg"
    },
    {
      "title" : "シーン 20",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_東風谷早苗.wav",
      "id" : "BA379E08-8D98-4ED5-B263-A2054AB1FFE8",
      "slideTitle" : "スライド #20",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（驚く）.png",
      "duration" : 4.794807256235828,
      "telop" : "私が職員室に入ると、彼女が私の方を見ると、驚く。",
      "voiceDuration" : 4.194807256235828,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.020.jpeg"
    },
    {
      "title" : "シーン 21",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_021_射命丸文.wav",
      "id" : "26FB0D90-5253-4FF2-A69E-B214B89591D7",
      "slideTitle" : "スライド #21",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文",
      "characterName" : "射命丸文",
      "transitionName" : "なし",
      "duration" : 3.307596371882086,
      "telop" : "「どうしたんですか、早苗さん、その彼は？」",
      "voiceDuration" : 2.707596371882086,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.021.jpeg"
    },
    {
      "title" : "シーン 22",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_東風谷早苗.wav",
      "id" : "3D36244E-D522-419B-8770-AAD597BF822C",
      "slideTitle" : "スライド #22",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "duration" : 7.38517006802721,
      "telop" : "「ふとさっき、私が廊下を歩いていたら、彼が倒れたんですよ。それで、彼、叩いたら起きますかね…」",
      "voiceDuration" : 6.7851700680272105,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.022.jpeg"
    },
    {
      "title" : "シーン 23",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_射命丸文.wav",
      "id" : "4462D8FB-4EA6-42CC-91DB-E13A0FD99FD8",
      "slideTitle" : "スライド #23",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文",
      "characterName" : "射命丸文",
      "transitionName" : "なし",
      "duration" : 5.499591836734694,
      "telop" : "「いや、叩くのはよしたほうがいいですよ、\n私が彼を自宅まで送り届けましょう。」",
      "voiceDuration" : 4.899591836734694,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.023.jpeg"
    },
    {
      "title" : "シーン 24",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_東風谷早苗.wav",
      "id" : "E7505211-29EE-4E38-8475-CF27B62DD23D",
      "slideTitle" : "スライド #24",
      "backgroundName" : "nc253890_学校の職員室（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97",
      "voiceCharacter" : "東風谷早苗",
      "characterName" : "東風谷早苗",
      "transitionName" : "なし",
      "duration" : 7.289795918367346,
      "telop" : "「そうですか…、それではよろしくお願いします。」\n私は、そういうと、彼の身柄を彼女に預けるのだった。",
      "voiceDuration" : 6.689795918367347,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.024.jpeg"
    },
    {
      "title" : "シーン 25: 文が彼を抱え、彼の家に着くと…",
      "id" : "7E15A222-584B-45A7-A967-CF2995BC6E95",
      "slideTitle" : "スライド #25",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.025.jpeg",
      "backgroundName" : "単色背景",
      "duration" : 3,
      "characterName" : "射命丸文",
      "animationName" : "なし",
      "transitionName" : "なし",
      "telop" : "文が彼を抱え、彼の家に着くと…"
    },
    {
      "title" : "シーン 26",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_026_射命丸文.wav",
      "id" : "780CF6DF-A767-4034-9B88-C9A0ADD62ED4",
      "slideTitle" : "スライド #26",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文",
      "seName" : "SE: ドアチャイム2",
      "characterName" : "射命丸文",
      "transitionName" : "なし",
      "duration" : 7.105578231292517,
      "telop" : "私は、彼の家に着くと、インターホンを押す。\n「武蔵学園の射命丸文です、誰かいらっしゃいませんか？」",
      "voiceDuration" : 6.505578231292517,
      "seAudioPath" : "\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアチャイム2.mp3",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.026.jpeg"
    },
    {
      "title" : "シーン 27",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_射命丸文.wav",
      "id" : "98C765C3-7A27-4B04-B5FF-4AEAA350C973",
      "slideTitle" : "スライド #27",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文",
      "characterName" : "射命丸文",
      "transitionName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png",
      "duration" : 7.117596371882086,
      "telop" : "すると、彼女の母で、学園の卒業生が出てきた。\n「あなたが連絡されていた彼を確保してきました。」",
      "voiceDuration" : 6.517596371882086,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.027.jpeg"
    },
    {
      "title" : "シーン 28",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_博麗霊夢.wav",
      "id" : "5E329694-21F1-49E3-9038-1DA3864EE373",
      "slideTitle" : "スライド #28",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢",
      "characterName" : "博麗霊夢",
      "transitionName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "duration" : 3.9669841269841273,
      "telop" : "「ありがとうございます。」私はそう返す。",
      "voiceDuration" : 3.366984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.028.jpeg"
    },
    {
      "title" : "シーン 29",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_029_射命丸文.wav",
      "id" : "E848F9A4-FFB1-4473-B71B-9FDBE60E70F3",
      "slideTitle" : "スライド #29",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "audioTrack" : "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
      "voiceCharacter" : "射命丸文",
      "characterName" : "射命丸文",
      "transitionName" : "なし",
      "characterImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png",
      "duration" : 6.854580498866213,
      "telop" : "「それじゃあ、後は、よろしくお願いします。」\n私はそういうと、彼をそっと下ろし、その場をさった。",
      "voiceDuration" : 6.254580498866213,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.029.jpeg"
    },
    {
      "title" : "シーン 30",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_博麗霊夢.wav",
      "id" : "AB4DAE2F-4AB5-43FB-A834-118DF5885074",
      "slideTitle" : "スライド #30",
      "backgroundName" : "nc235081_家（夜・灯りあり）.jpg",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢",
      "characterName" : "博麗霊夢",
      "transitionName" : "なし",
      "duration" : 9.120748299319727,
      "telop" : "「はぁ、全く困ったものだわ…」私は、ゆっくりと彼を抱えると、そのまま彼の部屋に、向かうのだった。",
      "voiceDuration" : 8.520748299319727,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.030.jpeg"
    },
    {
      "title" : "シーン 31",
      "animationName" : "なし",
      "animationDuration" : 3,
      "id" : "D55476A2-235E-4B93-AB3E-A8C0F9D0B13E",
      "slideTitle" : "スライド #31",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "duration" : 3,
      "telop" : "彼の目が覚めると…",
      "animationNote" : "表示時間：3秒",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.031.jpeg"
    },
    {
      "title" : "シーン 32",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav",
      "id" : "1E836660-1692-4DE8-8D88-4D893BE99DCE",
      "slideTitle" : "スライド #32",
      "backgroundName" : "一人部屋３（夜・照明OFF）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 7.746303854875283,
      "telop" : "僕は、ふと目が覚めると、そこは自分の部屋だった。\nそして、ゆっくりとベッドから降りて、電気をつける。",
      "voiceDuration" : 7.146303854875283,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.032.jpeg"
    },
    {
      "title" : "シーン 33",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav",
      "id" : "C02A89E3-28B7-44C9-B4F9-A2D95DEDE627",
      "slideTitle" : "スライド #33",
      "backgroundName" : "一人部屋３（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.182154195011337,
      "telop" : "そして、時計を見ると、深夜帯だということに気がつく。\nそして、同時に机の上にメモ書きがあることに気づく。",
      "voiceDuration" : 7.582154195011338,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.033.jpeg"
    },
    {
      "title" : "シーン 34",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav",
      "id" : "A62A0D89-BB55-43DC-9BDE-9CC2D013BB69",
      "slideTitle" : "スライド #34",
      "backgroundName" : "一人部屋３（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.066938775510204,
      "telop" : "そのメモ書きは、僕の知らない筆記跡でこう書かれていた。\n「これ以上無茶をすると、その頭が台無しになるぞ」と…。",
      "voiceDuration" : 7.466938775510204,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.034.jpeg"
    },
    {
      "title" : "シーン 35",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav",
      "id" : "4DCAE7A6-8335-4D83-90CB-371E82C8E59C",
      "slideTitle" : "スライド #35",
      "backgroundName" : "一人部屋３（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.612607709750566,
      "telop" : "「ふっ…」僕は、それを見て思わずそう吹いてしまう。確かに、この人の言うとおり、僕の取り柄は勉学だけだからだ。",
      "voiceDuration" : 8.012607709750567,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.035.jpeg"
    },
    {
      "title" : "シーン 36",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav",
      "id" : "52C53FB6-B279-4B4D-A3E2-A477F5AF01B0",
      "slideTitle" : "スライド #36",
      "backgroundName" : "一人部屋３（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 9.20498866213152,
      "telop" : "そして、そのメモ書きを残した人物にも、心当たりがないわけではなかった、だが、ごく僅かに感じるそれを、僕は思い返す。",
      "voiceDuration" : 8.60498866213152,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.036.jpeg"
    },
    {
      "title" : "シーン 37",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav",
      "id" : "12D94490-1314-4F2D-9462-4867046E889B",
      "slideTitle" : "スライド #37",
      "backgroundName" : "一人部屋３（夜・照明ON）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.289773242630385,
      "telop" : "そして、ふとその横にある家族写真が目に映る…。\nそして、「ふぅ」と一息吐くと、電気を消し、ベッドに戻った。",
      "voiceDuration" : 7.689773242630386,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.037.jpeg"
    },
    {
      "title" : "シーン 38",
      "animationName" : "なし",
      "animationDuration" : 3,
      "id" : "487F99C2-0195-49FE-B96E-CFF300954E96",
      "slideTitle" : "スライド #38",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "duration" : 3,
      "telop" : "そのころ、とある場所では…",
      "animationNote" : "表示時間：3秒",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.038.jpeg"
    },
    {
      "title" : "シーン 39",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_霧雨魔理沙.wav",
      "id" : "F2A797D3-5BED-48C9-9106-B460E4CED854",
      "slideTitle" : "スライド #39",
      "backgroundName" : "nc238758_一人部屋（夜・月明り）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 9.096984126984127,
      "telop" : "私は、自分の部屋で窓に視線を当てながら、片手に缶ビールを持ち、ぼそぼそと、一人小言を呟いていた。",
      "voiceDuration" : 8.496984126984128,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.039.jpeg"
    },
    {
      "title" : "シーン 40",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_霧雨魔理沙.wav",
      "id" : "3ECA008F-C3E8-4420-859D-FBA22774A8A2",
      "slideTitle" : "スライド #40",
      "backgroundName" : "nc238758_一人部屋（夜・月明り）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 8.776984126984127,
      "telop" : "「なぁ、お前は、どう思う、今の私を見て…」\n私は、誰もいない部屋で、そう誰かに語りかける。",
      "voiceDuration" : 8.176984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.040.jpeg"
    },
    {
      "title" : "シーン 41",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_霧雨魔理沙.wav",
      "id" : "932C24AD-8E8F-4731-860B-281A5BC10E3E",
      "slideTitle" : "スライド #41",
      "backgroundName" : "nc238758_一人部屋（夜・月明り）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 8.950748299319727,
      "telop" : "だが、返事はない。それでも私は、言葉を続ける。\n「今の私が、お前に知られたら、きっと…」",
      "voiceDuration" : 8.350748299319728,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.041.jpeg"
    },
    {
      "title" : "シーン 42",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_霧雨魔理沙.wav",
      "id" : "FCB8DBED-7CB8-4E34-B132-CE3000B95491",
      "slideTitle" : "スライド #42",
      "backgroundName" : "nc238758_一人部屋（夜・月明り）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 9.115736961451248,
      "telop" : "「きっと…」私は、そう言うと、ふと後ろから声が聞こえる。\n誰もいないはずの空間からは、声が聞こえる。",
      "voiceDuration" : 8.515736961451248,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.042.jpeg"
    },
    {
      "title" : "シーン 43",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_霧雨魔理沙.wav",
      "id" : "A88152A1-E647-4BDE-BC39-2913684894CE",
      "slideTitle" : "スライド #43",
      "backgroundName" : "nc238758_一人部屋（夜・月明り）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 10.179478458049886,
      "telop" : "だが、私は、頭を振り、缶ビールを飲み切ると、そのままベッドに入る。だが、だんだんと、その声は大きくなる。",
      "voiceDuration" : 9.579478458049886,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.043.jpeg"
    },
    {
      "title" : "シーン 44",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_霧雨魔理沙.wav",
      "id" : "210EA977-901D-406C-8D2F-10B35C403300",
      "slideTitle" : "スライド #44",
      "backgroundName" : "nc238758_一人部屋（夜・月明り）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 5.409478458049886,
      "telop" : "私は、ふと気がつけば、その声に体が勝手に動いていた。",
      "voiceDuration" : 4.809478458049886,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.044.jpeg"
    },
    {
      "title" : "シーン 45",
      "animationName" : "なし",
      "animationDuration" : 3,
      "id" : "85F46B6C-9367-4153-A310-3C06A1F2E8A7",
      "slideTitle" : "スライド #45",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "duration" : 3,
      "telop" : "それから…",
      "animationNote" : "表示時間：3秒",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.045.jpeg"
    },
    {
      "title" : "シーン 46",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_霧雨魔理沙.wav",
      "id" : "6B8C7BA0-09BC-419E-834F-A498ED0E1775",
      "slideTitle" : "スライド #46",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 7.4682312925170065,
      "telop" : "「あれ、私は…いったい何を…」\n私は、ふと気がつくと、そこはある交差点だった。",
      "voiceDuration" : 6.868231292517007,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.046.jpeg"
    },
    {
      "title" : "シーン 47",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_妹紅.wav",
      "id" : "18E72FE4-8A52-43A0-A4B2-9C0364073808",
      "slideTitle" : "スライド #47",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅",
      "characterName" : "妹紅",
      "transitionName" : "なし",
      "duration" : 8.212063492063493,
      "telop" : "「お前、今俺が止めなければ、車に轢かれるところだったぞ。\nこんな時間帯に、女一人でふらふら何してたんだ？」",
      "voiceDuration" : 7.612063492063492,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.047.jpeg"
    },
    {
      "title" : "シーン 48",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_霧雨魔理沙.wav",
      "id" : "19CBEF2C-2152-48DB-A618-391D9CD78D5E",
      "slideTitle" : "スライド #48",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 4.149478458049886,
      "telop" : "「えっ…」私はそう言われるが、思い出せない。",
      "voiceDuration" : 3.5494784580498866,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.048.jpeg"
    },
    {
      "title" : "シーン 49",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_妹紅.wav",
      "id" : "DFB22C6F-6FBA-4108-AD0A-1A73463C7AA5",
      "slideTitle" : "スライド #49",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅",
      "characterName" : "妹紅",
      "transitionName" : "なし",
      "duration" : 7.993333333333333,
      "telop" : "「まぁ、車が走ってなかったことが幸いか。それより、お前さんは、どうしたんだ、何かに血迷ってるのか？」",
      "voiceDuration" : 7.3933333333333335,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.049.jpeg"
    },
    {
      "title" : "シーン 50",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_霧雨魔理沙.wav",
      "id" : "E519D15E-8E49-438A-8B32-4163C14FB487",
      "slideTitle" : "スライド #50",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 6.928231292517006,
      "telop" : "「えっと…、私はただ…」\nそう言いかけて気がつく。「あなたは、霊夢の旦那さん…」",
      "voiceDuration" : 6.328231292517007,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.050.jpeg"
    },
    {
      "title" : "シーン 51",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_妹紅.wav",
      "id" : "AE5B8CAE-C814-411E-AF99-BD7C59186343",
      "slideTitle" : "スライド #51",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅",
      "characterName" : "妹紅",
      "transitionName" : "なし",
      "duration" : 3.6141496598639455,
      "telop" : "「そうか…、そしたら、久々の顔合わせだな…」",
      "voiceDuration" : 3.0141496598639455,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.051.jpeg"
    },
    {
      "title" : "シーン 52",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_妹紅.wav",
      "id" : "44F6F1B0-00AA-47DE-AA35-1CE41DF936E7",
      "slideTitle" : "スライド #52",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_%E5%A6%B9%E7%B4%85",
      "voiceCharacter" : "妹紅",
      "characterName" : "妹紅",
      "transitionName" : "なし",
      "duration" : 7.667278911564625,
      "telop" : "「まぁ、とにかく、次からは、信号をよく見て渡るんだな。」\n私は、そう言うと、その場をさっていった。",
      "voiceDuration" : 7.0672789115646255,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.052.jpeg"
    },
    {
      "title" : "シーン 53",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_053_霧雨魔理沙.wav",
      "id" : "D0B10D86-9AE8-4222-98EF-845228FC4B27",
      "slideTitle" : "スライド #53",
      "backgroundName" : "nc257257_街中の交差点（夜）.jpg",
      "audioTrack" : "track_voice_marisa",
      "voiceCharacter" : "霧雨魔理沙",
      "characterName" : "霧雨魔理沙",
      "transitionName" : "なし",
      "duration" : 9.936984126984127,
      "telop" : "私は、彼が立ち去ると、「あの声は、いったい誰の声だったんだろう…」っと、そう呟きながら、家に帰るのだった。",
      "voiceDuration" : 9.336984126984127,
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.053.jpeg"
    },
    {
      "title" : "シーン 54",
      "animationName" : "なし",
      "animationDuration" : 3,
      "id" : "A95D7341-2AEA-4127-B670-4BF1EDA508F5",
      "slideTitle" : "スライド #54",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "characterName" : "ナレーション",
      "transitionName" : "なし",
      "duration" : 3,
      "telop" : "翌朝…",
      "animationNote" : "表示時間：3秒",
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.054.jpeg"
    },
    {
      "title" : "シーン 55",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav",
      "id" : "DFBD58BE-E787-412A-BE72-4A8590771179",
      "slideTitle" : "スライド #55",
      "backgroundName" : "一人部屋３（日中）.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.275646258503402,
      "telop" : "僕は、目が覚め、カーテンを開けると、朝日が部屋に差し込んでいた。そして、あくびをしながら、リビングに向かう。",
      "voiceDuration" : 7.675646258503401,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.055.jpeg"
    },
    {
      "title" : "シーン 56",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav",
      "id" : "D38C2BA5-258E-4098-B985-43097199D94A",
      "slideTitle" : "スライド #56",
      "backgroundName" : "リビング（日中）.jpeg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 3.30390022675737,
      "telop" : "「どうしたの、母さん、そんな顔して。」",
      "voiceDuration" : 2.7039002267573697,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.056.jpeg"
    },
    {
      "title" : "シーン 57",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav",
      "id" : "EF1560B6-27C0-4FC4-8DC5-5478E2D23F6D",
      "slideTitle" : "スライド #57",
      "backgroundName" : "リビング（日中）.jpeg",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢",
      "characterName" : "博麗霊夢",
      "transitionName" : "なし",
      "duration" : 9.443242630385488,
      "telop" : "「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」",
      "voiceDuration" : 8.843242630385488,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.057.jpeg"
    },
    {
      "title" : "シーン 58",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav",
      "id" : "6E472622-25F5-4E44-989B-0D0A3712B155",
      "slideTitle" : "スライド #58",
      "backgroundName" : "リビング（日中）.jpeg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.695215419501134,
      "telop" : "「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」",
      "voiceDuration" : 8.095215419501134,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.058.jpeg"
    },
    {
      "title" : "シーン 59",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_059_博麗霊夢.wav",
      "id" : "284BF57D-D190-428A-921B-B664F47282BC",
      "slideTitle" : "スライド #59",
      "backgroundName" : "リビング（日中）.jpeg",
      "audioTrack" : "track_voice_reimu",
      "voiceCharacter" : "博麗霊夢",
      "characterName" : "博麗霊夢",
      "transitionName" : "なし",
      "duration" : 2.5494784580498866,
      "telop" : "「それじゃあ、行ってくるわ…」",
      "voiceDuration" : 1.9494784580498867,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.059.jpeg"
    },
    {
      "title" : "シーン 60",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_060_操夢.wav",
      "id" : "3543DBDA-FB3D-42AB-845A-5809D84657E7",
      "slideTitle" : "スライド #60",
      "backgroundName" : "リビング（日中）.jpeg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 7.784331065759637,
      "telop" : "僕は、それから朝食を食べ終えると、母が残していた洗い物などもまとめて済ませ、ふと冷蔵庫を開けてみる。",
      "voiceDuration" : 7.184331065759637,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.060.jpeg"
    },
    {
      "title" : "シーン 61",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav",
      "id" : "DA7C1DB0-4384-4D6F-A6B5-DAC6321E7AC1",
      "slideTitle" : "スライド #61",
      "backgroundName" : "リビング（日中）.jpeg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 7.839773242630385,
      "telop" : "冷蔵庫の中は、スカスカだった。「買い物しないと…」\n僕は、そうぼさっと呟きながら、自室に戻る。",
      "voiceDuration" : 7.239773242630386,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.061.jpeg"
    },
    {
      "title" : "シーン 62",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav",
      "id" : "42AB6BD6-DE45-44B0-AE96-1158739A9AA9",
      "slideTitle" : "スライド #62",
      "backgroundName" : "一人部屋３（日中）.pxd",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 9.519115646258504,
      "telop" : "そして、自室に戻ってくると、少し目に見えぬ埃が溜まっていたので、軽くを掃除機をかける。そして、ふと両親の部屋に向かう。",
      "voiceDuration" : 8.919115646258504,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）叡智シーンのみ\/一人部屋３（日中）.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.062.jpeg"
    },
    {
      "title" : "シーン 63",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav",
      "id" : "0CFE0F74-ABB1-4C45-B97E-F997D63DC81B",
      "slideTitle" : "スライド #63",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 8.358253968253969,
      "telop" : "そして、ふと窓から見える背景を見て思い出す、ここは台地の上で、向こう側は低地なため、景色が随分といいのだ。",
      "voiceDuration" : 7.758253968253968,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.063.jpeg"
    },
    {
      "title" : "シーン 64",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav",
      "id" : "839FCCD6-6A7C-4E14-B271-3CFA7290C267",
      "slideTitle" : "スライド #64",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 9.347369614512472,
      "telop" : "そして、部屋を見渡す。母は準備をきちんと済ませてから、リビングで朝食を食べていた。僕は、机からメモ帳を出す。",
      "voiceDuration" : 8.747369614512472,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.064.jpeg"
    },
    {
      "title" : "シーン 65",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav",
      "id" : "915318AD-A04B-4CB6-8AAD-A15D3A1C7292",
      "slideTitle" : "スライド #65",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 9.09845804988662,
      "telop" : "そして、そこに冷蔵庫がスカスカなのを記して、机に残すと、僕は、自室で身なりを整えてから、学校に向かうのだった。",
      "voiceDuration" : 8.49845804988662,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
