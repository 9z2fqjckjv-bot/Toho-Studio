      "slideTitle" : "スライド #2",
      "backgroundName" : "nc73538_【背景素材】博麗神社.jpg",
      "audioTrack" : "track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89",
      "voiceCharacter" : "アリス・マーガトロイド",
      "characterName" : "アリス・マーガトロイド",
      "transitionName" : "なし",
      "duration" : 6.076235827664399,
      "telop" : "「ごめんなさいね…、こんな時間まで、拘束しちゃって…」\n私が時計を見ると、夜の8時を指していた。\n作成者：zuyasi",
      "voiceDuration" : 5.476235827664399,
      "backgroundImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg",
      "slideImagePath" : "\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.002.jpeg"
    },
    {
      "title" : "シーン 3: 「いえ…、僕が、あの小瓶を持ってたのが、\n原因ですから、謝らなくても大丈夫ですよ。」",
      "animationName" : "なし",
      "voiceAudioPath" : "\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav",
      "id" : "9F5EA844-A89C-4FB6-A49C-89402DBFFD17",
      "slideTitle" : "スライド #3",
      "backgroundName" : "単色背景",
      "audioTrack" : "track_voice_soumu",
      "voiceCharacter" : "操夢",
      "characterName" : "操夢",
      "transitionName" : "なし",
      "duration" : 6.573469387755102,
      "telop" : "「いえ…、僕が、あの小瓶を持ってたのが、原因ですから、謝らなくても大丈夫ですよ。」",
