\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_フランドール・スカーレット.wav","bgmVolume":0.7,"telop":"「ここが、図書館。取り出した本は、元の位置に戻してよ。」\n私は、そう言うと、私と彼の部屋に戻っていった。","title":"シーン 52","voiceDuration":9.850748299319728,"characterName":"フランドール・スカーレット","id":"FEA942EE-B0B2-470D-875B-97FA15B508A0","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.052.jpeg","voiceCharacter":"フランドール・スカーレット","bgmStartTimeOffset":0},{"duration":7.937596371882086,"animationName":"なし","slideTitle":"スライド #53","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_サブ.wav","bgmVolume":0.7,"telop":"「さてと…」私はそう言いながら、一息吐くと、適当な本棚を眺めながら、図書館を歩き回るのだった。","title":"シーン 53","voiceDuration":7.3375963718820865,"characterName":"サブ","id":"6B2623DD-F6D0-42CF-8B42-6D3D752E47AB","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","audioTrack":"track_voice_sub","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.053.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"duration":3,"animationName":"なし","voice2StartTimeOffset":0,"slideTitle":"スライド #54","transitionName":"なし","bgmVolume":0.7,"telop":"その頃、彼が元いた家では…","title":"シーン 54: その頃、彼が元いた家では…","characterName":"操夢","id":"7868C366-F1A8-4C9C-8208-C82E4CC9FB86","backgroundName":"単色背景","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.054.jpeg","bgmStartTimeOffset":0},{"duration":10.671995464852607,"animationName":"なし","slideTitle":"スライド #55","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav","bgmVolume":0.7,"telop":"私は、家に帰ってくるとため息をつく。例の騒動を鎮静化させる代わりに、魔理沙の面倒を私と彼で見ることになったからだ。","title":"シーン 55","voiceDuration":10.071995464852607,"characterName":"博麗霊夢","id":"5CFD1B05-3343-4AC4-8696-379916106A21","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","audioTrack":"track_voice_reimu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.055.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":7.681995464852608,"animationName":"なし","slideTitle":"スライド #56","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_博麗霊夢.wav","bgmVolume":0.7,"telop":"「私の母校は昔から何も変わってないわね…」\n私がそう呟いていると、インターホンが鳴る。","title":"シーン 56","voiceDuration":7.081995464852608,"characterName":"博麗霊夢","id":"B9B22424-767E-427A-B9DC-034371A44632","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","audioTrack":"track_voice_reimu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.056.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":11.939478458049885,"animationName":"なし","slideTitle":"スライド #57","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav","bgmVolume":0.7,"telop":"私が外に出ると、書留郵便物の受け渡しだった。しかも、発送日時が数時間前になっていて、即日夜間速達の印があった。","title":"シーン 57","voiceDuration":11.339478458049886,"characterName":"博麗霊夢","id":"FBDF0248-868D-42DA-98E7-7F6163833E2E","backgroundName":"nc235081_家（夜・灯りあり）.jpg","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.057.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":9.614489795918367,"animationName":"なし","slideTitle":"スライド #58","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_博麗霊夢.wav","bgmVolume":0.7,"telop":"即日夜間速達は、高い料金と引き換えに、夕方から夜にかけて出せば、日付が変わる前に届くと言うものだ。","title":"シーン 58","voiceDuration":9.014489795918367,"characterName":"博麗霊夢","id":"5BCB301B-151E-409B-B284-D3CA14CC67E0","backgroundName":"nc235081_家（夜・灯りあり）.jpg","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.058.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":11.290748299319727,"animationName":"なし","slideTitle":"スライド #59","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav","bgmVolume":0.7,"telop":"私は、ふとその封筒の宛名を見る。そこには、私と夫の名前があり、差出人には…ある建設会社の代表の名前があった。","title":"シーン 59","voiceDuration":10.690748299319727,"characterName":"博麗霊夢","id":"F07E71AB-48D0-41E4-AA02-A88878B1D995","backgroundName":"nc235081_家（夜・灯りあり）.jpg","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.059.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":3.526984126984127,"animationName":"なし","slideTitle":"スライド #60","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_博麗霊夢.wav","bgmVolume":0.7,"telop":"私はふと、昨晩のことを思い出す。","title":"シーン 60","voiceDuration":2.926984126984127,"characterName":"博麗霊夢","id":"8563BA5E-5B41-409A-B9A3-A32670318EFC","backgroundName":"nc235081_家（夜・灯りあり）.jpg","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.060.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":9.613242630385487,"animationName":"なし","slideTitle":"スライド #61","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav","bgmVolume":0.7,"telop":"私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」\n第10話を参照","title":"シーン 61","voiceDuration":9.013242630385488,"characterName":"博麗霊夢","id":"EA909405-9709-41F4-8682-F2126EA6E2E2","backgroundName":"nc256639_警察署（夜）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","audioTrack":"track_voice_reimu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.061.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":5.781746031746032,"animationName":"なし","slideTitle":"スライド #62","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「実は、あなたの息子さんの将来に関わることで、\n折行ってご相談がありまして…」","title":"シーン 62","voiceDuration":5.181746031746032,"characterName":"レミリア・スカーレット","id":"186BB5B0-316A-4FE2-BA9B-AB1A6B26F044","backgroundName":"nc256639_警察署（夜）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.062.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"duration":2.5,"animationName":"なし","slideTitle":"スライド #63","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_博麗霊夢.wav","bgmVolume":0.7,"telop":"「何の相談ですか？」","title":"シーン 63","voiceDuration":1.696984126984127,"characterName":"博麗霊夢","id":"ED9EBC46-C495-49A6-AF7A-CFE8970995BE","backgroundName":"nc256639_警察署（夜）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","audioTrack":"track_voice_reimu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.063.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":2.5,"animationName":"なし","slideTitle":"スライド #64","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「実は…」","title":"シーン 64","voiceDuration":0.665079365079365,"characterName":"レミリア・スカーレット","id":"423C596A-8838-4842-A805-14DF006CE99F","backgroundName":"nc256639_警察署（夜）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.064.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"duration":11.033242630385487,"animationName":"なし","slideTitle":"スライド #65","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_博麗霊夢.wav","bgmVolume":0.7,"telop":"私は、それを思い出すと、その場で中身を見る。そこには、婚姻届のコピーがあった。私はそれを見ると、寝室に向かう。","title":"シーン 65","voiceDuration":10.433242630385488,"characterName":"博麗霊夢","id":"E2949627-60E7-42D2-AD7E-9F7C76C039A1","backgroundName":"nc235081_家（夜・灯りあり）.jpg","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.065.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":10.386984126984126,"animationName":"なし","slideTitle":"スライド #66","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav","bgmVolume":0.7,"telop":"そして、魔理沙が家に来る前に取り出した、息子の部屋にあった書類や荷物、そして過去の記録物を取り出し、中身を確認する。","title":"シーン 66","voiceDuration":9.786984126984127,"characterName":"博麗霊夢","id":"0ECDC622-893D-487B-BEC8-673E2F8503B5","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.066.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":9.425736961451246,"animationName":"なし","slideTitle":"スライド #67","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_博麗霊夢.wav","bgmVolume":0.7,"telop":"その中身にある文字と、婚姻届の文字を比較する。どうやら、彼が書いたわけではなかった。「もしかしたら…」","title":"シーン 67","voiceDuration":8.825736961451247,"characterName":"博麗霊夢","id":"1BF1E4F6-B3AA-4342-B93E-2E9FE41267B8","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.067.jpeg","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0},{"duration":11.816984126984126,"animationName":"なし","slideTitle":"スライド #68","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_博麗霊夢.wav","bgmVolume":0.7,"telop":"私は、取り出した書類や荷物の中から、入念深く探す。すると、あるものを見つける。その文字と婚姻届の文字は似通っていた。","title":"シーン 68","voiceDuration":11.216984126984126,"characterName":"博麗霊夢","id":"28844A6E-A5B1-4611-A877-B422F6243A6E","backgroun