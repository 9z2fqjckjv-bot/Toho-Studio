eratedAudio\/Slide_012_操夢.wav","bgmVolume":0.7,"telop":"僕が、その返答に悩んでいると、\nレミリアが僕たちに、ある言葉を突きつけていくのだった。","title":"シーン 12","voiceDuration":6.015850340136055,"characterName":"操夢","id":"A8355E1B-9BE7-456A-8588-EC1E0F7B5586","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.012.jpeg","voiceCharacter":"操夢","bgmStartTimeOffset":0},{"duration":3,"animationName":"なし","voice2StartTimeOffset":0,"slideTitle":"スライド #13","transitionName":"なし","bgmVolume":0.7,"telop":"元女子校の日常","title":"シーン 13: 東方Project二次創作作品　Powerd By zuyasi","characterName":"操夢","id":"04114516-2161-42BF-A5C9-B78648D15B87","backgroundName":"単色背景","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.013.jpeg","bgmStartTimeOffset":0},{"duration":9.312607709750566,"animationName":"なし","slideTitle":"スライド #14","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","bgmVolume":0.7,"telop":"あの後、僕たちは二人で入浴する羽目になり、僕たちの間には気まずさを超えた、冷たい空気が漂いながら、夕飯を迎えた。","title":"シーン 14","voiceDuration":8.712607709750566,"characterName":"操夢","id":"E407DA8B-9710-403D-AAC0-37AC0C948775","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.014.jpeg","voiceCharacter":"操夢","bgmStartTimeOffset":0},{"duration":7.108820861678004,"animationName":"なし","slideTitle":"スライド #15","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「それじゃあ、夕飯を食べましょうか。」\n私は、そう二人に言うが、二人からの反応は返ってこない。","title":"シーン 15","voiceDuration":6.5088208616780046,"characterName":"レミリア・スカーレット","id":"F78DEC61-19CD-4C83-93B1-B26059990E39","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.015.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"duration":3.8879818594104307,"animationName":"なし","slideTitle":"スライド #16","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「早く、夕飯食べないと、料理が冷めちゃうわよ。」","title":"シーン 16","voiceDuration":3.2879818594104306,"characterName":"レミリア・スカーレット","id":"CBB9CFB1-65F8-472E-86E0-34D71C918CF7","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.016.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"duration":8.511519274376417,"animationName":"なし","slideTitle":"スライド #17","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","bgmVolume":0.7,"telop":"僕たちは、彼女にそう告げられ、仕方なく料理に手を伸ばす。だが、先ほどまでの出来事が頭から離れなかった。","title":"シーン 17","voiceDuration":7.911519274376417,"characterName":"操夢","id":"7CB359C1-133B-4DAF-AB40-53CB1051900F","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.017.jpeg","voiceCharacter":"操夢","bgmStartTimeOffset":0},{"duration":7.134331065759637,"animationName":"なし","slideTitle":"スライド #18","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","bgmVolume":0.7,"telop":"僕はそれから、機械的に食べ進めて、\n食事を終えると、彼女が突如として、声をかけてくる。","title":"シーン 18","voiceDuration":6.534331065759638,"characterName":"操夢","id":"803034A1-E239-4303-B70B-5123CBCB2B37","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.018.jpeg","voiceCharacter":"操夢","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":6.777573696145124,"animationName":"なし","slideTitle":"スライド #19","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「さてと、そろそろデザートの時間にしましょうか。」\n私はそう二人に告げて、そっと席を立つ。","title":"シーン 19","voiceDuration":6.177573696145124,"characterName":"レミリア・スカーレット","id":"5FC7B1E1-5FCD-4549-A944-5FDD3E0A6A05","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.019.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","duration":7.921292517006802,"animationName":"なし","slideTitle":"スライド #20","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","bgmVolume":0.7,"telop":"僕がふとフランの方に視線をやると、彼女が驚いた。\nそれと同時、首筋に誰かが、噛み付いてくる。","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/噛みつく.mp3","title":"シーン 20","voiceDuration":7.321292517006802,"characterName":"操夢","seName":"SE: 噛みつく","id":"86428912-C9C7-4AE0-A4DF-4F2CAECF2733","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"seVolume":0.85867919921875,"seStartTimeOffset":2.18,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.020.jpeg","voiceCharacter":"操夢","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","duration":7.100634920634921,"animationName":"なし","slideTitle":"スライド #21","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","bgmVolume":0.7,"telop":"そして、僕がその行為が何であるかを把握するうちに、\n僕の意識が闇の中へ、落ちていくのだった。","title":"シーン 21","voiceDuration":6.500634920634921,"characterName":"操夢","id":"7FB4CC38-9A00-4C58-B740-B215265B2D98","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.021.jpeg","voiceCharacter":"操夢","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":10.438684807256235,"animationName":"なし","slideTitle":"スライド #22","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_サブ.wav","bgmVolume":0.7,"telop":"私は、ふと周囲を見渡すと、一方には、先日レミリアと名乗っていた人物、もう一方にはその妹がいた。するとレミリアが話しかけてくる。","title":"シーン 22","voiceDuration":9.838684807256236,"characterName":"サブ","id":"3272DA02-B59E-4FB0-A7FA-4BA10EC421BE","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.022.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":3.767165532879819,"animationName":"なし","slideTitle":"スライド #23","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「あら、ご機嫌用、今のご気分はいかがですか？」","title":"シーン 23","voiceDuration":3.1671655328798187,"characterName":"レミリア・スカーレット","id":"E83F4299-9765-4ADB-A8B1-2A0883F73905","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.023.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":3.562607709750567,"animationName":"なし","slideTitle":"スライド #24","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_サブ.wav","bgmVolume":0.7,"telop":"「普段と変わらない…とでも言っておきましょうか…。」","title":"シーン 24","voiceDuration":2.962607709750567,"characterName":"サブ","id":"096DF291-C7D8-436F-9E6A-F75171BC38C5","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.024.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":9.050498866213152,"animationName":"なし","slideTitle":"スライド #25","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「そうですか。確か私とあなたが対面するのは、あの深夜帯の学校以来ですね。あれから、彼に何か変化はありましたか？」","title":"シーン 25","voiceDuration":8.450498866213152,"characterName":"レミリア・スカーレット","id":"B8EE4836-6595-4234-BF35-36B63D0D0648","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.025.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":6.262607709750567,"animationName":"なし","slideTitle":"スライド #26","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_サブ.wav","bgmVolume":0.7,"telop":"「それより、あなたの妹さんが、\n先ほどから固まってますけど、大丈夫でしょうか？」","title":"シーン 26","voiceDuration":5.662607709750567,"characterName":"サブ","id":"5BCD4889-5CBC-44DA-BA55-CBEA488929C2","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.026.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":8.306734693877551,"animationName":"なし","slideTitle":"スライド #27","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「あら、それは失礼」私はそう言いながら、フランに軽いパンチをする。「しっかりしなさい、彼女は彼の裏に潜んでるのよ。」","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/軽いパンチ1.mp3","title":"シーン 27","voiceDuration":7.706734693877551,"characterName":"レミリア・スカーレット","seName":"SE: 軽いパンチ1","id":"4D5655A9-5D43-4D33-8060-E8A0AE23F65F","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":0.85,"seStartTimeOffset":1.43,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.027.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":4.475646258503401,"animationName":"なし","slideTitle":"スライド #28","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_サブ.wav","bgmVolume":0.7,"telop":"彼女が、妹のフランにパンチをすると、表情が変わる。","title":"シーン 28","voiceDuration":3.8756462585034015,"characterName":"サブ","id":"1A80A882-6883-4C71-A103-D6D6A6FD7337","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.028.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":7.356145124716553,"animationName":"なし","slideTitle":"スライド #29","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「フラン、ああ見えても、彼女と彼は同一人物なのよ。\nだから、気をしっかり持って、接しなさい。」","title":"シーン 29","voiceDuration":6.756145124716554,"characterName":"レミリア・スカーレット","id":"C8F50A88-7C64-4A81-8E6A-B17E4CC245D5","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.029.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":3.6694784580498867,"animationName":"なし","slideTitle":"スライド #30","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_フランドール・スカーレット.wav","bgmVolume":0.7,"telop":"「そう…なんだ…」私はそう呟く。","title":"シーン 30","voiceDuration":3.0694784580498866,"characterName":"フランドール・スカーレット","id":"262B4F04-64F8-48B3-9E4A-6A5C59006010","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.030.jpeg","voiceCharacter":"フランドール・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":5.412607709750566,"animationName":"なし","slideTitle":"スライド #31","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_サブ.wav","bgmVolume":0.7,"telop":"「それで、私を呼び出したと言うことは、\n何かしらの事情があるのですね？」","title":"シーン 31","voiceDuration":4.812607709750567,"characterName":"サブ","id":"95F20633-8835-48E0-9673-6B409306C1EC","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.031.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":6.69156462585034,"animationName":"なし","slideTitle":"スライド #32","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「ええそうよ。」私はそう言うと、\n事前に用意してあった、書面を彼女の方へとスライドさせる。","title":"シーン 32","voiceDuration":6.09156462585034,"characterName":"レミリア・スカーレット","id":"B3621467-D7C5-49B9-91D3-8A0EC78E0604","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.032.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":4.302562358276644,"animationName":"なし","slideTitle":"スライド #33","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「その書面を挟んでいるボールペンで、サインを頂けるかしら。」","title":"シーン 33","voiceDuration":3.702562358276644,"characterName":"レミリア・スカーレット","id":"FB38D172-AEB7-4804-8B33-8D73548AB925","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.033.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":8.835419501133787,"animationName":"なし","slideTitle":"スライド #34","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_サブ.wav","bgmVolume":0.7,"telop":"その書面には、先日の深夜帯に交わした契約を記したものと、フランの名前が記載された、婚姻届が挟まれてあった。","title":"シーン 34","voiceDuration":8.235419501133787,"characterName":"サブ","id":"1269A6BA-A9DE-4EA0-9E15-AE798D213D76","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.034.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":9.692154195011337,"animationName":"なし","slideTitle":"スライド #35","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「婚姻届の方は、まだ仮の状態よ。だから、あなたがサインしても、彼が拒絶すれば、無効。それで、返答はどうかしら？」","title":"シーン 35","voiceDuration":9.092154195011338,"characterName":"レミリア・スカーレット","id":"D325E394-3B4A-4477-9DF0-272DF2057D54","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.035.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":8.721292517006802,"animationName":"なし","slideTitle":"スライド #36","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_サブ.wav","bgmVolume":0.7,"telop":"私はふと考える、この機を逃せば、2度とこの書面を見れない気がした。そして、ペンを手に取ると、サインをして返す。","title":"シーン 36","voiceDuration":8.121292517006802,"characterName":"サブ","id":"90FF4D3F-79D8-4486-A753-5311F48FE639","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.036.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":5.956734693877551,"animationName":"なし","slideTitle":"スライド #37","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「フラン、この書類のコピーを取ってきなさい。」\n私はそう言い、書類とペンを渡す。","title":"シーン 37","voiceDuration":5.356734693877551,"characterName":"レミリア・スカーレット","id":"2BE3BB26-C732-412F-A4C3-FB02E908AE9A","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.037.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":9.582154195011338,"animationName":"なし","slideTitle":"スライド #38","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_038_サブ.wav","bgmVolume":0.7,"telop":"「夕方からのあなたの発言や所作は、私が表に出てくるように仕向けた手順なのですか？」私は確認のために、そう尋ねる。","title":"シーン 38","voiceDuration":8.982154195011338,"characterName":"サブ","id":"AD3B4731-5FEE-49D1-8FF5-A4967AFF1F7A","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.038.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":7.185895691609977,"animationName":"なし","slideTitle":"スライド #39","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「ええ、そうよ。彼は見事に、引っかかってくれたわ。\nそれで、あなたはこれからどうするのかしら？」","title":"シーン 39","voiceDuration":6.585895691609977,"characterName":"レミリア・スカーレット","id":"8699B657-BFE8-4BBE-9024-6F386063F283","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.039.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":2.5,"animationName":"なし","slideTitle":"スライド #40","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_サブ.wav","bgmVolume":0.7,"telop":"「特にありませんよ。」","title":"シーン 40","voiceDuration":1.33,"characterName":"サブ","id":"7B5F7457-CE5D-4C48-AC3C-FA3E479F86C2","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.040.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","duration":8.881746031746031,"animationName":"なし","slideTitle":"スライド #41","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_レミリア・スカーレット.wav","bgmVolume":0.7,"telop":"「そう。なら、この屋敷に図書館があるから、彼女に聞いて、読書するのがいいわ。何かあれば、彼女に聞いてちょうだい。」","title":"シーン 41","voiceDuration":8.281746031746032,"characterName":"レミリア・スカーレット","id":"6429C000-D928-4895-B2DE-75F12ECBAC20","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.041.jpeg","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0},{"duration":6.239773242630386,"animationName":"なし","slideTitle":"スライド #42","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_サブ.wav","bgmVolume":0.7,"telop":"彼女はそう言うと、どこかへと去っていった。\nすると入れ替わるように、フランがやってくる。","title":"シーン 42","voiceDuration":5.639773242630386,"characterName":"サブ","id":"B3B9E68C-4384-431D-A865-B522D17553F0","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.042.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","duration":2.5,"animationName":"なし","slideTitle":"スライド #43","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_フランドール・スカーレット.wav","bgmVolume":0.7,"telop":"「あれ、お姉様は？」","title":"シーン 43","voiceDuration":1.7344897959183674,"characterName":"フランドール・スカーレット","id":"B1CF3BE5-9379-4D64-9AF2-94518E6B4A95","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.043.jpeg","voiceCharacter":"フランドール・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","duration":3.4647619047619047,"animationName":"なし","slideTitle":"スライド #44","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_サブ.wav","bgmVolume":0.7,"telop":"「彼女なら、どこかに向かって行きましたよ。」","title":"シーン 44","voiceDuration":2.8647619047619046,"characterName":"サブ","id":"2DB88BC9-7AAB-47DD-94C9-9F866E0BFDC6","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.044.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","duration":4.596984126984127,"animationName":"なし","slideTitle":"スライド #45","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_フランドール・スカーレット.wav","bgmVolume":0.7,"telop":"「そう。それで、あなたは…これからどうするの？」","title":"シーン 45","voiceDuration":3.996984126984127,"characterName":"フランドール・スカーレット","id":"B4758C01-112C-4756-A913-101A09BAA451","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.045.jpeg","voiceCharacter":"フランドール・スカーレット","bgmStartTimeOffset":0},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","duration":4.282154195011338,"animationName":"なし","slideTitle":"スライド #46","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_サブ.wav","bgmVolume":0.7,"telop":"私はそう聞く彼女に、思わず「ふっ」と笑ってしまう。","title":"シーン 46","voiceDuration":3.682154195011338,"characterName":"サブ","id":"4D26EFD7-8ECB-46E9-9246-206231B8CFF0","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"seVolume":1,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第11話_434cee83b1\/元女子校の日常　第11話_434cee83b1.046.jpeg","voiceCharacter":"サブ","bgmStartTimeOffset":0},{"duration":2.8932426303854877,"animationName":"なし","slideTitle":"スライド #47","voice2StartTimeOffset":0,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_フランドール・スカーレット.wav","bgmVolume":0.7,"telop":"「ちょっと、なんで笑ってるの？」","title":"シーン 47","voiceDuration":2.2932426303854876,"characterName":"フランドール・スカーレット","id":"F00620FA-8FC7-48B2-9061-BD61113DA58D","backgroundName":"nc196982_食堂(夜2).png","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voi