/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1818_先代の巫女.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「これはすまない、霊夢。情報と引き換えに、\n新しい神社の後継を手配してくれることになったんだ。」","voiceCharacter":"先代の巫女","duration":5.227823129251701,"title":"シーン 1818","slideTitle":"スライド #1818","characterName":"先代の巫女","audioTrack":"track_voice_char_2CB2","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1818.jpeg","voiceDuration":5.227823129251701,"seVolume":1},{"id":"CD1A5B37-5E9E-4786-B400-9E4693508E31","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1819_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「はっ？」私は、突拍子のない母の衝撃発言に、そう返す。","voiceCharacter":"博麗霊夢","duration":5.849478458049886,"title":"シーン 1819","slideTitle":"スライド #1819","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1819.jpeg","voiceDuration":5.849478458049886,"seVolume":1},{"id":"AAB751C2-E717-4C8B-B413-ABB4694DA76B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1820_先代の巫女.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「だから、お前のとこの息子は、不要になったんだ…。」","voiceCharacter":"先代の巫女","duration":2.656394557823129,"title":"シーン 1820","slideTitle":"スライド #1820","characterName":"先代の巫女","audioTrack":"track_voice_char_2CB2","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1820.jpeg","voiceDuration":2.656394557823129,"seVolume":1},{"id":"9E23DCE5-0A63-4F69-AC49-867206000757","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1821_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「えっ？どういうこと、私が必死に生んだ彼がいらないの？」","voiceCharacter":"博麗霊夢","duration":4.764489795918367,"title":"シーン 1821","slideTitle":"スライド #1821","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1821.jpeg","voiceDuration":4.764489795918367,"seVolume":1},{"id":"EEA307C7-36E2-4DC8-A3EF-C6A54928E578","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1822_先代の巫女.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「そうだが…、それが何か？」","voiceCharacter":"先代の巫女","duration":1.4057596371882086,"title":"シーン 1822","slideTitle":"スライド #1822","characterName":"先代の巫女","audioTrack":"track_voice_char_2CB2","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1822.jpeg","voiceDuration":1.4057596371882086,"seVolume":1},{"id":"AC1422D6-8C70-4565-8ED8-80C2CA06C8EB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1823_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「覚悟は…出来ているんでしょうね…？」","voiceCharacter":"博麗霊夢","duration":2.516984126984127,"title":"シーン 1823","slideTitle":"スライド #1823","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1823.jpeg","voiceDuration":2.516984126984127,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ちゃんちゃん♪1.mp3","id":"32398E69-1BB9-40B2-B745-0509319003CA","seStartTimeOffset":6.18,"animationNa