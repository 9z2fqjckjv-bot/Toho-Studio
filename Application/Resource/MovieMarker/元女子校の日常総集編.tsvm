E2A77-66EF-4A1D-B9E0-AFF4E44E5C46","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「ええ、この学園では、幼稚部から大学院まであって、希望者は教員になって、定年まで居続けられる学園なんですよ。」","voiceCharacter":"古明地さとり","duration":6.435192743764173,"title":"シーン 21","slideTitle":"スライド #21","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.021.jpeg","voiceDuration":6.435192743764173,"seVolume":1},{"id":"D6DE1A6C-5672-470F-90B8-963D7064999B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「へぇ…」","voiceCharacter":"操夢","duration":0.5452154195011338,"title":"シーン 22","slideTitle":"スライド #22","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.022.jpeg","voiceDuration":0.5452154195011338,"seVolume":1},{"id":"094B9970-5F48-4D01-8C39-4C1D1514A1E2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「その顔…もしかして、この学園のことを\n何も知らずに入学したんですか？」","voiceCharacter":"古明地さとり","duration":3.964784580498866,"title":"シーン 23","slideTitle":"スライド #23","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.023.jpeg","voiceDuration":3.964784580498866,"seVolume":1},{"id":"50465F94-8CCC-48A1-B372-A2453301B6D1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「両親に、この学校に行けって言われて、\nただそのまま来たっていえばいいですか？」","voiceCharacter":"操夢","duration":5.112607709750567,"title":"シーン 24","slideTitle":"スライド #24","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.024.jpeg","voiceDuration":5.112607709750567,"seVolume":1},{"id":"07072DFC-20FC-4232-9906-EC5CC522FABF","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「そうですか…。まぁ、あなた以外はみな小さい頃から見知った同姓の学生ばかりですからね…」","voiceCharacter":"古明地さとり","duration":4.7883900226757365,"title":"シーン 25","slideTitle":"スライド #25","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.025.jpeg","voiceDuration":4.7883900226757365,"seVolume":1},{"id":"B161064A-5D27-4C57-B907-38CDCFB036EA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「それで、僕の席は…」","voiceCharacter":"操夢","duration":1.732154195011338,"title":"シーン 26","slideTitle":"スライド #26","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.026.jpeg","voiceDuration":1.732154195011338,"seVolume":1},{"id":"70814AB8-2DD7-48B7-9B37-8DB5EA1226B0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「確か、窓際の真ん中の席に空席があった気がしますが…」","voiceCharacter":"古明地さとり","duration":3.3127891156462583,"title":"シーン 27","slideTitle":"スライド #27","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.027.jpeg","voiceDuration":3.3127891156462583,"seVolume":1},{"id":"9A1C920C-8F13-4796-BE3C-2F914542F2D4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「そうですか…」\n僕は、そう呟くと言われた席につき、荷物をおろし始めた。","voiceCharacter":"操夢","duration":5.2365079365079366,"title":"シーン 28","slideTitle":"スライド #28","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.028.jpeg","voiceDuration":5.2365079365079366,"seVolume":1},{"id":"5403F1AA-B00C-4E04-B0CC-093654DA6E75","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"それからしばらくたち…","duration":1.5,"title":"シーン 29: それからしばらくたち…","slideTitle":"スライド #29","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.029.jpeg","seVolume":1},{"id":"32458048-14E1-4F2A-9222-56C55C9A5B41","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"それから、数十分ほど経つと、チャイムがなり、教室が静まり返る。そして、数十秒程度の間の後、誰かが教室にはいってくる。","voiceCharacter":"操夢","duration":9.59954648526077,"title":"シーン 30","slideTitle":"スライド #30","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.030.jpeg","voiceDuration":9.59954648526077,"seVolume":1},{"id":"ACEBFA25-6FF7-4A7C-9346-C72F163BF5F2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「おはようございます。」","voiceCharacter":"東風谷早苗","duration":1.2048072562358276,"title":"シーン 31","slideTitle":"スライド #31","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.031.jpeg","voiceDuration":1.2048072562358276,"seVolume":1},{"id":"4433753A-CED1-487F-8BBB-E3024A7C94E7","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"その女性がそういうと、周りの女子たちが皆一斉に「おはようございます」と言い、礼をする。","voiceCharacter":"操夢","duration":5.773469387755102,"title":"シーン 32","slideTitle":"スライド #32","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.032.jpeg","voiceDuration":5.773469387755102,"seVolume":1},{"id":"47F3835A-ABC8-4FF7-828B-1AC47A49826F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「おや…一人…はずれものがいますね…」\n私はそう言い、その男子に目線を合わせる。","voiceCharacter":"東風谷早苗","duration":5.297777777777778,"title":"シーン 33","slideTitle":"スライド #33","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.033.jpeg","voiceDuration":5.297777777777778,"seVolume":1},{"id":"442E2D0D-C6D0-4794-BD3B-91D9BB49FE46","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「あなたも、今日から、この学園の一員ですから、\n挨拶の練習でもしましょうか…、藤原さん。」","voiceCharacter":"東風谷早苗","duration":6.126848072562359,"title":"シーン 34","slideTitle":"スライド #34","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.034.jpeg","voiceDuration":6.126848072562359,"seVolume":1},{"id":"F2B9CBE5-2982-42D0-A0DE-D905BA5E1F0C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"僕はそう言われ、僕に向けての声かけだったことに気づく。\n「あの…練習って…何をすればいいんですか？」","voiceCharacter":"操夢","duration":6.95281179138322,"title":"シーン 35","slideTitle":"スライド #35","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.035.jpeg","voiceDuration":6.95281179138322,"seVolume":1},{"id":"AFF3C4DE-2011-47AF-8E46-48EB0EBA1C73","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「そうですね…とりあえず、私の方に来てください。」","voiceCharacter":"東風谷早苗","duration":3.3775736961451246,"title":"シーン 36","slideTitle":"スライド #36","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.036.jpeg","voiceDuration":3.3775736961451246,"seVolume":1},{"id":"D9A09C9E-13E7-4046-B721-A5A35BF58098","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"僕は、彼女にそう言われ、彼女の隣に立つ。\nすると、彼女が再び挨拶し、女子から挨拶と礼が返ってくる。","voiceCharacter":"操夢","duration":8.166938775510204,"title":"シーン 37","slideTitle":"スライド #37","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.037.jpeg","voiceDuration":8.166938775510204,"seVolume":1},{"id":"3D6FEC6E-5264-454F-93CE-CF0945513EE5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「彼女たちのように、あなたも私の挨拶に対して、\n挨拶とお辞儀で返すことはできますか？」","voiceCharacter":"東風谷早苗","duration":5.734444444444445,"title":"シーン 38","slideTitle":"スライド #38","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.038.jpeg","voiceDuration":5.734444444444445,"seVolume":1},{"id":"79D42475-7C90-45EC-B036-4BDCBF26174B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"僕はそう言われ、どう返すべきかわからず、黙ってしまう…。\nすると、彼女がある女子を呼び、その女子は僕の反対側に立つ。","voiceCharacter":"操夢","duration":8.436507936507937,"title":"シーン 39","slideTitle":"スライド #39","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.039.jpeg","voiceDuration":8.436507936507937,"seVolume":1},{"id":"468B6EEE-4C06-4952-B0AF-21F775B991DE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「さとりさん、私が今から、『おはようございます。』と言いますので、彼に返しの挨拶とお辞儀の手本を見せてください。」","voiceCharacter":"東風谷早苗","duration":7.468979591836734,"title":"シーン 40","slideTitle":"スライド #40","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.040.jpeg","voiceDuration":7.468979591836734,"seVolume":1},{"id":"612AB0DB-4690-454A-8CE9-7351A3054105","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「分かりました、早苗師匠。」\n私はそう返すと、彼女に言われた通りに、彼に手本を見せる。","voiceCharacter":"古明地さとり","duration":5.283378684807256,"title":"シーン 41","slideTitle":"スライド #41","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.041.jpeg","voiceDuration":5.283378684807256,"seVolume":1},{"id":"B2C9612E-A61E-4444-BC29-6611CA7070AE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「さて、お手本は見せました、今度はあなたの番ですよ、藤原さん。挨拶とお辞儀、出来ますか？」","voiceCharacter":"東風谷早苗","duration":6.580453514739229,"title":"シーン 42","slideTitle":"スライド #42","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.042.jpeg","voiceDuration":6.580453514739229,"seVolume":1},{"id":"2160C666-F856-4CA6-87B1-C957DAEA7198","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"僕は、彼女にそう言われ、見よう見まねで挨拶とお辞儀をする。","voiceCharacter":"操夢","duration":3.9973696145124715,"title":"シーン 43","slideTitle":"スライド #43","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.043.jpeg","voiceDuration":3.9973696145124715,"seVolume":1},{"id":"CEA45538-B96A-4303-8FFC-5278888620AA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「初日しては、上出来ですよ、藤原さん。それじゃあ、あなたのこれまでの人生について、10分間で言いましょう。」","voiceCharacter":"東風谷早苗","duration":7.4156462585034015,"title":"シーン 44","slideTitle":"スライド #44","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.044.jpeg","voiceDuration":7.4156462585034015,"seVolume":1},{"id":"007243ED-0E0E-4F3B-871F-2EC7B54C8DB1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「分かりました…」僕はそう言われ、これまでの人生を振り返る。そのうち、スイッチが入ったように、その内容を語った。","voiceCharacter":"操夢","duration":8.209342403628117,"title":"シーン 45","slideTitle":"スライド #45","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.045.jpeg","voiceDuration":8.209342403628117,"seVolume":1},{"id":"4935A518-14F6-49C7-90C0-5DD926270226","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「今日の朝礼はこれで、終了です。今日から新年度ですので、心改めて、より良い自分を見せられるようにしましょう。」","voiceCharacter":"東風谷早苗","duration":7.5830385487528345,"title":"シーン 46","slideTitle":"スライド #46","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.046.jpeg","voiceDuration":7.5830385487528345,"seVolume":1},{"id":"20BF2A8D-5235-46B6-8F2A-2FEB071A208E","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"彼女はそういうと、その場を去っていった。すると、彼女にさとりと呼ばれていた、先程の女子が僕の元に駆け寄る。","voiceCharacter":"操夢","duration":7.831065759637188,"title":"シーン 47","slideTitle":"スライド #47","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.047.jpeg","voiceDuration":7.831065759637188,"seVolume":1},{"id":"2F56A32A-5473-4722-8A9B-5FAD089D97FD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「汗ダラダラで顔も赤いですけど、大丈夫ですか？」","voiceCharacter":"古明地さとり","duration":2.6291836734693876,"title":"シーン 48","slideTitle":"スライド #48","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.048.jpeg","voiceDuration":2.6291836734693876,"seVolume":1},{"id":"29D75C8F-0827-44FD-B77F-EFE97D5F8DED","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"僕は彼女にそう言われ、何かを言おうとするが、声が出なかった。「あはは…」そう言いながら、僕の視界は闇に染まった。","voiceCharacter":"操夢","duration":7.927823129251701,"title":"シーン 49","slideTitle":"スライド #49","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.049.jpeg","voiceDuration":7.927823129251701,"seVolume":1},{"id":"B7CAAD01-0E52-4AE8-B87D-665F3667C510","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"私はふと目が覚めると、そこは学校の保健室だった。","voiceCharacter":"サブ","duration":3.6832426303854877,"title":"シーン 50","slideTitle":"スライド #50","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.050.jpeg","voiceDuration":3.6832426303854877,"seVolume":1},{"id":"FCA8047B-42EE-4F84-AA4E-DC9A1A81B5FC","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"すると、私のそばにいたのか、\n彼女が困惑した表情でここを見る。","voiceCharacter":"サブ","duration":4.6952154195011335,"title":"シーン 51","slideTitle":"スライド #51","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.051.jpeg","voiceDuration":4.6952154195011335,"seVolume":1},{"id":"82E8FBFF-73BC-4077-B512-5F1EA9712439","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_鈴仙・優曇華院・イナバ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「あの…確かこのベッドには男子がいたはずなのですが…」","voiceCharacter":"鈴仙・優曇華院・イナバ","duration":4.237596371882086,"title":"シーン 52","slideTitle":"スライド #52","characterName":"鈴仙・優曇華院・イナバ","audioTrack":"track_voice_char_153F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.052.jpeg","voiceDuration":4.237596371882086,"seVolume":1},{"id":"194A8506-6A80-4E05-836C-86B9333DAF8B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「そういえば…この学校に来て、私が出るのは初めてか…。\nあなたが言っている彼は、確かにこのベッドにいましたよ。」","voiceCharacter":"サブ","duration":7.823469387755102,"title":"シーン 53","slideTitle":"スライド #53","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.053.jpeg","voiceDuration":7.823469387755102,"seVolume":1},{"id":"490A193C-B21F-4FFC-BCF1-37763F5A7E7A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_鈴仙・優曇華院・イナバ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「えっと…それはどういう意味でしょう？」","voiceCharacter":"鈴仙・優曇華院・イナバ","duration":2.624875283446712,"title":"シーン 54","slideTitle":"スライド #54","characterName":"鈴仙・優曇華院・イナバ","audioTrack":"track_voice_char_153F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.054.jpeg","voiceDuration":2.624875283446712,"seVolume":1},{"id":"BEA3C883-2106-4F2D-8B08-3E2B9B87340B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「まぁ、もう一度寝たら、彼の姿に戻りはしますが、それよりも、授業の方が優先ですから、教室に戻りますね。」","voiceCharacter":"サブ","duration":8.240861678004535,"title":"シーン 55","slideTitle":"スライド #55","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.055.jpeg","voiceDuration":8.240861678004535,"seVolume":1},{"id":"105CC1A0-CB6A-476B-B75A-FA2B55ACAE57","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_鈴仙・優曇華院・イナバ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「とりあえず、あなたの教室に案内しますね…」","voiceCharacter":"鈴仙・優曇華院・イナバ","duration":3.677687074829932,"title":"シーン 56","slideTitle":"スライド #56","characterName":"鈴仙・優曇華院・イナバ","audioTrack":"track_voice_char_153F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.056.jpeg","voiceDuration":3.677687074829932,"seVolume":1},{"id":"1BD5726C-17D6-40BE-A056-A2F90157C8E6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"私はそう言われ、彼女と共に保健室を離れた。","voiceCharacter":"サブ","duration":3.3973696145124714,"title":"シーン 57","slideTitle":"スライド #57","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.057.jpeg","voiceDuration":3.3973696145124714,"seVolume":1},{"id":"757965AD-95E7-48DC-B6B7-089BB5E1C523","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"私が、彼女の案内で教室に戻ると、クラスメイトの視線が突き刺さるように飛んでくる。「まぁ…当たり前か…」","voiceCharacter":"サブ","duration":7.623469387755102,"title":"シーン 58","slideTitle":"スライド #58","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.058.jpeg","voiceDuration":7.623469387755102,"seVolume":1},{"id":"9C94EB66-75CB-4B7A-8D4B-A3C0F170FFA5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「あなた…見かけない顔ね…新入生かしら…」私は科学の講義中に突如として入ってきた彼女にそう問いかける。","voiceCharacter":"パチュリー・ノーレッジ","duration":6.499773242630385,"title":"シーン 59","slideTitle":"スライド #59","characterName":"パチュリー・ノーレッジ","audioTrack":"track_voice_char_1B13","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.059.jpeg","voiceDuration":6.499773242630385,"seVolume":1},{"id":"EFFDFEBA-A10E-4A70-A163-4BBB43AAB4D8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「まぁ、そんなことどうでもいいわ。とりあえず、あなたもささっと席に着いて、私の講義を聞きなさい。」","voiceCharacter":"パチュリー・ノーレッジ","duration":5.68530612244898,"title":"シーン 60","slideTitle":"スライド #60","characterName":"パチュリー・ノーレッジ","audioTrack":"track_voice_char_1B13","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.060.jpeg","voiceDuration":5.68530612244898,"seVolume":1},{"id":"7623EAA7-3754-4CA7-861D-EDF33005FA7B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「わかりました。」\n私はそう返すと、窓際の真ん中にある空席に座る。","voiceCharacter":"サブ","duration":5.266938775510204,"title":"シーン 61","slideTitle":"スライド #61","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.061.jpeg","voiceDuration":5.266938775510204,"seVolume":1},{"id":"8B19A8AA-D08B-40D4-9D40-AEB4017751E3","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「それじゃあ、続けるわね。」\n私はそう言って、科学の講義を再開した。","voiceCharacter":"パチュリー・ノーレッジ","duration":4.253356009070295,"title":"シーン 62","slideTitle":"スライド #62","characterName":"パチュリー・ノーレッジ","audioTrack":"track_voice_char_1B13","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.062.jpeg","voiceDuration":4.253356009070295,"seVolume":1},{"id":"565570EC-32BB-4F2E-83D4-BFCB7C4C2C5B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"それから時間が経ち…","duration":1.5,"title":"シーン 63: それから時間が経ち…","slideTitle":"スライド #63","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.063.jpeg","seVolume":1},{"id":"C929CF26-A67E-44F9-A2AC-339E5300150E","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"それから数十分程度でその講義は終了した。そして、周りを見ながら、彼が持ってきた弁当を取り出し、食べる。","voiceCharacter":"サブ","duration":7.786507936507936,"title":"シーン 64","slideTitle":"スライド #64","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.064.jpeg","voiceDuration":7.786507936507936,"seVolume":1},{"id":"2BB4047B-ECC7-4CCF-8AB4-83EA5947BF54","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"だが、弁当を食べ切ると同時に、全身に衝撃が走り、そのまま教室を抜け出し、ある場所…多目的トイレを探す。","voiceCharacter":"サブ","duration":8.243038548752834,"title":"シーン 65","slideTitle":"スライド #65","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.065.jpeg","voiceDuration":8.243038548752834,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3","id":"E8363802-6EED-44EB-9585-D4FBD1183809","seStartTimeOffset":0.3,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791193839_80109.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","telop":"そして私は、多目的トイレに来るとその場に倒れ込んだ。","voiceCharacter":"サブ","duration":3.6930385487528343,"title":"シーン 66","slideTitle":"スライド #66","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"seName":"SE: 倒れる","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.066.jpeg","voiceDuration":3.6930385487528343,"seVolume":0.85},{"id":"406C88FF-3EDF-4F69-AA14-86EAC97737F6","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791193839_80109.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","telop":"「ん…、ここは…トイレ…」僕はそう呟き、ハッと思い出す。\n「確か、10分の自己紹介で人生を話したら、気絶して…」","voiceCharacter":"操夢","duration":8.699546485260772,"title":"シーン 67","slideTitle":"スライド #67","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.067.jpeg","voiceDuration":8.699546485260772,"seVolume":1},{"id":"63D3200D-EAD6-4785-A91F-FB815C1C8060","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791193839_80109.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","telop":"「とりあえず…教室に戻るか…」\n僕はそう一人呟くと、念入りに手を洗ってから、トイレを出た。","voiceCharacter":"操夢","duration":6.53,"title":"シーン 68","slideTitle":"スライド #68","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.068.jpeg","voiceDuration":6.53,"seVolume":1},{"id":"956E87B6-7EF0-41C4-9DC8-CF91D8B219B1","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","voice2Character":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕が教室に戻ってくると、\nさとりと呼ばれていた少女が僕に、駆け寄ってくる。","voiceCharacter":"操夢","duration":5.036077097505669,"title":"シーン 69","slideTitle":"スライド #69","characterName":"操夢","audioTrack":"track_voice_soumu","voice2Duration":3.18,"bgmVolume":0.7,"voice2StartTimeOffset":1.8560770975056688,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.069.jpeg","voiceDuration":1.8560770975056688,"seVolume":1,"voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢_2.wav"},{"id":"64023350-FAB3-41B6-A95F-DDDC33A9475F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「あれ…どこから来たんですか？」","voiceCharacter":"古明地さとり","duration":1.5713832199546485,"title":"シーン 70","slideTitle":"スライド #70","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.070.jpeg","voiceDuration":1.5713832199546485,"seVolume":1},{"id":"72CA7C31-9285-4E6F-89CB-F32E7C07D348","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「えっと…」僕はそこで困惑してしまう…。\n「今はちょっと、自分の席で休みたいので….」","voiceCharacter":"操夢","duration":5.814761904761904,"title":"シーン 71","slideTitle":"スライド #71","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.071.jpeg","voiceDuration":5.814761904761904,"seVolume":1},{"id":"B84720C5-62AD-4BBE-99C6-F41D21EAF36F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「そうですか…、でもきっと、学園中で噂になりますよ…」","voiceCharacter":"古明地さとり","duration":3.1070975056689343,"title":"シーン 72","slideTitle":"スライド #72","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.072.jpeg","voiceDuration":3.1070975056689343,"seVolume":1},{"id":"D5F6342D-D5BE-4B5D-86A6-5F86FDE07F66","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「そういえば、次は被服室での授業ですが、一人で大丈夫ですか？あと、数十分もせずに休み時間は終わりますが…」","voiceCharacter":"古明地さとり","duration":6.512585034013606,"title":"シーン 73","slideTitle":"スライド #73","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.073.jpeg","voiceDuration":6.512585034013606,"seVolume":1},{"id":"0F4388F6-14A6-4B28-935B-6B0C556BE61E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「そうですか…ちょっと待っててください。」\n僕はそういうと、ささっと自席を片付ける。","voiceCharacter":"操夢","duration":5.721292517006803,"title":"シーン 74","slideTitle":"スライド #74","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.074.jpeg","voiceDuration":5.721292517006803,"seVolume":1},{"id":"9356D2ED-BAE6-43C0-B60F-9887B74F1518","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「それで、被服室はどこにありますか？」","voiceCharacter":"操夢","duration":2.5604308390022674,"title":"シーン 75","slideTitle":"スライド #75","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.075.jpeg","voiceDuration":2.5604308390022674,"seVolume":1},{"id":"DC7C0572-0F76-4175-9A02-B23455969056","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「私が案内しますから、着いてきてください。」","voiceCharacter":"古明地さとり","duration":2.4259863945578233,"title":"シーン 76","slideTitle":"スライド #76","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.076.jpeg","voiceDuration":2.4259863945578233,"seVolume":1},{"id":"80656C6D-36AB-4ED3-B479-25F5E8DC2217","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"僕が彼女と共に被服室にくると、誰かがこちらにくる。","voiceCharacter":"古明地さとり","duration":3.0713832199546487,"title":"シーン 77","slideTitle":"スライド #77","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.077.jpeg","voiceDuration":3.0713832199546487,"seVolume":1},{"id":"85DA3530-A8FD-4E3E-90CD-BBD5BB62224D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_十六夜咲夜.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"「あら、もしかして、このクラスに転入した男子ですか？」","voiceCharacter":"十六夜咲夜","duration":3.203378684807256,"title":"シーン 78","slideTitle":"スライド #78","characterName":"十六夜咲夜","audioTrack":"track_voice_char_53C6","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.078.jpeg","voiceDuration":3.203378684807256,"seVolume":1},{"id":"15BD1CF0-2682-4F7A-BC85-D83B3AFB30D8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"「ええ、そうですが、なぜそんなことを…」","voiceCharacter":"操夢","duration":2.6386848072562357,"title":"シーン 79","slideTitle":"スライド #79","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.079.jpeg","voiceDuration":2.6386848072562357,"seVolume":1},{"id":"71D9034C-AB79-4054-B492-BD35406A9CB8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_十六夜咲夜.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"「朝、早苗さんが見たときは、確かに男子だったはずなのに、パチュリーさんの授業に来た時には女子だった…と。」","voiceCharacter":"十六夜咲夜","duration":6.481882086167801,"title":"シーン 80","slideTitle":"スライド #80","characterName":"十六夜咲夜","audioTrack":"track_voice_char_53C6","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.080.jpeg","voiceDuration":6.481882086167801,"seVolume":1},{"id":"8C546A79-9B81-47FA-8F94-4F3B17DFDC1D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_十六夜咲夜.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"「教員の間で、話題になってますよ。まぁ、元女子校の学園に男子生徒が来ただけでも、話題性は絶えないですが…」","voiceCharacter":"十六夜咲夜","duration":7.121791383219954,"title":"シーン 81","slideTitle":"スライド #81","characterName":"十六夜咲夜","audioTrack":"track_voice_char_53C6","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.081.jpeg","voiceDuration":7.121791383219954,"seVolume":1},{"id":"F708C131-C302-4C02-992E-B6149F48185F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_十六夜咲夜.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"「とりあえず、これから家庭の授業をするので、あなたは…窓辺に座っているさとりの隣にでも座ってください。」","voiceCharacter":"十六夜咲夜","duration":6.107392290249433,"title":"シーン 82","slideTitle":"スライド #82","characterName":"十六夜咲夜","audioTrack":"track_voice_char_53C6","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.082.jpeg","voiceDuration":6.107392290249433,"seVolume":1},{"id":"A96066C3-6773-4A26-8A2F-A62A92F4A60F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"「今日は、咲夜師匠の２連無休授業ですから、あなたには…酷かもしれませんが、2時間を休憩なしで耐えるしかないですね。」","voiceCharacter":"古明地さとり","duration":6.549183673469388,"title":"シーン 83","slideTitle":"スライド #83","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.083.jpeg","voiceDuration":6.549183673469388,"seVolume":1},{"id":"9A691BD6-6C61-495D-9F2F-86208D20AEED","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791195025_33546.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","telop":"彼女がそういい、数分程度で授業が始まった。","voiceCharacter":"操夢","duration":3.1984580498866215,"title":"シーン 84","slideTitle":"スライド #84","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.084.jpeg","voiceDuration":3.1984580498866215,"seVolume":1},{"id":"00725DE2-F16C-46BE-9208-71930EC5DC6F","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"2時間休憩なし授業が終わると…","duration":1.5,"title":"シーン 85: 2時間休憩なし授業が終わると…","slideTitle":"スライド #85","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.085.jpeg","seVolume":1},{"id":"46DB148A-B0B4-47C1-B952-6EF900E82826","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕たちは、それから、2時間の間、休憩なしで、講義を受け続けると、教室に戻り、終礼が始まるまで席に座って待ち続ける。","voiceCharacter":"操夢","duration":9.5756462585034,"title":"シーン 86","slideTitle":"スライド #86","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.086.jpeg","voiceDuration":9.5756462585034,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3","id":"1B5519D9-B752-4890-A1D8-61149751C52D","seStartTimeOffset":0.3,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"すると、教室の扉が開き、朝礼の時に来た女性が入る。","voiceCharacter":"操夢","duration":4.408253968253968,"title":"シーン 87","slideTitle":"スライド #87","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 教室の戸を開ける","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.087.jpeg","voiceDuration":4.408253968253968,"seVolume":0.85},{"id":"1E703EAD-08DE-4E81-A641-52AA8EE2C949","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「皆さん、お疲れ様です。」","voiceCharacter":"東風谷早苗","duration":1.8664625850340135,"title":"シーン 88","slideTitle":"スライド #88","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.088.jpeg","voiceDuration":1.8664625850340135,"seVolume":1},{"id":"6F1FFB31-8FEC-4BEF-8D1E-021BB5E8CFB0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"彼女がそういうと、クラスメイトの女子たちは「お疲れ様です。」と一斉に返し、僕が急いで立ち、一緒に礼をする。","voiceCharacter":"操夢","duration":8.025646258503402,"title":"シーン 89","slideTitle":"スライド #89","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.089.jpeg","voiceDuration":8.025646258503402,"seVolume":1},{"id":"FDF295D4-D7EA-4A64-AF7C-3DDEBBE21533","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「何か、伝えたいことがある生徒はいますか。」","voiceCharacter":"東風谷早苗","duration":2.77702947845805,"title":"シーン 90","slideTitle":"スライド #90","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.090.jpeg","voiceDuration":2.77702947845805,"seVolume":1},{"id":"D75FB47A-507F-4530-9CE6-183D9964306D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"彼女がそういうと、シーンと教室が静まり返る。","voiceCharacter":"操夢","duration":3.195215419501134,"title":"シーン 91","slideTitle":"スライド #91","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.091.jpeg","voiceDuration":3.195215419501134,"seVolume":1},{"id":"F4AE32E0-67A1-4771-A5FD-BE7DD79110F9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「それでは、終礼はこれで終了です。お疲れ様でした。」","voiceCharacter":"東風谷早苗","duration":3.8336054421768706,"title":"シーン 92","slideTitle":"スライド #92","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.092.jpeg","voiceDuration":3.8336054421768706,"seVolume":1},{"id":"A82A5B76-81FF-4A21-8307-CF160F1450E4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extr