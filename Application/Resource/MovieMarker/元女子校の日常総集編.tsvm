女子校の日常総集編\/影ありニヤケ顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1918_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230674_観覧車の中（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","telop":"「ほら、こいし、私と一緒に家に戻りましょ。」","voiceCharacter":"古明地さとり","duration":2.589591836734694,"title":"シーン 1918","slideTitle":"スライド #1918","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1918.jpeg","voiceDuration":2.589591836734694,"seVolume":1},{"id":"9DF5E2BF-FB3B-4604-9DA3-A8FF251CD635","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1919_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230674_観覧車の中（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","telop":"私は、ハッとして気がつくと、目の前には怖気付く少女と黒い笑みを浮かべる彼女がいた。そして、状況を察する。","voiceCharacter":"サブ","duration":7.953900226757369,"title":"シーン 1919","slideTitle":"スライド #1919","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1919.jpeg","voiceDuration":7.953900226757369,"seVolume":1},{"audioTrack":"track_voice_char_CC3E","transitionName":"なし","telop":"そして、彼女が少女を手で掴みかけると、私はその手を叩く。\nすると、彼女の動作が止まり、表情が変わる。","title":"シーン 1920","slideTitle":"スライド #1920","voice2StartTimeOffset":4.406077097505669,"characterName":"サブ","bgmVolume":0.7,"seStartTimeOffset":2.97,"duration":7.662154195011338,"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/軽いパンチ1.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1920.jpeg","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1920_サブ_2.wav","seVolume":0.85,"animationName":"なし","seName":"SE: 軽いパンチ1","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1920_サブ.wav","voiceCharacter":"サブ","voice2Duration":3.2560770975056688,"id":"4FB4A323-59B3-4850-85BF-698840119493","voiceDuration":4.406077097505669,"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり微笑2.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","voice2Character":"サブ","bgmStartTimeOffset":0,"voiceStartTimeOffset":0},{"id":"115D6929-0D98-4583-BF24-62663804D92F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1921_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230674_観覧車の中（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","telop":"「おや、手出しをしなければ、私は黙っていたんですがね…、仕方ありません。今日のところは引き上げましょう。では失礼。」","voiceCharacter":"古明地さとり","duration":6.527777777777778,"title":"シーン 1921","slideTitle":"スライド #1921","characterName":"古明地さとり","audioTrack":"track