lication Support\/TohoStudio\/GeneratedAudio\/Slide_1810_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1810.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「そうか、そんな霊夢に一報が入ったぞ。」","id":"FFC870A7-C0B5-4C40-B0D2-3E4CB1C944E0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":2.1329251700680274},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":1.5894784580498866,"slideTitle":"スライド #1811","title":"シーン 1811","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1811_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1811.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「どんな知らせなのよ？」","id":"4F37B13A-3BB6-4E35-BA43-CD8E25037C34","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":1.5894784580498866},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":5.581065759637188,"slideTitle":"スライド #1812","title":"シーン 1812","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1812_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1812.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「これはあるツテから聞いたんだが、例のグループが内部分裂を引き起こして、片方は例の建設会社と手を組んだって。」","id":"D8DFB325-8ED2-41D7-A732-90035279E079","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":5.581065759637188},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":3.2444897959183674,"slideTitle":"スライド #1813","title":"シーン 1813","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1813_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1813.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「一体、その情報どこから仕入れたのよ？」","id":"4CB0D0B5-A49F-4E33-95D4-1944C3F89089","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":3.2444897959183674},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":6.468571428571429