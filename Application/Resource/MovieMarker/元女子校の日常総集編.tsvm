65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2130.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると彼女が、おとなしくなる。「それで、これからどうするんですか？」僕は、こいしの頭を撫でながら聞く。","id":"53CB6DFE-BF10-41CC-B447-BA66456ACA0D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.434331065759637},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.247369614512472,"slideTitle":"スライド #2131","title":"シーン 2131","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2131_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2131.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「これから、元々、この家に住んでいた人たちと食事があるから、あなたにも、それに参加してもらうから、覚悟しなさい。」","id":"25AF1253-2728-4344-AD4E-07B82D6DE7D5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.247369614512472},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":7.92891156462585,"slideTitle":"スライド #2132","title":"シーン 2132","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2132_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2132.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…」僕は彼女の言葉を聞くと、こいしの頭を撫でるのをやめようとすると、彼女がその手を掴む。「おっと…」","id":"193EFB78-EBC5-4448-BFA4-66C365424FEA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.92891156462585},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":4.942154195011338,"slideTitle":"スライド #2133","title":"シーン 2133","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2133_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2133.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「こいし、そろそろ彼と、\n食事に出かけないとだから、彼を離してちょうだい。」","id":"E1CAC7BA-1A61-496E-8578-3602311353DE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.942154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":0.7331292517006802,"slideTitle":"スライド #2134","title":"シーン 2134","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2134_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2134.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「やだ。」","id":"71B811C5-4F70-42DA-A3AD-1BA28C096549","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.7331292517006802},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":6.802562358276644,"slideTitle":"スライド #2135","title":"シーン 2135","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2135_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2135.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「やだじゃない、あなたもう20歳を過ぎた大人でしょ。だったら、そうわがままなんて言うじゃない。じゃないと…」","id":"1A50FE43-8010-4F32-A85F-A609E8CD4BDB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.802562358276644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校