racterName":"アリス・マーガトロイド","telop":"「えっ？」","id":"F33D1E76-905A-4FB8-A410-870EF3BECF2D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":0.5},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":8.936507936507937,"slideTitle":"スライド #1258","title":"シーン 1258","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1258_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1258.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が困惑しているのを見て、目線で電話口を変わったほうがいいか、確認する。すると、彼女はポケベルを僕に渡す。","id":"79F87665-8766-4B1C-8415-D436CF73F78C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.936507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":2.806077097505669,"slideTitle":"スライド #1259","title":"シーン 1259","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1259_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1259.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「もしもし、紅夢です…、どうしましたか？」","id":"B7CA5F98-6342-44AC-8D67-F9A779D0EDDF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.806077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":6.531519274376417,"slideTitle":"スライド #1260","title":"シーン 1260","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1260_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1260.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「美鈴から聞いたわよ、あんたが居候している家に送ったデビットカードから、短時間で5件の入出金があったみたいじゃない。」","id":"69FAAB08-CAAD-4EF8-83E4-64549968BFEC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":6.531519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":2.531609977324263,"slideTitle":"スライド #1261","title":"シーン 1261","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1261_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1261.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「それで、あんたたちは、これからどうするのよ？」","id":"A229A03E-FFA5-4682-A518-6A4F1F2F4C7C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":2.531609977324263},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":7.162607709750567,"slideTitle":"スライド #1262","title":"シーン 1262","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1262_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1262.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「あれ…パチュリーさんは、知らないんですか…、例のデビットカードが送られたとき、一緒に手紙が入っていたことを…？」","id":"10C08DB2-30C4-4058-97A2-A8B9906B3067","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.162607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":1.6711791383219954,"slideTitle":"スライド #1263","title":"シーン 1263","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1263_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1263.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「えっ？何よ手紙って…？」","id":"BF8F37F8-88D1-4B44-9ACE-EAA55EDBB0CF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":1.6711791383219954},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":7.958253968253969,"slideTitle":"スライド #1264","title":"シーン 1264","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1264_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1264.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そう彼女に聞かれ、デビットカードともに入っていた手紙というか、遠足後の試験に関する詳細を彼女に伝える。","id":"5AFB29A1-BD4B-41C8-B691-62134C888AEC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.958253968253969},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":1.9939002267573696,"slideTitle":"スライド #1265","title":"シーン 1265","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1265_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1265.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「それで、それは誰が今持ってるの？」","id":"B0EBC5D4-03CE-4DBF-9465-91236FD34C73","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":1.9939002267573696},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":8.110430839002268,"slideTitle":"スライド #1266","title":"シーン 1266","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1266_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1266.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「僕のバックの中に入ってますよ。それに、その封筒の差出人は、学園長の名義で、ちょうど都合もいいので…」","id":"E43C5444-5AF3-4FD7-86FE-7187B861092F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.110430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keyn