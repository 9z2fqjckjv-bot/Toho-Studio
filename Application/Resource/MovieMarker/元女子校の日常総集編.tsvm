n Support\/TohoStudio\/GeneratedAudio\/Slide_1559_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1559.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"私とお姉様は、昨日、こいしからの長電話を受けた後、夜通し、今後の事を話し合って行った。「それで、どうするの…？」","id":"CA3FE61C-8507-4B30-B396-5C2B92BB6144","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":9.720748299319729},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":6.9254875283446715,"slideTitle":"スライド #1560","title":"シーン 1560","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1560_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1560.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「なんで彼は、あんな巨大組織の令嬢の裸を見たのかしら…。\nたとえ、アクシデントでもあんなことを言うなんて…。」","id":"1EB7C5A1-B523-43F0-8513-FA0D031E66C8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.9254875283446715},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.204081632653061,"slideTitle":"スライド #1561","title":"シーン 1561","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1561_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1561.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「とにかく、彼が旅行から戻ってきたら、厳しく言いつけて、戦いに勝って、私たちの方に、なんとしてでも引き込むわよ。」","id":"779E902A-7456-4725-96E3-5481093879E6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.204081632653061},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":5.200748299319728,"slideTitle":"スライド #1562","title":"シーン 1562","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1562_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1562.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「私だって、彼がいなくなるのは嫌だし、お姉様に協力する。」","id":"360DFB58-6AFE-485D-9290-C72E7A56A236","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.200748299319728},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":7.6046485260770975,"slideTitle":"スライド #1563","title":"シーン 1563","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1563_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1563.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「いいこと思いついたわ、フラン。何かしらの口実をつけて、学校と彼の母親を裏切る前提で味方につけなさい。」","id":"615E8024-9EC9-4747-93B2-0AC1627113D4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.6046485260770975},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":2.8219954648526078,"slideTitle":"スライド #1564","title":"シーン 1564","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1564_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1564.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「えっ…、そんなことして大丈夫なの？」","id":"CA9F3B58-BD04-4BA2-A4C4-269F75BE50F4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.8219954648526078},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":3.5963265306122447,"slideTitle":"スライド #1565","title":"シーン 1565","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1565_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1565.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「いいのよ別に、これは女同士の泥沼試合なのだから。」","id":"14058CEE-1DEC-4317-ADB0-B00FB74AB414","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.5963265306122447},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":5.909478458049887,"slideTitle":"スライド #1566","title":"シーン 1566","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1566_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1566.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…わかった。」\n私はそれから、お姉様の言うとおりに動くのだった。","id":"F6E4EBB2-69A2-4882-91FC-C29B6BA266A1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.909478458049887},{"animationDuration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1567","title":"シーン 1567: フランドール・スカーレット（紅魔建設の破壊作業員）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"夜のお誘い.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1567.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"フランドール・スカーレット（紅魔建設の破壊作業員）","id":"E4F44EE2-5597-4407-8E3B-DB9988B4C528","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":7.505510204081633,"slideTitle":"スライド #1568","title":"シーン 1568","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1568_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1568.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、ふとため息を学園長室でついていた。「はぁ…」\n理由は明白で、昨晩にあった、ある電話である。","id":"1F61D9B5-F6F3-49B2-8EFF-1C0FAEA6CF24","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":7.505510204081633},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":9.184263038548753,"slideTitle":"スライド #1569","title":"シーン 1569","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1569_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1569.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私が、昨日、残業で職務をこなしていると、一本の電話が入る。\nそれを知らせにきた、萃香はいかにも面倒そうな顔をしていた。","id":"594ABC9E-0C0D-4951-A386-8F01FE189549","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":9.184263038548753},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":9.20968253968254,"slideTitle":"スライド #1570","title":"シーン 1570","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1570_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1570.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、彼女の言葉を受けると、内線を繋ぎ、相手の声を聞く。\nその声は、中等部の女子生徒、古明地こいしの声だった。","id":"90B4A83E-BC5A-4B85-A3F1-5BBA05613E3F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":9.20968253968254},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.503832199546485,"slideTitle":"スライド #1571","title":"シーン 1571","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1571_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1571.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、電話越しに彼女が起こっていることを感じ、なぜ起こっているのかと聞く。すると例の彼が、彼女の裸を見たと言う。","id":"527D44D3-2525-4DDA-93A2-E0448EFA5A00","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.503832199546485},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":9.934784580498865,"slideTitle":"スライド #1572","title":"シーン 1572","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1572_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1572.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私と萃香は驚きながらも、相手の話を聞く。すると、彼女はある衝撃的な発言を言ってきた。私は、その内容に困惑する。","id":"F0D08C46-78CC-48CD-8AE3-72B2D69D90A4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":9.934784580498865},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":6.302902494331065,"slideTitle":"スライド #1573","title":"シーン 1573","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1573_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1573.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"だが、すぐに永琳からの電話も飛んできて、\n私はこいしの電話を保留にし、そちらに切り替える。","id":"052D58D9-B7F0-4D91-90AF-04CEBB9D09A2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":6.302902494331065},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.660725623582767,"slideTitle":"スライド #1574","title":"シーン 1574","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1574_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1574.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"永琳が言うには、彼は貴重な研究対象だから、学園から話さずに、学校側の手が届く範囲でいさせたいとの要望だった。","id":"53073FE1-8483-42E3-9E89-6F4C16721FCF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.660725623582767},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.607596371882087,"slideTitle":"スライド #1575","title":"シーン 1575","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1575_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1575.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、彼が貴重な人物であることは認識していたが、それほど重要性の高い人物だとは、正直に言って感じてなかった。","id":"6B7194A0-2C76-43F7-8421-689B0FDB962C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.607596371882087},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":9.121020408163265,"slideTitle":"スライド #1576","title":"シーン 1576","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1576_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1576.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、一通り永琳の意見を聞き終えると、こいしの方に再度、切り替える。すると、彼女は、これは戦いだと、言ってきた。","id":"7DD52053-9897-4E43-905C-06026507BAB1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":9.121020408163265},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.534149659863946,"slideTitle":"スライド #1577","title":"シーン 1577","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1577_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1577.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"そして、彼女は控えめだったが、もし彼女たちの要請に応じられないなら、学園の資金提供などの協力は打ち切ると言ってきた。","id":"F65E5B22-ED00-4901-A5D3-FBE680826714","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.534149659863946},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":7.774058956916099,"slideTitle":"スライド #1578","title":"シーン 1578","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1578_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1578.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"どうやらすでに、彼女の両親がトップに鎮座する地下底国グループの意見を聞き取り、グループの見解になったそうだった。","id":"F1D418AB-E5FE-4340-9B27-79EC6718CF01","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":7.774058956916099},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.490408163265306,"slideTitle":"スライド #1579","title":"シーン 1579","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1579_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1579.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"地下底国グループは、その名の通り、この社会の土台や裏側を幅広く、汎用的に事業を展開し支える巨大組織である。","id":"57835C07-4403-47BE-B6E7-ED7A1FFE2DCE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.490408163265306},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":7.454875283446712,"slideTitle":"スライド #1580","title":"シーン 1580","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1580_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1580.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"彼女は、今までその名では行動することはなかった。\n学校生活とグループでの完全な使い分けをしていたのだ。","id":"6F2F4F39-47A1-4C16-AE34-6A77524E3BC6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":7.454875283446712},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.687165532879819,"slideTitle":"スライド #1581","title":"シーン 1581","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1581_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1581.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"そんな彼女の裸を運悪く見てしまった彼を発端に、彼女は今まであえて潜めていたグループを使い始めたことに、私は驚いた。","id":"27779CDB-FA26-4447-8F53-C7C52E713DCF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.687165532879819},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":7.917913832199546,"slideTitle":"スライド #1582","title":"シーン 1582","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1582_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1582.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"そして、彼女は、彼が居候している家が立ち上げている紅魔建設と、彼の母親にも宣戦布告を済ませたと言う。","id":"ACFF0118-B98C-4999-85E6-F8D77FEB5C7F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":7.917913832199546},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.996439909297052,"slideTitle":"スライド #1583","title":"シーン 1583","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1583_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1583.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"彼女は、自分の裸が見られた後、彼の素性を問いただし、彼がいなくなると、隠し持っていたPCで彼の母親を調べたという。","id":"CBED5806-2BD4-41A7-85B8-D68C4A090B7F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.996439909297052},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.520204081632652,"slideTitle":"スライド #1584","title":"シーン 1584","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1584_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1584.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"そして、その結果、彼の母親が務める神社の跡取りとして、彼に期待されているのを知った彼女は、宣戦布告をしたのだ。","id":"FB49F271-7645-49EC-B422-5411A47C0262","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.520204081632652},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","bgmStartTimeOffset":0,"duration":8.817687074829932,"slideTitle":"スライド #1585","title":"シーン 1585","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1585_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-11-10_17-38.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1585.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"そして、最後にはこの4つ巴の戦いは、旅行が終わったら、即時に始まると高圧的に宣言し、その電話は途切れたのだった。","id":"C24F4D92-0229-450B-8264-B80CE57DD141","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.817687074829932},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":8.648004535147392,"slideTitle":"スライド #1586","title":"シーン 1586","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1586_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1586.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、彼女が地下底国グループの令嬢であることは、把握していたつもりだったが、今回の出来事で、それを実感させられた。","id":"D772C87D-8E3B-41C3-85C6-A21D9A40A44C","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.648004535147392},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.893219954648526,"slideTitle":"スライド #1587","title":"シーン 1587","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1587_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1587.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"だが、これから始まるであろう、\nその戦いに不安を覚える、私だった。","id":"D7D49F61-E3AF-467D-964E-3437105F7C7D","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.893219954648526},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1588","title":"シーン 1588: 博麗霊夢（博麗神社の巫女）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1588.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"博麗霊夢（博麗神社の巫女）","id":"4978CBF8-B4E8-4AF1-AFA1-AC3D47EA21A8","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":10.165736961451247,"slideTitle":"スライド #1589","title":"シーン 1589","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1589_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1589.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「はぁ」私は、ため息をつきながら、神社の敷地を箒で掃いていた。ため息が出る理由は、巨大組織の令嬢からの電話だった。","id":"E7536F3F-7BEC-482D-A88D-5B56779EB72E","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.165736961451247},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":5.754444444444444,"slideTitle":"スライド #1590","title":"シーン 1590","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1590_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1590.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「ほら、ため息なんかついてないで、チャチャっとやったらどうなのよ、霊夢」私はそう、箒を持っている娘の霊夢に言う。","id":"31BE6245-211F-446A-9F52-4FB1233CF99C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":5.754444444444444},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":3.8844897959183675,"slideTitle":"スライド #1591","title":"シーン 1591","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1591_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1591.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「はぁ、そんなことくらい分かってるわよ、言わずとも。」","id":"27072EE0-511E-4155-A9A9-0856BDB27B2D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":3.8844897959183675},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":6.020521541950114,"slideTitle":"スライド #1592","title":"シーン 1592","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1592_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1592.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「そうなら、もっとやる気出して、テキパキ履きなさい。それで、例の跡取りになりそうな孫は、どうするのよ、今後？」","id":"AE896530-D428-4803-B03A-3865EA52BC73","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":6.020521541950114},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":10.576984126984128,"slideTitle":"スライド #1593","title":"シーン 1593","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1593_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1593.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「それは…」私は、ここで素直に、宣戦布告の事情を伝えるかどうか迷う。だが、伝えた方がいいと判断し、話し始める。","id":"31B181F8-088E-4F88-B5B6-CA605C6BBCF7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.576984126984128},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":5.279478458049887,"slideTitle":"スライド #1594","title":"シーン 1594","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1594_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1594.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「それなら、宣戦布告されたわよ、\n地下底国グループのご令嬢に。」","id":"C9975D0A-0D5C-434A-88E1-EDDC3067DBF7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":5.279478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":6.5863038548752835,"slideTitle":"スライド #1595","title":"シーン 1595","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1595_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1595.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「えっ？宣戦布告ってどう言うこと。だって彼は、あんたの息子だから、彼が何も言わない限り、ここで働くんじゃないの？」","id":"F1E3870E-11CD-4EF4-93BE-F75D8C19B82E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":6.5863038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":8.236984126984128,"slideTitle":"スライド #1596","title":"シーン 1596","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1596_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg