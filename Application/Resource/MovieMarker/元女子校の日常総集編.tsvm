E6B-5CD7-4E50-B89D-849952DCB96F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1285_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","telop":"「いや、学校での修学旅行で何度か、乗ったわ…。」","voiceCharacter":"アリス・マーガトロイド","duration":2.8959410430839,"title":"シーン 1285","slideTitle":"スライド #1285","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1285.jpeg","voiceDuration":2.8959410430839,"seVolume":1},{"id":"97A09C0F-AE51-4C63-AC3D-051D9A5D19B0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1286_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","telop":"「そうなんですね…、僕は小学生くらいまでは、\n家族で何度か、飛行機に乗って沖縄に行ってましたが…。」","voiceCharacter":"操夢","duration":6.8691156462585035,"title":"シーン 1286","slideTitle":"スライド #1286","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子