"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1336.jpeg","voiceDuration":4.3059410430839,"seVolume":1},{"id":"57D4670B-0241-4185-B9E3-E359F5376B81","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1337_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc352037_ホテルの廊下1.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","telop":"「私は、できるだけこいしと同じ部屋がいいわ…」","voiceCharacter":"古明地さとり","duration":2.446984126984127,"title":"シーン 1337","slideTitle":"スライド #1337","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1337.jpeg","voiceDuration":2.446984126984127,"seVolume":1},{"id":"D3A9AC90-D189-45DA-97F7-C5F6C1696A59","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1338_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc352037_ホテルの廊下1.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","telop":"「それで、こいしさんは…、どうですか？」","voiceCharacter":"操夢","duration":2.466938775510204,"title":"シーン 1338","slideTitle":"スライド #1338","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1338.jpeg","voiceDuration":2.466938775510204,"seVolume":1},{"id":"9DC827CE-CEE6-4F67-8384-89A4E7FC60AA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1339_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc352037_ホテルの廊下1.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","telop":"「私は…」私はそう言いかけて、言葉が止まる。\nそして、ふと彼とエンドレスランをした日のことを思い出す…。","voiceCharacter":"古明地こいし","duration":9.31047619047619,"title":"シーン 1339","slideTitle":"スライド #1339","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1339.jpeg","voiceDuration":9.31047619047619,"seVolume":1},{"id":"B7BA5663-1D73-4BDD-B2E3-2773A2EF1236","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1340_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"私たちが、走り始めてから、最初の校門を出て曲がるまでは、\n特に問題なく、比較的にスムーズに走れていた。","voiceCharacter":"古明地こいし","duration":10.14750566893424,"title":"シーン 1340","slideTitle":"スライド #1340","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1340.jpeg","voiceDuration":10.14750566893424,"seVolume":1},{"id":"60625397-89DB-4BA2-8F86-0457E87A4004","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1341_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"だが、1kmあたりを過ぎると、だんだんと、彼と私のペースに翳りが見え始め、後方にいた美鈴先生がその問題を指摘する。","voiceCharacter":"古明地こいし","duration":11.650272108843538,"title":"シーン 1341","slideTitle":"スライド #1341","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1341.jpeg","voiceDuration":11.650272108843538,"seVolume":1},{"id":"F37A9081-FB4F-42E2-BCAE-EBE55603347D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1342_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"そこまでは、単純に走って疲れて、歩いているだけ、だった。\nだが、歩き始めて少し経つと、彼が急に走り出す。","voiceCharacter":"古明地こいし","duration":10.726235827664398,"title":"シーン 1342","slideTitle":"スライド #1342","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1342.jpeg","voiceDuration":10.726235827664398,"seVolume":1},{"id":"51C0F4DB-5196-46E0-8895-1CB6A693F738","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1343_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"私は、慌てて彼について行こうとすると、彼の手がぶつかる。\n私はあのときドキッとし、そして、口走り、そのまま走り出す。","voiceCharacter":"古明地こいし","duration":11.539773242630385,"title":"シーン 1343","slideTitle":"スライド #1343","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1343.jpeg","voiceDuration":11.539773242630385,"seVolume":1},{"id":"D4ACDF0A-B9A3-4BF6-AA96-AF016B7BBCA7","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1344_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"だが、さらに1kmがたつと、今度は足元にある石ころにこける。\nそして、次の瞬間には、彼に抱っこされていた。","voiceCharacter":"古明地こいし","duration":10.744195011337869,"title":"シーン 1344","slideTitle":"スライド #1344","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1344.jpeg","voiceDuration":10.744195011337869,"seVolume":1},{"id":"3D491CCA-3DB3-4933-B12F-A2556376EBCE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1345_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"それからだろうか…、私は、今までの学校生活では全くと言っていいほど、感じなかった気持ちが心から湧き出していた。","voiceCharacter":"古明地こいし","duration":10.158548752834466,"title":"シーン 1345","slideTitle":"スライド #1345","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1345.jpeg","voiceDuration":10.158548752834466,"seVolume":1},{"id":"B5F6883F-2157-4194-96C9-729267B15D5C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1346_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc352037_ホテルの廊下1.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","telop":"私は、ふと意識が現実に戻ると、彼が困った表情で、私の名前を読んでいた。「私は…紅夢と…」私は、続けて言葉を放つ。","voiceCharacter":"古明地こいし","duration":3.1171201814058955,"title":"シーン 1346","slideTitle":"スライド #1346","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1346.jpeg","voiceDuration":3.1171201814058955,"seVolume":1},{"id":"5706D5DF-A43A-4FD0-B09E-F947B33218AA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","t