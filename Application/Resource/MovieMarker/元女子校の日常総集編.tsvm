ePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1535.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、そうですよ。今日は、北上する日なので、ささっと準備を済ませたら、出発しますよ。途中で朝食も取るので。」","id":"3B7CEF72-E705-4AF4-8D70-0FB35298FFAA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.921292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":1.910861678004535,"slideTitle":"スライド #1536","title":"シーン 1536","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1536_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1536.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「北上するって、どこに向かうの？」","id":"5423C8AC-B981-49D2-B7DC-C01A6CA67B96","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.910861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":4.677823129251701,"slideTitle":"スライド #1537","title":"シーン 1537","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1537_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1537.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「恩納村です。高速は使わないので、お金は必要ないですよ。」","id":"5D83DCFD-C3DF-46F7-9EDF-48EE2B8CDD85","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.677823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":0.5,"slideTitle":"スライド #1538","title":"シーン 1538","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1538_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1538.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「そう…」","id":"BA2D9D09-FA23-46F6-BEC3-24A03AA7764E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":0.5},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":7.845215419501134,"slideTitle":"スライド #1539","title":"シーン 1539","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1539_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1539.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、そんな話をしていると、玄関のチャイムが鳴る。\nすると、扉が開き、さとりとこいしが入ってきた。","id":"084185FA-17DF-4A06-8D8A-CB1ABEFDBC04","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.845215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":8.216938775510204,"slideTitle":"スライド #1540","title":"シーン 1540","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1540_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1540.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女はある書面を机上に置き、ペンを僕に渡し、サインをするように言ってくる。僕は、その書面の内容を読む。","id":"DC73F14E-5A22-4DCF-81B5-003F8F9C339D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.216938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":3.937551020408163,"slideTitle":"スライド #1541","title":"シーン 1541","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1541_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1541.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それで、あなたはこの内容に同意してくれるの？」","id":"BEA12B84-6AE1-4E4C-BCC3-7B2C0E7A18BE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.937551020408163},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":9.216938775510204,"slideTitle":"スライド #1542","title":"シーン 1542","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1542_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1542.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その書面に記された文章を見る。書面の下には、彼女のサインと何かの印章が貼られていた。すると、彼女が急かす。","id":"E881AC91-6DC0-47AD-827A-2E54E961245D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.216938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":0.7386621315192744,"slideTitle":"スライド #1543","title":"シーン 1543","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1543_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1543.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「まだ？」","id":"1FB30FAF-F427-461F-AC96-72613F5186EF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.7386621315192744},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":3.0104308390022676,"slideTitle":"スライド #1544","title":"シーン 1544","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1544_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1544.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「この内容…、フランさんたちは知ってるんですか？」","id":"6D42472B-D3DE-443C-966C-FBB89FB7CF32","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.0104308390022676},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":8.954126984126985,"slideTitle":"スライド #1545","title":"シーン 1545","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1545_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1545.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ええ、彼女たちに宣戦布告したのよ。昨日も言ったけど、もう以前の関係には戻れない、これは…」","id":"DA261A6F-C3AF-4326-8AEB-47A03C734FA9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":8.954126984126985},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":4.10172335600907,"slideTitle":"スライド #1546","title":"シーン 1546","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1546_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1546.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そこまで言うと、彼女は頬を赤らめ、数秒の間の後、言う。","id":"819157CC-BCAF-490E-BEA6-EDCB94CA2641","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.10172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":10.548049886621316,"slideTitle":"スライド #1547","title":"シーン 1547","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1547_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1547.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「これは…、あなたの結婚相手…いや、後継をめぐる紅魔建設と私たち…、地下底国グループが戦うための文書なのよ。」","id":"C5F955B3-0A6F-485B-88FE-33CF8EE35C1F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.548049886621316},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":10.994195011337869,"slideTitle":"スライド #1548","title":"シーン 1548","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1548_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1548.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それに、学校側だって、あなたが欲しいから、きっとこの戦いに参戦してくるわ。あなたは、その戦いの主軸なのよ。」","id":"93A3D62F-26A8-468E-B398-56AB88FB4470","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.994195011337869},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":8.30607709750567,"slideTitle":"スライド #1549","title":"シーン 1549","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1549_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1549.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…」僕は、次々と述べられる彼女の言葉の意味をうまく受け取れずに、ただ困惑してしまう。そして、さとりに視線を向ける。","id":"722C5F81-8983-4505-8067-0E361A974EB4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.30607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":3.156077097505669,"slideTitle":"スライド #1550","title":"シーン 1550","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1550_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1550.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「これは…、一体どう言うことですか…、さとりさん…？」","id":"415CCE2A-1FB4-4EB6-B1A1-53B2844431F7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.156077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":7.068185941043084,"slideTitle":"スライド #1551","title":"シーン 1551","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1551_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1551.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あなたが、昨日、妹の裸を見たことで、私たちの中での決まりが、あなたにも適用されたんですよ、強制ではないですが…」","id":"E158D2B5-3119-474A-8399-9234BF142A08","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":7.068185941043084},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":10.813242630385487,"slideTitle":"スライド #1552","title":"シーン 1552","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1552_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1552.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「あと、あなたの母親のところも、後継者の関係で、あなたを引き戻したいそうよ。だから、四つ巴の戦いなのよ…。」","id":"1373E52B-DC48-4817-A08A-A9039A26C4FF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.813242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":6.182789115646258,"slideTitle":"スライド #1553","title":"シーン 1553","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1553_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1553.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「簡単に言えば、私たちとあなたどう言う関係なのかを明白にし、戦いの混乱を避けるための同意が必要なんですよ…。」","id":"0196B285-85AE-4342-8B99-CF81D2452036","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.182789115646258},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":8.25172335600907,"slideTitle":"スライド #1554","title":"シーン 1554","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1554_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1554.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、さとりの補足説明で、彼女たちが言いたいことを大まかに把握する。「別に構いませんけど…、一つだけいいですか？」","id":"563115C8-3AA8-40DA-AF9B-586E84EF1D94","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.25172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":1.7082766439909296,"slideTitle":"スライド #1555","title":"シーン 1555","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1555_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1555.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「どんな条件なの？」","id":"2D70986C-EFCB-4F53-BAB6-52D184F5DD2F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.7082766439909296},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image68.jpeg","bgmStartTimeOffset":0,"duration":3.434331065759637,"slideTitle":"スライド #1556","title":"シーン 1556","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1556_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image68.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1556.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「向こうに帰るまでは、これまで通りで過ごしませんか？」","id":"24D02CD1-3741-40E7-AC35-E176B4EF4F35","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.434331065759637},{"backgroundIma