olume":1,"voiceCharacter":"古明地こいし","voiceDuration":6.568775510204081},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":1.7088208616780045,"slideTitle":"スライド #2140","title":"シーン 2140","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2140_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2140.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手小口笑い笑い目.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「それじゃあ、行きましょうか。」","id":"31C3A087-F82A-469D-88C4-FF91575C02D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":1.7088208616780045},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":5.646303854875283,"slideTitle":"スライド #2141","title":"シーン 2141","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2141_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2141.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手小口笑い笑い目.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、そうですね。」それから僕とレミリアとフランは、\n食事に出かけていくのだった。","id":"E33AF8BE-697C-49BB-B68C-42C1917C6AA8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.646303854875283},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #2142","title":"シーン 2142: スカーレット・紅夢（大学院まで完走した24歳。）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2142.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"スカーレット・紅夢（大学院まで完走した24歳。）","id":"FBD25BB4-D1E8-4DEE-8133-B90AE0C8D175","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.572380952380953,"slideTitle":"スライド #2143","title":"シーン 2143","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2143_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2143.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/よったニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は食事を終えて、夜の10時ごろに、酔いが全身に巡り巡って、赤くになったレミリアとフランを連れて帰ってきた。","id":"B30D6CAE-5E2B-4E16-9480-0BAFF8DF18EA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.572380952380953},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.495850340136054,"slideTitle":"スライド #2144","title":"シーン 2144","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2144_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2144.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/よったニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、僕はある嫌な予感がする。そこで僕は、食事前にパチュリーからもらっていたある液体を二人に飲ます。","id":"0D15D206-30EE-4A01-BDE5-4E6D5A901C4C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.495850340136054},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.547369614512471,"slideTitle":"スライド #2145","title":"シーン 2145","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2145_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2145.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/よったニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、その予感は見事に的中し、二人は料理が口に逆走しなかったはいいものの、二人の下にはある液体が垂れ流れていた。","id":"F56ED7EC-EA55-4C6E-90CA-D368F31AC64B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.547369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg","bgmStartTimeOffset":0,"duration":6.11922902494331,"slideTitle":"スライド #2146","title":"シーン 2146","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2146_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc228271_居酒屋の個室.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2146.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「これ、あなたが開発した、アルコール排出促進剤。\n二人が酔い潰れそうだったら、その前に飲ませて。」","id":"32AAB997-4B3C-462F-879E-4733750BA4FA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":6.11922902494331},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc228271_居酒屋の個室.jpg","bgmStartTimeOffset":0,"duration":5.534557823129251,"slideTitle":"スライド #2147","title":"シーン 2147","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2147_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc228271_居酒屋の個室.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2147.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「ただし、ゲロを吐くことはないけど、その代わりにアルコールがそのまま混じったアレがスカートから出てくるから。」","id":"EAD1CDD1-690B-43A4-91E2-E2D4A82D5932","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":5.534557823129251},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.040430839002267,"slideTitle":"スライド #2148","title":"シーン 2148","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2148_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2148.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/よったニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、自分たちがアレを出していることに気がつかない二人をじっと見る…。ちなみにその薬の別名は、赤ちゃん薬だった。","id":"FE3A7BE2-4EB4-4A17-A1D8-5D2B261F0289","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.040430839002267},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":4.28562358276644,"slideTitle":"スライド #2149","title":"シーン 2149","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2149_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2149.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ、二人を素っ裸にして、何する気なの？」","id":"F114D777-4D03-4082-A4FD-51C00D9725B6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.28562358276644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":6.675646258503401,"slideTitle":"スライド #2150","title":"シーン 2150","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2150_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2150.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こいし…、ちょっと手伝って、酔いが回って、アレを漏らしちゃったお二人さんを、浴室に連行するから。」","id":"8FD0A6AB-6DE0-426C-8E42-803C3B5A06D2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.675646258503401},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":10.031473922902494,"slideTitle":"スライド #2151","title":"シーン 2151","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2151_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2151.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り不満.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「はぁ？何言ってるの、あんた。言っておくけど、私は二人の下のお世話なんてしないから、あんた一人でしてね。」","id":"CE05257C-85DC-452C-A6C3-62F0FE87D6E2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.031473922902494},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.373469387755102,"slideTitle":"スライド #2152","title":"シーン 2152","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2152_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2152.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り不満.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「もしかして、こいし…、やけ酒してた？」\n僕は、彼女が普段呼びない呼び方で、僕を呼んだのでそう聞く。","id":"EB3F522B-4ECC-4E4C-9858-3E95D3181060","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.373469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":5.28562358276644,"slideTitle":"スライド #2153","title":"シーン 2153","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2153_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2153.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「くっ…、一人で寂しくて、お酒で濁してたのよ、私…」","id":"BDF3F9A6-E51A-4A38-9C4D-F4C5E494D94D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":5.28562358276644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.516938775510203,"slideTitle":"スライド #2154","title":"シーン 2154","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2154_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2154.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ふっ…」僕は、彼女の言動に思わず、そう笑い出してしまう。\n「あれ…酔ってないつもりだけど、酒が回ってきたのかな…」","id":"7AB2526A-5944-4410-A93C-B916CE90EBE8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.516938775510203},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.461519274376418,"slideTitle":"スライド #2155","title":"シーン 2155","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2155_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2155.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「まぁ、いいや。とにかく、アレを漏らしたお二人さんの介護、手伝って、それが済んだら、思う存分頭を撫でてあげるから。」","id":"FBA77C89-3601-45D0-9B95-267171E69EC4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.461519274376418},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":4.346394557823129,"slideTitle":"スライド #2156","title":"シーン 2156","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2156_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2156.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「うっ…、分かったわよ、この私が手伝ってあげる。」","id":"D4AF9B32-5BE5-489D-8F60-4C4289E8B2D7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.346394557823129},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.772380952380952,"slideTitle":"スライド #2157","title":"シーン 2157","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2157_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2157.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ふっ」僕は、彼女の言動で何かが外れてしまったのか、そこから彼女が怒鳴り込むまで、大笑いしてしまうのだった。","id":"81336835-9010-4D18-BD42-68190583D6B4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.772380952380952},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #2158","title":"シーン 2158: 古明地こいし（大学に通う21歳。）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2158.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照りジト目あわわ.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"古明地こいし（大学に通う21歳。）","id":"AE3F0602-8B24-4F8F-8DE2-80CF01DD38AF","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.348458049886621,"slideTitle":"スライド #2159","title":"シーン 2159","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2159_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2159.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「んっ…」僕はふと目が覚めると、そこは家の玄関ホールだった。そして、ある感触がし、ふとそれを見る。","id":"B3C97EA4-A959-4E6D-833A-3C50456FA460","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.348458049886621},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.510430839002268,"slideTitle":"スライド #2160","title":"シーン 2160","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2160_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2160.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なしバトルっぽい目閉じ口閉じ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、こいしが僕に抱きつく形で眠っていた。そして、ふと昨晩の記憶を思い出そうとしていると、誰かの視線を感じる。","id":"844A0D9C-51EB-41EC-AF05-CFD0562AC290","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.510430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.074557823129251,"slideTitle":"スライド #2161","title":"シーン 2161","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2161_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2161.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、そこには頬が赤らみ、驚いているフランがいた。\n「あっ、しまった…」僕は、ふとそう呟く。","id":"6DBD6553-CD71-41B8-B38E-00EF564B6697","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.074557823129251},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":3.856077097505669,"slideTitle":"スライド #2162","title":"シーン 2162","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2162_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2162.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女は僕に駆け寄ってくると、僕にビンタをした。","id":"578D58CF-2B08-4DA7-9CAB-A219F7EC3F58","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.856077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":1.7169387755102041,"slideTitle":"スライド #2163","title":"シーン 2163","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2163_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2163.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、こいしが目覚める。","id":"5A06964C-474D-48CD-98F7-0CB74CEBCB91","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.7169387755102041},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":3.9237414965986392,"slideTitle":"スライド #2164","title":"シーン 2164","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2164_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2164.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「えへへ、私、お兄ちゃんと抱き合って寝れた…。」","id":"9CE2FDA8-C7DF-43CD-9AC9-6C076BA13574","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.9237414965986392},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.859478458049887,"slideTitle":"スライド #2165","title":"シーン 2165","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2165_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2165.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、これはどう言うことなの？私という存在がいながら、こいしとこんなとこで抱き合って寝るなんて。一体…」","id":"044218A3-6CE9-455C-96CD-6DAD0092F830","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.859478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.416938775510204,"slideTitle":"スライド #2166","title":"シーン 2166","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2166_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2166.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「でも僕は…」僕はそう言いかけ、ハッとする。なぜなら、高校生の時なら、真っ先にそうなった言い訳を言っていたからだ。","id":"FA8351A3-F9FA-45E8-ABC8-E7904BE888AD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.416938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":9.473469387755102,"slideTitle":"スライド #2167","title":"シーン 2167","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2167_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2167.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私は、お兄ちゃんと一緒に過ごしていれば、安心できるし、いっぱい甘えて、頼れるから、それでいいと思うよ。」","id":"A823F2C4-6AB5-4E92-B516-2CA92EF881FF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":9.473469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.101723356009071,"slideTitle":"スライド #2168","title":"シーン 2168","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2168_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2168.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、こいしの言葉にどこか安心感を覚える。別にこいしが好きなんじゃない、ただその安心という言葉の響きがいいのだ…。","id":"9E2E8821-07FC-4E13-A179-C5002BB3217C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.101723356009071},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.401723356009071,"slideTitle":"スライド #2169","title":"シーン 2169","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2169_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2169.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、自分自身のフランやこいしに対する気持ちや考え方がわからなくなり、困っていると、レミリアの声がする。","id":"98DD9F3F-2967-4148-864B-25E4BF3799EE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.401723356009071},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.415079365079365,"slideTitle":"スライド #2170","title":"シーン 2170","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2170_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2170.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり驚き後ろ手.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「ねぇ、あなたとこいしは互いの存在に依存する共依存じゃないかしら…、もしあなたが彼女の発言に安心してたらだけど…」","id":"1B617A64-9A5A-44CE-A76B-EA8E59275906","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.415079365079365},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.757165532879819,"slideTitle":"スライド #2171","title":"シーン 2171","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2171_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2171.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり驚き後ろ手.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、レミリアの発言に、なぜか納得してしまった。そして、こうつぶやく。「確かに、レミリアさんの意見が正しいです…」","id":"F82CCDD3-B4C0-42F6-8F7A-5D086ED036DE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.757165532879819},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.473469387755102,"slideTitle":"スライド #2172","title":"シーン 2172","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2172_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2172.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フランごくり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、四人の間には、これまでに感じたことのない冷たく気まずい空気が漂い出す。そして、沈黙の時間が流れる。","id":"0B73A53C-A406-493C-8275-847144A0AEEF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.473469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.054648526077098,"slideTitle":"スライド #2173","title":"シーン 2173","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2173_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2173.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フランごくり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「それで、これからどうするの？あなたの意見を聞かせてもらえないかしら…。じゃないと来月からの予定が狂うのよ。」","id":"13583764-A3FE-402C-8FAE-8619E6DFEFF8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.054648526077098},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.316938775510204,"slideTitle":"スライド #2174","title":"シーン 2174","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2174_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2174.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フランごくり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「僕は…、この関係が壊れるのは嫌で、フランさんと離婚したくない…、でも、これは僕の単なるわがままですよ…。」","id":"40670D6A-5A8F-4D15-8F85-B962F984DA38","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.316938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.238684807256236,"slideTitle":"スライド #2175","title":"シーン 2175","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2175_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2175.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それからしばらくの間、冷えた笑いに溢れかえる。\nだが、フランが僕の頬を強く叩き、僕はハッと我に帰る。","id":"A0E9E13B-1CB4-4174-BAA9-BC01C0643B24","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.238684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":8.959478458049887,"slideTitle":"スライド #2176","title":"シーン 2176","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2176_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2176.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、しっかりして！このことは、あなたの妻である私の責任でもあるし、そこら辺はちゃんと責任を果たすから！」","id":"74044CD9-D032-4559-A3CF-F00D8B189EBC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.959478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.330634920634921,"slideTitle":"スライド #2177","title":"シーン 2177","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2177_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2177.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「確かにフランのいう通りですね…、このままだといけないのは僕も分かっているので、誰にも依存しないようにしますよ…」","id":"4D2E36FE-F3FA-4A5C-809F-59A5DA4DB481","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.330634920634921},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc213186_紅魔館ロビー.jpg","bgmStartTimeOffset":0,"duration":7.548458049886621,"slideTitle":"スライド #2178","title":"シーン 2178","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2178_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2178.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言う。だが、僕はまだ気づけなかった。\n僕の中でのこいしの存在の大きさ、そしてその効果を。","id":"46510A1C-9FD5-47C0-846D-32E660C42CE3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.548458049886621},{"animationDuration":2,"bgmStartTimeOffset":0,"duration":2,"slideTitle":"スライド #2179","title":"シーン 2179: 続く…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：2秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2179.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"続く…","id":"B37EC085-290F-49F7-B860-F5EDB3BE4EA6","seVolume":1},{"animationDuration":20,"bgmStartTimeOffset":0,"duration":20,"slideTitle":"スライド #2180","title":"シーン 2180: ご視聴ありがとうございました！","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：20秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2180.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"ご視聴ありがとうございました！","id":"BB7F6043-4E1D-476C-839D-2D30F6CD3B80","seVolume":1}]