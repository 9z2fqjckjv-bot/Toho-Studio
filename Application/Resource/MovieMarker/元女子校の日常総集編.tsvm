:"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.254.jpeg","voiceDuration":6.8192290249433105,"seVolume":1},{"id":"24465734-EB21-4B34-84E1-946C860B0A61","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_255_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「それで…」","voiceCharacter":"レミリア・スカーレット","duration":0.652562358276644,"title":"シーン 255","slideTitle":"スライド #255","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.255.jpeg","voiceDuration":0.652562358276644,"seVolume":1},{"id":"89CF9CC9-E8F6-46CF-B8A3-9E2D5B844B68","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_256_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「秘密保持契約で、口外は厳禁って言ったところですか？」","voiceCharacter":"サブ","duration":4.025646258503401,"title":"シーン 256","slideTitle":"スライド #256","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.256.jpeg","voiceDuration":4.025646258503401,"seVolume":1},{"id":"4D6BCA7D-501B-4427-84CC-BB8FE11B4B7A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_257_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「ええ、今この場で、口頭による契約成立とみなしていただき、今後、この事実が口外控えていただけますか？」","voiceCharacter":"レミリア・スカーレット","duration":7.4504988662131515,"title":"シーン 257","slideTitle":"スライド #257","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.257.jpeg","voiceDuration":7.4504988662131515,"seVolume":1},{"id":"2ED9E30B-325A-45BE-94C0-816D18847DFB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_258_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「承知しました、それで、この学園に来たのは、単純な深夜徘徊ではありませんよね。妹さんが入口を破壊してるだろうし…」","voiceCharacter":"サブ","duration":8.760430839002268,"title":"シーン 258","slideTitle":"スライド #258","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.258.jpeg","voiceDuration":8.760430839002268,"seVolume":1},{"id":"286C65C3-2EF1-4AE4-8A1A-17A695AF2107","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_259_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「ええ、これから、私は、妹が破壊した入口を修復するための手筈を取る予定です。それで、あなたはどうしますか？」","voiceCharacter":"レミリア・スカーレット","duration":8.10673469387755,"title":"シーン 259","slideTitle":"スライド #259","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.259.jpeg","voiceDuration":8.10673469387755,"seVolume":1},{"audioTrack":"track_voice_char_CC3E","transitionName":"なし","telop":"「そのついでに、食事の用意もできないでしょうか、私、今日、\nいや昨日のお昼から、何も食べてないんです。」","title":"シーン 260","slideTitle":"スライド #260","voice2StartTimeOffset":4.390861678004535,"seStartTimeOffset":0,"characterName":"サブ","bgmVolume":0.7,"duration":7.251292517006803,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.260.jpeg","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_260_サブ_2.wav","seVolume":1,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_260_サブ.wav","voiceCharacter":"サブ","voice2Duration":2.8604308390022677,"id":"FD8C76E1-A150-4341-BA38-E36C76BF3451","voiceDuration":4.390861678004535,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","voice2Character":"サブ","bgmStartTimeOffset":0,"voiceStartTimeOffset":0},{"id":"55C3C875-195B-4BE1-B23D-751685E210B6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_261_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「分かりました、それくらいはお安いご用です。では、私と一緒に、その妹を抱えてきていただけますでしょうか？」","voiceCharacter":"レミリア・スカーレット","duration":7.4858956916099775,"title":"シーン 261","slideTitle":"スライド #261","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.261.jpeg","voiceDuration":7.4858956916099775,"seVolume":1},{"id":"55EA3238-8265-43F2-807A-C81FD545213E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/z