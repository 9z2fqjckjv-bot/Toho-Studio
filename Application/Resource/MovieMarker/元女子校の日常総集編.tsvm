lication Support\/TohoStudio\/GeneratedAudio\/Slide_841_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「あれ…今私は、なにしてたんだっけ？」","voiceCharacter":"フランドール・スカーレット","duration":3.2632426303854873,"title":"シーン 841","slideTitle":"スライド #841","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.841.jpeg","voiceDuration":3.2632426303854873,"seVolume":1},{"id":"83700005-36E3-47EE-9F0C-344E77019CB6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_842_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「とりあえず、彼のいる図書館に行ってきたらどうかしら？」","voiceCharacter":"レミリア・スカーレット","duration":3.3192290249433105,"title":"シーン 842","slideTitle":"スライド #842","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.842.jpeg","voiceDuration":3.3192290249433105,"seVolume":1},{"id":"CAB3BD95-AC7C-47E3-97AD-1DF4E32B5234","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_843_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「じゃあ、図書館にいってくるね。」","voiceCharacter":"フランドール・スカーレット","duration":2.4244897959183676,"title":"シーン 843","slideTitle":"スライド #843","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.843.jpeg","voiceDuration":2.4244897959183676,"seVolume":1},{"id":"7DD6BB3E-03B8-4815-870E-DC7A5180E31D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_844_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"フランはそういうと去っていった。\nそして、私は先ほど使用したそれをみる。","voiceCharacter":"レミリア・スカーレット","duration":4.651995464852607,"title":"シーン 844","slideTitle":"スライド #844","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.844.jpeg","voiceDuration":4.651995464852607,"seVolume":1},{"id":"DCDF0377-650E-4DA2-807E-341FFBD5FFCA","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_845_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"これは、注射器で、その中には、ある人物の血液が入っていた。\nその人物は、今、彼が元いた家に住んでいる女性のものだった。","voiceCharacter":"レミリア・スカーレット","duration":9.112403628117914,"title":"シーン 845","slideTitle":"スライド #845","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.845.jpeg","voiceDuration":9.112403628117914,"seVolume":1},{"id":"0650DD5A-B6E3-47BB-960A-3908C69AE682","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_846_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「どっかのタイミングで、彼から採血しないとね…」特殊な体を持つ二人の血液は、フランの狂気を瞬時に、鎮静化できた。","voiceCharacter":"レミリア・スカーレット","duration":8.246326530612246,"title":"シーン 846","slideTitle":"スライド #846","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.846.jpeg","voiceDuration":8.246326530612246,"seVolume":1},{"id":"F599696C-C8A9-4C47-9CF9-577FC5EEE4CB","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_847_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"このことを知るまでは、フランの狂気を肉弾戦で食い止めるか、一瞬の隙をついて気絶させるかの二択しかなかったのだった。","voiceCharacter":"レミリア・スカーレット","duration":7.715079365079365,"title":"シーン 847","slideTitle":"スライド #847","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.847.jpeg","voiceDuration":7.715079365079365,"seVolume":1},{"id":"BAD4D510-1D2A-42B2-869C-94ED4D0DC4DF","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_848_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"彼とその女性には、狂気というものは存在しないが、別の要素を持っていた。この流れは、今後も続くかもしれない。","voiceCharacter":"レミリア・スカーレット","duration":7.746326530612245,"title":"シーン 848","slideTitle":"スライド #848","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.848.jpeg","voiceDuration":7.746326530612245,"seVolume":1},{"id":"B3485382-4791-4BF0-8A7C-E84FC300FA45","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_849_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"私は、それを見ながら、そんなことを考えるのだった。","voiceCharacter":"レミリア・スカーレット","duration":3.481156462585034,"title":"シーン 849","slideTitle":"スライド #849","characterName":"レミリア・スカーレット","audioTrack":"trac