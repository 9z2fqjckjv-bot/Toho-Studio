e\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.616.jpeg","voiceDuration":8.873469387755103,"seVolume":1},{"id":"2CDDD18B-5A4C-4B67-A12F-8C319CE1E7C8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_617_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「…少しばかし、恥ずかしいです…」僕は、そう返すのだった。","voiceCharacter":"操夢","duration":4.174557823129252,"title":"シーン 617","slideTitle":"スライド #617","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.617.jpeg","voiceDuration":4.174557823129252,"seVolume":1},{"id":"A35AA957-41A9-4321-B32F-CF9E611B8F91","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"その頃、霊夢は…","duration":1.5,"title":"シーン 618: その頃、霊夢は…","slideTitle":"スライド #618","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.618.jpeg","seVolume":1},{"id":"A2746F3C-7BBE-4419-BC54-3BD3DB27C748","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_619_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","telop":"私は、この取調室でふと今朝のことを思い出していた。","voiceCharacter":"博麗霊夢","duration":4.366984126984127,"title":"シーン 619","slideTitle":"スライド #619","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.619.jpeg","voiceDuration":4.366984126984127,"seVolume":1},{"id":"F8E0DDA9-8B2E-4E46-AB75-E516DBAE9B7D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_620_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc238754_一人部屋（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg","telop":"私は、家を出てから、魔理沙の家に着くと、彼女は、ため息をつきながら、どこか暗く感じる表情をしていた。","voiceCharacter":"博麗霊夢","duration":8.756984126984127,"title":"シーン 620","slideTitle":"スライド #620","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.620.jpeg","voiceDuration":8.756984126984127,"seVolume":1},{"id":"308AB73D-35E7-46BF-A09D-C9B64FBFDA77","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_621_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc238754_一人部屋（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg","telop":"私が、彼女にそんな表情をしている理由を問うと、昨晩の就寝時に、やけ酒をしていると、ふと不思議な声が聞こえたという。","voiceCharacter":"博麗霊夢","duration":9.694489795918367,"title":"シーン 621","slideTitle":"スライド #621","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.621.jpeg","voiceDuration":9.694489795918367,"seVolume":1},{"id":"886B8F27-6869-479D-92B3-D305347B7A36","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_622_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc238754_一人部屋（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg","telop":"そして、気がつけば、赤信号の横断歩道を渡っており、彼が止めなければ、きっとあのまま車に轢かれていたという。","voiceCharacter":"博麗霊夢","duration":8.569478458049886,"title":"シーン 622","slideTitle":"スライド #622","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.622.jpeg","voiceDuration":8.569478458049886,"seVolume":1},{"id":"9F39B405-553C-4ACE-B725-1BB30D8CC88A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_623_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc238754_一人部屋（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg","telop":"私は、その症状が時折彼女に現れることを知っていて、だが、出来事が起きてから、翌朝には記憶から消えることを知っていた。","voiceCharacter":"博麗霊夢","duration":10.046984126984126,"title":"シーン 623","slideTitle":"スライド #623","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.623.jpeg","voiceDuration":10.046984126984126,"seVolume":1},{"id":"0745BE60-E656-4E62-9473-87D499727FFF","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_624_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc238754_一人部屋（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc238754_一人部屋（日中）.jpg","telop":"だが、彼女はあの後も、悪夢に悩まされていて、今日1日を無事に過ごせるかが不安だというので、励まし、私は仕事に向かった。","voiceCharacter":"博麗霊夢","duration":10.303242630385487,"title":"シーン 624","slideTitle":"スライド #624","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.624.jpeg","voiceDuration":10.303242630385487,"seVolume":1},{"id":"37CD1BE8-E66B-4636-8150-DB0C29725BA4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔2.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_625_博麗霊夢.wav","