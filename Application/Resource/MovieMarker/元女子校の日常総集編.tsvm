1},{"id":"F0306F08-AC6F-4315-82DD-D6177967A7C8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1421_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"するとさとりとアリスの頬が頬照る。\n「二人とも、どうしました？」","voiceCharacter":"操夢","duration":4.234331065759637,"title":"シーン 1421","slideTitle":"スライド #1421","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1421.jpeg","voiceDuration":4.234331065759637,"seVolume":1},{"id":"7725A152-59A0-42B0-B288-0BC9577B4542","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1422_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"「こいしの態度が一変した理由が、分かったわ…」\n私はそう言いながら、あの感情の波が少しだけ理解できた。","voiceCharacter":"古明地さとり","duration":5.716984126984127,"title":"シーン 1422","slideTitle":"スライド #1422","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1422.jpeg","voiceDuration":5.716984126984127,"seVolume":1},{"id":"8D8E186C-7E84-47D1-9159-9842551EB864","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（怒り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1423_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"「私も分かったわ…」私はさとり続けてそういう。","voiceCharacter":"アリス・マーガトロイド","duration":2.7009523809523808,"title":"シーン 1423","slideTitle":"スライド #1423","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1423.jpeg","voiceDuration":2.7009523809523808,"seVolume":1},{"id":"C8E7C5A6-FECB-47C8-9268-AD119C5E85BA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1424_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"僕は、何かをぶつぶついう二人を置いて、最初の注文をする。頼んだのは、ハンバークセットと鉄火丼定食だった。","voiceCharacter":"操夢","duration":8.222380952380952,"title":"シーン 1424","slideTitle":"スライド #1424","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1424.jpeg","voiceDuration":8.222380952380952,"seVolume":1},{"id":"2BC09666-5E70-467F-809D-0F17858CC83A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1425_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"それから、僕とこいしはそのまま、ドリンクバーに向った。\nすると、二人は後から気づき、慌てて注文をするのだった。","voiceCharacter":"操夢","duration":7.999546485260771,"title":"シーン 1425","slideTitle":"スライド #1425","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1425.jpeg","voiceDuration":7.999546485260771,"seVolume":1},{"id":"F0AEB92F-C3BC-4112-AEF9-2C970EEECB2B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1426_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"僕たちは、ファミレスに着くと、各自が食べたい料理を注文し、順に順に運ばれてきた料理を食べ進めていた。","voiceCharacter":"操夢","duration":7.249546485260771,"title":"シーン 1426","slideTitle":"スライド #1426","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1426.jpeg","voiceDuration":7.249546485260771,"seVolume":1},{"id":"89BA84E0-D52D-4986-A521-22A2A575DFB0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStu