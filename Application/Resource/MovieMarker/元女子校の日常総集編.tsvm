.473673469387755},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":8.646303854875283,"slideTitle":"スライド #2030","title":"シーン 2030","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2030_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2030.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、僕が何かを言い出す前に、この瓶の中にある液体を飲ませてくる。そして僕は、意識が闇に落ちるのだった。","id":"0DD0FAA2-6D4B-4B20-9875-E71145EC7C2C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.646303854875283},{"bgmStartTimeOffset":0,"duration":7.75281179138322,"slideTitle":"スライド #2031","title":"シーン 2031","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2031_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2031.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、ふと気がつくと、そこは暗闇が広がる空間だった。\nすると、遠くで誰かが戦っている音が聞こえる。","id":"D817F7F6-6AF9-4405-AA5F-7131DF6BCC6D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.75281179138322},{"bgmStartTimeOffset":0,"duration":7.596303854875283,"slideTitle":"スライド #2032","title":"シーン 2032","animationName":"なし","voiceAud