dioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_854_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.854.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「全国財閥高統一模試ですよ。」\n僕はそういうと、勉強を再開した。\n元女子校の日常\n〜彼が図書館で勉強していると、フランが話しかけてきて…〜","id":"CE10E452-0F0E-4ECA-A29D-DF8A423A8EA6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.308253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.710430839002267,"slideTitle":"スライド #855","title":"シーン 855","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_855_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.855.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、あっという間に、時間が経ち、\n気がつけば転校してから、半月の程の期間が経っていた。","id":"748182B9-FD9C-4801-A211-8A7C598A070F","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.710430839002267},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":10.153469387755102,"slideTitle":"スライド #856","title":"シーン 856","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_856_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.856.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、今日は、この2週間ほどで勉強した全国財閥高統一模試を受ける日だった。すると、教室の扉が開き、担任が入ってくる。","id":"A1D834E8-685A-41CB-847A-2C833013B9A7","seVolume":1,"voiceCharacter":"操夢","voiceDuration":10.153469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.927823129251701,"slideTitle":"スライド #857","title":"シーン 857","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_857_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.857.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、素早く席を立ち上がり、クラスメイトに合わせた朝の挨拶をする。そして、彼女の合図とともに席に座る。","id":"11BFDEAA-E37A-4E11-B6E5-DB36219E3AF8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.927823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.562222222222223,"slideTitle":"スライド #858","title":"シーン 858","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_858_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.858.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「それでは、朝礼を始めます。今日は、毎月恒例の定期ミニテスト日です。全時限でミニテストがあるので、覚悟してください。」","id":"7FD765F7-7DA5-4898-AB48-78EA83FCD689","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":8.562222222222223},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.508253968253968,"slideTitle":"スライド #859","title":"シーン 859","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_859_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.859.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女の発言に驚く。ミニテストがあるなんて聞いてなかったからだ。だが、彼女がある衝撃的な発言をする。","id":"8F3B9BAC-B815-4FCF-A556-55E0EC58D84D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.508253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.08814058956916,"slideTitle":"スライド #860","title":"シーン 860","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_860_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.860.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「藤原さん、あなたは今日、ミニテストの代わりに、体力測定を行いますから、このあとすぐに、萃香先生を訪ねるように。」","id":"A6F01FA2-EFEA-48CA-B617-F24CD516CF88","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":8.08814058956916},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.2582539682539684,"slideTitle":"スライド #861","title":"シーン 861","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_861_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.861.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「あっ…、はい…、分かりました…」僕はそう返す。","id":"11851478-55B8-482B-A6E5-0BF5F990CF88","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.2582539682539684},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.0212018140589567,"slideTitle":"スライド #862","title":"シーン 862","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_862_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.862.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「連絡は以上です。皆試験に励むように。」","id":"51C5576B-7750-49DF-A332-9CCF3A1B1ACD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":3.0212018140589567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.607165532879819,"slideTitle":"スライド #863","title":"シーン 863","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_863_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.863.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、去っていった。僕は、ぼんやりとしていると、突如として、先ほど言っていた人が入ってくる。","id":"94FA07CC-074C-4164-AFA2-1B345827FA8E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.607165532879819},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.5696598639455783,"slideTitle":"スライド #864","title":"シーン 864","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_864_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.864.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「藤原くん、ボケっとしてないで、\nさっさと私の後に着いてきなさい。」","id":"1F7389A8-CB93-45A4-8359-AF7808A39D17","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":3.5696598639455783},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.15281179138322,"slideTitle":"スライド #865","title":"シーン 865","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_865_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.865.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう彼女に言われ、後ろをついていくのだった。","id":"8092511D-73E9-4343-B9CA-EA6E3B0352B5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.15281179138322},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":3.7897732426303854,"slideTitle":"スライド #866","title":"シーン 866","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_866_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.866.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女についていくと、やってきたのは校庭だった。","id":"18E5F705-A043-4F57-AAE7-9A13F780E907","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.7897732426303854},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.9696598639455782,"slideTitle":"スライド #867","title":"シーン 867","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_867_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.867.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「準備体操済ませて、とりあえずグラウンドを3周しなさい。」","id":"537498DD-30BC-43A5-AB7A-6621D3A9F849","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":2.9696598639455782},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.593038548752834,"slideTitle":"スライド #868","title":"シーン 868","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_868_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.868.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました…」僕は、彼女の有無を言わさぬ態度に、ある一種の恐ろしさを感じながら、準備体操をして走る。","id":"3B1431F9-C82F-49F3-9A63-155D1C27931B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.593038548752834},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":3.4013151927437644,"slideTitle":"スライド #869","title":"シーン 869","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_869_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.869.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「次は、樽投げだ。この酒樽を思いきっり投げ飛ばしなさい。」","id":"E1F72165-8420-4C98-9837-62246C71E2C9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":3.4013151927437644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":3.8669387755102043,"slideTitle":"スライド #870","title":"シーン 870","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_870_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.870.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は彼女に言われるがままに、酒樽を一所懸命に投げる。","id":"D28DF37F-3C82-4F90-B742-25C2DBA20C96","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.8669387755102043},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.6779818594104308,"slideTitle":"スライド #871","title":"シーン 871","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_871_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.871.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「今度は、握力だ。酒樽を持ってみなさい。」","id":"73831E4B-FB4C-4920-9B19-BD5F35AF882A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":2.6779818594104308},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.569115646258504,"slideTitle":"スライド #872","title":"シーン 872","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_872_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.872.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、その酒樽を持つと、\n彼女はどこからともなく、酒樽をもう一つ取り出す。","id":"5DDE2D7A-8ECC-4612-BE85-4962BBD86ABE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.569115646258504},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.6546485260770973,"slideTitle":"スライド #873","title":"シーン 873","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_873_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.873.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「中の酒をこぼさぬように、酒樽を持ち替えなさい。」","id":"524FF0FF-BEC8-41EA-AA73-0508FD476743","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":2.6546485260770973},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":8.690861678004536,"slideTitle":"スライド #874","title":"シーン 874","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_874_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.874.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は彼女が新しい酒樽を地面にそっと置くと、すでに持っていた樽を地面に置き、新しい方を持つ。すると、力がかかる。","id":"E51223DE-F6BD-4DAB-ADA8-CE3E0E2C195F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.690861678004536},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.98,"slideTitle":"スライド #875","title":"シーン 875","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_875_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.875.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女は、もう一つ酒樽を置くと、それも持つようにいう。僕は、慎重に手を動かして、その樽を持つ。","id":"4F98322E-5F28-4C38-A503-122C6457A30A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.98},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.921292517006803,"slideTitle":"スライド #876","title":"シーン 876","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_876_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.876.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕は、握力がそこをつくまで、酒樽を何回も持たせられ、それが終わると、10分の休憩が挟まれた。","id":"7C8E115B-FE36-4495-A332-E1F36D600CDE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.921292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.862607709750567,"slideTitle":"スライド #877","title":"シーン 877","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_877_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.877.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それが終わると、彼女は、今度どこからか持ってきた\nメモリがついているマットを、地面に敷く。","id":"1F38546D-6D5D-4218-A202-B86015A9BCE2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.862607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.1346485260770973,"slideTitle":"スライド #878","title":"シーン 878","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_878_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.878.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「今敷いたこのマットに向かって飛んでみなさい。」","id":"CDF1B71C-C13C-4260-B3AD-0902E9948855","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":2.1346485260770973},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.560430839002268,"slideTitle":"スライド #879","title":"シーン 879","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_879_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.879.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そう言われると、マットに向かって飛ぶ、そして、飛び終えると同時に、文句を言われ、彼女が手本を見せる。","id":"C26CE2B2-6508-452D-BE54-3102D78A7B9C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.560430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.1179818594104307,"slideTitle":"スライド #880","title":"シーン 880","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_880_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.880.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「今私が見せたように、飛んでみなさい。」","id":"7E5C9877-DCDA-4D90-9AD9-C99B9AA4E0FB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":2.1179818594104307},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.073469387755102,"slideTitle":"スライド #881","title":"シーン 881","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_881_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.881.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、\n彼女が本当に人なのかを疑いながら、飛ぶ。","id":"EF11C3FF-827F-4DDA-9F1D-6835CFB86C19","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.073469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":8.132154195011339,"slideTitle":"スライド #882","title":"シーン 882","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_882_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.882.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それが終わると、彼女は、いきなり僕をマットの上に押し倒す。\nすると、彼女を僕の足元を押さえ込み、説明をする。","id":"1AF05B3F-EC09-4263-9DE1-141CE698323E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.132154195011339},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.817981859410431,"slideTitle":"スライド #883","title":"シーン 883","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_883_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.883.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「今から、時間を測るから、上体起こしをしなさい。」","id":"B0D88F8B-ED29-4DE9-A6E8-C38B4964D200","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":2.817981859410431},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":8.425646258503402,"slideTitle":"スライド #884","title":"シーン 884","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_884_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.884.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、すでに動けない状態でそう言われ、彼女が時間を測り始めると、残っている力を引き出しながら、言われた通りにする。","id":"6DB88DB5-A345-4460-8633-8DC41C57FA95","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.425646258503402},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.249546485260771,"slideTitle":"スライド #885","title":"シーン 885","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_885_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.885.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女は休憩だと言い、10分間の休憩が再び入る。\n彼女はその間に、マットを片す。","id":"57282568-85EF-417C-AD50-D323286CFF26","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.249546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":6.146326530612245,"slideTitle":"スライド #886","title":"シーン 886","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_886_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.886.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「次は、反復横跳びだ、そこに立って私が時間を測り始めたら、動き出しなさい。フライングはするんじゃないぞ。」","id":"318E3526-CF00-41EE-BD43-FD4B1BB0A63F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":6.146326530612245},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.10390022675737,"slideTitle":"スライド #887","title":"シーン 887","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_887_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.887.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、すでに息切れが起きていたが、なんとか深呼吸で落ち着かせると、彼女の合図に合わせて、動き出す。","id":"5D4ED09F-D01A-4BDB-97B2-4A74BD1970B3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.10390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.0029931972789115,"slideTitle":"スライド #888","title":"シーン 888","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_888_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.888.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「次は、制限時間内に、グラウンドを1周しなさい。\nそれが無事に終われば、昼休憩だ。」","id":"CB23EFAC-4807-40BC-8ED8-160174321E9D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":5.0029931972789115},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.064761904761904,"slideTitle":"スライド #889","title":"シーン 889","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_889_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.889.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…は…はい…」僕はなんとかそう返し、彼女が1分のタイマーをスタートさせると、僕は全力疾走する。","id":"24598B04-2010-4C08-A219-76D9072C9DE8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.064761904761904},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":4.951315192743764,"slideTitle":"スライド #890","title":"シーン 890","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_890_萃香.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.890.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_6D7E","characterName":"萃香","telop":"「それじゃあ、30分後にまた、ここにきなさい。\nそしたら、最後に1500m走だ。」","id":"1202CF1D-869A-4B5B-9689-2C0715804533","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"萃香","voiceDuration":4.951315192743764},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.804557823129252,"slideTitle":"スライド #891","title":"シーン 891","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_891_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.891.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、頭の中で鐘が鳴ったようなガーンという感覚を感じながら、ふと思い出す。「荷物、教室の中だ…」","id":"EC05799B-6A6C-40B5-A09E-EA4230F2E3FE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.804557823129252},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.75172335600907,"slideTitle":"スライド #892","title":"シーン 892","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_892_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.892.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"まだ、きっと校舎は試験中だから、入れない。それと、弁当を持ってきたかも忘れた。「お昼ご飯どうしよう…」","id":"117758F9-EF9E-4F35-B493-86D0B636387B","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.75172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.564761904761905,"slideTitle":"スライド #893","title":"シーン 893","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_893_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.893.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、誰かがこちらに駆け寄ってくる。","id":"F7D324D4-C8AC-41E4-9AD9-D235382F8B3B","seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.564761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":1.7470748299319727,"slideTitle":"スライド #894","title":"シーン 894","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_894_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.894.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「大丈夫ですか、何があったんですか？」","id":"24B1EC07-26BA-4045-A499-46AAAF7A7C50","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":1.7470748299319727},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.281065759637189,"slideTitle":"スライド #895","title":"シーン 895","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_895_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.895.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…」僕は、すでにまともな言葉を発せなくなっていた。\nそして、彼女が困っているところで、気を失った。","id":"8F48E2FB-AE2B-43C8-9811-A0E9E3A7B882","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.281065759637189},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #896","title":"シーン 896: 彼が再び目覚めると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.896.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼が再び目覚めると…","id":"BC5E1AEF-C1AE-4B2D-AC9B-1DBC7BF46FA2","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":7.033242630385487,"slideTitle":"スライド #897","title":"シーン 897","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_897_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.897.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ん…」僕は目が覚めると、そこはフランとの二人部屋だった。\nすると、フランが驚き、部屋を飛び出す。","id":"EC418E14-0BAC-4962-AD02-45BC2C313C96","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.033242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":2.1254875283446713,"slideTitle":"スライド #898","title":"シーン 898","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_898_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.898.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「あら、目が覚めたの、紅夢。」","id":"0617A570-DD3E-421E-B289-A0B2C68690A9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.1254875283446713},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":1.2169387755102041,"slideTitle":"スライド #899","title":"シーン 899","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_899_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.899.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「あの…僕は…」","id":"D5A9FF21-B7DC-46FC-98C2-DD288FD6F2D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.2169387755102041},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":2.606734693877551,"slideTitle":"スライド #900","title":"シーン 900","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_900_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.900.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「試験と体力テストなら無事に終わったわよ。」","id":"90A5EBC9-234A-4EF6-A55A-5B0D7D1AA5A9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.606734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":1.8810657596371883,"slideTitle":"スライド #901","title":"シーン 901","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_901_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.901.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…、なんでそのことを…？」","id":"A9E74DC2-F7FB-4F71-92D1-D7F90D3BB028","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.8810657596371883},{"voice2StartTimeOffset":1.9129931972789116,"telop":"「そんなの、決まってるじゃない。私は、あなたの母親がわりなんだから…」","seVolume":1,"characterName":"レミリア・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア（困り）.png","voiceDuration":1.9129931972789116,"voiceCharacter":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","animationName":"なし","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"slideTitle":"スライド #902","bgmVolume":0.65,"duration":4.367641723356009,"backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.902.jpeg","id":"DE8D3A1D-60CA-4453-B7C8-EA493140A8FB","voice2Character":"レミリア・スカーレット","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_902_レミリア・スカーレット_2.wav","bgmStartTimeOffset":0,"voice2Duration":2.4546485260770976,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_902_レミリア・スカーレット.wav","transitionName":"なし","title":"シーン 902"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":3.346984126984127,"slideTitle":"スライド #903","title":"シーン 903","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_903_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.903.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/小口開け赤面.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「私だって分かってるよ…紅夢くんのこと…」","id":"C05AC20C-2563-4972-B4C2-F56161FEA17A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.346984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":2.3858956916099774,"slideTitle":"スライド #904","title":"シーン 904","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_904_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.904.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「それで、学校には馴染めたかしら？」","id":"BD0D0B9C-71BF-4F59-9C2D-DAA0B83196D9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.3858956916099774},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":1.702562358276644,"slideTitle":"スライド #905","title":"シーン 905","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_905_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.905.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「ええ、少しずつですが…」","id":"2243998A-1963-4A95-B127-54FE19CEF460","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":1.702562358276644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":7.049909297052154,"slideTitle":"スライド #906","title":"シーン 906","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_906_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.906.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「そう、じゃあ、今夜はもう遅いから、そのまま寝なさい。」\n私は、そういうと、そのまま部屋を出ていった。","id":"527A58B4-1390-4D98-BA6E-BDF1D2714785","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.049909297052154},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":10.419478458049886,"slideTitle":"スライド #907","title":"シーン 907","ani