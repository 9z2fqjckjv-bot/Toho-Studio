"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妖夢（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_492_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、彼女にそう言われ、今朝のことを思い出す…","voiceCharacter":"操夢","duration":3.2952154195011336,"title":"シーン 492","slideTitle":"スライド #492","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.492.jpeg","voiceDuration":3.2952154195011336,"seVolume":1},{"id":"C1E87924-A99E-4498-9B7E-E0926F4908DB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_493_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「どうしたの、母さん、そんな顔して。」","voiceCharacter":"操夢","duration":2.7039002267573697,"title":"シーン 493","slideTitle":"スライド #493","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.493.jpeg","voiceDuration":2.7039002267573697,"seVolume":1},{"id":"A62BE35A-555B-4B5E-8EE3-7F60D0CA79E3","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_494_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」","voiceCharacter":"博麗霊夢","duration":8.843242630385488,"title":"シーン 494","slideTitle":"スライド #494","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.494.jpeg","voiceDuration":8.843242630385488,"seVolume":1},{"id":"B8AE4CE4-538C-497F-BAB1-0961A45C947F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_495_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」","voiceCharacter":"操夢","duration":8.095215419501134,"title":"シーン 495","slideTitle":"スライド #495","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.495.jpeg","voiceDuration":8.095215419501134,"seVolume":1},{"id":"13C97D01-29BA-44E8-B46F-A75B2476B3E1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/