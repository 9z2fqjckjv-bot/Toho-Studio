ac7\/元女子校の日常総集編_6ce7fe1ac7.197.jpeg","voiceDuration":3.840861678004535,"seVolume":1},{"id":"5F486FDB-3C3C-40DB-85D6-83885CF8EF26","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_198_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「えっと僕は…藤原紅夢です…」\n僕がそう言っていると、どこからか声がする。","voiceCharacter":"操夢","duration":5.360430839002268,"title":"シーン 198","slideTitle":"スライド #198","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.198.jpeg","voiceDuration":5.360430839002268,"seVolume":1},{"id":"A2E73C3F-2C90-42E3-996C-37130824391F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_199_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「ほら、そこの二人、ささっと準備体操済ませて、スタートラインに立ちなさい。もうすぐ始まりますから。」","voiceCharacter":"美鈴","duration":4.838616780045352,"title":"シーン 199","slideTitle":"スライド #199","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.199.jpeg","voiceDuration":4.838616780045352,"seVolume":1},{"id":"B0D7EA54-0780-47D1-8A7F-9939542344A9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_200_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕とこいしは、彼女にそう言われ、\n準備体操をすると、スタートラインに向かうのだった。","voiceCharacter":"操夢","duration":5.631065759637188,"title":"シーン 200","slideTitle":"スライド #200","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.200.jpeg","voiceDuration":5.631065759637188,"seVolume":1},{"id":"B9CFB1C1-793F-426D-862D-4E31C9C2C9E6","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"二人がスタートラインに立つと…","duration":1.5,"title":"シーン 201: 二人がスタートラインに立つと…","slideTitle":"スライド #201","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.201.jpeg","seVolume":1},{"id":"E5D27A44-8CF4-4284-8214-6878144859F0","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_202_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"それから、僕たちがスタートラインに立ってしばらくすると、さっきの放送で話していた人物から、内容が話された。","voiceCharacter":"操夢","duration":7.532154195011338,"title":"シーン 202","slideTitle":"スライド #202","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.202.jpeg","voiceDuration":7.532154195011338,"seVolume":1},{"id":"4C311374-7DF4-482B-AA57-BAB482E89A62","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_203_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"エンドレスランのルールは一言で言えば、その場に倒れるまで走り続ける、または歩き続ける無限長距離走らしい。","voiceCharacter":"操夢","duration":7.147369614512471,"title":"シーン 203","slideTitle":"スライド #203","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.203.jpeg","voiceDuration":7.147369614512471,"seVolume":1},{"id":"023ABC64-634B-43D9-A69D-F931086FFCAF","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_204_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は、病み上がりの体に負担がかからないか心配だった。\nすると、昨日僕が倒れるまで走らせた彼女が来る。","voiceCharacter":"操夢","duration":7.624557823129252,"title":"シーン 204","slideTitle":"スライド #204","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.204.jpeg","voiceDuration":7.624557823129252,"seVolume":1},{"id":"3B22CFC5-08FB-49DD-AB86-84E7235CB9D5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_205_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「藤原さんは初めてのエンドレスランで、こいしさんと同等程度の体力ですから、二人のペースを合わせて走りましょうか。」","voiceCharacter":"美鈴","duration":5.0882086167800455,"title":"シーン 205","slideTitle":"スライド #205","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.205.jpeg","voiceDuration":5.0882086167800455,"seVolume":1},{"id":"E93F8620-8E15-4214-BF90-0F06F6A6C97B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_206_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「お二人さんのペースは、きっと最後尾になりますから、私がお二人さんの後ろを走る形でサポートしましょう。」","voiceCharacter":"美鈴","duration":4.789183673469387,"title":"シーン 206","slideTitle":"スライド #206","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.206.jpeg","voiceDuration":4.789183673469387,"seVolume":1},{"id":"A67297A1-AD6C-48FD-AECA-99B5CB9E9EDA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_207_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「ですが、だからと言って気を抜いたり、だらけたら体を叩きますから、走る力が尽きても、歩いて前に進んでくださいね。」","voiceCharacter":"美鈴","duration":5.486439909297052,"title":"シーン 207","slideTitle":"スライド #207","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.207.jpeg","voiceDuration":5.486439909297052,"seVolume":1},{"id":"EABC82C5-8608-4F89-8BFA-CBDC6D6D6E69","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_208_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕はふと、彼女にそう言われ、こいしの方を見る。\n彼女は苦笑いを浮かべていた。","voiceCharacter":"操夢","duration":5.4865079365079366,"title":"シーン 208","slideTitle":"スライド #208","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.208.jpeg","voiceDuration":5.4865079365079366,"seVolume":1},{"id":"3485C620-650E-4D93-807B-F2B61CCA4D12","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_209_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"だが、僕たちを置き去りにするように、開始の合図である笛が鳴り響くと、ゾロゾロと女子の大群が動き、僕たちも動き始めた。","voiceCharacter":"操夢","duration":8.512607709750567,"title":"シーン 209","slideTitle":"スライド #209","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.209.jpeg","voiceDuration":8.512607709750567,"seVolume":1},{"id":"5F0F6C0A-0F2E-49FE-95AF-9F3D3CED7748","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_210_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"そして、僕たちが走り始めて、数分経つと、ぞろぞろと、前方の大群が校門を抜けて、複数の方向に分散していく。","voiceCharacter":"操夢","duration":8.725646258503401,"title":"シーン 210","slideTitle":"スライド #210","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.210.jpeg","voiceDuration":8.725646258503401,"seVolume":1},{"id":"090EC530-6690-4F30-B463-8E66A17C6CDD","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_211_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「校門をでたら、右に曲がって、進んでください。」","voiceCharacter":"美鈴","duration":2.3236281179138323,"title":"シーン 211","slideTitle":"スライド #211","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.211.jpeg","voiceDuration":2.3236281179138323,"seVolume":1},{"id":"36746109-7E39-4357-B0CD-EF7387825FF5","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_212_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"僕たちは、それから、1kmくらい走ると、住宅街に入り、その中を進んでいた。だが、こいしと僕は走り続けるのに限界が来る…","voiceCharacter":"操夢","duration":10.062607709750568,"title":"シーン 212","slideTitle":"スライド #212","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.212.jpeg","voiceDuration":10.062607709750568,"seVolume":1},{"id":"25D9CAD6-37F3-4774-A73C-FB95B48B4301","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/toho_ref_20261008_194930_440.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_213_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"僕がふと、隣を見ると、汗ばむ彼女の姿があった。ふと足を見ると、彼女も走り続けるのには限界が来ているようだった。","voiceCharacter":"操夢","duration":8.719115646258503,"title":"シーン 213","slideTitle":"スライド #213","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.213.jpeg","voiceDuration":8.719115646258503,"seVolume":1},{"id":"2B96FBAC-7A79-4D62-9474-B38601FF0867","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/目閉じ困る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_214_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"「走り続けるのが厳しいなら、歩いても構いませんから、止まってないで前にすすまないと、学校に戻るときには夜中ですよ。」","voiceCharacter":"美鈴","duration":5.505804988662131,"title":"シーン 214","slideTitle":"スライド #214","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.214.jpeg","voiceDuration":5.505804988662131,"seVolume":1},{"id":"ABF3DE0A-7353-46E9-B681-DF008ACEBC6B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_215_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"私がそういうと、二人は走るのを諦め、歩き始める。\n「また、走れるようになったら走ってもらいますからね。」","voiceCharacter":"美鈴","duration":5.043786848072562,"title":"シーン 215","slideTitle":"スライド #215","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.215.jpeg","voiceDuration":5.043786848072562,"seVolume":1},{"id":"1BFAB12E-9BF8-4A28-B040-4CD43CA1743A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_216_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"「わかってますよ…それくらい…」\n僕はそう言いながら、再び、こいしの方を見る。","voiceCharacter":"操夢","duration":5.390861678004535,"title":"シーン 216","slideTitle":"スライド #216","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.216.jpeg","voiceDuration":5.390861678004535,"seVolume":1},{"id":"55A21EAD-3A41-47B8-8AE5-E4716F08792F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/息を吐くこいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_217_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"彼女は、細かく息を吐きながら、歩き続ける。僕は、ふと僕の歩くペースと彼女のペースのずれに気づき、少し遅く歩く。","voiceCharacter":"操夢","duration":8.832154195011338,"title":"シーン 217","slideTitle":"スライド #217","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.217.jpeg","voiceDuration":8.832154195011338,"seVolume":1},{"id":"6B8D4B71-E365-4A45-943C-FCF294840E52","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/息を吐くこいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_218_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"僕も、彼女と同様に息を細かく吐いていたことに気づき、深く息をすると、早歩き寄りの速度で再び走り始める。","voiceCharacter":"操夢","duration":8.03,"title":"シーン 218","slideTitle":"スライド #218","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.218.jpeg","voiceDuration":8.03,"seVolume":1},{"id":"4AFD387C-E2D4-489E-B98E-C3BCE6305A89","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_219_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"私は、いきなり走り始めた彼に、待ってと言い、そのまま手を出す。すると、次の瞬間、彼と私の手が触れ合う。","voiceCharacter":"古明地こいし","duration":10.73312925170068,"title":"シーン 219","slideTitle":"スライド #219","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.219.jpeg","voiceDuration":10.73312925170068,"seVolume":1},{"id":"806746ED-9792-4BFE-9A73-33E1BF4F5822","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_220_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"僕はふと、手に何かが当たり、ふと視線をこいしに移すと、彼女が頰てっていた。「どうしたんですか、こいしさん？」","voiceCharacter":"操夢","duration":7.386507936507937,"title":"シーン 220","slideTitle":"スライド #220","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.220.jpeg","voiceDuration":7.386507936507937,"seVolume":1},{"id":"90E4E78A-BD95-4A4B-A859-AEEDA94101C2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り目閉じこいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_221_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"「いえ、なんでもありません、とりあえず、走りましょう。」\n私は、緊張して、そう口走り、走り始める。","voiceCharacter":"古明地こいし","duration":9.85469387755102,"title":"シーン 221","slideTitle":"スライド #221","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.221.jpeg","voiceDuration":9.85469387755102,"seVolume":1},{"id":"12E88341-55BD-49A2-8467-C3B6810247CB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り目閉じこいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_222_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc367698_住宅街２（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","telop":"「そうですか。」僕はそう返し、呼吸を整えながら、ペースを彼女に合わせてあげていく。するとペースが少し上がっていく。","voiceCharacter":"操夢","duration":8.316938775510204,"title":"シーン 222","slideTitle":"スライド #222","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.222.jpeg","voiceDuration":8.316938775510204,"seVolume":1},{"id":"52C74745-30C8-4CD2-BBD9-046E22171E40","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り目閉じこいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_223_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"僕たちはそれから、さらに1kmほど走ると、息が再び荒くなり、走りから歩きに変わってしまう。","voiceCharacter":"操夢","duration":7.069115646258504,"title":"シーン 223","slideTitle":"スライド #223","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.223.jpeg","voiceDuration":7.069115646258504,"seVolume":1},{"id":"9440F02A-2387-475E-BF8B-2C38269994AD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_224_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"私は、二人のペースがあまりにも遅いので、本当にこのペースで学校に戻れるのだろうかと、不安を感じてしまう。","voiceCharacter":"美鈴","duration":5.0272562358276645,"title":"シーン 224","slideTitle":"スライド #224","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.224.jpeg","voiceDuration":5.0272562358276645,"seVolume":1},{"id":"F369D1F3-CA77-4EC4-A4B8-C5E52A7EFFAF","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_225_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"私は、息をぜぇぜぇ吐きながら、歩いていると、足元にあるに何かにつまづいてしまう。「あっ！」","voiceCharacter":"古明地こいし","duration":8.271814058956917,"title":"シーン 225","slideTitle":"スライド #225","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.225.jpeg","voiceDuration":8.271814058956917,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ2.mp3","id":"5AC5BB0D-67D0-44CC-87AC-3337F5F982ED","seStartTimeOffset":0.3,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_226_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"僕は、彼女が地面に倒れ込みかけると、腕をだし、彼女を抱え込む。すると、彼女が驚き、僕も恥ずかしくなり、頬照っていく。","voiceCharacter":"操夢","duration":9.623469387755103,"title":"シーン 226","slideTitle":"スライド #226","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 衣擦れ2","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.226.jpeg","voiceDuration":9.623469387755103,"seVolume":0.85},{"id":"42D4B8D1-A0AB-4480-ADA8-F6982ED86A53","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_227_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"僕は、こいしをお姫様抱っこしたまま、後ろにいる彼女に目線を送る。「どうすればいいですか？」","voiceCharacter":"操夢","duration":6.275646258503401,"title":"シーン 227","slideTitle":"スライド #227","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.227.jpeg","voiceDuration":6.275646258503401,"seVolume":1},{"id":"032994E6-E317-4663-8328-6CD104D6C40D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/目閉じ困る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_228_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"「もし、あなたが彼女を抱いたまま、前に進めば、特別に、二人とも完走したことにしましょう、それでいいですか？」","voiceCharacter":"美鈴","duration":5.305963718820862,"title":"シーン 228","slideTitle":"スライド #228","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.228.jpeg","voiceDuration":5.305963718820862,"seVolume":1},{"id":"C77A96C3-052B-41CE-B5B1-3A4CB795FE3D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_229_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"私がそう、彼に抱き抱えられている彼女に視線を送る。すると、彼女は、目を閉じ、微かに頷いた。「早く進んでください。」","voiceCharacter":"美鈴","duration":6.21530612244898,"title":"シーン 229","slideTitle":"スライド #229","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.229.jpeg","voiceDuration":6.21530612244898,"seVolume":1},{"id":"FAC783DD-697A-43AB-AE1A-7CA396AD304C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恥ずかしい顔こいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_230_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc240173_住宅街（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","telop":"僕に抱っこされたこいしを見ると、恥ずかしいそうに身を丸くしていた。僕は、前を向き、再び走り始めた。","voiceCharacter":"操夢","duration":7.48,"title":"シーン 230","slideTitle":"スライド #230","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.230.jpeg","voiceDuration":7.48,"seVolume":1},{"id":"86C6F443-E4B3-4CD4-9894-C3EEC0B2AB97","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"そして、時間が過ぎていき…","duration":1.5,"title":"シーン 231: そして、時間が過ぎていき…","slideTitle":"スライド #231","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.231.jpeg","seVolume":1},{"id":"8C9660AC-6655-45E7-9288-F7A85CF5628A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_232_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-08_20-48.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-08_20-48.png","telop":"僕はふと目が覚めると、そこは学校の保健室だった。僕は、ゆっくりとベッドから降りると、隣に人が寝てることに気づく。","voiceCharacter":"操夢","duration":8.496303854875283,"title":"シーン 232","slideTitle":"スライド #232","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.232.jpeg","voiceDuration":8.496303854875283,"seVolume":1},{"id":"7CE976B9-9285-4786-8813-7A3C9B52C1B6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恥ずかしい顔こいし.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_233_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-08_20-48.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-08_20-48.png","telop":"彼女は、恥ずかしいそうな表情の状態で寝ていた。\n僕は、彼女を起こさないようにそっと保健室を出る。","voiceCharacter":"操夢","duration":7.064761904761904,"title":"シーン 233","slideTitle":"スライド #233","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.233.jpeg","voiceDuration":7.064761904761904,"seVolume":1},{"id":"38E70491-E6F8-46FE-91D9-2A59D1C5C342","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_234_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"そして、廊下に出ると、ふとお腹が空き、何かご飯はないかを考えながら、歩を進めていく。","voiceCharacter":"操夢","duration":6.384331065759637,"title":"シーン 234","slideTitle":"スライド #234","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.234.jpeg","voiceDuration":6.384331065759637,"seVolume":1},{"id":"2B526080-6924-4B22-AC86-C4B0CED4B0DF","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_235_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"すると、ふと誰かが向こうからやってくる。","voiceCharacter":"操夢","duration":2.569115646258503,"title":"シーン 235","slideTitle":"スライド #235","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.235.jpeg","voiceDuration":2.569115646258503,"seVolume":1},{"id":"01B63565-B124-4656-9195-C4BC4D0C719F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_236_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「こんばんは。」","voiceCharacter":"フランドール・スカーレット","duration":0.9694784580498866,"title":"シーン 236","slideTitle":"スライド #236","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.236.jpeg","voiceDuration":0.9694784580498866,"seVolume":1},{"id":"D5C5B3E4-7885-4052-A093-114119F55675","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_237_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「こんばんは…、あなたは…誰ですか…こんな夜中に、学校の式内を歩ける人なんてごくわずかのはずなんですけど…」","voiceCharacter":"操夢","duration":7.60390022675737,"title":"シーン 237","slideTitle":"スライド #237","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.237.jpeg","voiceDuration":7.60390022675737,"seVolume":1},{"id":"9455CFD9-5967-4B53-ABA6-E50EC75AAFF4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_238_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「私が、なんで夜中にこんな場所にいるか、知りたいの？」","voiceCharacter":"フランドール・スカーレット","duration":4.449478458049887,"title":"シーン 238","slideTitle":"スライド #238","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.238.jpeg","voiceDuration":4.449478458049887,"seVolume":1},{"id":"6EE3E535-DF79-4149-A145-66592F3E63D2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","transitionName":"なし","voiceAudio