"bgmStartTimeOffset":0,"duration":2.745215419501134,"slideTitle":"スライド #765","title":"シーン 765","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_765_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.765.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「さっきも、彼女にそう聞かれましたから。」","id":"1032016D-CA57-433F-AA19-7CAFAAC9992B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":2.745215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":4.009478458049887,"slideTitle":"スライド #766","title":"シーン 766","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_766_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.766.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「何、私たちは姉妹だけど、何が言いたいの？」","id":"223F587E-E29D-41AB-820C-D9C70286E589","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.009478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cac