ath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"私が咲夜を連れて、食堂に戻ると、そこではフランが驚きの表情をしていた。「フラン、キッチンから紅茶を出してちょうだい。」","voiceCharacter":"レミリア・スカーレット","duration":8.077573696145125,"title":"シーン 1076","slideTitle":"スライド #1076","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1076.jpeg","voiceDuration":8.077573696145125,"seVolume":1},{"id":"7B3DC218-2C18-46FE-A451-1C95CE84A012","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1077_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「わかった、今からとってくるね。」\n私はそう言うと、紅茶をとりにキッチンに向かった。","voiceCharacter":"フランドール・スカーレット","duration":6.794489795918367,"title":"シーン 1077","slideTitle":"スライド #1077","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1077.jpeg","voiceDuration":6.794489795918367,"seVolume":1},{"id":"DF579D63-B028-4E7D-8799-D72CAB469CA4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1078_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「それで、何があったの、咲夜？」","voiceCharacter":"レミリア・スカーレット","duration":2.369229024943311,"title":"シーン 1078","slideTitle":"スライド #1078","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1078.jpeg","voiceDuration":2.369229024943311,"seVolume":1},{"id":"55EAEA7A-8FB1-464B-A39D-04B0823DB8DB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1079_十六夜咲夜.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「実は…、深夜帯のテレビに、お嬢様が空を飛ぶ様子が、映ってまして…、それが今朝のニュースになっていたので…」","voiceCharacter":"十六夜咲夜","duration":6.352993197278912,"title":"シーン 1079","slideTitle":"スライド #1079","characterName":"十六夜咲夜","audioTrack":"track_voice_char_53C6","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1079.jpeg","voiceDuration":6.352993197278912,"seVolume":1},{"id":"DAB58E1D-2704-4C98-B7FF-666FB9ECBC59","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/Generated