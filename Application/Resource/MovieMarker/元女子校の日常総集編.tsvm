27-8F27-F408DEDA594A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.3809297052154195},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":6.159342403628118,"slideTitle":"スライド #1906","title":"シーン 1906","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1906_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1906.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「まぁまぁ…」僕は、曖昧にそう返す。\n実際のところ、楽しめたとは言い切れなかった。","id":"F6AAFEA6-1DCB-4E48-A98A-D3C6C2AD2553","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.159342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":0.6806575963718821,"slideTitle":"スライド #1907","title":"シーン 1907","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1907_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1907.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…」","id":"D8DC24EE-D7BD-4E6C-9537-BD06729CB5A3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.6806575963718821},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":7.110430839002268,"slideTitle":"スライド #1908","title":"シーン 1908","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1908_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1908.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それから観覧車に乗るまでの空気感が一気になくなり、ただ静けさと気まずさだけに包まれていた。","id":"57BDC21D-807A-492B-A85C-9C90C3E0B573","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.110430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":8.169115646258504,"slideTitle":"スライド #1909","title":"シーン 1909","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1909_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1909.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そのまま、観覧車が進み、ちょうど真上にくると、観覧車の動きが突如止まる。僕は、ふと気になって立とうとする。","id":"FB1332A6-5053-462C-8991-209FA4163B76","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.169115646258504},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":7.740861678004535,"slideTitle":"スライド #1910","title":"シーン 1910","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1910_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1910.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、立とうとした習慣に大きな揺れがきて、僕は思わず、前のめりに倒れ、フランと間に手をつくように倒れ込む。","id":"4A456D6B-ADA9-41E5-A9A0-B3739B5F29C1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.740861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":6.5843310657596374,"slideTitle":"スライド #1911","title":"シーン 1911","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1911_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1911.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、はっと気がつくと、元の位置に戻る。\nすると、二人は頬照った状態で固まっていた。","id":"8015E97E-F91E-40E6-9F21-5EAB2B60DD98","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.5843310657596374},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":7.743038548752835,"slideTitle":"スライド #1912","title":"シーン 1912","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1912_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1912.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、戸惑っていると、嫌な予感が走り、反射的にフランとこいしの間に座り込むと、二人の手をぎゅっと掴む。","id":"08C2F8FD-F11A-4E12-AC4B-B1C7F792DFFB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.743038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":5.643038548752834,"slideTitle":"スライド #1913","title":"シーン 1913","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1913_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1913.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると案の定、観覧車の扉が開き、\n明らかに様子がおかしいさとりが入ってきた。","id":"B265C3C8-D4AC-4B7B-8C1C-4882EB753F8E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.643038548752834},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":1.9234693877551021,"slideTitle":"スライド #1914","title":"シーン 1914","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1914_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1914.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「一体、何の用ですか？」","id":"19668418-FA99-47DC-A9B9-455539AA1ABD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.9234693877551021},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":2.1779818594104308,"slideTitle":"スライド #1915","title":"シーン 1915","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1915_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1915.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そんなこと、決まっているではありませんか。」","id":"401F055C-2130-481F-82C8-5A2E77B5692B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.1779818594104308},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":5.534331065759638,"slideTitle":"スライド #1916","title":"シーン 1916","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1916_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1916.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言いながら、こいしに視線を当てる。\n僕は、その隙に彼女を蹴り上げる。","id":"877DD164-767B-4BFF-B329-01A269A26EE3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.534331065759638},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":8.400634920634921,"slideTitle":"スライド #1917","title":"シーン 1917","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1917_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1917.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、彼女は僕が蹴り上げた足を、強く蹴り返す。\nすると、僕の全身に強い衝撃が入り、気を失ってしまった。","id":"E94AE695-ED83-40C6-B0B2-63E2C3EEE484","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.400634920634921},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":2.589591836734694,"slideTitle":"スライド #1918","title":"シーン 1918","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1918_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1918.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「ほら、こいし、私と一緒に家に戻りましょ。」","id":"0020CB99-BD51-4665-8DEB-40E8519F5829","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.589591836734694},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":7.953900226757369,"slideTitle":"スライド #1919","title":"シーン 1919","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1919_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1919.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"私は、ハッとして気がつくと、目の前には怖気付く少女と黒い笑みを浮かべる彼女がいた。そして、状況を察する。","id":"9DF5E2BF-FB3B-4604-9DA3-A8FF251CD635","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":7.953900226757369},{"voice2StartTimeOffset":4.406077097505669,"telop":"そして、彼女が少女を手で掴みかけると、私はその手を叩く。\nすると、彼女の動作が止まり、表情が変わる。","seVolume":1,"characterName":"サブ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり微笑2.png","voiceDuration":4.406077097505669,"voiceCharacter":"サブ","audioTrack":"track_voice_char_CC3E","animationName":"なし","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"slideTitle":"スライド #1920","bgmVolume":0.65,"duration":7.662154195011338,"backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1920.jpeg","id":"4FB4A323-59B3-4850-85BF-698840119493","voice2Character":"サブ","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1920_サブ_2.wav","bgmStartTimeOffset":0,"voice2Duration":3.2560770975056688,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1920_サブ.wav","transitionName":"なし","title":"シーン 1920"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":6.527777777777778,"slideTitle":"スライド #1921","title":"シーン 1921","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1921_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1921.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「おや、手出しをしなければ、私は黙っていたんですがね…、仕方ありません。今日のところは引き上げましょう。では失礼。」","id":"115D6929-0D98-4583-BF24-62663804D92F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.527777777777778},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":5.254988662131519,"slideTitle":"スライド #1922","title":"シーン 1922","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1922_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1922.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ涙あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"彼女がそう言って、立ち去ると、\n席の片隅で固まっていた彼女が話し出す。","id":"6225EAE7-EBBB-4497-93B7-5F39422DA281","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":5.254988662131519},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":5.079478458049887,"slideTitle":"スライド #1923","title":"シーン 1923","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1923_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1923.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ涙あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ごめんなさい…、私…、彼女に心が読まれて、抑止された…」","id":"B46784F7-11D2-41FC-8897-D030C9155745","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.079478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230674_観覧車の中（夕方）.jpg","bgmStartTimeOffset":0,"duration":3.6539002267573695,"slideTitle":"スライド #1924","title":"シーン 1924","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1924_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1924.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ涙あわわ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"彼女がそう言っていると、観覧車が再び動き始めた。","id":"E5C3177A-F814-4E8E-B62D-2D210928521B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":3.6539002267573695},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1925","title":"シーン 1925: 黒いさとり（何者かに乗っ取られた状態）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1925.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影ありニヤケ顔.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"黒いさとり（何者かに乗っ取られた状態）","id":"2CFFF3CA-6B64-48FB-BC9C-6B19250A194F","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.065419501133787,"slideTitle":"スライド #1926","title":"シーン 1926","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1926_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1926.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"あれから、私たちはフランの家に戻ってくると、夕方の出来事とその出来事から推測できる事象をレミリアに伝えていた。","id":"DACEE4D9-0ADD-48FF-ADCA-6E5C5DA98262","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.065419501133787},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.521315192743764,"slideTitle":"スライド #1927","title":"シーン 1927","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1927_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1927.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「これは、私の責任よ。私が外出を許可したばかりに…。にしても、厄介ね…、グループ内の派閥争いっていうものは…。」","id":"8488D1B6-3B32-4E6F-8285-D77E72864F75","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.521315192743764},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.169115646258504,"slideTitle":"スライド #1928","title":"シーン 1928","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1928_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1928.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「とりあえず、彼女は再び、こいしの元に現れると言ってましたから、しばらくの間は、誰か護衛をつけた方がいいですよ。」","id":"20A057C2-76B0-4EEE-B6D7-DD55FD658200","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.169115646258504},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":4.987414965986394,"slideTitle":"スライド #1929","title":"シーン 1929","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1929_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1929.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「ごめんなさいね…、あなたに頼るつもりはなかったけど、\nこんなことになってしまって…。」","id":"4854C975-D1E9-4750-BE4F-C170573EBAD0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.987414965986394},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":7.022380952380952,"slideTitle":"スライド #1930","title":"シーン 1930","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1930_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1930.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「きっと次来る時も、向こうはあなたたちが吸血鬼であることを逆手にとって、逆らえないようにしてきますよ。」","id":"5C71FDF3-31BC-4299-9684-404461CD90DC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":7.022380952380952},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.142154195011338,"slideTitle":"スライド #1931","title":"シーン 1931","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1931_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1931.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「確かに、でもあなたは大丈夫なの？文脈から察するに、あなたの存在に関する情報が、向こうに流れるみたいだけど？」","id":"212EB5AE-FAD4-431B-A165-E078A685F899","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.142154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.382154195011339,"slideTitle":"スライド #1932","title":"シーン 1932","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1932_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1932.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「それは…、別に構いませんよ。ただ、彼女に従えば、吸血鬼という情報が流れ出さないなんていう保証はありませんよ。」","id":"280B8279-7B63-4F6C-9AA2-2C6903876900","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.382154195011339},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":6.358253968253968,"slideTitle":"スライド #1933","title":"シーン 1933","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1933_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1933.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「その上で、この派閥争いを鎮めて、\n次のステップに踏むべきだと、私は感じますがね…。」","id":"19936000-7999-42B0-831F-B9E517A82310","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":6.358253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":4.183832199546485,"slideTitle":"スライド #1934","title":"シーン 1934","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1934_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1934.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「確かにあなたのいうとおりね…。\nとりあえず、夕飯にしましょうか。」","id":"09DFBDB9-6A62-4C88-962F-F4CC76EE75A6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.183832199546485},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":9.059342403628118,"slideTitle":"スライド #1935","title":"シーン 1935","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1935_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1935.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"彼女はそう言い、部屋をさると、私も出る。そして、食事が終わると霊の如く、全身に衝撃が入り、彼が出てくるのだった。","id":"8AA626CD-6653-4E0A-8D3B-BE55B60F41B9","seVolume":1,"voiceCharacter":"サブ","voiceDuration":9.059342403628118},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1936","title":"シーン 1936: ？（霊夢の母に霖之助と呼ばれていた。そし…）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1936.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/黒影.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"？（霊夢の母に霖之助と呼ばれていた。そし…）","id":"B34112DB-C3ED-4B9C-BCAD-705AC31EBAEF","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.085419501133787,"slideTitle":"スライド #1937","title":"シーン 1937","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1937_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1937.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ驚き.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はふと気がつくと、そこは食堂だった。すると、こいしが驚いた様子で僕を見る。「どうしたんですか、こいしさん？」","id":"E41BE709-AE5C-4E35-A331-AB955447D6C6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.085419501133787},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":1.1386848072562359,"slideTitle":"スライド #1938","title":"シーン 1938","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1938_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1938.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「何でもないよ。」","id":"274121C6-CB60-4083-80E8-BC9D69C85876","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.1386848072562359},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":7.783242630385487,"slideTitle":"スライド #1939","title":"シーン 1939","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1939_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1939.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…」僕はそう呟くと、既に空になっている食器を片付け、歯を磨くと、そのまま二人部屋に向かった。","id":"F54D28EF-D766-4B11-9852-903C5E62DADA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.783242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":3.3082539682539682,"slideTitle":"スライド #1940","title":"シーン 1940","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1940_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1940.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が二人部屋に来ると、こいしがあることを聞いてくる。","id":"B89D239F-5A56-422C-9516-A26D40FA9783","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.3082539682539682},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":3.973469387755102,"slideTitle":"スライド #1941","title":"シーン 1941","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1941_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1941.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ、紅夢くんは誰か、好きな人はいるの？」","id":"1B88C98F-541A-4958-9BD6-B3AD67013E8B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.973469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":9.190861678004536,"slideTitle":"スライド #1942","title":"シーン 1942","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1942_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1942.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ？」僕は、思わずそう返す。だが、しばらく考えてからいう。「この部屋は、元々フランと僕の二人部屋だったんですよ。」","id":"3841B34B-FCFE-4051-93E7-2FC868110060","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.190861678004536},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":5.847369614512472,"slideTitle":"スライド #1943","title":"シーン 1943","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1943_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1943.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそういうと、彼女の頬が頰照る。\n「僕は、単純にただ事実を述べただけですけど…。」","id":"EBB359A2-2DFA-46A5-9224-D5ECA9E588E8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.847369614512472},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":1.8988888888888888,"slideTitle":"スライド #1944","title":"シーン 1944","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1944_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1944.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「あなた、馬鹿なの？」","id":"C3280C38-62C4-4E4C-8441-CA4754DBFF25","seStartTimeOffset":0,"