\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1418.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私は、これが食べたいな。」","id":"0336199C-BE97-430F-A88D-1D4B5C5BF3E8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.556349206349206},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":8.128458049886621,"slideTitle":"スライド #1419","title":"シーン 1419","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1419_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1419.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言って、あるメニューを指差す。それは、アグー豚100%のハンバークにご飯とドリンクバーがついたセットだった。","id":"1BDD5791-B69E-4E02-A048-79F65F091008","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.128458049886621},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":3.8712925170068027,"slideTitle":"スライド #1420","title":"シーン 1420","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1420_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideI