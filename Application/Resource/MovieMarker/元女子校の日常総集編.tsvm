t":0,"duration":6.328911564625851,"slideTitle":"スライド #97","title":"シーン 97","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_097_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.097.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そう彼女に言われ、ささっと荷物を片すと、\n彼女が着いてきてと言うので、着いていった。","id":"0B5AE1BC-E5AF-49A6-96D9-AE4BC9751237","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.328911564625851},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.058253968253968,"slideTitle":"スライド #98","title":"シーン 98","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.098.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると彼女は、校庭に出てくる。\n「あの僕は…何をこれからするんですか…」","id":"DE142266-5BCE-4F0D-930F-C4A725528830","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.058253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extrac