Name":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1422.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「こいしの態度が一変した理由が、分かったわ…」\n私はそう言いながら、あの感情の波が少しだけ理解できた。","id":"7725A152-59A0-42B0-B288-0BC9577B4542","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.716984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":2.7009523809523808,"slideTitle":"スライド #1423","title":"シーン 1423","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1423_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1423.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（怒り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私も分かったわ…」私はさとり続けてそういう。","id":"8D8E186C-7E84-47D1-9159-9842551EB864","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.7009523809523808},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":8.222380952380952,"slideTitle":"スライド #1424","title":"シーン 1424","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1424_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1424.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、何かをぶつぶついう二人を置いて、最初の注文をする。頼んだのは、ハンバークセットと鉄火丼定食だった。","id":"C8E7C5A6-FECB-47C8-9268-AD119C5E85BA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.222380952380952},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":7.999546485260771,"slideTitle":"スライド #1425","title":"シーン 1425","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1425_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1425.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕とこいしはそのまま、ドリンクバーに向った。\nすると、二人は後から気づき、慌てて注文をするのだった。","id":"2BC09666-5E70-467F-809D-0F17858CC83A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.999546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":7.249546485260771,"slideTitle":"スライド #1426","title":"シーン 1426","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1426_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1426.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、ファミレスに着くと、各自が食べたい料理を注文し、順に順に運ばれてきた料理を食べ進めていた。","id":"F0AEB92F-C3BC-4112-AEF9-2C970EEECB2B","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.249546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":3.6147619047619046,"slideTitle":"スライド #1427","title":"シーン 1427","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1427_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レストラン2.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1427.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ねぇ」.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、料理を食べきったこいしが、あることを聞いてくる。","id":"89BA84E0-D52D-4986-A521-22A2A575DFB0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.6147619047619046},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","bgmStartTimeOffset":0,"duration":2.2441950113378684,"slideTitle":"スライド #1428","title":"シーン 1428","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1428_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc307609_レスト