audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1033.jpeg","voiceDuration":2.4544897959183674,"seVolume":1},{"id":"91FCA1F7-7374-4500-B1B7-F3B2B04703CA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/にやけ顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1034_藤原妹紅.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","telop":"二人は、何かの確認をすると、いきなり私の服を掴んでくる。\nそして、まんまと服を脱がされると、二人も服を脱ぐ。","voiceCharacter":"藤原妹紅","duration":8.04748299319728,"title":"シーン 1034","slideTitle":"スライド #1034","characterName":"藤原妹紅","audioTrack":"track_voice_char_DF97","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1034.jpeg","voiceDuration":8.04748299319728,"seVolume":1},{"id":"CD4349CD-406A-48A3-8ADC-613A4BF03642","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1035_藤原妹紅.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","telop":"そして、霊夢が私のベッドで、上を向いたまま横になると、魔理沙が私の手を引っ張り、霊夢、魔理沙、私の順で重なる。","voiceCharacter":"藤原妹紅","duration":8.407913832199547,"title":"シーン 1035","slideTitle":"スライド #1035","characterName":"藤原妹紅","audioTrack":"track_voice_char_DF97","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1035.jpeg","voiceDuration":8.407913832199547,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ちゃんちゃん♪1.mp3","id":"13EC1E34-1CDD-4685-B025-406B9424DB93","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1036_藤原妹紅.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","telop":"そして、私は、魔理沙にアレを根こそぎ取られるのだった。","voiceCharacter":"藤原妹紅","duration":3.527687074829932,"title":"シーン 1036","slideTitle":"スライド #1036","characterName":"藤原妹紅","audioTrack":"track_voice_char_DF97","bgmVolume":0.7,"seName":"SE: ちゃんちゃん♪1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1036.jpeg","voiceDuration":3.527687074829932,"seVolume":1},{"id":"5ACBD1FD-4135-4A5A-AC3D-70108147C01F","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1037_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"私は、二人がいるキャンプ場に来ると、森の中に入る。","voiceCharacter":"レミリア・スカーレット","duration":3.733832199546485,"title":"シーン 1037","slideTitle":"スライド #1037","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1037.jpeg","voiceDuration":3.733832199546485,"seVolume":1},{"id":"495B9991-68F9-4175-BF00-4E0470922AE3","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1038_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"そして、私は、森の中にいるはずの二人を探し回る。","voiceCharacter":"レミリア・スカーレット","duration":3.7588208616780046,"title":"シーン 1038","slideTitle":"スライド #1038","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1038.jpeg","voiceDuration":3.7588208616780046,"seVolume":1},{"id":"A0AC717C-57A9-4A75-A97B-5CEB053B7D2B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1039_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"すると、二人が重なって倒れているのを発見する。\n「見ーつけた。」私はそう言うと、二人に襲いかかる。","voiceCharacter":"レミリア・スカーレット","duration":7.035895691609977,"title":"シーン 1039","slideTitle":"スライド #1039","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1039.jpeg","voiceDuration":7.035895691609977,"seVolume":1},{"id":"90DCAA59-D8AD-4327-B344-8F2FC9