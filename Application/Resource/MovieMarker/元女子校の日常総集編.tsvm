,"seStartTimeOffset":0.3,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_247_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"私は、彼女が豹変していくのがわかると、\nその間の隙をつき、彼女の首に、腕を勢いよくぶつける。","voiceCharacter":"サブ","duration":7.245215419501133,"title":"シーン 247","slideTitle":"スライド #247","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"seName":"SE: 打撃1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.247.jpeg","voiceDuration":7.245215419501133,"seVolume":0.85},{"id":"12578F2A-079A-4FC9-9101-A1A9C4117DA9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア（弱る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_248_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「私の妹が、あなたにご迷惑かけたようで申し訳ありません。」\n私は、そう彼女に返す。","voiceCharacter":"レミリア・スカーレット","duration":6.465079365079365,"title":"シーン 248","slideTitle":"スライド #248","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.248.jpeg","voiceDuration":6.465079365079365,"seVolume":1},{"id":"768DA34D-F2E8-4F15-919E-F3701F20AAEC","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア（弱る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_249_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「いえいえ、迷惑ではありませんよ、彼女が暴走する前に、食い止めることができましたから。それで、あなたたちの名前は…」","voiceCharacter":"サブ","duration":8.351723356009071,"title":"シーン 249","slideTitle":"スライド #249","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.249.jpeg","voiceDuration":8.351723356009071,"seVolume":1},{"id":"85C4BF79-11CE-4705-8390-480737752290","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_250_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485835_学校の廊下（夜・照明OFF）.jpg","telop":"「私の名前は、レミリア・スカーレット、その妹の名前はフランドール・スカーレットと言います。」","voiceCharacter":"レミリア・スカーレット","duration":5.658231292517007,"title":"シーン 250","slideTitle":"スライド #250","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/reposit