meOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「何か、言いたいことでもあるのですか？」","voiceCharacter":"操夢","duration":2.5930385487528347,"title":"シーン 120","slideTitle":"スライド #120","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.120.jpeg","voiceDuration":2.5930385487528347,"seVolume":1},{"id":"16103223-365A-4593-BBF8-77291EF14B98","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_121_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","voiceCharacter":"霧雨魔理沙","duration":5.118231292517007,"title":"シーン 121","slideTitle":"スライド #121","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.121.jpeg","voiceDuration":5.118231292517007,"seVolume":1},{"id":"5C94EA2F-87D1-46B9-B572-5354592CACEC","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_122_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","voiceCharacter":"操夢","duration":6.027823129251701,"title":"シーン 122","slideTitle":"スライド #122","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.122.jpeg","voiceDuration":6.027823129251701,"seVolume":1},{"id":"E67140B9-DEA9-4A6B-81DE-E77EDA321579","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_123_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","voiceCharacter":"霧雨魔理沙","duration":7.018231292517007,"title":"シーン 123","slideTitle":"スライド #123","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.123.jpeg","voiceDuration":7.018231292517007,"seVolume":1},{"id":"5EA95824-C89A-4013-937C-6B7452B4A317","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_124_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","voiceCharacter":"操夢","duration":5.20498866213152,"title":"シーン 124","slideTitle":"スライド #124","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.124.jpeg","voiceDuration":5.20498866213152,"seVolume":1},{"id":"A91D3B73-E965-4551-A53E-19EDD4F2C368","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_125_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","voiceCharacter":"操夢","duration":3.490861678004535,"title":"シーン 125","slideTitle":"スライド #125","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.125.jpeg","voiceDuration":3.490861678004535,"seVolume":1},{"id":"880551B9-41F6-42F4-ACA4-C619BE2CA543","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_126_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","voiceCharacter":"博麗霊夢","duration":6.755736961451247,"title":"シーン 126","slideTitle":"スライド #126","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.126.jpeg","voiceDuration":6.755736961451247,"seVolume":1},{"id":"EAC17005-47BB-49FB-880A-7C11CD2F6FF0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_127_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","voiceCharacter":"操夢","duration":6.414761904761905,"title":"シーン 127","slideTitle":"スライド #127","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.127.jpeg","voiceDuration":6.414761904761905,"seVolume":1},{"id":"D3AD664D-B318-41E2-BAC9-029BF6EE6666","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_128_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「それに…最近…魔理沙の様子が変なのよね…」","voiceCharacter":"博麗霊夢","duration":3.9094784580498865,"title":"シーン 128","slideTitle":"スライド #128","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.128.jpeg","voiceDuration":3.9094784580498865,"seVolume":1},{"id":"A357F801-32C5-4E90-A9D6-4D98CE8A8178","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_129_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","voiceCharacter":"操夢","duration":6.35172335600907,"title":"シーン 129","slideTitle":"スライド #129","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.129.jpeg","voiceDuration":6.35172335600907,"seVolume":1},{"id":"B9D5D29C-ADE5-40EF-AC84-FAA1BF1F403A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_130_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","voiceCharacter":"博麗霊夢","duration":10.184489795918367,"title":"シーン 130","slideTitle":"スライド #130","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.130.jpeg","voiceDuration":10.184489795918367,"seVolume":1},{"id":"8105D15B-D3B2-475E-8AEA-8FD8BB917F32","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_131_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","voiceCharacter":"操夢","duration":6.690861678004535,"title":"シーン 131","slideTitle":"スライド #131","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.131.jpeg","voiceDuration":6.690861678004535,"seVolume":1},{"id":"581B2B43-14BE-4D9A-A751-4AA28C55FA14","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_132_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256897_病室-夕方-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","voiceCharacter":"操夢","duration":4.321292517006802,"title":"シーン 132","slideTitle":"スライド #132","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.132.jpeg","voiceDuration":4.321292517006802,"seVolume":1},{"id":"7A1862A7-F2D7-4C0C-B58B-2FEF5CD30908","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"附属病院のある診察室では…","duration":1.5,"title":"シーン 133: 附属病院のある診察室では…","slideTitle":"スライド #133","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.133.jpeg","seVolume":1},{"id":"B3A40D6F-7FA3-4949-9D98-33F48992238C","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_134_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","voiceCharacter":"八意永琳","duration":5.903537414965986,"title":"シーン 134","slideTitle":"スライド #134","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.134.jpeg","voiceDuration":5.903537414965986,"seVolume":1},{"id":"B1FFAEB4-6F81-4861-A53B-D551A003340A","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_135_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","voiceCharacter":"八意永琳","duration":10.509183673469387,"title":"シーン 135","slideTitle":"スライド #135","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.135.jpeg","voiceDuration":10.509183673469387,"seVolume":1},{"id":"832AFB24-C2A6-469B-B7DD-2CE845B7204D","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_136_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","voiceCharacter":"八意永琳","duration":8.210839002267575,"title":"シーン 136","slideTitle":"スライド #136","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.136.jpeg","voiceDuration":8.210839002267575,"seVolume":1},{"id":"AA5C0873-E53B-4BAB-898C-58066995EC69","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_137_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","voiceCharacter":"八意永琳","duration":9.902108843537414,"title":"シーン 137","slideTitle":"スライド #137","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.137.jpeg","voiceDuration":9.902108843537414,"seVolume":1},{"id":"EB633CAA-A5D7-49F5-9DBD-1645B2E098A0","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_138_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","voiceCharacter":"八意永琳","duration":9.371814058956916,"title":"シーン 138","slideTitle":"スライド #138","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.138.jpeg","voiceDuration":9.371814058956916,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","id":"06280859-9E27-4656-BE77-D43165C8A010","seStartTimeOffset":0.3,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_139_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","voiceCharacter":"八意永琳","duration":8.214489795918368,"title":"シーン 139","slideTitle":"スライド #139","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"seName":"SE: 木のドアをノック1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.139.jpeg","voiceDuration":8.214489795918368,"seVolume":0.85},{"id":"B74E0A7D-F945-482A-816A-28AD4E9637AE","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_140_射命丸文.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。","voiceCharacter":"射命丸文","duration":7.111587301587302,"title":"シーン 140","slideTitle":"スライド #140","characterName":"射命丸文","audioTrack":"track_voice_char_EF7A","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.140.jpeg","voiceDuration":7.111587301587302,"seVolume":1},{"id":"535B6AC3-ABDB-483D-800C-2B35A4B3D848","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_141_射命丸文.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」","voiceCharacter":"射命丸文","duration":8.62358276643991,"title":"シーン 141","slideTitle":"スライド #141","characterName":"射命丸文","audioTrack":"track_voice_char_EF7A","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.141.jpeg","voiceDuration":8.62358276643991,"seVolume":1},{"id":"90FAD8AD-1BC0-4868-9770-6BDEF4C50AF5","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_142_射命丸文.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」","voiceCharacter":"射命丸文","duration":7.600181405895691,"title":"シーン 142","slideTitle":"スライド #142","characterName":"射命丸文","audioTrack":"track_voice_char_EF7A","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.142.jpeg","voiceDuration":7.600181405895691,"seVolume":1},{"id":"A779C864-8653-479A-B1E4-D0966A62F84F","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_143_射命丸文.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"「それと、息子さんの言ってたことは全て事実だそうですよ。」","voiceCharacter":"射命丸文","duration":3.6015873015873017,"title":"シーン 143","slideTitle":"スライド #143","characterName":"射命丸文","audioTrack":"track_voice_char_EF7A","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.143.jpeg","voiceDuration":3.6015873015873017,"seVolume":1},{"id":"5011836F-9EC6-4022-AC11-D4895D6EE1C8","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName