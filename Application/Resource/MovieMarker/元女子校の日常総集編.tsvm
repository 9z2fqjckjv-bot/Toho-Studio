imeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.20281179138322},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":4.437777777777778,"slideTitle":"スライド #1269","title":"シーン 1269","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1269_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1269.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あっ…ありがとう…」\n私は、そう辿々しく言うと、彼からポケベルを受け取った。","id":"FFA4FC4E-92ED-4142-A6BB-70A0866CF4D3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":4.437777777777778},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1270","title":"シーン 1270: 一方、学校では…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1270.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"一方、学校では…","id":"C9E53D94-08FF-462D-AE93-0714A59D9989","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":8.525714285714285,"slideTitle":"スライド #1271","title":"シーン 1271","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1271_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1271.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"美鈴が部屋を去った後、私がしばらくその書類を眺めていると、ふと彼の考えが伝わってくる。「なるほど、そう言うことか。」","id":"F77A757D-9EC5-43AE-BF85-60D74E8EE891","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.525714285714285},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.7521768707483,"slideTitle":"スライド #1272","title":"シーン 1272","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1272_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1272.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"すると、再び部屋の扉がノックされる。\n「いいぞ、入ってきなさい。」","id":"77601FD2-4B1E-4A7C-9949-F45F530F1828","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.7521768707483},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":5.585238095238095,"slideTitle":"スライド #1273","title":"シーン 1273","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1273_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1273.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「学園長…、その手元の書類の控えとデビットカードを送ったのは、あなたって本当なのですか？総理大臣からの認可は？」","id":"4DB95CB8-887A-4602-993E-F9A89064BB5E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.585238095238095},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.460204081632653,"slideTitle":"スライド #1274","title":"シーン 1274","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1274_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1274.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ光なし目慌てる.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「えっと、それはだな…」私は、彼女の指摘に言葉が詰まる。","id":"CC64213F-A5CC-41A5-8698-BE6CEC96DA29","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.460204081632653},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":2.729342403628118,"slideTitle":"スライド #1275","title":"シーン 1275","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1275_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1275.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「まさか…、認可も取らずに、独断で実行されたんですか…？」","id":"09A4BEAF-D892-4058-B740-27318E658F2C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":2.729342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.095918367346939,"slideTitle":"スライド #1276","title":"シーン 1276","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1276_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1276.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ光なし目慌てる.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「うぐっ。」私は、彼女の言う通りで何も言えなくなる。","id":"051ABE13-2CBA-4F70-9757-D92EB5CB4D1B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.095918367346939},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":5.458934240362812,"slideTitle":"スライド #1277","title":"シーン 1277","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1277_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1277.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/目閉じ困る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「万が一の時には学園長の責任ですからね…、まったく…。ここ最近の学園長は彼に、固執しすぎじゃないですか…？」","id":"F181E8F4-FC45-4B56-B67F-B165E3D6DB73","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.458934240362812},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":2.8093650793650795,"slideTitle":"スライド #1278","title":"シーン 1278","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1278_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1278.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ弱る.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「確かに、お前の言うとおりかも知れないな…。」","id":"5AE2371F-4790-4CBB-B10E-4644FD3D70B7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":2.8093650793650795},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.128639455782313,"slideTitle":"スライド #1279","title":"シーン 1279","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1279_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1279.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ決心.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「だが、彼に固執するのには、理由があるんだよ、美鈴。」","id":"2A00CFC4-7603-4076-8C95-55FAF2F2FDC1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.128639455782313},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":1.3261224489795918,"slideTitle":"スライド #1280","title":"シーン 1280","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1280_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1280.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「いったい、どんな理由ですか？」","id":"32CB6844-B8F6-424A-A960-AFC666E7B8F6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":1.3261224489795918},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.518208616780045,"slideTitle":"スライド #1281","title":"シーン 1281","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1281_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1281.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「その理由は、今度教えるから。この話は、ここでやめだ。」","id":"E0B21DB9-9C27-4182-82BD-9D6E588C8282","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.518208616780045},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":3.4027210884353742,"slideTitle":"スライド #1282","title":"シーン 1282","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1282_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1282.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「そうですか…、それでは失礼します…。」\n私はそう言うと、部屋を出て行った。","id":"0D767309-1D4D-42AA-84E7-9179010FE0BA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":3.4027210884353742},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","bgmStartTimeOffset":0,"duration":8.303900226757369,"slideTitle":"スライド #1283","title":"シーン 1283","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1283_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1283.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、蒲田のホテルで一泊をすると、そのまま空港に向かい、さとりとこいし、僕とアリスで別れて２ペアで並んで座る。","id":"39E91895-36C3-40CC-B6D7-F8C6C071CFCA","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.303900226757369},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","bgmStartTimeOffset":0,"duration":9.675124716553288,"slideTitle":"スライド #1284","title":"シーン 1284","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1284_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1284.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そういえば、アリスさんは、飛行機に乗るのは初めてですか？」僕は、ふと気になったので、彼女にそう尋ねる。","id":"66379755-01B2-446E-BA5E-F93DDE7EF758","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":9.675124716553288},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","bgmStartTimeOffset":0,"duration":2.8959410430839,"slideTitle":"スライド #1285","title":"シーン 1285","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1285_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1285.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「いや、学校での修学旅行で何度か、乗ったわ…。」","id":"FD70AE6B-5CD7-4E50-B89D-849952DCB96F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.8959410430839},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","bgmStartTimeOffset":0,"duration":6.8691156462585035,"slideTitle":"スライド #1286","title":"シーン 1286","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1286_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1286.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうなんですね…、僕は小学生くらいまでは、\n家族で何度か、飛行機に乗って沖縄に行ってましたが…。」","id":"97A09C0F-AE51-4C63-AC3D-051D9A5D19B0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.8691156462585035},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","bgmStartTimeOffset":0,"duration":8.00172335600907,"slideTitle":"スライド #1287","title":"シーン 1287","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1287_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5C6EB196-8DBE-56CE-96F3-C47438B1D16B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1287.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが、そんな会話をしていると、機内アナウンスで扉が閉まったことが知らされ、それから少しずつ飛行機は動き始めた。","id":"34B445B0-6B50-4926-B8DC-2F61333DEFEC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.00172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":8.577823129251701,"slideTitle":"スライド #1288","title":"シーン 1288","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1288_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1288.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、沖縄につき、空港を出ると、すでに手配済みだったレンタカーに乗り込む。昨日のホテルで手続きは既に済ませた。","id":"1EE90541-EB39-4823-8E71-26C8D5B8A3DD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.577823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":1.7940362811791384,"slideTitle":"スライド #1289","title":"シーン 1289","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1289_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1289.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「それで、これからどこに向かうの？」","id":"3986E5A8-4093-4A74-A52B-0678D77E729A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.7940362811791384},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":7.819115646258504,"slideTitle":"スライド #1290","title":"シーン 1290","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1290_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1290.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「今日と、帰る日の前日は、国際通り沿いのホテルなので、今日は南部中心ですが、アリスさんは希望はありますか？」","id":"0977B171-85B4-4640-A1CA-197C0DB15157","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.819115646258504},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":2.9190249433106574,"slideTitle":"スライド #1291","title":"シーン 1291","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1291_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1291.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私は…」私は彼の質問にどう返すべきか迷う。","id":"3BE6ECF3-324D-472D-B0AE-143B74F29CEF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.9190249433106574},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":1.9515192743764171,"slideTitle":"スライド #1292","title":"シーン 1292","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1292_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1292.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「出来れば、海中道路に行きたいわ…」","id":"483BB56C-D151-454B-9C66-A33DF60DE75A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.9515192743764171},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":6.173469387755102,"slideTitle":"スライド #1293","title":"シーン 1293","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1293_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1293.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…、こいしさんとさとりさんはどうですか？」\n僕は後ろの方を向いて、二人に尋ねる。","id":"690B6E34-ABED-43E3-9508-8B3745B50F1E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.173469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":2.7082766439909296,"slideTitle":"スライド #1294","title":"シーン 1294","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoS