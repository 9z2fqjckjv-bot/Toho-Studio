repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、彼女にそう言われ、今朝の出来事と、昨晩の夢の内容を彼女に１から話していく。すると、彼女の頬が、頬照っていく。","voiceCharacter":"操夢","duration":9.482154195011338,"title":"シーン 689","slideTitle":"スライド #689","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.689.jpeg","voiceDuration":9.482154195011338,"seVolume":1},{"id":"0627B175-C725-4D68-8A81-4C6608856747","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_690_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「それ、外では内緒だからね、分かった？」","voiceCharacter":"フランドール・スカーレット","duration":3.4332426303854877,"title":"シーン 690","slideTitle":"スライド #690","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.690.jpeg","voiceDuration":3.4332426303854877,"seVolume":1},{"id":"720519DC-DCF8-4D34-A50F-3FCC6E08D67C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_691_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volume