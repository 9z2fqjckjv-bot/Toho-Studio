ioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1927.jpeg","voiceDuration":8.521315192743764,"seVolume":1},{"id":"20A057C2-76B0-4EEE-B6D7-DD55FD658200","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1928_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「とりあえず、彼女は再び、こいしの元に現れると言ってましたから、しばらくの間は、誰か護衛をつけた方がいいですよ。」","voiceCharacter":"サブ","duration":8.169115646258504,"title":"シーン 1928","slideTitle":"スライド #1928","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1928.jpeg","voiceDuration":8.169115646258504,"seVolume":1},{"id":"4854C975-D1E9-4750-BE4F-C170573EBAD0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1929_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「ごめんなさいね…、あなたに頼るつもりはなかったけど、\nこんなことになってしまって…。」","voiceCharacter":"レミリア・スカーレット","duration":4.987414965986394,"title":"シーン 1929","slideTitle":"スライド #1929","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1929.jpeg","voiceDuration":4.987414965986394,"seVolume":1},{"id":"5C71FDF3-31BC-4299-9684-404461CD90DC","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1930_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「きっと次来る時も、向こうはあなたたちが吸血鬼であることを逆手にとって、逆らえないようにしてきますよ。」","voiceCharacter":"サブ","duration":7.022380952380952,"title":"シーン 1930","slideTitle":"スライド #1930","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1930.jpeg","voiceDuration":7.022380952380952,"seVolume":1},{"id":"212EB5AE-FAD4-431B-A165-E078A685F899","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1931_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「確かに、でもあなたは大丈夫なの？文脈から察するに、あなたの存在に関する情報が、向こうに流れるみたいだけど？」","voiceCharacter":"レミリア・スカーレット","duration":8.142154195011338,"title":"シーン 1931","slideTitle":"スライド #1931","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1931.jpeg","voiceDuration":8.142154195011338,"seVolume":1},{"id":"280B8279-7B63-4F6C-9AA2-2C6903876900","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1932_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「それは…、別に構いませんよ。ただ、彼女に従えば、吸血鬼という情報が流れ出さないなんていう保証はありませんよ。」","voiceCharacter":"サブ","duration":8.382154195011339,"title":"シーン 1932","slideTitle":"スライド #1932","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1932.jpeg","voiceDuration":8.382154195011339,"seVolume":1},{"id":"19936000-7999-42B0-831F-B9E517A82310","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1933_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「その上で、この派閥争いを鎮めて、\n次のステップに踏むべきだと、私は感じますがね…。」","voiceCharacter":"サブ","duration":6.358253968253968,"title":"シーン 1933","slideTitle":"スライド #1933","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1933.jpeg","voiceDuration":6.358253968253968,"seVolume":1},{"id":"09DFBDB9-6A62-4C88-962F-F4CC76EE75A6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂影あり困り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1934_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「確かにあなたのいうとおりね…。\nとりあえず、夕飯にしましょうか。」","voiceCharacter":"レミリア・スカーレット","duration":4.183832199546485,"title":"シーン 1934","slideTitle":"スライド #1934","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1934.jpeg","voiceDuration":4.183832199546485,"seVolume":1},{"id":"8AA626CD-6653-4E0A-8D3B-BE55B60F41B9","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1935_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"彼女はそう言い、部屋をさると、私も出る。そして、食事が終わると霊の如く、全身に衝撃が入り、彼が出てくるのだった。","voiceCharacter":"サブ","duration":9.059342403628118,"title":"シーン 1935","slideTitle":"スライド #1935","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1935.jpeg","voiceDuration":9.059342403628118,"seVolume":1},{"animationDuration":5,"audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"transitionName":"なし","telop":"？（霊夢の母に霖之助と呼ばれていた。そし…）","title":"シーン 1936: ？（霊夢の母に霖之助と呼ばれていた。そし…）","slideTitle":"スライド #1936","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","bgmAudioPath":"\/Users\/zuyasi\/Music\/Logic\/Mellotron Flute森近霖之助テーマ曲_1.aif","bgmVolume":0.65,"duration":8.085419501133787,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1936.jpeg","seVolume":1,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1937_操夢.wav","voiceCharacter":"操夢","id":"B34112DB-C3ED-4B9C-BCAD-705AC31EBAEF","animationNote":"5秒","voiceDuration":8.085419501133787,"backgroundName":"単色背景","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/黒影.png","bgmName":"BGM: Mellotron Flute森近霖之助テーマ曲_1","bgmStartTimeOffset":0},{"id":"E41BE709-AE5C-4E35-A331-AB955447D6C6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ驚き.png","transitionName":"なし","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"僕はふと気がつくと、そこは食堂だった。すると、こいしが驚いた様子で僕を見る。「どうしたんですか、こいしさん？」","duration":8.085419501133787,"title":"シーン 1937","slideTitle":"スライド #1937","characterName":