\/Slide_268_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「ここは、学校の保健室で、僕が覚えているのは、こいしさんとエンドレスランをしていて、途中で倒れる直前まで…です。」","voiceCharacter":"操夢","duration":8.266938775510203,"title":"シーン 268","slideTitle":"スライド #268","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.268.jpeg","voiceDuration":8.266938775510203,"seVolume":1},{"id":"9F5E3691-5F7B-4942-B64F-D319D8B8B267","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_269_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「えっと…あなたは、エンドラスランの途中で私を、お姫様抱っこした、紅夢さんですか？」私は、目覚めた頭でそう問う。","voiceCharacter":"古明地こいし","duration":11.0881179138322,"title":"シーン 269","slideTitle":"スライド #269","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.269.jpeg","voiceDuration":11.0881179138322,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3","id":"70C6517E-F04A-42E2-8907-338D6CE18496","seStartTimeOffset":0.3,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_270_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「それで…合ってます…」僕がそう言うと、なんとも言えない空気感が、保健室を包み込む。すると、扉が開く。","voiceCharacter":"操夢","duration":8.095215419501134,"title":"シーン 270","slideTitle":"スライド #270","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"[SE] 教室の戸を開ける.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.270.jpeg","voiceDuration":8.095215419501134,"seVolume":0.85},{"id":"2EA10909-C3D3-4531-98BE-5EF8B3CBB108","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_271_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「あんたたち、昨日のエンドレスランで、過去最低の記録を生み出したそうじゃないか…、その話、詳しく聞かせなさい。」","voiceCharacter":"萃香","duration":5.8363265306122445,"title":"シーン 271","slideTitle":"スライド #271","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.271.jpeg","voiceDuration":5.8363265306122445,"seVolume":1},{"id":"14D3587A-163E-4519-A5C9-C5799E2245EB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_272_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「えっと…」僕は、その強面の彼女に、怖気付いてしまう。\nだが、勇気を出して言う、「それは…どう言う意味ですか？」","voiceCharacter":"操夢","duration":8.213673469387755,"title":"シーン 272","slideTitle":"スライド #272","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.272.jpeg","voiceDuration":8.213673469387755,"seVolume":1},{"id":"FE0E7B83-ABBA-4227-ACEE-52A6C57971D0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_273_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"「美鈴から、聞いた話だと、途中からそこの彼女を、抱っこして走ったそうじゃないか？私だったら、そうはさせなかったぞ。」","voiceCharacter":"萃香","duration":6.781315192743764,"title":"シーン 273","slideTitle":"スライド #273","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.273.jpeg","voiceDuration":6.781315192743764,"seVolume":1},{"id":"7D8FC429-8788-4F12-BDDA-A61764F35B11","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_274_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"僕たちはそれから、その女性の説教を、\nチャイムがなるまで聞かされるのだった。","voiceCharacter":"操夢","duration":4.9419501133786845,"title":"シーン 274","slideTitle":"スライド #274","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.274.jpeg","voiceDuration":4.9419501133786845,"seVolume":1},{"id":"65962609-1A47-42A2-9FED-FB394DC05273","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_275_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕が、彼女の説教を聞き終えてから、教室に来ると、\nすでに1時間目が始まるまであと1分だった。","voiceCharacter":"操夢","duration":6.915850340136054,"title":"シーン 275","slideTitle":"スライド #275","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.275.jpeg","voiceDuration":6.915850340136054,"seVolume":1},{"id":"351211E2-679B-4732-97AE-8F3C372A256B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_276_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"そして、机に来ると、教科書の束が置いてあった。そして、付箋が机に貼られていて、今日の1時間目は現代文だった。","voiceCharacter":"操夢","duration":8.508253968253968,"title":"シーン 276","slideTitle":"スライド #276","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.276.jpeg","voiceDuration":8.508253968253968,"seVolume":1},{"id":"E171F6E6-5953-480F-BC67-41A946E02C4E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_277_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"それから、僕の元女子校生活３日目が始まった。","voiceCharacter":"操夢","duration":3.6332426303854874,"title":"シーン 277","slideTitle":"スライド #277","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.277.jpeg","voiceDuration":3.6332426303854874,"seVolume":1},{"id":"57C8559B-0A02-4BA2-9235-F14DD59D00FE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"それから時間が進み…","duration":1.5,"title":"シーン 278: それから時間が進み…","slideTitle":"スライド #278","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.278.jpeg","seVolume":1},{"id":"5042B723-D1EE-4B53-8CA9-34DE95F4EF4E","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_279_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕が、午前中の授業を終えると、\nふと、昼食がないことを思い出す。","voiceCharacter":"操夢","duration":4.8278231292517,"title":"シーン 279","slideTitle":"スライド #279","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.279.jpeg","voiceDuration":4.8278231292517,"seVolume":1},{"id":"41C406CB-9D4D-4C3D-BB08-3C80425A8F7B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_280_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"そこで、ふとさとりの姿を探す。\nだが、彼女は教室にはいなかった。","voiceCharacter":"操夢","duration":5.148458049886622,"title":"シーン 280","slideTitle":"スライド #280","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.280.jpeg","voiceDuration":5.148458049886622,"seVolume":1},{"id":"20ED76A5-4145-4715-A0AB-74D1069F6DE4","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_281_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"仕方なく、僕は廊下に出て歩いていると、\nふと向こうから、誰かがやってくる。","voiceCharacter":"操夢","duration":5.108253968253968,"title":"シーン 281","slideTitle":"スライド #281","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.281.jpeg","voiceDuration":5.108253968253968,"seVolume":1},{"id":"092F509F-0F9C-42A4-82DB-83714C07E686","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_282_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「おや、藤原さんですか、ちょうどよかった。あなた宛の荷物が来てたので、ちょうど渡そうとしてたところですよ。」","voiceCharacter":"東風谷早苗","duration":7.042222222222223,"title":"シーン 282","slideTitle":"スライド #282","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.282.jpeg","voiceDuration":7.042222222222223,"seVolume":1},{"id":"FFEE4074-1304-4B42-9B80-6039483F149A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_283_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「これ、魔理沙と名乗る女性から、預かった荷物です。」\n私はそう言うと、彼にそれを渡す。","voiceCharacter":"東風谷早苗","duration":6.116371882086168,"title":"シーン 283","slideTitle":"スライド #283","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.283.jpeg","voiceDuration":6.116371882086168,"seVolume":1},{"id":"C5118456-E126-4186-AC9F-E3F980733BD9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_284_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「では、私は、この後用があるので、ここで失礼します。」\n私はそう言うと、そのまま歩き出した。","voiceCharacter":"東風谷早苗","duration":6.6761904761904765,"title":"シーン 284","slideTitle":"スライド #284","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.284.jpeg","voiceDuration":6.6761904761904765,"seVolume":1},{"id":"28585B7A-6F5D-4BD4-8C92-C19030134F76","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_285_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、彼女に渡された荷物を持って、自席に戻ると、荷物を包んでいた風呂敷を時中を見ると、小瓶と弁当と紙があった。","voiceCharacter":"操夢","duration":8.610430839002268,"title":"シーン 285","slideTitle":"スライド #285","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.285.jpeg","voiceDuration":8.610430839002268,"seVolume":1},{"id":"9E35FC59-273C-435D-AA1C-F9434075788B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_286_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、その紙を見る。そこには、寄り道がてら、母から僕の弁当を受け取って、事務室に届けたことともう一つあった。","voiceCharacter":"操夢","duration":8.534331065759638,"title":"シーン 286","slideTitle":"スライド #286","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.286.jpeg","voiceDuration":8.534331065759638,"seVolume":1},{"id":"25F2F16E-F422-4481-9341-9FAE7BFBC3EE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_287_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"それは、この小瓶には試験薬が入っていて、それを飲めば、きっと僕の役に立つから飲んでみなさいと言う文章だった。","voiceCharacter":"操夢","duration":7.522380952380952,"title":"シーン 287","slideTitle":"スライド #287","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.287.jpeg","voiceDuration":7.522380952380952,"seVolume":1},{"id":"819B012D-34D5-4F73-B53B-D12C731A9BD4","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_288_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、その小瓶を手に取り眺める。そこには水に近い色合いの液体と、牛乳の色をした液体が入っていた。","voiceCharacter":"操夢","duration":7.490861678004535,"title":"シーン 288","slideTitle":"スライド #288","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.288.jpeg","voiceDuration":7.490861678004535,"seVolume":1},{"id":"521697A4-E9AA-41AF-9E5C-2C49E04588E6","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_289_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕はとりあえず、割れないように小瓶をどかすと、弁当を食べる。\nそして、弁当を数十分で食べ切ると、再び瓶を手に取る。","voiceCharacter":"操夢","duration":8.545215419501133,"title":"シーン 289","slideTitle":"スライド #289","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.289.jpeg","voiceDuration":8.545215419501133,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3","id":"B2F5E92D-B968-4E61-BFF5-8846E382EB42","seStartTimeOffset":0.3,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_290_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕が、その瓶をぼーっと眺めていると、\n誰かが教室に入り、僕の席に駆け寄ってくる。","voiceCharacter":"操夢","duration":6.058253968253968,"title":"シーン 290","slideTitle":"スライド #290","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 教室の戸を開ける","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.290.jpeg","voiceDuration":6.058253968253968,"seVolume":0.85},{"id":"BA6BE47F-F6D9-430F-9A58-51734F5F0C03","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_291_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「あんた、これ、どこで手に入れたの？」\n私は、彼からその瓶を取り上げ、そう尋ねる。","voiceCharacter":"パチュリー・ノーレッジ","duration":5.1407482993197275,"title":"シーン 291","slideTitle":"スライド #291","characterName":"パチュリー・ノーレッジ","audioTrack":"trac