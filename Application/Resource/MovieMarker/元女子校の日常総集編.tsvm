総集編\/image60.jpeg","telop":"「こいし、古明地こいしさんですよ。それがどうしたんですか？」","voiceCharacter":"操夢","duration":4.006077097505669,"title":"シーン 1454","slideTitle":"スライド #1454","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1454.jpeg","voiceDuration":4.006077097505669,"seVolume":1},{"id":"03A53CD1-F477-4153-8B19-E2CFF43989A8","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1455_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「まさか…、彼女の裸なんて見てるわけじゃないよね…？」","voiceCharacter":"フランドール・スカーレット","duration":3.9044897959183675,"title":"シーン 1455","slideTitle":"スライド #1455","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1455.jpeg","voiceDuration":3.9044897959183675,"seVolume":1},{"id":"5150B16F-B2C6-4083-BA65-19C6F0A375BD","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1456_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「さっき、こいしさんが素っ裸で、浴室から出てきて、\n数秒の間の後、全力疾走で浴室に戻ってましたよ。」","voiceCharacter":"操夢","duration":8.070204081632653,"title":"シーン 1456","slideTitle":"スライド #1456","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice