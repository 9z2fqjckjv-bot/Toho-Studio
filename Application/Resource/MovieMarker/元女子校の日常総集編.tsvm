sitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1298.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼らが海中道路に着くと…","id":"CC2DA62F-E2CE-4458-9C0C-ADF41F35087B","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.60390022675737,"slideTitle":"スライド #1299","title":"シーン 1299","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1299_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1299.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが海中道路につくと、道路沿いの海岸線に沿った駐車場に車を止めて、海岸線から海を眺めていた。","id":"47FBCE48-3D36-4D39-8809-5B217841F5F9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.60390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":3.0525850340136054,"slideTitle":"スライド #1300","title":"シーン 1300","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1300_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1300.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「波の音を聞きながら、海をただ眺めるって…良いわね。」","id":"F7AFC6C7-0771-4954-8245-0142EFCF8CEB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":3.0525850340136054},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.6604308390022675,"slideTitle":"スライド #1301","title":"シーン 1301","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1301_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1301.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、確かにその通りですよ。地元の人たちは、海は遊ぶものじゃくなくて、眺めるものだって言ってますから…」","id":"C6647CA0-47D8-427F-A3BA-60758EA3303C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.6604308390022675},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":2.914761904761905,"slideTitle":"スライド #1302","title":"シーン 1302","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1302_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1302.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言いながら、さとりとこいしの方を見る。","id":"D27BA41E-1F53-4997-B0BE-1180CAB4DD12","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.914761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.668027210884354,"slideTitle":"スライド #1303","title":"シーン 1303","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1303_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1303.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そこには、海水を互いに掛け合って、楽しんでいる二人がいた。\n「海入って遊ぶのは観光客だってよく言いますから…」","id":"9F5FCF01-71E0-4EE4-876E-825DF147E1DF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.668027210884354},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":3.2895011337868483,"slideTitle":"スライド #1304","title":"シーン 1304","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1304_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1304.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「確かに…その通りね…。」私は笑いながら、そういう。","id":"04EB377D-93FD-4D30-BCA3-39A2239C2EA9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":3.2895011337868483},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":1.8315192743764173,"slideTitle":"スライド #1305","title":"シーン 1305","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1305_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1305.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「それで、この後は、どうする？」","id":"FC3521C9-63AC-4D6A-886A-56084B06EACD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.8315192743764173},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":2.590861678004535,"slideTitle":"スライド #1306","title":"シーン 1306","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1306_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1306.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「アリスさんは、もうお腹がすいてますか？」","id":"91F5F9C4-3173-4E46-A060-BCFDC346114B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.590861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":5.499705215419501,"slideTitle":"スライド #1307","title":"シーン 1307","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1307_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1307.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"私は、彼にそう聞かれ、少しばかし考えてからいう。\n「今食べちゃうと、お昼が食べられなくなるわね…」","id":"27857C02-D2DB-41E2-9F69-080971C6388D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.499705215419501},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.166938775510204,"slideTitle":"スライド #1308","title":"シーン 1308","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1308_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1308.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「確かに、アリスさんのいう通りです。それで、どうします？\n海中道路を渡った先に、タコスのお店がありますが？」","id":"1E11C537-37B3-4B19-8479-0842BC11D854","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.166938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":5.540657596371882,"slideTitle":"スライド #1309","title":"シーン 1309","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1309_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1309.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「タコス…」私はそう呟きながら、考える。\n「1つくらいなら、お昼も問題なく食べられるかしら…」","id":"E14E513D-1EDE-4CE7-A1B0-C155BF2D24EC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.540657596371882},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.3256462585034,"slideTitle":"スライド #1310","title":"シーン 1310","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1310_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1310.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「昼食を一気に済ますのではなく、チビチビ済ますなら、問題ないですよ。ただ、お昼はステーキがいいと言うなら別ですが…」","id":"2C3DDEEF-F72B-4644-9720-0C6334E03B15","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.3256462585034},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":4.503832199546485,"slideTitle":"スライド #1311","title":"シーン 1311","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1311_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1311.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの二人にも聞いてこなくちゃね…」\n私はそう言うと、二人の方に向かって歩こうとする。","id":"C297CB3B-7583-4D94-AB32-87B4345D2E59","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":4.503832199546485},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.893038548752834,"slideTitle":"スライド #1312","title":"シーン 1312","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1312_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1312.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が二人の方に向かおうとすると、手で静止する。だが、その際に、彼女はバランスを崩し、海の方に倒れ込む。","id":"EFD509AE-5AC6-4FA5-802A-6335A560042F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.893038548752834},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.988684807256236,"slideTitle":"スライド #1313","title":"シーン 1313","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1313_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1313.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が海水に濡れさせないように、彼女を止めるように動く。すると、彼女が僕の腕に寄りかかるように倒れる。","id":"3F3DF6B2-1185-4D92-92C3-6B4819E714A6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.988684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.443038548752835,"slideTitle":"スライド #1314","title":"シーン 1314","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1314_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1314.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はふと気がつくと、足の太ももあたりまで、海水に使った状態になり、その状態で彼女を抱き抱えていた。","id":"D4546F31-1935-4E7E-88C6-4A215E8C4170","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.443038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.632154195011339,"slideTitle":"スライド #1315","title":"シーン 1315","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1315_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1315.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女は、今の状況を把握したのか、一気に頬が赤く染まる。\n僕は、そんな彼女に、こんな状況になったことを謝る。","id":"CBD546DF-E588-4027-BF27-42BD563FFAC6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.632154195011339},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.838684807256236,"slideTitle":"スライド #1316","title":"シーン 1316","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1316_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1316.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして気がつくと、アリスは僕の腕で抱っこされ、さとりとこいしが困った表情でこちらを見つめ、気まずい空気が流れ出す。","id":"FF8D8BDD-2EB5-44C3-9EE5-291700EB2794","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.838684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":7.464761904761905,"slideTitle":"スライド #1317","title":"シーン 1317","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1317_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1317.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちの間に、そんな空気感が数分間流れると、\n僕は、くしゃみをする。そして、体を震わせる。","id":"8F977404-C57C-4732-B042-52E38D834980","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.464761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":4.47219954648526,"slideTitle":"スライド #1318","title":"シーン 1318","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1318_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1318.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「とりあえず、車に戻りませんか？\nこのままだと、紅夢さんが風邪ひきそうですし」","id":"6DA2EBA4-F1FC-41A6-8F12-391AB8C234B1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":4.47219954648526},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":3.0425396825396827,"slideTitle":"スライド #1319","title":"シーン 1319","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1319_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1319.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そうだね…、私も車に戻る…」","id":"75CE1ED5-33D7-4241-B027-D94077447AEA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.0425396825396827},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.882154195011339,"slideTitle":"スライド #1320","title":"シーン 1320","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1320_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1320.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、二人がそう言い、歩き出すと、彼女を抱えたまま、僕も歩こうとする。だがその瞬間に、大きな負荷が僕にかかる。","id":"A9DEAC8A-56C3-45E0-8AE5-8D1918BB4E4B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.882154195011339},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":2.295374149659864,"slideTitle":"スライド #1321","title":"シーン 1321","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1321_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1321.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの、降ろしてもらえませんか、紅夢さん…」","id":"9F3F7382-D4F8-4139-82A0-6497C438D47E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.295374149659864},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.038684807256235,"slideTitle":"スライド #1322","title":"シーン 1322","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1322_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1322.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ？」僕は一瞬、彼女が何を言っているのかが分からなかったが、すぐに理解し、そっと階段の上に彼女を下ろす。","id":"ED954498-BC48-471B-9EF1-28518F8A6BB1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.038684807256235},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmStartTimeOffset":0,"duration":8.549546485260771,"slideTitle":"スライド #1323","title":"シーン 1323","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1323_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image59.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1323.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女は足早に車に戻って行った。「えっ…」\n僕は、そう呟いてから、再びくしゃみをすると、車に戻った。","id":"ED73FA18-4DDD-481F-B843-0538F7C4F277","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.549546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":8.934331065759638,"slideTitle":"スライド #1324","title":"シーン 1324","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1324_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1324.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、車に戻ると、元々座っていた助手席に座り、シートベルトを締める。そして、彼女はそれから車のエンジンをつける。","id":"2BCE86C9-E2F2-42C1-945C-318DB4056D3A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.934331065759638},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":8.745215419501134,"slideTitle":"スライド #1325","title":"シーン 1325","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1325_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1325.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、海中道路を一度渡り切り、Uターンして戻る。\nその最中、彼女が、心配そうな声で、僕に話しかける。","id":"6404EDDE-34CD-4824-870B-2C8AD0143650","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.745215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":1.1224943310657596,"slideTitle":"スライド #1326","title":"シーン 1326","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1326_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1326.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの…、大丈夫？」","id":"8B70851F-CE4B-433F-9AF0-5BB866A7BD46","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.1224943310657596},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":8.334331065759637,"slideTitle":"スライド #1327","title":"シーン 1327","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1327_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1327.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「少しばかし、風邪を引いたかも…しれません。とりあえず、国際通りに行きませんか？そしたら、ちょうどお昼だし…」","id":"BD2F700C-F9B9-4DD3-89CF-EE37240EA723","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.334331065759637},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":1.570748299319728,"slideTitle":"スライド #1328","title":"シーン 1328","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1328_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1328.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「確かに、そうしましょうか…」","id":"C3B941CB-90E7-49D0-B73C-2BC1BCFE31D2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.570748299319728},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","bgmStartTimeOffset":0,"duration":3.1006349206349206,"slideTitle":"スライド #1329","title":"シーン 1329","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1329_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc284290_自動車の車内（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1329.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それから、国際通りに向かった。","id":"E92770B8-4136-4F91-AB94-967F44390E83","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.1006349206349206},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1330","title":"シーン 1330: 彼らが国際通りに着くと…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1330.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼らが国際通りに着くと…","id":"8C5145C4-6AB4-48EA-BF1C-C1E5C3E680FF","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/473B4704-DE27-5D98-945D-7E43A3042370.jpg","bgmStartTimeOffset":0,"duration":7.219115646258503,"slideTitle":"スライド #1331","title":"シーン 1331","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1331_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"473B4704-DE27-5D98-945D-7E43A3042370.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1331.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちはそれから、今日と帰る日の前日に泊まるホテルの駐車場に車を停めて、駐車場の中を歩いていた。","id":"020D8E7E-3734-4CB9-881F-2577F8ABCA46","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.219115646258503},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/_.jpg","bgmStartTimeOffset":0,"duration":8.373469387755103,"slideTitle":"スライド #1332","title":"シーン 1332","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1332_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"_.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1332.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、ホテルのフロントに来ると、旅行券のコピーと、身分証を見せる。すると、部屋のキーカードを受け取り、歩き出す。","id":"2B1E0393-8D29-4135-ABC0-12522027FDE7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.373469387755103},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":7.810430839002268,"slideTitle":"スライド #1333","title":"シーン 1333","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1333_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1333.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、部屋2つありますが、部屋割りはどうしますか？」\n僕は、そうさとり、こいし、アリスの3人に尋ねる。","id":"B15DB6FD-7497-45E1-B3AA-5110A56006DB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.810430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":8.171292517006803,"slideTitle":"スライド #1334","title":"シーン 1334","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1334_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1334.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それってつまり、誰かしら一人は、紅夢さんと同じ部屋になるってことかしら？」私は、確認のためにそう彼に聞く。","id":"E14315C3-B601-430A-8AD6-22650C4597F8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.171292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":3.8908616780045353,"slideTitle":"スライド #1335","title":"シーン 1335","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1335_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1335.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、僕の希望はないので、三人で決めてもらえますか？」","id":"7A4D8E09-40C9-43FD-96AB-B06FAB1AFDF2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.8908616780045353},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cac