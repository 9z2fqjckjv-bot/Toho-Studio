"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2059.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それは…脳波ですか…？」","id":"126F6952-1F2F-477C-A6DF-466AFD58D430","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.6647619047619047},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":8.253061224489796,"slideTitle":"スライド #2060","title":"シーン 2060","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2060_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2060.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"「ええ。実は、あなたがあの研究室で倒れた後、\nすぐに病室に運ばれて、あなたの脳波をとっていたの。」","id":"3430D9A5-84B4-4D81-A983-92EFA23034BC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.253061224489796},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":3.0039002267573696,"slideTitle":"スライド #2061","title":"シーン 2061","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2061_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2061.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…、それで、何かわかるんですか？」","id":"FCCF3E45-8A11-4EC5-9110-A4AADA03F57C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.0039002267573696},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":8.122993197278912,"slideTitle":"スライド #2062","title":"シーン 2062","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2062_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2062.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"「そうね…、簡潔にいうなら、あなたの落ち着き度合いを確認するためよ。まぁ、そんなことは気にしなくていいわ。」","id":"612A9235-FBA8-43E3-B835-E640E7FF751D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.122993197278912},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":8.38077097505669,"slideTitle":"スライド #2063","title":"シーン 2063","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2063_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2063.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"「とりあえず、今日の診察はここまでにしましょう、学校には早退と伝えてあるから、病室に戻って休んでなさい。」","id":"1912317D-0D9F-473C-B4A6-845B72C93F31","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.38077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":3.824557823129252,"slideTitle":"スライド #2064","title":"シーン 2064","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2064_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2064.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました…」僕はそういうと、病室に戻っていった。","id":"39DCEC88-E639-406E-940F-96B9CB8DB505","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.824557823129252},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":9.576757369614512,"slideTitle":"スライド #2065","title":"シーン 2065","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2065_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2065.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（怒り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"私は彼が帰ると、ある彼のデータを眺めていた。実は、さっき見せた脳波のデータはダミーで、本当は違うデータを取っていた。","id":"B94EAD77-3281-4CBA-9190-2325F615F93E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":9.576757369614512},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffset":0,"duration":9.633718820861677,"slideTitle":"スライド #2066","title":"シーン 2066","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2066_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc166698_病院の診察室.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2066.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（怒り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。","id":"59C39A0D-825B-4D19-B2DA-866C55178645","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":9.633718820861677},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","bgmStartTimeOffse