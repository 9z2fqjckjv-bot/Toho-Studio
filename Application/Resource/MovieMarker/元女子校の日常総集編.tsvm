\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1858_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1858.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし驚き.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「ちょっと、見せてくれないか？」","id":"3F623A04-FD4E-44E6-86DC-40274B40C897","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":2.2632426303854873},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc244641_家の玄関ホール（日中）.jpg","bgmStartTimeOffset":0,"duration":3.6278231292517007,"slideTitle":"スライド #1859","title":"シーン 1859","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1859_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1859.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし驚き.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いいですよ。」僕は、そういうと、本を手渡す。","id":"0DCA06DA-4320-4D83-8012-F201E5712B55","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.6278231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc244641_家の玄関ホール（日中）.jpg","bgmStartTimeOffset":0,"duration":9.914489795918367,"slideTitle":"スライド #1860","title":"シーン 1860","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1860_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1860.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙箒・帽子なし微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「これは…、私が書いた本だな。それで、聞きたいことってのは？」私は、本を数分間眺めてそう言い、彼に返す。","id":"BCE33528-2280-4BED-A0CE-2467F1B785BE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":9.914489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc244641_家の玄関ホール（日中）.jpg","bgmStartTimeOffset":0,"duration":5.832154195011338,"slideTitle":"スライド #1861","title":"シーン 1861","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1861_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1861.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙箒・帽子なし微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうなんですか…。それで、魔理沙さんはこの本を見て、\nおかしいとこに気が付きましたか？」","id":"393C1DA4-2DC1-4827-9306-0445BAEA2FD0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.832154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc244641_家の玄関ホール（日中）.jpg","bgmStartTimeOffset":0,"duration":2.606984126984127,"slideTitle":"スライド #1862","title":"シーン 1862","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1862_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1862.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「おかしいとこ…？どういう意味だ？」","id":"2376CEEB-B55E-4557-A9E2-307F5FBE11CE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":2.606984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc244641_家の玄関ホール（日中）.jpg","bgmStartTimeOffset":0,"duration":4.7,"slideTitle":"スライド #1863","title":"シーン 1863","animationName":"なし","bgmVolume":0.65,"voiceStartTimeOffset":0,"transitionName":"なし","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1863.jpeg","bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし疑問.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"「この本の表紙の著者の欄に、ラベルが貼ってあって、\n巻末の出典ページが破れていて、ないんですよ」","id":"BD5B18C5-94BE-47D6-893F-04F477082C6C","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc244641_家の玄関ホール（日中）.jpg","bgmStartTimeOffset":0,"duration":1.8719954648526078,"slideTitle":"スライド #1864","title":"シーン 1864","animationName":"なし","voice