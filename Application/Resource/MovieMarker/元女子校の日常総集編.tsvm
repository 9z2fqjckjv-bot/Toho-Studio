lumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"僕は、ハッと気がつくと、彼女が暗い表情で、僕に声をかけていた。「ごめん…、母さん…。」僕は反射的に、そう謝る。","voiceCharacter":"操夢","duration":9.066938775510204,"title":"シーン 1124","slideTitle":"スライド #1124","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1124.jpeg","voiceDuration":9.066938775510204,"seVolume":1},{"id":"9F7A68A9-00F7-4ACB-A649-DAA4C3DC1CFD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1125_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「謝る必要はないわよ。それよりも、あんたは大丈夫なの、さっきより顔色が悪くなっているけど…」","voiceCharacter":"博麗霊夢","duration":7.706984126984127,"title":"シーン 1125","slideTitle":"スライド #1125","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1125.jpeg","voiceDuration":7.706984126984127,"seVolume":1},{"id":"378F443C-CB6F-4ADE-9A8B-FC7034537B01","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1126_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroun