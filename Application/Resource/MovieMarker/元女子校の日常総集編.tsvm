:"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","telop":"「そうね…、とりあえず、私のとこに来なさい。」","voiceCharacter":"パチュリー・ノーレッジ","duration":2.6085714285714285,"title":"シーン 2027","slideTitle":"スライド #2027","characterName":"パチュリー・ノーレッジ","audioTrack":"track_voice_char_1B13","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2027.jpeg","voiceDuration":2.6085714285714285,"seVolume":1},{"id":"48EB34E0-600B-4623-985F-D6F5EB0F5DBA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2028_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","telop":"彼女は、そう言って、手をこまねく。僕は、彼女のそばに立つ。\nすると、彼女は何かの瓶を手に取り、説明を始める。","voiceCharacter":"操夢","duration":8.972380952380952,"title":"シーン 2028","slideTitle":"スライド #2028","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2028.jpeg","voiceDuration":8.972380952380952,"seVolume":1},{"id":"DF886365-C3F9-4E63-92CB-02CD83384233","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Su