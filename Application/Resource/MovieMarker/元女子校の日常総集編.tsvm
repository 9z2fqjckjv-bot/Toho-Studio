7fe1ac7.909.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"私が家に帰ってくると、なぜか霊夢と魔理沙の二人がリビングで私の方に視線を向けていた。何となく嫌な予感がする。","id":"CBB5330F-07C7-4E8D-9B1F-A451B7A3BEA7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":7.923106575963719},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":3.769478458049887,"slideTitle":"スライド #910","title":"シーン 910","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_910_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.910.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「ねぇ、あなた、私と魔理沙のどっちを選ぶの？」","id":"EABBCDB9-1F32-4886-9AD0-42A466C71039","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":3.769478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":3.611995464852608,"slideTitle":"スライド #911","title":"シーン 911","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_911_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.911.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙箒・帽子なし微笑.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「まさか、どっちもなんていうのか、妹紅さん…」","id":"CD35F147-831B-4F40-9848-3B21755A9C6B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":3.611995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":8.067278911564626,"slideTitle":"スライド #912","title":"シーン 912","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_912_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.912.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"息子がいなくなって魔理沙がやってきてから、2週間ちょっと、その間に、この三角関係になり、私に危機が訪れていた。","id":"2CB010B9-23E5-4FEB-A983-A4E5709E1D9E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":8.067278911564626},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":8.223537414965987,"slideTitle":"スライド #913","title":"シーン 913","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_913_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.913.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"妻を選べば、ビームが飛んできて、魔理沙を選べば、妻の怒声が響いてしまうこの状況に私は、ただ無言になるしか出来なかった。","id":"1DE980A5-F3F1-413A-9796-D2D210CE6096","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":8.223537414965987},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":8.091247165532879,"slideTitle":"スライド #914","title":"シーン 914","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_914_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.914.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"お願いだから、早く戻ってきてくれ、息子よ…。私は叶いもしないはずのそんな願いを抱きながら、この状況をやり過ごした。","id":"171E25CE-61F2-4DED-A04B-2F6CC9C1F369","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":8.091247165532879},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.947369614512471,"slideTitle":"スライド #915","title":"シーン 915","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_915_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.915.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"体力テストと、統一模試を受けてから数日が経ち、遠足まであと1週間を切った今日、僕は教室に入ると、自分の席に着く。","id":"9523EFDD-EABB-4007-9442-594A7D2AEE83","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.947369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.564761904761905,"slideTitle":"スライド #916","title":"シーン 916","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_916_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.916.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、さとりがこちらに駆け寄ってくる。","id":"7217BED7-BFE5-4225-AD1C-8A8A64BF4EC4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.564761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.0151927437641723,"slideTitle":"スライド #917","title":"シーン 917","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_917_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.917.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「紅夢さん、あなた学内で、有名人になってますよ。」","id":"D66BD356-DFB2-4511-8CFF-341CBB98F116","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.0151927437641723},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.756077097505669,"slideTitle":"スライド #918","title":"シーン 918","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_918_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.918.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ…」僕はそう呟き、なぜ自分が有名人になったかを考える。そして、彼女に聞く。「なぜですか…？」","id":"64345661-672D-4D02-A20D-F8DF3A4B13D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.756077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.750884353741497,"slideTitle":"スライド #919","title":"シーン 919","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_919_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.919.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「本来なら大学受験に使われるような高難度の問題が入り混じった模試で満点を取り、文武両道な転校生が学内にいると…」","id":"C7D1611B-99A2-4378-B70D-F53C9957DFA8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.750884353741497},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.397596371882086,"slideTitle":"スライド #920","title":"シーン 920","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_920_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.920.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「教員側も驚愕しているっていう噂と共に、生徒の間でも話題になってますよ。それこそ遠足と学校行事よりも…」","id":"BF18F450-0C7A-4BAE-8A1B-F93DBA1A0DE5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.397596371882086},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.882698412698413,"slideTitle":"スライド #921","title":"シーン 921","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_921_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.921.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「私が聞いた限りだと、あなたは1500mを数分で走り切った後に受けた模試で100点が出た、転校生だと言われてますよ。」","id":"1D35F247-5F92-4B2F-B0CC-1BEA9B251E0C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.882698412698413},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.2791836734693875,"slideTitle":"スライド #922","title":"シーン 922","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_922_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.922.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「女子は、噂に敏感で、何でもかんでもすぐに広まるので、気をつけないと、後々面倒ごとに巻き込まれちゃいますよ。」","id":"09E890F1-4626-4362-AEB2-38B213658CDF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.2791836734693875},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.466938775510204,"slideTitle":"スライド #923","title":"シーン 923","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_923_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.923.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…」\n僕は、彼女から聞いたその内容に困惑するのだった。","id":"9FC5F721-5024-42C1-9AFD-08762E154CAF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.466938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.25390022675737,"slideTitle":"スライド #924","title":"シーン 924","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_924_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.924.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、さとりは自席に戻り、しばらくすると、教室の扉がチャイムと同時に開く。そして、担任が入ってくる。","id":"AC44F391-4047-4CF5-82DA-CCA2622666F5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.25390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.321292517006802,"slideTitle":"スライド #925","title":"シーン 925","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_925_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.925.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はいつものように、素早く立ち上がり、クラスメイトと同じタイミングで礼と挨拶をすると、彼女の合図で座る。","id":"E79279F1-C469-45C2-831B-9C7BC5E42772","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.321292517006802},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":9.00156462585034,"slideTitle":"スライド #926","title":"シーン 926","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_926_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.926.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「それでは、朝礼を始めます。今日は、テスト返却の後は、遠足に向けた、全校集会なので昼食後速やかに移動するように。」","id":"7FFB1757-CD67-43DA-B856-8C5DBB695D44","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":9.00156462585034},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.785351473922902,"slideTitle":"スライド #927","title":"シーン 927","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_927_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.927.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「それと藤原さんは、今学園内で流れている情報の真意を確かめるので、朝礼後、速やかに職員室を訪ねるように。」","id":"2BF19DDE-6F8C-4AE8-9784-3DE60A468496","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":7.785351473922902},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.300090702947846,"slideTitle":"スライド #928","title":"シーン 928","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_928_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.928.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「今日の連絡は以上です。今日も1日、勉学を励みましょう。」","id":"33873639-492B-4406-AA93-06231D98C34E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":4.300090702947846},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.699546485260771,"slideTitle":"スライド #929","title":"シーン 929","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_929_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.929.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、去っていた。\n僕は、きょとんとしながら、ふと我に帰り、職員室に向かう。","id":"7345BC37-E176-4160-9389-903BF59669EF","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.699546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.7756462585034014,"slideTitle":"スライド #930","title":"シーン 930","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_930_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.930.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕が職員室に来ると、ある女性がやってくる。","id":"ED6FB05A-74B2-458A-BDBA-04D2FE44FC8D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.7756462585034014},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.727891156462585,"slideTitle":"スライド #931","title":"シーン 931","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_931_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.931.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「藤原さん、早速ですが、別室に移動して、あなたの話を聞かせてもらうので、私の後についてきてください。」","id":"8FBB68D9-D354-4191-A151-B04C6F0A4EFA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":6.727891156462585},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.0267346938775512,"slideTitle":"スライド #932","title":"シーン 932","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_932_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.932.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそう言われ、やってきたのは被服室だった。","id":"6F35C8BF-015F-4C9B-8752-44A4D0462849","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.0267346938775512},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":2.8357823129251702,"slideTitle":"スライド #933","title":"シーン 933","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_933_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.933.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「それで、こないだの体力テスト、どうでしたか？」","id":"8C49CD6B-9798-4714-B373-48BF27279A41","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":2.8357823129251702},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.4984580498866213,"slideTitle":"スライド #934","title":"シーン 934","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_934_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.934.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…僕に取っては、負荷が大きいテストでした…。」","id":"783E2223-15EA-4584-9805-0DF388D26CCB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.4984580498866213},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":2.9520861678004535,"slideTitle":"スライド #935","title":"シーン 935","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_935_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.935.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「そうですか…それで、どこまでの記憶がありますか？」","id":"F0ABC745-4787-4474-A541-DE47470076FA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":2.9520861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.4430385487528343,"slideTitle":"スライド #936","title":"シーン 936","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_936_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.936.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「確か…グラウンドを全力疾走したところまでです…」","id":"86E0D4ED-0D8D-4F43-81F9-2221F072DE4A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.4430385487528343},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.3261904761904764,"slideTitle":"スライド #937","title":"シーン 937","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_937_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.937.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「それで、次に目が覚めた時、あなたはどこにいましたか？」","id":"C14884EE-7D00-474B-97BF-6513CB95ADA8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":3.3261904761904764},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":1.2821541950113378,"slideTitle":"スライド #938","title":"シーン 938","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_938_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.938.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「家の寝室です…」","id":"4C1D1CC0-803C-429F-A00E-B452418822DB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.2821541950113378},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.1115873015873015,"slideTitle":"スライド #939","title":"シーン 939","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_939_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.939.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「ちなみに、その間の記憶は、まったくありませんか？」","id":"C2553C8D-D66B-4B43-993D-0C56CA9CD43A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":3.1115873015873015},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.188684807256236,"slideTitle":"スライド #940","title":"シーン 940","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_940_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.940.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ…、でも僕は、ある意味、慣れっこですよ…」","id":"B8C140A3-8FC5-4569-904A-28FAB5C25F1D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.188684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":1.0293877551020407,"slideTitle":"スライド #941","title":"シーン 941","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_941_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.941.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「そう言える理由は？」","id":"898B35A7-276E-4734-BA49-FFBA8A81DCFB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":1.0293877551020407},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":5.5495464852607705,"slideTitle":"スライド #942","title":"シーン 942","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_942_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.942.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「その内容話すと、少なくとも1時間は必要ですけど、\nそれでも聞きたいですか？」","id":"8C498CD2-6010-45D7-A67F-A9587CE5EB5C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.5495464852607705},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":4.160680272108843,"slideTitle":"スライド #943","title":"シーン 943","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_943_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.943.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「ええ、あなたの心身にかかる事柄ですから、\nぜひ、聞かせてください。」","id":"9A018575-E70A-4FBA-A152-F8047D99CEAA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":4.160680272108843},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":4.356077097505669,"slideTitle":"スライド #944","title":"シーン 944","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_944_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.944.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女の意思を確認すると、過去を思い返しながら話す。","id":"BBB2BBB6-5402-4A85-ACA8-262F8501D0EB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.356077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.3903854875283446,"slideTitle":"スライド #945","title":"シーン 945","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_945_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.945.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「それで、あなたはこの学校に転校して、良かったですか？」","id":"AE20211D-8F1C-4D0F-89BC-AE81468A3374","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":3.3903854875283446},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":8.435419501133786,"slideTitle":"スライド #946","title":"シーン 946","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_946_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.946.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、前の学校と比べると、かなり良いです。母に、母の母校に転校したいと言って、良かったと僕は思っています。」","id":"A22F59AB-86DB-45CA-ABFF-AFA47413A63F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.435419501133786},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":6.837482993197279,"slideTitle":"スライド #947","title":"シーン 947","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_947_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.947.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「そうですか…、ところで話の節々から、あなたの記憶には、欠けているところがありますが、何か心当たりはありますか？」","id":"BA2B852E-1FA6-4A55-BE86-A12D75E6A5BB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":6.837482993197279},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":8.410430839002268,"slideTitle":"スライド #948","title":"シーン 948","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_948_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.948.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…正直に言って分からないです。小さかった頃は、それこそ些細な違いで、記憶が欠け始めたのは、中学からですから…」","id":"4FFD6226-E80E-4A39-BEE9-C56ECE3CBF21","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.410430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":7.962607709750567,"slideTitle":"スライド #949","title":"シーン 949","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_949_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.949.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…ただ、証拠を出せというのなら、僕のこの身体が、それを示してます…、正直にいうと人様には見せたくないですが…」","id":"4E7FA1A3-48BC-46AD-B8F3-485B1CABA25B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.962607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":7.084580498866213,"slideTitle":"スライド #950","title":"シーン 950","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_950_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.950.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「そうですか…。ところで、あなたは、この間の模試を受けている時の様子と、午後の1500m走の様子を見たいですか？」","id":"AF70D1DE-DD30-45DB-92D9-0FBDEDB94864","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":7.084580498866213},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":4.421292517006803,"slideTitle":"スライド #951","title":"シーン 951","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_951_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.951.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ？」僕は、彼女の急な質問に、そう返してしまう。","id":"D3E26C4E-4BAF-49EE-9EC5-0F8979696D68","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.421292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":5.884897959183673,"slideTitle":"スライド #952","title":"シーン 952","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_952_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.952.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「もし、見たいのなら、教員用のPCにデータが保存されているので、お見せできますが…、どうしますか？」","id":"1286E0D7-067E-4B8A-A54D-70CF05344CA0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":5.884897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":8.561519274376417,"slideTitle":"スライド #953","title":"シーン 953","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_953_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.953.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…」僕はふと迷う。確かに、こないだの気を失っている間に、自分が何をしてかを見たいが、見たくない気持ちもある。","id":"E71D30D0-27E5-484E-9307-5A3EE9242A2C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.561519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.7039002267573697,"slideTitle":"スライド #954","title":"シーン 954","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_954_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.954.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いや、いいです…」僕は、それから彼女にそう返す。","id":"CBC43BD0-C637-49D2-A627-EBAB5E668B46","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.7039002267573697},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":6.8395918367346935,"slideTitle":"スライド #955","title":"シーン 955","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_955_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.955.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「そうですか…、最後に一つだけ、こないだ渡した例の遠足に関する条件ですが、無事に満たしましたよ、では失礼。」","id":"486AD036-E39B-4623-ACE4-D7094CF99A1E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":6.8395918367346935},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":8.461519274376418,"slideTitle":"スライド #956","title":"シーン 956","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_956_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.956.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、部屋をさっていった。僕は、ゆっくりと立ちあがろうとすると、突如として頭痛が走り、床に崩れ落ちる。","id":"789DEF19-D065-4A0D-AEF9-FD01FA1EFACF","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.461519274376418},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":5.049297052154195,"slideTitle":"スライド #957","title":"シーン 957","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_957_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.957.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"そして、僕の様子を見に戻ってきた彼女を、\n一瞬見ると、そのまま気を失うのだった。","id":"A2331F57-385A-4676-80C2-3DD53101E4BE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":5.049297052154195},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #958","title":"シーン 958: 彼がふと気がつくと…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.958.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼がふと気がつくと…","id":"03A0D09A-49C4-4C39-B313-C36BB47D79FF","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","bgmStartTimeOffset":0,"duration":5.811519274376417,"slideTitle":"スライド #959","title":"シーン 959","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_959_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791193839_80109.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.959.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はふと気がつくと、そこはトイレだった。\nそして、手を洗ってから、トイレを出る。","id":"FED0E645-E518-4D87-ABFC-8EE9042786E6","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.811519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc485831_学校の廊下（日中）.jpg","bgmStartTimeOffset":0,"duration":8.458253968253969,"slideTitle":"スライド #960","title":"シーン 960","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_960_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc485831_学校の廊下（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.960.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、学校の廊下を歩いているときに、ふと午後は、全校集会だったことを思い出す。そして、僕は体育館に向かう。","id":"FEC66E06-ECC9-4CFE-B5C4-138770ED8944","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.458253968253969},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","bgmStartTimeOffset":0,"duration":8.357165532879819,"slideTitle":"スライド #961","title":"シーン 961","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_961_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.961.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が体育館に来ると、すでにほとんどの生徒や児童が集まっているようだった。僕は、ふと周りを見渡し、ある列に入る。","id":"80982BB8-7696-4926-BA1C-E4C7063D1795","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.357165532879819},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","bgmStartTimeOffset":0,"duration":3.9658503401360545,"slideTitle":"スライド #962","title":"シーン 962","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_962_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.962.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、数時間の間、遠足の説明を聞くのだった。","id":"D70999FC-1A67-4C50-9BB7-2B8A131BAA68","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.9658503401360545},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #963","title":"シーン 963: 説明会が終わり…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.963.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"説明会が終わり…","id":"C7B611A0-237F-486C-BF98-459FAF2E4F16","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.766938775510204,"slideTitle":"スライド #964","title":"シーン 964","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_964_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.964.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、朝と同じように礼と挨拶をして、数分程度の短い週例を終えると、そのまま、学校の校門に向かう。","id":"A3C6A3E4-8EB9-4F05-A579-A07C28CED8F0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.766938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.132154195011338,"slideTitle":"スライド #965","title":"シーン 965","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_965_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.965.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、学校の校門に来ると、ある車が門の前に止まっていた。\nすると、中からフランが降りてくる。","id":"F7257442-4DC7-454F-9F19-4270B502FFD0","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.132154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.198231292517007,"slideTitle":"スライド #966","title":"シーン 966","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_966_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.966.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「学校、お疲れ様、紅夢。とりあえず、車に乗って。」","id":"D49B769A-5B85-4571-AA08-B00FE74DCD02","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.198231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","bgmStartTimeOffset":0,"duration":8.954489795918366,"slideTitle":"スライド #967","title":"シーン 967","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_967_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.967.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"僕は、彼女にそう言われ、車に乗ると、数十分で高速に入る。\n「あの、フランさん、どこに行くのですか？」","id":"ECFDF5C3-D6F4-411E-B937-8EED234DB419","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.954489795918366},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","bgmStartTimeOffset":0,"duration":2.6419954648526076,"slideTitle":"スライド #968","title":"シーン 968","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_968_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.968.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「それは、向こうに着くまで秘密。」","id":"6F5446F5-0974-4CA6-8EDE-F2AE435EB20B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.6419954648526076},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","bgmStartTimeOffset":0,"duration":9.563242630385487,"slideTitle":"スライド #969","title":"シーン 969","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_969_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.969.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"僕は彼女にそう返され、前に向き直る。それから、僕はフランの隣の助手席で、ただぼーっと車窓を眺めるのだった。","id":"3CE4563A-D4C2-42C2-BCE6-C822452AB612","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":9.563242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg","bgmStartTimeOffset":0,"duration":8.25172335600907,"slideTitle":"スライド #970","title":"シーン 970","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_970_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image53.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.970.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、フランに連れられて、とある山間のキャンプ場に来ていた。そして、僕は、彼女にキャンプ用品を持ってきたかを聞く。","id":"F6E6E0BE-9DF8-4CE5-8CC4-8DE500388E3E","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.25172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg","bgmStartTimeOffset":0,"duration":8.641995464852608,"slideTitle":"スライド #971","title":"シーン 971","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_971_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image53.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.971.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「もちろん、持ってきたよ。」私はそう言い、車からテントなどのキャンプ用品を取り出し、テントの設営をする。","id":"F401E4B3-8FF1-415D-9B49-6A11BAA7A6D4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.641995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg","bgmStartTimeOffset":0,"duration":8.421292517006803,"slideTitle":"スライド #972","title":"シーン 972","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_972_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image53.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.972.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、数分から数十分の間、彼女は黙々と、テントの設営やキャンプの準備を進めていく。「何か手伝いますか？」","id":"D75962F5-BBE5-4D9E-A28B-CB039D7B1F50","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.421292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg","bgmStartTimeOffset":0,"duration":5.033242630385487,"slideTitle":"スライド #973","title":"シーン 973","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_973_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image53.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.973.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「いや、手伝わなくていいよ。そこらへんで座って、待ってて。」","id":"9DC33B1B-D6B8-49EC-A200-1AD24AFDD0A7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.033242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image53.jpeg","bgmStartTimeOffset":0,"duration":8.260430839002268,"slideTitle":"スライド #974","title":"シーン 974","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_974_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image53.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.974.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女がそう返すと、彼女の作業の邪魔にならない位置で、座って、その作業が終わるまで、周囲を見渡すのだった。","id":"D7429273-8644-41D1-B0F9-96BF3A2FDE1B","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.260430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":6.750884353741497,"slideTitle":"スライド #975","title":"シーン 975","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_975_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.975.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"テントの設営が終わり、夕日が静まると、フランはあらかじめ準備されていた食材とフライパンを焚き火の上に置く。","id":"3CE09FDB-30E7-4BB0-8918-FB8FD6F5A78F","seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.750884353741497},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":7.919478458049887,"slideTitle":"スライド #976","title":"シーン 976","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_976_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.976.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「今晩は、ステーキ丼だよ、紅夢。」\n私はそう言いながら、飯盒を乗せて、お肉を一緒に焼く。","id":"7B229E19-7699-4423-9FB3-812E61418F5B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":7.919478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":6.43,"slideTitle":"スライド #977","title":"シーン 977","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_977_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.977.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女がそういうと、焚き火の上に置かれた食材を眺める。そして、ふと空を見上げる。","id":"473583DA-4390-4E17-A6C0-E9E84746234E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.43},{"voice2StartTimeOffset":3.7212925170068027,"telop":"そこには、満点の星空が広がっていた。僕は、\nその星空を無言で、眺めていると、フランが声をかける。","seVolume":1,"characterName":"操夢","voiceDuration":3.7212925170068027,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","animationName":"なし","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"slideTitle":"スライド #978","bgmVolume":0.65,"duration":7.579546485260771,"backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.978.jpeg","id":"44926E72-B226-4531-B4B2-8AE5082154D5","voice2Character":"操夢","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_978_操夢_2.wav","bgmStartTimeOffset":0,"voice2Duration":3.858253968253968,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_978_操夢.wav","transitionName":"なし","title":"シーン 978"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","bgmStartTimeOffset":0,"duration":3.1244897959183673,"slideTitle":"スライド #979","title":"シーン 979","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_979_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.979.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「どう、満点の星空を見た感想は？」","id":"871AF4EF-288D-4287-ADB9-387B90D710F9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.1244897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","bgmStartTimeOffset":0,"duration":3.7539002267573696,"slideTitle":"スライド #980","title":"シーン 980","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_980_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.980.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「車を数時間走らせて、やってきた価値がありますよ。」","id":"CFAD253A-5366-4ED7-8E58-192E920FA823","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.7539002267573696},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","bgmStartTimeOffset":0,"duration":4.411995464852608,"slideTitle":"スライド #981","title":"シーン 981","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_981_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.981.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そうでしょ。それで、ご飯食べた後は、何する？」","id":"30765655-AE10-4CFF-BAA9-C97FC4FFAD3E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.411995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","bgmStartTimeOffset":0,"duration":3.682154195011338,"slideTitle":"スライド #982","title":"シーン 982","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_982_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.982.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですね…、僕は、フランさんの希望に合わせますよ。」","id":"0A76DCA6-8076-40D7-97BC-7FD8FE9626E0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.682154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","bgmStartTimeOffset":0,"duration":3.1744897959183676,"slideTitle":"スライド #983","title":"シーン 983","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_983_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.983.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…、ほら、そろそろご飯ができるよ。」","id":"A39DFA7E-A1E2-4D16-BE44-2360242C61CC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.1744897959183676},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":8.199546485260772,"slideTitle":"スライド #984","title":"シーン 984","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_984_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.984.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、視線を戻すと、彼女は、どこからか紙皿を取り出し、焼き上がった肉を乗せて、僕に渡す。","id":"0145FD03-4E6E-4DF3-99C8-532452B5F9F0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.199546485260772},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":10.511995464852607,"slideTitle":"スライド #985","title":"シーン 985","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_985_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.985.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ほら、出来たよ。」私はそう言い、紙皿に乗せたステーキを彼に渡すと、飯盒を取り、川の水に少しだけつけて、彼に渡す。","id":"6D01B1CF-612E-4E3F-8AED-B3FADEA66F09","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.511995464852607},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":7.976984126984127,"slideTitle":"スライド #986","title":"シーン 986","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_986_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.986.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「じゃあ、出来たのご飯、食べよ。」\n私は彼にそう言うと、私たちは、出来た料理を食べ進めた。","id":"F213031D-3C5C-402D-979E-8D1AEF2C9F93","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":7.976984126984127},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #987","title":"シーン 987: 二人は夕飯を終えると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.987.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"二人は夕飯を終えると…","id":"54BB2116-BF04-4492-BBAE-67DD5491AB3C","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":8.345215419501134,"slideTitle":"スライド #988","title":"シーン 988","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_988_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.988.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕と彼女は、夕飯を済ますと、飯盒だけ、水で軽く洗い、焚き火のそばに隣同士で座り、静寂の時間を過ごす。","id":"96189C58-6DE5-4F90-827F-EB88AEDB828E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.345215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":2.816984126984127,"slideTitle":"スライド #989","title":"シーン 989","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_989_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.989.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢は、キャンプをするのは初めて？」","id":"19678617-9F5B-47F8-8338-2A9B044AC1F3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.816984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":8.640861678004535,"slideTitle":"スライド #990","title":"シーン 990","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_990_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.990.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、僕の家は父しか車の運転ができなくて、その父は週6で働いていて、連休なんてのは、そんなに取れなかったので。」","id":"265F7CA4-D5EC-46D9-98CC-7A1DE99C7FB7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.640861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":3.3032426303854874,"slideTitle":"スライド #991","title":"シーン 991","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_991_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.991.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「へぇ…、それじゃあ、外出することはあった？」","id":"41272282-B699-49D8-BD51-B78571D2CD51","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.3032426303854874},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":7.703900226757369,"slideTitle":"スライド #992","title":"シーン 992","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_992_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.992.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「外出することも、滅多になかったです…、小さかった頃は学校の目の隙をついて、母と出かけることはありましたが…」","id":"B865F4EC-074F-4C38-9C79-0875721E0ABA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.703900226757369},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":7.703900226757369,"slideTitle":"スライド #993","title":"シーン 993","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_993_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.993.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそういっていると、頭痛が走る。","id":"6A0B92D4-C98E-468C-9D13-322562697145","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.703900226757369},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":6.543673469387755,"slideTitle":"スライド #994","title":"シーン 994","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_994_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.994.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"ある日、僕が登校してくると、周囲のクラスメイトから冷ややかな視線が向けられていることに気がつく。","id":"70BCC0AB-A96B-4D09-A23C-3208A8E041AA","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.543673469387755},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":3.45172335600907,"slideTitle":"スライド #995","title":"シーン 995","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_995_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.995.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、机の中に手を入れると、あるものを取り出す。","id":"01C7B85A-4BAC-4283-9B04-4046F8315365","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.45172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":3.7212925170068027,"slideTitle":"スライド #996","title":"シーン 996","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_996_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.996.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"その瞬間、周りからある囁き声が聞こえる…、それは…","id":"A7BE1CE0-8CAB-4CEA-89A5-782E99EF8809","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.7212925170068027},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":1.7294784580498865,"slideTitle":"スライド #997","title":"シーン 997","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_997_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.997.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、大丈夫？」","id":"A0AA53C9-5857-4574-A2CC-53536B42D474","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.7294784580498865},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":8.971995464852608,"slideTitle":"スライド #998","title":"シーン 998","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_998_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.998.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ええ、大丈夫です、嫌な記憶が一瞬蘇っただけですから…」\n本当はトラウマのフラッシュバックだったが、嘘をつく。","id":"FBC8C0B4-83C9-45E0-AD71-554040F19B3D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.971995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":3.0144897959183674,"slideTitle":"スライド #999","title":"シーン 999","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_999_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.999.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「顔が青ざめてるけど…大丈夫なの？」","id":"5078E051-0235-4B37-A960-435884FAD9D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.0144897959183674},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":3.4082539682539683,"slideTitle":"スライド #1000","title":"シーン 1000","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1000_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1000.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「すこしだけ、席を外しても、大丈夫ですか？」","id":"8A837681-B827-4170-B464-CB454C57F2A3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.4082539682539683},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":10.730748299319728,"slideTitle":"スライド #1001","title":"シーン 1001","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1001_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1001.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「もし、何かあるんだったら、私にいってね。」私は、不安が残りながら、彼にそう言うと、彼は、森林の中に入っていった。","id":"9D80A85E-3DFE-4AAD-BF06-8AA8129C8832","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.730748299319728},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1002","title":"シーン 1002: その頃、某所では…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1002.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"その頃、某所では…","id":"8B5CA0C7-3BBA-4CDD-A3F5-8602580195CC","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":4.115079365079365,"slideTitle":"スライド #1003","title":"シーン 1003","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1003_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1003.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私は、一人自室で、くつろいでいると、二人の様子が見える。","id":"7D85DD56-84A7-491F-9801-0D1C2BCF21D5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.115079365079365},{"voice2StartTimeOffset":2.633832199546485,"telop":"「一体何があったの…、フラン…、