r_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.729.jpeg","voiceDuration":2.5719954648526078,"seVolume":1},{"id":"062844F0-0DEA-4E3B-9A81-D22EE1FD2BD5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_730_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"僕が、その返答に悩んでいると、\nレミリアが僕たちに、ある言葉を突きつけていくのだった。","voiceCharacter":"操夢","duration":6.015850340136055,"title":"シーン 730","slideTitle":"スライド #730","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.730.jpeg","voiceDuration":6.015850340136055,"seVolume":1},{"id":"B443BAB2-9207-4052-8346-BE71283D49FC","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_731_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"あの後、僕たちは二人で入浴する羽目になり、僕たちの間には気まずさを超えた、冷たい空気が漂いながら、夕飯を迎えた。","voiceCharacter":"操夢","duration":8.712607709750566,"title":"シーン 731","slideTitle":"スライド #731","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.731.jpeg","voiceDuration":8.712607709750566,"seVolume":1},{"id":"799BCC76-7B13-4E7E-9B96-660867DF0AA6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_732_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「それじゃあ、夕飯を食べましょうか。」\n私は、そう二人に言うが、二人からの反応は返ってこない。","voiceCharacter":"レミリア・スカーレット","duration":6.5088208616780046,"title":"シーン 732","slideTitle":"スライド #732","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.732.jpeg","voiceDuration":6.5088208616780046,"seVolume":1},{"id":"2A6DCCCB-056F-407B-8D20-0F23F933D87D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_733_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「早く、夕飯食べないと、料理が冷めちゃうわよ。」","voiceCharacter":"レミリア・スカーレット","duration":3.2879818594104306,"title":"シーン 733","slideTitle":"スライド #733","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.733.jpeg","voiceDuration":3.2879818594104306,"seVolume":1},{"id":"B8897236-1814-4AAD-88AB-8C070DF24801","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_734_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"僕たちは、彼女にそう告げられ、仕方なく料理に手を伸ばす。だが、先ほどまでの出来事が頭から離れなかった。","voiceCharacter":"操夢","duration":7.911519274376417,"title":"シーン 734","slideTitle":"スライド #734","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.734.jpeg","voiceDuration":7.911519274376417,"seVolume":1},{"id":"5D9AE2FB-9671-4736-9BB4-E0405D13FAEB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_735_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"僕はそれから、機械的に食べ進めて、\n食事を終えると、彼女が突如として、声をかけてくる。","voiceCharacter":"操夢","duration":6.534331065759638,"title":"シーン 735","slideTitle":"スライド #735","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.735.jpeg","voiceDuration":6.534331065759638,"seVolume":1},{"id":"90FB545D-BA93-4A98-A94C-A315E8D8E4A9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_736_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「さてと、そろそろデザートの時間にしましょうか。」\n私はそう二人に告げて、そっと席を立つ。","voiceCharacter":"レミリア・スカーレット","duration":6.177573696145124,"title":"シーン 736","slideTitle":"スライド #736","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.736.jpeg","voiceDuration":6.177573696145124,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/噛みつく.mp3","id":"7CC03BC6-87E1-467D-B5D0-072E8023038B","seStartTimeOffset":2.18,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_737_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"僕がふとフランの方に視線をやると、彼女が驚いた。\nそれと同時、首筋に誰かが、噛み付いてくる。","voiceCharacter":"操夢","duration":7.321292517006802,"title":"シーン 737","slideTitle":"スライド #737","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 噛みつく","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.737.jpeg","voiceDuration":7.321292517006802,"seVolume":0.85867919921875},{"id":"0A4A9E7A-D47A-4CD1-B8FF-109E8A60F493","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_738_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"そして、僕がその行為が何であるかを把握するうちに、\n僕の意識が闇の中へ、落ちていくのだった。","voiceCharacter":"操夢","duration":6.500634920634921,"title":"シーン 738","slideTitle":"スライド #738","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.738.jpeg","voiceDuration":6.500634920634921,"seVolume":1},{"id":"2E83653F-9DDA-49B1-B784-885685C5C696","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_739_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"私は、ふと周囲を見渡すと、一方には、先日レミリアと名乗っていた人物、もう一方にはその妹がいた。するとレミリアが話しかけてくる。","voiceCharacter":"サブ","duration":9.838684807256236,"title":"シーン 739","slideTitle":"スライド #739","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.739.jpeg","voiceDuration":9.838684807256236,"seVolume":1},{"id":"F3D601FC-8F94-4F20-B0B2-D2B8A07A62BF","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_740_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「あら、ご機嫌用、今のご気分はいかがですか？」","voiceCharacter":"レミリア・スカーレット","duration":3.1671655328798187,"title":"シーン 740","slideTitle":"スライド #740","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.740.jpeg","voiceDuration":3.1671655328798187,"seVolume":1},{"id":"C09A1596-71AB-4A1E-9087-C19AB5650420","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_741_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「普段と変わらない…とでも言っておきましょうか…。」","voiceCharacter":"サブ","duration":2.962607709750567,"title":"シーン 741","slideTitle":"スライド #741","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.741.jpeg","voiceDuration":2.962607709750567,"seVolume":1},{"id":"444DBAA6-F7BB-4CDF-BE13-9FC5032A8645","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_742_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「そうですか。確か私とあなたが対面するのは、あの深夜帯の学校以来ですね。あれから、彼に何か変化はありましたか？」","voiceCharacter":"レミリア・スカーレット","duration":8.450498866213152,"title":"シーン 742","slideTitle":"スライド #742","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.742.jpeg","voiceDuration":8.450498866213152,"seVolume":1},{"id":"979C6804-F312-462D-A3F5-510C2A80D138","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_743_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「それより、あなたの妹さんが、\n先ほどから固まってますけど、大丈夫でしょうか？」","voiceCharacter":"サブ","duration":5.662607709750567,"title":"シーン 743","slideTitle":"スライド #743","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.743.jpeg","voiceDuration":5.662607709750567,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/軽いパンチ1.mp3","id":"C4D37735-A58F-4049-9C14-19F3C040B6A3","seStartTimeOffset":1.43,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_744_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「あら、それは失礼」私はそう言いながら、フランに軽いパンチをする。「しっかりしなさい、彼女は彼の裏に潜んでるのよ。」","voiceCharacter":"レミリア・スカーレット","duration":7.706734693877551,"title":"シーン 744","slideTitle":"スライド #744","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"seName":"SE: 軽いパンチ1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.744.jpeg","voiceDuration":7.706734693877551,"seVolume":0.85},{"id":"19A45891-D932-413D-9059-9691A8F33B8D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（弱る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_745_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"彼女が、妹のフランにパンチをすると、表情が変わる。","voiceCharacter":"サブ","duration":3.8756462585034015,"title":"シーン 745","slideTitle":"スライド #745","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.745.jpeg","voiceDuration":3.8756462585034015,"seVolume":1},{"id":"355247F5-776D-48EE-8CD7-DFC473716625","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_746_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「フラン、ああ見えても、彼女と彼は同一人物なのよ。\nだから、気をしっかり持って、接しなさい。」","voiceCharacter":"レミリア・スカーレット","duration":6.756145124716554,"title":"シーン 746","slideTitle":"スライド #746","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.746.jpeg","voiceDuration":6.756145124716554,"seVolume":1},{"id":"E045DF2C-DA11-4B17-8ABF-3EEA48A5B793","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_747_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「そう…なんだ…」私はそう呟く。","voiceCharacter":"フランドール・スカーレット","duration":3.0694784580498866,"title":"シーン 747","slideTitle":"スライド #747","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.747.jpeg","voiceDuration":3.0694784580498866,"seVolume":1},{"id":"A0C6ACCA-EF65-4EC6-8F2A-9B4F2EF29D1D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_748_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「それで、私を呼び出したと言うことは、\n何かしらの事情があるのですね？」","voiceCharacter":"サブ","duration":4.812607709750567,"title":"シーン 748","slideTitle":"スライド #748","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.748.jpeg","voiceDuration":4.812607709750567,"seVolume":1},{"id":"816BFD46-7DC4-4A67-B32F-5402AC9EE6BA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_749_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「ええそうよ。」私はそう言うと、\n事前に用意してあった、書面を彼女の方へとスライドさせる。","voiceCharacter":"レミリア・スカーレット","duration":6.09156462585034,"title":"シーン 749","slideTitle":"スライド #749","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.749.jpeg","voiceDuration":6.09156462585034,"seVolume":1},{"id":"8DDD4516-7E18-4CF2-8275-86FAB6FF811D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_750_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「その書面を挟んでいるボールペンで、サインを頂けるかしら。」","voiceCharacter":"レミリア・スカーレット","duration":3.702562358276644,"title":"シーン 750","slideTitle":"スライド #750","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.750.jpeg","voiceDuration":3.702562358276644,"seVolume":1},{"id":"F0A9B5C3-9317-4652-AC47-9C454AA9FB06","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_751_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"その書面には、先日の深夜帯に交わした契約を記したものと、フランの名前が記載された、婚姻届が挟まれてあった。","voiceCharacter":"サブ","duration":8.235419501133787,"title":"シーン 751","slideTitle":"スライド #751","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.751.jpeg","voiceDuration":8.235419501133787,"seVolume":1},{"id":"9E2F2B04-E966-4918-A7FC-773A148D5E5B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_752_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「婚姻届の方は、まだ仮の状態よ。だから、あなたがサインしても、彼が拒絶すれば、無効。それで、返答はどうかしら？」","voiceCharacter":"レミリア・スカーレット","duration":9.092154195011338,"title":"シーン 752","slideTitle":"スライド #752","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.752.jpeg","voiceDuration":9.092154195011338,"seVolume":1},{"id":"BEA8A1AE-D0AE-4260-B671-279F0047F799","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_753_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"私はふと考える、この機を逃せば、2度とこの書面を見れない気がした。そして、ペンを手に取ると、サインをして返す。","voiceCharacter":"サブ","duration":8.121292517006802,"title":"シーン 753","slideTitle":"スライド #753","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.753.jpeg","voiceDuration":8.121292517006802,"seVolume":1},{"id":"4A8DD2F2-2DAE-446E-ADAA-52767389D67B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_754_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「フラン、この書類のコピーを取ってきなさい。」\n私はそう言い、書類とペンを渡す。","voiceCharacter":"レミリア・スカーレット","duration":5.356734693877551,"title":"シーン 754","slideTitle":"スライド #754","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.754.jpeg","voiceDuration":5.356734693877551,"seVolume":1},{"id":"3AB55218-7DDE-48C0-8BC8-956C350A30BD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_755_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「夕方からのあなたの発言や所作は、私が表に出てくるように仕向けた手順なのですか？」私は確認のために、そう尋ねる。","voiceCharacter":"サブ","duration":8.982154195011338,"title":"シーン 755","slideTitle":"スライド #755","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.755.jpeg","voiceDuration":8.982154195011338,"seVolume":1},{"id":"4ACFDD63-006E-4775-9757-1C2907D3300A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_756_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196982_食堂(夜2).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","telop":"「ええ、そうよ。彼は見事に、引っかかってくれたわ。\nそれで、あなたはこれからどうするのかしら？」","voiceCharacter":"レミリア・スカーレット","duration":6.585895691609977,"title":"シーン 756","slideTitle":"スライド #756","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.756.jpeg","voiceDura