/元女子校の日常総集編\/永琳（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2054_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc166698_病院の診察室.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","telop":"「そう…、それでさっきまで見てた夢は分かるかしら？」","voiceCharacter":"八意永琳","duration":3.503401360544218,"title":"シーン 2054","slideTitle":"スライド #2054","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2054.jpeg","voiceDuration":3.503401360544218,"seVolume":1},{"id":"B325BFC7-0424-41B3-A6DB-82FC77F64AF1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2055_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc166698_病院の診察室.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","telop":"「多分こいしさんがいうに、悪い夢だったんだと思います。」","voiceCharacter":"操夢","duration":3.599546485260771,"title":"シーン 2055","slideTitle":"スライド #2055","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2055.jpeg","voiceDuration":3.599546485260771,"seVolume":1},{"id":"A29DD3D6-B5FF-4CBA-8502-607595720ED4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2056_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc166698_病院の診察室.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","telop":"「それで、あなたの考えは？」","voiceCharacter":"八意永琳","duration":2.183015873015873,"title":"シーン 2056","slideTitle":"スライド #2056","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2056.jpeg","voiceDuration":2.183015873015873,"seVolume":1},{"id":"7689193D-83A0-4CF4-A565-FFA62E8269C2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2057_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc166698_病院の診察室.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","telop":"「いや…夢の内容を覚えているわけではないので…」","voiceCharacter":"操夢","duration":3.1169387755102043,"title":"シーン 2057","slideTitle":"スライド #2057","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2057.jpeg","voiceDuration":3.1169387755102043,"seVolume":1},{"id":"BB932024-7EDC-4DFA-A4AA-AF6FCEE02B74","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（微笑）.png","transitionName":