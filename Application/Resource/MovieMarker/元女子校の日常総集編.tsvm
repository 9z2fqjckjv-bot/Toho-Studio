元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1436.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、暇つぶしにテレビをつける。だが、なんだかどの番組をつまらなく感じ、すぐに消すと、ベッドに腰掛けぼーっとする。","id":"10DBF0B2-F48D-4805-A1DA-4FC6B415B3D5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.40607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":4.536507936507936,"slideTitle":"スライド #1437","title":"シーン 1437","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1437_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1437.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、突如として部屋の電話が鳴り、受話器を取る。\n「もしもし…」","id":"82407928-E137-46EC-87BF-A3922A5784E8","seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.536507936507936},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":7.9865079365079366,"slideTitle":"スライド #1438","title":"シーン 1438","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1438_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1438.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、そう言うと、相手はこのホテルのロビーにいる従業員で、フランたちがいる屋敷から電話が来て、繋げるかを聞いてきた。","id":"B7C70D3B-DBB4-4872-A2D1-E45D78624AFD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.9865079365079366},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":7.313673469387755,"slideTitle":"スライド #1439","title":"シーン 1439","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1439_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1439.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、特に問題なく、了承すると通話相手が変わる。\nそして、聞こえてきたのは、フランの声だった。","id":"C448F2E1-175E-4E1F-B57E-1AE5D2DDEB6C","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.313673469387755},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":2.846984126984127,"slideTitle":"スライド #1440","title":"シーン 1440","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1440_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1440.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ねぇ、紅夢、今は何してるの？」","id":"ED8196A5-720E-4AE0-B991-49DAD09A8DD7","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.846984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":7.7365079365079366,"slideTitle":"スライド #1441","title":"シーン 1441","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1441_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1441.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ…？」僕は、その問いに思わずそう返してしまう。\n「確か、昨日、留守電を残していったはずなんですけど…」","id":"D767B7EF-8E42-4775-BD98-5F448683C528","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.7365079365079366},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":1.9394784580498867,"slideTitle":"スライド #1442","title":"シーン 1442","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1442_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1442.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「えっ…、ちょっと待ってて。」","id":"AB32D53A-69BA-4041-8BD3-0967B8E6EECC","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.9394784580498867},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":5.714761904761905,"slideTitle":"スライド #1443","title":"シーン 1443","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1443_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1443.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女がそう呟くと、保留音がなる。\nすると、浴室の扉が開く音がする。","id":"99C2EEA2-FE8C-4F0C-95D8-5483ECFEF843","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.714761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":8.101723356009071,"slideTitle":"スライド #1444","title":"シーン 1444","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1444_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1444.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/えっ」.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、浴室から服を一切着ていない、裸の彼女が出てきた。\n「…」僕と彼女は、数秒間の無言の時間を過ごす。","id":"61DB9645-C000-4295-9410-8D0B854FE4B8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.101723356009071},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":2.360204081632653,"slideTitle":"スライド #1445","title":"シーン 1445","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1445_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1445.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/やられ頬照り驚き.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ぎゃーーーーーーーーーーーーーーーーーー！」","id":"85262DF8-6478-4D27-B483-E7EAA535CA02","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.360204081632653},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":8.635419501133788,"slideTitle":"スライド #1446","title":"シーン 1446","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1446_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1446.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言うと、彼女の荷物から何かを取り出し、全力疾走で浴室に戻って行った。そして僕は、受話器を耳に充てる。","id":"853AD42E-F0AB-4969-9B20-CA5683101B31","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.635419501133788},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":1.7932426303854876,"slideTitle":"スライド #1447","title":"シーン 1447","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1447_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1447.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ちょっと、聞こえるの？」","id":"30FB5F7D-CA02-470D-BC85-44F1215C51F6","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.7932426303854876},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":3.5104308390022676,"slideTitle":"スライド #1448","title":"シーン 1448","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1448_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1448.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、聞こえますよ。それで、どうしたんですか？」","id":"9A18D5E7-8CC9-441C-BCE4-35117E07B229","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.5104308390022676},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":9.346984126984127,"slideTitle":"スライド #1449","title":"シーン 1449","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1449_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1449.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…、確かにお姉様と一緒に、確認したら留守電が入ってたけど…、次に同じようなことがあったら…お仕置きだからね…」","id":"242EAE44-C622-40D7-9489-805BE3909C4A","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":9.346984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":3.6039002267573697,"slideTitle":"スライド #1450","title":"シーン 1450","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1450_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1450.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…。それで、なんで電話をかけたんですか？」","id":"FE59288C-8CAF-42DE-AA21-14DCC29F8FCE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.6039002267573697},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":8.338231292517007,"slideTitle":"スライド #1451","title":"シーン 1451","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1451_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1451.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「えっと…それは…、それよりそんなことより、さっき何かあった