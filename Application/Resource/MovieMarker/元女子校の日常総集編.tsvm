","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.542154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":2.838684807256236,"slideTitle":"スライド #1050","title":"シーン 1050","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1050_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1050.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「僕も、レミリアさんの意見に賛成です。」","id":"29DB37E0-CBF8-49E9-8C50-DEFD2B64E098","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.838684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":3.2019954648526077,"slideTitle":"スライド #1051","title":"シーン 1051","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1051_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1051.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「私も、お姉様の言う通りだと思う。」","id":"905DEFC7-75EE-4466-9BFE-188127E7F0FD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.2019954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":6.444240362811791,"slideTitle":"スライド #1052","title":"シーン 1052","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1052_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1052.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「それじゃあ、とりあえず森から抜け出しましょうか。」\n私はそう言い、二人と共に、森を抜け出した。","id":"1B9DFFD6-7D5E-497B-B646-98A963A522F0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.444240362811791},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1053","title":"シーン 1053: それから…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1053.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それから…","id":"C89AABA2-F271-45F9-80D6-308F856DAF7A","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","bgmStartTimeOffset":0,"duration":9.014761904761905,"slideTitle":"スライド #1054","title":"シーン 1054","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1054_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1054.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それから、家に戻り、食堂で昼食をとっていると、二人は互いの記憶を擦り合わせ、僕にどこまで覚えてるか尋ねる。","id":"CC68C314-3087-4C95-91C0-DB6B5C6144DE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.014761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","bgmStartTimeOffset":0,"duration":3.436984126984127,"slideTitle":"スライド #1055","title":"シーン 1055","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1055_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1055.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ねぇ、紅夢、あなたはどこまで覚えてるの？」","id":"4B64214D-7B4B-4B04-913E-DFEB5B20E14F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.436984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196