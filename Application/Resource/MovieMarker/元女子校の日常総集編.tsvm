io\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":4.006077097505669,"slideTitle":"スライド #1454","title":"シーン 1454","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1454_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1454.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こいし、古明地こいしさんですよ。それがどうしたんですか？」","id":"4FFC0549-2949-439E-8B5F-57159DE3A9B9","seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.006077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":3.9044897959183675,"slideTitle":"スライド #1455","title":"シーン 1455","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1455_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1455.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「まさか…、彼女の裸なんて見てるわけじゃないよね…？」","id":"03A53CD1-F477-4153-8B19-E2CFF43989A8","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.9044897959183675},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":8.070204081632653,"slideTitle":"スライド #1456","title":"シーン 1456","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1456_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1456.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「さっき、こいしさんが素っ裸で、浴室から出てきて、\n数秒の間の後、全力疾走で浴室に戻ってましたよ。」","id":"5150B16F-B2C6-4083-BA65-19C6F0A375BD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.070204081632653},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":4.286984126984127,"slideTitle":"スライド #1457","title":"シーン 1457","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1457_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1457.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「この…、バカ…！とにかく、電話切らずに待ってなさい！」","id":"0ECD67EA-4279-45C7-A2C1-30EEF370FADA","seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.286984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":8.25172335600907,"slideTitle":"スライド #1458","title":"シーン 1458","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1458_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1458.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ…」僕がそう呟くと再び保留音が流れる。「一体、どうしたって言うんだろう…」僕は、そう単純な疑問を抱く。","id":"BAD60113-609D-44A0-AE7D-71F60DCF3659","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.25172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":1.0452834467120182,"slideTitle":"スライド #1459","title":"シーン 1459","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1459_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1459.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り説教.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「このバカ！」","id":"752852CB-0CB4-43F2-AE41-A9F9D365FDBA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.0452834467120182},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","bgmStartTimeOffset":0,"duration":8.171292517006803,"slideTitle":"スライド #1460","title":"シーン 1460","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1460_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image60.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.