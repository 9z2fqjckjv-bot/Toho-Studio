Title":"スライド #1846","title":"シーン 1846","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1846_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1846.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女に本を手渡そうとすると、呪いにかかったかのように、目の前に魔理沙の姿が現れ、警告をしていた。","id":"0EA75D22-D8E7-4CCB-87B7-3C74F96FB996","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.919115646258503},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.131995464852608,"slideTitle":"スライド #1847","title":"シーン 1847","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1847_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1847.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ねぇ、聞いてるの？その本、渡してくれない？」","id":"C485AB64-46DE-49FE-B288-A0B12E254938","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.131995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.069115646258504,"slideTitle":"スライド #1848","title":"シーン 1848","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1848_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1848.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いや、今は渡せないです。帰ってきてからでもいいですか？」","id":"F3AEC698-E09D-44B7-A2F8-A391AF591F8F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.069115646258504},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":5.9432426303854875,"slideTitle":"スライド #1849","title":"シーン 1849","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1849_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1849.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「えっ？」私が、そう呟いていると、\nいつの間にか彼は部屋を出ていった。","id":"84976C34-312C-4B55-ADE5-C6203AEAC948","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.9432426303854875},{"backgro