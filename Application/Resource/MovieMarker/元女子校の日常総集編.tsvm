11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1475_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「ええ、そうよ。本当は彼には関係ない、内部事情だったけど…、状況が打って変わって、彼も関係者になったの。」","voiceCharacter":"古明地こいし","duration":10.43342403628118,"title":"シーン 1475","slideTitle":"スライド #1475","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1475.jpeg","voiceDuration":10.43342403628118,"seVolume":1},{"id":"D2EDEF8A-FCE7-4BC0-B5A1-9F7DB30DAFC0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1476_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「それって、どういうこと？」","voiceCharacter":"古明地さとり","duration":1.4000907029478458,"title":"シーン 1476","slideTitle":"スライド #1476","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1476.jpeg","voiceDuration":1.4000907029478458,"seVolume":1},{"id":"0F358D5D-BFCF-4318-B90A-385E20C8766C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1477_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「彼が…、私の裸を見たのよ…」\n私は、羞恥心を堪えながら、姉にそう返す。","voiceCharacter":"古明地こいし","duration":7.636462585034014,"title":"シーン 1477","slideTitle":"スライド #1477","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1477.jpeg","voiceDuration":7.636462585034014,"seVolume":1},{"id":"E899A492-F65E-425F-8758-DD518F5330C1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1478_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「それ本当なの…？」","voiceCharacter":"古明地さとり","duration":0.98859410430839,"title":"シーン 1478","slideTitle":"スライド #1478","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1478.jpeg","voiceDuration":0.98859410430839,"seVolume":1},{"id":"DE569372-9455-4E40-A454-9B7088EE7420","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1479_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「ええそうよ…、しかも、確定ではないけど、彼には副人格があって、その人格のときに、某建設会社の嬢の許嫁になるって…」","voiceCharacter":"古明地こいし","duration":11.65578231292517,"title":"シーン 1479","slideTitle":"スライド #1479","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1479.jpeg","voiceDuration":11.65578231292517,"seVolume":1},{"id":"06BE14F0-7038-4B65-9325-5354F4C9D895","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1480_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「ねぇ、もっと詳しい話を聞かせてくれない…、これは私とあなたの将来と私たちのグループに関わる出来事だから…」","voiceCharacter":"古明地さとり","duration":5.9209977324263035,"title":"シーン 1480","slideTitle":"スライド #1480","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1480.jpeg","voiceDuration":5.9209977324263035,"seVolume":1},{"id":"999CA9D0-95B6-4916-9956-22841989D3A4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1481_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「ええ。」私は、彼が私の裸を見るまでは…、ただ甘えたい時に甘えられていた…、だが今となっては、それは過去の話だった。","voiceCharacter":"古明地こいし","duration":11.26766439909297,"title":"シーン 1481","slideTitle":"スライド #1481","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1481.jpeg","voiceDuration":11.26766439909297,"seVolume":1},{"id":"C661575E-90C3-4CFB-810C-60012DDF3FF0","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間：1.5秒","telop":"一方彼は…","duration":1.5,"title":"シーン 1482: 一方彼は…","slideTitle":"スライド #1482","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1482.jpeg","seVolume":1},{"id":"161210BA-1CEA-4BB9-A06F-DB8787577814","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1483_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc283172_商店街（夜）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283172_商店街（夜）.jpg","telop":"僕は、彼女が長電話をする中、なんとなく気まずくなり、\n部屋を出て、夜の国際通りを歩いていた。","voiceCharacter":"操夢","duration":6.9039002267573695,"title":"シーン 1483","slideTitle":"スライド #1483","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1483.jpeg","voiceDuration":6.9039002267573695,"seVolume":1},{"id":"8A2AB17D-7511-42D7-8248-C9BF2B951FE6","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1484_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc283172_商店街（夜）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283172_商店街（夜）.jpg","telop":"そして、しばらく歩いていると、ある予感がする。","voiceCharacter":"操夢","duration":3.0973696145124716,"title":"シーン 1484","slideTitle":"スライド #1484","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1484.jpeg","voiceDuration":3.0973696145124716,"seVolume":1},{"id":"5BAF05A7-C628-42C4-8BC4-1A55047E4E65","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1485_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"そして、僕は国際通りから少し離れた屋台が立ち並ぶ場所に来た。そして、屋台の間の通路を歩き進んでいく。","voiceCharacter":"操夢","duration":8.063242630385487,"title":"シーン 1485","slideTitle":"スライド #1485","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1485.jpeg","voiceDuration":8.063242630385487,"seVolume":1},{"id":"D52D6C1B-7350-4B13-A05E-328FC9008F8E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1486_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"すると、見事にその予感は当たり、頬照り、困った様子で、生ビールとおつまみらしきものを嗜む彼女の姿があった。","voiceCharacter":"操夢","duration":8.094126984126984,"title":"シーン 1486","slideTitle":"スライド #1486","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1486.jpeg","voiceDuration":8.094126984126984,"seVolume":1},{"id":"E81A2970-2794-4D08-A708-5A4162753529","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1487_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"すると、彼女は僕の存在に気がついたのか、驚いた表情をする。","voiceCharacter":"操夢","duration":4.586507936507936,"title":"シーン 1487","slideTitle":"スライド #1487","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1487.jpeg","voiceDuration":4.586507936507936,"seVolume":1},{"id":"9510375F-C948-4105-8C77-CCA233420880","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1488_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"「どうしたの…、紅夢くん…、高校生が来る場所じゃないわよ、ここは…、何か困ったことでもあったの？」","voiceCharacter":"操夢","duration":6.5147619047619045,"title":"シーン 1488","slideTitle":"スライド #1488","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1488.jpeg","voiceDuration":6.5147619047619045,"seVolume":1},{"id":"D5C3228D-4B38-40BE-AB1E-AD60702B55B9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1489_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"「アリスさん、その生ビールは何杯目ですか？」僕は、ジョッキグラスの半分ほど残っている、生ビールを見て言う。","voiceCharacter":"操夢","duration":7.499546485260771,"title":"シーン 1489","slideTitle":"スライド #1489","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1489.jpeg","voiceDuration":7.499546485260771,"seVolume":1},{"id":"ADC622A4-E7D0-44EE-BCE8-6F0838C15D9E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1490_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"「そんなことは、どうだっていいのよ…、それより彼女たちはどうしたのよ…、ここにいないならホテルにいるのでしょ？」","voiceCharacter":"操夢","duration":6.63,"title":"シーン 1490","slideTitle":"スライド #1490","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1490.jpeg","voiceDuration":6.63,"seVolume":1},{"id":"B80858E7-C408-4BE8-9260-1F8DEAFB25F5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1491_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"彼女がそう言うと、カウンター越しに、お店の人が驚いた様子で僕を見る。僕は、慌てて首を横に振り、あることを聞く。","voiceCharacter":"操夢","duration":8.419115646258504,"title":"シーン 1491","slideTitle":"スライド #1491","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1491.jpeg","voiceDuration":8.419115646258504,"seVolume":1},{"id":"724A0CD0-034C-4729-8D70-179925F641B8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1492_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"「彼女が飲んでいるお酒は、今何杯目ですか？」","voiceCharacter":"操夢","duration":3.1604308390022675,"title":"シーン 1492","slideTitle":"スライド #1492","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1492.jpeg","voiceDuration":3.1604308390022675,"seVolume":1},{"id":"C86EB5A6-FC33-44B9-89F8-08C6742C9057","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1493_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"僕がそう聞くと、その人は、ひっそりと指を立てる。\nその指は3本だった。僕は、それで価格に見当がつく。","voiceCharacter":"操夢","duration":8.191950113378685,"title":"シーン 1493","slideTitle":"スライド #1493","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1493.jpeg","voiceDuration":8.191950113378685,"seVolume":1},{"id":"0D4B3795-D053-4684-805E-25BB89705FBE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1494_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"そして、部屋から背負ってきたバックから財布を取り出す。\n「代金は、3000円ですよね…？」","voiceCharacter":"操夢","duration":5.788684807256236,"title":"シーン 1494","slideTitle":"スライド #1494","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1494.jpeg","voiceDuration":5.788684807256236,"seVolume":1},{"id":"F6B8EFB9-08A6-49AB-B9D2-72047EAEBD65","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1495_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image67.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image67.jpeg","telop":"すると、その人は驚いた様子をするが、\nハッと気を取り直し、お金を受け取り、笑って見せた。","voiceCharacter":"操夢","duration":6.345215419501134,"title":"シーン 1495","slideTitle":"スライド #1495","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1495.jpeg","voiceDuration":6.345215419501134,"seVolume":1},{"id":"D91A8BDA-7EF3-4491-8341-2441165E7EEB","seStartTimeOffset":0,"animatio