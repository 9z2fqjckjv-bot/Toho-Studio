ndImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"そして、とりあえず、互いに入浴を済ませることにし、\n今は、こいしが先に入っているところだった。","voiceCharacter":"操夢","duration":6.585419501133787,"title":"シーン 1435","slideTitle":"スライド #1435","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1435.jpeg","voiceDuration":6.585419501133787,"seVolume":1},{"id":"10DBF0B2-F48D-4805-A1DA-4FC6B415B3D5","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1436_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"僕は、暇つぶしにテレビをつける。だが、なんだかどの番組をつまらなく感じ、すぐに消すと、ベッドに腰掛けぼーっとする。","voiceCharacter":"操夢","duration":8.40607709750567,"title":"シーン 1436","slideTitle":"スライド #1436","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1436.jpeg","voiceDuration":8.40607709750567,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/電話の着信音.mp3","id":"82407928-E137-46EC-87BF-A3922A5784E8","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1437_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"すると、突如として部屋の電話が鳴り、受話器を取る。\n「もしもし…」","voiceCharacter":"操夢","durat