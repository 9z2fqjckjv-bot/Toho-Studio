e1ac7.1983.jpeg","voiceDuration":7.373401360544218,"seVolume":1},{"id":"29148C18-EC3E-4B81-B428-027083E85E61","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（不満）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1984_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「えっ？ でも、これまでの人生では、勉強しているだけで、相手の気持ちなんか考えなくても問題などなかったんですが…」","voiceCharacter":"操夢","duration":8.424126984126984,"title":"シーン 1984","slideTitle":"スライド #1984","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1984.jpeg","voiceDuration":8.424126984126984,"seVolume":1},{"id":"907D4E3C-47FC-40A1-B712-29B17D6D40E8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（不満）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1985_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「まぁ、さっきの発言は聞かなかったことにするから、\nあなたはもっと…、こう、なんて言うのかしら…」","voiceCharacter":"レミリア・スカーレット","duration":6.033242630385487,"title":"シーン 1985","slideTitle":"スライド #1985","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1985.jpeg","voiceDuration":6.033242630385487,"seVolume":1},{"id":"3098BAB6-F661-4D7A-8EC4-A3753E0A4102","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1986_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「私から言うのなんだけど、紅夢は乙女心っていうものを知るべきだと思うよ。ただ、本読んだり勉強だけするんじゃなくて。」","voiceCharacter":"フランドール・スカーレット","duration":9.171995464852607,"title":"シーン 1986","slideTitle":"スライド #1986","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1986.jpeg","voiceDuration":9.171995464852607,"seVolume":1},{"id":"4D3C47F8-016D-4649-8B21-3D5D8C1932B8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1987_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"「乙女心ですか…」僕はしばらく考えるが、ふと思い出す。「それより、先にこいしを探して、見つけ出さないと…」","voiceCharacter":"操夢","duration":7.788684807256236,"title":"シーン 1987","slideTitle":"スライド #1987","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2Start