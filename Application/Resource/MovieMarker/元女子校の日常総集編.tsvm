,"title":"シーン 1317","slideTitle":"スライド #1317","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"[SE] 海岸1.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1317.jpeg","voiceDuration":7.464761904761905,"seVolume":0.1530708016074449},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","id":"6DA2EBA4-F1FC-41A6-8F12-391AB8C234B1","seStartTimeOffset":-116.90873015872876,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1318_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image59.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","telop":"「とりあえず、車に戻りませんか？\nこのままだと、紅夢さんが風邪ひきそうですし」","voiceCharacter":"古明地さとり","duration":4.47219954648526,"title":"シーン 1318","slideTitle":"スライド #1318","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"seName":"[SE] 海岸1.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1318.jpeg","voiceDuration":4.47219954648526,"seVolume":0.1530708016074449},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","id":"75CE1ED5-33D7-4241-B027-D94077447AEA","seStartTimeOffset":-121.38092970521393,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/T