常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.781.jpeg","voiceDuration":0.665079365079365,"seVolume":1},{"id":"EE53A805-DCE5-4345-8F93-3E9707892B9B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_782_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc235081_家（夜・灯りあり）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","telop":"私は、それを思い出すと、その場で中身を見る。そこには、婚姻届のコピーがあった。私はそれを見ると、寝室に向かう。","voiceCharacter":"博麗霊夢","duration":10.433242630385488,"title":"シーン 782","slideTitle":"スライド #782","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.782.jpeg","voiceDuration":10.433242630385488,"seVolume":1},{"id":"A14A1772-C7DD-4B6A-9352-9AE31983D47D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_783_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","telop":"そして、魔理沙が家に来る前に取り出した、息子の部屋にあった書類や荷物、そして過去の記録物を取り出し、中身を確認する。","voiceCharacter":"博麗霊夢","duration":9.786984126984127,"title":"シーン 783","slideTitle":"スライド #783","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.783.jpeg","voiceDuration":9.786984126984127,"seVolume":1},{"id":"C0728986-B498-4CA5-969F-446B46AE8D94","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_784_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","telop":"その中身にある文字と、婚姻届の文字を比較する。どうやら、彼が書いたわけではなかった。「もしかしたら…」","voiceCharacter":"博麗霊夢","duration":8.685736961451248,"title":"シーン 784","slideTitle":"スライド #784","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.784.jpeg","voiceDuration":8.685736961451248,"seVolume":1},{"id":"B58DE3E8-5FA8-411D-B1D6-E7996F03EE6A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_785_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","telop":"私は、取り出した書類や荷物の中から、入念深く探す。すると、あるものを見つける。その文字と婚姻届の文字は似通っていた。","voiceCharacter":"博麗霊夢","duration":11.076984126984128,"title":"シーン 785","slideTitle":"スライド #785","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.785.jpeg","voiceDuration":11.076984126984128,"seVolume":1},{"id":"4736AFC7-CA70-495F-8A7F-2867D117C9AE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_786_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","telop":"私は、そこで気づく。いつの間にか、彼は、この家からいなくなったんだと。そして、時計を見ると、今日は土曜日だった。","voiceCharacter":"博麗霊夢","duration":10.145736961451247,"title":"シーン 786","slideTitle":"スライド #786","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.786.jpeg","voiceDuration":10.145736961451247,"seVolume":1},{"id":"633A7FC4-8AFC-4C05-9F22-A79BAC263FEB","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_787_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-26_19-50.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","telop":"僕は、ふと気がつくと、そこはフランと僕の二人部屋だった。\nすると、扉が、突如として開き、誰かが入ってくる。","voiceCharacter":"操夢","duration":8.428911564625851,"title":"シーン 787","slideTitle":"スライド #787","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.787.jpeg","voiceDuration":8.428911564625851,"seVolume":1},{"id":"4A6DD8B3-29B6-4B81-8E98-C928023A0D33","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_788