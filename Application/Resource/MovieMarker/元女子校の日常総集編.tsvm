\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":5.227823129251701,"slideTitle":"スライド #1818","title":"シーン 1818","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1818_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1818.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「これはすまない、霊夢。情報と引き換えに、\n新しい神社の後継を手配してくれることになったんだ。」","id":"5382F5C1-256A-4038-B589-4078A183173E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":5.227823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":5.849478458049886,"slideTitle":"スライド #1819","title":"シーン 1819","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1819_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1819.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「はっ？」私は、突拍子のない母の衝撃発言に、そう返す。","id":"CD1A5B37-5E9E-4786-B400-9E4693508E31","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":5.849478458049886},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":2.656394557823129,"slideTitle":"スライド #1820","title":"シーン 1820","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1820_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1820.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「だから、お前のとこの息子は、不要になったんだ…。」","id":"AAB751C2-E717-4C8B-B413-ABB4694DA76B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":2.656394557823129},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":4.764489795918367,"slideTitle":"スライド #1821","title":"シーン 1821","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1821_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1821.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「えっ？どういうこと、私が必死に生んだ彼がいらないの？」","id":"9E23DCE5-0A63-4F69-AC49-867206000757","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":4.764489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":1.4057596371882086,"slideTitle":"スライド #1822","title":"シーン 1822","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1822_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1822.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「そうだが…、それが何か？」","id":"EEA307C7-36E2-4DC8-A3EF-C6A54928E578","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":1.4057596371882086},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":2.516984126984127,"slideTitle":"スライド #1823","title":"シーン 1823","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1823_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1823.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「覚悟は…出来ているんでしょうね…？」","id":"AC1422D6-8C70-4565-8ED8-80C2CA06C8EB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":2.516984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":7.03063492063492,"slideTitle":"スライド #1824","title":"シーン 1824","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1824_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1824.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊異変やっちまった.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「えっと…それは…」私は、目の前に見える娘の怒気に一歩一歩と後ずさる。だが、娘から強烈な拳を喰らってしまうのだった。","id":"32398E69-1BB9-40B2-B745-0509319003CA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":7.03063492063492},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":7.675646258503401,"slideTitle":"スライド #1825","title":"シーン 1825","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1825_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1825.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、あれから魔法使い入門編の本を、読んでいる際にふと思いつき、僕とフランの部屋からノートとペンを持ってきた。","id":"23808C2C-B703-4BDF-918F-53251828DDDD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.675646258503401},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":7.686507936507937,"slideTitle":"スライド #1826","title":"シーン 1826","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1826_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1826.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、本の内容をもとに、自分なりにノートを書き込んでいく。そして、ふと本を読んでいて、あることに気がつく。","id":"B1302D53-A049-4E08-A8FC-FA507C9801BA","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.686507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.037596371882087,"slideTitle":"スライド #1827","title":"シーン 1827","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1827_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1827.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それは、ちょくちょく語尾に「だぜ。」という特徴的な口癖が書かれていることだった。そこで、僕はふと思い出す。","id":"FD5ADF79-9FA5-41F8-BB1C-46168065D09A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.037596371882087},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":5.1000000000000005,"slideTitle":"スライド #1828","title":"シーン 1828","animationName":"なし","bgmVolume":0.65,"voiceStartTimeOffset":0,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1828.jpeg","bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"そして巻末までページを捲ると、なぜか、出典や著者、出版社などの情報が載ったページが誰かに破られていた。","id":"77996454-8CC5-4AC0-8E30-7A2AEA7F1D27","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":7.2680272108843536,"slideTitle":"スライド #1829","title":"シーン 1829","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1829_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1829.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕は本の表紙にある著者名を見る。\nよく見ると、それは元の名前の上に、ラベルが貼ってあった。","id":"A6D63B54-6660-405B-B56D-6E9EC9E1D5F4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.2680272108843536},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":7.2365079365079366,"slideTitle":"スライド #1830","title":"シーン 1830","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1830_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1830.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そのラベルを剥がそうと、爪を立てるが、がっしりと拍子にラベルがしがみついていて、剥がすことができない。","id":"F003931B-8C5E-4159-B6EE-2BA3D1534863","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.2365079365079366},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.30498866213152,"slideTitle":"スライド #1831","title":"シーン 1831","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1831_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1831.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕は推測を立てる。おそらくこの本は、母の友人である魔理沙が書いたものだが、その証拠となるものはなかった。","id":"E05F232B-479F-48C0-BE32-E30A3F2409C7","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.30498866213152},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":5.804988662131519,"slideTitle":"スライド #1832","title":"シーン 1832","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1832_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1832.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕は直接本人に聞くのがいいと考え、\nその本を片手に部屋に戻っていった。","id":"6700D351-1008-4D17-8BF8-72D7E553EF77","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.804988662131519},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":7.359342403628118,"slideTitle":"スライド #1833","title":"シーン 1833","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1833_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1833.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が部屋に戻ってきて、本をバックにしまって、\n出かけようとすると、部屋の扉が開き、誰かが入ってくる。","id":"CF47CF89-26EF-49F9-B6E9-63906A5096CD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.359342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.0119954648526077,"slideTitle":"スライド #1834","title":"シーン 1834","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1834_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1834.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ねぇ、これからどこにいくの、紅夢？」","id":"20B4A770-EE10-448A-B800-167139825B4F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.0119954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":2.7539002267573696,"slideTitle":"スライド #1835","title":"シーン 1835","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1835_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1835.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「魔理沙さんの家ですけど…、どうかしました？」","id":"7911D531-5DF9-4027-995D-5976FC9AF163","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.7539002267573696},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.2932426303854876,"slideTitle":"スライド #1836","title":"シーン 1836","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1836_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1836.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「彼女の家で、何をするつもりだったの？」","id":"625D7B34-CC34-42BB-88BB-36E381872E0B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.2932426303854876},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":7.671292517006803,"slideTitle":"スライド #1837","title":"シーン 1837","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1837_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1837.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は彼女の質問を聞くと、バックを下ろし、中に入れた本を見せる。「この本について、聞きたいことがあるんですよ。」","id":"C07A6A1A-C28A-4A23-AFFA-6B933F737D63","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.671292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":5.323242630385487,"slideTitle":"スライド #1838","title":"シーン 1838","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1838_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1838.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「この本って…、図書館のやつだよね？\nそれで、何を聞きたいの？」","id":"93263835-115A-49C7-BE76-3FD1D0E75703","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.323242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":5.7,"slideTitle":"スライド #1839","title":"シーン 1839","animationName":"なし","bgmVolume":0.65,"voiceStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1839.jpeg","bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"「この本の巻末にあるはずの出典が破かれていてないことと、本の表紙にある著者名にかぶるようにラベルがあったので…。」","id":"0037EB24-FB21-4288-98DA-7AE69E07F23D","seVolume":1},{"voice2StartTimeOffset":3.8539002267573697,"telop":"僕が、そういうと、彼女は固まったような表情を見せる。\n「どうしたんですか、フランさん。そんな表情をして。」","seVolume":1,"characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フランごくり.png","voiceDuration":3.8539002267573697,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","animationName":"なし","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"slideTitle":"スライド #1840","bgmVolume":0.65,"duration":7.466507936507936,"backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1840.jpeg","id":"3A32C3D9-CC7E-442F-9095-5926F7703B46","voice2Character":"操夢","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1840_操夢_2.wav","bgmStartTimeOffset":0,"voice2Duration":3.612607709750567,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1840_操夢.wav","transitionName":"なし","title":"シーン 1840"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.086984126984127,"slideTitle":"スライド #1841","title":"シーン 1841","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1841_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1841.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、ちょっとその本を渡しに、渡してくれない？」","id":"3639ABB0-DE90-4762-9A00-6E1EF60029C1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.086984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.275646258503401,"slideTitle":"スライド #1842","title":"シーン 1842","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1842_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1842.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ、なぜですか？」僕は、彼女の発言にそう返す。","id":"FF1134DC-3BEB-49D2-9BFF-107EEB48051D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.275646258503401},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":5.476984126984127,"slideTitle":"スライド #1843","title":"シーン 1843","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1843_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1843.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「図書館の本を外に持ってくなら、\nお姉様に確認しなきゃいけないから。」","id":"61F1C05E-93DF-451A-A2ED-D084A9159ABD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.476984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":5.895215419501134,"slideTitle":"スライド #1844","title":"シーン 1844",