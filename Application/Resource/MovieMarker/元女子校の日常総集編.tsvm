,"duration":7.0875963718820865,"title":"シーン 146","slideTitle":"スライド #146","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.146.jpeg","voiceDuration":7.0875963718820865,"seVolume":1},{"id":"1CE1EC5F-E91A-437E-BA17-A7A8E2B7F896","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_147_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。","voiceCharacter":"八意永琳","duration":8.360249433106576,"title":"シーン 147","slideTitle":"スライド #147","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.147.jpeg","voiceDuration":8.360249433106576,"seVolume":1},{"id":"ED34555E-09CF-4A3F-957C-E599D96925D2","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"彼に視点が戻り…","duration":1.5,"title":"シーン 148: 彼に視点が戻り…","slideTitle":"スライド #148","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.148.jpeg","seVolume":1},{"id":"29775F15-E64C-4238-BC9C-C9BC7FD32604","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_149_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…","voiceCharacter":"操夢","duration":9.281065759637189,"title":"シーン 149","slideTitle":"スライド #149","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.149.jpeg","voiceDuration":9.281065759637189,"seVolume":1},{"id":"0E8D11FE-59C0-4C5F-9812-838C7CF12370","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_150_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。","voiceCharacter":"操夢","duration":8.397369614512472,"title":"シーン 150","slideTitle":"スライド #150","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.150.jpeg","voiceDuration":8.397369614512472,"seVolume":1},{"id":"FD739CED-6D67-4410-86C3-A545B1DF89E9","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_151_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。","voiceCharacter":"操夢","duration":8.261519274376417,"title":"シーン 151","slideTitle":"スライド #151","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.151.jpeg","voiceDuration":8.261519274376417,"seVolume":1},{"id":"92A4ED78-83DE-42E1-A94E-799944821539","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_152_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。","voiceCharacter":"操夢","duration":8.697369614512471,"title":"シーン 152","slideTitle":"スライド #152","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.152.jpeg","voiceDuration":8.697369614512471,"seVolume":1},{"id":"D0FA6252-4C89-4D35-96C9-72AB8715EBA0","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_153_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。","voiceCharacter":"操夢","duration":8.525646258503402,"title":"シーン 153","slideTitle":"スライド #153","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.153.jpeg","voiceDuration":8.525646258503402,"seVolume":1},{"id":"5C0BB5E1-ACF6-426F-82DC-E2F452910835","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_154_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。","voiceCharacter":"操夢","duration":7.856077097505669,"title":"シーン 154","slideTitle":"スライド #154","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.154.jpeg","voiceDuration":7.856077097505669,"seVolume":1},{"id":"5EA4D403-5954-44D0-9121-A3A98F94E7BE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_155_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"教室の前の方（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","telop":"そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。","voiceCharacter":"操夢","duration":6.240861678004535,"title":"シーン 155","slideTitle":"スライド #155","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.155.jpeg","voiceDuration":6.240861678004535,"seVolume":1},{"id":"DBD6BEDD-8E47-4C89-B519-1680447ABEE5","seStartTimeOffset"