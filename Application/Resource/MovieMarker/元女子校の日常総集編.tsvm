deImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1228.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕は諸々の手続きや、ホテル予約などを済ませ、3人はそれぞれ好きな軽食や今日の夕飯を買い出しを済ませた。","id":"1883AB7A-8E95-4AB2-B5B7-06C1947626EE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.393673469387755},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":8.90390022675737,"slideTitle":"スライド #1229","title":"シーン 1229","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1229_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1229.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「楽しみですか、旅行？」僕がそう聞くと、3人は頷く。\nそして、僕たちはそのまま今晩泊まるホテルに移動を始めた。","id":"0E6A99D6-4DEA-4037-913B-C1B4B9A63665","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.90390022675737},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1230","title":"シーン 1230: 一方、学校では…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1230.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"一方、学校では…","id":"EDE3E541-28B9-43E6-AA06-CE3D0A39C413","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.673219954648526,"slideTitle":"スライド #1231","title":"シーン 1231","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1231_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1231.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、一人、学園長室で作業をしていると、戸がノックされる。","id":"85BEEDB8-64F9-4373-98AB-84E10CDB24EA","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":4.673219954648526},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":3.3739455782312926,"slideTitle":"スライド #1232","title":"シーン 1232","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1232_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1232.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"すると、ある人物の声がする。「入っていいぞ。」","id":"FF6B7F80-C137-4155-91DB-B3A5297F71E9","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":3.3739455782312926},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":2.8947845804988663,"slideTitle":"スライド #1233","title":"シーン 1233","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1233_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1233.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「美鈴か、どうした、何かあったのか？」","id":"D4140C56-B8B4-4705-8E4B-4E6C421E30C8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":2.8947845804988663},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":6.010226757369614,"slideTitle":"スライド #1234","title":"シーン 1234","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1234_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1234.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「学園長…、つい先ほど、先日例の彼が居候している家に、送ったカードから数時間のうちに5回ほどの入出金がありまして…」","id":"57799287-803E-4AA7-B918-F81BBD894157","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":6.010226757369614},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":2.730612244897959,"slideTitle":"スライド #1235","title":"シーン 1235","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1235_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1235.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「入出金の明細は、どうなってんだ？」","id":"4B329E75-F8D4-4D0A-9049-FFE84CA5AC7D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":2.730612244897959},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":5.761269841269841,"slideTitle":"スライド #1236","title":"シーン 1236","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1236_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1236.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「お台場のショッピングモール内の洋服店から1件、現金の引き出しと、振り込みがそれぞれ1件、ホテル関連のものが数件です。」","id":"43AB3531-6DAB-40E9-91C1-C9D346AC3F58","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.761269841269841},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":0.6786394557823129,"slideTitle":"スライド #1237","title":"シーン 1237","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1237_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1237.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「ホテル？」","id":"24D36DC1-DD54-4F4D-AD54-40FC09FF8D8D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":0.6786394557823129},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":4.998208616780046,"slideTitle":"スライド #1238","title":"シーン 1238","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1238_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1238.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「ええ、一つは立体蒲田駅近くのホテル、残りは琉球郡内の沖縄本島にあるホテルの予約になっています。」","id":"49FE051D-249D-4969-9884-0BB00F4F5F10","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":4.998208616780046},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":2.6823809523809525,"slideTitle":"スライド #1239","title":"シーン 1239","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1239_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1239.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「デビットカードを使ったのは誰かわかるか？」","id":"B931341A-F5D0-4D6A-BAE3-E7CC11C950E7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":2.6823809523809525},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":5.005963718820862,"slideTitle":"スライド #1240","title":"シーン 1240","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1240_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1240.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「おそらく、例の彼本人かと…、どうしましょう、例の彼がいる班の班長に、何があったのかを聞き出しますか？」","id":"5DB30C98-C4AA-458A-8748-2CC5E5B92062","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.005963718820862},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":6.416666666666667,"slideTitle":"スライド #1241","title":"シーン 1241","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1241_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1241.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「確か、あの班の班長は、パチュリーが使っている研究室で学んでいる大学院生だったよな…？」","id":"6918C562-0DE8-4B9C-8480-BD993B776138","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":6.416666666666667},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":2.137573696145125,"slideTitle":"スライド #1242","title":"シーン 1242","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1242_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1242.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「ええ、班長の名前はアリス・マーガトロイドですが…？」","id":"7E39C1DC-5108-48BD-A212-B9908D6BEF58","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":2.137573696145125},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":8.742290249433106,"slideTitle":"スライド #1243","title":"シーン 1243","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1243_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1243.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"「なら、パチュリーに言いつけて、確認させて、あなたがその内容を聞いて、私に報告しなさい、期限は今日の午後3時までだ。」","id":"CFD77811-1D47-4F0A-AAFA-CF32050B2471","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":8.742290249433106},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":1.5932199546485262,"slideTitle":"スライド #1244","title":"シーン 1244","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1244_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1244.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「承知しました…聞き出してきます。」","id":"E625DB85-F418-4BC4-9BDF-5C7E806452D0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":1.5932199546485262},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmStartTimeOffset":0,"duration":9.177687074829931,"slideTitle":"スライド #1245","title":"シーン 1245","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1245_隠岐奈.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1245.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_85A1","characterName":"隠岐奈","telop":"私は、彼女が去ると、手元の机からある書類を取り出す。それには、例の彼が遠足後に受ける、試験の詳細が記されていた。","id":"C0A371F1-0000-430B-8BCE-EB388BE81609","seVolume":1,"voiceCharacter":"隠岐奈","voiceDuration":9.177687074829931},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1246","title":"シーン 1246: それから、彼らは…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1246.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それから、彼らは…","id":"D88FEC8E-8205-498D-959A-609C8D4C6337","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":9.162607709750567,"slideTitle":"スライド #1247","title":"シーン 1247","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1247_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1247.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕たちは、ホテルに着くと、予約した四人部屋に入る。そして、入浴の順番を決めて、アリスが先に浴室に入る。","id":"E013529D-8401-4A88-8DD2-B03FAE78078A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.162607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":3.088979591836735,"slideTitle":"スライド #1248","title":"シーン 1248","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1248_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1248.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あの…女子3人と一緒の部屋で寝泊まりで…いいんですか？」","id":"161C4861-1252-425C-929F-A4EFB4AC9117","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.088979591836735},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":3.666938775510204,"slideTitle":"スライド #1249","title":"シーン 1249","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1249_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1249.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、条件に見合った部屋が、ここしかなかったので…。」","id":"C6AA8F72-BB79-4C78-9895-ED130BC5F1AC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.666938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":2.068185941043084,"slideTitle":"スライド #1250","title":"シーン 1250","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1250_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1250.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そうですか…。それならいいんですけど…」","id":"96D77180-34E8-40F0-B134-5CACE8FF29B3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.068185941043084},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":7.460430839002267,"slideTitle":"スライド #1251","title":"シーン 1251","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1251_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1251.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それより、アリスさんの入力が終わったら、こいしさんを目覚めさせてください…」僕は、そう言いながら、こいしを見る。","id":"391D6C87-57FE-4063-A542-68C09A50AF7D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.460430839002267},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":8.457165532879818,"slideTitle":"スライド #1252","title":"シーン 1252","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1252_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1252.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝落ち寸前.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そこには、寝落ち寸前のような表情で、こくこくと頭が動いているこいしの姿があった。「今寝ちゃうと、夜眠れませんから…」","id":"CD86C5E0-51AE-48BA-BC14-696838840DDC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.457165532879818},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":6.592585034013606,"slideTitle":"スライド #1253","title":"シーン 1253","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1253_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1253.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「分かりました…」私と彼がそう話していると、浴室の扉が開く。そして、妹を起こし、入浴に向かわせた。","id":"C41C7D82-0369-4B68-87DB-FEA8D8EE9916","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.592585034013606},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":6.35297052154195,"slideTitle":"スライド #1254","title":"シーン 1254","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1254_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1254.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"私は、入浴が終わると、ポケベルに着信があったことに気がつく。そして、さとりと彼の了承を得ると電話に出る。","id":"0B18F1CE-9C8D-4525-8055-A85F5BBE0FBA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.35297052154195},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","bgmStartTimeOffset":0,"duration":1.5932653061224489,"slideTitle":"スライド #1255","title":"シーン 1255","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1255_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1255.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「もしもし、どうしたんですか？」","id":"CE2964BF-86D7-4AEF-8182-1B50324CDDC0","seStartTimeOffset":0,"seVolume":1,"voiceCharact