itionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.730.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、その返答に悩んでいると、\nレミリアが僕たちに、ある言葉を突きつけていくのだった。","id":"062844F0-0DEA-4E3B-9A81-D22EE1FD2BD5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.015850340136055},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.712607709750566,"slideTitle":"スライド #731","title":"シーン 731","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_731_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.731.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"あの後、僕たちは二人で入浴する羽目になり、僕たちの間には気まずさを超えた、冷たい空気が漂いながら、夕飯を迎えた。","id":"B443BAB2-9207-4052-8346-BE71283D49FC","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.712607709750566},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.5088208616780046,"slideTitle":"スライド #732","title":"シーン 732","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_732_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.732.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「それじゃあ、夕飯を食べましょうか。」\n私は、そう二人に言うが、二人からの反応は返ってこない。","id":"799BCC76-7B13-4E7E-9B96-660867DF0AA6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.5088208616780046},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.2879818594104306,"slideTitle":"スライド #733","title":"シーン 733","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_733_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.733.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「早く、夕飯食べないと、料理が冷めちゃうわよ。」","id":"2A6DCCCB-056F-407B-8D20-0F23F933D87D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.2879818594104306},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":7.911519274376417,"slideTitle":"スライド #734","title":"シーン 734","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_734_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.734.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、彼女にそう告げられ、仕方なく料理に手を伸ばす。だが、先ほどまでの出来事が頭から離れなかった。","id":"B8897236-1814-4AAD-88AB-8C070DF24801","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.911519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.534331065759638,"slideTitle":"スライド #735","title":"シーン 735","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_735_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.735.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそれから、機械的に食べ進めて、\n食事を終えると、彼女が突如として、声をかけてくる。","id":"5D9AE2FB-9671-4736-9BB4-E0405D13FAEB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.534331065759638},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.177573696145124,"slideTitle":"スライド #736","title":"シーン 736","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_736_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.736.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「さてと、そろそろデザートの時間にしましょうか。」\n私はそう二人に告げて、そっと席を立つ。","id":"90FB545D-BA93-4A98-A94C-A315E8D8E4A9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.177573696145124},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":7.321292517006802,"slideTitle":"スライド #737","title":"シーン 737","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_737_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.737.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がふとフランの方に視線をやると、彼女が驚いた。\nそれと同時、首筋に誰かが、噛み付いてくる。","id":"7CC03BC6-87E1-467D-B5D0-072E8023038B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.321292517006802},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.500634920634921,"slideTitle":"スライド #738","title":"シーン 738","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_738_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.738.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕がその行為が何であるかを把握するうちに、\n僕の意識が闇の中へ、落ちていくのだった。","id":"0A4A9E7A-D47A-4CD1-B8FF-109E8A60F493","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.500634920634921},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":9.838684807256236,"slideTitle":"スライド #739","title":"シーン 739","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_739_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.739.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"私は、ふと周囲を見渡すと、一方には、先日レミリアと名乗っていた人物、もう一方にはその妹がいた。するとレミリアが話しかけてくる。","id":"2E83653F-9DDA-49B1-B784-885685C5C696","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":9.838684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.1671655328798187,"slideTitle":"スライド #740","title":"シーン 740","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_740_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.740.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「あら、ご機嫌用、今のご気分はいかがですか？」","id":"F3D601FC-8F94-4F20-B0B2-D2B8A07A62BF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.1671655328798187},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":2.962607709750567,"slideTitle":"スライド #741","title":"シーン 741","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_741_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.741.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「普段と変わらない…とでも言っておきましょうか…。」","id":"C09A1596-71AB-4A1E-9087-C19AB5650420","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":2.962607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.450498866213152,"slideTitle":"スライド #742","title":"シーン 742","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_742_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.742.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「そうですか。確か私とあなたが対面するのは、あの深夜帯の学校以来ですね。あれから、彼に何か変化はありましたか？」","id":"444DBAA6-F7BB-4CDF-BE13-9FC5032A8645","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.450498866213152},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":5.662607709750567,"slideTitle":"スライド #743","title":"シーン 743","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_743_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.743.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「それより、あなたの妹さんが、\n先ほどから固まってますけど、大丈夫でしょうか？」","id":"979C6804-F312-462D-A3F5-510C2A80D138","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":5.662607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":7.706734693877551,"slideTitle":"スライド #744","title":"シーン 744","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_744_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.744.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「あら、それは失礼」私はそう言いながら、フランに軽いパンチをする。「しっかりしなさい、彼女は彼の裏に潜んでるのよ。」","id":"C4D37735-A58F-4049-9C14-19F3C040B6A3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.706734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.8756462585034015,"slideTitle":"スライド #745","title":"シーン 745","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_745_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.745.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"彼女が、妹のフランにパンチをすると、表情が変わる。","id":"19A45891-D932-413D-9059-9691A8F33B8D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":3.8756462585034015},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.756145124716554,"slideTitle":"スライド #746","title":"シーン 746","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_746_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.746.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「フラン、ああ見えても、彼女と彼は同一人物なのよ。\nだから、気をしっかり持って、接しなさい。」","id":"355247F5-776D-48EE-8CD7-DFC473716625","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.756145124716554},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.0694784580498866,"slideTitle":"スライド #747","title":"シーン 747","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_747_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.747.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…なんだ…」私はそう呟く。","id":"E045DF2C-DA11-4B17-8ABF-3EEA48A5B793","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.0694784580498866},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":4.812607709750567,"slideTitle":"スライド #748","title":"シーン 748","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_748_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.748.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「それで、私を呼び出したと言うことは、\n何かしらの事情があるのですね？」","id":"A0C6ACCA-EF65-4EC6-8F2A-9B4F2EF29D1D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":4.812607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.09156462585034,"slideTitle":"スライド #749","title":"シーン 749","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_749_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.749.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「ええそうよ。」私はそう言うと、\n事前に用意してあった、書面を彼女の方へとスライドさせる。","id":"816BFD46-7DC4-4A67-B32F-5402AC9EE6BA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.09156462585034},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.702562358276644,"slideTitle":"スライド #750","title":"シーン 750","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_750_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.750.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「その書面を挟んでいるボールペンで、サインを頂けるかしら。」","id":"8DDD4516-7E18-4CF2-8275-86FAB6FF811D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.702562358276644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.235419501133787,"slideTitle":"スライド #751","title":"シーン 751","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_751_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.751.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"その書面には、先日の深夜帯に交わした契約を記したものと、フランの名前が記載された、婚姻届が挟まれてあった。","id":"F0A9B5C3-9317-4652-AC47-9C454AA9FB06","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.235419501133787},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":9.092154195011338,"slideTitle":"スライド #752","title":"シーン 752","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_752_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.752.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「婚姻届の方は、まだ仮の状態よ。だから、あなたがサインしても、彼が拒絶すれば、無効。それで、返答はどうかしら？」","id":"9E2F2B04-E966-4918-A7FC-773A148D5E5B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":9.092154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.121292517006802,"slideTitle":"スライド #753","title":"シーン 753","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_753_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.753.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"私はふと考える、この機を逃せば、2度とこの書面を見れない気がした。そして、ペンを手に取ると、サインをして返す。","id":"BEA8A1AE-D0AE-4260-B671-279F0047F799","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.121292517006802},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":5.356734693877551,"slideTitle":"スライド #754","title":"シーン 754","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_754_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.754.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「フラン、この書類のコピーを取ってきなさい。」\n私はそう言い、書類とペンを渡す。","id":"4A8DD2F2-2DAE-446E-ADAA-52767389D67B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":5.356734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.982154195011338,"slideTitle":"スライド #755","title":"シーン 755","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_755_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.755.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「夕方からのあなたの発言や所作は、私が表に出てくるように仕向けた手順なのですか？」私は確認のために、そう尋ねる。","id":"3AB55218-7DDE-48C0-8BC8-956C350A30BD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.982154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.585895691609977,"slideTitle":"スライド #756","title":"シーン 756","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_756_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.756.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「ええ、そうよ。彼は見事に、引っかかってくれたわ。\nそれで、あなたはこれからどうするのかしら？」","id":"4ACFDD63-006E-4775-9757-1C2907D3300A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.585895691609977},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":2.05390022675737,"slideTitle":"スライド #757","title":"シーン 757","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_757_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.757.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「特に予定は、ありませんよ。」","id":"1A752944-C63B-45CA-AB77-1594B2B4BCB7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":2.05390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.281746031746032,"slideTitle":"スライド #758","title":"シーン 758","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_758_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.758.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「そう。なら、この屋敷に図書館があるから、彼女に聞いて、読書するのがいいわ。何かあれば、彼女に聞いてちょうだい。」","id":"57C9DF77-4E88-4024-A0BA-42177AEE5B65","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.281746031746032},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":5.639773242630386,"slideTitle":"スライド #759","title":"シーン 759","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_759_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.759.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"彼女はそう言うと、どこかへと去っていった。\nすると入れ替わるように、フランがやってくる。","id":"7D1BAFCE-B921-409E-A681-344ED8FC00F6","seVolume":1,"voiceCharacter":"サブ","voiceDuration":5.639773242630386},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":1.7344897959183674,"slideTitle":"スライド #760","title":"シーン 760","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_760_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.760.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「あれ、お姉様は？」","id":"60B7DF82-4F62-4E14-93C5-1268AC20ECB4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.7344897959183674},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":2.8647619047619046,"slideTitle":"スライド #761","title":"シーン 761","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_761_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.761.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「彼女なら、どこかに向かって行きましたよ。」","id":"357F44B3-5E5A-46CF-BB87-04836FF80905","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":2.8647619047619046},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.996984126984127,"slideTitle":"スライド #762","title":"シーン 762","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_762_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.762.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう。それで、あなたは…これからどうするの？」","id":"20111605-4749-4BAA-9927-CBEB0AA6D728","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.996984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.682154195011338,"s