nsitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1503.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"二人はホテルに戻ると…","id":"CDBBB668-9499-4B3A-9605-1431728C08EC","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":7.890861678004535,"slideTitle":"スライド #1504","title":"シーン 1504","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1504_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1504.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕は一度、こいしがいる部屋のチャイムを鳴らすが、姉妹で寝たいと二人が行ったため、その隣の部屋に来た。","id":"ADE61FC7-C365-4E83-8D20-AE00E37A255B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.890861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":2.3256462585034012,"slideTitle":"スライド #1505","title":"シーン 1505","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1505_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1505.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「アリスさんは、お風呂に入りますか？」","id":"B815F7A1-B6D0-4B31-9A8E-9667432A51F5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.3256462585034012},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":1.8701814058956916,"slideTitle":"スライド #1506","title":"シーン 1506","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1506_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1506.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「そうするけど、あなたはどうするの？」","id":"E5B1616F-DF0A-47C4-8075-B882F3AECBC3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.8701814058956916},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":3.2321541950113377,"slideTitle":"スライド #1507","title":"シーン 1507","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1507_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1507.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、明日からの行動計画でも練ってますよ。","id":"FC9F3400-2D79-4D6D-8FFF-8BD6B4FB306F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.2321541950113377},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":1.472108843537415,"slideTitle":"スライド #1508","title":"シーン 1508","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1508_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1508.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「そう…、それじゃあ入るわね…」","id":"F8D013BC-32F9-4AD3-884A-2198C24E4AF4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.472108843537415},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.747369614512472,"slideTitle":"スライド #1509","title":"シーン 1509","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1509_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1509.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言うと、風呂場に向かう。だが、床の段差につまづき、彼女は転けそうになる。僕は、彼女のそばに駆け寄る。","id":"F60ACCF1-FDF1-4032-A854-2CC42995FD35","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.747369614512472},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":2.0380725623582765,"slideTitle":"スライド #1510","title":"シーン 1510","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1510_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1510.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「うっ…、酔いが回ってしまったのかしら…」","id":"0F0E49BB-C777-4736-98EF-85FC3607BB80","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.0380725623582765},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.819115646258503,"slideTitle":"スライド #1511","title":"シーン 1511","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1511_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1511.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「でも、本当に酔い潰れたら、もっとひどくなりますから、それに比べれば、まだ健全の範囲ですよ。」僕はそう、助言する。","id":"AF6BC388-7092-4F1B-AAFC-0C978823D4D5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.819115646258503},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":5.006077097505669,"slideTitle":"スライド #1512","title":"シーン 1512","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1512_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1512.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ただ、浴室で怪我されても困るので、\nそこで少し座って待ってください。」","id":"9AA85C44-443A-47B6-B42F-36CACA671921","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.006077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.45063492063492,"slideTitle":"スライド #1513","title":"シーン 1513","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1513_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1513.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言うと、バックからあるものを2つ取り出す。それは、黒色のアイマスクだった。そして、それを一つ彼女につける。","id":"A8FDB0B9-B0CE-4DD1-8CEB-49695B20EEEB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.45063492063492},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":1.4037414965986394,"slideTitle":"スライド #1514","title":"シーン 1514","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1514_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1514.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「ちょっと、何するのよ。」","id":"11604D42-6B39-4ABF-95BC-17EADE190A58","seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.4037414965986394},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.458253968253969,"slideTitle":"スライド #1515","title":"シーン 1515","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1515_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1515.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こういう時のために、向こうで買ったんですよ。互いにアイマスクを被れば、僕が浴室の中でアリスさんの体を支えますから…」","id":"1EC5585C-EE77-40D2-88E6-2A70A7C662CB","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.458253968253969},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.049546485260771,"slideTitle":"スライド #1516","title":"シーン 1516","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1516_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1516.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ただ、触覚だけはどうにもならないので、そこは我慢してください。何より怪我なく、お風呂に入れるのが一番ですから。」","id":"7C2371AE-B27B-4F08-BEE3-4AE6627D4EC1","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.049546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":2.4017233560090703,"slideTitle":"スライド #1517","title":"シーン 1517","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1517_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1517.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言いながら、アイマスクを被る。","id":"BB64F52E-BEBA-4389-AC53-04E2DDA106E6","seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.4017233560090703},{"bgmStartTimeOffset":0,"duration":8.910430839002268,"slideTitle":"スライド #1518","title":"シーン 1518","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1518_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1518.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、暗闇の中、スッと息を吸い、神経を透き済ますと、触覚だけを頼り、彼女の服を脱がせ、自分自身も服を脱ぐ。","id":"F8681495-1FFE-4EDF-A09D-752730C1B246","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.910430839002268},{"bgmStartTimeOffset":0,"duration":8.646303854875283,"slideTitle":"スライド #1519","title":"シーン 1519","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1519_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1519.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女をそっと抱え上げると、浴室の段差に気をつけながら、中に入っていき、そのまま彼女の入浴を補助するのだった。","id":"32855A95-2E14-4F54-858E-23508D34B5A5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.646303854875283},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":7.35390022675737,"slideTitle":"スライド #1520","title":"シーン 1520","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1520_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1520.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、アリスを入浴させると、彼女が一人で出られるといい、僕は、一人ベッドに座り、ぼんやりとしていた。","id":"6124AA05-191F-4738-99DB-9014EC6E8510","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.35390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":4.581065759637188,"slideTitle":"スライド #1521","title":"シーン 1521","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1521_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1521.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"ふと時計を見ると、夜の9時だった。そして、僕は背伸びをする。","id":"87A6C3A6-8BF5-4B3E-8539-C3AB5570DCD9","seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.581065759637188},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.710430839002267,"slideTitle":"スライド #1522","title":"シーン 1522","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1522_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1522.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、ぼんやりと過ごしていると、浴室から大きな物音がする。\n僕は、なんだか嫌な予感がし、扉越しに様子を尋ねる。","id":"721C39E4-308D-4DC0-AA9B-0F05547C511D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.710430839002267},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":8.464761904761906,"slideTitle":"スライド #1523","title":"シーン 1523","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1523_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1523.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、返事は返ってこず、僕は一度外したアイマスクをつけ、\n扉を開けて中に、入ると、そこには気絶した彼女がいた。","id":"CAE89F4B-BA83-4BD4-B6CD-4CAD61255B25","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.464761904761906},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":6.291950113378685,"slideTitle":"スライド #1524","title":"シーン 1524","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1524_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1524.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、強めに彼女の頬を叩くと、彼女は意識を取り戻し、\nなんとかことなきを得るのだった。","id":"3F1828B6-044E-46FD-8F9D-D4B8ED49BCBD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.291950113378685},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":2.0115192743764174,"slideTitle":"スライド #1525","title":"シーン 1525","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1525_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1525.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの…、ごめんなさい…私ったら…」","id":"E70F440D-D44E-4713-9546-67B3600AB789","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.0115192743764174},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":6.362607709750567,"slideTitle":"スライド #1526","title":"シーン 1526","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1526_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1526.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「別にいいですよ…、酔った両親の相手を、少し前までは普通にしてたので…、僕は慣れてますから…」","id":"152913B0-BAA4-47F9-8ED0-336F45724AC1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.362607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":0.5,"slideTitle":"スライド #1527","title":"シーン 1527","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1527_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1527.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「そう…」","id":"46B62E7E-8C53-431E-B2F4-1FDAE5E22AAE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":0.5},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":7.045215419501134,"slideTitle":"スライド #1528","title":"シーン 1528","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1528_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1528.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「とりあえず、僕がこれから、入浴しますね。」\n僕はそう言うと、着替えを持って、浴室に入った。","id":"FB410643-0B9C-439D-A5EE-1CBD070BA0C5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.045215419501134},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1529","title":"シーン 1529: 藤原紅夢（主人公）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1529.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"藤原紅夢（主人公）","id":"8CE6C330-46BE-4EF4-AB93-2479183300F2","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image65.jpeg","bgmStartTimeOffset":0,"duration":7.498458049886621,"slideTitle":"スライド #1530","title":"シーン 1530","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1530_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image65.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1530.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り寝顔.pxd","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、浴室から戻ってくると、アリスはすでに眠ってしまっているようだった。僕も、ふと大きなあくびが出る。","id":"3A550772-3061-45B1-B5DD-ECAC8B92800A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.498458049886621},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cach