tTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"「笑わないでよ…、いつか必ず、\nあなたに振り向いてもらうから…。ちゃんと覚えててね…」","voiceCharacter":"古明地こいし","duration":7.014897959183673,"title":"シーン 2003","slideTitle":"スライド #2003","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2003.jpeg","voiceDuration":7.014897959183673,"seVolume":1},{"id":"B3ABC4A7-9CDA-471C-8B5C-8DEECA0D37B4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし怒り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2004_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"「その約束、頭の中にちゃんと留めておきますよ。」\n僕は、そういうと、すっと立ち上がり、図書館に向かった。","voiceCharacter":"操夢","duration":7.8441269841269845,"title":"シーン 2004","slideTitle":"スライド #2004","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2004.jpeg","voiceDuration":7.8441269841269845,"seVolume":1},{"id":"00D50E5B-CC65-416A-A0D8-7FCBBAE5AE1C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし怒り.png","transitionName":"なし","bgmName":"BGM: nc364900_【東方自作アレンジ】Mad【ハルトマンの妖怪少女】","animationDuration":5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"5秒","telop":"古明地こいし（中学生）","duration":5,"title":"シーン 2005: 古明地こいし（中学生）","slideTitle":"スライド #2005","characterName":"操夢","bgmVolume":0.2553129615952733,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc364900_【東方自作アレンジ】Mad【ハルトマンの妖怪少女】.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2005.jpeg","seVolume":1},{"id":"C3C2547E-3623-42EE-8EB5-2B1F1881AC87","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2006_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"あれからしばらく経ち、大型連休が終わり、僕は再び学校にやってきた。そして、いつものように朝礼が始まった。","voiceCharacter":"操夢","duration":8.035419501133786,"title":"シーン 2006","slideTitle":"スライド #2006","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2006.jpeg","voiceDuration":8.035419501133786,"seVolume":1},{"id":"CDD811CB-DEF1-48CF-AFD6-E11DE2F74F86","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2007_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「今日は、連休明け初日ですが、気を引き締め、教員から叱責を受けることもなく、向上心を持って取り組みましょう。」","voiceCharacter":"東風谷早苗","duration":7.4386848072562355,"title":"シーン 2007","slideTitle":"スライド #2007","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2007.jpeg","voiceDuration":7.4386848072562355,"seVolume":1},{"id":"5C4D2BDC-B333-45B1-BDC1-428AB0741432","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2008_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"「ただし、藤原さんは、このあと、速やかに職員室に向かってください。連休前の行動に関して確認をしますから。」","voiceCharacter":"東風谷早苗","duration":7.935442176870748,"title":"シーン 2008","slideTitle":"スライド #2008","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2008.jpeg","voiceDuration":7.935442176870748,"seVolume":1},{"id":"B0C51CCB-A1E8-4731-9E94-32E2A8376103","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2009_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-04_16-42.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","telop":"彼女はそういうと、去って行った。\n僕は、何となくの予測がついた状態で、職員室に向かう。","voiceCharacter":"操夢","duration":6.739773242630386,"title":"シーン 2009","slideTitle":"スライド #2009","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2009.jpeg","voiceDuration":6.739773242630386,"seVolume":1},{"id":"8DCEE0B2-468A-4EA2-92F7-D3C3F2F2436A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2010_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc253888_学校の職員室（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc253888_学校の職員室（日中）.jpg","telop":"僕はそれから、職員室に来ると、ある女性がやってくる。","voiceCharacter":"操夢","duration":6.739773242630386,"title":"シーン 2010","slideTitle":"スライド #2010","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2010.jpeg","voiceDuration":6.739773242630386,"seVolume":1},{"id":"7CD29C48-303B-4FAC-A684-DC69B68B24B4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2011_射命丸文.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc253888_学校の職員室（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc253888_学校の職員室（日中）.jpg","telop":"「とりあえず、別室に行きましょうか。」","voiceCharacter":"射命丸文","duration":2.215578231292517,"title":"シーン 2011","slideTitle":"スライド #2011","characterName":"射命丸文","audioTrack":"track_voice_char_EF7A","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2011.jpeg","voiceDuration":2.215578231292517,"seVolume":1},{"id":"02B52E8D-2421-40D3-836A-EFA043BB84DD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2012_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc227198_部室（昼）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","telop":"僕が彼女についていくと、やってきたのはある部室だった。","voiceCharacter":"操夢","duration":3.6006349206349206,"title":"シーン 2012","slideTitle":"スライド #2012","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2012.jpeg","voiceDuration":3.6006349206349206,"seVolume":1},{"id":"A2890814-3E4E-41EF-9A6F-F42D72026E40","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2013_射命丸文.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc227198_部室（昼）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","telop":"「ひとまず、遠足から今に至るまでの流れを説明してください。」","voi