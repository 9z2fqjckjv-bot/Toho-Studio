の日常総集編_6ce7fe1ac7.2034.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女がそういうと、僕は無意識のうちに、彼女の背中に隠れる。\nなぜだかわからないが、彼女が母である霊夢に見えていた。","id":"29F6840E-6925-43CC-959B-722E915EB261","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.40390022675737},{"bgmStartTimeOffset":0,"duration":5.745215419501133,"slideTitle":"スライド #2035","title":"シーン 2035","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2035_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2035.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲労.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女は暗闇から鋭い攻撃を受ける。\nそして、ぐちゃりと何か飛び散る。","id":"8F8EA937-2C4F-4A06-81C0-52C969FEEFA7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.745215419501133},{"bgmStartTimeOffset":0,"duration":3.78,"slideTitle":"スライド #2036","title":"シーン 2036","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2036_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2036.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それが血だとわかると、彼女から離れようとする。","id":"B399B57E-2A57-4A26-815F-E8400BD6B910","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.78},{"bgmStartTimeOffset":0,"duration":6.0147619047619045,"slideTitle":"スライド #2037","title":"シーン 2037","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2037_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2037.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「逃げるな、目の前の景色を目に焼き付けなさい…\nそうじゃないと次は、あなたの番になるわよ。」","id":"EA9704E3-F1CF-44D0-85BA-0C68ED33E45B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":6.0147619047619045},{"bgmStartTimeOffset":0,"duration":3.8756462585034015,"slideTitle":"スライド #2038","title":"シーン 2038","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2038_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2038.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc422703_血痕06【フリー素材あそび】.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女がそう言いながら、僕を庇い、再び攻撃を受ける。","id":"1F3E6CFA-8712-43EB-BAD1-DCA7DDFD0734","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.8756462585034015},{"b