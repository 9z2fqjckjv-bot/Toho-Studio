tle":"スライド #1870","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1870.jpeg","voiceDuration":5.636507936507937,"seVolume":1},{"id":"AB00FD83-35D6-49BF-AF9E-4ACD5D0BF412","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし普通.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1871_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","telop":"「ほら、ラベルも取れて、巻末のページももとに戻ったぞ。」","voiceCharacter":"霧雨魔理沙","duration":4.551995464852608,"title":"シーン 1871","slideTitle":"スライド #1871","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1871.jpeg","voiceDuration":4.551995464852608,"seVolume":1},{"id":"D31DF21C-6EFF-45FB-BA9B-770BD85DC9F5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし普通.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1872_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","telop":"僕は、彼女がそう言いながら、渡された本を見て、ある問題に気がつく。「魔理沙さん…これ…」僕はそう言いながら本を渡す。","voiceCharacter":"操夢","duration":8.558253968253968,"title":"シーン 1872","slideTitle":"スライド #1872","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1872.jpeg","voiceDuration":8.558253968253968,"seVolume":1},{"id":"F512592C-98AE-4B50-83D5-E30C18A034E6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし影あり苦笑.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1873_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","telop":"「えっ…？」私は、彼に渡した本が再び渡され、よく見る。\nそこには、魔法であえて隠した暗い過去を示すものがあった。","voiceCharacter":"霧雨魔理沙","duration":10.220748299319729,"title":"シーン 1873","slideTitle":"スライド #1873","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1873.jpeg","voiceDuration":10.220748299319729,"seVolume":1},{"id":"E2D48B32-FAF8-4833-A501-FCDFC22DD96B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし影あり苦笑.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1874_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","telop":"私は、一通りそれらを見ると、彼に手渡す。\n「この本が示す事実は、私とお前だけの秘密だぞ。」","voiceCharacter":"霧雨魔理沙","duration":8.429478458049887,"title":"シーン 1874","slideTitle":"スライド #1874","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1874.jpeg","voiceDuration":8.429478458049887,"seVolume":1},{"id":"4D7C4B82-24C1-4B0C-92B5-D7AD6A9E8645","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし影あり苦笑.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1875_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","telop":"僕はそう言い、受け取った本を見ると、そこには僕が以前に通っていた男子校とほぼ同等の行為があったことを示していた。","voiceCharacter":"操夢","duration":7.824126984126984,"title":"シーン 1875","slideTitle":"スライド #1875","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1875.jpeg","voiceDuration":7.824126984126984,"seVolume":1},{"id":"B22B5A97-0DE8-4CF5-93D0-6B01369F7655","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし苦笑涙.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1876_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","telop":"それから、彼女は以前僕が通っていた男子校と、\n同じ陰湿なそれについて、１から話し出すのだった。","voiceCharacter":"霧雨魔理