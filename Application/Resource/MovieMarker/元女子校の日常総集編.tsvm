dAudio\/Slide_1076_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1076.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私が咲夜を連れて、食堂に戻ると、そこではフランが驚きの表情をしていた。「フラン、キッチンから紅茶を出してちょうだい。」","id":"DCD37D94-7C17-467E-ADD8-77999FB8EB24","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.077573696145125},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","bgmStartTimeOffset":0,"duration":6.794489795918367,"slideTitle":"スライド #1077","title":"シーン 1077","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1077_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1077.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「わかった、今からとってくるね。」\n私はそう言うと、紅茶をとりにキッチンに向かった。","id":"7B3DC218-2C18-46FE-A451-1C95CE84A012","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":6.794489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","bgmStartTimeOffset":0,"duration":2.369229024943311,"sli