":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1560_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「なんで彼は、あんな巨大組織の令嬢の裸を見たのかしら…。\nたとえ、アクシデントでもあんなことを言うなんて…。」","voiceCharacter":"レミリア・スカーレット","duration":6.9254875283446715,"title":"シーン 1560","slideTitle":"スライド #1560","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1560.jpeg","voiceDuration":6.9254875283446715,"seVolume":1},{"id":"779E902A-7456-4725-96E3-5481093879E6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1561_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「とにかく、彼が旅行から戻ってきたら、厳しく言いつけて、戦いに勝って、私たちの方に、なんとしてでも引き込むわよ。」","voiceCharacter":"レミリア・スカーレット","duration":8.204081632653061,"title":"シーン 1561","slideTitle":"スライド #1561","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1561.jpeg","voiceDuration":8.204081632653061,"seVolume":1},{"id":"360DFB58-6AFE-485D-9290-C72E7A56A236","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1562_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「私だって、彼がいなくなるのは嫌だし、お姉様に協力する。」","voiceCharacter":"フランドール・スカーレット","duration":5.200748299319728,"title":"シーン 1562","slideTitle":"スライド #1562","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1562.jpeg","voiceDuration":5.200748299319728,"seVolume":1},{"id":"615E8024-9EC9-4747-93B2-0AC1627113D4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1563_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「いいこと思いついたわ、フラン。何かしらの口実をつけて、学校と彼の母親を裏切る前提で味方につけなさい。」","voiceCharacter":"レミリア・スカーレット","duration":7.6046485260770975,"title":"シーン 1563","slideTitle":"スライド #1563","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1563.jpeg","voiceDuration":7.6046485260770975,"seVolume":1},{"id":"CA9F3B58-BD04-4BA2-A4C4-269F75BE50F4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1564_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「えっ…、そんなことして大丈夫なの？」","voiceCharacter":"フランドール・スカーレット","duration":2.8219954648526078,"title":"シーン 1564","slideTitle":"スライド #1564","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1564.jpeg","voiceDuration":2.8219954648526078,"seVolume":1},{"id":"14058CEE-1DEC-4317-ADB0-B00FB74AB414","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1565_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「いいのよ別に、これは女同士の泥沼試合なのだから。」","voiceCharacter":"レミリア・スカーレット","duration":3.5963265306122447,"title":"シーン 1565","slideTitle":"スライド #1565","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1565.jpeg","voiceDuration":3.5963265306122447,"seVolume":1},{"id":"F6E4EBB2-69A2-4882-91FC-C29B6BA266A1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1566_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","telop":"「そう…わかった。」\n私はそれから、お姉様の言うとおりに動くのだった。","voiceCharacter":"フランドール・スカーレット","duration":5.909478458049887,"title":"シーン 1566","slideTitle":"スライド #1566","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1566.jpeg","voiceDuration":5.909478458049887,"seVolume":1},{"id":"E4F44EE2-5597-4407-8E3B-DB9988B4C528","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmName":"BGM: nc321386_[東方アレンジ]_495年のジャズフェスティバル_U.N.オーエンは彼女なのか？","animationDuration":5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"夜のお誘い.png","animationNote":"5秒","telop":"フランドール・スカーレット（紅魔建設の破壊作業員）","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","duration":5,"title":"シーン 1567: フランドール・スカーレット（紅魔建設の破壊作業員）","slideTitle":"スライド #1567","characterName":"操夢","bgmVolume":0.25069700886262924,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc321386_[東方アレンジ]_495年のジャズフェスティバル_U.N.オーエンは彼女なのか？.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1567.jpeg","seVolume":1},{"id":"1F61D9B5-F6F3-49B2-8EFF-1C0FAEA6CF24","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1568_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"私は、ふとため息を学園長室でついていた。「はぁ…」\n理由は明白で、昨晩にあった、ある電話である。","voiceCharacter":"隠岐奈","duration":7.505510204081633,"title":"シーン 1568","slideTitle":"スライド #1568","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1568.jpeg","voiceDuration":7.505510204081633,"seVolume":1},{"id":"594ABC9E-0C0D-4951-A386-8F01FE189549","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1569_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"私が、昨日、残業で職務をこなしていると、一本の電話が入る。\nそれを知らせにきた、萃香はいかにも面倒そうな顔をしていた。","voiceCharacter":"隠岐奈","duration":9.184263038548753,"title":"シーン 1569","slideTitle":"スライド #1569","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1569.jpeg","voiceDuration":9.184263038548753,"seVolume":1},{"id":"90B4A83E-BC5A-4B85-A3F1-5BBA05613E3F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png","transitionName":"なし","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"私は、彼女の言葉を受けると、内線を繋ぎ、相手の声を聞く。\nその声は、中等部の女子生徒、古明地こいしの声だった。","duration":9.20968253968254,"title":"シーン 1570","slideTitle":"スライド #1570","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1570.jpeg","seVolume":1},{"id":"527D44D3-2525-4DDA-93A2-E0448EFA5A00","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（弱る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1571_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"私は、電話越しに彼女が起こっていることを感じ、なぜ起こっているのかと聞く。すると例の彼が、彼女の裸を見たと言う。","voiceCharacter":"隠岐奈","duration":8.503832199546485,"title":"シーン 1571","slideTitle":"スライド #1571","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1571.jpeg","voiceDuration":8.503832199546485,"seVolume":1},{"id":"F0D08C46-78CC-48CD-8AE3-72B2D69D90A4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1572_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"私と萃香は驚きながらも、相手の話を聞く。すると、彼女はある衝撃的な発言を言ってきた。私は、その内容に困惑する。","voiceCharacter":"隠岐奈","duration":9.934784580498865,"title":"シーン 1572","slideTitle":"スライド #1572","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1572.jpeg","voiceDuration":9.934784580498865,"seVolume":1},{"id":"052D58D9-B7F0-4D91-90AF-04CEBB9D09A2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1573_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"だが、すぐに永琳からの電話も飛んできて、\n私はこいしの電話を保留にし、そちらに切り替える。","voiceCharacter":"隠岐奈","duration":6.302902494331065,"title":"シーン 1573","slideTitle":"スライド #1573","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1573.jpeg","voiceDuration":6.302902494331065,"seVolume":1},{"id":"53073FE1-8483-42E3-9E89-6F4C16721FCF","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1574_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"永琳が言うには、彼は貴重な研究対象だから、学園から話さずに、学校側の手が届く範囲でいさせたいとの要望だった。","voiceCharacter":"隠岐奈","duration":8.660725623582767,"title":"シーン 1574","slideTitle":"スライド #1574","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1574.jpeg","voiceDuration":8.660725623582767,"seVolume":1},{"id":"6B7194A0-2C76-43F7-8421-689B0FDB962C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1575_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"私は、彼が貴重な人物であることは認識していたが、それほど重要性の高い人物だとは、正直に言って感じてなかった。","voiceCharacter":"隠岐奈","duration":8.607596371882087,"title":"シーン 1575","slideTitle":"スライド #1575","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1575.jpeg","voiceDuration":8.607596371882087,"seVolume":1},{"id":"7DD52053-9897-4E43-905C-06026507BAB1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1576_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"私は、一通り永琳の意見を聞き終えると、こいしの方に再度、切り替える。すると、彼女は、これは戦いだと、言ってきた。","voiceCharacter":"隠岐奈","duration":9.121020408163265,"title":"シーン 1576","slideTitle":"スライド #1576","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1576.jpeg","voiceDuration":9.121020408163265,"seVolume":1},{"id":"F65E5B22-ED00-4901-A5D3-FBE680826714","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1577_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"そして、彼女は控えめだったが、もし彼女たちの要請に応じられないなら、学園の資金提供などの協力は打ち切ると言ってきた。","voiceCharacter":"隠岐奈","duration":8.534149659863946,"title":"シーン 1577","slideTitle":"スライド #1577","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1577.jpeg","voiceDuration":8.534149659863946,"seVolume":1},{"id":"F1D418AB-E5FE-4340-9B27-79EC6718CF01","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1578_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"どうやらすでに、彼女の両親がトップに鎮座する地下底国グループの意見を聞き取り、グループの見解になったそうだった。","voiceCharacter":"隠岐奈","duration":7.774058956916099,"title":"シーン 1578","slideTitle":"スライド #1578","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1578.jpeg","voiceDuration":7.774058956916099,"seVolume":1},{"id":"57835C07-4403-47BE-B6E7-ED7A1FFE2DCE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1579_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"地下底国グループは、その名の通り、この社会の土台や裏側を幅広く、汎用的に事業を展開し支える巨大組織である。","voiceCharacter":"隠岐奈","duration":8.490408163265306,"title":"シーン 1579","slideTitle":"スライド #1579","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1579.jpeg","voiceDuration":8.490408163265306,"seVolume":1},{"id":"6F2F4F39-47A1-4C16-AE34-6A77524E3BC6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1580_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"彼女は、今までその名では行動することはなかった。\n学校生活とグループでの完全な使い分けをしていたのだ。","voiceCharacter":"隠岐奈","duration":7.454875283446712,"title":"シーン 1580","slideTitle":"スライド #1580","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1580.jpeg","voiceDuration":7.454875283446712,"seVolume":1},{"id":"27779CDB-FA26-4447-8F53-C7C52E713DCF","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1581_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"そんな彼女の裸を運悪く見てしまった彼を発端に、彼女は今まであえて潜めていたグループを使い始めたことに、私は驚いた。","voiceCharacter":"隠岐奈","duration":8.687165532879819,"title":"シーン 1581","slideTitle":"スライド #1581","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1581.jpeg","voiceDuration":8.687165532879819,"seVolume":1},{"id":"ACFF0118-B98C-4999-85E6-F8D77FEB5C7F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1582_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"そして、彼女は、彼が居候している家が立ち上げている紅魔建設と、彼の母親にも宣戦布告を済ませたと言う。","voiceCharacter":"隠岐奈","duration":7.917913832199546,"title":"シーン 1582","slideTitle":"スライド #1582","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1582.jpeg","voiceDuration":7.917913832199546,"seVolume":1},{"id":"CBED5806-2BD4-41A7-85B8-D68C4A090B7F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1583_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"彼女は、自分の裸が見られた後、彼の素性を問いただし、彼がいなくなると、隠し持っていたPCで彼の母親を調べたという。","voiceCharacter":"隠岐奈","duration":8.996439909297052,"title":"シーン 1583","slideTitle":"スライド #1583","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1583.jpeg","voiceDuration":8.996439909297052,"seVolume":1},{"id":"FB49F271-7645-49EC-B422-5411A47C0262","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1584_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"そして、その結果、彼の母親が務める神社の跡取りとして、彼に期待されているのを知った彼女は、宣戦布告をしたのだ。","voiceCharacter":"隠岐奈","duration":8.520204081632652,"title":"シーン 1584","slideTitle":"スライド #1584","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1584.jpeg","voiceDuration":8.520204081632652,"seVolume":1},{"id":"C24F4D92-0229-450B-8264-B80CE57DD141","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1585_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-11-10_17-38.png","telop":"そして、最後にはこの4つ巴の戦いは、旅行が終わったら、即時に始まると高圧的に宣言し、その電話は途切れたのだった。","voiceCharacter":"隠岐奈","duration":8.817687074829932,"title":"シーン 1585","slideTitle":"スライド #1585","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1585.jpeg","voiceDuration":8.817687074829932,"seVolume":1},{"id":"D772C87D-8E3B-41C3-85C6-A21D9A40A44C","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1586_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"私は、彼女が地下底国グループの令嬢であることは、把握していたつもりだったが、今回の出来事で、それを実感させられた。","voiceCharacter":"隠岐奈","duration":8.648004535147392,"title":"シーン 1586","slideTitle":"スライド #1586","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1586.jpeg","voiceDuration":8.648004535147392,"seVolume":1},{"id":"D7D49F61-E3AF-467D-964E-3437105F7C7D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1587_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"だが、これから始まるであろう、\nその戦いに不安を覚える、私だった。","voiceCharacter":"隠岐奈","duration":4.893219954648526,"title":"シーン 1587","slideTitle":"スライド #1587","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1587.jpeg","voiceDuration":4.893219954648526,"seVolume":1},{"id":"4978CBF8-B4E8-4AF1-AFA1-AC3D47EA21A8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","transitionName":"なし","bgmName":"BGM: nc299045_【東方自作アレンジ】ASTROMIKO【少女綺想曲】","animationDuration":5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"5秒","telop":"博麗霊夢（博麗神社の巫女）","duration":5,"title":"シーン 1588: 博麗霊夢（博麗神社の巫女）","slideTitle":"スライド #1588","characterName":"操夢","bgmVolume":0.2555899187592319,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc299045_【東方自作アレンジ】ASTROMIKO【少女綺想曲】.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1588.jpeg","seVolume":1},{"id":"E7536F3F-7BEC-482D-A88D-5B56779EB72E","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1589_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「はぁ」私は、ため息をつきながら、神社の敷地を箒で掃いていた。ため息が出る理由は、巨大組織の令嬢からの電話だった。","voiceCharacter":"博麗霊夢","duration":10.165736961451247,"title":"シーン 1589","slideTitle":"スライド #1589","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1589.jpeg","voiceDuration":10.165736961451247,"seVolume":1},{"id":"31BE6245-211F-446A-9F52-4FB1233CF99C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1590_先代の巫女.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「ほら、ため息なんかついてないで、チャチャっとやったらどうなのよ、霊夢」私はそう、箒を持っている娘の霊夢に言う。","voiceCharacter":"先代の巫女","duration":5.754444444444444,"title":"シーン 1590","slideTitle":"スライド #1590","characterName":"先代の巫女","audioTrack":"track_voice_char_2CB2","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1590.jpeg","voiceDuration":5.754444444444444,"seVolume":1},{"id":"27072EE0-511E-4155-A9A9-0856BDB27B2D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1591_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「はぁ、そんなことくらい分かってるわよ、言わずとも。」","voiceCharacter":"博麗霊夢","duration":3.8844897959183675,"title":"シーン 1591","slideTitle":"スライド #1591","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1591.jpeg","voiceDuration":3.8844897959183675,"seVolume":1},{"id":"AE896530-D428-4803-B03A-3865EA52BC73","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1592_先代の巫女.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「そうなら、もっとやる気出して、テキパキ履きなさい。それで、例の跡取りになりそうな孫は、どうするのよ、今後？」","voiceCharacter":"先代の巫女","duration":6.020521541950114,"title":"シーン 1592","slideTitle":"スライド #1592","characterName":"先代の巫女","audioTrack":"track_voice_char_2CB2","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1592.jpeg","voiceDuration":6.020521541950114,"seVolume":1},{"id":"31B181F8-088E-4F88-B5B6-CA605C6BBCF7","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1593_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","telop":"「それは…」私は、ここで素直に、宣戦布告の事情を伝えるかどうか迷う。だが、伝えた方がいいと判断し、話し始める。","voiceCharacter":"博麗霊夢","duration":10.576984126984128,"title":"シーン 1593","slideTitle":"スライド #1593","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1593.jpeg","voiceDuration":10.576984126984128,"seVolume":1},{"id":"C9975D0A-0D5C-434A-88E1-EDDC3067DBF7","seStartTimeOffset":0,"