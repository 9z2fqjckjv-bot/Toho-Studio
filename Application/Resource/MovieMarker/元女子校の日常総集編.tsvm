es\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1136.jpeg","voiceDuration":7.4354195011337865,"seVolume":1},{"id":"05BE7B27-9B56-4B9D-80F1-2EB24D48442B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1137_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256899_病室-夜-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","telop":"それから、お弁当を数十分かけて、食べ終えると、僕は、そのまま窓の外に視線を向ける。そして、昨日のことを考える。","voiceCharacter":"操夢","duration":8.85390022675737,"title":"シーン 1137","slideTitle":"スライド #1137","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1137.jpeg","voiceDuration":8.85390022675737,"seVolume":1},{"id":"3450FF70-8B6D-4492-9B21-065B73003A46","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1138_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256899_病室-夜-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","telop":"すると、だんだんと瞼が落ちそうになる。\nだが、ある光景が僕の脳裏を横切る。","voiceCharacter":"操夢","duration":5.558253968253968,"title":"シーン 1138","slideTitle":"スライド #1138","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1138.jpeg","voiceDuration":5.558253968253968,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/Pink_Noise01\/Pink_Noise01-1.mp3","id":"CC5CE8A4-A09B-4462-807C-685DE74DBBCE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（狂気）.pxd","transitionName":"なし","animationDuration":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.pxd","animationNote":"表示時間：1秒","telop":"シーン 1139","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.pxd","duration":1,"title":"シーン 1139","slideTitle":"スライド #1139","characterName":"操夢","bgmVolume":0.7,"seName":"SE: Pink_Noise01-1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1139.jpeg","seVolume":0.85},{"id":"540C545F-E16A-4BD9-B178-6720DBB12F2D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲れた顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1140_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256899_病室-夜-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","telop":"「紅夢、大丈夫？顔が青ざめてるよ…。」","voiceCharacter":"フランドール・スカーレット","duration":3.546984126984127,"title":"シーン 1140","slideTitle":"スライド #1140","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1140.jpeg","voiceDuration":3.546984126984127,"seVolume":1},{"id":"4171BA98-CADE-447D-A0C6-3DB94488F614","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校