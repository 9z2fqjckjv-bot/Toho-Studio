haracterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"[SE] 海岸1.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1312.jpeg","voiceDuration":8.893038548752834,"seVolume":0.1530708016074449},{"voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","transitionName":"なし","telop":"僕は、彼女が海水に濡れさせないように、彼女を止めるように動く。すると、彼女が僕の腕に寄りかかるように倒れる。","title":"シーン 1313","slideTitle":"スライド #1313","voice2StartTimeOffset":0,"seStartTimeOffset":-77.54140589569033,"characterName":"操夢","bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/衣擦れ2.mp3","bgmVolume":2,"duration":7.988684807256236,"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1313.jpeg","seVolume":0.1530708016074449,"animationName":"なし","seName":"[SE] 海岸1.mp3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1313_操夢.wav","voiceCharacter":"操夢","id":"3F3DF6B2-1185-4D92-92C3-6B4819E714A6","voiceDuration":7.988684807256236,"backgroundName":"image59.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","bgmName":"BGM: 衣擦れ2","bgmStartTimeOffset":7.56},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","id":"D4546F31-1935-4E7E-88C6-4A215E8C4170","seStartTimeOffset":-85.53009070294684,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（