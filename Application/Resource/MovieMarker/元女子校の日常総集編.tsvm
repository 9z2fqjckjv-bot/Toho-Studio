":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"ふと隣を見ると彼女がすやすやと気持ちよさそうに眠っていた。","voiceCharacter":"操夢","duration":4.03063492063492,"title":"シーン 264","slideTitle":"スライド #264","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.264.jpeg","voiceDuration":4.03063492063492,"seVolume":1},{"id":"5C93B692-5737-4E1C-95FE-517EB3184E25","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_265_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791188423_26966.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","telop":"僕は、彼女を起こさないように、そっとベッドから降りる。","voiceCharacter":"操夢","duration":3.5865079365079366,"title":"シーン 265","slideTitle":"スライド #265","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.265.jpeg","voiceDuration":3.5865079365079366,"seVolume":1},{"id":"41C4B5D4-3ABA-4CC7-8712-EF5D403F2BFB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし寝起き顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_266_古明地こいし.wav","voiceStar