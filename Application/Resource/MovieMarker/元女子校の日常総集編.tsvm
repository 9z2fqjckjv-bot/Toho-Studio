9637188,"title":"シーン 5","slideTitle":"スライド #5","audioTrack":"track_voice_soumu","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.005.jpeg","voiceDuration":4.231065759637188,"seVolume":1},{"id":"8D5DB2FC-69C2-4F04-82EC-8F99A2DC6C7A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「そういえば、入学式は、親の付き添いっているの？」","voiceCharacter":"博麗霊夢","duration":4.0619954648526075,"title":"シーン 6","slideTitle":"スライド #6","audioTrack":"track_voice_reimu","characterName":"博麗霊夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.006.jpeg","voiceDuration":4.0619954648526075,"seVolume":1},{"id":"03EBE79F-4760-49E9-8430-79EFD007F8C4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「いや、大丈夫だから、付き添わなくていいよ。」","voiceCharacter":"操夢","duration":3.108253968253968,"title":"シーン 7","slideTitle":"スライド #7","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.007.jpeg","voiceDuration":3.108253968253968,"seVolume":1},{"id":"01D195AC-A687-4889-9EB2-92360F1717ED","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「そう、じゃあ、あんたの分の食器は自分で洗いなさいね。\n私は、もう神社に向かうから。」","voiceCharacter":"博麗霊夢","duration":7.211995464852608,"title":"シーン 8","slideTitle":"スライド #8","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.008.jpeg","voiceDuration":7.211995464852608,"seVolume":1},{"id":"E84BA652-B3C7-4FA8-8924-0D37971C7636","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"「分かった。」\n僕がそういうと、彼女はそのまま家を出ていった。","voiceCharacter":"操夢","duration":4.262607709750567,"title":"シーン 9","slideTitle":"スライド #9","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.009.jpeg","voiceDuration":4.262607709750567,"seVolume":1},{"id":"EBFAA67B-90B9-40F4-913C-4AE93480FB19","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"僕は、それから数分も経たずに、朝食を食べ切ると、そのまあ流しに食器を入れ、ささっと洗剤で洗う。","voiceCharacter":"操夢","duration":7.069115646258504,"title":"シーン 10","slideTitle":"スライド #10","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.010.jpeg","voiceDuration":7.069115646258504,"seVolume":1},{"id":"42F59D6B-DF2C-482A-B69B-C236CBE80848","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","telop":"そして、洗い物が終わると、自分の部屋に戻る。","voiceCharacter":"操夢","duration":3.2756462585034014,"title":"シーン 11","slideTitle":"スライド #11","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.011.jpeg","voiceDuration":3.2756462585034014,"seVolume":1},{"id":"D89A3A69-0929-4574-BD0E-278BCB137FFC","seStartTimeOff