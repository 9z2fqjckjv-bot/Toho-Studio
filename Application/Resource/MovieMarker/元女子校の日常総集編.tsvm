Studio\/GeneratedAudio\/Slide_181_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「ん…」僕はふと目が覚めると、\n朝日が登り、窓から日光が差し込んでいた。","voiceCharacter":"操夢","duration":5.186507936507937,"title":"シーン 181","slideTitle":"スライド #181","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.181.jpeg","voiceDuration":5.186507936507937,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","id":"2E889FF0-3EFA-4640-B8FC-885C533A63A3","seStartTimeOffset":0.3,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_182_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"そして、僕は大きく背伸びしてあくびをすると、誰かが部屋の戸を叩く。「入ってきて大丈夫ですよ。」僕はそう返す。","voiceCharacter":"操夢","duration":8.0756462585034,"title":"シーン 182","slideTitle":"スライド #182","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 木のドアをノック1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.182.jpeg","voiceDuration":8.0756462585034,"seVolume":0.85},{"id":"65213AF8-F625-41FC-BD17-38DD0C5E0FDC","seStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/てゐ（微笑）.png","animationName":"なし","transitionName":"なし","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「今朝は、よく眠れましたか、紅夢さん。？」\n画像出典\nニコニコモンズ\nみんちりえ\nAppleCreatorStudio","duration":3.5,"title":"シーン 183","slideTitle":"スライド #183","characterName":"因幡てゐ","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.183.jpeg","seVolume":1},{"id":"1B3B5A48-1A3A-47AF-A157-45657381808C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/てゐ（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_184_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「はい。それで、これから検査…ですか？」","voiceCharacter":"操夢","duration":3.190861678004535,"title":"シーン 184","slideTitle":"スライド #184","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.184.jpeg","voiceDuration":3.190861678004535,"seVolume":1},{"id":"CAACFDAD-A9E2-471A-B062-AC2171A19C69","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/てゐ（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_185_因幡てゐ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「ええ、それでは、検査室に案内しますね。」","voiceCharacter":"因幡てゐ","duration":2.711655328798186,"title":"シーン 185","slideTitle":"スライド #185","characterName":"因幡てゐ","audioTrack":"track_voice_char_057D","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.185.jpeg","voiceDuration":2.711655328798186,"seVolume":1},{"id":"4D61B306-011D-4BBE-81EF-C442729166E8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/てゐ（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_186_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「わかりました。」\n僕はそういうと、ベッドからおり、検査室に向かっていった。","voiceCharacter":"操夢","duration":5.237596371882086,"title":"シーン 186","slideTitle":"スライド #186","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.186.jpeg","voiceDuration":5.237596371882086,"seVolume":1},{"id":"43E97ED0-82EF-46E8-9F83-593F55903184","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_187_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、それから検査を終えると、\nお昼休憩のタイミングで教室に入る。","voiceCharacter":"操夢","duration":4.758253968253968,"title":"シーン 187","slideTitle":"スライド #187","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.187.jpeg","voiceDuration":4.758253968253968,"seVolume":1},{"id":"04AB8FF9-386F-4B13-BD18-5FBA30810612","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_188_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「なぜ、お昼時になってあなたが来るのですか…？」\n私は、彼が来たことに驚き、そう聞く。","voiceCharacter":"古明地さとり","duration":5.203786848072562,"title":"シーン 188","slideTitle":"スライド #188","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.188.jpeg","voiceDuration":5.203786848072562,"seVolume":1},{"id":"749F0B13-D7EF-40BC-AA71-093A7EC15FBC","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_189_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「昨日、校庭で3000m走ったら、バタって倒れて、さっきまで…」僕がそう言っていると、突如放送が入る。","voiceCharacter":"操夢","duration":8.016938775510203,"title":"シーン 189","slideTitle":"スライド #189","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.189.jpeg","voiceDuration":8.016938775510203,"seVolume":1},{"id":"7B30DA47-C3BE-4543-AAB2-A82DC692356A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_190_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「全校生徒及び児童に次ぐ、本日、５限から７限までは、\nグラウンドで全クラス合同のエンドレスランを行う…」","voiceCharacter":"萃香","duration":5.841315192743764,"title":"シーン 190","slideTitle":"スライド #190","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.190.jpeg","voiceDuration":5.841315192743764,"seVolume":1},{"id":"9097BCC5-4607-43DB-945D-38963AC704A8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_191_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「どうやら、あまり話している余裕はなさそうですね…、ささっと昼食とって校庭に出たほうがいいですよ。」","voiceCharacter":"古明地さとり","duration":5.220589569160998,"title":"シーン 191","slideTitle":"スライド #191","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.191.jpeg","voiceDuration":5.220589569160998,"seVolume":1},{"id":"2316E371-C1EB-404A-ACCD-AFC1AEE10749","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_192_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"彼女がそう呟き、数分で放送は終わり、周りが、急ぎ始める。\n僕は、そこで、今日のお弁当がないことを思い出す。","voiceCharacter":"操夢","duration":8.684331065759638,"title":"シーン 192","slideTitle":"スライド #192","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.192.jpeg","voiceDuration":8.684331065759638,"seVolume":1},{"id":"709FCF88-25A8-4B9A-85EC-C9216CEEFEBF","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_193_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕はそこで、彼女に学食はあるか聞こうとしたが、すでにそこにはいなかった。僕は仕方がなく、教室を出る。","voiceCharacter":"操夢","duration":7.694126984126984,"title":"シーン 193","slideTitle":"スライド #193","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.193.jpeg","voiceDuration":7.694126984126984,"seVolume":1},{"id":"29F336CB-9FD8-4E4F-A623-4EBB012AB91F","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_194_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"そして、校庭に来ると、大勢の女子たちが、グラウンドで動き回っていた。すると、ある女子と体がぶつかる。","voiceCharacter":"操夢","duration":7.612607709750567,"title":"シーン 194","slideTitle":"スライド #194","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.194.jpeg","voiceDuration":7.612607709750567,"seVolume":1},{"id":"58209336-C501-42B0-A013-C912FC0ACF16","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_195_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「あの、大丈夫ですか？」","voiceCharacter":"古明地こいし","duration":2.1889342403628116,"title":"シーン 195","slideTitle":"スライド #195","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe