0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1180.jpeg","voiceDuration":0.8201587301587302,"seVolume":1},{"id":"DF3174F0-512A-4F22-9AED-F3D331324EE0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1181_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"僕の問いかけに、言い淀む彼女を見て、思わずため息が漏れる。\n「ATMを探しに向かうので、その間、服を見てていいですよ。」","voiceCharacter":"操夢","duration":8.708253968253969,"title":"シーン 1181","slideTitle":"スライド #1181","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1181.jpeg","voiceDuration":8.708253968253969,"seVolume":1},{"id":"968DB406-D070-4AD7-8DE7-3FA7C10CC91A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1182_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「えっ、こいし。本気でくじ引きをするの？紅夢さんも、\n無理にお金を出そうとしなくて、大丈夫ですよ。」","voiceCharacter":"古明地さとり","duration":5.91,"title":"シーン 1182","slideTitle":"スライド #1182","characterName":"古明地さとり","audioTrack":"track_voice_