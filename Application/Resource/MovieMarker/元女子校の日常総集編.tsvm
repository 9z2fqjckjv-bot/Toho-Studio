ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.851.jpeg","voiceDuration":4.161995464852608,"seVolume":1},{"id":"ECFE1356-F9E9-4768-A5AD-826E8C3D93C7","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_852_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"「今度受ける試験の勉強ですよ。」","voiceCharacter":"操夢","duration":2.1865079365079363,"title":"シーン 852","slideTitle":"スライド #852","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.852.jpeg","voiceDuration":2.1865079365079363,"seVolume":1},{"id":"2E2CDA1B-D433-454F-9307-1A338204070B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_853_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"「どんな試験を受けるの？」","voiceCharacter":"フランドール・スカーレット","duration":1.736984126984127,"title":"シーン 853","slideTitle":"スライド #853","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.853.jpeg","voiceDuration":1.736984126984127,"seVolume":1},{"id":"CE10E452-0F0E-4ECA-A29D-DF8A423A8EA6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_854_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"「全国財閥高統一模試ですよ。」\n僕はそういうと、勉強を再開した。\n元女子校の日常\n〜彼が図書館で勉強していると、フランが話しかけてきて…〜","voiceCharacter":"操夢","duration":5.308253968253968,"title":"シーン 854","slideTitle":"スライド #854","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.854.jpeg","voiceDuration":5.308253968253968,"seVolume":1},{"id":"748182B9-FD9C-4801-A211-8A7C598A070F","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_855_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"それから、あっという間に、時間が経ち、\n気がつけば転校してから、半月の程の期間が経っていた。","voiceCharacter":"操夢","duration":6.710430839002267,"title":"シーン 855","slideTitle":"スライド #855","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.855.jpeg","voiceDuration":6.710430839002267,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/教室の戸を開ける.mp3","id":"A1D834E8-685A-41CB-847A-2C833013B9A7","seStartTimeOffset":0.3,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_856_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"そして、今日は、この2週間ほどで勉強した全国財閥高統一模試を受ける日だった。すると、教室の扉が開き、担任が入ってくる。","voiceCharacter":"操夢","duration":10.153469387755102,"title":"シーン 856","slideTitle":"スライド #856","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 教室の戸を開ける","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.856.jpeg","voiceDuration":10.153469387755102,"seVolume":0.85},{"id":"11BFDEAA-E37A-4E11-B6E5-DB36219E3AF8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_857_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、素早く席を立ち上がり、クラスメイトに合わせた朝の挨拶をする。そして、彼女の合図とともに席に座る。","voiceCharacter":"操夢","duration":7.927823129251701,"title":"シーン 857","slideTitle":"スライド #857","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.857.jpeg","voiceDuration":7.927823129251701,"seVolume":1},{"id":"7FD765F7-7DA5-4898-AB48-78EA83FCD689","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_858_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「それでは、朝礼を始めます。今日は、毎月恒例の定期ミニテスト日です。全時限でミニテストがあるので、覚悟してください。」","voiceCharacter":"東風谷早苗","duration":8.562222222222223,"title":"シーン 858","slideTitle":"スライド #858","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.858.jpeg","voiceDuration":8.562222222222223,"seVolume":1},{"id":"8F3B9BAC-B815-4FCF-A556-55E0EC58D84D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_859_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、彼女の発言に驚く。ミニテストがあるなんて聞いてなかったからだ。だが、彼女がある衝撃的な発言をする。","voiceCharacter":"操夢","duration":8.508253968253968,"title":"シーン 859","slideTitle":"スライド #859","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.859.jpeg","voiceDuration":8.508253968253968,"seVolume":1},{"id":"A6F01FA2-EFEA-48CA-B617-F24CD516CF88","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_860_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「藤原さん、あなたは今日、ミニテストの代わりに、体力測定を行いますから、このあとすぐに、萃香先生を訪ねるように。」","voiceCharacter":"東風谷早苗","duration":8.08814058956916,"title":"シーン 860","slideTitle":"スライド #860","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.860.jpeg","voiceDuration":8.08814058956916,"seVolume":1},{"id":"11851478-55B8-482B-A6E5-0BF5F990CF88","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_861_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「あっ…、はい…、分かりました…」僕はそう返す。","voiceCharacter":"操夢","duration":3.2582539682539684,"title":"シーン 861","slideTitle":"スライド #861","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.861.jpeg","voiceDuration":3.2582539682539684,"seVolume":1},{"id":"51C5576B-7750-49DF-A332-9CCF3A1B1ACD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_862_東風谷早苗.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「連絡は以上です。皆試験に励むように。」","voiceCharacter":"東風谷早苗","duration":3.0212018140589567,"title":"シーン 862","slideTitle":"スライド #862","characterName":"東風谷早苗","audioTrack":"track_voice_char_D32F","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.862.jpeg","voiceDuration":3.0212018140589567,"seVolume":1},{"id":"94FA07CC-074C-4164-AFA2-1B345827FA8E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_863_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"彼女はそういうと、去っていった。僕は、ぼんやりとしていると、突如として、先ほど言っていた人が入ってくる。","voiceCharacter":"操夢","duration":7.607165532879819,"title":"シーン 863","slideTitle":"スライド #863","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.863.jpeg","voiceDuration":7.607165532879819,"seVolume":1},{"id":"1F7389A8-CB93-45A4-8359-AF7808A39D17","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_864_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「藤原くん、ボケっとしてないで、\nさっさと私の後に着いてきなさい。」","voiceCharacter":"萃香","duration":3.5696598639455783,"title":"シーン 864","slideTitle":"スライド #864","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.864.jpeg","voiceDuration":3.5696598639455783,"seVolume":1},{"id":"8092511D-73E9-4343-B9CA-EA6E3B0352B5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_865_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕はそう彼女に言われ、後ろをついていくのだった。","voiceCharacter":"操夢","duration":3.15281179138322,"title":"シーン 865","slideTitle":"スライド #865","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.865.jpeg","voiceDuration":3.15281179138322,"seVolume":1},{"id":"18E5F705-A043-4F57-AAE7-9A13F780E907","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_866_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"そして、彼女についていくと、やってきたのは校庭だった。","voiceCharacter":"操夢","duration":3.7897732426303854,"title":"シーン 866","slideTitle":"スライド #866","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.866.jpeg","voiceDuration":3.7897732426303854,"seVolume":1},{"id":"537498DD-30BC-43A5-AB7A-6621D3A9F849","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_867_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「準備体操済ませて、とりあえずグラウンドを3周しなさい。」","voiceCharacter":"萃香","duration":2.9696598639455782,"title":"シーン 867","slideTitle":"スライド #867","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.867.jpeg","voiceDuration":2.9696598639455782,"seVolume":1},{"id":"3B1431F9-C82F-49F3-9A63-155D1C27931B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_868_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「分かりました…」僕は、彼女の有無を言わさぬ態度に、ある一種の恐ろしさを感じながら、準備体操をして走る。","voiceCharacter":"操夢","duration":7.593038548752834,"title":"シーン 868","slideTitle":"スライド #868","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.868.jpeg","voiceDuration":7.593038548752834,"seVolume":1},{"id":"E1F72165-8420-4C98-9837-62246C71E2C9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_869_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「次は、樽投げだ。この酒樽を思いきっり投げ飛ばしなさい。」","voiceCharacter":"萃香","duration":3.4013151927437644,"title":"シーン 869","slideTitle":"スライド #869","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.869.jpeg","voiceDuration":3.4013151927437644,"seVolume":1},{"id":"D28DF37F-3C82-4F90-B742-25C2DBA20C96","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_870_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は彼女に言われるがままに、酒樽を一所懸命に投げる。","voiceCharacter":"操夢","duration":3.8669387755102043,"title":"シーン 870","slideTitle":"スライド #870","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.870.jpeg","voiceDuration":3.8669387755102043,"seVolume":1},{"id":"73831E4B-FB4C-4920-9B19-BD5F35AF882A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_871_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「今度は、握力だ。酒樽を持ってみなさい。」","voiceCharacter":"萃香","duration":2.6779818594104308,"title":"シーン 871","slideTitle":"スライド #871","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.871.jpeg","voiceDuration":2.6779818594104308,"seVolume":1},{"id":"5DDE2D7A-8ECC-4612-BE85-4962BBD86ABE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_872_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕が、その酒樽を持つと、\n彼女はどこからともなく、酒樽をもう一つ取り出す。","voiceCharacter":"操夢","duration":5.569115646258504,"title":"シーン 872","slideTitle":"スライド #872","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.872.jpeg","voiceDuration":5.569115646258504,"seVolume":1},{"id":"524FF0FF-BEC8-41EA-AA73-0508FD476743","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_873_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「中の酒をこぼさぬように、酒樽を持ち替えなさい。」","voiceCharacter":"萃香","duration":2.6546485260770973,"title":"シーン 873","slideTitle":"スライド #873","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.873.jpeg","voiceDuration":2.6546485260770973,"seVolume":1},{"id":"E51223DE-F6BD-4DAB-ADA8-CE3E0E2C195F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_874_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は彼女が新しい酒樽を地面にそっと置くと、すでに持っていた樽を地面に置き、新しい方を持つ。すると、力がかかる。","voiceCharacter":"操夢","duration":8.690861678004536,"title":"シーン 874","slideTitle":"スライド #874","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.874.jpeg","voiceDuration":8.690861678004536,"seVolume":1},{"id":"4F98322E-5F28-4C38-A503-122C6457A30A","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_875_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"すると、彼女は、もう一つ酒樽を置くと、それも持つようにいう。僕は、慎重に手を動かして、その樽を持つ。","voiceCharacter":"操夢","duration":7.98,"title":"シーン 875","slideTitle":"スライド #875","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.875.jpeg","voiceDuration":7.98,"seVolume":1},{"id":"7C8E115B-FE36-4495-A332-E1F36D600CDE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_876_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"それから、僕は、握力がそこをつくまで、酒樽を何回も持たせられ、それが終わると、10分の休憩が挟まれた。","voiceCharacter":"操夢","duration":7.921292517006803,"title":"シーン 876","slideTitle":"スライド #876","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.876.jpeg","voiceDuration":7.921292517006803,"seVolume":1},{"id":"1F38546D-6D5D-4218-A202-B86015A9BCE2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_877_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"それが終わると、彼女は、今度どこからか持ってきた\nメモリがついているマットを、地面に敷く。","voiceCharacter":"操夢","duration":5.862607709750567,"title":"シーン 877","slideTitle":"スライド #877","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.877.jpeg","voiceDuration":5.862607709750567,"seVolume":1},{"id":"CDF1B71C-C13C-4260-B3AD-0902E9948855","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_878_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「今敷いたこのマットに向かって飛んでみなさい。」","voiceCharacter":"萃香","duration":2.1346485260770973,"title":"シーン 878","slideTitle":"スライド #878","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.878.jpeg","voiceDuration":2.1346485260770973,"seVolume":1},{"id":"C26CE2B2-6508-452D-BE54-3102D78A7B9C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_879_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は、そう言われると、マットに向かって飛ぶ、そして、飛び終えると同時に、文句を言われ、彼女が手本を見せる。","voiceCharacter":"操夢","duration":7.560430839002268,"title":"シーン 879","slideTitle":"スライド #879","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.879.jpeg","voiceDuration":7.560430839002268,"seVolume":1},{"id":"7E5C9877-DCDA-4D90-9AD9-C99B9AA4E0FB","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_880_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「今私が見せたように、飛んでみなさい。」","voiceCharacter":"萃香","duration":2.1179818594104307,"title":"シーン 880","slideTitle":"スライド #880","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.880.jpeg","voiceDuration":2.1179818594104307,"seVolume":1},{"id":"EF11C3FF-827F-4DDA-9F1D-6835CFB86C19","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_881_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は、彼女にそう言われ、\n彼女が本当に人なのかを疑いながら、飛ぶ。","voiceCharacter":"操夢","duration":5.073469387755102,"title":"シーン 881","slideTitle":"スライド #881","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.881.jpeg","voiceDuration":5.073469387755102,"seVolume":1},{"id":"1AF05B3F-EC09-4263-9DE1-141CE698323E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_882_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"それが終わると、彼女は、いきなり僕をマットの上に押し倒す。\nすると、彼女を僕の足元を押さえ込み、説明をする。","voiceCharacter":"操夢","duration":8.132154195011339,"title":"シーン 882","slideTitle":"スライド #882","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.882.jpeg","voiceDuration":8.132154195011339,"seVolume":1},{"id":"B0D88F8B-ED29-4DE9-A6E8-C38B4964D200","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_883_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「今から、時間を測るから、上体起こしをしなさい。」","voiceCharacter":"萃香","duration":2.817981859410431,"title":"シーン 883","slideTitle":"スライド #883","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.883.jpeg","voiceDuration":2.817981859410431,"seVolume":1},{"id":"6DB88DB5-A345-4460-8633-8DC41C57FA95","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_884_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は、すでに動けない状態でそう言われ、彼女が時間を測り始めると、残っている力を引き出しながら、言われた通りにする。","voiceCharacter":"操夢","duration":8.425646258503402,"title":"シーン 884","slideTitle":"スライド #884","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.884.jpeg","voiceDuration":8.425646258503402,"seVolume":1},{"id":"57282568-85EF-417C-AD50-D323286CFF26","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_885_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"すると、彼女は休憩だと言い、10分間の休憩が再び入る。\n彼女はその間に、マットを片す。","voiceCharacter":"操夢","duration":7.249546485260771,"title":"シーン 885","slideTitle":"スライド #885","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.885.jpeg","voiceDuration":7.249546485260771,"seVolume":1},{"id":"318E3526-CF00-41EE-BD43-FD4B1BB0A63F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_886_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「次は、反復横跳びだ、そこに立って私が時間を測り始めたら、動き出しなさい。フライングはするんじゃないぞ。」","voiceCharacter":"萃香","duration":6.146326530612245,"title":"シーン 886","slideTitle":"スライド #886","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.886.jpeg","voiceDuration":6.146326530612245,"seVolume":1},{"id":"5D4ED09F-D01A-4BDB-97B2-4A74BD1970B3","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_887_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は、すでに息切れが起きていたが、なんとか深呼吸で落ち着かせると、彼女の合図に合わせて、動き出す。","voiceCharacter":"操夢","duration":7.10390022675737,"title":"シーン 887","slideTitle":"スライド #887","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.887.jpeg","voiceDuration":7.10390022675737,"seVolume":1},{"id":"CB23EFAC-4807-40BC-8ED8-160174321E9D","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_888_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「次は、制限時間内に、グラウンドを1周しなさい。\nそれが無事に終われば、昼休憩だ。」","voiceCharacter":"萃香","duration":5.0029931972789115,"title":"シーン 888","slideTitle":"スライド #888","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.888.jpeg","voiceDuration":5.0029931972789115,"seVolume":1},{"id":"24598B04-2010-4C08-A219-76D9072C9DE8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_889_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「…は…はい…」僕はなんとかそう返し、彼女が1分のタイマーをスタートさせると、僕は全力疾走する。","voiceCharacter":"操夢","duration":7.064761904761904,"title":"シーン 889","slideTitle":"スライド #889","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.889.jpeg","voiceDuration":7.064761904761904,"seVolume":1},{"id":"1202CF1D-869A-4B5B-9689-2C0715804533","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/萃香（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_890_萃香.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"「それじゃあ、30分後にまた、ここにきなさい。\nそしたら、最後に1500m走だ。」","voiceCharacter":"萃香","duration":4.951315192743764,"title":"シーン 890","slideTitle":"スライド #890","characterName":"萃香","audioTrack":"track_voice_char_6D7E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.890.jpeg","voiceDuration":4.951315192743764,"seVolume":1},{"id":"EC05799B-6A6C-40B5-A09E-EA4230F2E3FE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_891_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"僕は、頭の中で鐘が鳴ったようなガーンという感覚を感じながら、ふと思い出す。「荷物、教室の中だ…」","voiceCharacter":"操夢","duration":7.804557823129252,"title":"シーン 891","slideTitle":"スライド #891","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.891.jpeg","voiceDuration":7.804557823129252,"seVolume":1},{"id":"117758F9-EF9E-4F35-B493-86D0B636387B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_892_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"まだ、きっと校舎は試験中だから、入れない。それと、弁当を持ってきたかも忘れた。「お昼ご飯どうしよう…」","voiceCharacter":"操夢","duration":7.75172335600907,"title":"シーン 892","slideTitle":"スライド #892","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.892.jpeg","voiceDuration":7.75172335600907,"seVolume":1},{"id":"F7D324D4-C8AC-41E4-9AD9-D235382F8B3B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_893_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ColabGPU_1791199901_67118.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","telop":"すると、誰かがこちらに駆け寄ってくる。","voiceCharacter":"操夢","duration":2.564761904761905,"title":"シーン 893","slideTitle":"スライド #893","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/ke