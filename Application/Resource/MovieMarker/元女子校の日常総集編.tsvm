1995464852608,"title":"シーン 998","slideTitle":"スライド #998","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.998.jpeg","voiceDuration":8.971995464852608,"seVolume":1},{"id":"5078E051-0235-4B37-A960-435884FAD9D1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_999_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image55.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","telop":"「顔が青ざめてるけど…大丈夫なの？」","voiceCharacter":"フランドール・スカーレット","duration":3.0144897959183674,"title":"シーン 999","slideTitle":"スライド #999","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.999.jpeg","voiceDuration":3.0144897959183674,"seVolume":1},{"id":"8A837681-B827-4170-B464-CB454C57F2A3","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1000_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image55.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","telop":"「すこしだけ、席を外しても、大丈夫ですか？」","voiceCharacter":"操夢","duration":3.4082539682539683,"title":"シーン 1000","slideTitle":"スライド #1000","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1000.jpeg","voiceDuration":3.4082539682539683,"seVolume":1},{"id":"9D80A85E-3DFE-4AAD-BF06-8AA8129C8832","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1001_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image55.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","telop":"「もし、何かあるんだったら、私にいってね。」私は、不安が残りながら、彼にそう言うと、彼は、森林の中に入っていった。","voiceCharacter":"フランドール・スカーレット","duration":10.730748299319728,"title":"シーン 1001","slideTitle":"スライド #1001","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1001.jpeg","voiceDuration":10.730748299319728,"seVolume":1},{"id":"8B5CA0C7-3BBA-4CDD-A3F5-8602580195CC","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示：1.5秒","telop":"その頃、某所では…","duration":1.5,"title":"シーン 1002: その頃、某所では…","slideTitle":"スライド #1002","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1002.jpeg","seVolume":1},{"id":"7D85DD56-84A7-491F-9801-0D1C2BCF21D5","seStartTimeOffset":0