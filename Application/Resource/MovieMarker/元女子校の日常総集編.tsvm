"audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1162.jpeg","voiceDuration":2.340861678004535,"seVolume":1},{"id":"80DC4339-0E4A-46DA-ADAD-F1279E6A7A46","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1163_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"僕はそう彼女に聞かれ、考える。すると、アリスが話し出す。","voiceCharacter":"操夢","duration":4.586507936507936,"title":"シーン 1163","slideTitle":"スライド #1163","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1163.jpeg","voiceDuration":4.586507936507936,"seVolume":1},{"id":"D8F18C65-BFE6-41B7-B669-F91C3AA44EFC","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1164_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「私は、本屋に行きたいわ…。」","voiceCharacter":"アリス・マーガトロイド","duration":1.633061224489796,"title":"シーン 1164","slideTitle":"スライド #1164","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1164.jpeg","voiceDuration":1.633061224489796,"seVolume":1},{"id":"6A7C051A-FB9B-44B4-9810-333653FCB20E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1165_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「こいし、さっきからどうしたの？」\n私は、こいしがそっぽを向いていたので、そう声をかける。","voiceCharacter":"古明地さとり","duration":4.864399092970522,"title":"シーン 1165","slideTitle":"スライド #1165","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1165.jpeg","voiceDuration":4.864399092970522,"seVolume":1},{"id":"66E88EDB-F644-45E6-8214-FAA5AEA154A1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1166_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「えっ？」私は、彼女にそう声をかけられ、驚く。","voiceCharacter":"古明地こいし","duration":5.1171201814058955,"title":"シーン 1166","slideTitle":"スライド #1166","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1166.jpeg","voiceDuration":5.1171201814058955,"seVolume":1},{"id":"0DDA6068-22C3-4F13-8586-93C3109901B2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1167_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「班長がこう言うのあれかもだけど…、本屋を見にいってても大丈夫かしら…」私は、そう彼に、尋ねる。","voiceCharacter":"アリス・マーガトロイド","duration":5.541133786848072,"title":"シーン 1167","slideTitle":"スライド #1167","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1167.jpeg","voiceDuration":5.541133786848072,"seVolume":1},{"id":"CE36C7A0-7167-44C1-8ABC-1729A65732D4","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1168_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"僕は、彼女にそう聞かれ、ふと二人の方を見る。","voiceCharacter":"操夢","duration":3.284331065759637,"title":"シーン 1168","slideTitle":"スライド #1168","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1168.jpeg","voiceDuration":3.284331065759637,"seVolume":1},{"id":"1E4E02E7-1523-4F86-BE49-59386CC57482","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1169_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"そこには、なぜか、頬照りながら困るこいしと、ため息をつくさとりの姿があった。「二人とも、どうしたんですか？」","voiceCharacter":"操夢","duration":7.789773242630385,"title":"シーン 1169","slideTitle":"スライド #1169","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1169.jpeg","voiceDuration":7.789773242630385,"seVolume":1},{"id":"00B0E9E7-E35C-4C63-963C-236935CA996C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1170_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"だが、互いに何も言わず、気まずい空気になってしまう。\n僕は仕方なく、アリスの方を向く。","voiceCharacter":"操夢","duration":6.423469387755102,"title":"シーン 1170","slideTitle":"スライド #1170","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1170.jpeg","voiceDuration":6.423469387755102,"seVolume":1},{"id":"32A02491-3EE5-438D-AF62-07DD94A765F6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1171_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「いいですよ。ただ、昼食は一緒に取りませんか？」","voiceCharacter":"操夢","duration":3.684331065759637,"title":"シーン 1171","slideTitle":"スライド #1171","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1171.jpeg","voiceDuration":3.684331065759637,"seVolume":1},{"id":"A0E9519B-919C-4B02-917D-A85F9E9839E0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1172_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「ええ、分かったわ…、それじゃあ、行ってくるわね…」\n私はそう言うと、本屋を見に行った。","voiceCharacter":"アリス・マーガトロイド","duration":4.769501133786848,"title":"シーン 1172","slideTitle":"スライド #1172","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1172.jpeg","voiceDuration":4.769501133786848,"seVolume":1},{"id":"71CB2B95-C798-46FC-A846-F10204D4E653","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1173_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「ねぇ、紅夢…。あれを見て…」\n私はそう言いながら、あるものを指差す。","voiceCharacter":"古明地こいし","duration":6.29390022675737,"title":"シーン 1173","slideTitle":"スライド #1173","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1173.jpeg","voiceDuration":6.29390022675737,"seVolume":1},{"id":"A18F352D-EC5B-47FE-ACCB-B091D3CEA07C","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1174_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","telop":"僕がそう言われ、そっちを向くと、洋服店があった。すると、とあるポスターが目に入る。僕は、そのポスターの文字を見る。","voiceCharacter":"操夢","duration":8.568027210884354,"title":"シーン 1174","slideTitle":"スライド #1174","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1174.jpeg","voiceDuration":8.568027210884354,"seVolume":1},{"id":"09868FEC-3912-467D-B0C7-B4A7C64C2AB3","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1175_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","telop":"その内容を要約すると、今現在、このお店で一定金額以上の利用をすると、金額に応じたくじ引きができるとあった。","voiceCharacter":"操夢","duration":8.181065759637189,"title":"シーン 1175","slideTitle":"スライド #1175","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1175.jpeg","voiceDuration":8.181065759637189,"seVolume":1},{"id":"8AFB8C9E-CCCE-4797-B62C-56B997B16269","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1176_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","telop":"そして、あたりの中に、旅行券が含まれていた。くじ引きは、今日までで、行き先は…僕が、見知っている場所だった。","voiceCharacter":"操夢","duration":8.446303854875284,"title":"シーン 1176","slideTitle":"スライド #1176","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1176.jpeg","voiceDuration":8.446303854875284,"seVolume":1},{"id":"F452CF73-032C-482B-AFF3-863E6AD25A56","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1177_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","telop":"そして、店内には、きっとその場所で使うことを想定されている洋服がずらりと並んでいた。そこまで見ると、視線を戻す。","voiceCharacter":"操夢","duration":8.286507936507936,"title":"シーン 1177","slideTitle":"スライド #1177","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1177.jpeg","voiceDuration":8.286507936507936,"seVolume":1},{"id":"41F24F9F-8DAB-4651-9651-A8F30E8D4169","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1178_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"「紅夢…、そのお店で洋服を見てきてもいい？」","voiceCharacter":"古明地こいし","duration":3.669591836734694,"title":"シーン 1178","slideTitle":"スライド #1178","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset"