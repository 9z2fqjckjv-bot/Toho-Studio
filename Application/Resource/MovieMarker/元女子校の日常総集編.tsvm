tory\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1010.jpeg","voiceDuration":8.58798185941043,"seVolume":1},{"id":"62C3DA00-394A-4D68-AD9D-34DC7453B763","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1011_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image55.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","telop":"「分かった…」私は通話を切ると、彼の姿を探し始めた。","voiceCharacter":"フランドール・スカーレット","duration":4.978231292517007,"title":"シーン 1011","slideTitle":"スライド #1011","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1011.jpeg","voiceDuration":4.978231292517007,"seVolume":1},{"id":"B3D0EB06-3A0C-4C28-B9CC-6DFFF1E300C3","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1012_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"「はぁ、はぁ。」僕は、荒い息をしながら、森の中を彷徨った。\nすると、先ほど蘇った過去が頭の中で勝手に流れる。","voiceCharacter":"操夢","duration":9.259342403628118,"title":"シーン 1012","slideTitle":"スライド #1012","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1012.jpeg","voiceDuration":9.259342403628118,"seVolume":1},{"id":"61D8F8D0-5453-41A3-9D6F-94636BBFB805","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1013_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"僕の意識は、あと少しで吹き飛びそうだった。","voiceCharacter":"操夢","duration":2.909342403628118,"title":"シーン 1013","slideTitle":"スライド #1013","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1013.jpeg","voiceDuration":2.909342403628118,"seVolume":1},{"id":"5A7BC55E-E2D2-4CCC-9A5D-D9603DA67BAE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1014_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"「紅夢、どこにいるの？聞こえたら返事して…」私は、暗い夜の森でそう呼びかけながら、彼の姿を探す。","voiceCharacter":"フランドール・スカーレット","duration":8.869478458049887,"title":"シーン 1014","slideTitle":"スライド #1014","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1014.jpeg","voiceDuration":8.869478458049887,"seVolume":1},{"id":"E0DA0A73-3EE1-4B98-A552-FF365A62009F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1015_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"「紅夢？どこにいるの？」私は、だんだんと早足になるのを自覚しながら、彼の姿を必死に探し出す。","voiceCharacter":"フランドール・スカーレット","duration":8.866984126984127,"title":"シーン 1015","slideTitle":"スライド #1015","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1015.jpeg","voiceDuration":8.866984126984127,"seVolume":1},{"id":"CB1A4EE9-0943-40A7-AE7C-AE25A82677C4","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1016_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"僕は、その攻撃に抵抗しながら、意識が切れないようにする。\nだが、僕ができる唯一の対抗策は、ひたすら逃げるだけだった。","voiceCharacter":"操夢","duration":8.991950113378685,"title":"シーン 1016","slideTitle":"スライド #1016","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1016.jpeg","voiceDuration":8.991950113378685,"seVolume":1},{"id":"7F987404-6C90-4BA9-A22F-EFD817B19B3A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1017_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"だが、それも長くは続かず、僕は何か躓くと、\nこけてしまい、そのまま意識が落ちていった。","voiceCharacter":"操夢","duration":6.509342403628118,"title":"シーン 1017","slideTitle":"スライド #1017","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1017.jpeg","voiceDuration":6.509342403628118,"seVolume":1},{"id":"26B973CE-95E7-4A03-81F2-B8038C3E3ED7","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1018_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"私は、彼の姿を探しながら、ポケベルの時間を確認する。時刻は、午後9時だった。彼が席を外してから数時間だった。","voiceCharacter":"フランドール・スカーレット","duration":10.819478458049886,"title":"シーン 1018","slideTitle":"スライド #1018","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1018.jpeg","voiceDuration":10.819478458049886,"seVolume":1},{"id":"1999C7AE-ECF7-4AA7-BFDA-41FECA2E19B5","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1019_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"「紅夢、どこにいるの…」私は、気がつけば、木々の合間を縫うように走りながら、彼を探していた。だが、まだ見つからない。","voiceCharacter":"フランドール・スカーレット","duration":10.181995464852609,"title":"シーン 1019","slideTitle":"スライド #1019","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1019.jpeg","voiceDuration":10.181995464852609,"seVolume":1},{"id":"0342EEB9-1872-417F-A229-FBDC7FC95BA7","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1020_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image56.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","telop":"そして、ふとポケベルの時間を確認する。あと数十分で日付が変わるところだった。だが、私は時間を気にせず、彼を探す。","voiceCharacter":"フランドール・スカーレット","duration":10.608231292517006,"title":"シーン 1020","slideTitle":"スライド #1020","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1020.jpeg","voiceDuration":10.608231292517006,"seVolume":1},{"id":"7C800023-4979-4098-9101-B28403A7C662","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.