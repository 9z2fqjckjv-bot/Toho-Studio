ame":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1826_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"そして、本の内容をもとに、自分なりにノートを書き込んでいく。そして、ふと本を読んでいて、あることに気がつく。","voiceCharacter":"操夢","duration":7.686507936507937,"title":"シーン 1826","slideTitle":"スライド #1826","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1826.jpeg","voiceDuration":7.686507936507937,"seVolume":1},{"id":"FD5ADF79-9FA5-41F8-BB1C-46168065D09A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1827_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"それは、ちょくちょく語尾に「だぜ。」という特徴的な口癖が書かれていることだった。そこで、僕はふと思い出す。","voiceCharacter":"操夢","duration":8.037596371882087,"title":"シーン 1827","slideTitle":"スライド #1827","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1827.jpeg","voiceDuration":8.037596371882087,"seVolume":1},{"id":"77996454-8CC5-4AC0-8E30-7A2AEA7F1D27","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"そして巻末までページを捲ると、なぜか、出典や著者、出版社などの情報が載ったページが誰かに破られていた。","duration":5.1000000000000005,"title":"シーン 1828","slideTitle":"スライド #1828","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1828.jpeg","seVolume":1},{"id":"A6D63B54-6660-405B-B56D-6E9EC9E1D5F4","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1829_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"そして、僕は本の表紙にある著者名を見る。\nよく見ると、それは元の名前の上に、ラベルが貼ってあった。","voiceCharacter":"操夢","duration":7.2680272108843536,"title":"シーン 1829","slideTitle":"スライド #1829","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1829.jpeg","voiceDuration":7.2680272108843536,"seVolume":1},{"id":"F003931B-8C5E-4159-B6EE-2BA3D1534863","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1830_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"僕は、そのラベルを剥がそうと、爪を立てるが、がっしりと拍子にラベルがしがみついていて、剥がすことができない。","voiceCharacter":"操夢","duration":7.2365079365079366,"title":"シーン 1830","slideTitle":"スライド #1830","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1830.jpeg","voiceDuration":7.2365079365079366,"seVolume":1},{"id":"E05F232B-479F-48C0-BE32-E30A3F2409C7","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1831_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"そして、僕は推測を立てる。おそらくこの本は、母の友人である魔理沙が書いたものだが、その証拠となるものはなかった。","voiceCharacter":"操夢","duration":8.30498866213152,"title":"シーン 1831","slideTitle":"スライド #1831","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1831.jpeg","voiceDuration":8.30498866213152,"seVolume":1},{"id":"6700D351-1008-4D17-8BF8-72D7E553EF77","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1832_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"そして、僕は直接本人に聞くのがいいと考え、\nその本を片手に部屋に戻っていった。","voiceCharacter":"操夢","duration":5.804988662131519,"title":"シーン 1832","slideTitle":"スライド #1832","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1832.jpeg","voiceDuration":5.804988662131519,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアを開ける3.mp3","id":"CF47CF89-26EF-49F9-B6E9-63906A5096CD","seStartTimeOffset":3.27,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1833_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"僕が部屋に戻ってきて、本をバックにしまって、\n出かけようとすると、部屋の扉が開き、誰かが入ってくる。","voiceCharacter":"操夢","duration":7.359342403628118,"title":"シーン 1833","slideTitle":"スライド #1833","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: ドアを開ける3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1833.jpeg","voiceDuration":7.359342403628118,"seVolume":0.85},{"id":"20B4A770-EE10-448A-B800-167139825B4F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/疑問顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1834_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"「ねぇ、これからどこにいくの、紅夢？」","voiceCharacter":"フランドール・スカーレット","duration":3.0119954648526077,"title":"シーン 1834","slideTitle":"スライド #1834","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1834.jpeg","voiceDurat