"シーン 54","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_鈴仙・優曇華院・イナバ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.054.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_153F","characterName":"鈴仙・優曇華院・イナバ","telop":"「えっと…それはどういう意味でしょう？」","id":"490A193C-B21F-4FFC-BCF1-37763F5A7E7A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"鈴仙・優曇華院・イナバ","voiceDuration":2.624875283446712},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":8.240861678004535,"slideTitle":"スライド #55","title":"シーン 55","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.055.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「まぁ、もう一度寝たら、彼の姿に戻りはしますが、それよりも、授業の方が優先ですから、教室に戻りますね。」","id":"BEA3C883-2106-4F2D-8B08-3E2B9B87340B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.240861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":3.677687074829932,"slideTitle":"スライド #56","title":"シーン 56","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_鈴仙・優曇華院・イナバ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.056.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_153F","characterName":"鈴仙・優曇華院・イナバ","telop":"「とりあえず、あなたの教室に案内しますね…」","id":"105CC1A0-CB6A-476B-B75A-FA2B55ACAE57","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"鈴仙・優曇華院・イナバ","voiceDuration":3.677687074829932},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":3.3973696145124714,"slideTitle":"スライド #57","title":"シーン 57","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.057.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"私はそう言われ、彼女と共に保健室を離れた。","id":"1BD5726C-17D6-40BE-A056-A2F90157C8E6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":3.3973696145124714},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.623469387755102,"slideTitle":"スライド #58","title":"シーン 58","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.058.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"私が、彼女の案内で教室に戻ると、クラスメイトの視線が突き刺さるように飛んでくる。「まぁ…当たり前か…」","id":"757965AD-95E7-48DC-B6B7-089BB5E1C523","seVolume":1,"voiceCharacter":"サブ","voiceDuration":7.623469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.499773242630385,"slideTitle":"スライド #59","title":"シーン 59","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.059.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「あなた…見かけない顔ね…新入生かしら…」私は科学の講義中に突如として入ってきた彼女にそう問いかける。","id":"9C94EB66-75CB-4B7A-8D4B-A3C0F170FFA5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":6.499773242630385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.68530612244898,"slideTitle":"スライド #60","title":"シーン 60","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.060.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「まぁ、そんなことどうでもいいわ。とりあえず、あなたもささっと席に着いて、私の講義を聞きなさい。」","id":"EFFDFEBA-A10E-4A70-A163-4BBB43AAB4D8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":5.68530612244898},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.266938775510204,"slideTitle":"スライド #61","title":"シーン 61","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.061.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"「わかりました。」\n私はそう返すと、窓際の真ん中にある空席に座る。","id":"7623EAA7-3754-4CA7-861D-EDF33005FA7B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":5.266938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.253356009070295,"slideTitle":"スライド #62","title":"シーン 62","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.062.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「それじゃあ、続けるわね。」\n私はそう言って、科学の講義を再開した。","id":"8B19A8AA-D08B-40D4-9D40-AEB4017751E3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":4.253356009070295},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #63","title":"シーン 63: それから時間が経ち…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.063.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それから時間が経ち…","id":"565570EC-32BB-4F2E-83D4-BFCB7C4C2C5B","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.786507936507936,"slideTitle":"スライド #64","title":"シーン 64","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.064.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"それから数十分程度でその講義は終了した。そして、周りを見ながら、彼が持ってきた弁当を取り出し、食べる。","id":"C929CF26-A67E-44F9-A2AC-339E5300150E","seVolume":1,"voiceCharacter":"サブ","voiceDuration":7.786507936507936},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.243038548752834,"slideTitle":"スライド #65","title":"シーン 65","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.065.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"だが、弁当を食べ切ると同時に、全身に衝撃が走り、そのまま教室を抜け出し、ある場所…多目的トイレを探す。","id":"2BB4047B-ECC7-4CCF-8AB4-83EA5947BF54","seVolume":1,"voiceCharacter":"サブ","voiceDuration":8.243038548752834},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","bgmStartTimeOffset":0,"duration":3.6930385487528343,"slideTitle":"スライド #66","title":"シーン 66","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791193839_80109.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.066.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"そして私は、多目的トイレに来るとその場に倒れ込んだ。","id":"E8363802-6EED-44EB-9585-D4FBD1183809","seVolume":1,"voiceCharacter":"サブ","voiceDuration":3.6930385487528343},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","bgmStartTimeOffset":0,"duration":8.699546485260772,"slideTitle":"スライド #67","title":"シーン 67","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791193839_80109.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.067.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ん…、ここは…トイレ…」僕はそう呟き、ハッと思い出す。\n「確か、10分の自己紹介で人生を話したら、気絶して…」","id":"406C88FF-3EDF-4F69-AA14-86EAC97737F6","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.699546485260772},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791193839_80109.png","bgmStartTimeOffset":0,"duration":6.53,"slideTitle":"スライド #68","title":"シーン 68","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791193839_80109.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.068.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「とりあえず…教室に戻るか…」\n僕はそう一人呟くと、念入りに手を洗ってから、トイレを出た。","id":"63D3200D-EAD6-4785-A91F-FB815C1C8060","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.53},{"voice2StartTimeOffset":1.8560770975056688,"telop":"僕が教室に戻ってくると、\nさとりと呼ばれていた少女が僕に、駆け寄ってくる。","seVolume":1,"characterName":"操夢","voiceDuration":1.8560770975056688,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","animationName":"なし","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"slideTitle":"スライド #69","bgmVolume":0.65,"duration":5.036077097505669,"backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.069.jpeg","id":"956E87B6-7EF0-41C4-9DC8-CF91D8B219B1","voice2Character":"操夢","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢_2.wav","bgmStartTimeOffset":0,"voice2Duration":3.18,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","transitionName":"なし","title":"シーン 69"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":1.5713832199546485,"slideTitle":"スライド #70","title":"シーン 70","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.070.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あれ…どこから来たんですか？」","id":"64023350-FAB3-41B6-A95F-DDDC33A9475F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":1.5713832199546485},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.814761904761904,"slideTitle":"スライド #71","title":"シーン 71","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.071.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…」僕はそこで困惑してしまう…。\n「今はちょっと、自分の席で休みたいので….」","id":"72CA7C31-9285-4E6F-89CB-F32E7C07D348","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.814761904761904},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":3.1070975056689343,"slideTitle":"スライド #72","title":"シーン 72","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.072.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そうですか…、でもきっと、学園中で噂になりますよ…」","id":"B84720C5-62AD-4BBE-99C6-F41D21EAF36F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.1070975056689343},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":6.512585034013606,"slideTitle":"スライド #73","title":"シーン 73","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.073.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そういえば、次は被服室での授業ですが、一人で大丈夫ですか？あと、数十分もせずに休み時間は終わりますが…」","id":"D5F6342D-D5BE-4B5D-86A6-5F86FDE07F66","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.512585034013606},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.721292517006803,"slideTitle":"スライド #74","title":"シーン 74","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.074.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…ちょっと待っててください。」\n僕はそういうと、ささっと自席を片付ける。","id":"0F4388F6-14A6-4B28-935B-6B0C556BE61E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.721292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":2.5604308390022674,"slideTitle":"スライド #75","title":"シーン 75","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.075.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、被服室はどこにありますか？」","id":"9356D2ED-BAE6-43C0-B60F-9887B74F1518","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.5604308390022674},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":2.4259863945578233,"slideTitle":"スライド #76","title":"シーン 76","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.076.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「私が案内しますから、着いてきてください。」","id":"DC7C0572-0F76-4175-9A02-B23455969056","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.4259863945578233},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.0713832199546487,"slideTitle":"スライド #77","title":"シーン 77","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.077.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"僕が彼女と共に被服室にくると、誰かがこちらにくる。","id":"80656C6D-36AB-4ED3-B479-25F5E8DC2217","seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.0713832199546487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.203378684807256,"slideTitle":"スライド #78","title":"シーン 78","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.078.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「あら、もしかして、このクラスに転入した男子ですか？」","id":"85DA3530-A8FD-4E3E-90CD-BBD5BB62224D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":3.203378684807256},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":2.6386848072562357,"slideTitle":"スライド #79","title":"シーン 79","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.079.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、そうですが、なぜそんなことを…」","id":"15BD1CF0-2682-4F7A-BC85-D83B3AFB30D8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.6386848072562357},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":6.481882086167801,"slideTitle":"スライド #80","title":"シーン 80","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.080.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「朝、早苗さんが見たときは、確かに男子だったはずなのに、パチュリーさんの授業に来た時には女子だった…と。」","id":"71D9034C-AB79-4054-B492-BD35406A9CB8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":6.481882086167801},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":7.121791383219954,"slideTitle":"スライド #81","title":"シーン 81","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.081.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「教員の間で、話題になってますよ。まぁ、元女子校の学園に男子生徒が来ただけでも、話題性は絶えないですが…」","id":"8C546A79-9B81-47FA-8F94-4F3B17DFDC1D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":7.121791383219954},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":6.107392290249433,"slideTitle":"スライド #82","title":"シーン 82","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.082.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「とりあえず、これから家庭の授業をするので、あなたは…窓辺に座っているさとりの隣にでも座ってください。」","id":"F708C131-C302-4C02-992E-B6149F48185F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":6.107392290249433},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":6.549183673469388,"slideTitle":"スライド #83","title":"シーン 83","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.083.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「今日は、咲夜師匠の２連無休授業ですから、あなたには…酷かもしれませんが、2時間を休憩なしで耐えるしかないですね。」","id":"A96066C3-6773-4A26-8A2F-A62A92F4A60F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.549183673469388},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791195025_33546.png","bgmStartTimeOffset":0,"duration":3.1984580498866215,"slideTitle":"スライド #84","title":"シーン 84","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791195025_33546.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.084.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女がそういい、数分程度で授業が始まった。","id":"9A691BD6-6C61-495D-9F2F-86208D20AEED","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.1984580498866215},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #85","title":"シーン 85: 2時間休憩なし授業が終わると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.085.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"2時間休憩なし授業が終わると…","id":"00725DE2-F16C-46BE-9208-71930EC5DC6F","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":9.5756462585034,"slideTitle":"スライド #86","title":"シーン 86","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.086.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それから、2時間の間、休憩なしで、講義を受け続けると、教室に戻り、終礼が始まるまで席に座って待ち続ける。","id":"46DB148A-B0B4-47C1-B952-6EF900E82826","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.5756462585034},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.408253968253968,"slideTitle":"スライド #87","title":"シーン 87","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.087.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、教室の扉が開き、朝礼の時に来た女性が入る。","id":"1B5519D9-B752-4890-A1D8-61149751C52D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.408253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":1.8664625850340135,"slideTitle":"スライド #88","title":"シーン 88","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.088.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「皆さん、お疲れ様です。」","id":"1E703EAD-08DE-4E81-A641-52AA8EE2C949","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":1.8664625850340135},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":8.025646258503402,"slideTitle":"スライド #89","title":"シーン 89","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.089.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女がそういうと、クラスメイトの女子たちは「お疲れ様です。」と一斉に返し、僕が急いで立ち、一緒に礼をする。","id":"6F1FFB31-8FEC-4BEF-8D1E-021BB5E8CFB0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.025646258503402},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":2.77702947845805,"slideTitle":"スライド #90","title":"シーン 90","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.090.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「何か、伝えたいことがある生徒はいますか。」","id":"FDF295D4-D7EA-4A64-AF7C-3DDEBBE21533","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":2.77702947845805},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\