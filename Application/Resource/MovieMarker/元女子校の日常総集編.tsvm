eratedAudio\/Slide_1655_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1655.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、遠くで遊んでいるこいしの水着が舞い上がる。\nそれと同時に、中に隠れている何かが見えた。","id":"EC3428B8-2DA2-44A7-9A94-0387C6D75BB2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.810430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":3.9458503401360545,"slideTitle":"スライド #1656","title":"シーン 1656","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1656_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1656.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ、今私の水着の中、見たでしょ？」","id":"E6470534-4E18-4479-8133-A1B8928D8EA3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.9458503401360545},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":5.488684807256236,"slideTitle":"スライド #1657","title":"シーン 1657","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1657_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1657.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ…、確かに見えましたけど…」\n僕がそう言うと、彼女は強烈なビンタをしてくる。","id":"D2A239E7-7B7D-4D63-976C-D54C658A11DE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.488684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":3.871269841269841,"slideTitle":"スライド #1658","title":"シーン 1658","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1658_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1658.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「あなたね…、デリカシーっていうものはないのかしら？」","id":"A410B1BC-5A57-47DD-9EE7-EEACEB77C776","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.871269841269841},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":4.056077097505669,"slideTitle":"スライド #1659","title":"シーン 1659","animationName":"なし","voiceAudioPath":"\/Us