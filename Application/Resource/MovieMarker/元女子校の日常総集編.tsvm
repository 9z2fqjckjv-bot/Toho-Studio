困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1265_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","telop":"「それで、それは誰が今持ってるの？」","voiceCharacter":"パチュリー・ノーレッジ","duration":1.9939002267573696,"title":"シーン 1265","slideTitle":"スライド #1265","characterName":"パチュリー・ノーレッジ","audioTrack":"track_voice_char_1B13","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1265.jpeg","voiceDuration":1.9939002267573696,"seVolume":1},{"id":"E43C5444-5AF3-4FD7-86FE-7187B861092F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1266_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","telop":"「僕のバックの中に入ってますよ。それに、その封筒の差出人は、学園長の名義で、ちょうど都合もいいので…」","voiceCharacter":"操夢","duration":8.110430839002268,"title":"シーン 1266","slideTitle":"スライド #1266","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1266.jpeg","voiceDuration":8.110430839002268,"seVolume":1},{"id":"EFF9B9FF-BD7F-4A21-BF12-018F91DD2ABF","seStartTimeOffset":0,"animationName":"なし","c