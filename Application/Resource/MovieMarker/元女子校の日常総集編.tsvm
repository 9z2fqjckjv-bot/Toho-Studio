onName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1190.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"昨日、学校から家に帰ってくると、僕は、入浴を済ませ、図書館で読書をしていた。すると、レミリアが封筒を手渡す。","id":"809E48B5-82CD-4BDE-AE85-FD427C766756","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.821292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.090861678004535,"slideTitle":"スライド #1191","title":"シーン 1191","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1191_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1191.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それを受け取ると宛名に僕の名前があり、差出人は学園長と記載されていた。そして、中を早速開ける。","id":"142768DA-3DD6-4328-A607-4460DDDA16DB","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.090861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.545850340136054,"slideTitle":"スライド #1192","title":"シーン 1192","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1192_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1192.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、そこには、遠足ノートに記載されていた遠足の後に受ける試験の内容が記載された紙と、デビットカードが入っていた。","id":"79E1A9CD-667B-42E9-988A-DC6742A8AF40","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.545850340136054},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":7.915850340136054,"slideTitle":"スライド #1193","title":"シーン 1193","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1193_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1193.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、試験の内容をよく見ると、そこには、いくつかの試験が記載されていた、その一つに、外泊試験があった。","id":"AA4DDC4B-AAD6-4EF2-A255-50175772AC0C","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.915850340136054},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.396303854875283,"slideTitle":"スライド #1194","title":"シーン 1194","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1194_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1194.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"内容は、学校側で決めたメンバーで数日間の間、家以外の場所で1日を過ごし、与えられた課題をこなすと言うものだった。","id":"6C34ACBB-29FC-4C9E-810B-00FC3D370FB4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.396303854875283},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":7.7995464852607705,"slideTitle":"スライド #1195","title":"シーン 1195","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1195_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1195.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、前の学校であった泊まりを含む行事の参加を、全て見送っていた。それを踏まえての試験だと記載されていた…。","id":"6FD5D1C9-44AA-4015-99F2-F8D06A64EBC6","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.7995464852607705},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":7.436507936507937,"slideTitle":"スライド #1196","title":"シーン 1196","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1196_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1196.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「僕は、少しだけ安心しましたよ。こいしさんが、あのポスターを見たおかげで、既知の人と行動できるから…。」","id":"7A64DFB3-FC4C-4C4D-9A9D-8E7AEA6BFCB1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.436507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":0.7127891156462585,"slideTitle":"スライド #1197","title":"シーン 1197","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1197_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1197.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そうですか…」","id":"8B2E0368-628D-42BE-B9B5-95442B7B0C8E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":0.7127891156462585},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":8.15172335600907,"slideTitle":"スライド #1198","title":"シーン 1198","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1198_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1198.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「とりあえず、ATMでお金を引き出してくるので、少しだけ待っていてください。その間に、買い物をしてもらっていいので…」","id":"EF01F847-B465-4CCE-9438-AE7F43A88165","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.15172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":4.115691609977325,"slideTitle":"スライド #1199","title":"シーン 1199","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1199_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1199.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「分かりました…」\n私はそう言うと、不安が残りながら、洋服を見るのだった。","id":"25BE6C4F-8CBA-4DD0-BC9A-486ADE12718E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":4.115691609977325},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc270066_ATMコーナー（日中）.jpg","bgmStartTimeOffset":0,"duration":8.456077097505668,"slideTitle":"スライド #1200","title":"シーン 1200","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1200_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc270066_ATMコーナー（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1200.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、一人でATMにやってくると、封筒にあったデビットカードを機械に差し込む。すると、機械がカードの情報を読み込む。","id":"96B89CD5-8A6F-4B5E-992A-A18D0D57DD18","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.456077097505668},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc270066_ATMコーナー（日中）.jpg","bgmStartTimeOffset":0,"duration":8.506077097505669,"slideTitle":"スライド #1201","title":"シーン 1201","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1201_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc270066_ATMコーナー（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1201.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、封筒にあったメモ書きも出し、認証が済むと、東京の物価と服の値段を考えながら、おおよその金額を引き出した。","id":"58B09704-E85B-450D-8882-C8248397AD0F","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.506077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":8.70498866213152,"slideTitle":"スライド #1202","title":"シーン 1202","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1202_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1202.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、ATMから戻って、洋服店に戻ると、こいしがある列の洋服を真剣そうな表情で眺めていた。「どうしたんですか？」","id":"D55CD7B7-85A8-491F-AD0D-7DE64949E5EF","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.70498866213152},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":2.6143537414965987,"slideTitle":"スライド #1203","title":"シーン 1203","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1203_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1203.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/真剣な顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ、これどっちがいいと思う？」","id":"BCF1D6C2-1F08-4DC5-8C31-55FC4CA3DCD3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.6143537414965987},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":3.72891156462585,"slideTitle":"スライド #1204","title":"シーン 1204","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1204_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1204.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/真剣な顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…」僕は、いきなりそう言われ、戸惑ってしまう。","id":"789AF56B-BED0-4DA5-AFD4-79F383E9AF15","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.72891156462585},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":7.016938775510204,"slideTitle":"スライド #1205","title":"シーン 1205","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1205_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1205.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/真剣な顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、あることを思い出し、彼女の質問に答えを出す。\n「長く使えて、飽きない服を選ぶといいですよ。」","id":"5E8D237E-439E-400E-AD25-2DC2694F1E85","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.016938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":10.223469387755102,"slideTitle":"スライド #1206","title":"シーン 1206","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1206_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1206.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…」私は、期待していた返答が得られずにため息が出る。\nそれから、私は一人で、買う服を決めるのだった。","id":"977D734A-D710-4F22-9952-79A0D2B85496","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.223469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":8.140861678004535,"slideTitle":"スライド #1207","title":"シーン 1207","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1207_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1207.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから僕たちは、こいしが歩くのに少し疲れていたので、休憩スペースで休みをとっていた。すると、アリスがやってくる。","id":"8D2E700F-D01D-4D0E-882B-7B6C9C193263","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.140861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":5.362879818594104,"slideTitle":"スライド #1208","title":"シーン 1208","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1208_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1208.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「こんなところで、どうしたんですか…」\n私は、本を買い終えて、戻ってくると休んでいた3人に聞く。","id":"43E650B5-1616-415A-B511-AD163245A261","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.362879818594104},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":7.758253968253968,"slideTitle":"スライド #1209","title":"シーン 1209","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1209_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1209.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「少しだけ歩き疲れたので、休憩してたんです。あと…」\n僕はそう言い、見事にくじ引きで当たった旅行券を出す。","id":"458F3A11-F6CF-437F-BD9F-5E45F62E1E4F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.758253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":1.2436507936507937,"slideTitle":"スライド #1210","title":"シーン 1210","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1210_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1210.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「これは…何ですか？」","id":"A1C46610-F222-47BD-B5A6-31B7654B09D6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.2436507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":6.83,"slideTitle":"スライド #1211","title":"シーン 1211","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1211_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1211.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「アリスさんがいなくなった後、僕たちは洋服を買っていて、そのお店のくじ引きの景品でもらったんですよ。」","id":"C318CCDE-DE60-47F5-B566-49A065FC5613","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.83},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":7.9452154195011335,"slideTitle":"スライド #1212","title":"シーン 1212","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1212_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1212.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「チケットは4人分ありますが、どうします、アリスさんは行きますか？もし、行かないなら、誰かを別に誘いますけど…」","id":"6230BE84-B9F0-4B13-B300-D70D2319698C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.9452154195011335},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":6.663356009070295,"slideTitle":"スライド #1213","title":"シーン 1213","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1213_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1213.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"私は、彼が出した旅行券をよく見る。行き先は琉球郡沖縄本島とあり、そこで出発日が明日であることに気がつく。","id":"491A66E8-F04E-48C0-BCD7-147187CBE1DB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.663356009070295},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":6.4959410430839,"slideTitle":"スライド #1214","title":"シーン 1214","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1214_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1214.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「まさか、今日中に準備して、明日の朝イチに空港集合なんて、言いませんよね…、今日は、出発日前日ですけど…。」","id":"73E06283-276B-4A3D-8A09-1C1133042002","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.4959410430839},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":7.871292517006803,"slideTitle":"スライド #1215","title":"シーン 1215","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1215_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1215.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「飛行機の時間が朝6時台であることを考えると、今日は家に帰らずに、空港の近くで泊まったほうがいいと思いますよ…」","id":"7BC75696-EFFD-47FD-A3D6-6841E813BCFA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.871292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":1.7392290249433107,"slideTitle":"スライド #1216","title":"シーン 1216","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1216_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1216.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「家には帰れないって言うことですか？」","id":"5901803F-3EC7-4706-9EF7-12A0716964AA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.7392290249433107},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":3.5017233560090704,"slideTitle":"スライド #1217","title":"シーン 1217","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1217_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1217.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、そうなりますね…。それで、どうしますか？」","id":"14236534-FA1D-490C-856D-B3C13116B601","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.5017233560090704},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":6.710090702947846,"slideTitle":"スライド #1218","title":"シーン 1218","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1218_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1218.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"私は、彼の急な誘いに、どう返すべきか迷う。\nそして、私が無言で、考えていると、彼がある発言をする。","id":"96B06D66-CB31-40C7-99BE-5FA578391BF5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.710090702947846},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":2.290861678004535,"slideTitle":"スライド #1219","title":"シーン 1219","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1219_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1219.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「アリスさんは…、お酒は飲めますか…？」","id":"8FF8F51A-1A90-408F-B3D0-679DBE51EE00","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.290861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":3.5300907029478457,"slideTitle":"スライド #1220","title":"シーン 1220","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1220_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1220.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「えっ？」私は、その発言に思わず、そう返してしまう。","id":"C3B4D2FA-186D-49CA-B5B7-EE55490A9C2C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":3.5300907029478457},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":2.3213378684807258,"slideTitle":"スライド #1221","title":"シーン 1221","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1221_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1221.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの…、どう言う意図ですか…、その発言は…？」","id":"16762C26-2FEA-454A-BB44-5F342409D8D3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.3213378684807258},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":6.271519274376417,"slideTitle":"スライド #1222","title":"シーン 1222","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1222_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1222.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「一緒に来てくれれば…琉球郡のご当地のお酒から、好きなのを言って貰えば、僕が買うので、好きなだけ飲めますよ…」","id":"2A4295B1-8EC8-4EE7-84AD-2574444F9B8F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.271519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":3.0759410430839003,"slideTitle":"スライド #1223","title":"シーン 1223","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1223_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1223.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「えっ…」私は、彼が出した予想外の提案に驚く。","id":"AAC24948-69B5-462F-9A71-9FCFE19BC6CB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":3.0759410430839003},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":5.192108843537415,"slideTitle":"スライド #1224","title":"シーン 1224","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1224_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1224.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの…、いいんですか…、私だけ好きなお酒を飲んでも…、あなたたちはお酒がまだ飲めない年齢だけど…？」","id":"2718A9D3-8F5E-4782-9FBE-7E49339A32C7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.192108843537415},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image58.jpeg","bgmStartTimeOffset":0,"duration":6.085170068027211,"slideTitle":"スライド #1225","title":"シーン 1225","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1225_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image58.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1225.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「ええもちろん…、それに高校生と中学生だけだと、何かと不自由なので…、ひとりばかし大人がいたほうがいいですよ…」","id":"3C6ACD2D-CD87-4C23-8420-37D804C64553","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.085170068027211},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/r