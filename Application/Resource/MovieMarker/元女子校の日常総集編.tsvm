Slide_1273_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「学園長…、その手元の書類の控えとデビットカードを送ったのは、あなたって本当なのですか？総理大臣からの認可は？」","voiceCharacter":"美鈴","duration":5.585238095238095,"title":"シーン 1273","slideTitle":"スライド #1273","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1273.jpeg","voiceDuration":5.585238095238095,"seVolume":1},{"id":"CC64213F-A5CC-41A5-8698-BE6CEC96DA29","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ光なし目慌てる.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1274_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「えっと、それはだな…」私は、彼女の指摘に言葉が詰まる。","voiceCharacter":"隠岐奈","duration":4.460204081632653,"title":"シーン 1274","slideTitle":"スライド #1274","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1274.jpeg","voiceDuration":4.460204081632653,"seVolume":1},{"id":"09A4BEAF-D892-4058-B740-27318E658F2C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1275_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「まさか…、認可も取らずに、独断で実行されたんですか…？」","voiceCharacter":"美鈴","duration":2.729342403628118,"title":"シーン 1275","slideTitle":"スライド #1275","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1275.jpeg","voiceDuration":2.729342403628118,"seVolume":1},{"id":"051ABE13-2CBA-4F70-9757-D92EB5CB4D1B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ光なし目慌てる.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1276_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「うぐっ。」私は、彼女の言う通りで何も言えなくなる。","voiceCharacter":"隠岐奈","duration":4.095918367346939,"title":"シーン 1276","slideTitle":"スライド #1276","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1276.jpeg","voiceDuration":4.095918367346939,"seVolume":1},{"id":"F181E8F4-FC45-4B56-B67F-B165E3D6DB73","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/目閉じ困る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1277_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「万が一の時には学園長の責任ですからね…、まったく…。ここ最近の学園長は彼に、固執しすぎじゃないですか…？」","voiceCharacter":"美鈴","duration":5.458934240362812,"title":"シーン 1277","slideTitle":"スライド #1277","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1277.jpeg","voiceDuration":5.458934240362812,"seVolume":1},{"id":"5AE2371F-4790-4CBB-B10E-4644FD3D70B7","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ弱る.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1278_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「確かに、お前の言うとおりかも知れないな…。」","voiceCharacter":"隠岐奈","duration":2.8093650793650795,"title":"シーン 1278","slideTitle":"スライド #1278","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1278.jpeg","voiceDuration":2.8093650793650795,"seVolume":1},{"id":"2A00CFC4-7603-4076-8C95-55FAF2F2FDC1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ決心.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1279_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「だが、彼に固執するのには、理由があるんだよ、美鈴。」","voiceCharacter":"隠岐奈","duration":4.128639455782313,"title":"シーン 1279","slideTitle":"スライド #1279","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1279.jpeg","voiceDuration":4.128639455782313,"seVolume":1},{"id":"32CB6844-B8F6-424A-A960-AFC666E7B8F6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1280_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「いったい、どんな理由ですか？」","voiceCharacter":"美鈴","duration":1.3261224489795918,"title":"シーン 1280","slideTitle":"スライド #1280","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1280.jpeg","voiceDuration":1.3261224489795918,"seVolume":1},{"id":"E0B21DB9-9C27-4182-82BD-9D6E588C8282","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ微笑.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1281_隠岐奈.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「その理由は、今度教えるから。この話は、ここでやめだ。」","voiceCharacter":"隠岐奈","duration":4.518208616780045,"title":"シーン 1281","slideTitle":"スライド #1281","characterName":"隠岐奈","audioTrack":"track_voice_char_85A1","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1281.jpeg","voiceDuration":4.518208616780045,"seVolume":1},{"id":"0D767309-1D4D-42AA-84E7-9179010FE0BA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1282_美鈴.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","telop":"「そうですか…、それでは失礼します…。」\n私はそう言うと、部屋を出て行った。","voiceCharacter":"美鈴","duration":3.4027210884353742,"title":"シーン 1282","slideTitle":"スライド #1282","characterName":"美鈴","audioTrack":"track_voice_char_21A0","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校