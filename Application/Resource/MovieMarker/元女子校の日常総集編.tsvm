olume":1},{"id":"63132CE6-8381-401D-A7E6-9FD687CCFA77","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_769_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"「ここが、図書館。取り出した本は、元の位置に戻してよ。」\n私は、そう言うと、私と彼の部屋に戻っていった。","voiceCharacter":"フランドール・スカーレット","duration":9.850748299319728,"title":"シーン 769","slideTitle":"スライド #769","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.769.jpeg","voiceDuration":9.850748299319728,"seVolume":1},{"id":"8A1CA783-84DB-4F73-B3A9-942007F43928","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_770_サブ.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"「さてと…」私はそう言いながら、一息つくと、適当な本棚を眺めながら、図書館を歩き回るのだった。","voiceCharacter":"サブ","duration":7.3375963718820865,"title":"シーン 770","slideTitle":"スライド #770","characterName":"サブ","audioTrack":"track_voice_char_CC3E","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.770.jpeg","voiceDuration":7.3375963718820865,"seVolume":1},{"id":"D1BF95B8-A7E1-43B9-93DF-6337539B638D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"その頃、彼が元いた家では…","duration":1.5,"title":"シーン 771: その頃、彼が元いた家では…","slideTitle":"スライド #771","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.771.jpeg","seVolume":1},{"id":"91973BFC-1C96-4C7B-9425-8F4052FD1054","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_772_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","telop":"私は、家に帰ってくるとため息をつく。例の騒動を鎮静化させる代わりに、魔理沙の面倒を私と彼で見ることになったからだ。","voiceCharacter":"博麗霊夢","duration":10.071995464852607,"title":"シーン 772","slideTitle":"スライド #772","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.772.jpeg","voiceDuration":10.071995464852607,"seVolume":1},{"id":"33530D8F-BF2C-4F82-B222-462441BEF800","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_773_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","telop":"「私の母校は昔から何も変わってないわね…」\n私がそう呟いていると、インターホンが鳴る。","voiceCharacter":"博麗霊夢","duration":7.081995464852608,"title":"シーン 773","slideTitle":"スライド #773","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.773.jpeg","voiceDuration":7.081995464852608,"seVolume":1},{"id":"C215AFE3-3262-4AB4-8088-A807AD37894B","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_774_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc235081_家（夜・灯りあり）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","telop":"私が外に出ると、書留郵便物の受け渡しだった。しかも、発送日時が数時間前になっていて、即日夜間速達の印があった。","voiceCharacter":"博麗霊夢","duration":11.339478458049886,"title":"シーン 774","slideTitle":"スライド #774","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.774.jpeg","voiceDuration":11.339478458049886,"seVolume":1},{"id":"0DE5A4D4-B1B2-47A5-98B7-472AB8BCD91F","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_775_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc235081_家（夜・灯りあり）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","telop":"即日夜間速達は、高い料金と引き換えに、夕方から夜にかけて出せば、日付が変わる前に届くと言うものだ。","voiceCharacter":"博麗霊夢","duration":9.014489795918367,"title":"シーン 775","slideTitle":"スライド #775","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.775.jpeg","voiceDuration":9.014489795918367,"seVolume":1},{"id":"B2997AB2-345A-4E3B-8F23-27C8E7A57ED7","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_776_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc235081_家（夜・灯りあり）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","telop":"私は、ふとその封筒の宛名を見る。そこには、私と夫の名前があり、差出人には…ある建設会社の代表の名前があった。","voiceCharacter":"博麗霊夢","duration":10.690748299319727,"title":"シーン 776","slideTitle":"スライド #776","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.776.jpeg","voiceDuration":10.690748299319727,"seVolume":1},{"id":"51AF3478-D77F-4BCB-B251-1E584CEA3068","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_777_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc235081_家（夜・灯りあり）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","telop":"私はふと、昨晩のことを思い出す。","voiceCharacter":"博麗霊夢","duration":2.926984126984127,"title":"シーン 777","slideTitle":"スライド #777","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.777.jpeg","voiceDuration":2.926984126984127,"seVolume":1},{"id":"AE32FC5E-FD46-4804-AF0B-0B528A9CA5B9","seStartTimeOffset":0,"animationName":"なし","char