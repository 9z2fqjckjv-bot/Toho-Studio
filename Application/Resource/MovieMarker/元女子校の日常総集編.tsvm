Offset":0,"bgmStartTimeOffset":0,"backgroundName":"image77.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","telop":"「レミリアさん…、僕からのお願いを聞いてくれませんか…。」\n僕はそう言い始め、今までの出来事をそのまま伝えていった。","voiceCharacter":"操夢","duration":7.6289115646258505,"title":"シーン 1717","slideTitle":"スライド #1717","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1717.jpeg","voiceDuration":7.6289115646258505,"seVolume":1},{"id":"FE5725A9-336E-4695-A388-7541942C8BB1","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/目閉じ困る.png","transitionName":"なし","bgmName":"BGM: nc433019_【東方アレンジ】上海紅茶館【東方動画BGM支援】","animationDuration":5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"5秒","telop":"紅美鈴（学園の体育科担当教員）","duration":5,"title":"シーン 1718: 紅美鈴（学園の体育科担当教員）","slideTitle":"スライド #1718","characterName":"操夢","bgmVolume":0.30627307976366325,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc433019_【東方アレンジ】上海紅茶館【東方動画BGM支援】.wav","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1718.jpeg","seVolume":1},{"id":"1C92E153-F393-4DC8-BFC3-8E218A96940D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1719_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image78.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","telop":"「んっ…」僕は、あれからふと気がつくと、窓から朝日が差し込んでいた。レミリアとの電話の後、僕はそのまま眠った。","voiceCharacter":"操夢","duration":8.207165532879818,"title":"シーン 1719","slideTitle":"スライド #1719","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1719.jpeg","voiceDuration":8.207165532879818,"seVolume":1},{"id":"00911EE8-F8F0-4952-AC16-322A69DB7C9F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1720_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image78.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","telop":"そして周りを見ると、こいしとアリスも目が覚めたみたいだった。そして、さとりは部屋にはいなかった。","voiceCharacter":"操夢","duration":6.35172335600907,"title":"シーン 1720","slideTitle":"スライド #1720","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1720.jpeg","voiceDuration":6.35172335600907,"seVolume":1},{"id":"5B572065-D4D6-4030-AB41-0E8052BE0EA8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1721_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image78.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","telop":"「お姉ちゃんはどこにいるの…」","voi