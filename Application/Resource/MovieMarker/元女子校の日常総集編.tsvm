ry\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1643_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1643.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.tiff","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いや、僕は泳げないので…」","id":"B39BF882-FC98-469F-BBE6-EFE014FBAF14","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.93},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":0.6806575963718821,"slideTitle":"スライド #1644","title":"シーン 1644","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1644_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1644.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…」","id":"99EC33CD-8B43-4AAA-BC50-076FA3FD7F3F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.6806575963718821},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":3.269047619047619,"slideTitle":"スライド #1645","title":"シーン 1645","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1645_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1645.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.tiff","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それじゃあ、私は海で泳いでくるね！」","id":"06FF6E95-ECA9-4578-8A76-DA52F0D1CE44","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.269047619047619},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":7.213673469387755,"slideTitle":"スライド #1646","title":"シーン 1646","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1646_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1646.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言うと、海の方へと駆け出していった。\n僕は、ふと砂浜に座り込むと、アリスが声をかける。","id":"88BBE138-368D-4109-BCF2-883C8A9E47BF","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.213673469387755},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":2.9378684807256237,"slideTitle":"スライド #1647","title":"シーン 1647","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1647_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1647.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの、いいんですか？こいしさんだけはしゃいでしまって。」","id":"317E97D3-17FF-4770-9599-BB5843522103","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.9378684807256237},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":5.562607709750567,"slideTitle":"スライド #1648","title":"シーン 1648","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1648_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1648.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「別にいいですよ。僕は、\nその姿を遠くから見るだけで十分満足ですから…。」","id":"6D1C4829-059C-40E6-A174-BB028AB8DA84","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.562607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":5.275850340136055,"slideTitle":"スライド #1649","title":"シーン 1649","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1649_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1649.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あなた、それ本音なのですか？」\n私は、彼の発言に思わず驚き、そう尋ねてしまう。","id":"68DAFCB0-AB82-40EF-94BA-CE1AA7657C65","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.275850340136055},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":2.53,"slideTitle":"スライド #1650","title":"シーン 1650","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1650_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1650.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、そうですけど…、それが何か？」","id":"7516783F-C636-4F18-9A99-184D379F9447","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.53},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":3.973469387755102,"slideTitle":"スライド #1651","title":"シーン 1651","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1651_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1651.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「私は知りませんからね…、そんな考えで彼女に接しても…」","id":"9BB6F92C-9177-41D3-AB30-612D0B801693","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.973469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":7.561519274376417,"slideTitle":"スライド #1652","title":"シーン 1652","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1652_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1652.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が何を言いたいのかが、分からなかった。\nだが、海ではしゃぐこいしの姿を見て、ほのぼのとした。","id":"68291A5B-6849-4FBD-A1C6-19706674EE92","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.561519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":2.3495918367346937,"slideTitle":"スライド #1653","title":"シーン 1653","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/Genera