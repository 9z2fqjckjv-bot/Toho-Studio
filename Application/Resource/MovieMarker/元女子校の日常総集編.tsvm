repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1149.jpeg","voiceDuration":8.909342403628118,"seVolume":1},{"id":"A05744E9-96E1-41AD-9A35-54F4AA6D32D5","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1150_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、そのメモ書きを適当にバックに入れると、弁当を包みにくるみ、そのままバックにそっと入れる。","voiceCharacter":"操夢","duration":6.506077097505669,"title":"シーン 1150","slideTitle":"スライド #1150","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1150.jpeg","voiceDuration":6.506077097505669,"seVolume":1},{"id":"B6A9A0CD-525E-45C0-AFEB-278DC455508D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1151_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"それからしばらくすると、チャイムが鳴り、担任が入ってくる。\nそれからいつも通りの、日常がやってきた。","voiceCharacter":"操夢","duration":7.097369614512472,"title":"シーン 1151","slideTitle":"スライド #1151","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1151.jpeg","voiceDuration":7.097369614512472,"seVolume":1},{"id":"0C9AD2F1-DD1B-453D-9114-695AF1824108","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間：1.5秒","telop":"それから、数日の時間が流れ…","duration":1.5,"title":"シーン 1152: それから、数日の時間が流れ…","slideTitle":"スライド #1152","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1152.jpeg","seVolume":1},{"id":"5A62F061-68C6-44D5-9DBD-6E26AE5771D5","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1153_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"それから、数日が経ち、僕たちは、遠足当日を迎えた。\nそして、駅を出ると、さとりとこいしの二人が話しかけてくる。","voiceCharacter":"操夢","duration":8.816938775510204,"title":"シーン 1153","slideTitle":"スライド #1153","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1153.jpeg","voiceDuration":8.816938775510204,"seVolume":1},{"id":"86D21A53-9A26-4C5C-97DC-2A523D8C1EFA","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1154_古明地さとり.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"「思っていたよりも、人がいますね…」","voiceCharacter":"古明地さとり","duration":1.915986394557823,"title":"シーン 1154","slideTitle":"スライド #1154","characterName":"古明地さとり","audioTrack":"track_voice_char_C52B","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1154.jpeg","voiceDuration":1.915986394557823,"seVolume":1},{"id":"99F6B7FF-0F35-4B9B-9596-CF4E2558C7FE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1155_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"「私が考えていたよりも、お台場を選んだ人が多いみたい…」","voiceCharacter":"古明地こいし","duration":5.001088435374149,"title":"シーン 1155","slideTitle":"スライド #1155","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1155.jpeg","voiceDuration":5.001088435374149,"seVolume":1},{"id":"181A6513-A413-49B2-B04B-B2146CCAE348","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1156_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"「電車に乗っていてわかってるとは思いますが、新宿とかなら、この倍以上の人がいるから、それと比べたらすいてるわよ。」","voiceCharacter":"アリス・マーガトロイド","duration":6.1873015873015875,"title":"シーン 1156","slideTitle":"スライド #1156","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1156.jpeg","voiceDuration":6.1873015873015875,"seVolume":1},{"id":"93A44BA2-E33C-4862-BDCC-85D616E12368","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1157_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"「確かに、アリスさんの言うとおり…」","voiceCharacter":"古明地こいし","duration":2.7856235827664397,"title":"シーン 1157","slideTitle":"スライド #1157","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1157.jpeg","voiceDuration":2.7856235827664397,"seVolume":1},{"id":"2DEA96BF-AF80-4B2E-9977-92C5681957D8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1158_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"僕は、場の空気が気まずくなるのを感じ、流れを変えようと、3人に提案する。「とりあえず、ショッピングモールに行きませんか？」","voiceCharacter":"操夢","duration":8.514761904761905,"title":"シーン 1158","slideTitle":"スライド #1158","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1158.jpeg","voiceDuration":8.514761904761905,"seVolume":1},{"id":"3956BF67-2A1C-404E-94AE-1FA867D5B948","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1159_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image57.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","telop":"「とりあえず、その予定だったし、そうしましょ。」\nそれから、私たちは、ショッピングモールに向かって歩く。","voiceCharacter":"アリス・マーガトロイド","duration":5.718344671201814,"title":"シーン 1159","slideTitle":"スライド #1159","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1159.jpeg","voiceDuration":5.718344671201814,"seVolume":1},{"id":"BC26F2B4-3923-48FE-8BBF-61A2761EDA50","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1160_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc230307_ショッピングモール.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","telop":"僕たちは、それから駅から数分程度歩き、ショッピングモールにやってきた。明日から大型連休だからか、そこそこ人がいた。","voiceCharacter":"操夢","duration":8.55172335600907,"title":"シーン 1160","slideTitle":"スライド #1160","