65,"animationNote":"表示時間：1秒","transitionName":"なし","backgroundName":"image56.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1123.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア壊れたにやけ顔.pxd","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"シーン 1123","id":"8D27EB19-C6F3-485C-BC0F-8FB99436FB58","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":9.066938775510204,"slideTitle":"スライド #1124","title":"シーン 1124","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1124_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1124.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、ハッと気がつくと、彼女が暗い表情で、僕に声をかけていた。「ごめん…、母さん…。」僕は反射的に、そう謝る。","id":"5A457EBC-D6CC-4F3E-A7BC-CAE67A70F08F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.066938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":7.706984126984127,"slideTitle":"スライド #1125","title":"シーン 1125","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1125_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1125.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「謝る必要はないわよ。それよりも、あんたは大丈夫なの、さっきより顔色が悪くなっているけど…」","id":"9F7A68A9-00F7-4ACB-A649-DAA4C3DC1CFD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":7.706984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":5.856077097505669,"slideTitle":"スライド #1126","title":"シーン 1126","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1126_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1126.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そう…、でも僕は大丈夫だから、そんな顔しないで…、\n母さん…」僕はそう彼女に言う。","id":"378F443C-CB6F-4ADE-9A8B-FC7034537B01","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.856077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":8.553242630385487,"slideTitle":"スライド #1127","title":"シーン 1127","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1127_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1127.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「もし、何かあるんだったら、しっかりと人を頼りなさいね。」\n私は、そうこぼすと、病室を去っていった。","id":"7B246D6B-FB49-49FD-AE5A-256CF30566EB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":8.553242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":7.271292517006803,"slideTitle":"スライド #1128","title":"シーン 1128","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1128_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1128.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言うと、去っていった。僕は、つけたテレビを消すと、そのまま布団を被り、目を閉じるのだった。","id":"719C144A-A23A-488D-AFA9-E1060798A208","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.271292517006803},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1129","title":"シーン 1129: それから時間がたち…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1129.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それから時間がたち…","id":"BDA640EB-F130-47BD-B096-4E19C37051A0","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":5.612607709750567,"slideTitle":"スライド #1130","title":"シーン 1130","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1130_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1130.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はふと目が覚めると、すでに日が沈んでいた。\nすると、病室の扉が開く。","id":"F8F0F56D-A8A1-4DC0-9E12-9FB285FF85E2","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.612607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":3.246984126984127,"slideTitle":"スライド #1131","title":"シーン 1131","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1131_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1131.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、大丈夫、暗い表情をして…」","id":"D0AAFBAC-937A-4F58-AB1E-3F7527B38368","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.246984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":3.0104308390022676,"slideTitle":"スライド #1132","title":"シーン 1132","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1132_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1132.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「少しばかし、悪い夢を見ていただけですよ…」","id":"EBE9D5C4-6E75-45F5-B705-8EEC2E72820C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.0104308390022676},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":8.471995464852608,"slideTitle":"スライド #1133","title":"シーン 1133","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1133_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1133.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…、ほら、これ…」私はそう言うと、差し入れを渡す。\n「病院の許可はとってあるから、ちゃんと食べてね…」","id":"3C91BC57-6B3F-4FA3-9E92-07A1971D02BE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.471995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":8.294126984126985,"slideTitle":"スライド #1134","title":"シーン 1134","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1134_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1134.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ありがとうございます…」僕はそう言われ、渡されたお弁当の堤を開けて、中身を取り出す。それは手作りのお弁当だった。","id":"644B8945-911E-44B3-A5AB-C040D1400166","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.294126984126985},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":9.260748299319728,"slideTitle":"スライド #1135","title":"シーン 1135","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1135_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1135.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲れた顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「これ、私が頑張って作ったから、しっかり食べ切ってね…」\n私は、そう言うと、一度、病室から離れていった。","id":"4A6603DA-B510-43FB-95AB-3A1698037FD3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":9.260748299319728},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":7.4354195011337865,"slideTitle":"スライド #1136","title":"シーン 1136","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1136_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1136.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が病室を出ると、早速そのお弁当を開ける。\nそして、そのお弁当をよく味わって食べていった。","id":"EBF724D3-5E58-4308-B092-9AC48B1A7A54","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.4354195011337865},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":8.85390022675737,"slideTitle":"スライド #1137","title":"シーン 1137","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1137_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1137.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、お弁当を数十分かけて、食べ終えると、僕は、そのまま窓の外に視線を向ける。そして、昨日のことを考える。","id":"05BE7B27-9B56-4B9D-80F1-2EB24D48442B","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.85390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":5.558253968253968,"slideTitle":"スライド #1138","title":"シーン 1138","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1138_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1138.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、だんだんと瞼が落ちそうになる。\nだが、ある光景が僕の脳裏を横切る。","id":"3450FF70-8B6D-4492-9B21-065B73003A46","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.558253968253968},{"animationDuration":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.pxd","bgmStartTimeOffset":0,"duration":1,"slideTitle":"スライド #1139","title":"シーン 1139","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1秒","transitionName":"なし","backgroundName":"image56.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1139.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（狂気）.pxd","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"シーン 1139","id":"CC5CE8A4-A09B-4462-807C-685DE74DBBCE","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":3.546984126984127,"slideTitle":"スライド #1140","title":"シーン 1140","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1140_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1140.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲れた顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、大丈夫？顔が青ざめてるよ…。」","id":"540C545F-E16A-4BD9-B178-6720DBB12F2D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.546984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":9.961995464852608,"slideTitle":"スライド #1141","title":"シーン 1141","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1141_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1141.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲れた顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"僕は、彼女の声掛けで我に帰る。「あっ…お弁当美味しかったです…」僕は、自分の思考を悟られないように、そう誤魔化す。","id":"4171BA98-CADE-447D-A0C6-3DB94488F614","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":9.961995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":10.585736961451246,"slideTitle":"スライド #1142","title":"シーン 1142","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1142_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1142.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/疲れた顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「本当に、大丈夫なの？何か、あるなら私に相談してね…」\n私は、彼にそう言うと、病室を去り、家に帰っていった。","id":"70AF516D-CEE2-4217-8282-66A054EFC663","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.585736961451246},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","bgmStartTimeOffset":0,"duration":8.75172335600907,"slideTitle":"スライド #1143","title":"シーン 1143","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1143_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256899_病室-夜-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1143.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が病室を出ると、一人考える。「過去を克服しないと…」僕は、ある一種の不安を感じながら、そう呟いた。","id":"D6346343-9DB6-433D-B5FC-BF0380E991A2","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.75172335600907},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1144","title":"シーン 1144: 翌朝…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1144.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"翌朝…","id":"D97DC0AD-4497-4CB5-9917-A294F105730D","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.60063492063492,"slideTitle":"スライド #1145","title":"シーン 1145","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1145_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1145.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、朝がやってくると、病室で朝食をとり、そのまま教室に入った。そして、席に着き、身の回りを整える。","id":"C86AE708-8A05-4959-B7E6-B4987DFEEBB4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.60063492063492},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.164761904761905,"slideTitle":"スライド #1146","title":"シーン 1146","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1146_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1146.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、教室の扉が開き、彼女が僕の席にやってくる。\n「あの、どうしたんですか？」","id":"BF56913B-65E7-493E-94C4-29F1A987807E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.164761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.313197278911565,"slideTitle":"スライド #1147","title":"シーン 1147","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1147_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1147.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「ついさっき、あなたのお弁当が届けられたので…」\n私はそう言いながら、受け取った弁当を置く。","id":"0CDDEBE8-82B8-4AFC-84EF-8FEDACECA0F0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":5.313197278911565},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.014897959183673,"slideTitle":"スライド #1148","title":"シーン 1148","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1148_十六夜咲夜.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1148.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_53C6","characterName":"十六夜咲夜","telop":"「これは、昼食用だそうです。それでは、私は失礼します…」\n私はそういいながら、彼の教室から去っていった。","id":"C7852BEC-886D-407E-8AD9-B1969FB998D0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","voiceDuration":7.014897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.909342403628118,"slideTitle":"スライド #1149","title":"シーン 1149","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1149_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1149.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、届けられた弁当が入った包みを開く。すると、弁当箱と共に、メモ書きが載せてあった。『何かあったら言ってね…』","id":"8A9B0B80-12FD-4C30-9C61-6879517428A1","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.909342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.506077097505669,"slideTitle":"スライド #1150","title":"シーン 1150","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1150_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1150.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そのメモ書きを適当にバックに入れると、弁当を包みにくるみ、そのままバックにそっと入れる。","id":"A05744E9-96E1-41AD-9A35-54F4AA6D32D5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.506077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.097369614512472,"slideTitle":"スライド #1151","title":"シーン 1151","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1151_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1151.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それからしばらくすると、チャイムが鳴り、担任が入ってくる。\nそれからいつも通りの、日常がやってきた。","id":"B6A9A0CD-525E-45C0-AFEB-278DC455508D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.097369614512472},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1152","title":"シーン 1152: それから、数日の時間が流れ…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1152.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それから、数日の時間が流れ…","id":"0C9AD2F1-DD1B-453D-9114-695AF1824108","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":8.816938775510204,"slideTitle":"スライド #1153","title":"シーン 1153","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1153_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1153.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、数日が経ち、僕たちは、遠足当日を迎えた。\nそして、駅を出ると、さとりとこいしの二人が話しかけてくる。","id":"5A62F061-68C6-44D5-9DBD-6E26AE5771D5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.816938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":1.915986394557823,"slideTitle":"スライド #1154","title":"シーン 1154","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1154_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1154.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「思っていたよりも、人がいますね…」","id":"86D21A53-9A26-4C5C-97DC-2A523D8C1EFA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":1.915986394557823},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":5.001088435374149,"slideTitle":"スライド #1155","title":"シーン 1155","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1155_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1155.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私が考えていたよりも、お台場を選んだ人が多いみたい…」","id":"99F6B7FF-0F35-4B9B-9596-CF4E2558C7FE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":5.001088435374149},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":6.1873015873015875,"slideTitle":"スライド #1156","title":"シーン 1156","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1156_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1156.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「電車に乗っていてわかってるとは思いますが、新宿とかなら、この倍以上の人がいるから、それと比べたらすいてるわよ。」","id":"181A6513-A413-49B2-B04B-B2146CCAE348","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.1873015873015875},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":2.7856235827664397,"slideTitle":"スライド #1157","title":"シーン 1157","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1157_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1157.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「確かに、アリスさんの言うとおり…」","id":"93A44BA2-E33C-4862-BDCC-85D616E12368","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.7856235827664397},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":8.514761904761905,"slideTitle":"スライド #1158","title":"シーン 1158","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1158_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1158.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、場の空気が気まずくなるのを感じ、流れを変えようと、3人に提案する。「とりあえず、ショッピングモールに行きませんか？」","id":"2DEA96BF-AF80-4B2E-9977-92C5681957D8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.514761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image57.jpeg","bgmStartTimeOffset":0,"duration":5.718344671201814,"slideTitle":"スライド #1159","title":"シーン 1159","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1159_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image57.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1159.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「とりあえず、その予定だったし、そうしましょ。」\nそれから、私たちは、ショッピングモールに向かって歩く。","id":"3956BF67-2A1C-404E-94AE-1FA867D5B948","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.718344671201814},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":8.55172335600907,"slideTitle":"スライド #1160","title":"シーン 1160","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1160_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1160.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それから駅から数分程度歩き、ショッピングモールにやってきた。明日から大型連休だからか、そこそこ人がいた。","id":"BC26F2B4-3923-48FE-8BBF-61A2761EDA50","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.55172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":2.556077097505669,"slideTitle":"スライド #1161","title":"シーン 1161","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1161_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1161.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、こいしが僕に話しかけてくる。","id":"5049A7B7-5D64-4B6B-86D9-45B3030DB9EC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.556077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":2.340861678004535,"slideTitle":"スライド #1162","title":"シーン 1162","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1162_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1162.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それで、これからどうする？」","id":"DACB53B3-F049-4B3C-9EF0-4420CFC67C8B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.340861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":4.586507936507936,"slideTitle":"スライド #1163","title":"シーン 1163","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1163_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1163.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう彼女に聞かれ、考える。すると、アリスが話し出す。","id":"80DC4339-0E4A-46DA-ADAD-F1279E6A7A46","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.586507936507936},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":1.633061224489796,"slideTitle":"スライド #1164","title":"シーン 1164","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1164_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1164.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私は、本屋に行きたいわ…。」","id":"D8F18C65-BFE6-41B7-B669-F91C3AA44EFC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.633061224489796},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":4.864399092970522,"slideTitle":"スライド #1165","title":"シーン 1165","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1165_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1165.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「こいし、さっきからどうしたの？」\n私は、こいしがそっぽを向いていたので、そう声をかける。","id":"6A7C051A-FB9B-44B4-9810-333653FCB20E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":4.864399092970522},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":5.1171201814058955,"slideTitle":"スライド #1166","title":"シーン 1166","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1166_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1166.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「えっ？」私は、彼女にそう声をかけられ、驚く。","id":"66E88EDB-F644-45E6-8214-FAA5AEA154A1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":5.1171201814058955},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":5.541133786848072,"slideTitle":"スライド #1167","title":"シーン 1167","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1167_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1167.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「班長がこう言うのあれかもだけど…、本屋を見にいってても大丈夫かしら…」私は、そう彼に、尋ねる。","id":"0DDA6068-22C3-4F13-8586-93C3109901B2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":5.541133786848072},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":3.284331065759637,"slideTitle":"スライド #1168","title":"シーン 1168","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1168_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1168.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう聞かれ、ふと二人の方を見る。","id":"CE36C7A0-7167-44C1-8ABC-1729A65732D4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.284331065759637},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":7.789773242630385,"slideTitle":"スライド #1169","title":"シーン 1169","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1169_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1169.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そこには、なぜか、頬照りながら困るこいしと、ため息をつくさとりの姿があった。「二人とも、どうしたんですか？」","id":"1E4E02E7-1523-4F86-BE49-59386CC57482","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.789773242630385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":6.423469387755102,"slideTitle":"スライド #1170","title":"シーン 1170","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1170_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1170.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、互いに何も言わず、気まずい空気になってしまう。\n僕は仕方なく、アリスの方を向く。","id":"00B0E9E7-E35C-4C63-963C-236935CA996C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.423469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":3.684331065759637,"slideTitle":"スライド #1171","title":"シーン 1171","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1171_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1171.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いいですよ。ただ、昼食は一緒に取りませんか？」","id":"32A02491-3EE5-438D-AF62-07DD94A765F6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.684331065759637},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":4.769501133786848,"slideTitle":"スライド #1172","title":"シーン 1172","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1172_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1172.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「ええ、分かったわ…、それじゃあ、行ってくるわね…」\n私はそう言うと、本屋を見に行った。","id":"A0E9519B-919C-4B02-917D-A85F9E9839E0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":4.769501133786848},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":6.29390022675737,"slideTitle":"スライド #1173","title":"シーン 1173","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1173_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1173.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ、紅夢…。あれを見て…」\n私はそう言いながら、あるものを指差す。","id":"71CB2B95-C798-46FC-A846-F10204D4E653","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":6.29390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":8.568027210884354,"slideTitle":"スライド #1174","title":"シーン 1174","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1174_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1174.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそう言われ、そっちを向くと、洋服店があった。すると、とあるポスターが目に入る。僕は、そのポスターの文字を見る。","id":"A18F352D-EC5B-47FE-ACCB-B091D3CEA07C","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.568027210884354},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":8.181065759637189,"slideTitle":"スライド #1175","title":"シーン 1175","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1175_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1175.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"その内容を要約すると、今現在、このお店で一定金額以上の利用をすると、金額に応じたくじ引きができるとあった。","id":"09868FEC-3912-467D-B0C7-B4A7C64C2AB3","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.181065759637189},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":8.446303854875284,"slideTitle":"スライド #1176","title":"シーン 1176","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1176_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1176.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、あたりの中に、旅行券が含まれていた。くじ引きは、今日までで、行き先は…僕が、見知っている場所だった。","id":"8AFB8C9E-CCCE-4797-B62C-56B997B16269","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.446303854875284},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","bgmStartTimeOffset":0,"duration":8.286507936507936,"slideTitle":"スライド #1177","title":"シーン 1177","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1177_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1177.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、店内には、きっとその場所で使うことを想定されている洋服がずらりと並んでいた。そこまで見ると、視線を戻す。","id":"F452CF73-032C-482B-AFF3-863E6AD25A56","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.286507936507936},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":3.669591836734694,"slideTitle":"スライド #1178","title":"シーン 1178","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1178_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1178.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「紅夢…、そのお店で洋服を見てきてもいい？」","id":"41F24F9F-8DAB-4651-9651-A8F30E8D4169","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.669591836734694},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":6.086507936507936,"slideTitle":"スライド #1179","title":"シーン 1179","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1179_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1179.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ちなみに、そのお金は…？」\n僕は、二人が財布が手元にないを知った上で、そう聞く。","id":"6D341BC8-5658-4031-A176-1D17F6D86A75","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.086507936507936},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":0.8201587301587302,"slideTitle":"スライド #1180","title":"シーン 1180","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1180_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1180.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「えっと…」","id":"BFD2C0A1-E366-4E98-AC4C-A0937023E7C0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.8201587301587302},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":8.708253968253969,"slideTitle":"スライド #1181","title":"シーン 1181","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1181_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1181.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕の問いかけに、言い淀む彼女を見て、思わずため息が漏れる。\n「ATMを探しに向かうので、その間、服を見てていいですよ。」","id":"DF3174F0-512A-4F22-9AED-F3D331324EE0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.708253968253969},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":5.91,"slideTitle":"スライド #1182","title":"シーン 1182","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1182_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1182.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「えっ、こいし。本気でくじ引きをするの？紅夢さんも、\n無理にお金を出そうとしなくて、大丈夫ですよ。」","id":"968DB406-D070-4AD7-8DE7-3FA7C10CC91A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.91},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":5.900272108843537,"slideTitle":"スライド #1183","title":"シーン 1183","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1183_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1183.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ありがとう…！」\n私はそう言うと、早速、そのお店に入って行った。","id":"777E42AA-D507-4EB5-B46C-2C4F0E27BA2D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":5.900272108843537},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":5.404195011337868,"slideTitle":"スライド #1184","title":"シーン 1184","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1184_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1184.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あの、いいんですか、妹のわがままに付き合っても…。\nもし、あれだったら、私が注意しますよ…。」","id":"DA2B7233-9ABC-4DD6-A861-580588308336","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.404195011337868},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":3.5212925170068026,"slideTitle":"スライド #1185","title":"シーン 1185","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1185_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1185.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そういう彼女にあるものをバックから取り出し見せる。","id":"56040A1B-891A-440B-BEEB-48234B721EE5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.5212925170068026},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":6.735487528344671,"slideTitle":"スライド #1186","title":"シーン 1186","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1186_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1186.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"私は、彼がバックから取り出した、封筒の中身を見て驚く。\nそこには、ある衝撃の内容が書かれた手紙とカードがあった。","id":"095F05D5-2D02-41A4-8D90-E90F0DF405D5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.735487528344671},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":0.9044897959183673,"slideTitle":"スライド #1187","title":"シーン 1187","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1187_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_ショッピングモール.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1187.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そのカードって…。」","id":"CEC95079-3593-4398-B55F-DF1B35CD7368","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":0.9044897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc230307_ショッピングモール.jpg","bgmStartTimeOffset":0,"duration":6.83,"slideTitle":"スライド #1188","title":"シーン 1188","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1188_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc230307_シ