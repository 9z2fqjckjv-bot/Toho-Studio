\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.005.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かった…」\n僕はそういうと、目の前の卵かけご飯を食べる。","id":"12C3B141-D8AB-4708-A588-57469912256A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.231065759637188},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":4.0619954648526075,"slideTitle":"スライド #6","title":"シーン 6","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.006.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「そういえば、入学式は、親の付き添いっているの？」","id":"8D5DB2FC-69C2-4F04-82EC-8F99A2DC6C7A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":4.0619954648526075},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":3.108253968253968,"slideTitle":"スライド #7","title":"シーン 7","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.007.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いや、大丈夫だから、付き添わなくていいよ。」","id":"03EBE79F-4760-49E9-8430-79EFD007F8C4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.108253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":7.211995464852608,"slideTitle":"スライド #8","title":"シーン 8","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.008.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「そう、じゃあ、あんたの分の食器は自分で洗いなさいね。\n私は、もう神社に向かうから。」","id":"01D195AC-A687-4889-9EB2-92360F1717ED","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":7.211995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":4.262607709750567,"slideTitle":"スライド #9","title":"シーン 9","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.009.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かった。」\n僕がそういうと、彼女はそのまま家を出ていった。","id":"E84BA652-B3C7-4FA8-8924-0D37971C7636","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.262607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":7.069115646258504,"slideTitle":"スライド #10","title":"シーン 10","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.010.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それから数分も経たずに、朝食を食べ切ると、そのまあ流しに食器を入れ、ささっと洗剤で洗う。","id":"EBFAA67B-90B9-40F4-913C-4AE93480FB19","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.069115646258504},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/リビング（日中）.jpg","bgmStartTimeOffset":0,"duration":3.2756462585034014,"slideTitle":"スライド #11","title":"シーン 11","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.011.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、洗い物が終わると、自分の部屋に戻る。","id":"42F59D6B-DF2C-482A-B69B-C236CBE80848","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.2756462585034014},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":8.869115646258503,"slideTitle":"スライド #12","title":"シーン 12","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.012.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、部屋に戻ると、新品の学校の制服を取り出し、ささっと着替える。そして、デスクをチラリと見ると、ある写真が写る。","id":"D89A3A69-0929-4574-BD0E-278BCB137FFC","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.869115646258503},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":9.37891156462585,"slideTitle":"スライド #13","title":"シーン 13","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.013.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"その写真には、巫女服の霊夢と、僕の父である妹紅、そして、僕の3人が写っていた。この時の僕はまだ、小学生だった。","id":"4EB79851-3A16-40DE-9103-F075E0A652E4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.37891156462585},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":8.750634920634921,"slideTitle":"スライド #14","title":"シーン 14","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.014.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"今思えば、僕がこの学校を選んだ理由も、中学時代のある経験が原因だ。中学まで男子ばっかで度々トラブルになった。","id":"C72A5F2B-2638-4343-A4DE-D96721D29D6F","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.750634920634921},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":8.082154195011338,"slideTitle":"スライド #15","title":"シーン 15","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","bgmVolume":0.65,"transitionName":"カラーでフェード","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.015.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"世の中の男女比率…僕はそんなことを考えながら、ふと時計を見ると、もうすぐ家を出ないといけない時間で、頭を振る。","id":"B84D7513-5966-4E21-A920-1B60234AE23D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.082154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.081065759637188,"slideTitle":"スライド #16","title":"シーン 16","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.016.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、学校に着くと、腕につけている時計を見る、\n思っていたよりも早く着いたみたいだった。","id":"69008E1F-A4E0-4576-BCF1-08032FB592D2","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.081065759637188},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":1.7843310657596372,"slideTitle":"スライド #17","title":"シーン 17","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.017.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして中に、入っていく。","id":"F24164EF-9083-4386-A1B9-071594ACF250","seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.7843310657596372},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":4.686507936507937,"slideTitle":"スライド #18","title":"シーン 18","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.018.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が教室に入ると、すでに教室にいた\n女子たちが一斉にコチラを見る。","id":"191664A1-CAB9-43BE-925A-69DB7A317333","seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.686507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":2.798979591836735,"slideTitle":"スライド #19","title":"シーン 19","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.019.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あなたは…今年から来る中途入学の男子ですか？」","id":"832805F0-A893-4760-9D83-B4BD71C6E3E5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.798979591836735},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":1.1452154195011337,"slideTitle":"スライド #20","title":"シーン 20","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.020.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「中途入学…？」","id":"A81B8468-26DA-4518-8172-C33FA9871F10","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.1452154195011337},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":6.435192743764173,"slideTitle":"スライド #21","title":"シーン 21","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.021.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「ええ、この学園では、幼稚部から大学院まであって、希望者は教員になって、定年まで居続けられる学園なんですよ。」","id":"3BAE2A77-66EF-4A1D-B9E0-AFF4E44E5C46","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.435192743764173},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":0.5452154195011338,"slideTitle":"スライド #22","title":"シーン 22","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.022.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「へぇ…」","id":"D6DE1A6C-5672-470F-90B8-963D7064999B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":0.5452154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":3.964784580498866,"slideTitle":"スライド #23","title":"シーン 23","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.023.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「その顔…もしかして、この学園のことを\n何も知らずに入学したんですか？」","id":"094B9970-5F48-4D01-8C39-4C1D1514A1E2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.964784580498866},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.112607709750567,"slideTitle":"スライド #24","title":"シーン 24","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.024.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「両親に、この学校に行けって言われて、\nただそのまま来たっていえばいいですか？」","id":"50465F94-8CCC-48A1-B372-A2453301B6D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.112607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":4.7883900226757365,"slideTitle":"スライド #25","title":"シーン 25","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.025.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「そうですか…。まぁ、あなた以外はみな小さい頃から見知った同姓の学生ばかりですからね…」","id":"07072DFC-20FC-4232-9906-EC5CC522FABF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":4.7883900226757365},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":1.732154195011338,"slideTitle":"スライド #26","title":"シーン 26","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.026.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、僕の席は…」","id":"B161064A-5D27-4C57-B907-38CDCFB036EA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.732154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":3.3127891156462583,"slideTitle":"スライド #27","title":"シーン 27","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.027.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「確か、窓際の真ん中の席に空席があった気がしますが…」","id":"70814AB8-2DD7-48B7-9B37-8DB5EA1226B0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.3127891156462583},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.2365079365079366,"slideTitle":"スライド #28","title":"シーン 28","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.028.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…」\n僕は、そう呟くと言われた席につき、荷物をおろし始めた。","id":"9A1C920C-8F13-4796-BE3C-2F914542F2D4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.2365079365079366},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #29","title":"シーン 29: それからしばらくたち…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.029.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それからしばらくたち…","id":"5403F1AA-B00C-4E04-B0CC-093654DA6E75","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":9.59954648526077,"slideTitle":"スライド #30","title":"シーン 30","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.030.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、数十分ほど経つと、チャイムがなり、教室が静まり返る。そして、数十秒程度の間の後、誰かが教室にはいってくる。","id":"32458048-14E1-4F2A-9222-56C55C9A5B41","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.59954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":1.2048072562358276,"slideTitle":"スライド #31","title":"シーン 31","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.031.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「おはようございます。」","id":"ACEBFA25-6FF7-4A7C-9346-C72F163BF5F2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":1.2048072562358276},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.773469387755102,"slideTitle":"スライド #32","title":"シーン 32","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.032.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"その女性がそういうと、周りの女子たちが皆一斉に「おはようございます」と言い、礼をする。","id":"4433753A-CED1-487F-8BBB-E3024A7C94E7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.773469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.297777777777778,"slideTitle":"スライド #33","title":"シーン 33","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.033.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「おや…一人…はずれものがいますね…」\n私はそう言い、その男子に目線を合わせる。","id":"47F3835A-ABC8-4FF7-828B-1AC47A49826F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":5.297777777777778},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":6.126848072562359,"slideTitle":"スライド #34","title":"シーン 34","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.034.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「あなたも、今日から、この学園の一員ですから、\n挨拶の練習でもしましょうか…、藤原さん。」","id":"442E2D0D-C6D0-4794-BD3B-91D9BB49FE46","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":6.126848072562359},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":6.95281179138322,"slideTitle":"スライド #35","title":"シーン 35","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.035.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言われ、僕に向けての声かけだったことに気づく。\n「あの…練習って…何をすればいいんですか？」","id":"F2B9CBE5-2982-42D0-A0DE-D905BA5E1F0C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.95281179138322},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":3.3775736961451246,"slideTitle":"スライド #36","title":"シーン 36","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.036.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「そうですね…とりあえず、私の方に来てください。」","id":"AFF3C4DE-2011-47AF-8E46-48EB0EBA1C73","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":3.3775736961451246},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":8.166938775510204,"slideTitle":"スライド #37","title":"シーン 37","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.037.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、彼女の隣に立つ。\nすると、彼女が再び挨拶し、女子から挨拶と礼が返ってくる。","id":"D9A09C9E-13E7-4046-B721-A5A35BF58098","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.166938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.734444444444445,"slideTitle":"スライド #38","title":"シーン 38","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.038.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「彼女たちのように、あなたも私の挨拶に対して、\n挨拶とお辞儀で返すことはできますか？」","id":"3D6FEC6E-5264-454F-93CE-CF0945513EE5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":5.734444444444445},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":8.436507936507937,"slideTitle":"スライド #39","title":"シーン 39","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.039.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言われ、どう返すべきかわからず、黙ってしまう…。\nすると、彼女がある女子を呼び、その女子は僕の反対側に立つ。","id":"79D42475-7C90-45EC-B036-4BDCBF26174B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.436507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.468979591836734,"slideTitle":"スライド #40","title":"シーン 40","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.040.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「さとりさん、私が今から、『おはようございます。』と言いますので、彼に返しの挨拶とお辞儀の手本を見せてください。」","id":"468B6EEE-4C06-4952-B0AF-21F775B991DE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":7.468979591836734},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":5.283378684807256,"slideTitle":"スライド #41","title":"シーン 41","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.041.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「分かりました、早苗師匠。」\n私はそう返すと、彼女に言われた通りに、彼に手本を見せる。","id":"612AB0DB-4690-454A-8CE9-7351A3054105","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.283378684807256},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":6.580453514739229,"slideTitle":"スライド #42","title":"シーン 42","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.042.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「さて、お手本は見せました、今度はあなたの番ですよ、藤原さん。挨拶とお辞儀、出来ますか？」","id":"B2C9612E-A61E-4444-BC29-6611CA7070AE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":6.580453514739229},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":3.9973696145124715,"slideTitle":"スライド #43","title":"シーン 43","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.043.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、見よう見まねで挨拶とお辞儀をする。","id":"2160C666-F856-4CA6-87B1-C957DAEA7198","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.9973696145124715},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.4156462585034015,"slideTitle":"スライド #44","title":"シーン 44","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.044.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「初日しては、上出来ですよ、藤原さん。それじゃあ、あなたのこれまでの人生について、10分間で言いましょう。」","id":"CEA45538-B96A-4303-8FFC-5278888620AA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":7.4156462585034015},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":8.209342403628117,"slideTitle":"スライド #45","title":"シーン 45","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.045.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました…」僕はそう言われ、これまでの人生を振り返る。そのうち、スイッチが入ったように、その内容を語った。","id":"007243ED-0E0E-4F3B-871F-2EC7B54C8DB1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.209342403628117},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.5830385487528345,"slideTitle":"スライド #46","title":"シーン 46","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.046.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「今日の朝礼はこれで、終了です。今日から新年度ですので、心改めて、より良い自分を見せられるようにしましょう。」","id":"4935A518-14F6-49C7-90C0-5DD926270226","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":7.5830385487528345},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.831065759637188,"slideTitle":"スライド #47","title":"シーン 47","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.047.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、その場を去っていった。すると、彼女にさとりと呼ばれていた、先程の女子が僕の元に駆け寄る。","id":"20BF2A8D-5235-46B6-8F2A-2FEB071A208E","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.831065759637188},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":2.6291836734693876,"slideTitle":"スライド #48","title":"シーン 48","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.048.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「汗ダラダラで顔も赤いですけど、大丈夫ですか？」","id":"2F56A32A-5473-4722-8A9B-5FAD089D97FD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.6291836734693876},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.927823129251701,"slideTitle":"スライド #49","title":"シーン 49","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.049.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は彼女にそう言われ、何かを言おうとするが、声が出なかった。「あはは…」そう言いながら、僕の視界は闇に染まった。","id":"29D75C8F-0827-44FD-B77F-EFE97D5F8DED","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.927823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","bgmStartTimeOffset":0,"duration":3.6832426303854877,"slideTitle":"スライド #50","title":"シーン 50","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791188423_26966.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.050.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"私はふと目が覚めると、そこは学校の保健室だった。","id":"B7CAAD01-0E52-4AE8-B87D-665F3667C510","seVolume":1,"voiceCharacter":"サブ","voiceDuration":3.6832426303854877},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","bgmStartTimeOffset":0,"duration":4.6952154195011335,"slideTitle":"スライド #51","title":"シーン 51","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_サブ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791188423_26966.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.051.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/鈴仙（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_CC3E","characterName":"サブ","telop":"すると、私のそばにいたのか、\n彼女が困惑した表情でここを見る。","id":"FCA8047B-42EE-4F84-AA4E-DC9A1A81B5FC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"サブ","voiceDuration":4.6952154195011335},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791188423_26966.png","bgmStartTimeOffset":0,"duration":4.237596371882086,"slideTitle":"スライド #52","title":"シーン 52","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStu