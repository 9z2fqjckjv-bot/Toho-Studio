":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1943.jpeg","voiceDuration":5.847369614512472,"seVolume":1},{"id":"C3280C38-62C4-4E4C-8441-CA4754DBFF25","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1944_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-26_19-50.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","telop":"「あなた、馬鹿なの？」","voiceCharacter":"古明地こいし","duration":1.8988888888888888,"title":"シーン 1944","slideTitle":"スライド #1944","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1944.jpeg","voiceDuration":1.8988888888888888,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/衣擦れ2.mp3","id":"CD8019E0-904E-4581-9B16-8A703C596046","seStartTimeOffset":3.45,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1945_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-26_19-50.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","telop":"「えっ？」僕は、そう返すと、\n彼女は黙って、僕をベッドに押し倒す。","voiceCharacter":"操夢","duration":5.222380952380952,"title":"シーン 1945","slideTitle":"スライド #1945","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 衣擦れ2","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1945.jpeg","voiceDuration":5.222380952380952,"seVolume":2},{"id":"7A3E3BEA-CF6C-4364-A69A-488E82AF6A39","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1946_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","telop":"「もういい、あんたに私の気持ちを分からせるわ。」","voiceCharacter":"古明地こいし","duration":3.8270521541950115,"title":"シーン 1946","slideTitle":"スライド #1946","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1946.jpeg","voiceDuration":3.8270521541950115,"seVolume":1},{"id":"940A14EF-8BD0-45D3-BCC4-B3D690107EF8","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1947_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","telop":"僕は、彼女の突如の変化に戸惑いながらも、そっとキスをする。","voiceCharacter":"操夢","duration":4.421292517006803,"title":"シーン 1947","slideTitle":"スライド #1947","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1947.jpeg","voiceDuration":4.421292517006803,"seVolume":1},{"id":"D9370A62-E945-4281-81B2-11E5C92FC733","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ驚き.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1948_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","telop":"すると、彼女の全身が頬照ったように赤みを帯び、固まってしまう。僕は、その彼女の手を取り、ある存在を示す。","voiceCharacter":"操夢","duration":8.225646258503401,"title":"シーン 1948","slideTitle":"スライド #1948","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1948.jpeg","voiceDuration":8.225646258503401,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いパンチ2.mp3","id":"328C9F6F-4BB8-4543-B0F9-961944D8DF6F","seStartTimeOffset":6.13,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ怒り.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedA