ackgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.555.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「それで、どう。私と一緒に夜の街をお散歩する？」","id":"971A6824-A250-4EED-9700-8863EE01DCC6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.504489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.6539002267573695,"slideTitle":"スライド #556","title":"シーン 556","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_556_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.556.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いや、今用事を思い出したので、\nそれを済ませたら、家に帰ります。」","id":"AA94543D-2471-4DAA-BA7C-163BAC4C3F4E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.6539002267573695},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":0.6319954648526077,"slideTitle":"スライド #557","title":"シーン 557","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_557_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.557.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン困り後ろ手.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…」","id":"E15597B5-E43E-47F3-B4F1-AAC1125935D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":0.6319954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":9.788684807256235,"slideTitle":"スライド #558","title":"シーン 558","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_558_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.558.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン困り後ろ手.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その彼女の表情を見ると、なんだか断るのは、申し訳なく感じてくる。「散歩とは違いますが…僕の用事に付き合ってくれませんか…？」","id":"07673032-0F0A-4FB7-96BE-0D36F777955F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.788684807256235},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":0.9569841269841269,"slideTitle":"スライド #559","title":"シーン 559","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_559_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.559.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ありがとう！」","id":"B1C7C43D-69F5-4896-9E1B-CAE033C1A646","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":0.9569841269841269},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.656077097505669,"slideTitle":"スライド #560","title":"シーン 560","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_560_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.560.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そう彼女が笑うと、どこかで見たことのあるようなその表情に、過去を思い出しながら、一緒に歩き始めた。","id":"22EAFB3E-9954-4CF4-9DD3-B6BF8B828F13","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.656077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.582721088435374,"slideTitle":"スライド #561","title":"シーン 561","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_561_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.561.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"私が、その場所につき、そっと影から覗くと、一方の男女は戦い、もう一方の男女は一緒にどこかに歩き出していた。","id":"7A4742C0-A28A-4FF1-BC2F-148803783451","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.582721088435374},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.6998185941043085,"slideTitle":"スライド #562","title":"シーン 562","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_562_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.562.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「一体、何があったんでしょうか…」私は、そう呟く。","id":"9A096345-8427-465B-80ED-1EEC9E404A68","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":2.6998185941043085},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.554421768707483,"slideTitle":"スライド #563","title":"シーン 563","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_563_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.563.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"だが、歩き出した二人の方は、あっという間に姿が消え、残ったのは、元学園生の霧雨魔理沙とある男性だけだった。","id":"42F88EF0-352E-4C91-B9C8-4E676DF65D48","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.554421768707483},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #564","title":"シーン 564: 歩き始めたフランと彼は…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.564.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"歩き始めたフランと彼は…","id":"E3534883-6CAF-49E7-9228-AC5A2EC91109","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.9354195011337865,"slideTitle":"スライド #565","title":"シーン 565","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_565_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.565.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕とその女性、フランさんはあるスーパーに寄って行った。\n冷蔵庫がスカスカなために、買い出しにやって来た。","id":"DC6ACA3D-02F0-4F40-B46F-AE855FAB1D03","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.9354195011337865},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.10281179138322,"slideTitle":"スライド #566","title":"シーン 566","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_566_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.566.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そういえば、フランさんって、過去に僕と会ってましたか？」\n僕は、過去の記憶を確かめるために、彼女にそう尋ねる。","id":"0D2D287A-8FDC-42EA-B0DF-35DCAC640F06","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.10281179138322},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.301995464852608,"slideTitle":"スライド #567","title":"シーン 567","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_567_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.567.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「さあ、どうだろうね。あなたは、思い出せるかしら…」","id":"B337D6EB-1F1F-4D52-81FC-BF12D4D32A75","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.301995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.266938775510203,"slideTitle":"スライド #568","title":"シーン 568","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_568_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.568.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その彼女の表情を見て、僕がそれを思い出すまでは、答えなささそうなので、献立を考え、食材を見ていく。","id":"7B9BE78B-1D2B-42EF-B9D2-04183BE6B606","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.266938775510203},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.5778231292517,"slideTitle":"スライド #569","title":"シーン 569","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_569_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.569.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「フランさんは、夕飯はもう食べましたか？」\n僕はそう彼女に聞く。","id":"E146A75E-A551-4C92-9E41-4707916C4FEB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.5778231292517},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.019478458049887,"slideTitle":"スライド #570","title":"シーン 570","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_570_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.570.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「いや…まだ食べてないよ。」","id":"08B574B3-9BD6-4806-8731-DC616A1F212C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.019478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.906077097505669,"slideTitle":"スライド #571","title":"シーン 571","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_571_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.571.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「何か、食べたい料理とかってありますか？僕は、親にガスコンロは危ないから使うなって言われてますが…」","id":"6E4CEE6C-630A-4C67-B4D8-0A5871AF858D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.906077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.539478458049887,"slideTitle":"スライド #572","title":"シーン 572","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_572_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.572.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…、もしあれだったら、私も手伝うよ。」","id":"1EDC01FF-41DD-4065-A3B4-A1FA0169621F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.539478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.8973696145124714,"slideTitle":"スライド #573","title":"シーン 573","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_573_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.573.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…、何か食べたい物はありますか…？」","id":"DE60F350-52A4-47D9-934F-4E10F10266AC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.8973696145124714},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.041995464852608,"slideTitle":"スライド #574","title":"シーン 574","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_574_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.574.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「どうしようかな…、あなたは何か得意な料理でもあるの？」","id":"4DD8CF47-2385-4466-9CDB-FB9F74E787DC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.041995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":6.462607709750567,"slideTitle":"スライド #575","title":"シーン 575","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_575_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.575.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「得意な料理ですか…、強いていえば、ガスコンロと包丁を使わない料理だったら、僕でもできますよ。」","id":"F8A4144A-88C4-4539-950F-305BBAB20062","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.462607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.456984126984127,"slideTitle":"スライド #576","title":"シーン 576","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_576_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.576.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…、なら…リゾットはどう？」","id":"7869C7A5-B060-4D1D-A583-03B7BD695890","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.456984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.143038548752834,"slideTitle":"スライド #577","title":"シーン 577","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_577_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.577.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「リゾットですか…」僕はそう言いながら、献立を思いつく。\nそして、目的の食材がある売り場に向かう。","id":"AE7E3455-DEC8-406C-B5D5-89FE7ADFF875","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.143038548752834},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.634331065759637,"slideTitle":"スライド #578","title":"シーン 578","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_578_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.578.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、サバ味噌煮缶とチーズ、パックご飯をカゴに入れて歩く。\nそして、去り際に、ふりかけが目に入り、それもカゴに入れる。","id":"2B45FAB9-086C-4337-9DA9-D0A420D4327F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.634331065759637},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.765850340136055,"slideTitle":"スライド #579","title":"シーン 579","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_579_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.579.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、卵売り場に向かい、卵を手に取る。ふと、振り返ると、彼女の姿が見えなかった。僕は、彼女を探す。","id":"4191B3AD-33DC-4242-8191-9CE65CDCCB63","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.765850340136055},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.056077097505669,"slideTitle":"スライド #580","title":"シーン 580","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_580_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.580.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、彼女を探し、ワインの売り場に来ると、彼女はあるワインを見つめていた。「それ、飲みたいんですか？」","id":"DA5E5922-E5C3-42BB-A327-65EDB8B42F41","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.056077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.0182312925170067,"slideTitle":"スライド #581","title":"シーン 581","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_581_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.581.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「なんだか、良さげなワイン見つけちゃって…」","id":"4682EB90-C0E4-49D7-8505-134B82FEC138","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.0182312925170067},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.686507936507937,"slideTitle":"スライド #582","title":"シーン 582","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_582_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.582.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…」僕は、そう言い考える、ここでワインを買って行ってもいいが、母がそれ見たら、どんな反応をするかと…。","id":"0B577C21-7B7B-4147-81A1-D5DBF14C5B13","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.686507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.756077097505669,"slideTitle":"スライド #583","title":"シーン 583","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_583_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.583.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、数十秒、そう深く考えると、\nまぁいいかと括り、そのワインをカゴに入れた。","id":"DE87C39F-2419-45A7-8C12-7BF200B46817","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.756077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":0.9569841269841269,"slideTitle":"スライド #584","title":"シーン 584","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_584_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.584.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ありがとう。」","id":"9756A8AB-E116-4F2D-886B-BC039A724194","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":0.9569841269841269},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.266938775510204,"slideTitle":"スライド #585","title":"シーン 585","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_585_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.585.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「いえいえ。」僕はそう言い、彼女を見る。\nすると、ハッと過去を思い出す。","id":"6FD873CA-86C0-4150-96B0-C5FD4ECCDB55","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.266938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","bgmStartTimeOffset":0,"duration":9.588684807256236,"slideTitle":"スライド #586","title":"シーン 586","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_586_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.586.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それは、今から10年ほど前の、ある劇の発表日だった。その日は、参観日だったが、周りの同級生と違い、両親は来なかった。","id":"1333D873-7CDC-45F3-9410-8452BD914798","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.588684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","bgmStartTimeOffset":0,"duration":9.077823129251701,"slideTitle":"スライド #587","title":"シーン 587","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_587_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.587.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その発表をつまらなく感じ、ぼっと席を立ち、当時の先生、初恋であった彼女…フランを一瞬見て、教室を飛び出す。","id":"678B9459-8FB9-4188-88C9-10F700849E2D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.077823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","bgmStartTimeOffset":0,"duration":8.665850340136055,"slideTitle":"スライド #588","title":"シーン 588","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_588_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.588.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女にある告白をする。その当時は、単に「ありがとう。」と返される程度だった。","id":"9D565AB1-5D16-4C31-9F45-B694F7CA7C7C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.665850340136055},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","b