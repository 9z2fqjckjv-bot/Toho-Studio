gmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1598.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/靈夢（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「そのご令嬢と同じ部屋で過ごしていたら、ご令嬢が裸で出てきて、彼はその姿をしっかりと捉えて、ビンタを食らったって…。」","id":"5316D774-2BEE-43AD-9B85-1BEAB8B293E7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.498231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":4.642267573696145,"slideTitle":"スライド #1599","title":"シーン 1599","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1599_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1599.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊異変疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「ふーん、それであんたはどう思うのよ、\n自分の息子がご令嬢の裸を見たって言う事実に対して。」","id":"30393AB2-F0AD-4EBD-9367-3F47F6DED6EB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":4.642267573696145},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":8.780748299319727,"slideTitle":"スライド #1600","title":"シーン 1600","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1600_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1600.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊異変疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「どうって…」私はそう言われ、意見を言おうとするが、何を言えばいいかわからない。すると、彼女がある言葉を言う。","id":"4C11C9A2-C52A-41C6-8F3F-3133E0102E8C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":8.780748299319727},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":5.927278911564626,"slideTitle":"スライド #1601","title":"シーン 1601","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1601_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1601.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊異変疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「まさかとは思うけど、ヤキモチなんてしてないわよね…」\n私が、そう娘に問いただすと、娘は明らかに動揺する。","id":"B6CA0862-AB50-493B-8CAD-B26E8212F558","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":5.927278911564626},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":6.0403174603174605,"slideTitle":"スライド #1602","title":"シーン 1602","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1602_先代の巫女.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1602.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊異変疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2CB2","characterName":"先代の巫女","telop":"「これは、図星ね…、まぁ、いいわ。ほら、やる気出して、チャチャっと敷地内の埃を吐き出しなさい。いいわね…」","id":"5EB9BD20-81E2-442A-8BB7-AF7CC70E574C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"先代の巫女","voiceDuration":6.0403174603174605},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"duration":4.993242630385487,"slideTitle":"スライド #1603","title":"シーン 1603","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1603_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1603.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私は、それから、頭を横に振って、掃き掃除を進めた。","id":"963B377B-4417-47E4-92F8-B9B18E4566C7","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":4.993242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image69.jpeg","bgmStartTimeOffset":0,"duration":7.857165532879819,"slideTitle":"スライド #1604","title":"シーン 1604","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1604_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image69.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1604.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"あれから僕たちは、朝食を間にとって、恩納村にあるホテルにお昼前に着いた。そして、アリスが車を停めに向かう。","id":"E7FBEC64-A71B-4E07-8088-237FB42C7225","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.857165532879819},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image70.jpeg","bgmStartTimeOffset":0,"duration":8.09954648526077,"slideTitle":"スライド #1605","title":"シーン 1605","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1605_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image70.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1605.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"アリスが車を停めに行っている間、僕はチェックインの手続きを済ます。そして、ロビーのソファで休んでいる二人の元に戻る。","id":"D9815266-E6BA-4479-9345-DDADD6B422BE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.09954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image70.jpeg","bgmStartTimeOffset":0,"duration":8.573469387755102,"slideTitle":"スライド #1606","title":"シーン 1606","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1606_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image70.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1606.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が二人の元に来ると、ここまでの道中やホテルに対する感想を呟いていた。「お昼ご飯までは、休憩の時間にしますか？」","id":"1583DB7E-D16B-440A-B639-7C1899A929A0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.573469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image70.jpeg","bgmStartTimeOffset":0,"duration":1.4265079365079365,"slideTitle":"スライド #1607","title":"シーン 1607","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1607_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image70.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1607.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そうしようかな…」","id":"A72A05D2-F86B-4C6F-971D-B137A16ABE7D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.4265079365079365},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image70.jpeg","bgmStartTimeOffset":0,"duration":2.9151927437641723,"slideTitle":"スライド #1608","title":"シーン 1608","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1608_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image70.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1608.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「私も、こいしと同様に休憩の時間を取りたいです…」","id":"88A74022-F733-44B6-9361-F95E34A4EF8E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.9151927437641723},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image70.jpeg","bgmStartTimeOffset":0,"duration":8.366938775510205,"slideTitle":"スライド #1609","title":"シーン 1609","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1609_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image70.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1609.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました…」僕たちがそう話していると、アリスがやってくる。それから、僕たちは、今日から泊まる4人部屋に移動した。","id":"58F43CA7-2085-47AD-A48B-00C1F1B9F942","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.366938775510205},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":8.420204081632653,"slideTitle":"スライド #1610","title":"シーン 1610","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1610_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1610.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちがそれから、泊まる部屋にやってくると、その部屋は和洋折衷の4人部屋だった。すると、後ろから驚きの声がする。","id":"DE0BF45A-4B13-4111-93CE-9DC8FF79D476","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.420204081632653},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":9.623469387755103,"slideTitle":"スライド #1611","title":"シーン 1611","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1611_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1611.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ここは、4人部屋で、ベッドが2つに、布団が2つある部屋ですよ。それで、誰がベッドを使いますか？」僕はそう、3人に聞く。","id":"CFF5375F-F435-4465-ABFC-7138EAC250DE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.623469387755103},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":1.6573015873015873,"slideTitle":"スライド #1612","title":"シーン 1612","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1612_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1612.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私は、どっちでもいいわよ。」","id":"91D075FA-88BC-4BEA-919E-85274256B31C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.6573015873015873},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":2.3685034013605444,"slideTitle":"スライド #1613","title":"シーン 1613","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1613_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1613.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私は、ベッドがいいな…。」","id":"0A011712-667E-42A8-8D81-ACA5F55C7049","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.3685034013605444},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":2.266984126984127,"slideTitle":"スライド #1614","title":"シーン 1614","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1614_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1614.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「私は、紅夢さんの意見に合わせますよ。」","id":"3403E1F7-DBB2-44CA-A71A-A703650961C4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.266984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":5.977823129251701,"slideTitle":"スライド #1615","title":"シーン 1615","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1615_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1615.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それじゃあ、ベッドはこいしさんとさとりさん、\n布団で寝るのは、僕とアリスさんで構いませんか？」","id":"35DCD35F-B522-425E-93AE-953ADEFB9BE6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.977823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":6.835419501133787,"slideTitle":"スライド #1616","title":"シーン 1616","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1616_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1616.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそう言うと、3人は頷き、その通りになった。\n「それで、アリスさんは、これからどうしますか？」","id":"0C6728FB-AE21-4BA5-9768-ECBCBDB12E3E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.835419501133787},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":2.8740362811791385,"slideTitle":"スライド #1617","title":"シーン 1617","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1617_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1617.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「特にやりたいこともないわよ…、何か計画でもあるの？」","id":"32BFC6F7-438E-4D99-8DA7-D638D5E0DA55","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.8740362811791385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":8.147369614512472,"slideTitle":"スライド #1618","title":"シーン 1618","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1618_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1618.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、少しばかし考え込む。こいしとさとりが休んでいる間に、アリスと出かけてもいいのかな…と。","id":"E1BD112C-923B-409C-B70B-251117041AEC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.147369614512472},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":4.625396825396826,"slideTitle":"スライド #1619","title":"シーン 1619","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1619_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1619.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私たちのことは、今は気にしなくていいよ、紅夢。」","id":"85C16318-6B2D-4714-9A30-3DD093AB4324","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.625396825396826},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":7.743038548752835,"slideTitle":"スライド #1620","title":"シーン 1620","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1620_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1620.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…、少しばかし昼食のタイミングが遅くなるかもしれませんが、それで、大丈夫なら…、提案できますけど…。」","id":"F982BA4D-DDFD-49C7-9FB2-D776D194075F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.743038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":1.0300907029478459,"slideTitle":"スライド #1621","title":"シーン 1621","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1621_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image71.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1621.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「分かった…。」","id":"55CAE98F-F4E8-49CF-9834-D3C950EA77CF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.0300907029478459},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image71.jpeg","bgmStartTimeOffset":0,"duration":5.243038548752835,"slideTitle":"スライ