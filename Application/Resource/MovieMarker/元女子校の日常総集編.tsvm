ration":6.314489795918368},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.58798185941043,"slideTitle":"スライド #1010","title":"シーン 1010","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1010_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1010.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり驚き後ろ手.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「フラン、よく聞いて、ちょうだい。今すぐに、彼を探して。だけど、日付が変わる前に見つけ出せなかったら、報告して。」","id":"A647C833-21F4-4BC8-8B0B-62032B7A70A3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.58798185941043},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":4.978231292517007,"slideTitle":"スライド #1011","title":"シーン 1011","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1011_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1011.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「分かった…」私は通話を切ると、彼の姿を探し始めた。","id":"62C3DA00-394A-4D68-AD9D-34DC7453B763","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.978231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":9.259342403628118,"slideTitle":"スライド #1012","title":"シーン 1012","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1012_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1012.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「はぁ、はぁ。」僕は、荒い息をしながら、森の中を彷徨った。\nすると、先ほど蘇った過去が頭の中で勝手に流れる。","id":"B3D0EB06-3A0C-4C28-B9CC-6DFFF1E300C3","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.259342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":2.909342403628118,"slideTitle":"スライド #1013","title":"シーン 1013","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1013_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1013.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕の意識は、あと少しで吹き飛びそうだった。","id":"61D8F8D0-5453-41A3-9D6F-94636BBFB805","seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.909342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":8.869478458049887,"slideTitle":"スライド #1014","title":"シーン 1014","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1014_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1014.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、どこにいるの？聞こえたら返事して…」私は、暗い夜の森でそう呼びかけながら、彼の姿を探す。","id":"5A7BC55E-E2D2-4CCC-9A5D-D9603DA67BAE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.869478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":8.866984126984127,"slideTitle":"スライド #1015","title":"シーン 1015","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1015_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1015.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢？どこにいるの？」私は、だんだんと早足になるのを自覚しながら、彼の姿を必死に探し出す。","id":"E0DA0A73-3EE1-4B98-A552-FF365A62009F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.866984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":8.991950113378685,"slideTitle":"スライド #1016","title":"シーン 1016","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1016_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1016.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その攻撃に抵抗しながら、意識が切れないようにする。\nだが、僕ができる唯一の対抗策は、ひたすら逃げるだけだった。","id":"CB1A4EE9-0943-40A7-AE7C-AE25A82677C4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.991950113378685},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":6.509342403628118,"slideTitle":"スライド #1017","title":"シーン 1017","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1017_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1017.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、それも長くは続かず、僕は何か躓くと、\nこけてしまい、そのまま意識が落ちていった。","id":"7F987404-6C90-4BA9-A22F-EFD817B19B3A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.509342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":10.819478458049886,"slideTitle":"スライド #1018","title":"シーン 1018","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1018_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1018.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"私は、彼の姿を探しながら、ポケベルの時間を確認する。時刻は、午後9時だった。彼が席を外してから数時間だった。","id":"26B973CE-95E7-4A03-81F2-B8038C3E3ED7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.819478458049886},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":10.181995464852609,"slideTitle":"スライド #1019","title":"シーン 1019","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1019_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1019.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、どこにいるの…」私は、気がつけば、木々の合間を縫うように走りながら、彼を探していた。だが、まだ見つからない。","id":"1999C7AE-ECF7-4AA7-BFDA-41FECA2E19B5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.181995464852609},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":10.608231292517006,"slideTitle":"スライド #1020","title":"シーン 1020","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1020_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1020.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"そして、ふとポケベルの時間を確認する。あと数十分で日付が変わるところだった。だが、私は時間を気にせず、彼を探す。","id":"0342EEB9-1872-417F-A229-FBDC7FC95BA7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.608231292517006},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":7.436507936507937,"slideTitle":"スライド #1021","title":"シーン 1021","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1021_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1021.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「んっ…」僕は、ふと目が覚めて、周りを見る、するとそこには、こっちを見ながら、不気味に笑う彼女がいた。","id":"7C800023-4979-4098-9101-B28403A7C662","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.436507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":1.166938775510204,"slideTitle":"スライド #1022","title":"シーン 1022","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1022_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1022.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「フラン…さん…？」","id":"18ADE73C-3C3D-4675-AD3F-1E5BA3569B7C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.166938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":1.0844897959183672,"slideTitle":"スライド #1023","title":"シーン 1023","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1023_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1023.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「見ーつけた。」","id":"00481839-0F16-4C7E-B1E3-4861906D9EC4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.0844897959183672},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":9.173469387755102,"slideTitle":"スライド #1024","title":"シーン 1024","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1024_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1024.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女の気配から、直感的に、次の行動を予測する。\nそして、彼女とは反対方向に、回転し、立ち上がる。","id":"0316E3C2-D553-4F4A-8297-E061A5D7F4EB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.173469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":7.651723356009071,"slideTitle":"スライド #1025","title":"シーン 1025","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1025_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1025.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女がこちらに襲いかかるタイミングで、背後に回り、\n腕に力を込めると、それを彼女の首筋に当てる。","id":"5FE406CE-975B-4514-8D22-6E5FD6B7D7F7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.651723356009071},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":3.577823129251701,"slideTitle":"スライド #1026","title":"シーン 1026","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1026_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1026.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女は何かを言いながら、その場に倒れ込む。","id":"55E2C3E8-BD37-4DF5-92E0-E7A28A20F1A7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.577823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":7.95281179138322,"slideTitle":"スライド #1027","title":"シーン 1027","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1027_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1027.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕は、今何をしたのかを理解すると共に、再び頭痛に晒されて、彼女に被さるように倒れ込むのだった。","id":"52097CA3-561E-4BC1-A06B-AB2F5FDAB7EE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.95281179138322},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":7.487981859410431,"slideTitle":"スライド #1028","title":"シーン 1028","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1028_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1028.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり驚き後ろ手.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私は、フランに電話をしたあと、ずっとそわそわしていた。そして、ふと時計を見ると、時刻は真夜中を指していた。","id":"43BE62E9-CDAC-4874-B3F2-BFAD8761F8F3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.487981859410431},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","bgmStartTimeOffset":0,"duration":8.454081632653061,"slideTitle":"スライド #1029","title":"シーン 1029","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1029_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc107556_紅魔的館内.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1029.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア壊れたにやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「フラン、今から、私がそっちに向かうから、待ってなさい。」\n私は、そう言い、家を離れ、その場所に飛んで向かうのだった。","id":"E5ABD91A-2446-4490-A099-935C6EA0ACF0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.454081632653061},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1030","title":"シーン 1030: おまけ","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1030.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"おまけ","id":"E0A3982D-74D9-482C-85E4-098BB1E08A1E","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","bgmStartTimeOffset":0,"duration":3.797482993197279,"slideTitle":"スライド #1031","title":"シーン 1031","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1031_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1031.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/にやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"「あの…お二人さん…こんな時間に、俺のベッドで何を…」","id":"DDE935B6-4937-4FAB-A1F4-9E599381D63A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":3.797482993197279},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","bgmStartTimeOffset":0,"duration":2.1294784580498867,"slideTitle":"スライド #1032","title":"シーン 1032","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1032_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1032.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「魔理沙、準備はいいわね。」","id":"F931AC83-6099-4B30-9ED3-C824F0B55DA6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":2.1294784580498867},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","bgmStartTimeOffset":0,"duration":2.4544897959183674,"slideTitle":"スライド #1033","title":"シーン 1033","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1033_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1033.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/にやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「ああ、もちろんだぜ、霊夢。」","id":"2D52D069-7556-414F-BB9F-DD9B2B896317","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":2.4544897959183674},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","bgmStartTimeOffset":0,"duration":8.04748299319728,"slideTitle":"スライド #1034","title":"シーン 1034","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1034_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1034.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/にやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"二人は、何かの確認をすると、いきなり私の服を掴んでくる。\nそして、まんまと服を脱がされると、二人も服を脱ぐ。","id":"91FCA1F7-7374-4500-B1B7-F3B2B04703CA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":8.04748299319728},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","bgmStartTimeOffset":0,"duration":8.407913832199547,"slideTitle":"スライド #1035","title":"シーン 1035","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1035_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1035.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"そして、霊夢が私のベッドで、上を向いたまま横になると、魔理沙が私の手を引っ張り、霊夢、魔理沙、私の順で重なる。","id":"CD4349CD-406A-48A3-8ADC-613A4BF03642","seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":8.407913832199547},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝室の窓際のベッド（夜・月明り・青）.jpg","bgmStartTimeOffset":0,"duration":3.527687074829932,"slideTitle":"スライド #1036","title":"シーン 1036","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1036_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1036.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"そして、私は、魔理沙にアレを根こそぎ取られるのだった。","id":"13EC1E34-1CDD-4685-B025-406B9424DB93","seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":3.527687074829932},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":3.733832199546485,"slideTitle":"スライド #1037","title":"シーン 1037","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1037_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1037.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私は、二人がいるキャンプ場に来ると、森の中に入る。","id":"5ACBD1FD-4135-4A5A-AC3D-70108147C01F","seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.733832199546485},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":3.7588208616780046,"slideTitle":"スライド #1038","title":"シーン 1038","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1038_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1038.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"そして、私は、森の中にいるはずの二人を探し回る。","id":"495B9991-68F9-4175-BF00-4E0470922AE3","seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.7588208616780046},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":7.035895691609977,"slideTitle":"スライド #1039","title":"シーン 1039","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1039_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1039.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"すると、二人が重なって倒れているのを発見する。\n「見ーつけた。」私はそう言うと、二人に襲いかかる。","id":"A0AC717C-57A9-4A75-A97B-5CEB053B7D2B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.035895691609977},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":4.300498866213152,"slideTitle":"スライド #1040","title":"シーン 1040","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1040_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1040.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私は、今まさに、二人に襲いかかると、急に彼が目覚める。","id":"90DCAA59-D8AD-4327-B344-8F2FC9BCBC9B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.300498866213152},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image56.jpeg","bgmStartTimeOffset":0,"duration":8.974897959183673,"slideTitle":"スライド #1041","title":"シーン 1041","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1041_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image56.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1041.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私は、一瞬フリーズしたように固まると、彼が一瞬で消え、首筋に、鋭い衝撃が入り、そのまま気を失い、倒れるのだった。","id":"29DB718C-1B96-4AA8-A3C4-316AA5E53491","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.974897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":5.037596371882086,"slideTitle":"スライド #1042","title":"シーン 1042","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1042_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1042.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「んっ…」僕は、ふと目が覚めると、\nそこは朝日が差し込む森の中だった。","id":"DF9E2DAD-6E56-4F8D-9499-F61A972C0D46","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.037596371882086},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":7.395215419501134,"slideTitle":"スライド #1043","title":"シーン 1043","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1043_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1043.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、ふと体を回転させて、起き上がると、そこには、ぐったりと重なるように倒れているフランとレミリアがいた。","id":"68D74642-F477-4885-B759-C9854495C37C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.395215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":2.626734693877551,"slideTitle":"スライド #1044","title":"シーン 1044","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1044_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1044.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、二人をそっと、回転させる。","id":"8125C297-417A-4E5F-8843-72583DAA2D77","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.626734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":3.838684807256236,"slideTitle":"スライド #1045","title":"シーン 1045","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1045_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1045.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、二人から声が出ると共に、だんだんと目が覚める。","id":"2024118B-1313-48A4-8494-5098D3D10F29","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.838684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","bgmStartTimeOffset":0,"duration":2.2191156462585035,"slideTitle":"スライド #1046","title":"シーン 1046","animationName":"なし","voic