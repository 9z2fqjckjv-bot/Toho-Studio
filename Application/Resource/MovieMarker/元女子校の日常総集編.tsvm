port\/TohoStudio\/GeneratedAudio\/Slide_177_藤原妹紅.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","telop":"「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」","voiceCharacter":"藤原妹紅","duration":6.796439909297052,"title":"シーン 177","slideTitle":"スライド #177","characterName":"藤原妹紅","audioTrack":"track_voice_char_DF97","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.177.jpeg","voiceDuration":6.796439909297052,"seVolume":1},{"id":"2BE13389-CC72-4F9B-89D1-D019FDE03DFD","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅やれやれ.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_178_藤原妹紅.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","telop":"「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」","voiceCharacter":"藤原妹紅","duration":7.026666666666666,"title":"シーン 178","slideTitle":"スライド #178","characterName":"藤原妹紅","audioTrack":"track_voice_char_DF97","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.178.jpeg","voiceDuration":7.026666666666666,"seVolume":1},{"id":"29F31700-5D3B-44A6-9488-4E327DE2C221","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（笑い）.png","transitionName":"なし","v