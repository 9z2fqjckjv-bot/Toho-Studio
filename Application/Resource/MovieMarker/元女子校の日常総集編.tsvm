15.jpeg","voiceDuration":4.394489795918368,"seVolume":1},{"id":"966991A5-09C2-4F92-AFFA-A9A811851854","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/博麗霊夢_困った笑み.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_716_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「何なの、伝言って？」私はそう言って、耳を立てて聞く。","voiceCharacter":"博麗霊夢","duration":5.209478458049887,"title":"シーン 716","slideTitle":"スライド #716","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.716.jpeg","voiceDuration":5.209478458049887,"seVolume":1},{"id":"463F6FD3-CE3E-40CE-A7E0-4C20E1F797FE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_717_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「気を悪くしたのなら、すまない。これが、私が考えられる最善策と彼のための言葉なんだ。だから、彼にそう伝えてくれ。」","voiceCharacter":"霧雨魔理沙","duration":10.514489795918367,"title":"シーン 717","slideTitle":"スライド #717","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.717.jpeg","voiceDuration":10.514489795918367,"seVolume":1},{"id":"7A40D6A7-924E-4A19-907D-58F8406B00B6","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖顔２.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_718_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"「そう、それじゃあ、またお見舞いに来るわ。」\n私はそう言うと、勤務地に向かっていった。","voiceCharacter":"博麗霊夢","duration":6.833242630385487,"title":"シーン 718","slideTitle":"スライド #718","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.718.jpeg","voiceDuration":6.833242630385487,"seVolume":1},{"id":"ABC0C1AB-D94F-4886-9A52-90740A3A406E","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_719_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"レミリアの突如の訪問から始まった引っ越し作業は、なんとか1日で完了し、今は、フランと僕の二人部屋で休んでいた。\n東方Project二次創作作品\n第11話","voiceCharacter":"操夢","duration":8.175646258503402,"title":"シーン 719","slideTitle":"スライド #719","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.719.jpeg","voiceDuration":8.175646258503402,"seVolume":1},{"id":"296FC1D5