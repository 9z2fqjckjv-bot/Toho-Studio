ository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.167.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私が家に帰ってくると、すでに夫がリビングにいた。","id":"DE8E1887-E4C5-4568-BF52-6110A6EC3A75","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":4.031995464852607},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":6.243333333333333,"slideTitle":"スライド #168","title":"シーン 168","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_168_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.168.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"「霊夢、お前その顔どうした？」\n私は、彼女が泣いた後の表情をしていたのでそう問いかける。","id":"0AB3B3D5-63C9-4D89-8F68-59CBB1819387","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":6.243333333333333},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":4.3644897959183675,"slideTitle":"スライド #169","title":"シーン 169","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_169_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.169.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「そんなことどうだっていいわ、それより、夕飯は食べたの？」","id":"2E26905B-000C-44AA-B1CC-DF469E8FB128","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":4.3644897959183675},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":3.26,"slideTitle":"スライド #170","title":"シーン 170","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_170_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.170.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」","id":"413D2B3B-CB22-4749-B2F5-7AF80E774013","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":3.26},{"voice2StartTimeOffset":3.3869841269841268,"telop":"「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。","seVolume":1,"characterName":"博麗霊夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（困る）.png","voiceDuration":3.3869841269841268,"voiceCharacter":"博麗霊夢","audioTrack":"track_voice_reimu","animationName":"なし","seStartTimeOffset":0,"backgroundIm