dioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1783_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1783.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女がこいしに手を伸ばすと、押さえ込んでいたものが浮き上がり、意識が途切れると、彼女に襲いかかった。","id":"6C93C268-7E1A-4A7F-90D3-4A7071DA2200","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.283242630385487},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1784","title":"シーン 1784: 八意永琳（主人公の担当医）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1784.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳.psd","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"八意永琳（主人公の担当医）","id":"E81D6DF1-4D43-4C93-9C36-8083BB15B0C3","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":10.28,"slideTitle":"スライド #1785","title":"シーン 1785","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1785_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1785.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/弱った寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、ふと気がつくと、そこには服が敗れた状態で、寝ているさとりの姿があった。そして、部屋の隅には、泣きながら眠るこいしの姿があった。","id":"83B873DB-4C4C-4DB0-ACE4-7F9A4CB700B2","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":10.28},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":9.038684807256235,"slideTitle":"スライド #1786","title":"シーン 1786","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1786_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1786.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/弱った寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それを頭で理解すると同時に、とてつもない恐怖心に襲われ、そのままずるずると後ずさる。すると、部屋の扉が開く。","id":"F7D0DF5B-DDFA-451F-9C61-A2A1F9CC840A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.038684807256235},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":8.294126984126985,"slideTitle":"スライド #1787","title":"シーン 1787","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1787_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1787.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア壊れたにやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がその扉の方に振り向くと、そこには怖い笑みを浮かべるフランとレミリアの姿があった。僕は、反射的に後ろに下がる。","id":"B4CF157A-97E3-4A08-9E91-E22AE77DC5D3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.294126984126985},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":9.399546485260771,"slideTitle":"スライド #1788","title":"シーン 1788","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1788_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1788.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア壊れたにやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、僕の足に何かが当たる。そして、僕は挟み撃ちになっていることに気がつく。だが、金縛りにあったように手足が動かせない。","id":"6C686111-2381-4443-8705-2DB2A4900E69","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.399546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":7.886507936507937,"slideTitle":"スライド #1789","title":"シーン 1789","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1789_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1789.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア壊れたにやけ顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、フランたちが今、まさに襲い掛かろうとした瞬間に、\nぷつりと何かが切れ、僕は、何かに意識を奪われた。","id":"91B828C2-3DFB-4553-BAC8-7B38362BD868","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.886507936507937},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1790","title":"シーン 1790: 摩多羅隠岐奈（学園長）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1790.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子のみ微笑.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"摩多羅隠岐奈（学園長）","id":"0CF7E7AE-EC51-483D-8544-F47C522439FD","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":7.669115646258503,"slideTitle":"スライド #1791","title":"シーン 1791","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1791_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1791.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「んっ…」僕はふと目が覚めると、窓からは朝日が差し込んでいた。そして、ある違和感に気がつき、ベッドを降りる。","id":"F89EE094-2656-4E33-A667-B5B92132BE99","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.669115646258503},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.4039002267573695,"slideTitle":"スライド #1792","title":"シーン 1792","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1792_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1792.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると地べたでは4人の女性が目覚めていた。「えっ？」","id":"3D6DA21E-827F-4A4A-87EC-9BECECB125AF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.4039002267573695},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":9.314761904761905,"slideTitle":"スライド #1793","title":"シーン 1793","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1793_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1793.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそう呟くと、その4人は皆、困った表情をする。僕はそこで、昨晩の記憶を思い出そうとするが、一部分が欠けていた。","id":"37D76393-52FD-43F4-95BF-791357E4DEF3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.314761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":2.3052834467120182,"slideTitle":"スライド #1794","title":"シーン 1794","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1794_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1794.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あの…私、昨日何してましたっけ…？」","id":"7516623A-69F5-43FB-8AB1-67B01FF48C2A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.3052834467120182},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":6.3408616780045355,"slideTitle":"スライド #1795","title":"シーン 1795","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1795_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1795.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私も…昨日、夕飯食べて、\nこの部屋に来たあたりから思い出せない…」","id":"98CACF71-AB28-4756-A389-508C6F972659","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":6.3408616780045355},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.979478458049886,"slideTitle":"スライド #1796","title":"シーン 1796","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1796_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1796.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「私は…、夕飯食べた後は、たしかお姉様と話し込んでて…」","id":"B1BE7DDD-117C-4429-9C20-C92FEED9025A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.979478458049886},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.600498866213152,"slideTitle":"スライド #1797","title":"シーン 1797","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1797_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1797.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「私は…フランと、私の部屋で、確かに、話し合っていたわ…」","id":"C53077FB-5A08-4484-828E-948D069AC6A9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":4.600498866213152},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.8629931972789118,"slideTitle":"スライド #1798","title":"シーン 1798","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1798_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1798.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「とりあえず、身だしなみを整えて、朝食を食べましょうか…」","id":"02F879F3-376B-474C-A3C1-353E1B12FC4D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.8629931972789118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":8.196303854875284,"slideTitle":"スライド #1799","title":"シーン 1799","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1799_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1799.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝起き顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"レミリアがそう呟くと、僕たちも賛同し、各自が諸々を済ませると、食堂に集まり、朝食の時間になるのだった。","id":"87B1F44A-C540-4597-B5C2-D74BE34FD1B0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.196303854875284},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1800","title":"シーン 1800: 射命丸文（学園の国語科教師）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1800.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文ルイポスター寝起き.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"射命丸文（学園の国語科教師）","id":"A285FEE4-0907-4BFC-8B19-AD25B1BB20BA","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.10390022675737,"slideTitle":"スライド #1801","title":"シーン 1801","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1801_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1801.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが朝食を済ますと、女性4人は、例の発表でいろいろ言いたいことを思い出したのか、4人だけで話し合いを始めた。","id":"A7706078-C4C6-42DE-AD87-CC2EF55802FC","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.10390022675737},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":6.00172335600907,"slideTitle":"スライド #1802","title":"シーン 1802","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1802_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1802.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、暇つぶしがてら、図書館に来た。\nそして、適した本がないかどうかを探す。","id":"A2044BE7-5AAA-46E9-8734-AB7421728DA0","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.00172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","bgmStartTimeOffset":0,"duration":7.864761904761905,"slideTitle":"スライド #1803","title":"シーン 1803","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1803_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1803.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、ある本棚が僕を導いているように感じ、その本棚を見渡すと、魔法に関する本が、たくさん置かれていた。","id":"EE3D6B85-72B9-4162-836E-57BC1FD22542","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.864761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","bgmStartTimeOffset":0,"duration":8.654988662131519,"slideTitle":"スライド #1804","title":"シーン 1804","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1804_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1804.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、ある本を手に取ってみる。その本は著者の欄に、とある魔法使いと書かれていた。タイトルは魔法使い入門編だった。","id":"46F5DD6E-AB34-4617-B3A9-938F657175AD","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.654988662131519},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","bgmStartTimeOffset":0,"duration":8.712607709750566,"slideTitle":"スライド #1805","title":"シーン 1805","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1805_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1805.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はその本を持ってくると、以前に使っていたスペースにある椅子に座り、その本を開く。そして、最初のページから読み始めた。","id":"66661D3D-ED6D-448E-9997-C9955197532F","seVolume":1,"voiceChara