7fe1ac7.641.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"二人が家に着くと…","id":"57C7E545-5DE4-4E46-A371-8126406A5474","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":10.068231292517007,"slideTitle":"スライド #642","title":"シーン 642","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_642_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.642.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」","id":"F9705DCC-4B31-43DD-8C88-B804AB7E1364","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.068231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（夜・照明OFF）.jpg","bgmStartTimeOffset":0,"duration":9.304489795918368,"slideTitle":"スライド #643","title":"シーン 643","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_643_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（夜・照明OFF）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.643.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手すやすや頬照り寝顔.pxd","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"そして、そっと息子の部屋の扉を開けて、中を覗く。すると、彼女が言っていた女性が、スヤスヤとベッドで寝ていた。","id":"1EC2E275-D306-40AD-A2A5-AD508A8503CE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.304489795918368},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":10.769478458049887,"slideTitle":"スライド #644","title":"シーン 644","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_644_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.644.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝顔３.pxd","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"そして、私と彼の部屋に入ると、紅夢がベッドの片方で寝ていた。私は、それを確認すると、リビングで待つ彼女の元に戻る。","id":"E4877A39-91FD-4B41-8746-4DF3A27B1AD5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.769478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.560907029478458,"slideTitle":"スライド #645","title":"シーン 645","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_645_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.645.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「それで、各部屋の様子はどうでしたか？」","id":"E2645B09-1AE8-4045-921C-D5B515E392EB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.560907029478458},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.745238095238095,"slideTitle":"スライド #646","title":"シーン 646","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_646_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.646.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「あなたに指摘された通りです。それで…本当に私の息子の許嫁に妹さんをもらって大丈夫でしょうか？」","id":"EA07E2F2-D744-41B7-AA04-47AFB78EAC54","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":8.745238095238095},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.6713151927437644,"slideTitle":"スライド #647","title":"シーン 647","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_647_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.647.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「ええ、妹がきっとそれを望みますから…。」","id":"1E97E673-A385-4CDE-8EB4-9A9DF2E2DC1C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.6713151927437644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.714489795918367,"slideTitle":"スライド #648","title":"シーン 648","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_648_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.648.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「建設会社の方は、後継者はいるのですか？」","id":"C5E546C4-411F-49FB-B845-38C1268F4AB8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":3.714489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.0629931972789115,"slideTitle":"スライド #649","title":"シーン 649","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_649_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.649.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「後継者は今は、いませんが…、それが何か？」","id":"D62C04B8-C543-4299-AB6A-77B154657285","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.0629931972789115},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":9.547732426303854,"slideTitle":"スライド #650","title":"シーン 650","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_650_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.650.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私は、息子の事情を話すべきか迷う、だが、ここで話しておかないと後々大変になるのは目に見えていた。「実は…」","id":"92F60068-FEAF-4D47-AE35-F0D6CC5008B7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.547732426303854},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":2.556734693877551,"slideTitle":"スライド #651","title":"シーン 651","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_651_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.651.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/後ろ手驚く.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"私は、彼女の話にとても驚く。","id":"B72C80F2-7E53-438C-A9C2-52223957F18C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.556734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.556734693877551,"slideTitle":"スライド #652","title":"シーン 652","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_652_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.652.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「そうですか…」私は、このままでは養子を迎え入れるか、企業合併以外の選択肢しか残されない事実に考え込む。","id":"1BC9DB34-769C-4FB5-BA8B-97E7CBC7A07F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.556734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":3.615079365079365,"slideTitle":"スライド #653","title":"シーン 653","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_653_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.653.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「承知しました…。それでもう一つお願いがあるのですか…」","id":"1DFD95BE-E0F4-4D0A-9CC9-EF9AC91CF3DF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.615079365079365},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":11.094489795918367,"slideTitle":"スライド #654","title":"シーン 654","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_654_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.654.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私はその内容に驚く。そして考えこむ。それから数分程度の間の後、告げる。「それでは、息子の今後については頼みます。」","id":"F5D39567-5306-4498-841A-74BC0B9986BA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":11.094489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.190068027210884,"slideTitle":"スライド #655","title":"シーン 655","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_655_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.655.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「私からの二つの願いに答えていただき、ありがとうございます。このご恩は、近いうちに必ずお返しします。」","id":"4C226C6E-AC71-4F4C-9EA4-FB494F490D98","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.190068027210884},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":9.123242630385487,"slideTitle":"スライド #656","title":"シーン 656","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_656_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.656.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"彼女はそういうと、家を去っていった。私は、「はぁ…」吐息を吐くと、そのまま入浴を済ませて、寝室に向かう。","id":"43DF5E5A-F15F-41D8-9262-01D2ACCADB04","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.123242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":9.803242630385487,"slideTitle":"スライド #657","title":"シーン 657","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_657_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.657.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝顔３.pxd","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"そして、部屋にそっと入って気づく。「今日は久々の添い寝ね…」私はそう呟きながら、彼の横に入り、寝付くのだった。","id":"6F92EA54-35D6-4E2D-ACA0-967538EB4321","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.803242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.341995464852608,"slideTitle":"スライド #658","title":"シーン 658","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_658_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.658.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ねぇ、私と一緒に、大人の体験、してみない？」","id":"7FAC1784-9162-4483-8CEB-658ACEFAD10B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.341995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":1.2147619047619047,"slideTitle":"スライド #659","title":"シーン 659","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_659_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.659.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「大人の体験？」","id":"1E84D814-090C-470F-9F2E-6BB904C1BD14","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.2147619047619047},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":5.159478458049887,"slideTitle":"スライド #660","title":"シーン 660","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_660_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.660.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「うん、そう、私が導いてあげる、だから私に身を委ねて。」","id":"3B6E8D8D-18BE-464B-BF4D-820D7E0A6B41","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.159478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.814761904761905,"slideTitle":"スライド #661","title":"シーン 661","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_661_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.661.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、息を吐きながら、脱力する。\nすると、彼女が僕の背中に手を回し、唇をそっとくっつける。","id":"7BB4B9CE-BEDB-4A2B-8E89-6550DC3AFCF5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.814761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.008253968253968,"slideTitle":"スライド #662","title":"シーン 662","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_662_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.662.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女が僕の手を握り、そっと彼女の胸に当てる。","id":"E596832C-F077-4384-AEF2-B761C577AEA1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.008253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":4.174489795918367,"slideTitle":"スライド #663","title":"シーン 663","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_663_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.663.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「ほら、どう先生のーは？大きい？小さい？」","id":"B1F3A482-FA54-4F79-8F0E-0E31918315F4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.174489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":7.469115646258503,"slideTitle":"スライド #664","title":"シーン 664","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_664_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.664.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…僕は、どっちでも大丈夫ですよ…」僕は、どこかふわふわしたような、だが確かに感じるその感触を味わう。","id":"60D4146A-B039-4330-B9CE-4F0881115327","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.469115646258503},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":10.384489795918368,"slideTitle":"スライド #665","title":"シーン 665","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_665_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.665.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"私は、彼に自らの胸を触らせた後、そっと彼の頭を胸に埋める。\n「ほら、もっと力を抜いて…、リラーックス、リラーックス。」","id":"0B5D8F84-3D2D-4A95-A8C6-E0FA176CF604","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.384489795918368},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":8.60063492063492,"slideTitle":"スライド #666","title":"シーン 666","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_666_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.666.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/夜のお誘い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言いながら、僕の服をそっと掴む。僕は、それに気づかずに、ふわふわしながら感じる感触に身を任せるのだった。","id":"881902CB-6332-413A-A636-E9660A5A80A8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.60063492063492},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #667","title":"シーン 667: 一方、霊夢は…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.667.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"一方、霊夢は…","id":"891BA6C6-643D-488D-983D-4FB246F83BDD","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":6.178730158730159,"slideTitle":"スライド #668","title":"シーン 668","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_668_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.668.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ぐち.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"「だからよ…」私は、そう妻である彼女に、\n仕事終わりの飲み会での愚痴をお酒片手に話す。","id":"54BBBE9B-DED1-423C-8C4A-75E7961274B9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":6.178730158730159},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":7.921995464852608,"slideTitle":"スライド #669","title":"シーン 669","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_669_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.669.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/酔った顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「どうしたの、あなた、急に黙り込んで？」\n私が、そう彼に問いかけると、急に抱きついてくる。","id":"05C51A86-96B7-4BFE-9101-380579C3ABD3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":7.921995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":6.392290249433106,"slideTitle":"スライド #670","title":"シーン 670","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_670_藤原妹紅.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.670.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/やる.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_DF97","characterName":"藤原妹紅","telop":"「だから、今晩は朝までーだぞ、霊夢。」\n私は、そういうと、彼女に襲い掛かるのだった。","id":"A234F3BB-E975-439F-BD45-949366CB115F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"藤原妹紅","voiceDuration":6.392290249433106},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","bgmStartTimeOffset":0,"duration":8.734331065759637,"slideTitle":"スライド #671","title":"シーン 671","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_671_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backg