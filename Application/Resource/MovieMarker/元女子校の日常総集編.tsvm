TimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_169_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","telop":"「そんなことどうだっていいわ、それより、夕飯は食べたの？」","voiceCharacter":"博麗霊夢","duration":4.3644897959183675,"title":"シーン 169","slideTitle":"スライド #169","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.169.jpeg","voiceDuration":4.3644897959183675,"seVolume":1},{"id":"413D2B3B-CB22-4749-B2F5-7AF80E774013","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_170_藤原妹紅.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","telop":"「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」","voiceCharacter":"藤原妹紅","duration":3.26,"title":"シーン 170","slideTitle":"スライド #170","characterName":"藤原妹紅","audioTrack":"track_voice_char_DF97","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.170.jpeg","voiceDuration":3.26,"seVolume":1},{"audioTrack":"track_voice_reimu","transitionName":"なし","telop":"「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。","title":"シーン 171","slideTitle":"スライド #171","voice2StartTimeOffset":3.3869841269841268,"seStartTimeOffset":0,"characterName":"博麗霊夢","bgmVolume":0.7,"duration":6.517732426303855,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.171.jpeg","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_171_博麗霊夢_2.wav","seVolume":1,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_171_博麗霊夢.wav","voiceCharacter":"博麗霊夢","voice2Duration":3.1307482993197278,"id":"3A35B4DF-1968-48AD-AAE5-0A3560449FD6","voiceDuration":3.3869841269841268,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅（困る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","voice2Character":"博麗霊夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0},{"id":"E0EB3DAF-06CF-4F6A-B81C-2876D7CBDAB0","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","telop":"霊夢がお風呂を澄ますと…","duration":3,"title":"シーン 172: 霊夢がお風呂を澄ますと…","slideTitle":"スライド #172","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.172.jpeg","seVolume":1},{"id":"528543C6-4C9A-4845-A81A-C633617C244B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/妹紅やれやれ.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_173_博麗霊夢.wav","voiceStartTimeOffset"