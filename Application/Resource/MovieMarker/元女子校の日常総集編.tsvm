Support\/TohoStudio\/GeneratedAudio\/Slide_2110_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256899_病室-夜-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","telop":"「あなたの母については、私たちが選出した後継ぎを向こうに送るから、安心しなさい。それと、学校の了承も得てるから。」","voiceCharacter":"レミリア・スカーレット","duration":8.371315192743765,"title":"シーン 2110","slideTitle":"スライド #2110","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2110.jpeg","voiceDuration":8.371315192743765,"seVolume":1},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/ちゃんちゃん♪1.mp3","id":"8EC238B7-FF63-4940-979A-9628CD92D6A5","seStartTimeOffset":6.425646258503401,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2111_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256899_病室-夜-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","telop":"「そうですか…ならいいですけど…」僕は、\n三人の説明を聞き終えると、そう言いながらハンコを押した。","voiceCharacter":"操夢","duration":6.475646258503401,"title":"シーン 2111","slideTitle":"スライド #2111","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: ちゃんちゃん♪1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2111.jpeg","voiceDuration":6.475646258503401,"seVolume":0.85},{"id":"F4A75CB3-2341-442F-9861-8A8B6DF2E4A3","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2112_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","telop":"あれから、長い年月がたち、あっという間に、僕は卒業式を迎えた。すると卒業生代表のスピーチで僕の名前が呼ばれる。","voiceCharacter":"操夢","duration":9.002380952380953,"title":"シーン 2112","slideTitle":"スライド #2112","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2112.jpeg","voiceDuration":9.002380952380953,"seVolume":1},{"id":"F154EE93-18F2-4CB7-8B65-3835337EBCCF","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2113_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","telop":"そして、僕は卒業生を代表したスピーチのために壇上を上がる。\n卒業生の列にさとり、そしてこいし、保護者席にフランがいた。","voiceCharacter":"操夢","duration":8.947369614512471,"title":"シーン 2113","slideTitle":"スライド #2113","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2113.jpeg","voiceDuration":8.947369614512471,"seVolume":1},{"id":"A1A309C3-8A93-4A38-92E0-8B5D8DC9E743","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application 