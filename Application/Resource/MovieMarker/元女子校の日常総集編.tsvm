07,"seVolume":1},{"id":"898B42B4-F4CB-40B7-8314-899A8D46115C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1413_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc283171_商店街（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","telop":"「そうですか…」私は、仕方なく納得する。","voiceCharacter":"アリス・マーガトロイド","duration":2.612108843537415,"title":"シーン 1413","slideTitle":"スライド #1413","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_char_2DB3","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1413.jpeg","voiceDuration":2.612108843537415,"seVolume":1},{"id":"93301E39-F6AA-487D-ACC9-E374AA8C5F8F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1414_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc283171_商店街（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","telop":"僕たちがそう話していると、ある交差点を通りかける。","voiceCharacter":"操夢","duration":3.4865079365079366,"title":"シーン 1414","slideTitle":"スライド #1414","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1414.jpeg","voiceDuration":3.4865079365079366,"seVolume":1},{"id":"697487E0-D749-4E29-BCF8-EC3DE82F7417","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1415_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image63.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image63.jpeg","telop":"そして、コンビニの上にあるお店に僕たちは入って行った。","voiceCharacter":"操夢","duration":3.531065759637188,"title":"シーン 1415","slideTitle":"スライド #1415","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1415.jpeg","voiceDuration":3.531065759637188,"seVolume":1},{"id":"D83910D2-6816-46EB-BBCE-BCD3274A1D97","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1416_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc307609_レストラン2.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc307609_レストラン2.jpg","telop":"僕たちが、そのお店に入っていくと、そこはファミレスだった。","voiceCharacter":"操夢","duration":3.976734693877551,"title":"シーン 1416","slideTitle":"スライド #1416","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1416.jpeg","voiceDuration":3.976734693877551,"seVolume":1},{"id":"84