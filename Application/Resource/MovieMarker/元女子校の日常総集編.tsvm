groundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1115.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっ、何も聞いてないけど…」","id":"2559E441-D27F-444D-B092-532E32DA31D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.0256462585034014},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":8.964489795918368,"slideTitle":"スライド #1116","title":"シーン 1116","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1116_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256896_病室-昼.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1116.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「念のために聞くけど、この書類にサインしたのはあんた？」\n私はそう言い、家に送られてきた婚姻届の控を出す。","id":"C56D2100-9771-446C-873C-80C72A55727C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":8.964489795918368},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","bgmStartTimeOffset":0,"duration":9.183242630385488,"slideTitle":"スライド #1117","title":"シーン 1117","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1117_操夢.wav",