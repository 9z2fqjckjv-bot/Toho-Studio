\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1956.jpeg","voiceDuration":2.9473696145124717,"seVolume":1},{"id":"47D7C822-69EA-4D69-98FE-4BD0807C831B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ不満.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1957_古明地こいし.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","telop":"「そんなことどうだっていいわ、あなたが私をその気にさせたんだから。何かあっても、絶対に責任とってよね。」","voiceCharacter":"古明地こいし","duration":9.503854875283446,"title":"シーン 1957","slideTitle":"スライド #1957","characterName":"古明地こいし","audioTrack":"track_voice_char_2B53","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1957.jpeg","voiceDuration":9.503854875283446,"seVolume":1},{"id":"A04EF022-AE51-4F3D-B25E-9F47043A221C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ頬照り赤らみ不満.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1958_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","telop":"彼女はそういうと、無理やり僕の服を脱がすのだった。","voiceCharacter":"操夢","duration":3.3484580498866214,"title":"シーン 1958","slideTitle":"スライド #1958","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1958.jpeg","voiceDuration":3.3484580498866214,"seVolume":1},{"id":"B449E82C-344B-4963-B644-2ED593A46AFE","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1959_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"「んっ…」僕は、ふと目が覚めると、窓から光が差し込んでいた。\n僕は、ふと動こうとすると、違和感に気がつく。","voiceCharacter":"操夢","duration":8.108253968253969,"title":"シーン 1959","slideTitle":"スライド #1959","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1959.jpeg","voiceDuration":8.108253968253969,"seVolume":1},{"id":"9F3FE971-B188-4E81-B812-0918AE524B81","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ寝顔.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1960_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"2026-10-25_16-14.pxd","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","telop":"そして、ふと隣を見ると、そこにはすやすや眠るこいしの姿があった。だが、僕はすぐに違和感の正体を知る。「裸…」","voiceCharacter":"操夢","duration":8.65281179138322,"title":"シーン 1960","slideTitle":"スライド #1960","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,