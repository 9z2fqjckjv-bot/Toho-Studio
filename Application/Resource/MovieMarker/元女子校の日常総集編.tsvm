dAudio\/Slide_978_操夢.wav","voice2Character":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","telop":"そこには、満点の星空が広がっていた。僕は、\nその星空を無言で、眺めていると、フランが声をかける。","voiceCharacter":"操夢","duration":7.579546485260771,"title":"シーン 978","slideTitle":"スライド #978","characterName":"操夢","audioTrack":"track_voice_soumu","voice2Duration":3.858253968253968,"bgmVolume":0.7,"voice2StartTimeOffset":3.7212925170068027,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.978.jpeg","voiceDuration":3.7212925170068027,"seVolume":1,"voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_978_操夢_2.wav"},{"id":"871AF4EF-288D-4287-ADB9-387B90D710F9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_979_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","telop":"「どう、満点の星空を見た感想は？」","voiceCharacter":"フランドール・スカーレット","duration":3.1244897959183673,"title":"シーン 979","slideTitle":"スライド #979","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.979.jpeg","voiceDuration":3.1244897959183673,"seVolume":1},{"id":"CFAD253A-5366-4ED7-8E58-192E920FA823","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_980_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","telop":"「車を数時間走らせて、やってきた価値がありますよ。」","voiceCharacter":"操夢","duration":3.7539002267573696,"title":"シーン 980","slideTitle":"スライド #980","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.980.jpeg","voiceDuration":3.7539002267573696,"seVolume":1},{"id":"30765655-AE10-4CFF-BAA9-C97FC4FFAD3E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/フラン（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_981_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","telop":"「そうでしょ。それで、ご飯食べた後は、何する？」","voiceCharacter":"フランドール・スカーレット","duration":4.411995464852608,"title":"シーン 981","slideTitle":"スライド #981","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総