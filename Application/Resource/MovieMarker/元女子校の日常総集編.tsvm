brary\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_629_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc247230_都会の街中（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc247230_都会の街中（夕方）.jpg","telop":"そして、彼女は、ある言葉を私にいう。私は、その言葉に思わず彼女を平手打ちし、なぜそんなことを言うのかと問いただす。","voiceCharacter":"博麗霊夢","duration":10.066984126984128,"title":"シーン 629","slideTitle":"スライド #629","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.629.jpeg","voiceDuration":10.066984126984128,"seVolume":1},{"id":"222E6165-036D-4D89-BDEB-96A5CBF16F71","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霧雨魔理沙7.jpg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_630_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc247230_都会の街中（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc247230_都会の街中（夕方）.jpg","telop":"すると、彼女は、謎に笑い出し、だんだんと様子が変わっていき、まるで悩みなどなかったように笑うと、ビームを出した。","voiceCharacter":"博麗霊夢","duration":9.059478458049886,"title":"シーン 630","slideTitle":"スライド #630","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.630.jpeg","voiceDuration":9.059478458049886,"seVolume":1},{"id":"A7166462-3D3F-4241-9F31-90B8955C9439","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霧雨魔理沙7.jpg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_631_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc247230_都会の街中（夕方）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc247230_都会の街中（夕方）.jpg","telop":"結果的に、私は、彼女のビームを避けて、戦うことになってしまい、だんだんと周りのビル群に影響が出始めていった。","voiceCharacter":"博麗霊夢","duration":9.473242630385487,"title":"シーン 631","slideTitle":"スライド #631","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.631.jpeg","voiceDuration":9.473242630385487,"seVolume":1},{"id":"90724341-EA95-4392-9D63-0D486E89F85E","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_632_博麗霊夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","telop":"あれから、数時間程度の間、私は彼女からのビームを避け続けていたが、それでもビームを喰らい、気づけば倒れてしまった。","voiceCharacter":"博麗霊夢","duration":9.473242630385487,"title":"シーン 632","slideTitle":"スライド #632","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.632.jpeg","voiceDuration":9.473242630385487,"seVolume":1},{"id":"EDEA6CCA-1F1E-438B-87E9-6B3A27FBC22F","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_633_博麗霊夢.wav","voiceStartTimeOffset":0,"bg