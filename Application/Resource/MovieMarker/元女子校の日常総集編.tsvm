oTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ…お兄ちゃんは海で、泳がなくてよかったの…？」","id":"308AD474-7991-4968-B46D-599F5012F290","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.28562358276644},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":7.809342403628118,"slideTitle":"スライド #1666","title":"シーン 1666","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1666_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1666.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その問いかけに衝撃を受け、時間が止まったのかと思ってしまう。それは、アリスとさとりも同じみたいだった。","id":"FAF4E430-83D6-439A-B4ED-AE958BA14FC5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.809342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":7.946303854875284,"slideTitle":"スライド #1667","title":"シーン 1667","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1667_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1667.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女は、そういうと、いきなり僕に倒れかかってくる。\n僕は、それを受け止めると、そっと、彼女を背中に背負う。","id":"37063536-D06F-412A-9D26-D8E6CEF85BE3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.946303854875284},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image74.jpeg","bgmStartTimeOffset":0,"duration":7.6223809523809525,"slideTitle":"スライド #1668","title":"シーン 1668","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1668_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image74.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1668.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（怒り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、背後からついてくる二人の機嫌が悪くなっているのを感じながら、こいしを起こさぬように、車までおんぶしていった。","id":"67DF1B5C-C254-4A42-9057-ACDE13EFCC5A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.6223809523809525},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1669","title":"シーン 1669: レミリア・スカーレット（紅魔建設代表）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1669.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリアジト涙目.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"レミリア・スカーレット（紅魔建設代表）","id":"8FB50117-6A3F-4697-95BD-28C527ED2CC0","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":8.40716553287982,"slideTitle":"スライド #1670","title":"シーン 1670","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1670_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1670.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それからホテルに戻る。そして、こいしは車内で目覚め、頬照りながら、せっせと部屋の浴室に駆け込んで行った。","id":"3FEE520D-748D-459C-B9CE-38B5E36B3281","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.40716553287982},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":3.612607709750567,"slideTitle":"スライド #1671","title":"シーン 1671","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1671_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1671.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、僕たちは、窓に差し込む夕陽を眺めていた。","id":"EA0066B1-494E-4F96-A69B-0DD9B3FB807D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.612607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":2.109024943310658,"slideTitle":"スライド #1672","title":"シーン 1672","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1672_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1672.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「それで、今晩の夕食はどうするの？」","id":"751D991A-CB97-4F99-A67B-E803D85A5C42","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.109024943310658},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":7.721292517006803,"slideTitle":"スライド #1673","title":"シーン 1673","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1673_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1673.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「今晩は、ホテル内のレストランでバイキングですよ。もちろん、お酒が飲みたいなら、ホテル内のバーにもいいですけど。」","id":"45D898FB-E7DD-4078-A214-83575BC89DBE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.721292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":2.255283446712018,"slideTitle":"スライド #1674","title":"シーン 1674","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1674_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1674.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「それって、自由にお酒が飲めるってこと？」","id":"FE1A4D2D-29A1-4F76-8480-F7D518440B35","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.255283446712018},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":7.289342403628118,"slideTitle":"スライド #1675","title":"シーン 1675","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1675_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1675.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、昨日は不意打ちでしたが、今晩は夕食後に部屋に戻る二人とアリスさんと僕で別行動の予定ですよ。」","id":"F7F955E0-9617-4E1F-97D2-29E1AA23C9D4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.289342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":2.311791383219955,"slideTitle":"スライド #1676","title":"シーン 1676","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1676_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1676.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「それだと、こいしがまた怒り出しそうだけど…」","id":"091D1715-2216-418F-BC55-1D7DFC67D854","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.311791383219955},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":7.397369614512471,"slideTitle":"スライド #1677","title":"シーン 1677","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1677_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1677.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そこで、一つ名案です。」僕はそう言いながら、ある券が入った首からぶら下げるカードケースをさとりにかける。","id":"35AA55A2-1466-4029-9337-19AC058918EE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.397369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":0.9803854875283446,"slideTitle":"スライド #1678","title":"シーン 1678","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1678_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1678.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「これは…何？」","id":"53B2CB8D-35B9-4841-A7E9-D89E4C36F426","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":0.9803854875283446},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":8.553900226757369,"slideTitle":"スライド #1679","title":"シーン 1679","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1679_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1679.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ナイトプールの利用券ですよ。その券を見せれば、最大二人まで、日付が変わるまで遊び放題なので、楽しんでください。」","id":"AB9AF462-9B94-4B8A-9F6A-2AB94273B301","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.553900226757369},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":0.5,"slideTitle":"スライド #1680","title":"シーン 1680","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1680_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1680.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「えっ？」","id":"793DBCD5-FFA0-45C7-B944-31B068955457","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":0.5},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":7.33,"slideTitle":"スライド #1681","title":"シーン 1681","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1681_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1681.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「後一つ、もしナイトプールで寝ることなく、日付が変わるまで遊び尽くしたら、僕からお祝いがあると言ってください。」","id":"D3A5861D-EF2E-4608-A0A9-E49D55F04339","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.33},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":7.266938775510204,"slideTitle":"スライド #1682","title":"シーン 1682","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1682_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1682.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ただし、事故が起きるのも嫌なので、その限度は弁えることができるように、さとりさんが彼女を見ててください。」","id":"5CB75F4B-DEAB-4841-8D0C-864444F3261F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.266938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":3.47859410430839,"slideTitle":"スライド #1683","title":"シーン 1683","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1683_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1683.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あの、いいんですか…、\n彼女がそこまであなたに甘えさせてもらっても…」","id":"FA4C1D01-D10F-431E-B8FD-1E3509763868","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.47859410430839},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":8.601723356009071,"slideTitle":"スライド #1684","title":"シーン 1684","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1684_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1684.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「彼女が、純粋に僕に甘えられるのは、この旅行までなんですから、残りの短い期間、思う存分甘えさせたくはないですか？」","id":"665F847C-CFA7-4481-863B-67A79766D9C1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.601723356009071},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":5.307891156462585,"slideTitle":"スライド #1685","title":"シーン 1685","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1685_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1685.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「分かりました…、ただ覚悟してくださいね…、彼女は人に懐くと固執しがちでヤキモチも妬きやすいので…」","id":"A3CF54FA-B276-48E7-9EE0-60658FCC7C94","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.307891156462585},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":7.282154195011338,"slideTitle":"スライド #1686","title":"シーン 1686","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1686_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1686.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それくらいできてますよ。それに、さとりさんとアリスさんも本当なら、彼女みたいに…したくはありませんか？」","id":"F32EDD81-8E09-4C1D-B922-95142CA020B9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.282154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":3.182154195011338,"slideTitle":"スライド #1687","title":"シーン 1687","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1687_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1687.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそういうと、二人とも驚いた様子を浮かべる。","id":"D32E63D2-2D9C-40B9-BF53-30C3BE709EFD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.182154195011338},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":3.2419954648526077,"slideTitle":"スライド #1688","title":"シーン 1688","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1688_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1688.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あなたには…勝てませんよ…」私は、思わずそう呟く。","id":"9C6DD649-F64F-45BE-B9DB-B618AE6E32FB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.2419954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":2.4240362811791383,"slideTitle":"スライド #1689","title":"シーン 1689","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1689_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1689.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私も、さとりさんの意見に同感ですよ…」","id":"277EE74E-86FA-4B4D-A4A5-8919966FAF0B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.4240362811791383},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image75.jpeg","bgmStartTimeOffset":0,"duration":8.661519274376417,"slideTitle":"スライド #1690","title":"シーン 1690","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1690_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image75.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1690.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕たち3人は、こいしの入浴を終えると、夕食会場に向かい、夕食を済ますと、それぞれ別行動を取るのだった。","id":"C3D68F06-1959-49F5-8D09-FC448A5F2B70","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.661519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":6.690861678004535,"slideTitle":"スライド #1691","title":"シーン 1691","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1691_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1691.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは、それから夕飯を済ますと、さとりとこいしはナイトプールに向かい、僕とアリスはバーにやってきた。","id":"0A5385D9-F4DE-483F-8E55-1398E34936D0","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.690861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":2.3201814058956916,"slideTitle":"スライド #1692","title":"シーン 1692","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1692_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1692.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「なんだか、今日は色々あって疲れちゃったわ…。」","id":"BD8189F3-D712-4990-BCD1-3C28E96E96F1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.3201814058956916},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":4.308253968253968,"slideTitle":"スライド #1693","title":"シーン 1693","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1693_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1693.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「確かに、その通りですね…。」僕は、彼女にそう返す。","id":"DF383D60-E80D-4537-8044-D286D43DA959","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.308253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":8.412607709750567,"slideTitle":"スライド #1694","title":"シーン 1694","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1694_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1694.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが、そんな話をしていると、注文したファーストドリンクがやってくる。彼女は、白ワインで、僕は〇〇〇〇を頼んだ。\n制作ソフト及び協力\nGemini\nTohoStuido","id":"B608D104-4B15-4204-A5C3-82E4F9AF97BC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.412607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":7.4136734693877555,"slideTitle":"スライド #1695","title":"シーン 1695","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1695_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1695.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、互いにやってきたグラスを持って、お互いにしか聞こえない音量で、「乾杯。」というと、ごくごくと飲む。","id":"179CA903-3CF3-4631-95C4-8DA82E2414A5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.4136734693877555},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":4.294126984126984,"slideTitle":"スライド #1696","title":"シーン 1696","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1696_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1696.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、彼女から色々な話や愚痴などを、僕は聞いていった。","id":"145E49FC-6EB3-422F-9F9A-481697C5601C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.294126984126984},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":8.210430839002267,"slideTitle":"スライド #1697","title":"シーン 1697","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1697_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1697.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（怒り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕は数時間ほど彼女の話を聞いていると、時刻は夜の9時ごろを指していた。「そろそろ、部屋に戻りますか？」","id":"762E75BB-7A5A-4635-B67A-46DEAB75A418","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.210430839002267},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":2.212879818594104,"slideTitle":"スライド #1698","title":"シーン 1698","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1698_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1698.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「確かに、そろそろ戻ったほうがいいわね…」","id":"202DAFB6-1A46-4163-BEB0-C414093E20B4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.212879818594104},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc232269_バー.jpg","bgmStartTimeOffset":0,"duration":9.688684807256235,"slideTitle":"スライド #1699","title":"シーン 1699","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1699_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc232269_バー.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1699.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女の意思を確認すると、席を立ち上がる。僕は、彼女が席を立つと、そっと手を繋ぐ。そして、部屋に向けて歩き出す。","id":"2364D15F-A7CD-495F-BF6F-28E345C5C05B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.688684807256235},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":7.968027210884354,"slideTitle":"スライド #1700","title":"シーン 1700","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1700_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1700.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが部屋に戻ったときには、まだこいしとさとりのすがたはなかった。そして、彼女は、そのまま入浴を始めた。","id":"C0B7EA17-BFC5-4938-A1E9-9E3AB79A686C","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.968027210884354},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":9.064761904761905,"slideTitle":"スライド #1701","title":"シーン 1701","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1701_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1701.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、ふと暇になり、テレビをつける。すると、テレビでは地下底国グループが突如、発表したご令嬢の今後について流れていた。","id":"155DC2A2-1E3A-4721-A02F-981B6C6F3993","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.064761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":8.193038548752835,"slideTitle":"スライド #1702","title":"シーン 1702","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1702_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1702.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それも、ご令嬢は以前から、次期グループの長に適した婿養子を取ることが決まっていて、その候補の名前は不明となっていた。","id":"AB1F6929-7F12-48B1-87FA-102503058085","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.193038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":9.236507936507936,"slideTitle":"スライド #1703","title":"シーン 1703","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1703_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1703.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、その発表では、目的人物が決まったとされ、そして、紅魔建設や学園で同タイミングでの発表から、憶測がされていた。","id":"311AE120-9D9E-46F2-8348-8B892D5D1116","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.236507936507936},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":8.49845804988662,"slideTitle":"スライド #1704","title":"シーン 1704","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1704_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1704.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、そのテレビの報道を見る限り、あくまで噂程度だった。\nそれでも、僕はなんとなく、自分の将来を不安に感じた。","id":"7A1A9DCD-60C7-43C9-9EEE-3EB37DF422E4","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.49845804988662},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":7.158253968253968,"slideTitle":"スライド #1705","title":"シーン 1705","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1705_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1705.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、報道の内容が、グールプの今までの流れとこいしやさとりが小さかった頃のことがピックアップされていく。","id":"D4D33923-7262-47AE-949B-7DE209CD5A31","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.158253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image76.jpeg","bgmStartTimeOffset":0,"duration":7.585419501133787,"slideTitle":"スライド #1706","title":"シーン 1706","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1706_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image76.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1706.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、その報道を集中して見てたからか、アリスが肩を叩くまで、彼女が入浴を終えたことに気が付かなかった。","id":"066BCF35-DF5F-4AF1-BD6D-C98CAAE23D93","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.585419501133787},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1707","title":"シーン 1707: 東風谷早苗（主人公がいるクラスの担任）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1707.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"東風谷早苗（主人公がいるクラスの担任）","id":"CE6EBF43-087E-4125-9748-A97EA0AA7757","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":7.771292517006803,"slideTitle":"スライド #1708","title":"シーン 1708","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1708_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1708.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/頬照り笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が入浴を終えると、僕とアリスは、寝るための布団を敷き談笑をしていた。すると、いきなり部屋の扉が開く。","id":"A728DE65-43FD-42C4-9EBF-5311F9B528F9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.771292517006803},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":8.098458049886622,"slideTitle":"スライド #1709","title":"シーン 1709","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1709_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1709.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして入ってきたのは、暗い影と涙があるこいしだった。\n彼女は入ってくるや否や、ドアを急いで閉めて、鍵をかける。","id":"817E5E80-C6AB-44F0-BA71-622C9F2872D0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.098458049886622},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":7.43,"slideTitle":"スライド #1710","title":"シーン 1710","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1710_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1710.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、廊下の方からドンドンとドアを叩く音がする。\nそして、こいしは僕に抱きつき、泣きながら言葉を出す。","id":"457490AC-BEA6-441B-B42A-7C2C51F1CDA5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.43},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":4.589501133786848,"slideTitle":"スライド #1711","title":"シーン 1711","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1711_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1711.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「お兄ちゃん…、助けて…、お姉ちゃんが…、お姉ちゃんが…。」","id":"CEFD0B22-F189-4E4A-A195-073BAA31F7C4","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.589501133786848},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":8.843038548752835,"slideTitle":"スライド #1712","title":"シーン 1712","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1712_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1712.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女が小さくそう呟きがなら、ひたすら泣き、僕は事態を把握する。廊下の人物は、扉を叩く代わりにをこじ開けようとする。","id":"FC0842C2-E524-4FC0-B2B3-A3381FCBF61A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.843038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":7.147369614512471,"slideTitle":"スライド #1713","title":"シーン 1713","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1713_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1713.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、ここはこいしの頭をそっと撫でて、少しだけ落ち着かせると、部屋の電話を取り、ロビーに電話をかける。","id":"25BE5951-9214-4161-837B-3AFAD523677A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.147369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":8.193038548752835,"slideTitle":"スライド #1714","title":"シーン 1714","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1714_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1714.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、さらに時間が経ち、こいしがそのまま泣き疲れて、僕の腕の中で眠り出した頃には、廊下は静かになっていた。","id":"40B149F6-7153-477D-AB46-26981CABAB3E","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.193038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":7.362607709750567,"slideTitle":"スライド #1715","title":"シーン 1715","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1715_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1715.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、こいしをベッドで寝かせ、アリスもいつの間にか就寝していることを知ると、部屋の電話である場所に電話をかける。","id":"A2D14780-3479-418A-870E-EAC28B460E33","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.362607709750567},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":1.9942403628117913,"slideTitle":"スライド #1716","title":"シーン 1716","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1716_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1716.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「もしもし、どちら様ですか？」","id":"CB30F088-ECE9-4D47-BCC6-AA6FBEBE92FF","seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":1.9942403628117913},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image77.jpeg","bgmStartTimeOffset":0,"duration":7.6289115646258505,"slideTitle":"スライド #1717","title":"シーン 1717","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1717_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image77.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1717.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「レミリアさん…、僕からのお願いを聞いてくれませんか…。」\n僕はそう言い始め、今までの出来事をそのまま伝えていった。","id":"603BBEA4-6C11-44A2-806F-01E4E9F36943","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.6289115646258505},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1718","title":"シーン 1718: 紅美鈴（学園の体育科担当教員）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1718.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/目閉じ困る.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"紅美鈴（学園の体育科担当教員）","id":"FE5725A9-336E-4695-A388-7541942C8BB1","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.207165532879818,"slideTitle":"スライド #1719","title":"シーン 1719","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1719_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1719.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「んっ…」僕は、あれからふと気がつくと、窓から朝日が差し込んでいた。レミリアとの電話の後、僕はそのまま眠った。","id":"1C92E153-F393-4DC8-BFC3-8E218A96940D","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.207165532879818},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":6.35172335600907,"slideTitle":"スライド #1720","title":"シーン 1720","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1720_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1720.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/生成された画像.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして周りを見ると、こいしとアリスも目が覚めたみたいだった。そして、さとりは部屋にはいなかった。","id":"00911EE8-F8F0-4952-AC16-322A69DB7C9F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.35172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":2.056349206349206,"slideTitle":"スライド #1721","title":"シーン 1721","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1721_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1721.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「お姉ちゃんはどこにいるの…」","id":"5B572065-D4D6-4030-AB41-0E8052BE0EA8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.056349206349206},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.803900226757369,"slideTitle":"スライド #1722","title":"シーン 1722","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1722_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1722.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そう聞いてくる彼女に、昨夜のナイトプールで一体何があったのかを、優しく尋ねると、彼女は泣きながら、説明をした。","id":"70CA17E1-7038-4848-A926-9F403B405271","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.803900226757369},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1723","title":"シーン 1723: パチュリー・ノーレッジ（学園の科学担当教員兼博士）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1723.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パチュリー真顔小口開け.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"パチュリー・ノーレッジ（学園の科学担当教員兼博士）","id":"7C813115-60A1-45EB-B6E9-D3EAD61C4E55","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.086734693877551,"slideTitle":"スライド #1724","title":"シーン 1724","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1724_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1724.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それで、これから、どうするの…？\nお姉ちゃんは、あの人たちに捕まっているけど…。」","id":"615F8F81-B3C5-4611-865D-460607BC48A4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":7.086734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.599546485260771,"slideTitle":"スライド #1725","title":"シーン 1725","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1725_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1725.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"こいしは、着替えた後にそう僕に聞いてくる。「とりあえず、ホテル内の安全確保はできたので、朝食を取りませんか？」","id":"DB71108D-BD7F-488F-A0F3-79EE0E73FD24","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.599546485260771},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":0.6806575963718821,"slideTitle":"スライド #1726","title":"シーン 1726","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1726_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1726.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…」","id":"7633DC7B-9D36-460C-8A2C-28BC9854DF27","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.6806575963718821},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.814761904761904,"slideTitle":"スライド #1727","title":"シーン 1727","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1727_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1727.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こいしさんのいう、邪道派が昨日、襲ってきた彼らなら、きっとまたやってくるはずです。いずれは、戦いましょう。」","id":"1F6D549B-C5EE-4112-9CE4-B73D9ED22127","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.814761904761904},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.0300907029478459,"slideTitle":"スライド #1728","title":"シーン 1728","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1728_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1728.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「わかった…」","id":"C42A178B-B89F-41C9-ACAB-6BFDFA76B29D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.0300907029478459},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.506077097505669,"slideTitle":"スライド #1729","title":"シーン 1729","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1729_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1729.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちがそう話していると、部屋の電話が鳴る。受話器を取ると、ロビーの人から通話相手を知り、繋げてもらう。","id":"954F9460-5278-4193-AD3C-08D34C3BF2DB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.506077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.6647619047619047,"slideTitle":"スライド #1730","title":"シーン 1730","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1730_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1730.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「もしもし…、フランさん？」","id":"6F7A8D95-0915-4E47-A366-8B9B860D6C09","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.6647619047619047},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":10.221995464852608,"slideTitle":"スライド #1731","title":"シーン 1731","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1731_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1731.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢、昨日、お姉様に伝えてくれたお願いに、応えることにしたの、それで私が、今飛行機に乗るから、ホテルで待ってて。」","id":"B8726F58-11B6-4EC3-BDF3-8C83827FEB92","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.221995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.613673469387756,"slideTitle":"スライド #1732","title":"シーン 1732","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1732_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1732.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「わかりました。今日の間は、ホテルから出ないように、言っておきますね。」僕は、それと部屋番号を言うと、電話を切った。","id":"B9A9E32D-2AF5-43B4-8ED8-ED973BBF1227","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.613673469387756},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.124557823129251,"slideTitle":"スライド #1733","title":"シーン 1733","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1733_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1733.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「今、フランさんから連絡があって、あと数分で出発する飛行機に乗ったようなので、昼過ぎには、こっちに着くそうです。」","id":"DFAD6A20-EEAE-4280-83AD-C7D42F85E79E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.124557823129251},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.7027437641723355,"slideTitle":"スライド #1734","title":"シーン 1734","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1734_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1734.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…、ありがとう…」","id":"0D49E2F8-12F2-4407-AD4F-45652274E97F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.7027437641723355},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.447369614512471,"slideTitle":"スライド #1735","title":"シーン 1735","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1735_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1735.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「とりあえず、朝食をホテルのレストランで取ったら、フランさんが着くまでの間は、部屋の中で待ってるのが安全ですよ。」","id":"1659DB13-CFA9-4D72-B1FD-92620A7AB3C0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.447369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.0300907029478459,"slideTitle":"スライド #1736","title":"シーン 1736","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1736_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1736.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「わかった…」","id":"FEDC63E6-E317-4E2B-A125-67AF4FC73A72","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.0300907029478459},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":6.583242630385487,"slideTitle":"スライド #1737","title":"シーン 1737","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1737_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1737.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから僕たちは、朝食を済ませたあと、\nフランがホテルに着くまでの間、部屋の中で過ごすのだった。","id":"A76B6F4B-4DBA-421E-9B90-C8CFC3AD51DC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.583242630385487},{"animationDuration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/咲夜頬照り困った笑み.png","bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1738","title":"シーン 1738: 十六夜咲夜（学園の家庭科担当教員）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"咲夜頬照り困った笑み.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1738.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"十六夜咲夜（学園の家庭科担当教員）","id":"11BE4F0D-6587-4929-8C7F-65EEAF4D3381","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":3.6539002267573695,"slideTitle":"スライド #1739","title":"シーン 1739","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1739_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1739.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが、いろいろと話していると、部屋のチャイムが鳴る。","id":"EEFBF898-1FCD-427D-8D96-05ACFA88E382","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.6539002267573695},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.9919954648526077,"slideTitle":"スライド #1740","title":"シーン 1740","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1740_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1740.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「紅夢は大丈夫だったの？」","id":"C472F757-6C90-4517-9C92-0B402C7F6DDD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.9919954648526077},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.416938775510204,"slideTitle":"スライド #1741","title":"シーン 1741","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1741_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1741.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ。僕とアリスさんは無事ですが、こいしさんとさとりさんが襲撃にあったみたいで、さとりさんが連れ去られました…」","id":"C0C2D04D-AD7A-49FA-8CD4-F40CFFEC9C66","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.416938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":5.789478458049887,"slideTitle":"スライド #1742","title":"シーン 1742","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1742_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1742.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…、とりあえず、これからどうするの？\n旅行を続けるわけじゃないんでしょ？」","id":"2039E0FC-7A79-4B12-81C5-E86925EA0CCF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.789478458049887},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":5.723469387755102,"slideTitle":"スライド #1743","title":"シーン 1743","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1743_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1743.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「まだ…今後のことは決めてないです。\n何よりこいしさんは、連絡手段がないので…。」","id":"974ED7A6-6D42-4279-BAF0-58056AB452D7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.723469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.998231292517007,"slideTitle":"スライド #1744","title":"シーン 1744","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1744_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1744.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「そう…。」私がそう言っていると、私のポケベルがなる。\n「ちょっと、電話してくるから、待ってて。」","id":"386559FF-31BC-427E-90C8-7E8CB584BFB6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":7.998231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":6.138253968253968,"slideTitle":"スライド #1745","title":"シーン 1745","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1745_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1745.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"フランはそう言うと、部屋を出て行った。\n「それで、アリスさんとこいしさんは何か希望はありますか？」","id":"605BD8E0-B345-4221-99AD-33BBFA461D48","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.138253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":2.238843537414966,"slideTitle":"スライド #1746","title":"シーン 1746","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1746_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1746.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私は、安全が一番だと思うけど…」","id":"3353A87E-92E2-4187-8953-8AD7079950DA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.238843537414966},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.6147619047619048,"slideTitle":"スライド #1747","title":"シーン 1747","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1747_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1747.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、こいしさんは？」","id":"4AFB8512-E731-4425-BBC4-8FC28EDDF44C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.6147619047619048},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":5.1309297052154195,"slideTitle":"スライド #1748","title":"シーン 1748","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1748_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1748.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私は、特に希望はないけど…もうあんな目に遭うのはやだ…」","id":"B8A9056B-AB88-4B66-8D3A-493359965A55","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":5.1309297052154195},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.72891156462585,"slideTitle":"スライド #1749","title":"シーン 1749","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1749_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1749.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…。とりあえず、彼女が戻るのを待ちますか…」\n僕たちは、不安を抱えながら、フランが戻るのを待った。","id":"16D5AD5C-54DF-4B15-88A2-38D9A31EFA9E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.72891156462585},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #1750","title":"シーン 1750: 伊吹萃香（学園の体育科担当教員）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1750.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/怒る.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"伊吹萃香（学園の体育科担当教員）","id":"71CC7E22-76F6-4274-9A0B-50D2D548C628","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.425646258503402,"slideTitle":"スライド #1751","title":"シーン 1751","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1751_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1751.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちがそれから、数十分ほど待っていると、フランが部屋の扉を再び開き、戻ってきた。そして、あることを告げる。","id":"2E99CE59-1B53-4E95-BC13-B4590E71C614","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.425646258503402},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":10.034489795918367,"slideTitle":"スライド #1752","title":"シーン 1752","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1752_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1752.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「今、お姉様が、こいしさんの両親と協議して、一時的に私たちたちの家で、こいしさんを預かることにしたって連絡が来た。」","id":"655C4436-2C50-458B-A0DD-9D830FBA180F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.034489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":3.108253968253968,"slideTitle":"スライド #1753","title":"シーン 1753","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1753_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1753.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、彼女の両親はなんと言ってましたか？」","id":"83867E33-C6FF-416F-8AF0-C597EFDCA501","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.108253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.113242630385487,"slideTitle":"スライド #1754","title":"シーン 1754","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1754_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1754.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「今、地下底国グループで派閥争いが起きていて、とてもじゃないけど彼女を家に帰らせるわけにはいかないって。」","id":"0A8AFC9C-0AD6-4A12-9D34-858CC93E2BEE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.113242630385487},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":9.576984126984128,"slideTitle":"スライド #1755","title":"シーン 1755","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1755_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1755.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「それと、こないだの突如の発表は、一旦無効にして、状況が落ち着くまで、私やお姉様と協力するって言ってた。」","id":"96A1B21D-8457-4EE0-B5C4-03A44EFC3A5B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":9.576984126984128},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":0.8973696145124717,"slideTitle":"スライド #1756","title":"シーン 1756","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1756_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1756.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…」","id":"5D9FAF60-AEC1-4CFC-8104-B222AA584A7D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":0.8973696145124717},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":5.240748299319728,"slideTitle":"スライド #1757","title":"シーン 1757","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1757_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1757.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「とりあえず、空港に戻って、私たちの家に帰る、それでいい？」","id":"168A0787-4058-4C5B-A8B1-2F2F274A3CC4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":5.240748299319728},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":0.7994104308390023,"slideTitle":"スライド #1758","title":"シーン 1758","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1758_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1758.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの私は…」","id":"8EA15F94-48EA-472B-AA9C-3C4021520096","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":0.7994104308390023},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":8.295215419501133,"slideTitle":"スライド #1759","title":"シーン 1759","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1759_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1759.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「アリスさんは、自由行動で構いませんよ。ただ、もし、もう少し滞在するなら、少しばかし手続きが必要ですが…」","id":"C77FB8E2-3C8A-4465-AA16-93D820E87ABA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.295215419501133},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":1.8822902494331066,"slideTitle":"スライド #1760","title":"シーン 1760","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1760_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1760.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「じゃあ、私も家に帰ろうかしら…」","id":"85945762-D4C0-4FF5-9162-2D41BD9BDEB4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.8822902494331066},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":2.4604308390022678,"slideTitle":"スライド #1761","title":"シーン 1761","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1761_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1761.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こいしさんは、それで大丈夫ですか？」","id":"A0FB4417-02FE-41BD-B51D-5090CA381E73","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.4604308390022678},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":4.183424036281179,"slideTitle":"スライド #1762","title":"シーン 1762","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1762_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1762.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それでいいよ…、もう一度危険な目には遭いたくないし…」","id":"F2F27AAC-83D8-4D77-BDBB-4BD18C87C0AB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.183424036281179},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image78.jpeg","bgmStartTimeOffset":0,"duration":7.039773242630385,"slideTitle":"スライド #1763","title":"シーン 1763","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1763_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image78.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1763.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、二人の意見を把握すると、そのままフランが先導する形で、フランたちの家に帰っていくのだった。","id":"F43B638B-3DB2-45B7-B5DB-DD2DFA051A9E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.039773242630385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":7.904988662131519,"slideTitle":"スライド #1764","title":"シーン 1764","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1764_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1764.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"あれから、僕たちは家に帰り、レミリアとフランにいろいろと説明をしていると、あっという間に時間が過ぎ、夕飯時になった。","id":"D60DDADE-58DE-458B-ADEE-2124FE28077F","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.904988662131519},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.4017233560090703,"slideTitle":"スライド #1765","title":"シーン 1765","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1765_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1765.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂怒り目開き.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、今はレミリアとフランになぜか説教されていた。","id":"996FD418-A49C-4938-BFD0-1FA3EA9E7993","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.4017233560090703},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":6.385895691609977,"slideTitle":"スライド #1766","title":"シーン 1766","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1766_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1766.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/香霖堂怒り目開き.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「まったく、留守電を残していたとはいえ、\n何で私たちに相談もせずに、勝手に行動をするのよ。」","id":"EB73F35E-8B1E-4F66-B168-C36BFD6F33FC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":6.385895691609977},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":3.3494784580498864,"slideTitle":"スライド #1767","title":"シーン 1767","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1767_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1767.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"「次こう言うことがあったら、お仕置きだからね。」","id":"4BD7695B-E08D-43EA-87D6-5A0CDC61EE51","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.3494784580498864},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":8.195736961451248,"slideTitle":"スライド #1768","title":"シーン 1768","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1768_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1768.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/レミリア（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「まぁ、今更言ったって、過ぎたことは仕方ないし、今日はこれくらいにしておくわ。今は、彼女の身の安全が優先だからね。」","id":"AC844EF0-4BEF-4620-8CCF-0A0F085B4BC3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":8.195736961451248},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc196982_食堂(夜2).png","bgmStartTimeOffset":0,"duration":7.488684807256236,"slideTitle":"スライド #1769","title":"シーン 1769","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1769_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1769.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言うと、困った様子を浮かべるこいしを向く。\nそして、そこで会話が途切れ、沈黙の時間が流れた。","id":"3BF9A081-CF61-4E4A-B2BA-EE827D594603","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.488684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":6.767596371882086,"slideTitle":"スライド #1770","title":"シーン 1770","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1770_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1770.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちは夕飯を食べ終えると、歯を磨き、\nこいしとともに元々フランと僕の二人部屋だった部屋に来た。","id":"EE3E2149-CCDD-44E6-91BA-B20462A36AF6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.767596371882086},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":2.255238095238095,"slideTitle":"スライド #1771","title":"シーン 1771","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1771_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1771.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「何だか…ごめんなさい…。」","id":"A2E6D4E5-858D-48A3-8B7A-B0B4C4A7F16D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":2.255238095238095},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":5.0843310657596374,"slideTitle":"スライド #1772","title":"シーン 1772","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1772_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1772.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こいしさんが謝る必要はないですよ。\n僕とフランさんたちとの問題なので…。」","id":"34E49CAE-5CE3-4B58-B28D-BD4F2A213B18","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.0843310657596374},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":0.6806575963718821,"slideTitle":"スライド #1773","title":"シーン 1773","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1773_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1773.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…」","id":"EBC39790-8970-4DC8-8EE3-4919C50A360C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.6806575963718821},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":9.014761904761905,"slideTitle":"スライド #1774","title":"シーン 1774","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1774_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1774.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕たちが、そう話していると、玄関の方から、物音がする。\nだが、すっと静かになり、僕は気にせず、ただボーっとする。","id":"BB2BB87E-BB46-40DC-A1D4-5146FB86368C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.014761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":6.08,"slideTitle":"スライド #1775","title":"シーン 1775","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1775_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1775.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ汗なし困り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、部屋の扉がノックされる。\n僕は、特に気にも止めずに、部屋の扉を開ける。","id":"2921C15C-F767-4997-817C-C4E36F3EEC23","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.08},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":4.383197278911565,"slideTitle":"スライド #1776","title":"シーン 1776","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1776_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1776.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あら、こいし。こんなところにいたの。\nほら、私たちの家に帰りますよ。」","id":"03879C21-4F6D-4BDE-A89D-6C709AA32C19","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":4.383197278911565},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":7.388684807256236,"slideTitle":"スライド #1777","title":"シーン 1777","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1777_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1777.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/パジャマ恐怖.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はふとこいしの方を見ると、彼女には恐怖の表情を浮かべていた。僕は、そこで瞬時にこいしの前に立つ。","id":"8079E690-1B46-4D80-BA5F-8E87B638BC71","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.388684807256236},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":6.356984126984127,"slideTitle":"スライド #1778","title":"シーン 1778","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1778_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1778.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/恐怖笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「あら、紅夢さん、どうしたんですか？私は妹を連れて帰るだけですよ。それとも…私がどうかしたのですか？」","id":"AB07BED0-C4CE-4196-945C-9757B2BE3DE6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":6.356984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-26_19-50.png","bgmStartTimeOffset":0,"duration":6.356984126984127,"slideT