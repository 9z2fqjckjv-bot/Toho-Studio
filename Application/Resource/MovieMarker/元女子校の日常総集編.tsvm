\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1439.jpeg","voiceDuration":7.313673469387755,"seVolume":1},{"id":"ED8196A5-720E-4AE0-B991-49DAD09A8DD7","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1440_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「ねぇ、紅夢、今は何してるの？」","voiceCharacter":"フランドール・スカーレット","duration":2.846984126984127,"title":"シーン 1440","slideTitle":"スライド #1440","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1440.jpeg","voiceDuration":2.846984126984127,"seVolume":1},{"id":"D767B7EF-8E42-4775-BD98-5F448683C528","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1441_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image60.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image60.jpeg","telop":"「えっ…？」僕は、その問いに思わずそう返してしまう。\n「確か、昨日、留守電を残していったはずなんですけど…」","voiceCharacter":"操夢","duration":7.7365079365079366,"title":"シーン 1441","slideTitle":"スライド #1441","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1441.jpeg","voiceDuration":7.7365079365079366,"seVolume":1},{"id":"AB32D53A-69BA-4041-8BD3-0967B8E6EECC","seStartTimeOffset":0,"animationName":"なし","transiti