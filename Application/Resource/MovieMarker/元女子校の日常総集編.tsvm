ioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が、二人部屋にやってくると、部屋の隅でこいしが泣いていた。「どうしたんですか、こいしさん…？」","id":"DA8B6E94-F408-4242-83DB-3F04A3A30E81","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.356077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.8685034013605444,"slideTitle":"スライド #1995","title":"シーン 1995","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1995_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1995.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし泣き怒り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「こいしだけでいい、あとタメ口で構わないから。」","id":"9ABC3F38-3043-45F8-A75E-ABEDAD5606DB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.8685034013605444},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.578911564625851,"slideTitle":"スライド #1996","title":"シーン 1996","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1996_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1996.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし泣き怒り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かった…、こいし…。」\n僕はそう言い、彼女の頭をそっと撫でる。","id":"1BBA4C72-20C4-4F09-A56F-763F6E6BE2F4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.578911564625851},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.973469387755102,"slideTitle":"スライド #1997","title":"シーン 1997","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1997_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1997.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし泣き疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、彼女の表情が変わる。\n「どうですか、気持ちは落ち着きましたか？」","id":"BDC25522-8E68-43E4-A7F5-75894D8F02CD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.973469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":6.008253968253968,"slideTitle":"スライド #1998","title":"シーン 1998","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1998_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1998.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし泣き疑問.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると彼女は、小さく頷く。\n僕は、彼女が泣き止むまで、頭を撫で続ける。","id":"496B73BA-7F36-4474-8C50-2B8EE440E887","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.008253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":1.9140816326530612,"slideTitle":"スライド #1999","title":"シーン 1999","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1999_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1999.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なしあきれ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「何だか疲れちゃった…」","id":"3806FA80-AC75-4DF5-B432-F079D37676B8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.9140816326530612},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.5017233560090704,"slideTitle":"スライド #2000","title":"シーン 2000","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2000_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2000.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なしあきれ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…」僕は、彼女の呟きにそう返す。","id":"1B00853A-C1A6-41E4-8296-65D347F194FB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.5017233560090704},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":3.0314739229024945,"slideTitle":"スライド #2001","title":"シーン 2001","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2001_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2001.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし不満.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「でも、諦めたわけじゃないからね…」","id":"5233CC09-6C07-4E1A-8CA9-EB204C71ACA8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.0314739229024945},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":4.093038548752834,"slideTitle":"スライド #2002","title":"シーン 2002","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2002_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2002.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし不満.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ふっ…」僕は彼女のその発言に思わず、笑いが漏れる。","id":"2CEB8B30-A957-4AB3-82DE-4D1C2A740EF4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.093038548752834},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":7.014897959183673,"slideTitle":"スライド #2003","title":"シーン 2003","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2003_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2003.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし怒り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「笑わないでよ…、いつか必ず、\nあなたに振り向いてもらうから…。ちゃんと覚えててね…」","id":"B80FF333-5A07-433A-93D7-522ED21B8ADE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":7.014897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/2026-10-25_16-14.pxd","bgmStartTimeOffset":0,"duration":7.8441269841269845,"slideTitle":"スライド #2004","title":"シーン 2004","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2004_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-25_16-14.pxd","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2004.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし怒り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「その約束、頭の中にちゃんと留めておきますよ。」\n僕は、そういうと、すっと立ち上がり、図書館に向かった。","id":"B3ABC4A7-9CDA-471C-8B5C-8DEECA0D37B4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.8441269841269845},{"animationDuration":5,"bgmStartTimeOffset":0,"duration":5,"slideTitle":"スライド #2005","title":"シーン 2005: 古明地こいし（中学生）","animationName":"なし","bgmVolume":0.65,"animationNote":"5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2005.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/帽子なし怒り.png","voice2StartTimeOffset":0,"characterName":"操夢","seStartTimeOffset":0,"telop":"古明地こいし（中学生）","id":"00D50E5B-CC65-416A-A0D8-7FCBBAE5AE1C","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":8.035419501133786,"slideTitle":"スライド #2006","title":"シーン 2006","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2006_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2006.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"あれからしばらく経ち、大型連休が終わり、僕は再び学校にやってきた。そして、いつものように朝礼が始まった。","id":"C3C2547E-3623-42EE-8EB5-2B1F1881AC87","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.035419501133786},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.4386848072562355,"slideTitle":"スライド #2007","title":"シーン 2007","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2007_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2007.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「今日は、連休明け初日ですが、気を引き締め、教員から叱責を受けることもなく、向上心を持って取り組みましょう。」","id":"CDD811CB-DEF1-48CF-AFD6-E11DE2F74F86","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":7.4386848072562355},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":7.935442176870748,"slideTitle":"スライド #2008","title":"シーン 2008","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2008_東風谷早苗.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2008.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/早苗（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_D32F","characterName":"東風谷早苗","telop":"「ただし、藤原さんは、このあと、速やかに職員室に向かってください。連休前の行動に関して確認をしますから。」","id":"5C4D2BDC-B333-45B1-BDC1-428AB0741432","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"東風谷早苗","voiceDuration":7.935442176870748},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/2026-10-04_16-42.png","bgmStartTimeOffset":0,"duration":6.739773242630386,"slideTitle":"スライド #2009","title":"シーン 2009","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2009_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"2026-10-04_16-42.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2009.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、去って行った。\n僕は、何となくの予測がついた状態で、職員室に向かう。","id":"B0C51CCB-A1E8-4731-9E94-32E2A8376103","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.739773242630386},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc253888_学校の職員室（日中）.jpg","bgmStartTimeOffset":0,"duration":6.739773242630386,"slideTitle":"スライド #2010","title":"シーン 2010","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2010_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc253888_学校の職員室（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2010.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそれから、職員室に来ると、ある女性がやってくる。","id":"8DCEE0B2-468A-4EA2-92F7-D3C3F2F2436A","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.739773242630386},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc253888_学校の職員室（日中）.jpg","bgmStartTimeOffset":0,"duration":2.215578231292517,"slideTitle":"スライド #2011","title":"シーン 2011","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2011_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc253888_学校の職員室（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2011.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「とりあえず、別室に行きましょうか。」","id":"7CD29C48-303B-4FAC-A684-DC69B68B24B4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":2.215578231292517},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":3.6006349206349206,"slideTitle":"スライド #2012","title":"シーン 2012","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2012_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2012.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕が彼女についていくと、やってきたのはある部室だった。","id":"02B52E8D-2421-40D3-836A-EFA043BB84DD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.6006349206349206},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":3.915578231292517,"slideTitle":"スライド #2013","title":"シーン 2013","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2013_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2013.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「ひとまず、遠足から今に至るまでの流れを説明してください。」","id":"A2890814-3E4E-41EF-9A6F-F42D72026E40","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":3.915578231292517},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":7.873469387755102,"slideTitle":"スライド #2014","title":"シーン 2014","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2014_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2014.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女がそういうと、僕は、彼女に言われた通りに話す。\n彼女は、時折相槌や質問をしながら、聞いていた。","id":"893B4FCD-124D-4DC6-92F9-7DB973C880F5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.873469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":3.1115873015873015,"slideTitle":"スライド #2015","title":"シーン 2015","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2015_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2015.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「それにしても、厄介ですね…、例の発表は…」","id":"EB874732-5FE6-49BE-A3E2-721A856095F7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":3.1115873015873015},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":2.266938775510204,"slideTitle":"スライド #2016","title":"シーン 2016","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2016_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2016.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「地下底国グループの話ですか？」","id":"E84D786D-B509-4E1B-98B2-0481EB906BD9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.266938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":2.9615873015873015,"slideTitle":"スライド #2017","title":"シーン 2017","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2017_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2017.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「ええ…、何しろ学校も巻き添えを食らってますから…」","id":"A4796BC6-309B-4DDF-8F1A-AEFEFEB4276A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":2.9615873015873015},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":3.975646258503401,"slideTitle":"スライド #2018","title":"シーン 2018","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2018_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2018.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、遠足前に来た、例のお題はどうなったんですか？」","id":"7D90AE40-8723-4DE6-A50A-196172D53185","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.975646258503401},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":3.9735827664399093,"slideTitle":"スライド #2019","title":"シーン 2019","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2019_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2019.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「確かに、あなたの行動は、周囲に大きな影響を与えました。」","id":"7D65D420-61FD-4B7E-AEBD-5F8D12DC56E9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":3.9735827664399093},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":7.490181405895692,"slideTitle":"スライド #2020","title":"シーン 2020","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2020_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2020.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「ですが、あなたの行動は、こちらが予定していた試験を前取りしたのであることを私たちも認識してますから。ただし…」","id":"8835BA04-0A0C-4845-8BF8-B9E35AC635CA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":7.490181405895692},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":6.99358276643991,"slideTitle":"スライド #2021","title":"シーン 2021","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2021_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2021.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「あなたは、これからパチュリー博士のいる研究室に向かってもらいます。そこではアリスさんに事情を聞き取り中ですから。」","id":"D74AA437-6E36-407E-B39E-0F22125A55A3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":6.99358276643991},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc227198_部室（昼）.jpg","bgmStartTimeOffset":0,"duration":2.759591836734694,"slideTitle":"スライド #2022","title":"シーン 2022","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2022_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc227198_部室（昼）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2022.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「とりあえず、私の後についてきてください。」","id":"AA051F5D-EFAF-4119-BDAB-6518DCAEDD9E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":2.759591836734694},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":5.493038548752835,"slideTitle":"スライド #2023","title":"シーン 2023","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2023_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2023.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕がそう言った彼女と共に研究室にくると、\n彼女のいう通りアリスとパチュリーがいた。","id":"91D4BB5B-84CC-4886-97F3-B6D1F0DA654A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.493038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":3.3832426303854874,"slideTitle":"スライド #2024","title":"シーン 2024","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2024_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2024.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女はパチュリーに耳打ちしてから去って言った。","id":"8042DF4B-59BE-449D-82BC-48FB76EE5133","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.3832426303854874},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":3.3745578231292517,"slideTitle":"スライド #2025","title":"シーン 2025","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2025_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2025.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「あら、当の本人がやってきたのね…、それで何の用かしら？」","id":"71BAFADF-3194-4FB4-9BC9-F9B310210D62","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":3.3745578231292517},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":3.5223809523809524,"slideTitle":"スライド #2026","title":"シーン 2026","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2026_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2026.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「えっと…、彼女について来てと言われて来ただけですけど…」","id":"C2DFF85A-8081-474E-8CB2-2C1408DFB406","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.5223809523809524},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":2.6085714285714285,"slideTitle":"スライド #2027","title":"シーン 2027","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2027_パチュリー・ノーレッジ.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2027.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/パチュリー（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1B13","characterName":"パチュリー・ノーレッジ","telop":"「そうね…、とりあえず、私のとこに来なさい。」","id":"A98290C0-84CE-4FAF-A348-5E598208F78D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","voiceDuration":2.6085714285714285},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","bgmStartTimeOffset":0,"duration":8.9