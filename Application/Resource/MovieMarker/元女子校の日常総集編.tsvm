984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":2.466938775510204,"slideTitle":"スライド #1338","title":"シーン 1338","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1338_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1338.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、こいしさんは…、どうですか？」","id":"D3A9AC90-D189-45DA-97F7-C5F6C1696A59","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.466938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":9.31047619047619,"slideTitle":"スライド #1339","title":"シーン 1339","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1339_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1339.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私は…」私はそう言いかけて、言葉が止まる。\nそして、ふと彼とエンドレスランをした日のことを思い出す…。","id":"9DC827CE-CEE6-4F67-8384-89A4E7FC60AA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":9.31047619047619},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","bgmStartTimeOffset":0,"duration":10.14750566893424,"slideTitle":"スライド #1340","title":"シーン 1340","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1340_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ペーストされた画像.tiff","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1340.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"私たちが、走り始めてから、最初の校門を出て曲がるまでは、\n特に問題なく、比較的にスムーズに走れていた。","id":"B7BA5663-1D73-4BDD-B2E3-2773A2EF1236","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.14750566893424},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","bgmStartTimeOffset":0,"duration":11.650272108843538,"slideTitle":"スライド #1341","title":"シーン 1341","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1341_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc367698_住宅街２（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1341.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"だが、1kmあたりを過ぎると、だんだんと、彼と私のペースに翳りが見え始め、後方にいた美鈴先生がその問題を指摘する。","id":"60625397-89DB-4BA2-8F86-0457E87A4004","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":11.650272108843538},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","bgmStartTimeOffset":0,"duration":10.726235827664398,"slideTitle":"スライド #1342","title":"シーン 1342","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1342_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc367698_住宅街２（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1342.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"そこまでは、単純に走って疲れて、歩いているだけ、だった。\nだが、歩き始めて少し経つと、彼が急に走り出す。","id":"F37A9081-FB4F-42E2-BCAE-EBE55603347D","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.726235827664398},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc367698_住宅街２（日中）.jpg","bgmStartTimeOffset":0,"duration":11.539773242630385,"slideTitle":"スライド #1343","title":"シーン 1343","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1343_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc367698_住宅街２（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1343.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"私は、慌てて彼について行こうとすると、彼の手がぶつかる。\n私はあのときドキッとし、そして、口走り、そのまま走り出す。","id":"51C0F4DB-5196-46E0-8895-1CB6A693F738","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":11.539773242630385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","bgmStartTimeOffset":0,"duration":10.744195011337869,"slideTitle":"スライド #1344","title":"シーン 1344","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1344_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc240173_住宅街（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1344.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"だが、さらに1kmがたつと、今度は足元にある石ころにこける。\nそして、次の瞬間には、彼に抱っこされていた。","id":"D4ACDF0A-B9A3-4BF6-AA96-AF016B7BBCA7","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.744195011337869},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc240173_住宅街（日中）.jpg","bgmStartTimeOffset":0,"duration":10.158548752834466,"slideTitle":"スライド #1345","title":"シーン 1345","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1345_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc240173_住宅街（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1345.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"それからだろうか…、私は、今までの学校生活では全くと言っていいほど、感じなかった気持ちが心から湧き出していた。","id":"3D491CCA-3DB3-4933-B12F-A2556376EBCE","seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.158548752834466},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":3.1171201814058955,"slideTitle":"スライド #1346","title":"シーン 1346","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1346_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1346.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困り顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"私は、ふと意識が現実に戻ると、彼が困った表情で、私の名前を読んでいた。「私は…紅夢と…」私は、続けて言葉を放つ。","id":"B5F6883F-2157-4194-96C9-729267B15D5C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.1171201814058955},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":5.495396825396825,"slideTitle":"スライド #1347","title":"シーン 1347","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1347_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1347.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「こいし…、一体どんな変化があったのよ…」\n私は、妹が発した予想外なその言葉に、そう返す。","id":"5706D5DF-A43A-4FD0-B09E-F947B33218AA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.495396825396825},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":8.010430839002268,"slideTitle":"スライド #1348","title":"シーン 1348","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1348_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1348.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、こいしの発言に驚きながらも、念の為に、他の二人に確認をとる。「それで、部屋割りはどうしますか？」","id":"D505B063-8675-425E-8A45-12644EF4A628","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.010430839002268},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":6.72047619047619,"slideTitle":"スライド #1349","title":"シーン 1349","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1349_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1349.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの…、もしこいしさんと紅夢さんが同じ部屋になるのなら、私との約束は、どうなるのかしら…。」私は、そう彼に聞く。","id":"69C9A675-E4D1-4271-9FF1-715A8621D635","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":6.72047619047619},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":8.773469387755101,"slideTitle":"スライド #1350","title":"シーン 1350","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1350_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1350.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、アリスのその指摘で思い出す。「確かにそうですね…」\n僕は、そう言いながら、考える。だが、くしゃみが再び出る。","id":"213CE725-DA41-4025-956B-DAFB2F7FF4C3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.773469387755101},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":3.456077097505669,"slideTitle":"スライド #1351","title":"シーン 1351","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1351_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1351.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「今日の昼食は、各自で準備でも構いませんか？」","id":"0C865871-0305-4ACF-B06A-21B310317342","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.456077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":7.054580498866213,"slideTitle":"スライド #1352","title":"シーン 1352","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1352_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1352.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「それで、構いませんよ。とりあえず、紅夢さんの、風邪を治すのが、先ですし…、ただこいしの発言にも…答えてくれますか？」","id":"827DC614-DD42-426F-8A95-37AF19BC476F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":7.054580498866213},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":7.756077097505669,"slideTitle":"スライド #1353","title":"シーン 1353","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1353_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1353.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「じゃあ、誰と寝るかは、夕食後に決めるとして、とりあえず今は、僕とこいしさん、さとりさんとアリスさんでいいですか？」","id":"025E79E8-BF29-4189-B90B-A39228112250","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.756077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":1.3111337868480726,"slideTitle":"スライド #1354","title":"シーン 1354","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1354_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1354.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「ええ、そうしましょうか…」","id":"94D5B811-BB6D-4DC8-B04F-6F6E576AFD20","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":1.3111337868480726},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc352037_ホテルの廊下1.jpg","bgmStartTimeOffset":0,"duration":8.22891156462585,"slideTitle":"スライド #1355","title":"シーン 1355","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1355_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc352037_ホテルの廊下1.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1355.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/困った笑み小口笑い.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから、僕とこいし、アリスとさとりに分かれて部屋に入って行き、各自昼食をとり、それからは、休憩の時間になった。","id":"BFEBC51E-3B6B-4091-AA09-6AF62577D3B4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.22891156462585},{"voice2StartTimeOffset":4.6278231292517,"telop":"僕とこいしが部屋に入ると、僕は、浴室に入り、湯船をため、\n浴室を出ると、こいしがもじもじとしていた。","seVolume":1,"characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voiceDuration":4.6278231292517,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","animationName":"なし","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"slideTitle":"スライド #1356","bgmVolume":0.65,"duration":7.464331065759637,"backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1356.jpeg","id":"2EBE5BC2-5446-4DD4-94D8-7194942202AF","voice2Character":"操夢","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1356_操夢_2.wav","bgmStartTimeOffset":0,"voice2Duration":2.8365079365079366,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1356_操夢.wav","transitionName":"なし","title":"シーン 1356"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":2.0104308390022676,"slideTitle":"スライド #1357","title":"シーン 1357","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1357_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1357.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「どうしたんですか、こいしさん…？」","id":"4A6AC881-71D3-491A-BD25-1100C2766EF9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.0104308390022676},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":1.4845124716553288,"slideTitle":"スライド #1358","title":"シーン 1358","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1358_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1358.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「こいしって呼んで…」","id":"E3205B3B-2048-4FCA-B710-708D1054375E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.4845124716553288},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":1.7778231292517006,"slideTitle":"スライド #1359","title":"シーン 1359","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1359_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1359.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「こいし…、これでいいですか？」","id":"B1B11C52-F195-4D00-9D2C-A8AF88F2A348","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":1.7778231292517006},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":0.6253968253968254,"slideTitle":"スライド #1360","title":"シーン 1360","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1360_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1360.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「うん…」","id":"A4448ED1-393C-4931-9FDE-A96096522646","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.6253968253968254},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":6.60172335600907,"slideTitle":"スライド #1361","title":"シーン 1361","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1361_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1361.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました…」ちょっと湯船の方見てきますね。\n僕はそう言うと、もう一度、浴室に入る。","id":"FD906F3F-7075-46D6-A679-656E4AFC67DC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.60172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image62.jpeg","bgmStartTimeOffset":0,"duration":7.965850340136054,"slideTitle":"スライド #1362","title":"シーン 1362","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1362_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image62.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1362.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、浴槽には足がつかる程度のお湯が溜まっていた。\n僕は、そこから満タンになる時間を頭で算出したのだった。","id":"70D2A6D1-66D0-402C-AE0C-15FA0F8910E9","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.965850340136054},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":8.789773242630385,"slideTitle":"スライド #1363","title":"シーン 1363","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1363_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1363.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それから入浴で全身を温めて、出ると空腹がやってくる。\nそして、ふとこいしの方を見ると、彼女も同じようだった。","id":"8346C323-8B44-4D2C-B06C-243607F0CBFD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.789773242630385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":2.4691156462585035,"slideTitle":"スライド #1364","title":"シーン 1364","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1364_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1364.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「どうします、ご飯食べに行きますか？」","id":"0CFAB3F4-203A-44FF-BBF2-73F5380D8ED6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.4691156462585035},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":1.5148979591836735,"slideTitle":"スライド #1365","title":"シーン 1365","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1365_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1365.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「出前ってできる？」","id":"6DBDE2C6-BB02-4039-A495-875A034EEC36","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.5148979591836735},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.876734693877551,"slideTitle":"スライド #1366","title":"シーン 1366","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1366_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1366.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女にそう言われ、テレビをつける。そして、テレビに出てくるホテルの案内を見るが、デリバリーの文字はなかった。","id":"B68D4338-F374-48E0-8185-19E123BCAAE3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.876734693877551},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.5082539682539684,"slideTitle":"スライド #1367","title":"シーン 1367","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1367_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1367.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「どっちかが、外にでて、買いに行くしかないですね…。」","id":"1CD9CC89-F508-4D3A-BB20-DC487A6EEE08","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.5082539682539684},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":0.6806575963718821,"slideTitle":"スライド #1368","title":"シーン 1368","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1368_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1368.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「そう…」","id":"55459D56-A089-470D-9C7C-BC520ACF4C23","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":0.6806575963718821},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":2.0278231292517006,"slideTitle":"スライド #1369","title":"シーン 1369","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1369_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1369.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「何か食べたいものはありますか？」","id":"11C9D2EF-2B44-4234-98EC-F59DA7CE3FA4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.0278231292517006},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":1.5370068027210884,"slideTitle":"スライド #1370","title":"シーン 1370","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1370_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1370.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「いや…特に…」","id":"8C427AF1-7719-4C2F-88AC-B1C93699E3AF","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.5370068027210884},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":4.697369614512471,"slideTitle":"スライド #1371","title":"シーン 1371","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1371_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1371.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですか…、それなら、\n僕が勝手に買ってきても、大丈夫ですか…？」","id":"1B3FF6E2-43DF-470B-B4DD-8721FBBD3A35","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.697369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":1.6033106575963718,"slideTitle":"スライド #1372","title":"シーン 1372","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1372_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1372.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「それで、いいよ…」","id":"07565111-0F69-462C-B33D-3D5F4DBE7653","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.6033106575963718},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.145215419501134,"slideTitle":"スライド #1373","title":"シーン 1373","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1373_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1373.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました。それじゃあ、買ってきますね。」\n僕はそう言うと、一度おろしたバックを背負い、部屋を出た。","id":"D6919EDF-AEF7-4E4F-ACF3-F2B5CEF8F81F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.145215419501134},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1374","title":"シーン 1374: 彼が買い出しから戻ると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1374.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼が買い出しから戻ると…","id":"1CD3761A-75E9-4C25-8E68-655F20C1C054","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":6.993038548752835,"slideTitle":"スライド #1375","title":"シーン 1375","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1375_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1375.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、買い出しから戻ると、バックから〇〇〇〇チュそばを取り出し、給湯ポットから、お湯を入れて、蓋をする。","id":"EEBF231C-FA5D-47CF-AE49-670CC7942EC4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.993038548752835},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":8.434331065759638,"slideTitle":"スライド #1376","title":"シーン 1376","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1376_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1376.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、数分程度待ち、容器の上に、箸を乗せて、そっともち、彼女に、手渡す。「熱いので気をつけてください。」","id":"B21FB339-86B4-46CB-8890-7C793D67BA67","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.434331065759638},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.411315192743764,"slideTitle":"スライド #1377","title":"シーン 1377","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1377_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1377.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ありがとう…、じゃあ、いただきます…。」\n私は、そう言って、冷ましながらそれを食べる。","id":"35F19988-CBAB-43D5-9561-96D97077C7E7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":7.411315192743764},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.395215419501134,"slideTitle":"スライド #1378","title":"シーン 1378","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1378_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1378.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が食べ始めたのを見ると、バックから油みそが入ったポーク玉子おむすびと天ぷらを取り出して、食べる。","id":"ABFBA62D-0D0F-488D-87DD-3D37CAEA8555","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.395215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.147369614512471,"slideTitle":"スライド #1379","title":"シーン 1379","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1379_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1379.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/照れ小口開け.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、昼食を済ますと、彼女に沖縄そばの感想を聞く。\n「どうでしたか、初めての沖縄そばは…？」","id":"12B776BC-24F1-433F-A83B-B64FFAEB1DA8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.147369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":10.331201814058957,"slideTitle":"スライド #1380","title":"シーン 1380","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1380_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1380.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝落ち寸前頬照り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「美味しかった…」私は、お腹が満たされると、眠たくなる。\nそして、私は無意識のうちに彼の服を手で引っ張る…。","id":"59B886B0-8371-4C0C-B80F-2E8CF1050B4E","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":10.331201814058957},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.656077097505669,"slideTitle":"スライド #1381","title":"シーン 1381","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1381_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1381.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/寝落ち寸前頬照り.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、僕の服を引っ張る彼女を見て、彼女をベッドに横たわらせると、自分自身も同じベッドの隣で横になる。","id":"5943FC0F-43C9-4F3B-8386-44DD5D49169B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.656077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.923469387755102,"slideTitle":"スライド #1382","title":"シーン 1382","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1382_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1382.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、頭をそっと優しく撫でていると、彼女は気持ちよさそうに、そのまま寝落ちした。すると、あくびが出てくる。","id":"104B36C4-9619-4C45-B5C3-5EB7C7300149","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.923469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":8.14845804988662,"slideTitle":"スライド #1383","title":"シーン 1383","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1383_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1383.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、彼女の頭を優しくトントンと手を当てながら、そのまま瞼が重たくなって行き、彼女のそばでそのまま眠るのだった。","id":"59853255-90F4-465E-84F6-C0273FBE5E3B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.14845804988662},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1384","title":"シーン 1384: 彼の目が覚めると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1384.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼の目が覚めると…","id":"2D6A2ADF-B46C-4690-8C9B-F23FA679FF75","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":7.821292517006802,"slideTitle":"スライド #1385","title":"シーン 1385","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1385_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1385.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はふと目が覚めると、部屋の時計を確認する。時計には、午後4時と表示されていた。「昼寝しすぎたな…」","id":"94FFFD0E-67E0-48B6-BD45-F648438EEBBB","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.821292517006802},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":6.923469387755102,"slideTitle":"スライド #1386","title":"シーン 1386","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1386_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1386.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそう言いながら、起きあがろうとすると、こいしが腕を回し、僕の体に抱きつき、その場に引き留める。","id":"122A05CC-70A9-4328-8324-7EA1BCB6504F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.923469387755102},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":8.166938775510204,"slideTitle":"スライド #1387","title":"シーン 1387","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1387_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1387.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/気持ちの良い寝顔.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、部屋のチャイムが鳴ると同時に、焦燥感に駆られる。\nだが、予備のカードーキーでドアが開き、誰かが入ってくる。","id":"C3924FCA-463F-49A8-AD72-2142BC661A1B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.166938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":8.495215419501134,"slideTitle":"スライド #1388","title":"シーン 1388","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1388_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1388.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、入ってきたその女性…、さとりは、驚いた表情で、その場で固まってしまった…。そして僕は、何かを悟った。","id":"D3065D3E-9B65-4D1E-AD41-D104BEF9B544","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.495215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":4.328911564625851,"slideTitle":"スライド #1389","title":"シーン 1389","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1389_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1389.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕はそれから、彼女に理不尽なお説教を数十分受けるのだった。","id":"B18759D4-8425-4C4E-A706-14C8B80E0B80","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.328911564625851},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1390","title":"シーン 1390: さとりの説教が終わり…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1390.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"さとりの説教が終わり…","id":"3914F56F-404B-498E-B0F4-8411B2436580","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":6.756077097505669,"slideTitle":"スライド #1391","title":"シーン 1391","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1391_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1391.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それからさとりによる説教という修羅場を乗り切ると、僕はようやくベッドから立ち上がり、弁明の時間になる。","id":"C20C4BD2-08AB-4539-BFD1-146F439ED61C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.756077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.6778231292517005,"slideTitle":"スライド #1392","title":"シーン 1392","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1392_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1392.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、その最中に、こいしがある質問を僕にする…。","id":"EDBFEF40-F4E6-4F69-BF16-7ABAD4F7B42C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.6778231292517005},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.545283446712018,"slideTitle":"スライド #1393","title":"シーン 1393","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1393_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1393.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（怒る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「ねぇ…、今晩も私と…寝てくれない…？」","id":"C541FA73-D2CC-4D0E-866B-56DC27D99AA4","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":3.545283446712018},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.1043990929705214,"slideTitle":"スライド #1394","title":"シーン 1394","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1394_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1394.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「こいし、やめときなさい…、もし誰かに甘えたいなら私を…」","id":"E4392529-1DDC-4FC0-B533-C5D9684EFC94","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.1043990929705214},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":1.3021995464852607,"slideTitle":"スライド #1395","title":"シーン 1395","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1395_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1395.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「でも私は…」","id":"C2ED8EFA-43B1-428E-809E-A735A768B201","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":1.3021995464852607},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.695215419501134,"slideTitle":"スライド #1396","title":"シーン 1396","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1396_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1396.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女が発したその言葉にさとりとともに驚く。","id":"23DAA9AD-0639-4ADF-816F-7566A1259C4D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.695215419501134},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":8.185986394557823,"slideTitle":"スライド #1397","title":"シーン 1397","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1397_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1397.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/嫉妬.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"私は、彼女が私よりも、彼を選んだことに、複雑な感情が湧き上がる。悔しい、嫉妬、欲望…私は感情の波に飲まれそうだった。","id":"30CEA233-94F7-4F83-911B-390FC6484933","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":8.185986394557823},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.0613832199546485,"slideTitle":"スライド #1398","title":"シーン 1398","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1398_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1398.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「とりあえず、一旦外に出て、国際通りを歩きましょ。」","id":"0C24D1D9-29D1-458C-A483-BC1EA85EAFB5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":3.0613832199546485},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.1778231292517005,"slideTitle":"スライド #1399","title":"シーン 1399","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1399_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1399.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（不満）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「そうですね…、ついでに夜のお店も探しますか…。」","id":"EF2BA67F-9F25-401A-92F4-2D7AD7A5B791","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.1778231292517005},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":5.8939909297052155,"slideTitle":"スライド #1400","title":"シーン 1400","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1400_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1400.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「夜のお店？どういう意味ですか、それ？」\n私は、彼の発言に対して、そう思わずつぶやいてしまう。","id":"83C7A2CB-E454-4AED-B090-07170C1F376C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":5.8939909297052155},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":5.2358956916099775,"slideTitle":"スライド #1401","title":"シーン 1401","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1401_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1401.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「夜ご飯食べるお店じゃないの？」\n私は、そう彼に聞く。","id":"71E22B4A-4008-4B7F-9480-B4242E82C2BD","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":5.2358956916099775},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":3.2212925170068027,"slideTitle":"スライド #1402","title":"シーン 1402","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1402_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1402.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（驚く）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ええ、そうですよ。それじゃあ、行きますか？」","id":"1C170E58-FE50-4FF3-816F-22253CB3E3D0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.2212925170068027},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image61.jpeg","bgmStartTimeOffset":0,"duration":4.78469387755102,"slideTitle":"スライド #1403","title":"シーン 1403","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1403_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image61.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1403.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「それじゃあ、出かけますか…」\n私は、二人の反応に呆れ、そのまま外に出るのだった。","id":"AE27BD3C-9D3C-49AE-89B5-5C01D5142062","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":4.78469387755102},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1404","title":"シーン 1404: それから…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1404.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"それから…","id":"9E2DD84E-9484-4886-9B6A-F319CB831395","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":8.7278231292517,"slideTitle":"スライド #1405","title":"シーン 1405","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1405_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1405.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"それから僕たちは、国際通りを散策していると、夕日が差し込む時間帯になっていた。僕は、3人にどんなお店がいいか聞く。","id":"41BDD002-8FA3-45F3-B6CD-F78F5C3EE795","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.7278231292517},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":3.7039002267573697,"slideTitle":"スライド #1406","title":"シーン 1406","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1406_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1406.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「アリスさんは、この通り沿いなら、どのお店がいいですか？」","id":"F8E74BCB-2EEF-47CA-9BDC-6F4C29F7CB5B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.7039002267573697},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":3.114036281179138,"slideTitle":"スライド #1407","title":"シーン 1407","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1407_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1407.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「私は…、今日はそんなに長居せず、ホテルに戻りたいわ。」","id":"E9E1547A-3511-4EBD-8B1A-A4A277F3343B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":3.114036281179138},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":2.4473696145124717,"slideTitle":"スライド #1408","title":"シーン 1408","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1408_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1408.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それで、さとりさんと、こいしは？」","id":"68C29AE6-4B12-42AF-A413-BBB767D4153C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.4473696145124717},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":4.998321995464853,"slideTitle":"スライド #1409","title":"シーン 1409","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1409_古明地こいし.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1409.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/こいし（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2B53","characterName":"古明地こいし","telop":"「私は、昼寝もとったし、長くなっても大丈夫だよ。」","id":"7BA0BEF3-BEE1-4CAF-A5E6-5EFA9D841484","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地こいし","voiceDuration":4.998321995464853},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":2.3111791383219953,"slideTitle":"スライド #1410","title":"シーン 1410","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1410_古明地さとり.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1410.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/さとり（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_C52B","characterName":"古明地さとり","telop":"「私は…、紅夢さんとアリスさんに合わせます。」","id":"098D7D20-B227-4880-AB1E-03CDBE321583","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"古明地さとり","voiceDuration":2.3111791383219953},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":2.111904761904762,"slideTitle":"スライド #1411","title":"シーン 1411","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1411_アリス・マーガトロイド.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1411.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_2DB3","characterName":"アリス・マーガトロイド","telop":"「あの…、なぜ、こいしさんだけ呼び捨て…」","id":"7BFBE4BE-6BDB-4590-BD5F-58B3127D054A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"アリス・マーガトロイド","voiceDuration":2.111904761904762},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc283171_商店街（夕方）.jpg","bgmStartTimeOffset":0,"duration":3.1278231292517007,"slideTitle":"スライド #1412","title":"シーン 1412","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1412_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc283171_商店街（夕方）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1412.jpeg","voiceStartTimeOffset":0,"bgmName":"