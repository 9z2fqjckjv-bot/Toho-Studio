audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"すると、今度ははっきりと、二人の様子が見える。「これは、緊急事態ね…」私はそう言いながら、電話をかける。","id":"AE00E455-9127-4398-A115-FEA2B09787D1","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.583832199546485},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #1006","title":"シーン 1006: フランに視点が写り…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示：1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1006.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"フランに視点が写り…","id":"7E80D882-760E-49D3-B33F-DEEA00608D0E","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image55.jpeg","bgmStartTimeOffset":0,"duration":10.006984126984127,"slideTitle":"スライド #1007","title":"シーン 1007","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1007_フランドール・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"image55.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1007.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/影あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_1A94","characterName":"フランドール・スカーレット","telop":"私は、それから、数十分の間、待っていたが、一向に彼が戻ってくる気配を感じず、探しにいくべきか、迷っていた。","id":"668E1C06-CD24-429B-8CC4-724B782561CC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","voiceDuration":10.006984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynot