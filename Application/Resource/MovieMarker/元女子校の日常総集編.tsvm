Volume":0.7,"seName":"[SE] 海岸1.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1322.jpeg","voiceDuration":8.038684807256235,"seVolume":0.1530708016074449},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","id":"ED73FA18-4DDD-481F-B843-0538F7C4F277","seStartTimeOffset":-143.6396825396805,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1323_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"image59.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/image59.jpeg","telop":"すると、彼女は足早に車に戻って行った。「えっ…」\n僕は、そう呟いてから、再びくしゃみをすると、車に戻った。","voiceCharacter":"操夢","duration":8.549546485260771,"title":"シーン 1323","slideTitle":"スライド #1323","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"[SE] 海岸1.mp3","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1323.jpeg","voiceDuration":8.549546485260771,"seVolume":0.1530708016074449},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/車のエンジンをかける1.mp3","id":"2BCE86C9-E2F2-42C1-945C-318DB4056D3A","seStartTimeOffset":7.68,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1324_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc284290_自動車の車内（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","telop":"僕は、車に戻ると、元々座っていた助手席に座り、シートベルトを締める。そして、彼女はそれから車のエンジンをつける。","voiceCharacter":"操夢","duration":8.934331065759638,"title":"シーン 1324","slideTitle":"スライド #1324","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"seName":"SE: 車のエンジンをかける1","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1324.jpeg","voiceDuration":8.934331065759638,"seVolume":0.85},{"id":"6404EDDE-34CD-4824-870B-2C8AD0143650","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1325_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc284290_自動車の車内（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc284290_自動車の車内（日中）.jpg","telop":"それから、海中道路を一度渡り切り、Uターンして戻る。\nその最中、彼女が、心配そうな声で、僕に話しかける。","voiceCharacter":"操夢","duration":8.745215419501134,"title":"シーン 1325","slideTitle":"スライド #1325","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1325.jpeg","voiceDuration":8.745215419501134,"seVolume":1},{"id":"8B70851F-CE4B-433F-9AF0-5BB866A7BD46","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/アリス（困り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1326_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc284290_自動車の車内（日中）.jpg","backg