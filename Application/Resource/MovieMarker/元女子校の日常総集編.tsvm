ed\/元女子校の日常総集編\/永琳（怒り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2066_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc166698_病院の診察室.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","telop":"「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。","voiceCharacter":"八意永琳","duration":9.633718820861677,"title":"シーン 2066","slideTitle":"スライド #2066","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2066.jpeg","voiceDuration":9.633718820861677,"seVolume":1},{"id":"F686FD28-B58E-480D-B072-5741B569683B","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/永琳（怒り）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2067_八意永琳.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc166698_病院の診察室.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","telop":"実は、それは彼の出生に関わる秘密情報でもあり、しかもその情報を以前、彼を担当してた医者からは聞いてないものだった。","voiceCharacter":"八意永琳","duration":9.381836734693877,"title":"シーン 2067","slideTitle":"スライド #2067","characterName":"八意永琳","audioTrack":"track_voice_char_F1CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.2067.jpeg","voiceDuration":9.381836734693877,"seVolume":1},{"id":"46178055-5AE6-4684-BB57-8A95D448BBC9","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSS