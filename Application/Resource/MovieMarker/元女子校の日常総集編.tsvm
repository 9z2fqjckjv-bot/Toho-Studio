imationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1143_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256899_病室-夜-電気あり.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256899_病室-夜-電気あり.png","telop":"僕は、彼女が病室を出ると、一人考える。「過去を克服しないと…」僕は、ある一種の不安を感じながら、そう呟いた。","voiceCharacter":"操夢","duration":8.75172335600907,"title":"シーン 1143","slideTitle":"スライド #1143","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1143.jpeg","voiceDuration":8.75172335600907,"seVolume":1},{"id":"D97DC0AD-4497-4CB5-9917-A294F105730D","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間：1.5秒","telop":"翌朝…","duration":1.5,"title":"シーン 1144: 翌朝…","slideTitle":"スライド #1144","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1144.jpeg","seVolume":1},{"id":"C86AE708-8A05-4959-B7E6-B4987DFEEBB4","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1145_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"僕は、朝がやってくると、病室で朝食をとり、そのまま教室に入った。そして、席に着き、身の回りを整える。","voiceCharacter":"操夢","duration":8.60063492063492,"title":"シーン 1145","slideTitle":"スライド #1145","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1145.jpeg","voiceDuration":8.60063492063492,"seVolume":1},{"id":"BF56913B-65E7-493E-94C4-29F1A987807E","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1146_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"すると、教室の扉が開き、彼女が僕の席にやってくる。\n「あの、どうしたんですか？」","voiceCharacter":"操夢","duration":6.164761904761905,"title":"シーン 1146","slideTitle":"スライド #1146","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1146.jpeg","voiceDuration":6.164761904761905,"seVolume":1},{"id":"0CDDEBE8-82B8-4AFC-84EF-8FEDACECA0F0","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/咲夜（困る）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1147_十六夜咲夜.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「ついさっき、あなたのお弁当が届けられたので…」\n私はそう言いながら、受け取った弁当を置く。","voiceCharacter":"十六夜咲夜","duration":5.313197278911565,"title":"シーン 1147","slideTitle":"スライド #1147","characterName":"十六夜咲夜","audioTrack":"track_voice_