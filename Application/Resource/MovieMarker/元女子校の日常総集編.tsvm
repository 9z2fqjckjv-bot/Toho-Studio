5963718820865},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #771","title":"シーン 771: その頃、彼が元いた家では…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.771.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"その頃、彼が元いた家では…","id":"D1BF95B8-A7E1-43B9-93DF-6337539B638D","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":10.071995464852607,"slideTitle":"スライド #772","title":"シーン 772","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_772_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.772.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私は、家に帰ってくるとため息をつく。例の騒動を鎮静化させる代わりに、魔理沙の面倒を私と彼で見ることになったからだ。","id":"91973BFC-1C96-4C7B-9425-8F4052FD1054","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.071995464852607},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","bgmStartTimeOffset":0,"duration":7.081995464852608,"slideTitle":"スライド #773","title":"シーン 773","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_773_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.773.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「私の母校は昔から何も変わってないわね…」\n私がそう呟いていると、インターホンが鳴る。","id":"33530D8F-BF2C-4F82-B222-462441BEF800","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":7.081995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","bgmStartTimeOffset":0,"duration":11.339478458049886,"slideTitle":"スライド #774","title":"シーン 774","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_774_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.774.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私が外に出ると、書留郵便物の受け渡しだった。しかも、発送日時が数時間前になっていて、即日夜間速達の印があった。","id":"C215AFE3-3262-4AB4-8088-A807AD37894B","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":11.339478458049886},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","bgmStartTimeOffset":0,"duration":9.014489795918367,"slideTitle":"スライド #775","title":"シーン 775","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_775_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.775.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"即日夜間速達は、高い料金と引き換えに、夕方から夜にかけて出せば、日付が変わる前に届くと言うものだ。","id":"0DE5A4D4-B1B2-47A5-98B7-472AB8BCD91F","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.014489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","bgmStartTimeOffset":0,"duration":10.690748299319727,"slideTitle":"スライド #776","title":"シーン 776","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_776_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.776.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私は、ふとその封筒の宛名を見る。そこには、私と夫の名前があり、差出人には…ある建設会社の代表の名前があった。","id":"B2997AB2-345A-4E3B-8F23-27C8E7A57ED7","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.690748299319727},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/nc235081_家（夜・灯りあり）.jpg","bgmStartTimeOffset":0,"duration":2.926984126984127,"slideTitle":"スライド #777","title":"シーン 777","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_777_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.777.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私はふと、昨晩のことを思い出す。","id":"51AF3478-D77F-4BCB-B251-1E584CEA3068","seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":2.926984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":9.013242630385488,"slideTitle":"スライド #778","title":"シーン 778","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_778_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.778.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」","id":"AE32FC5E-FD46-4804-AF0B-0B528A9CA5B9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":9.013242630385488},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":5.181746031746032,"slideTitle":"スライド #779","title":"シーン 779","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_779_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.779.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_30CA","characterName":"レミリア・スカーレット","telop":"「実は、あなたの息子さんの将来に関わることで、\n折行ってご相談がありまして…」","id":"3D8D299C-B026-497A-ABA9-850C0A646726","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","voiceDuration":5.181746031746032},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":1.696984126984127,"slideTitle":"スライド #780","title":"シーン 780","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_780_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.780.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「何の相談ですか？」","id":"5AB437AE-ED2B-4D86-9A3C-F8B074E3A403","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":1.696984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","bgmStartTimeOffset":0,"duration":0.665079365079365,"slideTitle":"スライド #781","title":"シーン 781","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_781_レミリア・スカーレット.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.781.jpeg","voiceStartTimeOffset":0,"b