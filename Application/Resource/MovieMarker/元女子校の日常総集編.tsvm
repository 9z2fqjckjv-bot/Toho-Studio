","id":"95C1BBA4-C659-4BB3-92FF-5382082132B7","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.169773242630386},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":5.636507936507937,"slideTitle":"スライド #1870","title":"シーン 1870","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1870_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1870.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし見開き目口閉じ.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「ふっ…」僕は、あっけなくラベルが取れてしまうその有様に、思わず苦笑してしまう。","id":"56737CA2-398B-496F-BEB9-50381C7CBA49","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.636507936507937},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":4.551995464852608,"slideTitle":"スライド #1871","title":"シーン 1871","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1871_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1871.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし普通.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「ほら、ラベルも取れて、巻末のページももとに戻ったぞ。」","id":"AB00FD83-35D6-49BF-AF9E-4ACD5D0BF412","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":4.551995464852608},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":8.558253968253968,"slideTitle":"スライド #1872","title":"シーン 1872","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1872_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1872.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし普通.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、彼女がそう言いながら、渡された本を見て、ある問題に気がつく。「魔理沙さん…これ…」僕はそう言いながら本を渡す。","id":"D31DF21C-6EFF-45FB-BA9B-770BD85DC9F5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.558253968253968},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"duration":10.220748299319729,"slideTitle":"スライド #1873","title":"シーン 1873","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1873_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"一人部屋３（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.1873.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/魔理沙帽子箒なし影あり苦笑.png","voice2StartTimeOffset":0,"audioT