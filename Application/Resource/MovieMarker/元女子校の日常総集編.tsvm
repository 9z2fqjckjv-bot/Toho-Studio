set":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（驚く）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_818_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc196979_食堂(昼).png","telop":"それから僕が二人に告げた、ある内容に二人は驚くのだった。","voiceCharacter":"操夢","duration":4.05281179138322,"title":"シーン 818","slideTitle":"スライド #818","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.818.jpeg","voiceDuration":4.05281179138322,"seVolume":1},{"id":"00D7E72B-D3C5-4208-AE6E-967EAE73C42A","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"それから…","duration":1.5,"title":"シーン 819: それから…","slideTitle":"スライド #819","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.819.jpeg","seVolume":1},{"id":"F4D4D55D-C940-4AF1-AC4E-C276FC1FDD46","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_820_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"それから、僕は、朝食を食べ終えて、身支度を整えると、フランに図書館の場所を聞いて、やってきた。そしてある本を探す。","voiceCharacter":"操夢","duration":8.723469387755102,"title":"シーン 820","slideTitle":"スライド #820","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.820.jpeg","voiceDuration":8.723469387755102,"seVolume":1},{"id":"E8343659-6D90-4A45-938D-E6B2A7B8B4B3","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_821_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","telop":"それから、目的の本がありそうな棚を見つけ、その棚をはじから見ていく。「あった。」僕はそう言い、その本を取り出し戻る。","voiceCharacter":"操夢","duration":8.591950113378685,"title":"シーン 821","slideTitle":"スライド #821","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.821.jpeg","voiceDuration":8.591950113378685,"seVolume":1},{"id":"5A1C3DC6-88BC-4240-9FCE-48E7B19802B0","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_822_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","telop":"そして、取り出した本は、「全国財閥高統一模試」の過去問集だった。そして、フランにもらった新品のノートを開く。","voiceCharacter":"操夢","duration":8.318027210884354,"title":"シーン 822","slideTitle":"スライド #822","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2St