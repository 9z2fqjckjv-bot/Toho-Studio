eOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「どうしたの、お姉様…」","voiceCharacter":"フランドール・スカーレット","duration":2.019478458049887,"title":"シーン 699","slideTitle":"スライド #699","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.699.jpeg","voiceDuration":2.019478458049887,"seVolume":1},{"id":"8DA91E60-22D7-46A8-92C7-2A5FD83792FE","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_700_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「彼の母親と契約して、彼を引き取りに来たのよ。」","voiceCharacter":"レミリア・スカーレット","duration":3.450498866213152,"title":"シーン 700","slideTitle":"スライド #700","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.700.jpeg","voiceDuration":3.450498866213152,"seVolume":1},{"id":"04ACAD65-EAC6-4882-A3A6-0837172DC858","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_701_フランドール・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「え…、それって…これからあの屋敷で彼と住むってこと？」","voiceCharacter":"フランドール・スカーレット","duration":4.173242630385488,"title":"シーン 701","slideTitle":"スライド #701","characterName":"フランドール・スカーレット","audioTrack":"track_voice_char_1A94","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.701.jpeg","voiceDuration":4.173242630385488,"seVolume":1},{"id":"FA306245-1FEF-41E8-9B14-7DB2B7A4B3D2","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_702_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「ええそのとおり。それで、紅夢くんは、\n荷物と部屋の整理にどれくらいの時間がかかるかしら？」","voiceCharacter":"レミリア・スカーレット","duration":5.992154195011338,"title":"シーン 702","slideTitle":"スライド #702","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.702.jpeg","voiceDuration":5.992154195011338,"seVolume":1},{"id":"81CF6DBC-B569-4563-9129-09124E2B1254","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_703_操夢.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「えっと…」僕は、レミリアの発言に戸惑ってしまう。","voiceCharacter":"操夢","duration":3.6049886621315195,"title":"シーン 703","slideTitle":"スライド #703","characterName":"操夢","audioTrack":"track_voice_soumu","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.703.jpeg","voiceDuration":3.6049886621315195,"seVolume":1},{"id":"AA20F972-462F-4BED-80FF-6342E401119C","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_704_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「もし、時間がかかるなら、私もお手伝いするわ。それで、どうかしら？できれば、今日の夕方には屋敷宛に発送したいけど…」","voiceCharacter":"レミリア・スカーレット","duration":8.873401360544218,"title":"シーン 704","slideTitle":"スライド #704","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.704.jpeg","voiceDuration":8.873401360544218,"seVolume":1},{"id":"EF0325B7-F557-472F-9692-C4D1FFE5DD2F","seStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_705_レミリア・スカーレット.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"ペーストされた画像.tiff","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ペーストされた画像.tiff","telop":"「じゃあ、それでお願いします…」\nそれから、僕と彼女たちは引っ越しの作業を進めるのだった。","voiceCharacter":"レミリア・スカーレット","duration":5.814489795918368,"title":"シーン 705","slideTitle":"スライド #705","characterName":"レミリア・スカーレット","audioTrack":"track_voice_char_30CA","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.705.jpeg","voiceDuration":5.814489795918368,"seVolume":1},{"id":"FFAB6B46-2CEA-49A6-8062-E5120F2216B1","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":1.5,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"単色背景","animationNote":"表示時間:1.5秒","telop":"一方、魔理沙は…","duration":1.5,"title":"シーン 706: 一方、魔理沙は…","slideTitle":"スライド #706","characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.706.jpeg","seVolume":1},{"id":"36872800-6BF9-4DFD-9C2F-5950468F73BA","seStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_707_霧雨魔理沙.wav","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundName":"nc256896_病室-昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256896_病室-昼.png","telop":"私は、ふと目が覚めると、そこは病院だった。\nすると、誰かが入ってくる。","voiceCharacter":"霧雨魔理沙","duration":6.425736961451247,"title":"シーン 707","slideTitle":"スライド #707","characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","bgmVolume":0.7,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cac