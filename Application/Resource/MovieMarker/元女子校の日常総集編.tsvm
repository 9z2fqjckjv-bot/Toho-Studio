},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.4332199546485263,"slideTitle":"スライド #101","title":"シーン 101","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_101_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.101.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「それじゃあ、今から時間測るから、走ってみなさい。」","id":"AA64F1D9-968D-493B-8C9C-E684395F90E3","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":2.4332199546485263},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":4.813673469387755,"slideTitle":"スライド #102","title":"シーン 102","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_102_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.102.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「はい…」僕はそう言うと、\n校庭に引かれた線に沿って、走り始める。","id":"78C97FCC-A394-4237-A5EC-6026FEACA25A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.813673469387755},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #103","title":"シーン 103: 彼が1500m走を完走すると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.103.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼が1500m走を完走すると…","id":"25D5826D-90C0-48D9-92F4-5CEA07F1DF7F","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.56031746031746,"slideTitle":"スライド #104","title":"シーン 104","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_104_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.104.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「君、そこら辺の女子よりも、足が遅いんじゃないか？」\n私は、手元の腕時計を見ながら言う、あれから10分がたった。","id":"8698B619-3ED0-46CD-9BB4-99156E7F718C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.56031746031746},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.255147392290249,"slideTitle":"スライド #105","title":"シーン 105","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_105_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.105.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「これだと、女子相手に情けない男になるぞ、どうだ、もう一走りして、今度は…8分目安にするのはどうだ？」","id":"9EAD49AF-7EC9-49E7-9429-9A111C0B7229","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.255147392290249},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":8.553900226757369,"slideTitle":"スライド #106","title":"シーン 106","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_106_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.106.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「じゃあ、もう一走りしますか…」僕は、彼女の理屈が通っているように感じ、何らかのプライドが刺激されたか、そう呟く。","id":"1A8E6DB7-B072-4EB1-AD6A-2D9580ED52F9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.553900226757369},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":2.729342403628118,"slideTitle":"スライド #107","title":"シーン 107","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_107_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.107.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「そうだ、その意気込みで、8分切れるように走ってみなさい。」","id":"F7FCD51C-F9A2-4FB1-A14D-2449F3D8F6DE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":2.729342403628118},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":3.2865079365079364,"slideTitle":"スライド #108","title":"シーン 108","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_108_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.108.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は彼女にそう言われると、再び走り始める。","id":"DD3C05F8-0B75-47EE-95E6-4A216C9E633B","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.2865079365079364},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #109","title":"シーン 109: 彼がもう一走りをすると…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.109.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼がもう一走りをすると…","id":"4A2BBC7E-CAEF-44FF-8DB3-754992247154","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":4.270068027210884,"slideTitle":"スライド #110","title":"シーン 110","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_110_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.110.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「さっきよりは良くなったか…」\n私は、手元の腕時計を見る。あれから9分弱が経っていた。","id":"D5FACB14-C1EF-4E90-9102-88C81AE2A52C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":4.270068027210884},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.2411111111111115,"slideTitle":"スライド #111","title":"シーン 111","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_111_美鈴.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.111.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/美鈴（困る）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_21A0","characterName":"美鈴","telop":"「とりあえず、これで今日はおしまいにしよう、今度の体育では、同じトラックで女子と競争になるから、覚悟するのだぞ。」","id":"B19C15A5-8D17-4BA4-8D8F-76869539B050","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"美鈴","voiceDuration":5.2411111111111115},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":7.504988662131519,"slideTitle":"スライド #112","title":"シーン 112","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_112_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.112.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそう言うと、そのまま何かを呟きながら、去っていった。\n僕は、その場でしゃがみ込んで、休みを取る。","id":"B754AF9C-F1AB-4883-85DA-931EEF440B26","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.504988662131519},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":6.422380952380952,"slideTitle":"スライド #113","title":"シーン 113","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_113_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.113.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"すると、走ってた時には感じなかった痛みが僕を襲う。\nどうやら、無理強いをしていたようだった。","id":"27B453F1-3D98-4F38-8E40-15E1968EEDF3","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.422380952380952},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":8.239773242630385,"slideTitle":"スライド #114","title":"シーン 114","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_114_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.114.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、彼女の言葉は事実を述べているだけなので、何もいえず、ただ一人、校庭で俯きながら、考え込む僕だった。","id":"5A898AEF-CCEB-417E-AE53-D4C71E65A7D0","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.239773242630385},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/ColabGPU_1791199901_67118.png","bgmStartTimeOffset":0,"duration":5.761519274376417,"slideTitle":"スライド #115","title":"シーン 115","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_115_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"ColabGPU_1791199901_67118.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.115.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、立ちあがろうとしたその時、\n僕の全身がぐらつき、そのまま倒れ込むのだった。","id":"55F1E220-E300-4645-AA89-5F3CB7832DB5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.761519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":3.814761904761905,"slideTitle":"スライド #116","title":"シーン 116","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_116_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.116.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「んっ…ここは…」僕はふと目が覚めると、そう呟く。","id":"E6A39ED7-768C-4CCC-8033-8C7EF1AF14CA","seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.814761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":2.876984126984127,"slideTitle":"スライド #117","title":"シーン 117","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_117_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.117.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「おや、目が覚めたかい…、紅夢君…」","id":"B9095557-4218-491A-9B30-0648A507A30D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":2.876984126984127},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":3.316938775510204,"slideTitle":"スライド #118","title":"シーン 118","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_118_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.118.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「あなたは…魔理沙さんですか…母の友達の…」","id":"51AC04D5-6ADC-48C0-988C-3DD68D482DA9","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.316938775510204},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":2.4344897959183673,"slideTitle":"スライド #119","title":"シーン 119","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_119_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.119.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「ああ…そうだ…。それより…」","id":"7FCD4B5E-3FF3-434E-B181-9FF453EB16FA","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":2.4344897959183673},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":2.5930385487528347,"slideTitle":"スライド #120","title":"シーン 120","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_120_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.120.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「何か、言いたいことでもあるのですか？」","id":"EBB40869-CBF1-444B-921D-C4A9D95838F6","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":2.5930385487528347},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":5.118231292517007,"slideTitle":"スライド #121","title":"シーン 121","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_121_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.121.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","id":"16103223-365A-4593-BBF8-77291EF14B98","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":5.118231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":6.027823129251701,"slideTitle":"スライド #122","title":"シーン 122","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_122_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.122.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","id":"5C94EA2F-87D1-46B9-B572-5354592CACEC","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.027823129251701},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":7.018231292517007,"slideTitle":"スライド #123","title":"シーン 123","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_123_霧雨魔理沙.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.123.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/箒あり困った笑み.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","id":"E67140B9-DEA9-4A6B-81DE-E77EDA321579","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"霧雨魔理沙","voiceDuration":7.018231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":5.20498866213152,"slideTitle":"スライド #124","title":"シーン 124","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_124_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.124.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","id":"5EA95824-C89A-4013-937C-6B7452B4A317","seVolume":1,"voiceCharacter":"操夢","voiceDuration":5.20498866213152},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":3.490861678004535,"slideTitle":"スライド #125","title":"シーン 125","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_125_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.125.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","id":"A91D3B73-E965-4551-A53E-19EDD4F2C368","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":3.490861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":6.755736961451247,"slideTitle":"スライド #126","title":"シーン 126","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_126_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.126.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","id":"880551B9-41F6-42F4-ACA4-C619BE2CA543","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":6.755736961451247},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":6.414761904761905,"slideTitle":"スライド #127","title":"シーン 127","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_127_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.127.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","id":"EAC17005-47BB-49FB-880A-7C11CD2F6FF0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.414761904761905},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":3.9094784580498865,"slideTitle":"スライド #128","title":"シーン 128","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_128_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.128.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「それに…最近…魔理沙の様子が変なのよね…」","id":"D3AD664D-B318-41E2-BAC9-029BF6EE6666","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":3.9094784580498865},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":6.35172335600907,"slideTitle":"スライド #129","title":"シーン 129","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_129_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.129.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/j.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","id":"A357F801-32C5-4E90-A9D6-4D98CE8A8178","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.35172335600907},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":10.184489795918367,"slideTitle":"スライド #130","title":"シーン 130","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_130_博麗霊夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.130.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/霊夢（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_reimu","characterName":"博麗霊夢","telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","id":"B9D5D29C-ADE5-40EF-AC84-FAA1BF1F403A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"博麗霊夢","voiceDuration":10.184489795918367},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":6.690861678004535,"slideTitle":"スライド #131","title":"シーン 131","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_131_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.131.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","id":"8105D15B-D3B2-475E-8AEA-8FD8BB917F32","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.690861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc256897_病室-夕方-電気あり.png","bgmStartTimeOffset":0,"duration":4.321292517006802,"slideTitle":"スライド #132","title":"シーン 132","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_132_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"nc256897_病室-夕方-電気あり.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.132.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","id":"581B2B43-14BE-4D9A-A751-4AA28C55FA14","seVolume":1,"voiceCharacter":"操夢","voiceDuration":4.321292517006802},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #133","title":"シーン 133: 附属病院のある診察室では…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.133.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"附属病院のある診察室では…","id":"7A1862A7-F2D7-4C0C-B58B-2FEF5CD30908","seVolume":1},{"bgmStartTimeOffset":0,"duration":5.903537414965986,"slideTitle":"スライド #134","title":"シーン 134","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_134_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.134.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","id":"B3A40D6F-7FA3-4949-9D98-33F48992238C","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":5.903537414965986},{"bgmStartTimeOffset":0,"duration":10.509183673469387,"slideTitle":"スライド #135","title":"シーン 135","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_135_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.135.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","id":"B1FFAEB4-6F81-4861-A53B-D551A003340A","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":10.509183673469387},{"bgmStartTimeOffset":0,"duration":8.210839002267575,"slideTitle":"スライド #136","title":"シーン 136","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_136_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.136.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","id":"832AFB24-C2A6-469B-B7DD-2CE845B7204D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.210839002267575},{"bgmStartTimeOffset":0,"duration":9.902108843537414,"slideTitle":"スライド #137","title":"シーン 137","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_137_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.137.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","id":"AA5C0873-E53B-4BAB-898C-58066995EC69","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":9.902108843537414},{"bgmStartTimeOffset":0,"duration":9.371814058956916,"slideTitle":"スライド #138","title":"シーン 138","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_138_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.138.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","id":"EB633CAA-A5D7-49F5-9DBD-1645B2E098A0","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":9.371814058956916},{"bgmStartTimeOffset":0,"duration":8.214489795918368,"slideTitle":"スライド #139","title":"シーン 139","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_139_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.139.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","id":"06280859-9E27-4656-BE77-D43165C8A010","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.214489795918368},{"bgmStartTimeOffset":0,"duration":7.111587301587302,"slideTitle":"スライド #140","title":"シーン 140","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_140_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.140.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。","id":"B74E0A7D-F945-482A-816A-28AD4E9637AE","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":7.111587301587302},{"bgmStartTimeOffset":0,"duration":8.62358276643991,"slideTitle":"スライド #141","title":"シーン 141","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_141_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.141.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」","id":"535B6AC3-ABDB-483D-800C-2B35A4B3D848","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":8.62358276643991},{"bgmStartTimeOffset":0,"duration":7.600181405895691,"slideTitle":"スライド #142","title":"シーン 142","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_142_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.142.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」","id":"90FAD8AD-1BC0-4868-9770-6BDEF4C50AF5","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":7.600181405895691},{"bgmStartTimeOffset":0,"duration":3.6015873015873017,"slideTitle":"スライド #143","title":"シーン 143","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_143_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.143.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（微笑）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「それと、息子さんの言ってたことは全て事実だそうですよ。」","id":"A779C864-8653-479A-B1E4-D0966A62F84F","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":3.6015873015873017},{"bgmStartTimeOffset":0,"duration":8.235374149659863,"slideTitle":"スライド #144","title":"シーン 144","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_144_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.144.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。","id":"5011836F-9EC6-4022-AC11-D4895D6EE1C8","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.235374149659863},{"bgmStartTimeOffset":0,"duration":4.105578231292517,"slideTitle":"スライド #145","title":"シーン 145","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_145_射命丸文.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.145.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/文（余裕）.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_EF7A","characterName":"射命丸文","telop":"「代金、確かにいただきました。それでは、またのご利用を。」","id":"72885777-FDEF-4335-9313-0CF3DC0C7C6D","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"射命丸文","voiceDuration":4.105578231292517},{"bgmStartTimeOffset":0,"duration":7.0875963718820865,"slideTitle":"スライド #146","title":"シーン 146","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_146_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.146.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」","id":"5C33B97E-48A9-48F5-9C69-6162AF6D2526","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":7.0875963718820865},{"bgmStartTimeOffset":0,"duration":8.360249433106576,"slideTitle":"スライド #147","title":"シーン 147","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_147_八意永琳.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.147.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/nc166698_病院の診察室.png","voice2StartTimeOffset":0,"audioTrack":"track_voice_char_F1CA","characterName":"八意永琳","telop":"私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。","id":"1CE1EC5F-E91A-437E-BA17-A7A8E2B7F896","seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"八意永琳","voiceDuration":8.360249433106576},{"animationDuration":1.5,"bgmStartTimeOffset":0,"duration":1.5,"slideTitle":"スライド #148","title":"シーン 148: 彼に視点が戻り…","animationName":"なし","bgmVolume":0.65,"animationNote":"表示時間:1.5秒","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.148.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","telop":"彼に視点が戻り…","id":"ED34555E-09CF-4A3F-957C-E599D96925D2","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":9.281065759637189,"slideTitle":"スライド #149","title":"シーン 149","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_149_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.149.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…","id":"29775F15-E64C-4238-BC9C-C9BC7FD32604","seVolume":1,"voiceCharacter":"操夢","voiceDuration":9.281065759637189},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":8.397369614512472,"slideTitle":"スライド #150","title":"シーン 150","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_150_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.150.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。","id":"0E8D11FE-59C0-4C5F-9812-838C7CF12370","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.397369614512472},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":8.261519274376417,"slideTitle":"スライド #151","title":"シーン 151","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_151_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.151.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。","id":"FD739CED-6D67-4410-86C3-A545B1DF89E9","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.261519274376417},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":8.697369614512471,"slideTitle":"スライド #152","title":"シーン 152","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_152_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.152.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。","id":"92A4ED78-83DE-42E1-A94E-799944821539","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.697369614512471},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":8.525646258503402,"slideTitle":"スライド #153","title":"シーン 153","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_153_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.153.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。","id":"D0FA6252-4C89-4D35-96C9-72AB8715EBA0","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.525646258503402},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":7.856077097505669,"slideTitle":"スライド #154","title":"シーン 154","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_154_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.154.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。","id":"5C0BB5E1-ACF6-426F-82DC-E2F452910835","seVolume":1,"voiceCharacter":"操夢","voiceDuration":7.856077097505669},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":6.240861678004535,"slideTitle":"スライド #155","title":"シーン 155","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_155_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.155.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。","id":"5EA4D403-5954-44D0-9121-A3A98F94E7BE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":6.240861678004535},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":8.803900226757369,"slideTitle":"スライド #156","title":"シーン 156","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_156_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.156.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。","id":"DBD6BEDD-8E47-4C89-B519-1680447ABEE5","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.803900226757369},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":8.601723356009071,"slideTitle":"スライド #157","title":"シーン 157","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_157_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.157.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…","id":"BA3A09C1-5D28-430D-A8FB-93F0C4ECD1BF","seVolume":1,"voiceCharacter":"操夢","voiceDuration":8.601723356009071},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常総集編\/教室の前の方（日中）.jpg","bgmStartTimeOffset":0,"duration":0.9778231292517007,"slideTitle":"スライド #158","title":"シーン 158","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_158_操夢.wav","bgmVolume":0.65,"transitionName":"なし","backgroundName":"教室の前の方（日中）.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常総集編_6ce7fe1ac7\/元女子校の日常総集編_6ce7fe1ac7.158.jpeg","voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","seStartTimeOffset":0,"voice2StartTimeOffset":0,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"そう、それは…","id":"4FCAF8F0-2E37-426F-B233-9386135E76AE","seVolume":1,"voiceCharacter":"操夢","voiceDuration":0.9778231292517007},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_e