nimationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","slideTitle":"第79スライド","voiceDuration":7.254489795918367,"bgmName":"BGM: 東方妖恋談","title":"シーン 79","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.079.jpeg","id":"F72079D7-E416-460E-AC9F-164E58C932B4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"蘭","transitionName":"クロスディゾルブ","characterName":"蘭","duration":5.9,"audioTrack":"track_voice_%E8%98%AD","telop":"蘭は、印刷されたネットニュース記事をそう言いながら渡す。\nそのニュース記事には、あの記者会見は嘘つきだと書かれていた。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","slideTitle":"第80スライド","voiceDuration":1.7278231292517008,"bgmName":"BGM: 東方妖恋談","title":"シーン 80","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.080.jpeg","id":"2AF8B316-9D15-4173-899C-FCC6A257E134","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"蘭","transitionName":"クロスディゾルブ","characterName":"蘭","duration":3.5,"audioTrack":"track_voice_%E8%98%AD","telop":"「紫様…、これは文が紫様を裏切った…と言うことですか？」","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_操夢.wav","slideTitle":"第81スライド","voiceDuration":3.019478458049887,"bgmName":"BGM: 東方妖恋談","title":"シーン 81","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.081.jpeg","id":"12F581B9-3F86-4DE4-A545-DC52AA7A1C79","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","characterName":"八雲紫","duration":5,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","telop":"「ええ、そうなるわね。きっと私たちの見てない隙に、買収されたのよ…、巨漢党の置き土産である彼にね…」","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav","slideTitle":"第82スライド","voiceDuration":5.4484580498866215,"bgmName":"BGM: 東方妖恋談","title":"シーン 82","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.082.jpeg","id":"19D516B8-E87B-43EC-A1A9-170766C70C7E","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","characterName":"八雲紫","duration":5.4,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","telop":"「それと、彼のそばにいる霊夢の動きが見られない以上、彼女も彼に取られたことになるわ…、これは…私の失策よ…」","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_射命丸文.wav","slideTitle":"第83スライド","voiceDuration":4.374489795918367,"bgmName":"BGM: 東方妖恋談","title":"シーン 83","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.083.jpeg","id":"6A4642FC-AF1A-402C-B071-877ED6A362DA","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","characterName":"八雲紫","duration":3.5,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","telop":"私たちがそんな話をしていると、\n誰かが部屋の戸を叩き入ってくる。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Librar