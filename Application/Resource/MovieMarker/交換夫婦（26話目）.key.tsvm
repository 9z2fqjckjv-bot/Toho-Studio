onName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav","slideTitle":"第66スライド","voiceDuration":6.1007482993197275,"bgmName":"BGM: 東方妖恋談","title":"シーン 66","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.066.jpeg","id":"C9CA10A7-A9DB-4AAE-BF47-F7C8E15D5B11","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","characterName":"操夢","duration":4.5,"audioTrack":"track_voice_soumu","telop":"すると、ふと霊夢が僕の腕にもたれかかる感覚を感じ、\nしっかりと支えながら、彼女の正面に回る。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_古明地こいし.wav","slideTitle":"第67スライド","voiceDuration":6.979002267573696,"bgmName":"BGM: 東方妖恋談","title":"シーン 67","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.067.jpeg","id":"12A73631-A06B-40A0-884F-0982B95841AC","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","characterName":"操夢","duration":5.1000000000000005,"audioTrack":"track_voice_soumu","telop":"どうやら、彼女は頭を撫でられているうちに、寝落ちした様だった。僕はその彼女をそっと地面に横たわらせる。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","slideTitle":"第68スライド","voiceDuration":7.221292517006803,"bgmName":"BGM: 東方妖恋談","title":"シーン 68","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.068.jpeg","id":"3BF2A84E-E4E7-4346-B728-D289A706979B","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","characterName":"操夢","duration":5.5,"audioTrack":"track_voice_soumu","telop":"そして、僕は操作盤の前に立ち、先ほどのまでのコードの書き換えを進めていく。そして、数十分すると部屋の扉が開く。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","slideTitle":"第69スライド","voiceDuration":4.953900226757369,"bgmName":"BGM: 東方妖恋談","title":"シーン 69","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.069.jpeg","id":"70BF2911-4D64-4929-ACE1-F242C122A8FD","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","characterName":"操夢","duration":4.7,"audioTrack":"track_voice_soumu","telop":"彼女は何かを言いかけるが、地面で気持ちよく眠る霊夢を見て、何かを思い出したのか、頬を赤らめる。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_古明地さとり.wav","slideTitle":"第70スライド","voiceDuration":3.1411791383219954,"bgmName":"BGM: 東方妖恋談","title":"シーン 70","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.070.jpeg","id":"3FEA4CFD-C4C4-4D28-B43F-9A88D76C3955","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","transitionName":"クロスディゾルブ","characterName":"射命丸文","duration":3.5,"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","telop":"「依頼された記事は…、書き終わって投稿できました…」","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Suppor