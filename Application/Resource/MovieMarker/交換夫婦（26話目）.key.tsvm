groundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","characterName":"操夢","duration":4.5,"audioTrack":"track_voice_soumu","telop":"すると、みとりがやってきて、僕に進捗を聞いてくる。\n僕は、彼女にある程度進んでいると答える。","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_射命丸文.wav","slideTitle":"第90スライド","voiceDuration":4.689591836734694,"bgmName":"BGM: 東方妖恋談","title":"シーン 90","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.090.jpeg","id":"52C5E694-6D1E-4448-8F62-2B626F9ECA99","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","characterName":"操夢","duration":5,"audioTrack":"track_voice_soumu","telop":"僕は、さらに、システムの作り替えを進めていく。\nそして、先方からの連絡が入ると、沖縄を離れるのだった。","animationName":"なし"},{"animationName":"なし","bgmName":"BGM: 東方妖恋談","slideTitle":"中扉","title":"ご視聴ありがとうございました","telop":"","transitionName":"クロスディゾルブ","voiceCharacter":"","duration":20,"backgroundName":"単色背景","characterName":"","id":"AE95B3D1-3645-49A2-A5DC-0B2C8199E1FE","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.091.jpeg"}]