[{"characterName":"八雲紫","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_001_八雲紫.wav","telop":"私が、記者会見中ふと、周りを見ると、橙が私に視線を向けていることに気がつき、彼女に小声で言う。「どうしたのよ、橙。」","id":"64D7FF56-F8EF-4AAE-B1D1-F26D3FA3CD42","slideTitle":"スライド #1","duration":9.317596371882086,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.001.jpeg","title":"シーン 1","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.560226757369614},{"characterName":"橙","voiceCharacter":"橙","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_橙.wav","telop":"「えっと…円球機械室を見回りしたものが、誰かが、円球の権限を乗っ取り、遠隔操作しているって…騒いでいて…」","id":"29A8DCEB-2086-4DE3-848C-738F836A1E98","slideTitle":"スライド #2","duration":7.960702947845805,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.002.jpeg","title":"シーン 2","audioTrack":"track_voice_%E6%A9%99","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.360702947845805},{"characterName":"八雲紫","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_003_八雲紫.wav","telop":"私は、その一言に嫌な予感し、\n橙に会見の続きを任せて、そのまま円球機械室に向かう。","id":"38C4170D-A09D-41D8-BF74-6A1B68A6153C","slideTitle":"スライド #3","duration":7.155986394557822,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.003.jpeg","title":"シーン 3","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":6.3986167800453515},{"characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","telop":"私は、ただ部屋に一人残され、何気なく、霊夢に話しかける。\n「なぁ、霊夢…お前が競馬で大儲けしたってのは本当なのか？」","id":"185A3DED-D045-4AE9-B4D4-6B029FB761E9","slideTitle":"スライド #4","duration":11.091995464852607,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.004.jpeg","title":"シーン 4","audioTrack":"track_voice_marisa","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":10.491995464852607},{"characterName":"博麗霊夢","voiceCharacter":"博麗霊夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","telop":"「確かに…共同口座のお金と早苗の奇跡の力で、がっぽり儲けたのは、本当なのよ…、でもちょっとして出来心で…」","id":"BE212793-238E-49A9-B2B4-AFF89245336F","slideTitle":"スライド #5","duration":10.016984126984127,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.005.jpeg","title":"シーン 5","audioTrack":"track_voice_reimu","backgroundName":"nc374640_電車内・座席・昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png","voiceDuration":9.416984126984127},{"characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav","telop":"「そうか…、操夢が言ってた話だと、過去の口座の入出金を調べていたら、何回か不審な履歴があったと言ってたのだぜ…」","id":"6705354C-22E0-4135-A047-F3BC4BF4E389","slideTitle":"スライド #6","duration":9.926984126984127,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.006.jpeg","title":"シーン 6","audioTrack":"track_voice_marisa","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":9.326984126984128},{"characterName":"博麗霊夢","voiceCharacter":"博麗霊夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav","telop":"私は、その指摘を受け、ズキズキと心に何かが刺さる…。\n「えっと…、それは…」","id":"BE26DA22-15C7-430B-83B8-E68B5A23E673","slideTitle":"スライド #7","duration":7.005736961451247,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.007.jpeg","title":"シーン 7","audioTrack":"track_voice_reimu","backgroundName":"nc374640_電車内・座席・昼.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第6話\/nc374640_電車内・座席・昼.png","voiceDuration":6.405736961451248},{"characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_霧雨魔理沙.wav","telop":"「なあ、一つ聞きたいんだけど、\n霊夢の収入が少ないと感じるのは…」","id":"32859BD1-E005-48A6-8BC2-BE4F6CC2A8A1","slideTitle":"スライド #8","duration":5.861995464852607,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.008.jpeg","title":"シーン 8","audioTrack":"track_voice_marisa","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":5.261995464852608},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","telop":"「ええ、あの問題の続報になるかもしれないですが、文さんにはあの記者会見の内容の否定と、協力のお願いをしたくて…」","id":"1C4345B9-8CCD-42AE-BB37-689A50AAC6B4","slideTitle":"スライド #9","duration":8.669115646258502,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.009.jpeg","title":"シーン 9","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.069115646258503},{"characterName":"射命丸文","voiceCharacter":"射命丸文","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_射命丸文.wav","telop":"「お願い…もし、内密な話なのであれば、\nそちらにお伺いしましょうか？」","id":"5F41FE43-042B-4252-B947-91E880586334","slideTitle":"スライド #10","duration":5.289591836734694,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.010.jpeg","title":"シーン 10","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.689591836734694},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","telop":"「いえ、あの家は、しばらく手放す予定なので、文さんでお願いを話せればいいかと…」僕は、ボソボソと呟くように言う。","id":"5C044360-401D-4BA4-A6C0-9BDD97790C01","slideTitle":"スライド #11","duration":8.619115646258503,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.011.jpeg","title":"シーン 11","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.019115646258504},{"characterName":"射命丸文","voiceCharacter":"射命丸文","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_射命丸文.wav","telop":"「わかりました…それで、話し合いは、今夜にしますか？」","id":"67B188B3-EF19-4FD1-BB20-D92816299592","slideTitle":"スライド #12","duration":4.1355782312925164,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.012.jpeg","title":"シーン 12","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":3.535578231292517},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","telop":"「ええ、それでお願いします。」","id":"A7C521AC-AAC0-463C-8E95-3099BD1A6DA4","slideTitle":"スライド #13","duration":3.5,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.013.jpeg","title":"シーン 13","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":1.9039002267573697},{"telop":"交換夫婦","backgroundName":"単色背景","duration":3,"title":"シーン 14: 東方Project二次創作 powerd by zuyasi ※前回の予告と一部内容が異なります。","characterName":"博麗霊夢","transitionName":"クロスディゾルブ","id":"CC3456AA-24D2-4B24-825B-CBD52D61F58F","animationName":"なし","slideTitle":"スライド #14","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.014.jpeg"},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","telop":"僕は、それから、家に戻ってくると、\nポケットからポケベルを取り出し、PCに繋げて起動する。","id":"C51CCBF3-0C7D-4E9C-A626-4EE92B87C776","slideTitle":"スライド #15","duration":7.10390022675737,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.015.jpeg","title":"シーン 15","audioTrack":"track_voice_soumu","backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","voiceDuration":6.50390022675737},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","telop":"そして、何気なくポケベルのアプリを開く。\nFiles\nポケベル\nポケベル\nFiles\n編集\n表示\n移動\nウィンドウ\nヘルプ","id":"195CD4E0-A3D8-47D5-B142-263C69B15FED","slideTitle":"スライド #16","duration":3.5,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.016.jpeg","title":"シーン 16","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":2.699546485260771},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルはさまざまな人々の\n「誰かと繋がりたい」という\n思いが沢山こもった製品として\n平成初期から中期にかけて\n流行した通話機能を有する機器\nであり、国会においてスマート\nフォンマナーの問題が挙げられ\n国民のスマートフォン利用を\n原則中止すると、我ら河童\nが生み出したこのポケベルが\n巨大な需要を生み出して…\npocketbell.kappa\/home\/top\n政府公認の安心国産ポケベル\nホーム\nポケベルって何？\n出来ること\n河童の技術力\nポケベル史\n政府公認とは？\nポケベルの魅力\n電話の歴史\nポケベルの性能\nポケベルの価格\n必要なもの\n固定電話は必須？\n通信機能について\nすると、右上に通知が表示され、\n僕は、その通知にカーソルを合わせてクリックする。\n操作\nWeb\nポケベル\n政府が臨時記者会見が始まる\n例の賭博問題に関する言及か…","id":"9F6157CA-60AC-4D88-8808-36E29D609310","slideTitle":"スライド #17","duration":6.290861678004535,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.017.jpeg","title":"シーン 17","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":5.690861678004535},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nえ\npocketbell.kappa\/news\/live\/movie\/miko-tobaku-info\nすると、生放送の画面に切り替わり、読み込み表記が表示される。僕は、しばらく待った後、会見放送を眺めるのだった。\n操作\nWeb\nroading…\nコメント\nroading…\n大宮巫女賭博問題に関する政府臨時記者会見\n生放送配信　映像提供：文々。新聞社","id":"8C305999-3CE5-4E9F-B690-0FDB1EB45D88","slideTitle":"スライド #18","duration":9.504988662131518,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.018.jpeg","title":"シーン 18","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.904988662131519},{"telop":"それから時間がたち…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.5,"title":"シーン 19","characterName":"ナレーション","transitionName":"クロスディゾルブ","id":"312462C8-9707-43EF-A83B-EA7C64436574","animationName":"なし","slideTitle":"スライド #19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.019.jpeg"},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","telop":"僕はそれから、会見を見ていたが、だんだんとそれどころではないと考え、そして、ひっそりとみとりの研究室に来た。","id":"F012E197-FDAE-4CC3-AC80-A3679C1C3DE2","slideTitle":"スライド #20","duration":8.360430839002268,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.020.jpeg","title":"シーン 20","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.760430839002267},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","telop":"この場所は、僕があの島唄居酒屋で、連行されたあとに、睡眠中にこの場所のデータが、インポートされていた。","id":"F7F267D2-E130-41DE-B649-4804A03ED106","slideTitle":"スライド #21","duration":8.084331065759637,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.021.jpeg","title":"シーン 21","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.484331065759637},{"characterName":"操夢","voiceCharacter":"操夢","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","telop":"そして僕は操作盤を触り、会見途中からあのPCで会話していた、この円球に直接、文章を…いや、プログラムを送る。","id":"6B36FD17-0DE4-4363-9662-173B4DE4EF3C","slideTitle":"スライド #22","duration":9.262607709750567,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.022.jpeg","title":"シーン 22","audioTrack":"track_voice_soumu","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.662607709750567},{"characterName":"ナレーション","voiceCharacter":"ナレーション","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_ナレーション.wav","telop":"「プログラムを読み込み中…、首相官邸の丸型システムの遠隔操作を実行中…、現在の動作システムコードを解析中…」","id":"080C5A43-F620-4920-8018-9C79FE3BA783","slideTitle":"スライド #23","duration":8.632154195011337,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.023.jpeg","title":"シーン 23","audioTrack":"track_voice__E1DB","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.032154195011337},{"characterName":"八雲紫","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_024_八雲紫.wav","telop":"私が、記者会見中ふと、周りを見ると、橙が私に視線を向けていることに気がつき、彼女に小声で言う。「どうしたのよ、橙。」","id":"B3D4E40D-46F0-43BC-B667-AA83804D7BB9","slideTitle":"スライド #24","duration":9.317596371882086,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.024.jpeg","title":"シーン 24","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.560226757369614},{"characterName":"橙","voiceCharacter":"橙","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_橙.wav","telop":"「えっと…円球機械室を見回りしたものが、誰かが、円球の権限を乗っ取り、遠隔操作しているって…騒いでいて…」","id":"EC4CABBA-9BE0-4970-A589-9E4F0D82A08E","slideTitle":"スライド #25","duration":7.960702947845805,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.025.jpeg","title":"シーン 25","audioTrack":"track_voice_%E6%A9%99","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.360702947845805},{"characterName":"八雲紫","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","animationName":"なし","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_026_八雲紫.wav","telop":"私は、その一言に嫌な予感し、\n橙に会見の続きを任せて、そのまま円球機械室に向かう。","id":"4B1059D1-81BE-4106-82C1-7B9DC56FDFE9","slideTitle":"スライド #26","duration":7.155986394557822,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.026.jpeg","title":"シーン 26","audioTrack":