de_067_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"characterName":"古明地さとり","voiceDuration":5.716984126984127,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 68","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「こいしの態度が一変した理由が、分かったわ…」\n私はそう言いながら、あの感情の波が少しだけ理解できた。","seVolume":1,"duration":5.716984126984127,"transitionName":"なし","slideTitle":"スライド #68","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.068.jpeg","id":"40BF4EB5-CDEB-4FF5-92A3-BFBC7AA73584","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_古明地さとり.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0,"characterName":"アリス・マーガトロイド","voiceDuration":2.7009523809523808,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 69","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「私も分かったわ…」私はさとり続けてそういう。","seVolume":1,"duration":2.7009523809523808,"transitionName":"なし","slideTitle":"スライド #69","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.069.jpeg","id":"48D81B65-A3D3-44D0-ADE0-3251BCA0964F","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_アリス・マーガトロイド.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.24845804988662,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 70","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕は、何かをぶつぶついう二人を置いて、最初の注文をする。頼んだのは、ハンバークセットと鉄火丼定食だった。","seVolume":1,"duration":8.24845804988662,"transitionName":"なし","slideTitle":"スライド #70","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.070.jpeg","id":"0575BACC-276F-42A2-8A83-1551F4B15A44","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.121292517006802,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 71","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"それから、僕とこいしはそのまま、ドリンクバーに向った。\nすると、二人は後から気づき、慌てて注文をするのだった。","seVolume":1,"duration":8.121292517006802,"transitionName":"なし","slideTitle":"スライド #71","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.071.jpeg","id":"D65FF1C0-BEEF-4D6E-A6B6-433786B62344","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voice2StartTimeOffset":0,"characterName":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 72: ご視聴ありがとうございました！","telop":"ご視聴ありがとうございました！","seVolume":0.25625,"duration":20,"transitionName":"なし",