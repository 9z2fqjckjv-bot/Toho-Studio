7256236,"transitionName":"なし","slideTitle":"スライド #63","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.063.jpeg","id":"EB267738-DFD7-4765-8678-83769C344FB7","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceDuration":1.69875283446712,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 64","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「私は、これが食べたいな。」","seVolume":1,"duration":1.69875283446712,"transitionName":"なし","slideTitle":"スライド #64","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.064.jpeg","id":"CF57B2ED-68A9-40C5-A530-17F3C33BA7AF","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_古明地こいし.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.128458049886621,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 65","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"彼女はそう言って、あるメニューを指差す。それは、アグー豚100%のハンバークにご飯とドリンクバーがついたセットだった。","seVolume":1,"duration":8.128458049886621,"transitionName":"なし","slideTitle":"スライド #65","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a