Volume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":7.145215419501134,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 19","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「分かりました。それじゃあ、買ってきますね。」\n僕はそう言うと、一度おろしたバックを背負い、部屋を出た。","seVolume":1,"duration":7.145215419501134,"transitionName":"なし","slideTitle":"スライド #19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.019.jpeg","id":"51FD3D98-6930-415D-9A1B-7EE5950CD20F","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voice2StartTimeOffset":0,"characterName":"ナレーション","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 20","telop":"彼が買い出しから戻ると…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"duration":1.5,"transitionName":"なし","animationDuration":1.5,"slideTitle":"スライド #20","id":"41FB3846-B948-4876-992B-64E2A9B8CF8D","animationName":"なし","animationNote":"表示時間：1.5秒","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.020.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"bgmVolume":0.7},{"seStartTimeOffset":2.31,"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":6.993038548752835,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 21","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕は、買い出しから戻ると、バックから〇〇〇〇チュそばを取り出し、給湯ポットから、お湯を入れて、蓋をする。","seVolume":2,"duration":6.993038548752835,"transitionName":"なし","slideTitle":"スライド #21","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.021.jpeg","id":"7FF22B82-8DE1-4A04-8B9C-630F6AFC0894","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/自主規制ピー音.mp3","seName":"SE: 自主規制ピー音","bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.434331065759638,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 22","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、数分程度待ち、容器の上に、箸を乗せて、そっともち、彼女に、手渡す。「熱いので気をつけてください。」","seVolume":1,"duration":8.434331065759638,"transitionName":"なし","slideTitle":"スライド #22","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.022.jpeg","id":"8DC0812F-AE63-4CF2-8D7A-23A99986C187","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceDuration":4.915192743764172,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 23","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「ありがとう…、じゃあ、いただきます…。」\n私は、そう言って、冷ましながらそれを食べる。","seVolume":1,"duration":4.915192743764172,"transitionName":"なし","slideTitle":"スライド #23","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.023.jpeg","id":"3489FA85-333B-4B39-9C3C-14C98A290A35","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_古明地こいし.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":7.395215419501134,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 24","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕は、彼女が食べ始めたのを見ると、バックから油みそが入ったポーク玉子おむすびと天ぷらを取り出して、食べる。","seVolume":1,"duration":7.395215419501134,"transitionName":"なし","slideTitle":"スライド #24","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.024.jpeg","id":"1E002A44-F661-4A8C-97EF-EB087A68F49D","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":7.147369614512471,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 25","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、昼食を済ますと、彼女に沖縄そばの感想を聞く。\n「どうでしたか、初めての沖縄そばは…？」","seVolume":1,"duration":7.147369614512471,"transitionName":"なし","slideTitle":"スライド #25","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.025.jpeg","id":"1313DB38-B33B-4A08-8091-3F520D5A7627","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceDuration":6.849160997732426,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 26","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「美味しかった…」私は、お腹が満たされると、眠たくなる。\nそして、私は無意識のうちに彼の服を手で引っ張る…。","seVolume":1,"duration":6.849160997732426,"transitionName":"なし","slideTitle":"スライド #26","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.026.jpeg","id":"EF3B6073-60C6-42C4-A02D-166AC489C0FE","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_古明地こいし.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":7.656077097505669,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 27","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕は、僕の服を引っ張る彼女を見て、彼女をベッドに横たわらせると、自分自身も同じベッドの隣で横になる。","seVolume":1,"duration":7.656077097505669,"transitionName":"なし","slideTitle":"スライド #27","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.027.jpeg","id":"CD9C184F-BF68-4BB2-B9A1-C0FF02B1553E","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":7.923469387755102,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 28","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、頭をそっと優しく撫でていると、彼女は気持ちよさそうに、そのまま寝落ちした。すると、あくびが出てくる。","seVolume":1,"duration":7.923469387755102,"transitionName":"なし","slideTitle":"スライド #28","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.028.jpeg","id":"4F1405B3-14CF-48AC-87ED-42A83AE4BA2C","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/気持ちの良い寝顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.14845804988662,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 29","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、彼女の頭を優しくトントンと手を当てながら、そのまま瞼が重たくなって行き、彼女のそばでそのまま眠るのだった。","seVolume":1,"duration":8.14845804988662,"transitionName":"なし","slideTitle":"スライド #29","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.029.jpeg","id":"D76DC37F-17B2-4AC2-AD92-B88D032AE279","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/気持ちの良い寝顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voice2StartTimeOffset":0,"characterName":"ナレーション","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 30","telop":"彼の目が覚めると…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"duration":1.5,"transitionName":"なし","animationDuration":1.5,"slideTitle":"スライド #30","id":"FF379921-568C-4FA0-B223-BCC760C5F16F","animationName":"なし","animationNote":"表示時間：1.5秒","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.030.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":7.599546485260771,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 31","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕はふと目が覚めると、部屋の時計を確認する。時計には、午後4時と表示されていた。「昼寝しすぎたな…」","seVolume":1,"duration":7.599546485260771,"transitionName":"なし","slideTitle":"スライド #31","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.031.jpeg","id":"C9EDD6EA-D24B-4FC4-ABD1-C54D1A17DACA","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/気持ちの良い寝顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":6.923469387755102,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 32","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕はそう言いながら、起きあがろうとすると、こいしが腕を回し、僕の体に抱きつき、その場に引き留める。","seVolume":1,"duration":6.923469387755102,"transitionName":"なし","slideTitle":"スライド #32","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.032.jpeg","id":"9D0B8587-5EBB-4673-881C-194BC0098B41","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/気持ちの良い寝顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"seName":"SE: ドアチャイム1","seStartTimeOffset":0.66,"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.166938775510204,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 33","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、部屋のチャイムが鳴ると同時に、焦燥感に駆られる。\nだが、予備のカードーキーでドアが開き、誰かが入ってくる。","seVolume":0.85,"duration":8.166938775510204,"transitionName":"なし","slideTitle":"スライド #33","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.033.jpeg","id":"B24E4C8E-93E9-4859-9C13-97E578B1CEE1","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/気持ちの良い寝顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアチャイム1.mp3","bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":8.495215419501134,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 34","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、入ってきたその女性…、さとりは、驚いた表情で、その場で固まってしまった…。そして僕は、何かを悟った。","seVolume":1,"duration":8.495215419501134,"transitionName":"なし","slideTitle":"スライド #34","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.034.jpeg","id":"3152987D-5E86-4172-B8E3-5B9C9B5A7046","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":4.328911564625851,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 35","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"僕はそれから、彼女に理不尽なお説教を数十分受けるのだった。","seVolume":1,"duration":4.328911564625851,"transitionName":"なし","slideTitle":"スライド #35","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.035.jpeg","id":"F6B540A5-1C51-4FAC-B448-A2905553894C","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（怒る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voice2StartTimeOffset":0,"characterName":"古明地さとり","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 36","telop":"さとりの説教が終わり…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"duration":1.5,"transitionName":"なし","animationDuration":1.5,"slideTitle":"スライド #36","id":"C65E9751-50E9-4961-A3C4-5F856590737F","animationName":"なし","animationNote":"表示時間：1.5秒","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.036.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":6.756077097505669,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 37","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"それからさとりによる説教という修羅場を乗り切ると、僕はようやくベッドから立ち上がり、弁明の時間になる。","seVolume":1,"duration":6.756077097505669,"transitionName":"なし","slideTitle":"スライド #37","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.037.jpeg","id":"DFE206D1-C0EC-41D5-9C8B-E12CAC682032","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（怒る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"操夢","voice2StartTimeOffset":0,"characterName":"操夢","voiceDuration":3.6778231292517005,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 38","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"すると、その最中に、こいしがある質問を僕にする…。","seVolume":1,"duration":3.6778231292517005,"transitionName":"なし","slideTitle":"スライド #38","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.038.jpeg","id":"202F92B4-0073-410F-8036-7DE71CC5DDB4","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（怒る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceDuration":2.3541269841269843,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 39","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"「ねぇ…、今晩も私と…寝てくれない…？」","seVolume":1,"duration":2.3541269841269843,"transitionName":"なし","slideTitle":"スライド #39","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第20話_a180212b32\/元女子校の日常　第20話_a180212b32.039.jpeg","id":"D147C9F1-5207-43AA-B8EC-28771BA253FF","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（怒る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_古明地こいし.wav","seStartTimeOffset":0,"bgmVolume":0.7},{"voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"characterName":"古明地さとり","voiceDuration":3.1043990929705214,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"title":"シーン 40","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynot