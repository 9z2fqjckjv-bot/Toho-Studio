    "id": "AC93AFFF-8CD1-4489-8630-592C2E9BA548",
    "title": "シーン 29",
    "voiceCharacter": "射命丸文"
  },
  {
    "audioTrack": "track_voice_%E6%B0%B8%E7%90%B3",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "characterName": "八意永琳",
    "duration": 4.800000000000001,
    "bgmName": "BGM: 少女綺想曲",
    "slideTitle": "第30スライド",
    "transitionName": "なし",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.030.jpeg",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_030_永琳.wav",
    "telop": "「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。",
    "characterImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/文（微笑）.png",
