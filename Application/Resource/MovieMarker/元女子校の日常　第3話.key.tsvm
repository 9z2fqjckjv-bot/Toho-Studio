  },
  {
    "voiceDuration": 2.5930385487528347,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "duration": 3.5,
    "characterName": "操夢",
    "slideTitle": "第5スライド",
    "bgmName": "BGM: 少女綺想曲",
    "title": "シーン 5",
    "audioTrack": "track_voice_soumu",
    "animationName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_005_操夢.wav",
    "voiceCharacter": "操夢",
    "telop": "「何か、言いたいことでもあるのですか？」",
    "id": "71559A40-B1BF-49A3-8A1F-F896C6E6F8D5",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.005.jpeg"
  },
  {
    "duration": 3.5,
    "telop": "「お前の祖母さんが、困ってたぞ、私の孫が云々…って」",
    "transitionName": "なし",
    "slideTitle": "第6スライド",
    "voiceAudioPath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/Application/Resource/GeneratedAudio/Slide_006_霧雨魔理沙.wav",
    "audioTrack": "track_voice_marisa",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.006.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "animationName": "なし",
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "title": "シーン 6",
    "characterName": "霧雨魔理沙",
    "id": "ACB45FA1-D0A0-4854-B4D1-0353B2741447",
    "voiceCharacter": "霧雨魔理沙",
    "voiceDuration": 5.053242630385488
  },
  {
    "duration": 3.7,
    "telop": "「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。",
    "transitionName": "なし",
    "slideTitle": "第7スライド",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_007_操夢.wav",
    "audioTrack": "track_voice_soumu",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.007.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "animationName": "なし",
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "title": "シーン 7",
    "characterName": "操夢",
    "id": "BD5D32C3-BF34-494D-8938-33278F38728D",
    "voiceCharacter": "操夢",
    "voiceDuration": 6.027823129251701
  },
  {
    "duration": 4.5,
    "telop": "「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」",
    "transitionName": "なし",
    "slideTitle": "第8スライド",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_008_霧雨魔理沙.wav",
    "audioTrack": "track_voice_marisa",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.008.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "animationName": "なし",
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "title": "シーン 8",
    "characterName": "霧雨魔理沙",
    "id": "188BEF56-1A21-4F54-9D4A-653B9850B54D",
    "voiceCharacter": "霧雨魔理沙",
    "voiceDuration": 7.018231292517007
  },
  {
    "duration": 3.7,
    "telop": "そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」",
    "transitionName": "カラーでフェード",
    "slideTitle": "第9スライド",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_009_操夢.wav",
    "audioTrack": "track_voice_soumu",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.009.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "animationName": "なし",
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "title": "シーン 9",
    "characterName": "操夢",
    "id": "23049E00-3070-4C8E-8313-ECF87415AF4D",
    "voiceCharacter": "操夢",
    "voiceDuration": 5.20498866213152
  },
  {
    "duration": 19,
    "videoPath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_animations/元女子校の日常　第3話_c997bea981/slide_010_anim.m4v",
    "telop": "元女子校の日常",
