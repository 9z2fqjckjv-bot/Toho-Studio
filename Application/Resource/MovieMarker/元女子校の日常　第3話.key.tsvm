    "id": "13E9715A-CBDE-4AF6-8899-87791A97F586",
    "voiceDuration": 7.520181405895691,
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_028_射命丸文.wav",
    "audioTrack": "track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87",
    "slideTitle": "第28スライド",
    "bgmName": "BGM: 少女綺想曲",
    "title": "シーン 28",
