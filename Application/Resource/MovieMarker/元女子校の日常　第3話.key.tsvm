  {
    "voiceCharacter": "博麗霊夢",
    "title": "シーン 57",
    "telop": "「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。",
    "voiceDuration": 6.735736961451247,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.057.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 4.5,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_reimu",
    "characterName": "博麗霊夢",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第57スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_057_博麗霊夢.wav",
    "id": "3CCB182A-6378-4F66-8B66-369ABFE4D41A"
  },
  {
    "voiceCharacter": "博麗霊夢",
    "title": "シーン 58",
    "telop": "霊夢がお風呂を澄ますと…",
    "voiceDuration": 3.2244897959183674,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.058.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 3.5,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "audioTrack": "track_voice_reimu",
    "characterName": "博麗霊夢",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "slideTitle": "第58スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_058_射命丸文.wav",
    "id": "A01F5316-8A6E-4BFD-B458-20149DA03478"
  },
  {
    "voiceCharacter": "博麗霊夢",
    "title": "シーン 59",
    "telop": "私がお風呂から戻ってくると、彼はビール缶をあけ、ため息をついていた。「何か現場仕事に不満でもあるの？」",
    "voiceDuration": 8.424489795918367,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.059.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 5.1000000000000005,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_reimu",
    "characterName": "博麗霊夢",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第59スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_059_博麗霊夢.wav",
    "id": "4E5CF415-9347-4C8C-AB9E-25FB19EDF3A9"
  },
  {
    "voiceCharacter": "妹紅",
    "title": "シーン 60",
    "telop": "「今日は、例の紅魔建設からの依頼だったんだけど…」",
    "voiceDuration": 3.305827664399093,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.060.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 3.5,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_%E5%A6%B9%E7%B4%85",
    "characterName": "藤原妹紅",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第60スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_060_妹紅.wav",
    "id": "A1AB907B-46AB-43D6-9103-CFD50C89C5C5"
  },
  {
    "voiceCharacter": "博麗霊夢",
    "title": "シーン 61",
    "telop": "彼はそういうと、その話を始める。特殊な力で一瞬で建造物を破壊できる女性がいる一族経営の館の解体工事中の出来事だった。",
    "voiceDuration": 11.514739229024944,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.061.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 5.800000000000001,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_reimu",
    "characterName": "博麗霊夢",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第61スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_061_博麗霊夢.wav",
    "id": "425F8D24-106F-48C1-AC64-A75408C63749"
  },
  {
    "voiceCharacter": "妹紅",
    "title": "シーン 62",
    "telop": "「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」",
    "voiceDuration": 7.374580498866213,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.062.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 4.800000000000001,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_%E5%A6%B9%E7%B4%85",
    "characterName": "藤原妹紅",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第62スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_062_妹紅.wav",
    "id": "6C6C335D-0533-425E-95A0-E4BE226F0164"
  },
  {
    "voiceCharacter": "妹紅",
    "title": "シーン 63",
    "telop": "「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」",
    "voiceDuration": 6.796439909297052,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.063.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 5.5,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_%E5%A6%B9%E7%B4%85",
    "characterName": "藤原妹紅",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第63スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_063_妹紅.wav",
    "id": "00953FEF-50B4-4D6E-B4D9-B365E56DF405"
  },
  {
    "voiceCharacter": "妹紅",
    "title": "シーン 64",
    "telop": "「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」",
    "voiceDuration": 7.026666666666666,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.064.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 5.2,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_%E5%A6%B9%E7%B4%85",
    "characterName": "藤原妹紅",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第64スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_064_妹紅.wav",
    "id": "91377C49-9C71-4CB1-9943-37FC2A45319B"
  },
  {
    "voiceCharacter": "妹紅",
    "title": "シーン 65",
    "telop": "「だが、そんなことよりも、今日もこうして、霊夢のところに帰って来れて、俺は幸せ者だぜ。」私はそう笑みを浮かべる。",
    "voiceDuration": 7.868321995464853,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.065.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "duration": 5.6000000000000005,
    "backgroundName": "リビング（夜・照明ON・カーテン閉）.jpeg",
    "audioTrack": "track_voice_%E5%A6%B9%E7%B4%85",
    "characterName": "藤原妹紅",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/リビング（夜・照明ON・カーテン閉）.jpg",
    "animationName": "なし",
    "slideTitle": "第65スライド",
    "transitionName": "なし",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_065_妹紅.wav",
    "id": "06049C29-4912-4400-B192-245A606CAC7A"
  },
  {
    "voiceCharacter": "博麗霊夢",
    "characterName": "博麗霊夢",
    "id": "651C6E71-9827-4C43-A00F-C6EA24B9AFAF",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_066_博麗霊夢.wav",
    "telop": "「そうね…」私は、夫のその発言こう返すことしかできなかった。そして、なんだか距離を感じてしまったのだった。",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.066.jpeg",
