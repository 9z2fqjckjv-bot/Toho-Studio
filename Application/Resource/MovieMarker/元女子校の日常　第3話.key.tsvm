    "telop": "彼に視点が戻り…",
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "id": "7C8DE181-3B8D-42A8-AB97-2AEA5C4D489F",
    "title": "シーン 34",
    "voiceCharacter": "ナレーション"
  },
  {
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "characterName": "操夢",
    "duration": 5.9,
    "bgmName": "BGM: 少女綺想曲",
    "slideTitle": "第35スライド",
    "transitionName": "なし",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.035.jpeg",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_035_操夢.wav",
    "telop": "僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…",
    "voiceDuration": 9.285419501133786,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "id": "7725EF72-0012-46F6-B943-E61FA98BD195",
    "title": "シーン 35",
    "voiceCharacter": "操夢"
  },
  {
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "characterName": "操夢",
    "duration": 5.300000000000001,
    "bgmName": "BGM: 少女綺想曲",
    "slideTitle": "第36スライド",
    "transitionName": "なし",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.036.jpeg",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_036_操夢.wav",
    "telop": "だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。",
    "voiceDuration": 8.366938775510205,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "id": "1D53BA5E-6AFE-4AE5-A137-7FB467C63F83",
    "title": "シーン 36",
    "voiceCharacter": "操夢"
  },
  {
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "characterName": "操夢",
    "duration": 5.5,
    "bgmName": "BGM: 少女綺想曲",
    "slideTitle": "第37スライド",
    "transitionName": "なし",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.037.jpeg",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_037_操夢.wav",
    "telop": "だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。",
    "voiceDuration": 8.261519274376417,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "id": "CCE39B4A-000A-444E-81C0-E24DECC47ED1",
    "title": "シーン 37",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_038_操夢.wav",
    "slideTitle": "第38スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.038.jpeg",
    "voiceDuration": 8.697369614512471,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "id": "FE71F3AC-CE8F-4571-A1BA-63A53820C7A8",
    "duration": 5.6000000000000005,
    "transitionName": "なし",
    "characterName": "操夢",
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "title": "シーン 38",
    "telop": "一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。",
    "bgmName": "BGM: 少女綺想曲",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_039_操夢.wav",
    "slideTitle": "第39スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.039.jpeg",
    "voiceDuration": 8.525646258503402,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "id": "D50B5CB5-13E3-4CAD-8B5B-380676DA308C",
    "duration": 5.300000000000001,
    "transitionName": "なし",
    "characterName": "操夢",
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "title": "シーン 39",
    "telop": "だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。",
    "bgmName": "BGM: 少女綺想曲",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_040_操夢.wav",
    "slideTitle": "第40スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.040.jpeg",
    "voiceDuration": 7.856077097505669,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "id": "27F60F73-65CA-41E8-AA8D-7CAB362E324D",
    "duration": 5,
    "transitionName": "なし",
    "characterName": "操夢",
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "title": "シーン 40",
    "telop": "そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。",
    "bgmName": "BGM: 少女綺想曲",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_041_操夢.wav",
    "slideTitle": "第41スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.041.jpeg",
    "voiceDuration": 6.240861678004535,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "id": "0F0C9425-CAAC-4B1E-8102-429A1D599F0C",
    "duration": 3.8000000000000003,
    "transitionName": "なし",
    "characterName": "操夢",
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "title": "シーン 41",
    "telop": "そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。",
    "bgmName": "BGM: 少女綺想曲",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_042_操夢.wav",
    "slideTitle": "第42スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.042.jpeg",
    "voiceDuration": 8.803900226757369,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "id": "6517FA3A-D2EB-4040-84B3-39BBFF93D089",
    "duration": 5.6000000000000005,
    "transitionName": "なし",
    "characterName": "操夢",
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "title": "シーン 42",
    "telop": "そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。",
    "bgmName": "BGM: 少女綺想曲",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_043_操夢.wav",
    "slideTitle": "第43スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.043.jpeg",
    "voiceDuration": 8.601723356009071,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "id": "F728746C-B34A-46BE-9CC9-010FC0C57ACD",
    "duration": 5.2,
    "transitionName": "なし",
    "characterName": "操夢",
    "audioTrack": "track_voice_soumu",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "title": "シーン 43",
    "telop": "僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…",
    "bgmName": "BGM: 少女綺想曲",
    "voiceCharacter": "操夢"
  },
  {
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_044_操夢.wav",
    "slideTitle": "第44スライド",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.044.jpeg",
