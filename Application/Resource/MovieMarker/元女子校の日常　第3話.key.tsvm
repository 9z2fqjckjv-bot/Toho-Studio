    "voiceCharacter": ""
  },
  {
    "duration": 3.5,
    "telop": "そして、それから数分程度で霊夢が部屋に入ってくる。",
    "transitionName": "なし",
    "slideTitle": "第11スライド",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_011_操夢.wav",
    "audioTrack": "track_voice_soumu",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.011.jpeg",
    "bgmName": "BGM: 少女綺想曲",
    "animationName": "なし",
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "title": "シーン 11",
    "characterName": "操夢",
    "id": "6E4174F4-B285-44B7-A83D-6FADE8D7AE55",
    "voiceCharacter": "操夢",
    "voiceDuration": 3.490861678004535
  },
  {
    "duration": 4.4,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "博麗霊夢",
    "voiceDuration": 6.755736961451247,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.012.jpeg",
    "animationName": "なし",
    "id": "4540A300-F5BA-4A1F-819A-61D22C7A262B",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_012_博麗霊夢.wav",
    "voiceCharacter": "博麗霊夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_reimu",
    "title": "シーン 12",
    "slideTitle": "第12スライド",
    "telop": "「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」"
  },
  {
    "duration": 4.2,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "操夢",
    "voiceDuration": 6.414761904761905,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.013.jpeg",
    "animationName": "なし",
    "id": "BCBA2ACC-F7C0-44DB-9763-1C7ECD0B4EA0",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_013_操夢.wav",
    "voiceCharacter": "操夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_soumu",
    "title": "シーン 13",
    "slideTitle": "第13スライド",
    "telop": "「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。"
  },
  {
    "duration": 3.5,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "博麗霊夢",
    "voiceDuration": 3.9094784580498865,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.014.jpeg",
    "animationName": "なし",
    "id": "C0A6DB25-EC68-4B12-9534-A8F8682B8A85",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_014_博麗霊夢.wav",
    "voiceCharacter": "博麗霊夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_reimu",
    "title": "シーン 14",
    "slideTitle": "第14スライド",
    "telop": "「それに…最近…魔理沙の様子が変なのよね…」"
  },
  {
    "duration": 4.7,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "操夢",
    "voiceDuration": 6.35172335600907,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.015.jpeg",
    "animationName": "なし",
    "id": "43BA2028-2F9D-48ED-BBFC-9223322401E9",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_015_操夢.wav",
    "voiceCharacter": "操夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_soumu",
    "title": "シーン 15",
    "slideTitle": "第15スライド",
    "telop": "「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」"
  },
  {
    "duration": 5.800000000000001,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "博麗霊夢",
    "characterImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/交換夫婦（21.22話目）/霊夢（微笑）.png",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.016.jpeg",
    "voiceDuration": 10.184489795918367,
    "animationName": "なし",
    "id": "3BCC5C36-0EC2-47DA-B112-15A2ED0ED282",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_016_博麗霊夢.wav",
    "voiceCharacter": "博麗霊夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_reimu",
    "title": "シーン 16",
    "slideTitle": "第16スライド",
    "telop": "「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」"
  },
  {
    "duration": 4.3,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "操夢",
    "voiceDuration": 6.690861678004535,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.017.jpeg",
    "animationName": "なし",
    "id": "EF4BBC1A-5FF4-48FB-840D-0ABAB8E3CFAB",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_017_操夢.wav",
    "voiceCharacter": "操夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_soumu",
    "title": "シーン 17",
    "slideTitle": "第17スライド",
    "telop": "彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。"
  },
  {
    "duration": 3.5,
    "backgroundName": "nc256897_病室-夕方-電気あり.png",
    "transitionName": "なし",
    "characterName": "操夢",
    "voiceDuration": 4.321292517006802,
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.018.jpeg",
    "animationName": "なし",
    "id": "6655DB30-7C73-4664-B36E-9586AC8FD878",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_018_操夢.wav",
    "voiceCharacter": "操夢",
    "bgmName": "BGM: 少女綺想曲",
    "audioTrack": "track_voice_soumu",
    "title": "シーン 18",
    "slideTitle": "第18スライド",
    "telop": "僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。"
  },
  {
    "duration": 3.5,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "transitionName": "なし",
    "characterName": "ナレーション",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.019.jpeg",
    "animationName": "なし",
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
