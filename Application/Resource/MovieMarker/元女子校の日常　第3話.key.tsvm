    "transitionName": "なし",
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第3話_c997bea981/元女子校の日常　第3話_c997bea981.033.jpeg",
    "voiceAudioPath": "/Users/zuyasi/Library/Application Support/TohoStudio/GeneratedAudio/Slide_033_永琳.wav",
    "telop": "私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。",
    "voiceDuration": 7.329614512471656,
    "backgroundName": "nc73538_【背景素材】博麗神社.jpg",
    "animationName": "なし",
    "id": "C8A71076-6757-4DF6-BE50-BB922DDA2649",
    "title": "シーン 33",
    "voiceCharacter": "永琳"
  },
  {
    "backgroundImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第2話/nc73538_【背景素材】博麗神社.jpg",
    "characterName": "ナレーション",
    "duration": 3.5,
    "bgmName": "BGM: 少女綺想曲",
