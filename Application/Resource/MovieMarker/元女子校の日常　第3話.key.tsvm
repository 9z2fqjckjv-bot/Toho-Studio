    "title": "シーン 19",
    "slideTitle": "第19スライド",
    "telop": "附属病院のある診察室では…"
  },
  {
    "voiceCharacter": "永琳",
    "animationName": "なし",
    "characterName": "八意永琳",
    "transitionName": "なし",
    "id": "5FEEE145-642E-45A4-8210-B785016F2C79",
    "voiceDuration": 4.956916099773243,
