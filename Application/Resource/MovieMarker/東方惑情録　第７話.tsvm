58-494B-8279-516C3020AE92","duration":3.5},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.004.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第4スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 4","voiceDuration":1.7191156462585033,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","animationName":"なし","voiceStartTimeOffset":0,"telop":"「なんだか違和感を感じる…」","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","voiceCharacter":"操夢","seVolume":1,"transitionName":"なし","id":"F9147B11-708B-4235-97D4-08CF8458330F","duration":3.5},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.005.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第5スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 5","voiceDuration":2.6191156462585035,"seStartTimeOffset":0,"audioTrack":"track_voice__2DEA","animationName":"なし","voiceStartTimeOffset":0,"telop":"「違和感の正体についてお調べしますか？」","characterName":"ナレーション","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_ナレーション.wav","voiceCharacter":"ナレーション","seVolume":1,"transitionName":"なし","id":"06F3709F-6120-4E51-9CE4-C0AC316ADD3F","duration":3.5},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.006.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第6スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 6","voiceDuration":1.5,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","animationName":"なし","voiceStartTimeOffset":0,"telop":"「調べて。」","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","voiceCharacter":"操夢","seVolume":1,"transitionName":"なし","id":"27CB4C45-AD7A-48BC-932C-5173C74436D7","duration":3.5},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.007.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第7スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 7","voiceDuration":2.873469387755102,"seStartTimeOffset":0,"audioTrack":"track_voice__2DEA","animationName":"なし","voiceStartTimeOffset":0,"telop":"「承知しました。しばらくお待ちください。」","characterName":"ナレーション","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_ナレーション.wav","voiceCharacter":"ナレーション","seVolume":1,"transitionName":"なし","id":"27EE4BA0-2494-448A-B445-96D943AF27F5","duration":3.5},{"slideTitle":"中扉","characterName":"","id":"86F8F68C-A1C9-47FA-9E07-8728D7BEB6C2","seVolume":1,"backgroundName":"単色背景","transitionName":"なし","title":"その頃、にとりは…","voiceStartTimeOffset":0,"animationName":"なし","duration":3,"seStartTimeOffset":0,"telop":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.008.jpeg","voiceCharacter":""},{"slideTitle":"第9スライド","characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_博麗霊夢.wav","voiceCharacter":"博麗霊夢","seVolume":1,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceDuration":5.714489795918367,"transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","title":"シーン 9","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","duration":3.8000000000000003,"seStartTimeOffset":0,"telop":"「それで、なぜあんたは、あんな異変を起こしたのよ？\n言い訳があるのでしょう？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.009.jpeg","id":"852FF734-D32F-46F8-97A6-475794548A08"},{"slideTitle":"第10スライド","characterName":"にとり","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_010_にとり.wav","voiceCharacter":"にとり","seVolume":1,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceDuration":8.808798185941043,"transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","title":"シーン 10","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","duration":5.6000000000000005,"seStartTimeOffset":0,"telop":"「えっと…」私は、仕方なくその日のことを話す。「ある日、霖之助が妙な機械を手に入れたって、自慢話を聞いたんだよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.010.jpeg","id":"A46D563B-7B32-4BB5-BE9B-2297DB78E63F"},{"slideTitle":"第11スライド","characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","voiceCharacter":"博麗霊夢","seVolume":1,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceDuration":3.6044897959183673,"transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","title":"シーン 11","audioTrack":"track_voice_reimu","voiceStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","duration":3.5,"seStartTimeOffset":0,"telop":"「それで、霖之助が主犯者だとでも言いたいの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.011.jpeg","id":"563F25A0-81E1-4B58-A419-3ECE76EFBD93"},{"slideTitle":"第12スライド","characterName":"にとり","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_012_にとり.wav","voiceCharacter":"にとり","seVolume":1,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceDuration":8.889750566893424,"transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","title":"シーン 12","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","duration":5.7,"seStartTimeOffset":0,"telop":"「そう言いたんじゃない、私は、その機械を幻想郷で作り出すのは、到底できない品物で、列車で運んで、中を見たんだよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.012.jpeg","id":"8DB3AF50-03DC-474F-9182-3BBA6B1AD76C"},{"id":"27C5B357-C618-4097-8D0A-07E87BCA1028","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","seVolume":1,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.013.jpeg","characterName":"博麗霊夢","slideTitle":"第13スライド","title":"シーン 13","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_博麗霊夢.wav","voiceCharacter":"博麗霊夢","duration":3.5,"animationName":"なし","voiceDuration":1.5,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"telop":"「で、それで？」","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg"},{"id":"78464E43-65BA-4FB5-8373-3FC4E7BAEFB0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","seVolume":1,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.014.jpeg","characterName":"にとり","slideTitle":"第14スライド","title":"シーン 14","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_にとり.wav","voiceCharacter":"にとり","duration":5.800000000000001,"animationName":"なし","voiceDuration":7.93297052154195,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"telop":"「ふと、それを見て、なぜか私は、違和感を感じたんだ、どこかで見たことのあるようなリンゴマークが機械についてたから。」","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg"},{"id":"7CA825E6-3D15-40C6-8D9D-A3A81D608C6A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","seVolume":1,"voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.015.jpeg","characterName":"にとり","slideTitle":"第15スライド","title":"シーン 15","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_にとり.wav","voiceCharacter":"にとり","duration":4.800000000000001,"animationName":"なし","voiceDuration":7.163809523809523,"backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"telop":"「それで、過去の記録を見ようと思って、機械をそのまま妖怪の山に列車で輸送したんだよ。だけども…」","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg"},{"title":"シーン 16","audioTrack":"track_voice_reimu","slideTitle":"第16スライド","telop":"「何か問題でもあったの？」","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.016.jpeg","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seVolume":1,"voiceDuration":2.056984126984127,"id":"073E8985-03FD-499A-ABF5-F117CFF9C4F9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav","voiceCharacter":"博麗霊夢"},{"title":"シーン 17","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","slideTitle":"第17スライド","telop":"「その機械を動かすには、大きな電力がないと動かせず、発電所から直に電気を供給する必要があったんだ。」","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.017.jpeg","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seVolume":1,"voiceDuration":7.6420181405895695,"id":"275321C1-70D7-437F-B7E6-1ED88EA239F7","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"transitionName":"なし","characterName":"にとり","animationName":"なし","duration":5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_017_にとり.wav","voiceCharacter":"にとり"},{"title":"シーン 18","audioTrack":"track_voice_reimu","slideTitle":"第18スライド","telop":"「まさか、その機械を動かしたら、あんな空気が出たなんて言わないわよね？」私は、そう彼女を問い詰める。","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.018.jpeg","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seVolume":1,"voiceDuration":8.316984126984128,"id":"DD5D753E-4A0B-444E-BBFF-C8E2916A6140","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_博麗霊夢.wav","voiceCharacter":"博麗霊夢"},{"title":"シーン 19","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","slideTitle":"第19スライド","telop":"「そうさ、その機械を発電所の設備に直付けで起動したら、なんでかわかんないけど、轟音立てながら、煙が出たんだ。」","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.019.jpeg","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seVolume":1,"voiceDuration":8.294399092970522,"id":"DE40FD4D-6ADA-4593-8795-F62BC7D0B030","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"transitionName":"なし","characterName":"にとり","animationName":"なし","duration":5.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_019_にとり.wav","voiceCharacter":"にとり"},{"title":"シーン 20","audioTrack":"track_voice_reimu","slideTitle":"第20スライド","telop":"「それで、もし仮にその機械に原因があるなら、\nその機械は処分したのよね？」","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.020.jpeg","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","seVolume":1,"voiceDuration":5.821995464852607,"id":"DF466435-353C-4808-8E31-1DBF18180CD7","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","seStartTimeOffset":0,"transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_博麗霊夢.wav","voiceCharacter":"博麗霊夢"},{"slideTitle":"第21スライド","telop":"「えっと、それは…。まだ、あの発電所の中にある…。」","title":"シーン 21","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_にとり.wav","voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","animationName":"なし","voiceDuration":3.970113378684807,"voiceCharacter":"にとり","duration":3.5,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.021.jpeg","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","id":"2B00BAA8-26D1-4133-B93C-0A9E3C80D649","seVolume":1},{"slideTitle":"中扉","telop":"","title":"その頃、彼は…","transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","voiceCharacter":"","duration":3,"characterName":"","seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.022.jpeg","backgroundName":"単色背景","id":"022B8AAA-F512-4518-9B57-F8F5FBD44928","seVolume":1},{"slideTitle":"第23スライド","telop":"「異常を検知しました。ある部屋から、ある空気が発生しています。電力供給を止めますか？」","title":"シーン 23","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_ナレーション.wav","voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","voiceDuration":6.6539002267573695,"voiceCharacter":"ナレーション","duration":4.3,"audioTrack":"track_voice__2DEA","characterName":"ナレーション","seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.023.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"ADAA7674-AA19-4001-AF9C-6188A7F47995","seVolume":1},{"animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","slideTitle":"第24スライド","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.024.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","voiceStartTimeOffset":0,"telop":"「その部屋の位置と現在の状況をモニターで映して。」","seStartTimeOffset":0,"id":"BA33151F-186E-46F9-9979-DCE2489EDD43","title":"シーン 24","voiceDuration":3.2952154195011336},{"animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_ナレーション.wav","slideTitle":"第25スライド","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice__2DEA","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.025.jpeg","voiceCharacter":"ナレーション","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"ナレーション","voiceStartTimeOffset":0,"telop":"「承知しました。管理モニターを起動中です…」","seStartTimeOffset":0,"id":"4442B83D-D9A6-4AFB-A77D-0587B5A88A94","title":"シーン 25","voiceDuration":3.288684807256236},{"animationName":"なし","duration":5.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","slideTitle":"第26スライド","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.026.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","voiceStartTimeOffset":0,"telop":"僕は、それを見ると、唖然とする。それは、さっきほど消えた空気とほぼ同じ空気だった。そして、急ぎその部屋に向かった。","seStartTimeOffset":0,"id":"1D964834-DF7A-4694-87D4-3199ACB6F5EB","title":"シーン 26","voiceDuration":8.803900226757369},{"animationName":"なし","duration":3,"slideTitle":"中扉","transitionName":"なし","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.027.jpeg","voiceCharacter":"","seVolume":1,"characterName":"","voiceStartTimeOffset":0,"telop":"","seStartTimeOffset":0,"id":"A9A7736C-626B-405C-AEDF-BE3B1DD85333","title":"彼がその部屋に着くと…"},{"animationName":"なし","duration":5.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","slideTitle":"第28スライド","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.pxd","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.028.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","characterName":"操夢","voiceStartTimeOffset":0,"telop":"僕が、その部屋に来ると、すでにそこでは、その空気が充満していた。僕は、コンセントの場所を確認し、抜き取る。","seStartTimeOffset":0,"id":"A93823A5-21C5-4BCF-8108-5270CA88DC87","title":"シーン 28","voiceDuration":8.38},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","characterName":"操夢","slideTitle":"第29スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":5.4,"seVolume":1,"title":"シーン 29","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.029.jpeg","telop":"そして、部屋の扉を開け、空気が廊下に出ると、とりあえず息を吐く。そして、ふとその空気の排出元を見ると、驚く。","id":"B4CE296D-1297-42BC-879F-BDF1070BE500","animationName":"なし","voiceDuration":8.634331065759637},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","characterName":"操夢","slideTitle":"第30スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":5.6000000000000005,"seVolume":1,"title":"シーン 30","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.030.jpeg","telop":"それは、最大100万円以上する、リンゴマークでお馴染みのデスクトップコンピューターだった。そして、ふと気がつく。","id":"412C82C6-33A1-4090-B0D8-112182BCBF05","animationName":"なし","voiceDuration":7.498458049886621},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","characterName":"操夢","slideTitle":"第31スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":4.7,"seVolume":1,"title":"シーン 31","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.031.jpeg","telop":"コンピューターの基盤と共に小さな加湿器が埋め込まれていて、そこから、空気が出ていたようだった。","id":"1DC4C117-D85F-4CB7-8E5C-7B676FD40BEF","animationName":"なし","voiceDuration":6.165850340136054},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","characterName":"操夢","slideTitle":"第32スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":5.5,"seVolume":1,"title":"シーン 32","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.032.jpeg","telop":"僕はそれを取り出し、加湿器を取り出してみる。すると、そこには謎の液体と共に、小さなメモ用紙貼り付けられていた。","id":"00B18765-479D-43AE-A632-158065BD5247","animationName":"なし","voiceDuration":8.13},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","characterName":"操夢","slideTitle":"第33スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":5.1000000000000005,"seVolume":1,"title":"シーン 33","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.033.jpeg","telop":"メモ用紙には、この加湿器の差出人と、納付先が記載されていた。「八雲紫依頼の品を、にとりに納付」っと…。","id":"325BC957-7FFA-4427-B9B5-347F37CB310C","animationName":"なし","voiceDuration":8.057165532879818},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","characterName":"操夢","slideTitle":"第34スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":5.800000000000001,"seVolume":1,"title":"シーン 34","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.034.jpeg","telop":"そして、僕はあることに気がつく。わざわざ発電所から直に給電させたのは、加湿器から爆速であの空気を広めるためなのだと…","id":"05B026D9-59D3-40C2-8F88-C6EA13EEA5C9","animationName":"なし","voiceDuration":8.808253968253968},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","characterName":"操夢","slideTitle":"第35スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc240799_パソコン部屋（夜・照明ON）.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":3.5,"seVolume":1,"title":"シーン 35","transitionName":"なし","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","seStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.035.jpeg","telop":"僕は、その加湿器だけ、抜き取ると、あの部屋に持って行った。","id":"27827618-12C5-4936-8F63-19B8D8C6A82E","animationName":"なし","voiceDuration":4.239773242630386},{"characterName":"八雲紫","slideTitle":"中扉","voiceStartTimeOffset":0,"duration":3,"seVolume":1,"title":"その頃、紫は…","seStartTimeOffset":0,"transitionName":"なし","backgroundName":"単色背景","voiceCharacter":"八雲紫","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.036.jpeg","telop":"","id":"A497011F-2954-4AE4-A7C6-4C59F95D9D96","animationName":"なし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_博麗霊夢.wav","characterName":"博麗霊夢","slideTitle":"第37スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_reimu","duration":4.9,"seVolume":1,"title":"シーン 37","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.037.jpeg","telop":"私と魔理沙は、あれから霖之助に問い詰めた後、\n真犯人を把握し、その犯人の家にやってきて会議を開いた。","id":"C8CFCD54-B183-445E-B79C-982798B9232A","animationName":"なし","voiceDuration":8.644489795918368},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_八雲紫.wav","characterName":"八雲紫","slideTitle":"第38スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","duration":3.5,"seVolume":1,"title":"シーン 38","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"voiceCharacter":"八雲紫","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.038.jpeg","telop":"「えっと…みなさんお揃いで、どんな御用でしょうか…？」","id":"6E23F78B-6B97-44FF-B390-C1B4485E23BF","animationName":"なし","voiceDuration":3.1319727891156464},{"seName":"SE: 自主規制ピー音","transitionName":"なし","id":"3B405D9A-3E5B-4726-892D-C9445617653B","duration":5.800000000000001,"animationName":"なし","voiceDuration":9.306984126984126,"voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.039.jpeg","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/自主規制ピー音.mp3","characterName":"博麗霊夢","title":"シーン 39","audioTrack":"track_voice_reimu","slideTitle":"第39スライド","telop":"「私たちは知ってるのよ、外の世界から持ってきた⚪︎薬加湿器を、一緒に持ってきた機械に埋め込んで、香霖堂に送ったの。」","seStartTimeOffset":0,"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_039_博麗霊夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","id":"04262150-88D5-4B59-9DC7-39CEA6CF34C5","duration":3.5,"animationName":"なし","voiceDuration":2.4312925170068027,"voiceCharacter":"八雲紫","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.040.jpeg","characterName":"八雲紫","title":"シーン 40","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"第40スライド","telop":"「えっと…それには、訳がありまして…」","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_八雲紫.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","id":"2759DC77-B8F8-4997-9C21-F828EFD229A2","duration":4.800000000000001,"animationName":"なし","voiceDuration":6.909478458049887,"voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.041.jpeg","characterName":"博麗霊夢","title":"シーン 41","audioTrack":"track_voice_reimu","slideTitle":"第41スライド","telop":"「どんな言い分言ったって無駄よ、皆に迷惑をかけたのは、\nあんただっていうことは変わらないからね。」","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_博麗霊夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","id":"80359D57-FB5D-4CE7-A9BA-E2263870A501","duration":4.800000000000001,"animationName":"なし","voiceDuration":8.166984126984127,"voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.042.jpeg","characterName":"博麗霊夢","title":"シーン 42","audioTrack":"track_voice_reimu","slideTitle":"第42スライド","telop":"「とにかく、あんたと霖之助と、にとりには罰を与えるわよ、さぁ、あの3人に、罰を与えましょうか。」","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_博麗霊夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"id":"B4C2A66B-1EED-46DC-9138-664038919775","transitionName":"なし","duration":3,"animationName":"なし","voiceCharacter":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.043.jpeg","characterName":"ナレーション","title":"シーン 43","slideTitle":"第43スライド","telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","id":"DE1C185E-355C-4921-A598-6CE17E174D2E","duration":5.2,"animationName":"なし","voiceDuration":8.694126984126983,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.044.jpeg","characterName":"操夢","title":"シーン 44","audioTrack":"track_voice_soumu","slideTitle":"第44スライド","telop":"あの後、真犯人である紫は、然るべき罰を共犯である霖之助と、にとりとともに、受け、幻想郷には平和が戻った。","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","id":"401059C2-A3BD-48F4-9A8C-FAD4B4C52A21","duration":5.800000000000001,"animationName":"なし","voiceDuration":8.968027210884355,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.045.jpeg","characterName":"操夢","title":"シーン 45","audioTrack":"track_voice_soumu","slideTitle":"第45スライド","telop":"そして僕は、その後、霊夢と共に博麗神社に住むことになり、時折、紅魔館や地霊殿と行ったり来たりしながらすごすのだった。","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","id":"37CCA481-26B2-4238-9873-AEF3FBA34D6E","duration":5.1000000000000005,"animationName":"なし","voiceDuration":8.744489795918367,"voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.046.jpeg","characterName":"博麗霊夢","title":"シーン 46","audioTrack":"track_voice_reimu","slideTitle":"第46スライド","telop":"「さて、あんたの初めてを誰が取るかの抽選に、受かったことだし、早速始めましょうよ…」私はそう彼に言う。","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_博麗霊夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"seName":"SE: ちゃんちゃん♪1","transitionName":"なし","id":"F0049A9F-AE81-4973-805A-5DD8DC85FA08","duration":7.5,"animationName":"なし","voiceDuration":11.949546485260772,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.047.jpeg","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ちゃんちゃん♪1.mp3","characterName":"操夢","title":"シーン 47","audioTrack":"track_voice_soumu","slideTitle":"第47スライド","telop":"あと、紫たちに罰が与えらたのちに、宴会で抽選が開かれ、当選したのが嬉しいのか、酔った霊夢が、帰ってきてそれから、順々に幻想郷の住人に襲われるのでした…","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","seVolume":1,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"seName":"SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～","id":"2C48EE36-9396-4512-9926-F8E787979F9F","transitionName":"なし","duration":20,"animationName":"なし","voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/東方惑情録　第７話_add878d3bf\/東方惑情録　第７話_add878d3bf.048.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～.wav","characterName":"フランドール・スカーレット","title":"ご視聴ありがとうございました！","slideTitle":"中扉","telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"単色背景"}]