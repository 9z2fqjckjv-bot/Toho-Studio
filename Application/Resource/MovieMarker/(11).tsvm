21","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_レミリア・スカーレット.wav","bgmVolume":0.7,"id":"F61F3615-BAA0-4523-87FF-B41615A4CDB4","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"telop":"「それ、飲んでみてもいい？」","seStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"voiceDuration":1.6317460317460317,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.022.jpeg","title":"シーン 22","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #22","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","bgmVolume":0.7,"id":"8B713D24-28BA-4E4F-B5F1-84B1F98862E0","voiceCharacter":"操夢","bgmStartTimeOffset":0,"seVolume":1,"telop":"「ええ、もちろん。」僕はそういうと、バックから紙コップを取り出し、ワインを注ぐと、彼女に手渡す。「どうぞ。」","seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":8.55607709750567,"voiceDuration":7.956077097505669,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.023.jpeg","title":"シーン 23","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #23","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","bgmVolume":0.7,"id":"300D3477-3A1F-4F45-AD2B-595B1CE09A12","voiceCharacter":"操夢","bgmStartTimeOffset":0,"seVolume":1,"telop":"彼女は、紙コップに入ったワインを一口で飲み切ると、瞬く間に笑みが溢れる。「どうですか、美味しいですか？」","seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":8.001723356009071,"voiceDuration":7.401723356009071,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.024.jpeg","title":"シーン 24","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #24","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_レミリア・スカーレット.wav","bgmVolume":0.7,"id":"B44AEA11-080E-4F4F-9043-4463D1DE9619","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"telop":"「うん、美味しい！」","seStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"voiceDuration":1.1213151927437641,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.025.jpeg","title":"シーン 25","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #25","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","bgmVolume":0.7,"id":"A9C3C26D-FAEA-4498-8A5A-C43F38513FCF","voiceCharacter":"操夢","bgmStartTimeOffset":0,"seVolume":1,"telop":"「そうですか、それで何よりです。それで、僕がこの前、ここを離れてから、今までに何があったか、教えてくれますか？」","seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":9.0756462585034,"voiceDuration":8.475646258503401,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.026.jpeg","title":"シーン 26","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #26","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_レミリア・スカーレット.wav","bgmVolume":0.7,"id":"F5CBB6D8-DE55-47D8-9006-2420665C73F5","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"telop":"「えっと…」","seStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"voiceDuration":0.6248979591836735,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.027.jpeg","title":"シーン 27","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #27","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_レミリア・スカーレット.wav","bgmVolume":0.7,"id":"FEB3BDA2-C3AD-4FC6-9202-FB729A02D878","voiceCharacter":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"telop":"「分かったわよ…、ただし、そのワインを飲みながら、ね。」","seStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","animationName":"なし","voiceStartTime