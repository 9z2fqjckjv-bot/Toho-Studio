":0.7,"seVolume":1,"telop":"すると、パチュリーが驚きの表情でこちらを見る。","seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":3.7039002267573697,"voiceDuration":3.1039002267573697,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.033.jpeg","title":"シーン 33","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"スライド #33","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_パチュリー・ノーレッジ.wav","id":"24442E71-7A5C-40A9-BB4E-CC6819FF2F68","voiceCharacter":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"telop":"「一体、レミノアと何してたら、彼女が寝つくのよ。」","seStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":3.630634920634921,"voiceDuration":3.030634920634921,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.034.jpeg","title":"シーン 34","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"スライド #34","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","id":"B498288B-EE76-4B03-965A-7E0EA98076C2","voiceCharacter":"操夢","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"telop":"「名古屋で買ってきたワインを彼女が飲みながら、今までの経緯を聞いていたら、自然と寝落ちしましたよ。」","seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":6.9386848072562355,"voiceDuration":6.338684807256236,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.035.jpeg","title":"シーン 35","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"スライド #35","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_パチュリー・ノーレッジ.wav","id":"E4E72C94-9CF4-4863-AC25-C629E720DF93","voiceCharacter":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"telop":"「そう…」私は彼の行動に呆れてしまう。","seStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","animationName":"なし","voiceStartTimeOffset":0,"transitionName":"なし","duration":3.0163038548752836,"voiceDuration":2.4163038548752835,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_11__75a569f27f\/_11__75a569f27f.036.jpeg","title":"シーン 36","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"スライド #36","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","voiceAudioPath":"