[{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第1スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 1","duration":9.02891156462585,"telop":"僕は、ふと気がつくと、そこはフランと僕の二人部屋だった。\nすると、扉が、突如として開き、誰かが入ってくる。\n東方Project二次創作作品","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.001.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","voiceDuration":8.428911564625851,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"6CA9CAB8-6187-4156-881D-9EBEA4312BB3","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第2スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 2","duration":3.386984126984127,"telop":"「あら、目が覚めたの、紅夢くん…。」\n作成者：zuyasi","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.002.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_フランドール・スカーレット.wav","voiceDuration":2.786984126984127,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"6CBD9BBD-1A0F-4F64-AA53-A7C95BF88790","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundName":"単色背景","slideTitle":"中扉","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"僕はふと、彼女の吐息が酒臭いことに気がつく。「…フランさん、どれだけお酒を飲みましたか？」","duration":6.9778231292517,"telop":"僕はふと、彼女の吐息が酒臭いことに気がつく。「…フランさん、どれだけお酒を飲みましたか？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.003.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","voiceDuration":6.3778231292517,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"A74F65E2-CB4A-4169-951F-07A0C83B419A","seVolume":1,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"seStartTimeOffset":2.33,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":0.85,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第4スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 4","duration":5.753900226757369,"telop":"僕がそう尋ねるが、返答はなく、\n代わりに彼女は僕をベッドの上に押し倒す。\n制作ソフト及び協力\nGemini\nTohoStuido","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.004.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","voiceDuration":5.1539002267573695,"characterName":"操夢","bgmVolume":0.7,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ2.mp3","id":"21BCF2C8-7996-48A2-AAD7-3A1031760D61","seName":"SE: 衣擦れ2","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第5スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 5","duration":10.234489795918368,"telop":"「そんなことよりも…」私はそう言いながら、服を動かし、彼に下着と生身をチラ見せする。「どう、先生といいことしない？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.005.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_フランドール・スカーレット.wav","voiceDuration":9.634489795918368,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"A2E69E8A-6CDA-4FFB-B279-B6929DB34F7D","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第6スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 6","duration":8.40390022675737,"telop":"「でも…僕は…」僕は彼女をそう制止させようとするが、そう言いかける口を彼女は、そっと口付けをして封じてくる。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.006.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","voiceDuration":7.80390022675737,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"3F6E03EC-5DBC-4AC9-9750-0D8384D900FB","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第7スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 7","duration":4.006984126984126,"telop":"「どう、このまま先生に身を任せてくれない？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.007.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_フランドール・スカーレット.wav","voiceDuration":3.406984126984127,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"7C356D89-D9C7-4FF7-9D37-F5AB5701B0A0","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第8スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 8","duration":9.30172335600907,"telop":"僕はそう言われ、一瞬断ろうかと思ったが、雰囲気的に難しいと感じ、全身の力を抜いて、脱力する。「それじゃあ…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.008.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","voiceDuration":8.70172335600907,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"D373554D-CF97-43A9-9E97-3212AD326547","seVolume":1,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第9スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 9","duration":9.026984126984127,"telop":"「ありがとう、それじゃあ、気持ち良くしてあげる。」\n私はそういい、彼の服を脱がすと、自らも服を脱いだ。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.009.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_フランドール・スカーレット.wav","voiceDuration":8.426984126984127,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"6CB096FD-D9C1-4FE9-B265-540F2DC541A7","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"backgroundName":"単色背景","slideTitle":"タイトル","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"東方Project二次創作作品　Powerd By zuyasi","duration":3,"telop":"元女子校の日常","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.010.jpeg","bgmVolume":0.7,"characterName":"","seStartTimeOffset":0,"id":"9F1A3093-6B2C-4AF6-8911-045044AF3313","voice2StartTimeOffset":0},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第11スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 11","duration":8.132154195011339,"telop":"「んっ…」僕はふと目が覚めると、窓から朝日が差し込んでいた。そして、ふとある違和感を感じ、隣を見る。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.011.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","voiceDuration":7.532154195011338,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"0908345A-2331-4A1B-8466-CF754490C1BF","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第12スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 12","duration":9.285419501133786,"telop":"僕は、隣を見た瞬間に、裸のフランを見てしまい、さっとベッドから飛び出る。そして、ふと手元を見ると僕も裸だった。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.012.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","voiceDuration":8.685419501133786,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"62FA8CBD-F2FB-457B-91F8-6DF7141CC18D","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"seVolume":0.85,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第13スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 13","duration":8.20172335600907,"telop":"僕は、服を着るということが抜け落ちたまま、あたふたしていると、突如として扉をノックされ、レミリアの声が聞こえる。","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.013.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","voiceDuration":7.60172335600907,"characterName":"操夢","bgmVolume":0.7,"seName":"SE: 木のドアをノック1","id":"B66D57CC-2CF6-4BD2-A607-739C79308C81","seStartTimeOffset":2.07,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第14スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 14","duration":7.371315192743764,"telop":"「もう起きてるの、二人とも？起きているなら、返事をしなさい。じゃないと、勝手に扉を開けるわよ。」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.014.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_レミリア・スカーレット.wav","voiceDuration":6.7713151927437645,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"9D0743AC-63B0-42E6-8A06-C3673D97E94F","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"seVolume":0.85,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第15スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 15","duration":9.948027210884353,"telop":"僕は、ふとフランの方を見ると、彼女は依然として裸のまますやすやと眠っていた。僕は、そのまま戸惑っていると、扉が開く。","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアを開ける1.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.015.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","voiceDuration":9.348027210884354,"characterName":"操夢","bgmVolume":0.7,"seName":"SE: ドアを開ける1","id":"C956E86C-7A71-4ACB-BB63-2C2C648081FF","seStartTimeOffset":2.97,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第16スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 16","duration":8.369115646258503,"telop":"そして、部屋に入ってきた彼女は、みるみるうちに頬を赤く染めていた。「あの…レミリアさん…僕は…どうすれば…」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.016.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voiceDuration":7.769115646258504,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"267DF608-30C8-4567-A0EE-357D32C25A20","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第17スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 17","duration":2.731746031746032,"telop":"「とりあえず、服を着たらどうなの？」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.017.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_レミリア・スカーレット.wav","voiceDuration":2.1317460317460317,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"1A64A750-9291-4B51-B2D8-3549AD03D6D0","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第18スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 18","duration":8.843038548752833,"telop":"僕は、彼女にそう指摘され、自分が裸のままであることに気づく。そして、ベッドの下に服があり、それを取って切る。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.018.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","voiceDuration":8.243038548752834,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"4225647C-F01B-4E65-A70A-64E869734B8A","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第19スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 19","duration":8.38798185941043,"telop":"「とりあえず、私は食堂に戻るから、あなたもフランを起こして、ささっと食堂に来なさい、そこでこの件は話しましょう。」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.019.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_レミリア・スカーレット.wav","voiceDuration":7.787981859410431,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"98966619-7563-44B9-8F16-F56D3C567072","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第20スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 20","duration":7.065850340136054,"telop":"彼女はそういうと、部屋をさっていった。\nそれから、静けさが部屋に戻ると、フランが目を覚ます。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.020.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voiceDuration":6.465850340136054,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"61D0FDCF-0550-423E-AB95-D5C2089C525F","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第21スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 21","duration":2.5,"telop":"「んっ…」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.021.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_フランドール・スカーレット.wav","voiceDuration":0.6419954648526077,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"735F6810-589E-45E9-BE78-B2A046016A95","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第22スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 22","duration":6.149478458049886,"telop":"「あれ…ここは…」\n私は、そう言いながら、だんだんと頭が冴えてくる。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.022.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav","voiceDuration":5.549478458049887,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"28C5CF66-F9FA-4C6B-8C05-AE98156C835E","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第23スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 23","duration":5.128231292517007,"telop":"「紅夢くん…昨日はごめんなさい、真夜中に襲いかかって…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.023.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_フランドール・スカーレット.wav","voiceDuration":4.528231292517007,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"26538355-4504-416A-BDAE-8817B5BC974B","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第24スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 24","duration":2.906077097505669,"telop":"「それより、服を着てくれませんか…？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.024.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voiceDuration":2.306077097505669,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"44981E0B-E539-4D92-BC41-3B7CC47713AE","seVolume":1,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第25スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 25","duration":4.304489795918367,"telop":"「とりあえず、着替えるから、部屋から出てくれない？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.025.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_フランドール・スカーレット.wav","voiceDuration":3.7044897959183674,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"7925094B-45B5-43F4-8653-2ABED092B7F6","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第26スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 26","duration":9.286507936507936,"telop":"「分かりました…、着替えたら食堂に来てください。僕は、先に食堂に向かっているので。」僕はそういうと、部屋を離れた。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.026.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceDuration":8.686507936507937,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"42118A86-9F06-488C-B087-4FD9A23B1792","seVolume":1,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第27スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 27","duration":5.082154195011338,"telop":"僕は、それから食堂に来ると、すでに朝食の準備ができていた。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.027.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_027_操夢.wav","voiceDuration":4.482154195011338,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"E6A7ACA8-8D3A-4164-8BD0-57333C515B47","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第28スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 28","duration":7.690861678004535,"telop":"それから、10分程度でフランもやってくる。\nすると、挨拶を済ますと、3人で朝食を食べ始めた。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.028.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voiceDuration":7.0908616780045355,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"C838AF4D-DFAD-4C5C-B51C-E36674BC2268","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"seVolume":0.85,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第29スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 29","duration":4.685895691609977,"telop":"「それで、〇〇を卒業した気分を教えてくれるかしら、紅夢。」","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/自主規制ピー音.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.029.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_029_レミリア・スカーレット.wav","voiceDuration":4.085895691609977,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seName":"SE: 自主規制ピー音","id":"254D4107-AEBB-46FF-8CDF-6202C05DFE7B","seStartTimeOffset":0.21999999999999886,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"seVolume":0.85,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第30スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 30","duration":6.699546485260771,"telop":"「あの、〇〇ってなんですか…？」\n僕は、フランが頬照りながら驚いている姿を見ながらいう。","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/自主規制ピー音.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.030.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_030_操夢.wav","voiceDuration":6.099546485260771,"characterName":"操夢","bgmVolume":0.7,"seName":"SE: 自主規制ピー音","id":"FE604E22-8A9E-48DD-A3D6-CB0C95FB0F48","seStartTimeOffset":0.19999999999998863,"voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第31スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 31","duration":4.248412698412698,"telop":"「こんなこと言わなくてもわかるでしょ。それで、どうなの？」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.031.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_レミリア・スカーレット.wav","voiceDuration":3.6484126984126983,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"68C4CA29-753A-41A8-BC8D-C5FD3CA9687C","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第32スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 32","duration":8.419115646258504,"telop":"僕は、そういうとレミリアの表情と今までの会話から、その言葉の意味を推測する。「フランさんならわかると思いますが…」","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.032.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_032_操夢.wav","voiceDuration":7.819115646258504,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"06D19B78-464B-44C1-99FB-FF501EEE2854","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideTitle":"第33スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 33","duration":4.652811791383219,"telop":"それから僕が二人に告げた、ある内容に二人は驚くのだった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（驚く）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.033.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","voiceDuration":4.05281179138322,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"EC40FEFD-5C84-4A2B-B170-1B9AE9E4C4D6","seVolume":1,"voiceCharacter":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第34スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 34","duration":3,"telop":"それから…","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.034.jpeg","bgmVolume":0.7,"characterName":"ナレーション","seStartTimeOffset":0,"id":"3814C361-96FE-483A-BB6D-5EDAFAA8A11E","voice2StartTimeOffset":0},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"第35スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 35","duration":9.488684807256236,"telop":"それから、僕は、朝食を食べ終えて、身支度を整えると、フランに図書館の場所を聞いて、やってきた。そしてある本を探す。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.035.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_035_操夢.wav","voiceDuration":8.888684807256237,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"4A8BEEEC-E798-4A6E-819F-C710C75C630D","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第36スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 36","duration":9.191950113378685,"telop":"それから、目的の本がありそうな棚を見つけ、その棚をはじから見ていく。「あった。」僕はそう言い、その本を取り出し戻る。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.036.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voiceDuration":8.591950113378685,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"BC6B2916-A4D5-4F68-953B-644C43B0D749","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"第37スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 37","duration":8.85281179138322,"telop":"そして、取り出した本は、「全国財閥高統一模試」の過去問集だった。そして、フランにもらった新品のノートを開く。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.037.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_037_操夢.wav","voiceDuration":8.25281179138322,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"82955DF4-A590-4823-9068-EE7AE42D5568","voiceCharacter":"操夢"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","slideTitle":"第38スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 38","duration":8.970204081632653,"telop":"そこから、僕は遠足の2週間前に受ける、その試験に向けた勉強を黙々と、この大規模な図書館で進めていくのだった。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.038.jpeg","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","voiceDuration":8.370204081632654,"characterName":"操夢","bgmVolume":0.7,"seStartTimeOffset":0,"id":"884E0735-F35D-489C-8F75-45417508D440","voiceCharacter":"操夢"},{"backgroundName":"単色背景","slideTitle":"中扉","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"一方でフランとレミリアは…","duration":3,"telop":"","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.039.jpeg","bgmVolume":0.7,"characterName":"フランドール・スカーレット","seStartTimeOffset":0,"id":"150A5F50-945C-4824-A875-F0C482A15AE2","voice2StartTimeOffset":0},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第40スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 40","duration":2.5,"telop":"「ねぇ、フラン。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.040.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_レミリア・スカーレット.wav","voiceDuration":1.1046485260770975,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"ECB2B84F-0105-418C-898A-FD9F3C3199E6","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第41スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 41","duration":2.5,"telop":"「なに、お姉様？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.041.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_フランドール・スカーレット.wav","voiceDuration":1.6844897959183673,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"1130B263-E6BB-404D-9D54-5BCD2923F6B8","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第42スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 42","duration":3.8775736961451246,"telop":"「フランは、昨晩のパーティー、どこまで覚えてるの？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.042.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_レミリア・スカーレット.wav","voiceDuration":3.2775736961451245,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"CE1FFDC4-E36A-41EE-8524-D91DA1D1B0F5","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第43スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 43","duration":4.315736961451247,"telop":"「えっと…」私はそう言われ、記憶を遡る。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.043.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_フランドール・スカーレット.wav","voiceDuration":3.715736961451247,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"F5981AAC-B140-462E-83D4-AEB0369BCA10","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第44スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 44","duration":9.690748299319727,"telop":"昨晩、彼女が図書館に行った後、私とお姉様は、もともとこの屋敷に住んでいた咲夜たちとの飲み会に向かった。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.044.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_フランドール・スカーレット.wav","voiceDuration":9.090748299319728,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"0BE26796-231F-4E73-BC14-A0D3205FCA95","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第45スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 45","duration":9.551995464852608,"telop":"すると、始まってからすぐに、パチュリーが私に、祝いの言葉を告げる。その後、順々に言葉を聞き終えていく。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（微笑）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.045.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_フランドール・スカーレット.wav","voiceDuration":8.951995464852608,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"9F381516-8B05-4E73-BBCE-3B809061069C","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第46スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 46","duration":9.216984126984126,"telop":"私は、彼女たちからの祝いの言葉に少し困惑する。\nなぜなら、彼との結婚が決まったわけではないからだ。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（微笑）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.046.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_フランドール・スカーレット.wav","voiceDuration":8.616984126984127,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"A15068A1-4527-4CB7-A1E3-A167CE14F92B","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","backgroundName":"咲夜（困る）.png","slideTitle":"第47スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 47","duration":9.309478458049886,"telop":"すると、咲夜が私になぜ、困っているかを聞いてくる。\n私が戸惑っていると、お姉様がそのことを伝える。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.047.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_フランドール・スカーレット.wav","voiceDuration":8.709478458049887,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"E750C6F2-0B45-42AE-9F20-DC0E111962FF","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","backgroundName":"咲夜（弱る）.png","slideTitle":"第48スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 48","duration":8.439478458049887,"telop":"その言葉に皆は、謝り、少しばかし空気が暗くなりかけてたところに、赤ワインとお通しが出てくる。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.048.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_フランドール・スカーレット.wav","voiceDuration":7.839478458049887,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"8736C1D0-0B10-4420-8DDC-5EE7EE46D091","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","backgroundName":"咲夜（弱る）.png","slideTitle":"第49スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 49","duration":9.934489795918367,"telop":"そして、それからしばらく経つと、お酒だけ飲んでいた私とお姉様は…、私はその先を思い出そうとするが、思い出せない。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.049.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_フランドール・スカーレット.wav","voiceDuration":9.334489795918367,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"0E5E7838-1072-48C5-9D3C-611FBC85704A","voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第50スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 50","duration":8.292154195011339,"telop":"「確かに、あの時は、私とフランだけすでに食事を済ませて、酒を飲んでいたのが、原因なのは分かっている、けど…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.050.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_レミリア・スカーレット.wav","voiceDuration":7.692154195011338,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"27B8A85A-A1A5-4544-A649-CB68E7D71102","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第51スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 51","duration":7.673401360544218,"telop":"「私がフランにいう資格は、ないかもしれないけど、少しばかし、アルコールの自己管理くらい、出来たらどうかしら？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.051.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_レミリア・スカーレット.wav","voiceDuration":7.073401360544218,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"8932A604-A62C-46D4-9C07-33B407C63C48","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第52スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 52","duration":10.054489795918366,"telop":"私は、お姉様の指摘通りなので、頭を抱えて考える。だが、だんだんとオーバヒートしているような感覚がしてくる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.052.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_フランドール・スカーレット.wav","voiceDuration":9.454489795918366,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"AEF7356D-F9DB-47D3-8342-E4908A27E704","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第53スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 53","duration":7.358820861678004,"telop":"私はそこで、「しまった」とつぶやく。だが、\nそう呟いている間にも、フランはこちらに攻撃をしてくる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.053.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_レミリア・スカーレット.wav","voiceDuration":6.7588208616780046,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"52AF56F2-3626-4D50-A11B-F3962C511A83","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第54スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 54","duration":8.275487528344671,"telop":"私は、彼女の攻撃を避けながら、あるものを探す。\nすると、ハッと思い出し、その場所に向かい、疾走する。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.054.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_レミリア・スカーレット.wav","voiceDuration":7.6754875283446715,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"426821F4-8D01-4B89-995C-E557CDA20B75","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第55スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 55","duration":7.171315192743764,"telop":"そして、フランの攻撃を避けながら、なんとか取り出したそれを、フランの攻撃の隙をつき、ぷつっと刺す。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.055.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_レミリア・スカーレット.wav","voiceDuration":6.571315192743764,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"262B29EC-7889-49DA-8295-06E8A7BDA99F","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第56スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 56","duration":3.8632426303854874,"telop":"「あれ…今私は、なにしてたんだっけ？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.056.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_フランドール・スカーレット.wav","voiceDuration":3.2632426303854873,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"B9A09B0E-5887-4E66-8F2D-6E26014E61A5","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第57スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 57","duration":3.9192290249433106,"telop":"「とりあえず、彼のいる図書館に行ってきたらどうかしら？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.057.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_レミリア・スカーレット.wav","voiceDuration":3.3192290249433105,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"3940C2DF-2E8D-4A2E-B53E-0C981131C1B7","seVolume":1,"voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第58スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 58","duration":3.0244897959183676,"telop":"「じゃあ、図書館にいってくるね。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.058.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_フランドール・スカーレット.wav","voiceDuration":2.4244897959183676,"characterName":"フランドール・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"8DDC0776-EC1C-4A30-81D7-7B0389424BAA","seVolume":1,"voiceCharacter":"フランドール・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第59スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 59","duration":5.251995464852607,"telop":"フランはそういうと去っていった。\nそして、私は先ほど使用したそれをみる。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.059.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_レミリア・スカーレット.wav","voiceDuration":4.651995464852607,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"1A0A17B6-C78B-42F8-9903-DA59BC4A17D5","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第60スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 60","duration":9.712403628117913,"telop":"これは、注射器で、その中には、ある人物の血液が入っていた。\nその人物は、今、彼が元いた家に住んでいる女性のものだった。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.060.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_レミリア・スカーレット.wav","voiceDuration":9.112403628117914,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"4ADEB499-079E-4990-A7E1-60B57F27B54B","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第61スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 61","duration":8.846326530612245,"telop":"「どっかのタイミングで、彼から採血しないとね…」特殊な体を持つ二人の血液は、フランの狂気を瞬時に、鎮静化できた。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.061.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_レミリア・スカーレット.wav","voiceDuration":8.246326530612246,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"A16B5469-C231-41FA-95BB-26494F224D7B","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第62スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 62","duration":8.315079365079365,"telop":"このことを知るまでは、フランの狂気を肉弾戦で食い止めるか、一瞬の隙をついて気絶させるかの二択しかなかったのだった。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.062.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_レミリア・スカーレット.wav","voiceDuration":7.715079365079365,"characterName":"レミリア・スカーレット","bgmVolume":0.7,"seStartTimeOffset":0,"id":"7083A735-5BD8-4146-AEA8-7CB9FC691420","voiceCharacter":"レミリア・スカーレット"},{"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第63スライド","bgmStartTimeOffset":0,"transitionName":"なし","voiceStartTimeOffset":0,"animationName":"なし","title":"シーン 63","duration":8.346326530612245,"telop":"彼とその女性には、狂気というものは存在しないが、別の要素を持っていた。この流れは、今後も続くかもしれない。","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第12話_32d321c69a\/元女子校の日常　第12話_32d321c69a.063.jpeg","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedA