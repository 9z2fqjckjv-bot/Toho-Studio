te":"アニメーション:25秒"},{"characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/寝室の窓際のベッド｜みんちりえ\/寝室の窓際のベッド（日中・青）.jpg","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/slide_036_anim.m4v","animationDuration":25,"animationName":"バウンス","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","slideTitle":"スライド #36","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.036.jpeg","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3","duration":25,"transitionName":"クロスディゾルブ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/キャラクター\/紅魔館\/フランドール・スカーレット\/フランドール・スカーレット(バトルっぽい2)\/赤面\/フラン（困り）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voiceCharacter":"操夢","voiceDuration":6.516984126984127,"seName":"[SE] 飲む.mp3","title":"シーン 36","telop":"そして、じんわり攻め込む。\nそして、しばらく経つと再び彼女は「あっ」と漏らす。","id":"5104A968-84C5-4151-8B42-F13F8E21EB2F","audioTrack":"track_voice__66B3","animationNote":"アニメーション:25秒"},{"characterName":"フランドール・スカーレット","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/寝室の窓際のベッド｜みんちりえ\/寝室の窓際のベッド（日中・青）.jpg","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/slide_037_anim.m4v","animationDuration":25,"animationName":"バウンス","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","slideTitle":"スライド #37","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.037.jpeg","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3","duration":25,"transitionName":"クロスディゾルブ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画