Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3","duration":10,"transitionName":"クロスディゾルブ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/キャラクター\/紅魔館\/フランドール・スカーレット\/フランドール・スカーレット(旧2)\/赤面\/フラン（弱る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_フランドール・スカーレット.wav","voiceCharacter":"フランドール・スカーレット","voiceDuration":3.7719954648526075,"seName":"[SE] 飲む.mp3","title":"シーン 17","telop":"「まだ、まだ…」\n私はそう言いながら、動く。","id":"A1AF8A16-13F0-4512-82FD-7CB3DC17572E","audioTrack":"track_voice__6B67","animationNote":"アニメーション:10秒"},{"characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/一人部屋３｜みんちりえ\/一人部屋３（日中）.jpg","animationDuration":10,"animationName":"バウンス","backgroundName":"一人部屋３（日中）.jpg","slideTitle":"スライド #18","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.018.jpeg","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/音楽\/効果音\/飲む.mp3","duration":10,"transitionName":"クロスディゾルブ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/キャラクター\/紅魔館\/フランドール・スカーレット\/フランドール・スカーレット(旧2)\/赤面\/フラン（弱る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","voiceCharacter":"操夢","voiceDuration":6.549478458049887,"seName":"[SE] 飲む.mp3","title":"シーン 18","telop":"彼女はそう言うが、動きの速度が下がり、\n僕は先ほどよりも丁寧に素早く突つく。","id":"6569C854-D5B0-41FE-B299-28BA51017358","audioTrack":"track_voice__66B3","animationNote":"アニメーション:10秒"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.019.jpeg","duration":9.304489795918366,"transitionName":"クロスディゾルブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","voiceCharacter":"操夢","voiceDuration":8.704489795918366,"title":"シーン 19","telop":"僕はふと気がつくと、レミリアとフランの二人が部屋に入ってきた。だが、なんとなく二人の様子に違和感を覚える。\n※察しのいい人にはPCが見えます。","id":"60D28B40-129B-4BB6-8B71-7427493AEB07","audioTrack":"track_voice__66B3","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #20","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.020.jpeg","duration":6.055124716553288,"transitionName":"クロスディゾルブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_レミリア・スカーレット.wav","voiceCharacter":"レミリア・スカーレット","voiceDuration":5.455124716553288,"title":"シーン 20","telop":"「ねぇ、操夢…、もう一回私を…いい気持ちにして…」\n※察しのいい人にはPCが見えます。","id":"08167A13-12E8-44BD-B78B-C9269B54DF63","audioTrack":"track_voice__D8BB","characterName":"レミリア・スカーレット"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #21","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85\/交換夫婦（21_22話目）叡智シーンのみ_4e85436a85.021.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_フランドール・スカーレット.wav","voiceCharacter":"フランドール・スカーレット","voiceDuration":2.536984126984127,"title":"シーン 21","telop":"「私も…お願い…操夢…」\n※察しのいい人にはPCが見えます。","id":"85E09F38-4655-4BA4-BA04-84CDBFD42DCA","audioTrack":"track_voice__6B67","characterName":"フランドール・スカーレット"},{"backgroundIma