dImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第3スライド","voiceDuration":4.440861678004535,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","characterName":"操夢","telop":"僕は、彼女にそう聞かれ、そっと彼女に近づき、耳打ちする。"},{"bgmName":"BGM: 東方妖恋談","id":"79E970FB-1782-44D8-89E9-A9F9BC6FC522","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.004.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第4スライド","voiceDuration":3.373469387755102,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","characterName":"操夢","telop":"すると、彼女は頬を赤らめて、大きな声を出す。"},{"bgmName":"BGM: 東方妖恋談","id":"791B8EB6-8669-4DFC-8839-FB8C209F907D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.005.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 5","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第5スライド","voiceDuration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_射命丸文.wav","characterName":"射命丸文","telop":"「それ、正気ですか？」"},{"slideTitle":"タイトル","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.006.jpeg","voiceCharacter":"","id":"CCDD71FB-6993-4724-84B5-8231302A2A06","transitionName":"クロスディゾルブ","telop":"交換夫婦","animationName":"なし","duration":3,"characterName":"","title":"東方Project二次創作 powerd by zuyasi","bgmName":"BGM: 東方妖恋談"},{"bgmName":"BGM: 東方妖恋談","id":"BD38567C-07CA-41EF-9F9D-642584FF9B4E","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.007.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 7","voiceDuration":2.940861678004535,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第7スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","characterName":"操夢","telop":"僕はそれから、これからのことを話し始める。"},{"bgmName":"BGM: 東方妖恋談","id":"1922FC59-CAB3-450C-9062-53B34C2BEF8F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.008.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 8","voiceDuration":4.032154195011338,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第8スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","characterName":"操夢","telop":"「霊夢さんたちは、あの会見を見て、何を考えましたか？」"},{"bgmName":"BGM: 東方妖恋談","id":"05192A7E-DDB5-4F1C-A109-9C8178262F38","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.009.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"博麗霊夢","title":"シーン 9","voiceDuration":5.858231292517007,"audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第9スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「えっと…」\n私は、彼の問いかけにどう答えるべきかわからず、そう呟く。"},{"bgmName":"BGM: 東方妖恋談","id":"D5FF51DD-36DF-49CF-9FE4-D9977FFF0B19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.010.jpeg","duration":5.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"霧雨魔理沙","title":"シーン 10","voiceDuration":9.104489795918367,"audioTrack":"track_voice_marisa","animationName":"なし","slideTitle":"第10スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_霧雨魔理沙.wav","characterName":"霧雨魔理沙","telop":"「さっきまで、乗せてたお客さんから聞いたんだが、守谷神社は、この問題には関わってないと硬い態度…だそうだぜ。」"},{"bgmName":"BGM: 東方妖恋談","id":"C39B3249-D517-42BE-B949-E14ED4AC2DAD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.011.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"レミリア・スカーレット","title":"シーン 11","voiceDuration":3.6171655328798185,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"第11スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","telop":"「あなただけに、その問題の責任を負わせるつもりかしら…」"},{"bgmName":"BGM: 東方妖恋談","id":"82E1462B-4D03-4591-9497-AB0B0E5BA0B4","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.012.jpeg","duration":4.6000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"パチュリー・ノーレッジ","title":"シーン 12","voiceDuration":6.010861678004535,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","animationName":"なし","slideTitle":"第12スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_パチュリー・ノーレッジ.wav","characterName":"パチュリー・ノーレッジ","telop":"「確かに、レミリアと魔理沙の言う通りね。\nでも、その問題の責任を紫たちは、あなたに転嫁した。」"},{"bgmName":"BGM: 東方妖恋談","id":"7F6CCA6E-85C6-43E8-949E-EA7A3F3740CF","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.013.jpeg","duration":5.6000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"古明地さとり","title":"シーン 13","voiceDuration":6.519795918367347,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","slideTitle":"第13スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_古明地さとり.wav","characterName":"古明地さとり","telop":"「彼女たちは、その責任をあなたに転嫁することで、政府とりわけ、紫や霊夢さんに不評が行かないように…してますね…」"},{"bgmName":"BGM: 東方妖恋談","id":"57E43A59-19E9-4DA7-B4ED-945B62D5611D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.014.jpeg","duration":5.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"十六夜咲夜","title":"シーン 14","voiceDuration":6.942086167800453,"audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","animationName":"なし","slideTitle":"第14スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_十六夜咲夜.wav","characterName":"十六夜咲夜","telop":"「今、彼女たちは自らの地位や立場の保全のために、世の不評や批判があなたに向かうように仕向けている…とも感じます。」"},{"bgmName":"BGM: 東方妖恋談","id":"FD2E51F2-B041-4F98-89B5-F80111436F74","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.015.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 15","voiceDuration":2.7517233560090704,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第15スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","characterName":"操夢","telop":"「フランさんとこいしさんは、どう思いますか？」"},{"bgmName":"BGM: 東方妖恋談","id":"2F5B624C-FAB4-421E-B432-D443F04EF5B3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.016.jpeg","duration":5.6000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"フランドール・スカーレット","title":"シーン 16","voiceDuration":9.054489795918368,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"第16スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","telop":"「私は、お姉様たちが言っていることが、ピンとは来ないけど、ただなんとなく、責任が操夢に乗っかってるのは分かる。」"},{"bgmName":"BGM: 東方妖恋談","id":"BAF34A92-98CA-4E75-B081-9959FF65C73E","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.017.jpeg","duration":5.1000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"古明地こいし","title":"シーン 17","voiceDuration":10.322925170068027,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","animationName":"なし","slideTitle":"第17スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_古明地こいし.wav","characterName":"古明地こいし","telop":"「私は…記者会見見てたけど、正直言って内容が入らなかった。\nそれで、操夢は、これからどうする予定なの？」"},{"bgmName":"BGM: 東方妖恋談","id":"11F12A09-1FC5-450C-8713-21B6286059AF","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.018.jpeg","duration":5.6000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 18","voiceDuration":8.688684807256235,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第18スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","characterName":"操夢","telop":"「僕は、とりあえず、問題が発覚したスクープを掲載した記者に、記者会見の内容の否定と、協力をお願いする予定です。」"},{"bgmName":"BGM: 東方妖恋談","id":"BDEEA59C-3002-42F5-ABD6-8B730ED9EBCE","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.019.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"レミリア・スカーレット","title":"シーン 19","voiceDuration":1.5,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"第19スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","telop":"「その記者って…」"},{"bgmName":"BGM: 東方妖恋談","id":"821666E6-614C-442F-9E4B-33842C4E4881","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.020.jpeg","duration":5.1000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 20","voiceDuration":7.1821541950113374,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第20スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","characterName":"操夢","telop":"「名前は…伏せときますが、今晩は、この施設で泊まるための許可をとってありますから、安心してください。」"},{"bgmName":"BGM: 東方妖恋談","id":"2BEE2DC0-8719-46EB-9E3D-BC55AFF3438F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.021.jpeg","duration":3.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"レミリア・スカーレット","title":"シーン 21","voiceDuration":5.571315192743764,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"第21スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","telop":"「そう…」私は、一つの懸念が浮かぶが、\n強く問いただすこともなく、そう呟く。"},{"bgmName":"BGM: 東方妖恋談","id":"368BE3F0-F6B1-4150-9EAB-2CC6B621F455","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.022.jpeg","duration":5.800000000000001,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 22","voiceDuration":7.964761904761905,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第22スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","characterName":"操夢","telop":"「レミリアさんたちが寝ている間に、戻りますから、それまで、このフロアマップを見て、部屋分けした後、休んでください。」"},{"bgmName":"BGM: 東方妖恋談","id":"854AA9E4-5A21-4343-B624-3C8304A3A609","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.023.jpeg","duration":4.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 23","voiceDuration":6.534331065759638,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第23スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","characterName":"操夢","telop":"「それじゃあ、僕はその場所に行ってきますね。」\n僕はそう言うと、フロアマップを開き、部屋を出た。"},{"slideTitle":"中扉","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.024.jpeg","voiceCharacter":"射命丸文","id":"8C8EC024-11F7-4B5D-80A4-9FB84939BE80","transitionName":"クロスディゾルブ","telop":"","animationName":"なし","duration":3,"characterName":"射命丸文","title":"操夢が文の家に着くと…","bgmName":"BGM: 東方妖恋談"},{"bgmName":"BGM: 東方妖恋談","id":"967E87E6-1577-4939-A7FD-B39B3166A799","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.025.jpeg","duration":4.3,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 25","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第25スライド","voiceDuration":6.164761904761905,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","characterName":"操夢","telop":"僕はそれから、家から持ってきたノートPCで不要になったシステム権限を移動中に放棄し、文の家にやってきた。"},{"bgmName":"BGM: 東方妖恋談","id":"D32BEBDF-5D91-4392-A63A-3B5E019308AD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.026.jpeg","duration":3.6,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 26","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第26スライド","voiceDuration":5.285578231292517,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_射命丸文.wav","characterName":"射命丸文","telop":"「それで、今日はどんな情報を、持ってきましたか？」\n私は、そう彼に尋ねる。"},{"bgmName":"BGM: 東方妖恋談","id":"8A13477A-F88F-4DEF-ACFB-40B5E3E865C6","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.027.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 27","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第27スライド","voiceDuration":4.775646258503401,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","characterName":"操夢","telop":"「例の記者会見の内容の否定と…、\n少しばかし協力をお願いしたくて…」"},{"bgmName":"BGM: 東方妖恋談","id":"5F19470F-189E-4270-8D43-6A6145810900","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.028.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 28","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第28スライド","voiceDuration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_射命丸文.wav","characterName":"射命丸文","telop":"「協力のお願いとは…」"},{"bgmName":"BGM: 東方妖恋談","id":"96CC3A3D-9E48-4C66-A5A9-70BABE18281D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.029.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 29","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第29スライド","voiceDuration":4.440861678004535,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","characterName":"操夢","telop":"僕は、彼女にそう聞かれ、そっと彼女に近づき、耳打ちする。"},{"bgmName":"BGM: 東方妖恋談","id":"676ECA58-4BF5-4D29-9241-FD43F723A7A3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.030.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 30","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第30スライド","voiceDuration":3.373469387755102,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","characterName":"操夢","telop":"すると、彼女は頬を赤らめて、大きな声を出す。"},{"bgmName":"BGM: 東方妖恋談","id":"5960FC9D-9A9B-4D35-8C0E-C381E7A8E0E9","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.031.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 31","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第31スライド","voiceDuration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_射命丸文.wav","characterName":"射命丸文","telop":"「それ、正気ですか？」"},{"bgmName":"BGM: 東方妖恋談","id":"D1FF0596-3060-42C1-91CF-841CC267AE86","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.032.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 32","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第32スライド","voiceDuration":4.169115646258503,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","characterName":"操夢","telop":"「ええ、本当です。それなら、互いの理に適ってますし…」"},{"bgmName":"BGM: 東方妖恋談","id":"F6175353-F260-4280-937F-4688570E1A41","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.033.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 33","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第33スライド","voiceDuration":2.0115873015873014,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_射命丸文.wav","characterName":"射命丸文","telop":"「理に適っているとは？あの…」"},{"bgmName":"BGM: 東方妖恋談","id":"3D9B7B1B-4817-424A-A099-E2AB8A4BB38D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.034.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 34","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第34スライド","voiceDuration":4.143038548752834,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","characterName":"操夢","telop":"僕は、そう彼女がその発言をする前に、キスで塞ぎ込む。"},{"bgmName":"BGM: 東方妖恋談","id":"0D2D3EC8-1E77-4E49-A76F-C1069D06C9A2","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.035.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 35","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第35スライド","voiceDuration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_射命丸文.wav","characterName":"射命丸文","telop":"「んっ…」"},{"bgmName":"BGM: 東方妖恋談","id":"0C377077-F9BA-4DBA-89F9-2974726B1AE1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.036.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 36","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第36スライド","voiceDuration":2.413582766439909,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_射命丸文.wav","characterName":"射命丸文","telop":"「どうします、今すぐ出てもいいですけど…」"},{"bgmName":"BGM: 東方妖恋談","id":"306407E6-E72C-47B0-9417-C2F054CB0250","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.037.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 37","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第37スライド","voiceDuration":4.977823129251701,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","characterName":"操夢","telop":"僕はそう言われ、時間を確かめる。\nだが、終電の時刻は過ぎていた。"},{"bgmName":"BGM: 東方妖恋談","id":"AD979E27-222F-4EC1-AE03-AEE926984937","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.038.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 38","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第38スライド","voiceDuration":1.9535827664399092,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_射命丸文.wav","characterName":"射命丸文","telop":"「私の家に泊まって行きますか？」"},{"bgmName":"BGM: 東方妖恋談","id":"D9F47A11-8C41-4663-86DB-BBD565C7BB00","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.039.jpeg","duration":5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 39","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第39スライド","voiceDuration":7.038684807256236,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","characterName":"操夢","telop":"僕は考える、タクシーを呼べば、すぐに戻れるが、タクシーを呼ぶのには、政府の網にはまるリスクも伴う…。"},{"bgmName":"BGM: 東方妖恋談","id":"BB8CF289-F70D-4949-A613-C4E74BBB9AF9","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.040.jpeg","duration":4.6000000000000005,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 40","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第40スライド","voiceDuration":6.224557823129252,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","characterName":"操夢","telop":"「すでに終電は過ぎてるので、今晩は泊まって、\n明朝には向こうにつけるようにしようと思います。」"},{"bgmName":"BGM: 東方妖恋談","id":"F6C3A7D7-138A-4138-8B22-07AB5EB2688B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.041.jpeg","duration":4.800000000000001,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 41","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第41スライド","voiceDuration":7.138684807256236,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","characterName":"操夢","telop":"「それで、文さんは、普段記者として活動する中で、\n周りの人々に対する愚痴や不満などはありますか？」"},{"bgmName":"BGM: 東方妖恋談","id":"81A24DF0-35FD-4501-92C3-2B447A9630EC","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.042.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 42","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第42スライド","voiceDuration":1.937596371882086,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_射命丸文.wav","characterName":"射命丸文","telop":"「どうしてそんなことを言うのですか？」"},{"bgmName":"BGM: 東方妖恋談","id":"9C8B54BE-1A86-40BD-80CE-DA477501A9B5","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.043.jpeg","duration":5.2,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 43","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第43スライド","voiceDuration":7.532154195011338,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","characterName":"操夢","telop":"「明朝までには、向こうについてる必要があり、寝ていたら、きっと間に合わないので、今夜は、睡眠0ですよ。」"},{"bgmName":"BGM: 東方妖恋談","id":"646C8F53-420F-4EBF-A720-7117C0F0AB6C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.044.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 44","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第44スライド","voiceDuration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_射命丸文.wav","characterName":"射命丸文","telop":"「でも私は…」"},{"bgmName":"BGM: 東方妖恋談","id":"E3423BC6-9CE0-4ECE-96FE-FAF48C864B41","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.045.jpeg","duration":5.9,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 45","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第45スライド","voiceDuration":8.586507936507937,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","characterName":"操夢","telop":"「睡眠が0時間になるのは、僕だけでいいですから、文さんは眠たかったら、寝て大丈夫ですよ。寝たら背負って移動するので。」"},{"bgmName":"BGM: 東方妖恋談","id":"2791CD45-E12E-4B99-9971-FA875AF276B3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.046.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 46","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第46スライド","voiceDuration":2.2615873015873014,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_射命丸文.wav","characterName":"射命丸文","telop":"「そうですか…、ちょっと待っててください。」"},{"bgmName":"BGM: 東方妖恋談","id":"E6473D07-FDD7-4597-8E62-014F97DE9745","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.047.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"ナレーション","title":"シーン 47","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","slideTitle":"第47スライド","characterName":"ナレーション","telop":"数十分後…"},{"bgmName":"BGM: 東方妖恋談","id":"C64A1396-C43B-40C1-90F5-82E0398B4D30","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.048.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 48","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第48スライド","voiceDuration":4.443582766439909,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_射命丸文.wav","characterName":"射命丸文","telop":"「お待たせしました…」\n私は、遠出の準備を済ませると、彼にそう言う。"},{"bgmName":"BGM: 東方妖恋談","id":"F3081B3D-8541-442A-BAA1-D70D8DF51206","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.049.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 49","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第49スライド","voiceDuration":2.156077097505669,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","characterName":"操夢","telop":"「これで、準備は万端ですか？」"},{"bgmName":"BGM: 東方妖恋談","id":"E1D41E3E-6AF8-4598-AF9F-3AA1739F2EF3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.050.jpeg","duration":5.6000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 50","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第50スライド","voiceDuration":7.742585034013605,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_射命丸文.wav","characterName":"射命丸文","telop":"「ええ、万端です。」私はその言葉で啖呵が切れたように、\n記者としての活動で、溜まった不満や愚痴を彼に言うのだった。"},{"bgmName":"BGM: 東方妖恋談","id":"9F899F08-ACBA-45A7-B62F-17E89614AC73","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.051.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"ナレーション","title":"シーン 51","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","slideTitle":"第51スライド","characterName":"ナレーション","telop":"それから夜が更けていき…"},{"bgmName":"BGM: 東方妖恋談","id":"90E5D46F-C5B8-4800-AAF0-B35797B64258","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.052.jpeg","duration":3.9000000000000004,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 52","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第52スライド","voiceDuration":5.313673469387755,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","characterName":"操夢","telop":"彼女はそれから、愚痴や不満を出し続けていると、\nそのまますやすやと寝てしまった。"},{"bgmName":"BGM: 東方妖恋談","id":"E4D9A6AF-F7F2-4FCF-BADC-9F401391A2C4","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.053.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 53","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第53スライド","voiceDuration":4.237596371882086,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","characterName":"操夢","telop":"僕は、ふとポケベルを取り出す。日の出まであと数時間だった。"},{"bgmName":"BGM: 東方妖恋談","id":"1900E5B5-0114-4F30-9111-B5328B14C710","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.054.jpeg","duration":4.7,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 54","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第54スライド","voiceDuration":6.116938775510204,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","characterName":"操夢","telop":"僕はポケベルをポケットにしまうと、そっと彼女を起こさないように近づき、彼女をゆっくりと背負う。"},{"bgmName":"BGM: 東方妖恋談","id":"CF416911-778F-4630-B717-4A5306F5AAB2","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.055.jpeg","duration":5.800000000000001,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 55","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第55スライド","voiceDuration":9.564761904761905,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","characterName":"操夢","telop":"すると、彼女が寝言をつぶやく。僕は、そんな彼女の寝言に、小さく「そうですか…」と返すと、彼女の足に僕の腕を絡ませる。"},{"bgmName":"BGM: 東方妖恋談","id":"BC942077-BD55-45E4-BBEC-997035495687","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.056.jpeg","duration":4,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 56","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第56スライド","voiceDuration":5.4321541950113374,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","characterName":"操夢","telop":"そして、二つのスーツケースを手に取りつかむと、\nゆっくりと歩き、駅のほうに向かう。"},{"bgmName":"BGM: 東方妖恋談","id":"FAA0D6C1-8702-41F4-B401-5BDE93771E6C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.057.jpeg","duration":5.2,"transitionName":"クロスディゾルブ","backgroundName":"nc260102_田舎の駅前（夜）.jpg","voiceCharacter":"操夢","title":"シーン 57","voiceDuration":8.447369614512471,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第57スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav","characterName":"操夢","telop":"そして、駅に着くと、無人の改札を通り、彼女が寝静まった後に、密かに動かしていた列車に乗り込み、出発した。"},{"slideTitle":"中扉","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.058.jpeg","voiceCharacter":"博麗霊夢","id":"A3ACFDB4-A994-402E-9BF7-09609923A33C","transitionName":"クロスディゾルブ","telop":"","animationName":"なし","duration":3,"characterName":"博麗霊夢","title":"一方その頃、霊夢たちは…","bgmName":"BGM: 東方妖恋談"},{"bgmName":"BGM: 東方妖恋談","id":"196262CF-AF07-46E4-B92A-EFEEBB0EF30D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.059.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","title":"シーン 59","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第59スライド","voiceDuration":5.145736961451247,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav","characterName":"博麗霊夢","telop":"私はふと目が覚めると、そこは西東京研究所の仮眠室だった。"},{"bgmName":"BGM: 東方妖恋談","id":"9682917A-9D90-47BB-850D-1C3760BF047E","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.060.jpeg","duration":4.6000000000000005,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","title":"シーン 60","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第60スライド","voiceDuration":8.344489795918367,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「まだ、暗い…」ふとそうつぶやく。私が、そう言いながら、目を瞑ろうとすると、誰かが戸を叩く。"},{"bgmName":"BGM: 東方妖恋談","id":"85727BD4-7567-423A-B43B-53DD51BB5225","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.061.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","title":"シーン 61","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第61スライド","voiceDuration":3.6819954648526076,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav","characterName":"博麗霊夢","telop":"私は、おぼつかない足取りで、扉へと向かう。"},{"bgmName":"BGM: 東方妖恋談","id":"9D045597-E14A-4736-B0BA-BF65EA7E102A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.062.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","title":"シーン 62","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第62スライド","voiceDuration":2.8494784580498864,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「こんな夜中にどうしたのよ…魔理沙。」"},{"bgmName":"BGM: 東方妖恋談","id":"CED7AAFE-976E-4C5A-A039-0599D317EF5B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.063.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"霧雨魔理沙","title":"シーン 63","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_marisa","animationName":"なし","slideTitle":"第63スライド","voiceDuration":2.428231292517007,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_霧雨魔理沙.wav","characterName":"霧雨魔理沙","telop":"「なんだか…目が覚めちまって…」"},{"bgmName":"BGM: 東方妖恋談","id":"65CAA762-8E15-4200-839E-92115D87BC5B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.064.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","title":"シーン 64","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第64スライド","voiceDuration":3.3044897959183674,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「そう…それで…私と一緒に寝たいの？」"},{"bgmName":"BGM: 東方妖恋談","id":"1119B537-D2F7-4B61-8180-070DADB31FFB","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.065.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"霧雨魔理沙","title":"シーン 65","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_marisa","animationName":"なし","slideTitle":"第65スライド","voiceDuration":2.7644897959183674,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_霧雨魔理沙.wav","characterName":"霧雨魔理沙","telop":"「そうさせてもらえないか…なのだぜ…」"},{"bgmName":"BGM: 東方妖恋談","id":"7157A159-0B9E-4DB6-AC04-0C0CED937B4F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.066.jpeg","duration":3.7,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","title":"シーン 66","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第66スライド","voiceDuration":6.1007482993197275,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「分かったわ…いいわよ…魔理沙…」\n私はそう言うと、そのままベッドに戻った。"},{"slideTitle":"中扉","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.067.jpeg","voiceCharacter":"射命丸文","id":"304AC46C-A427-46DF-B174-9E383D8D8732","transitionName":"クロスディゾルブ","telop":"","animationName":"なし","duration":3,"characterName":"射命丸文","title":"彼が文とともに研究所に着くと…","bgmName":"BGM: 東方妖恋談"},{"bgmName":"BGM: 東方妖恋談","id":"A5303422-C0D7-47E8-90D9-64000238FE3A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.068.jpeg","duration":4.9,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜（驚く）.png","voiceCharacter":"操夢","title":"シーン 68","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第68スライド","voiceDuration":7.221292517006803,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","characterName":"操夢","telop":"僕が、文を背負った状態で、スーツケースを転がしながら、入ると、霊夢たちが驚いた様子でこちらを見る。"},{"bgmName":"BGM: 東方妖恋談","id":"744B96D2-3462-4EBD-BBC3-3A5D6A88D97F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.069.jpeg","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"博麗霊夢","title":"シーン 69","voiceDuration":3.2394784580498865,"audioTrack":"track_voice_reimu","animationName":"なし","slideTitle":"第69スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「あんた、なんで文を背負って戻ってきたの？」"},{"bgmName":"BGM: 東方妖恋談","id":"44087FCB-E580-4CB7-B0EA-EBABB6D2634B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.070.jpeg","duration":5.2,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 70","voiceDuration":7.386507936507937,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第70スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav","characterName":"操夢","telop":"僕は、彼女に小声でそう聞かれると、そっと文を起こさないように、床におろし、壁に寄りかからせてから答える。"},{"bgmName":"BGM: 東方妖恋談","id":"90ECB17F-9D52-4828-847D-1F27BE56652C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.071.jpeg","duration":3.6,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 71","voiceDuration":5.508253968253968,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第71スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","characterName":"操夢","telop":"「彼女がそばにいた方が、理に適っているからです。」\n僕はそう、小声で返す。"},{"bgmName":"BGM: 東方妖恋談","id":"A56CA6F2-F7F2-4C76-A91D-80858D0163FC","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.072.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 72","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第72スライド","voiceDuration":3.915578231292517,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_射命丸文.wav","characterName":"射命丸文","telop":"「んっ…ここは…」\n私は、ふと目が覚めると、そう呟く。"},{"bgmName":"BGM: 東方妖恋談","id":"0F501BBB-AE0E-48EE-BBDB-96ECF0C2CB69","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.073.jpeg","duration":4.7,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 73","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第73スライド","voiceDuration":6.4635827664399095,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_射命丸文.wav","characterName":"射命丸文","telop":"すると、脳が急に覚醒したかのように、思い出す。\n「私が操夢さんに愚痴こぼしてたら…寝落ちした…」"},{"bgmName":"BGM: 東方妖恋談","id":"74698720-C2A3-4592-ABBC-A25A67E8D321","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.074.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"射命丸文","title":"シーン 74","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第74スライド","voiceDuration":4.977596371882086,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_射命丸文.wav","characterName":"射命丸文","telop":"「なんだか…申し訳ないです…。」\n私は、羞恥心でそんな言葉を彼に言う。"},{"bgmName":"BGM: 東方妖恋談","id":"70E3F3EA-FB09-4BF2-8750-79C4E4E01509","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.075.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 75","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第75スライド","voiceDuration":4.427823129251701,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","characterName":"操夢","telop":"「いえいえ、大丈夫ですよ。」\n僕はそう呟く彼女にそう返す。"},{"bgmName":"BGM: 東方妖恋談","id":"B0CDED59-43A4-4422-A2E9-8A37FA0C7AF3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.076.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 76","voiceDuration":5.040861678004535,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第76スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_操夢.wav","characterName":"操夢","telop":"「これで全員、揃いましたね…。\n霊夢さんたちは、準備は万端ですか？」"},{"bgmName":"BGM: 東方妖恋談","id":"729ADC3E-AEC2-493B-808C-05294915DC63","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.077.jpeg","duration":5.1000000000000005,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 77","voiceDuration":7.83,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第77スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_操夢.wav","characterName":"操夢","seName":"SE: nc146478_【東方アレンジ】紅の予感【東方動画BGM支援】","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/BGM\/nc146478_【東方アレンジ】紅の予感【東方動画BGM支援】.wav","telop":"僕がそう問いかけると、僕のポケベルから着信音が鳴る。\n僕は、すぐさま操作盤に繋げ、スピーカーにして出る。"},{"bgmName":"BGM: 東方妖恋談","id":"6200C9B4-052E-4275-88A9-BC9B88528FC1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.078.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 78","voiceDuration":2.83,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第78スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav","characterName":"操夢","telop":"「もしもし、みとりさん、どうしましたか？」"},{"bgmName":"BGM: 東方妖恋談","id":"D7CA49F5-180F-4965-82FA-D7AC7CF9C73B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.079.jpeg","duration":3.9000000000000004,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"八雲紫","title":"シーン 79","voiceDuration":5.738208616780045,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","animationName":"なし","slideTitle":"第79スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_八雲紫.wav","characterName":"八雲紫","telop":"「操夢さん、今すぐにその研究所を出てください！\n紫からの追手が迫っています！」"},{"bgmName":"BGM: 東方妖恋談","id":"4B0F5A73-6422-40D8-8151-A375B17226BD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.080.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 80","voiceDuration":1.7278231292517008,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第80スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","characterName":"操夢","telop":"「それで、移動手段は？」"},{"bgmName":"BGM: 東方妖恋談","id":"E2680914-A9D0-4786-8E21-72C442A7BCB6","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.081.jpeg","duration":4.7,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"射命丸文","title":"シーン 81","voiceDuration":7.312380952380952,"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","animationName":"なし","slideTitle":"第81スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_射命丸文.wav","characterName":"射命丸文","telop":"「今、その研究所の屋上に専用機が待機しているので、\n今すぐに屋上から、施設を離れてください！」"},{"bgmName":"BGM: 東方妖恋談","id":"BE582B2A-B752-4A3B-9D93-482B7E0AECBF","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.082.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"咲夜困り顔.png","voiceCharacter":"操夢","title":"シーン 82","voiceDuration":5.4484580498866215,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第82スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav","characterName":"操夢","telop":"すると、なぜか通話が強制終了になった。\n「急いで、屋上に向かいますよ。」"},{"bgmName":"BGM: 東方妖恋談","id":"ADCBB213-7E10-4A0D-80EC-910A067216BF","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.083.jpeg","duration":4.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 83","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第83スライド","voiceDuration":6.760430839002267,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_操夢.wav","characterName":"操夢","telop":"僕たちは、そこから屋上に上がると、止まっていたヘリコプターに乗り込み、僕は、運転席に座る。\n察しのいい人には乗り物が見えます…"},{"bgmName":"BGM: 東方妖恋談","id":"AC6BEC9D-FB51-483E-940D-1760D0680023","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.084.jpeg","duration":4.7,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 84","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第84スライド","voiceDuration":6.212607709750567,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav","characterName":"操夢","telop":"そして、頭の中でヘリコプターの運転マニュアルを読み込みながら、同時にヘリコプターを離陸させる。\n察しのいい人には乗り物が見えます…"},{"bgmName":"BGM: 東方妖恋談","id":"98158DC3-7F19-4B47-A5CB-147BB9A0E1B3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.085.jpeg","duration":3.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第85スライド","voiceDuration":3.994126984126984,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav","characterName":"操夢","telop":"そして、そのまま彼女の現在地…沖縄に向かうのだった。\n察しのいい人には乗り物が見えます…"},{"slideTitle":"中扉","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.086.jpeg","voiceCharacter":"","id":"E0CFF66C-CFB8-417D-9F38-8A518C79224D","transitionName":"クロスディゾルブ","telop":"","animationName":"なし","duration":3,"characterName":"","title":"次回予告","bgmName":"BGM: 東方妖恋談"},{"bgmName":"BGM: 東方妖恋談","id":"3DE993B4-6F76-4086-B681-0060624F4955","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.087.jpeg","duration":5.300000000000001,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 87","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第87スライド","voiceDuration":8.796303854875283,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav","characterName":"操夢","telop":"僕たちは、沖縄の某所につくと、みとりとそこで話す。\n僕たちが離陸して数十分後に、紫からの追手が来た様だった。"},{"bgmName":"BGM: 東方妖恋談","id":"8A01F34C-ADFD-49BF-99D5-570F91806E19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.088.jpeg","duration":4.5,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第88スライド","voiceDuration":7.256077097505669,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_操夢.wav","characterName":"操夢","telop":"そこで、僕は、予定していた計画を前倒しにし、\nその場、今後を霊夢たちと話し合い、実行に移す。"},{"bgmName":"BGM: 東方妖恋談","id":"BB77297F-8F81-42F7-B4F8-5CBD3CC5D3C4","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.089.jpeg","duration":4.9,"transitionName":"クロスディゾルブ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","title":"シーン 89","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"第89スライド","voiceDuration":8.120204081632654,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav","characterName":"操夢","telop":"そして、それを実行途中に、霊夢の姿が消える。\n僕は、その彼女の不可解な行動への対処も考えるのだった。"},{"slideTitle":"中扉","backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（25話目）_d034e5218c\/交換夫婦（25話目）_d034e5218c.090.jpeg","voiceCharacter":"","id":"744777CB-D842-4F13-BE46-40E9AEFBCC6A","transitionName":"クロスディゾルブ","telop":"","animationName":"なし","duration":3,"characterName":"","title":"ご視聴ありがとうございました","bgmName":"BGM: 東方妖恋談"}]