g","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"第84スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.084.jpeg","duration":5.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"さ&り","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":3.656734693877551,"voice2StartTimeOffset":0,"telop":"私は、彼がバックから取り出した、封筒の中身を見て驚く。\nそこには、ある衝撃の内容が書かれた手紙とカードがあった。","id":"88168BBE-2B03-44C5-B539-921DD38EDA1A","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 84","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_パチュリー・ノーレッジ.wav","seVolume":1},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"第85スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.085.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"さ&り","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":8.411904761904761,"voice2StartTimeOffset":0,"telop":"「そのカードって…。」","id":"0ECF4D13-D676-48F5-A098-235C17AF3B90","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 85","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_ナレーション.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第86スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.086.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.121292517006802,"voice2StartTimeOffset":0,"telop":"「デビットカードですよ…、こいしさんが、あのポスターを見なかったとしても、連休明けに同じ試験を受けるので…」","id":"52CF65F9-1D5A-4593-8C8E-459B9A484967","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 86","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第87スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.087.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.954557823129251,"voice2StartTimeOffset":0,"telop":"僕は、そう言い、昨日のことを思い出す。","id":"963F4DB8-FD0C-4473-8F28-303F478C0ABD","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 87","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第88スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.088.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":9.154988662131519,"voice2StartTimeOffset":0,"telop":"昨日、学校から家に帰ってくると、僕は、入浴を済ませ、図書館で読書をしていた。すると、レミリアが封筒を手渡す。","id":"5502C198-55AD-441F-B6E5-5392BBAC4C68","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第89スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.089.jpeg","duration":5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.731065759637188,"voice2StartTimeOffset":0,"telop":"僕は、それを受け取ると宛名に僕の名前があり、差出人は学園長と記載されていた。そして、中を早速開ける。","id":"6DF00C6E-0438-4DDB-85C6-1635D9CA54FF","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 89","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第90スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.090.jpeg","duration":5.800000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.845215419501134,"voice2StartTimeOffset":0,"telop":"すると、そこには、遠足ノートに記載されていた遠足の後に受ける試験の内容が記載された紙と、デビットカードが入っていた。","id":"887C6357-E00D-463C-9603-F9FEEBB620A3","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 90","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第91スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.091.jpeg","duration":5.2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":4.30390022675737,"voice2StartTimeOffset":0,"telop":"そして、試験の内容をよく見ると、そこには、いくつかの試験が記載されていた、その一つに、外泊試験があった。","id":"C2AC745C-A1FF-4314-A4DD-0AD1984C9E33","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 91","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第92スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.092.jpeg","duration":5.6000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.459342403628118,"voice2StartTimeOffset":0,"telop":"内容は、学校側で決めたメンバーで数日間の間、家以外の場所で1日を過ごし、与えられた課題をこなすと言うものだった。","id":"93779B0B-5591-442A-BF24-9FC90E4DE8FF","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 92","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第93スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.093.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.3408616780045355,"voice2StartTimeOffset":0,"telop":"僕は、前の学校であった泊まりを含む行事の参加を、全て見送っていた。それを踏まえての試験だと記載されていた…。","id":"3655A806-BA47-46CC-B600-944725193951","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 93","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第94スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.094.jpeg","duration":5.2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.376734693877551,"voice2StartTimeOffset":0,"telop":"「僕は、少しだけ安心しましたよ。こいしさんが、あのポスターを見たおかげで、既知の人と行動できるから…。」","id":"4B1708DE-7DAD-4740-A823-89DF82BB94D7","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 94","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"第95スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.095.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"さ&り","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":4.506984126984127,"voice2StartTimeOffset":0,"telop":"「そうですか…」","id":"BAC25AF8-26A5-4A74-8556-94A89FEE8A1F","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 95","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_博麗霊夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第96スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.096.jpeg","duration":5.9,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.858253968253968,"voice2StartTimeOffset":0,"telop":"「とりあえず、ATMでお金を引き出してくるので、少しだけ待っていてください。その間に、買い物をしてもらっていいので…」","id":"7CCB3378-813C-4B4A-9B4A-3D43DBB22996","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 96","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_096_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"第97スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.097.jpeg","duration":3.6,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"さ&り","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":5.123401360544218,"voice2StartTimeOffset":0,"telop":"「分かりました…」\n私はそう言うと、不安が残りながら、洋服を見るのだった。","id":"271F3CC8-ED6C-4A62-A6D1-C512221EC940","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_097_レミリア・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第98スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.098.jpeg","duration":5.800000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.2604308390022676,"voice2StartTimeOffset":0,"telop":"僕は、一人でATMにやってくると、封筒にあったデビットカードを機械に差し込む。すると、機械がカードの情報を読み込む。","id":"6D258B22-D65F-4ED3-AE6D-C4D2C799DE37","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 98","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第99スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.099.jpeg","duration":5.6000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":6.038684807256236,"voice2StartTimeOffset":0,"telop":"そして、封筒にあったメモ書きも出し、認証が済むと、東京の物価と服の値段を考えながら、おおよその金額を引き出した。","id":"8DA9852B-ACE3-45E3-85F7-A8D98273781C","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 99","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_099_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"単色背景","animationName":"なし","seStartTimeOffset":0,"slideTitle":"中扉","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.100.jpeg","duration":20,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"","voice2StartTimeOffset":0,"seVolume":1,"telop":"","id":"E7C4A9D3-711D-4AE7-8FBA-F33692E0E8FA","transitionName":"なし","bgmStartTimeOffset":0,"title":"ご視聴ありがとうございました！"}]