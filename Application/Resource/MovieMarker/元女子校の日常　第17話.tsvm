"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 69","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","slideTitle":"第70スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.070.jpeg","duration":4.3,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":6.028639455782313,"voice2StartTimeOffset":0,"telop":"「ええ、分かったわ…、それじゃあ、行ってくるわね…」\n私はそう言うと、本屋を見に行った。","id":"2FC066CB-57C5-4D60-A374-3A1E755C3E11","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 70","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_アリス・マーガトロイド.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideTitle":"第71スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.071.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":7.9452154195011335,"voice2StartTimeOffset":0,"telop":"「ねぇ、紅夢…。あれを見て…」\n私はそう言いながら、あるものを指差す。","id":"52D674BE-8177-4D0E-B33B-66A01043632D","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 71","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","seVolume":1},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第72スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.072.jpeg","duration":5.7,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":4.197369614512471,"voice2StartTimeOffset":0,"telop":"僕がそう言われ、そっちを向くと、洋服店があった。すると、とあるポスターが目に入る。僕は、そのポスターの文字を見る。","id":"9964B7AE-2758-46C7-A3A3-9B78F1B1CE82","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 72","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第73スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.073.jpeg","duration":5.300000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":4.149546485260771,"voice2StartTimeOffset":0,"telop":"その内容を要約すると、今現在、このお店で一定金額以上の利用をすると、金額に応じたくじ引きができるとあった。","id":"E13DD4C9-7E45-488E-86FC-9406ACD237AA","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\