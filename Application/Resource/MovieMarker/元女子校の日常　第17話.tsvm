/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.003.jpeg","duration":3,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"八意永琳","voice2StartTimeOffset":0,"seVolume":0.8,"telop":"「こんにちは、紅夢くん。今日は来てくれて、ありがとね。」","id":"1B443410-24F2-4CB0-91BD-4F7D814F1FA2","transitionName":"なし","bgmStartTimeOffset":0,"seName":"SE: 決定・衝撃音","title":"「こんにちは、紅夢くん。今日は来てくれて、ありがとね。」"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第4スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.004.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.756077097505669,"voice2StartTimeOffset":0,"telop":"「いえ、いえ。それで僕に今日は、どんな用があるのですか？」\n制作ソフト及び協力\nGemini\nTohoStuido","id":"0F10E0B5-3768-4E2A-A0BD-B62E9B2B3947","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"永琳","slideTitle":"第5スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.005.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"八意永琳","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceDuration":1.473469387755102,"voice2StartTimeOffset":0,"telop":"「最近の、君の様子を聞かせてくれるかね？」","id":"B84B59AE-B37D-425C-BAFB-9D27799FDF54","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第6スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.006.jpeg","duration":3.6,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.523469387755101,"voice2StartTimeOffset":0,"telop":"「ええ、もちろん。」\n僕はそう返すと、彼女と共に診察室に向かって移動した。","id":"00A88215-6EAC-46BF-9999-9D2F9A528B2F","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 6","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_006_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"単色背景","animationName":"なし","seStartTimeOffset":0,"slideTitle":"タイトル","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.007.jpeg","duration":2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"","voice2StartTimeOffset":0,"seVolume":1,"telop":"元女子校の日常","id":"301959E8-9C8B-4CD2-BF65-8F586458456E","transitionName":"なし","bgmStartTimeOffset":0,"title":"東方Project二次創作作品　Powerd By zuyasi"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第8スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.008.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.395215419501134,"voice2StartTimeOffset":0,"telop":"僕は、あれからここ最近の出来事を淡々と話し、診察が終わると、続けて、ある検査を受けて、今は病室で休んでいた。","id":"7299D1EE-F5E9-4830-9686-FC1606C97E11","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第9スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.009.jpeg","duration":5.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":2.7865079365079364,"voice2StartTimeOffset":0,"telop":"今日は、彼女に今晩は病院で過ごすように言われ、フランたちのところには戻らず、そのまま明日登校することになった。","id":"454A3420-DCB2-467D-B34B-F2E79B9E7455","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 9","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_009_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第10スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.010.jpeg","duration":5.2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.838684807256236,"voice2StartTimeOffset":0,"telop":"僕は、一人病室で、窓から見える景色をただ眺めていた。\nすると、病室の扉が突如として開き、誰かが入ってくる。","id":"10135793-12F7-4A12-8A30-91587C7F870C","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 10","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第11スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.011.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":2.2191156462585035,"voice2StartTimeOffset":0,"telop":"「母さん、何かあったの？」","id":"629209D2-206C-4A9C-BB7E-27F13CC5A11E","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 11","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideTitle":"第12スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.012.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","voiceDuration":7.921995464852608,"voice2StartTimeOffset":0,"telop":"「ねぇ、あんた、スカーレット姉妹から何か聞かされたの？」","id":"C0B039BE-D388-4618-A1AC-723773FB6F74","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 12","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第13スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.013.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.2582539682539684,"voice2StartTimeOffset":0,"telop":"「えっ、何も聞いてないけど…」","id":"ADE9E2CE-BB83-4912-8FA1-D86E7DAE5E97","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 13","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideTitle":"第14スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.014.jpeg","duration":5.2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","voiceDuration":2.8644897959183675,"voice2StartTimeOffset":0,"telop":"「念のために聞くけど、この書類にサインしたのはあんた？」\n私はそう言い、家に送られてきた婚姻届の控を出す。","id":"294AD751-77EC-4046-A865-7CC8D1AE92A7","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 14","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第15スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.015.jpeg","duration":5.6000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":2.838684807256236,"voice2StartTimeOffset":0,"telop":"僕は、彼女が出した書類をじっくりと見る。それは、婚姻届で、片方には、フランの名前が、もう片方には僕の名前があった。","id":"D727B4C1-2DE6-450A-8F02-F83648EC8A9B","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 15","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第16スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.016.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.338684807256236,"voice2StartTimeOffset":0,"telop":"「いや、知らない。」","id":"08EF9623-B942-439E-9F80-E6D657335137","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 16","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideTitle":"第17スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.017.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","voiceDuration":4.514489795918367,"voice2StartTimeOffset":0,"telop":"「そう。ところで、今朝のニュース、見たかしら？」","id":"3F358378-DB56-4181-B109-3C1F4A3FBC7D","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 17","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_博麗霊夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第18スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.018.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.7897732426303854,"voice2StartTimeOffset":0,"telop":"「ニュース？」","id":"428EEFC8-1582-4CB5-A2C0-AE62DEF60688","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 18","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideTitle":"第19スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.019.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","voiceDuration":5.246984126984127,"voice2StartTimeOffset":0,"telop":"「知らないの？とりあえずテレビつけて見なさい。」","id":"D8A83932-3561-4044-985A-9EA2FF76041E","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 19","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_博麗霊夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第20スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.020.jpeg","duration":5.800000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.436507936507937,"voice2StartTimeOffset":0,"telop":"僕は、彼女にそう言われ、後ろにあるテレビをつける。すると、そこには、月明かりが照らす空を飛ぶ、レミリアの姿があった。","id":"BA4AA30B-F284-4C79-BD9C-D3505264D5AD","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 20","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"slideTitle":"第21スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.021.jpeg","duration":2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"レミリア・スカーレット","voice2StartTimeOffset":0,"seVolume":1,"telop":"","id":"782B9D69-2E4B-40B8-85E7-AEE5E3934FA2","transitionName":"なし","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 21"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第22スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.022.jpeg","duration":5.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.640861678004535,"voice2StartTimeOffset":0,"telop":"僕は、ハッと気がつくと、彼女が暗い表情で、僕に声をかけていた。「ごめん…、母さん…。」僕は反射的に、そう謝る。","id":"3EF0E4DA-A8A2-4125-9A69-ABDFE9235954","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 22","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideTitle":"第23スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.023.jpeg","duration":4.6000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","voiceDuration":8.066984126984128,"voice2StartTimeOffset":0,"telop":"「謝る必要はないわよ。それよりも、あんたは大丈夫なの、さっきより顔色が悪くなっているけど…」","id":"85DBB819-D98E-4609-B69B-8F1511FEF3D6","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 23","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_博麗霊夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第24スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.024.jpeg","duration":4.1000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.760430839002267,"voice2StartTimeOffset":0,"telop":"「そう…、でも僕は大丈夫だから、そんな顔しないで…、\n母さん…」僕はそう彼女に言う。","id":"C12CF758-EA25-400D-9E7A-FFC2119351A5","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 24","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","slideTitle":"第25スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.025.jpeg","duration":4.9,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","audioTrack":"track_voice_reimu","voiceDuration":7.20421768707483,"voice2StartTimeOffset":0,"telop":"「もし、何かあるんだったら、しっかりと人を頼りなさいね。」\n私は、そうこぼすと、病室を去っていった。","id":"4E26E1B7-3368-44FD-A8CB-A0CC31AC3671","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 25","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第26スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.026.jpeg","duration":5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":6.543673469387755,"voice2StartTimeOffset":0,"telop":"彼女はそう言うと、去っていった。僕は、つけたテレビを消すと、そのまま布団を被り、目を閉じるのだった。","id":"B470438C-DFC1-4752-810D-1C2989B286F5","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 26","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"slideTitle":"第27スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.027.jpeg","duration":2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"ナレーション","voice2StartTimeOffset":0,"seVolume":1,"telop":"それから時間がたち…","id":"FA75B25F-E64E-4ABD-9EDA-2088F6359D9F","transitionName":"なし","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 27"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第28スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.028.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.034331065759638,"voice2StartTimeOffset":0,"telop":"僕はふと目が覚めると、すでに日が沈んでいた。\nすると、病室の扉が開く。","id":"92864C93-A202-46FF-9A58-A011569EC4AC","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 28","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_028_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideTitle":"第29スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.029.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":1.7294784580498865,"voice2StartTimeOffset":0,"telop":"「紅夢、大丈夫、暗い表情をして…」","id":"62F57D24-0913-4F69-AFDA-90212CD6BBD6","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 29","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_フランドール・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第30スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.030.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.80172335600907,"voice2StartTimeOffset":0,"telop":"「少しばかし、悪い夢を見ていただけですよ…」","id":"3108DEC8-8F70-4475-8AE0-EC5AEAF04715","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 30","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideTitle":"第31スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.031.jpeg","duration":5.300000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":10.299478458049887,"voice2StartTimeOffset":0,"telop":"「そう…、ほら、これ…」私はそう言うと、差し入れを渡す。\n「病院の許可はとってあるから、ちゃんと食べてね…」","id":"FD3B41FE-99B6-4215-8852-6E88E8AB2F59","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 31","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_031_フランドール・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第32スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.032.jpeg","duration":5.7,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":4.18,"voice2StartTimeOffset":0,"telop":"「ありがとうございます…」僕はそう言われ、渡されたお弁当の堤を開けて、中身を取り出す。それは手作りのお弁当だった。","id":"62E90C85-932A-4047-9CA2-7065C4A48B22","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 32","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideTitle":"第33スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.033.jpeg","duration":5.1000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":10.730748299319728,"voice2StartTimeOffset":0,"telop":"「これ、私が頑張って作ったから、しっかり食べ切ってね…」\n私は、そう言うと、一度、病室から離れていった。","id":"D845C826-42D2-45A4-B7F3-ACA91940496E","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 33","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_フランドール・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第34スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.034.jpeg","duration":4.800000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.132154195011339,"voice2StartTimeOffset":0,"telop":"僕は、彼女が病室を出ると、早速そのお弁当を開ける。\nそして、そのお弁当をよく味わって食べていった。","id":"5C368ED7-47CC-482E-A870-E037CEF69533","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 34","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第35スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.035.jpeg","duration":5.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.410430839002268,"voice2StartTimeOffset":0,"telop":"それから、お弁当を数十分かけて、食べ終えると、僕は、そのまま窓の外に視線を向ける。そして、昨日のことを考える。","id":"6ACF8FEF-02E3-4764-AC18-1E4E2298DB0B","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 35","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第36スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.036.jpeg","duration":3.6,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.962607709750567,"voice2StartTimeOffset":0,"telop":"すると、だんだんと瞼が落ちそうになる。\nだが、ある光景が僕の脳裏を横切る。","id":"B9417DEA-4A77-4C54-8DAF-99E739459013","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 36","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"slideTitle":"第37スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.037.jpeg","duration":2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","voice2StartTimeOffset":0,"seVolume":1,"telop":"","id":"F5815B41-667E-49EF-90E6-034D920F0F41","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（狂気）.png","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 37"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideTitle":"第38スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.038.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":4.041995464852608,"voice2StartTimeOffset":0,"telop":"「紅夢、大丈夫？顔が青ざめてるよ…。」","id":"B37567CD-8A2C-48C2-9FE8-82603DD74C07","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 38","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_フランドール・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideTitle":"第39スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.039.jpeg","duration":5.7,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":10.089478458049886,"voice2StartTimeOffset":0,"telop":"僕は、彼女の声掛けで我に帰る。「あっ…お弁当美味しかったです…」僕は、自分の思考を悟られないように、そう誤魔化す。","id":"A22E61BB-0DB8-497E-BE7A-E5D95DAB4670","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 39","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_フランドール・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideTitle":"第40スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.040.jpeg","duration":5.300000000000001,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"フランドール・スカーレット","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":8.430748299319728,"voice2StartTimeOffset":0,"telop":"「本当に、大丈夫なの？何か、あるなら私に相談してね…」\n私は、彼にそう言うと、病室を去り、家に帰っていった。","id":"A221755C-FE15-4F48-9A51-C4A430CF92CA","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 40","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_フランドール・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第41スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.041.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.616938775510205,"voice2StartTimeOffset":0,"telop":"僕は、彼女が病室を出ると、一人考える。「過去を克服しないと…」僕は、ある一種の不安を感じながら、そう呟いた。","id":"1A83233F-20EE-4F37-BCF8-0F5AFE71E459","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 41","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_041_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"slideTitle":"第42スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.042.jpeg","duration":2,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"ナレーション","voice2StartTimeOffset":0,"seVolume":1,"telop":"翌朝…","id":"44B05EFA-FDA6-41B3-8DCE-6B85CF37727F","transitionName":"なし","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 42"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第43スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.043.jpeg","duration":5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.461519274376418,"voice2StartTimeOffset":0,"telop":"僕は、朝がやってくると、病室で朝食をとり、そのまま教室に入った。そして、席に着き、身の回りを整える。","id":"1E0B16EB-E750-4009-81A3-FFF28A58DE97","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 43","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"咲夜（困る）.png","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第44スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.044.jpeg","duration":3.9000000000000004,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":9.20281179138322,"voice2StartTimeOffset":0,"telop":"すると、教室の扉が開き、彼女が僕の席にやってくる。\n「あの、どうしたんですか？」","id":"D43D3EDC-3283-4F8A-9ACF-234D3B33581C","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 44","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"咲夜（困る）.png","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"十六夜咲夜","slideTitle":"第45スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.045.jpeg","duration":4.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"十六夜咲夜","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceDuration":17.274489795918367,"voice2StartTimeOffset":0,"telop":"「ついさっき、あなたのお弁当が届けられたので…」\n私はそう言いながら、受け取った弁当を置く。","id":"7AE58DBA-3C82-4B04-B2C7-8638A1A795E1","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 45","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_ナレーション.wav"},{"voiceStartTimeOffset":0,"backgroundName":"咲夜（困る）.png","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"十六夜咲夜","slideTitle":"第46スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.046.jpeg","duration":5.1000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"十六夜咲夜","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceDuration":6.448185941043084,"voice2StartTimeOffset":0,"telop":"「これは、昼食用だそうです。それでは、私は失礼します…」\n私はそういいながら、彼の教室から去っていった。","id":"1D3170FD-2B8E-43A5-86E8-9804F5A4A2B4","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 46","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_十六夜咲夜.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第47スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.047.jpeg","duration":5.6000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.458253968253969,"voice2StartTimeOffset":0,"telop":"僕は、届けられた弁当が入った包みを開く。すると、弁当箱と共に、メモ書きが載せてあった。『何かあったら言ってね…』","id":"26A3FE0A-C94E-4963-BDBD-CFB74C079A3D","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 47","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第48スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.048.jpeg","duration":4.7,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.991950113378685,"voice2StartTimeOffset":0,"telop":"僕は、そのメモ書きを適当にバックに入れると、弁当を包みにくるみ、そのままバックにそっと入れる。","id":"1EE147ED-E4EA-48C7-AEFE-D4F74A40D724","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 48","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第49スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.049.jpeg","duration":4.9,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":9.624126984126985,"voice2StartTimeOffset":0,"telop":"それからしばらくすると、チャイムが鳴り、担任が入ってくる。\nそれからいつも通りの、日常がやってきた。","id":"BB27EC0D-B5AD-4176-A96B-8F568AFA3ED6","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 49","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"slideTitle":"第50スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.050.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"ナレーション","voice2StartTimeOffset":0,"seVolume":1,"telop":"それから、数日の時間が流れ…","id":"732CFC85-EF75-4F79-88D6-EAF72AD4FAC5","transitionName":"なし","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 50"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第51スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.051.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":4.50390022675737,"voice2StartTimeOffset":0,"telop":"それから、数日が経ち、僕たちは、遠足当日を迎えた。\nそして、駅を出ると、さとりとこいしの二人が話しかけてくる。","id":"9F7E8F49-FDE0-418B-A526-5FECFCA5AC0B","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 51","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"第52スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.052.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"さ&り","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":2.610907029478458,"voice2StartTimeOffset":0,"telop":"「思っていたよりも、人がいますね…」","id":"18CD7734-8C12-4BCD-8F5F-7FC97D0B1F61","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 52","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_レミリア・スカーレット.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideTitle":"第53スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.053.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":2.4332199546485263,"voice2StartTimeOffset":0,"telop":"「私が考えていたよりも、お台場を選んだ人が多いみたい…」","id":"E4843ABF-83FA-42D9-A1C8-391783A7D2DB","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 53","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_美鈴.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","slideTitle":"第54スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.054.jpeg","duration":5.7,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":2.673265306122449,"voice2StartTimeOffset":0,"telop":"「電車に乗っていてわかってるとは思いますが、新宿とかなら、この倍以上の人がいるから、それと比べたらすいてるわよ。」","id":"0580E81C-FA69-4F45-884A-B17CAD78787C","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 54","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_アリス・マーガトロイド.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideTitle":"第55スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.055.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":7.9563718820861675,"voice2StartTimeOffset":0,"telop":"「確かに、アリスさんの言うとおり…」","id":"902F5EE3-FF9D-4092-9722-8B013C3F4FF7","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 55","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_赤面.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第56スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.056.jpeg","duration":6.1000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":9.173469387755102,"voice2StartTimeOffset":0,"telop":"僕は、場の空気が気まずくなるのを感じ、流れを変えようと、3人に提案する。「とりあえず、ショッピングモールに行きませんか？」","id":"B2C08E41-B823-4D8E-901B-6A67C918DB10","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 56","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","slideTitle":"第57スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.057.jpeg","duration":5.1000000000000005,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":6.746485260770975,"voice2StartTimeOffset":0,"telop":"「とりあえず、その予定だったし、そうしましょ。」\nそれから、私たちは、ショッピングモールに向かって歩く。","id":"6654CE82-F34C-45C7-8414-F529E9D34994","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 57","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_十六夜咲夜.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第58スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.058.jpeg","duration":5.7,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.314761904761905,"voice2StartTimeOffset":0,"telop":"僕たちは、それから駅から数分程度歩き、ショッピングモールにやってきた。明日から大型連休だからか、そこそこ人がいた。","id":"A3950E81-A34E-4ED3-927A-2B28EE601CA5","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 58","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_058_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第59スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.059.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.95281179138322,"voice2StartTimeOffset":0,"telop":"すると、こいしが僕に話しかけてくる。","id":"B9E6D016-8611-4129-8C84-338500C2958F","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 59","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideTitle":"第60スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.060.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":4.448616780045351,"voice2StartTimeOffset":0,"telop":"「それで、これからどうする？」","id":"B9021969-5EDD-4A2B-90BE-B510FDE18D30","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 60","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_古明地こいし.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第61スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.061.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":5.762607709750567,"voice2StartTimeOffset":0,"telop":"僕はそう彼女に聞かれ、考える。すると、アリスが話し出す。","id":"7BE88FCC-1945-4B26-B53C-E11765D0076E","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 61","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","slideTitle":"第62スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.062.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":3.3113378684807255,"voice2StartTimeOffset":0,"telop":"「私は、本屋に行きたいわ…。」","id":"5C13DD93-59B9-45F8-8148-5B04F3673B94","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 62","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_アリス・マーガトロイド.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"第63スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.063.jpeg","duration":4.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"さ&り","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":7.995215419501133,"voice2StartTimeOffset":0,"telop":"「こいし、さっきからどうしたの？」\n私は、こいしがそっぽを向い