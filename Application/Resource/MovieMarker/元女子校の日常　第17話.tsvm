ation":8.223537414965987,"voice2StartTimeOffset":0,"telop":"「班長がこう言うのあれかもだけど…、本屋を見にいってても大丈夫かしら…」私は、そう彼に、尋ねる。","id":"4C6309BC-D8BD-409F-B9EA-CCABB4469E4B","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 65","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_妹紅.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第66スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.066.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":0.8973696145124717,"voice2StartTimeOffset":0,"telop":"僕は、彼女にそう聞かれ、ふと二人の方を見る。","id":"A3151D6B-CEA2-4ADC-8389-AB729AF21370","transitionName":"なし","bgmStartTimeOffset":0,"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 66","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第67スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.067.jpeg","duration":5.4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.062607709750568,"voice2StartTimeOffset":0,"telop":"そこには、なぜか、頬照りながら困るこいしと、ため息をつくさとりの姿があった。「二人とも、どうしたんですか？」","id":"9E489295-EB11-4AFC-BD20-F97D4B3FF274","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub