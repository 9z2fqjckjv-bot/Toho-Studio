Slide_075_操夢.wav"},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideTitle":"第76スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.076.jpeg","duration":3.5,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":0.652562358276644,"voice2StartTimeOffset":0,"telop":"「紅夢…、そのお店で洋服を見てきてもいい？」","id":"63C1381B-9D5F-452E-99AE-455BFE8966FC","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 76","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_レミリア・スカーレット.wav","seVolume":1},{"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"第77スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第17話_70dfdc35d7\/元女子校の日常　第17話_70dfdc35d7.077.jpeg","duration":4,"bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.1365079365079365,"voice2StartTimeOffset":0,"telop":"「ちなみに、そのお金は…？」\n僕は、二人が財布が手元にないを知った上で、そう聞く。","id":"4BB8079F-1FA8-4801-9516-6468DD0781F4","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 77","voiceAudioPath":"\/Use