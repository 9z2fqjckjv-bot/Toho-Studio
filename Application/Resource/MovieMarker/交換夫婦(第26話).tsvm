hoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.061.jpeg","voiceDuration":3.686984126984127,"voiceCharacter":"博麗霊夢","audioTrack":"track_voice_reimu","slideTitle":"スライド #61","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1C6B55D2-947E-4C93-A351-CD4FD42B256B","duration":7.719115646258503,"seName":"[SE] 衣擦れ1.mp3","transitionName":"なし","characterName":"操夢","telop":"僕は、そういう彼女の背後にそっと周り、\n片手で彼女の頭を撫でながら、片手を彼女の体に回す。","title":"シーン 62","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.062.jpeg","voiceDuration":7.1191156462585035,"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/効果音\/衣擦れ1.mp3","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #62","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D13401A2-663D-42E7-9EC3-72F88D392611","duration":3.5,"transitionName":"なし","characterName":"博麗霊夢","telop":"「あんた…それ…反則よ…」","title":"シーン 63","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.063.jpeg","voiceDuration":2.4094784580498865,"voiceCharacter":"博麗霊夢","audioTrack":"track_voice_reimu","slideTitle":"スライド #63","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_博麗霊夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B27AD367-F02B-4892-8F94-5B115DC74EAC","duration":3.5,"transitionName":"なし","characterName":"博麗霊夢","telop":"「でも…もっと…そうなでて…。」","title":"シーン 64","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.064.jpeg","voiceDuration":2.490748299319728,"voiceCharacter":"博麗霊夢","audioTrack":"track_voice_reimu","slideTitle":"スライド #64","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_064_博麗霊夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F5BB6C49-E789-4452-A65C-4AAC8906F5DA","duration":6.962607709750567,"transitionName":"なし","characterName":"操夢","telop":"僕は、特に何かを言うこともなく、\nただ同じような体制で、彼女の頭をそっとなで続ける。","title":"シーン 65","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.065.jpeg","voiceDuration":6.362607709750567,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #65","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D0076207-2FE4-43BB-9BC4-0BA1E513C1F5","duration":7.536507936507936,"transitionName":"なし","characterName":"操夢","telop":"すると、ふと霊夢が僕の腕にもたれかかる感覚を感じ、\nしっかりと支えながら、彼女の正面に回る。","title":"シーン 66","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.066.jpeg","voiceDuration":6.936507936507937,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #66","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"361CE6F4-D34D-497C-871A-92778FD19C41","duration":7.985419501133786,"transitionName":"なし","characterName":"操夢","telop":"どうやら、彼女は頭を撫でられているうちに、寝落ちした様だった。僕はその彼女をそっと地面に横たわらせる。","title":"シーン 67","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.067.jpeg","voiceDuration":7.385419501133787,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #67","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"076E4C01-35DF-4876-A638-EF49B6E6F608","duration":9.23,"transitionName":"なし","characterName":"操夢","telop":"そして、僕は操作盤の前に立ち、先ほどのまでのコードの書き換えを進めていく。そして、数十分すると部屋の扉が開く。","title":"シーン 68","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.068.jpeg","voiceDuration":8.63,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #68","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"6993B93D-6C28-42A6-896D-836A83E89D46","duration":7.393038548752834,"transitionName":"なし","characterName":"操夢","telop":"彼女は何かを言いかけるが、地面で気持ちよく眠る霊夢を見て、何かを思い出したのか、頬を赤らめる。","title":"シーン 69","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.069.jpeg","voiceDuration":6.793038548752834,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #69","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1880F0BC-1518-47A1-ABD0-D53D0DA692BC","duration":3.5975963718820863,"transitionName":"なし","characterName":"射命丸文","telop":"「依頼された記事は…、書き終わって投稿できました…」","title":"シーン 70","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.070.jpeg","voiceDuration":2.997596371882086,"voiceCharacter":"射命丸文","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"スライド #70","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_射命丸文.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"EE0E5F2D-E1D2-4B48-90F9-70CC969F38DD","duration":3.509591836734694,"transitionName":"なし","characterName":"射命丸文","telop":"「霊夢さんだけが、頭を撫でられて眠るなんて…」","title":"シーン 71","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.071.jpeg","voiceDuration":2.909591836734694,"voiceCharacter":"射命丸文","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"スライド #71","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_071_射命丸文.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"46E74CBD-4C7E-48BC-9E4F-73BDD58E1362","duration":8.620204081632652,"transitionName":"なし","characterName":"操夢","telop":"僕は、彼女の小言を聞き取ると、そっと背中に回り、霊夢と同じように、霊夢と同じ時間だけなでなでするのだった。","title":"シーン 72","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.072.jpeg","voiceDuration":8.020204081632652,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #72","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"5816324C-CA39-4025-9DA0-23B6CAEFAF5D","duration":9.719115646258503,"transitionName":"なし","characterName":"操夢","telop":"そして、文も疲れたのか、眠りに落ち、僕はただ一人、操作盤の前に立つ、この国のシステムの大規模変更は始まったばかりだ。","title":"シーン 73","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.073.jpeg","voiceDuration":9.097369614512472,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #73","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_073_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"6CCCEE8E-0E32-40B1-9A28-827BBAD18014","duration":7.781065759637188,"transitionName":"なし","characterName":"操夢","telop":"そして、同時にこれから、僕はある決断をしなければならず、\nその決断について考えを深めていくのであった。","title":"シーン 74","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.074.jpeg","voiceDuration":7.181065759637188,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #74","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav"},{"animationDuration":3,"animationName":"なし","id":"F0B13FD2-2B42-4107-AB11-62155481E0A7","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3,"transitionName":"なし","characterName":"ナレーション","telop":"場面が変わり…","title":"シーン 75","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.075.jpeg","animationNote":"表示時間：3秒","slideTitle":"スライド #75","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"052A36BB-B16A-41EB-AFDA-D393EBBFB654","duration":8.967414965986395,"transitionName":"なし","characterName":"八雲紫","telop":"私が、霊夢に電話をかけ、この問題は…異変だと言い、解決するように指示を出したが、一向に不正アクセスは実行され続ける。","title":"シーン 76","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.076.jpeg","voiceDuration":8.367414965986395,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #76","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"BFB842DB-2863-4792-B595-8B0AF143138E","duration":5.03798185941043,"transitionName":"なし","characterName":"八雲紫","telop":"すると、再び戸がノックされる。私は「どうぞ。」と返す。","title":"シーン 77","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.077.jpeg","voiceDuration":4.4379818594104306,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #77","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F72F3B01-E9C1-4EE9-A05A-68641C18D8F0","duration":4.367687074829932,"transitionName":"なし","characterName":"蘭","telop":"「紫様…、あの射命丸文がこんな記事を先ほど投稿しまして…」","title":"シーン 78","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.078.jpeg","voiceDuration":3.767687074829932,"voiceCharacter":"蘭","audioTrack":"track_voice_%E8%98%AD","slideTitle":"スライド #78","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_蘭.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"600E9D0A-D370-43E3-942E-79A398FA9DDD","duration":7.381632653061224,"transitionName":"なし","characterName":"蘭","telop":"蘭は、印刷されたネットニュース記事をそう言いながら渡す。\nそのニュース記事には、あの記者会見は嘘つきだと書かれていた。","title":"シーン 79","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.079.jpeg","voiceDuration":6.781632653061225,"voiceCharacter":"蘭","audioTrack":"track_voice_%E8%98%AD","slideTitle":"スライド #79","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_蘭.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"294B6C04-5679-4DF2-BC67-DA27FE4CB867","duration":4.300544217687075,"transitionName":"なし","characterName":"蘭","telop":"「紫様…、これは文が紫様を裏切った…と言うことですか？」","title":"シーン 80","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.080.jpeg","voiceDuration":3.700544217687075,"voiceCharacter":"蘭","audioTrack":"track_voice_%E8%98%AD","slideTitle":"スライド #80","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_蘭.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"DA271853-0DA3-4BE3-8320-A0177497B3B9","duration":7.582380952380952,"transitionName":"なし","characterName":"八雲紫","telop":"「ええ、そうなるわね。きっと私たちの見てない隙に、買収されたのよ…、巨漢党の置き土産である彼にね…」","title":"シーン 81","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.081.jpeg","voiceDuration":6.982380952380953,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #81","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"22C81D4B-3B0A-492A-8809-0933617E9A22","duration":7.871632653061224,"transitionName":"なし","characterName":"八雲紫","telop":"「それと、彼のそばにいる霊夢の動きが見られない以上、彼女も彼に取られたことになるわ…、これは…私の失策よ…」","title":"シーン 82","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.082.jpeg","voiceDuration":7.271632653061224,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #82","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B7DB0669-384A-4862-B2E4-12433AD642FD","duration":4.798412698412698,"transitionName":"なし","characterName":"八雲紫","telop":"私たちがそんな話をしていると、\n誰かが部屋の戸を叩き入ってくる。","title":"シーン 83","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.083.jpeg","voiceDuration":4.198412698412699,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #83","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F3C9F3D6-3BD5-4B01-969E-7BE85E56FAE1","duration":4.047165532879818,"transitionName":"なし","characterName":"橙","telop":"「紫しゃま、さっき、沖縄からこんな文書が届いて…」","title":"シーン 84","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.084.jpeg","voiceDuration":3.4471655328798185,"voiceCharacter":"橙","audioTrack":"track_voice_%E6%A9%99","slideTitle":"スライド #84","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_橙.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"96E54F4E-57D8-477D-B420-481955348E4B","duration":7.43984126984127,"transitionName":"なし","characterName":"八雲紫","telop":"橙はそう言うと、Faxで印刷された用紙を渡す。\nその用紙には、彼が提示したある内容が記されていた。","title":"シーン 85","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.085.jpeg","voiceDuration":6.83984126984127,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #85","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F174752D-4019-4021-AA88-136E79303D68","duration":6.9957596371882085,"transitionName":"なし","characterName":"八雲紫","telop":"「蘭、橙、覚悟はできているかしら…。」\n私は、そう二人、そして自らにも、問いかけた。","title":"シーン 86","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.086.jpeg","voiceDuration":6.395759637188209,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #86","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_八雲紫.wav"},{"slideTitle":"スライド #87","title":"シーン 87: 次回予告","backgroundName":"単色背景","duration":3,"id":"0B17125C-465B-42E0-AA0F-7F4A48DDE528","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.087.jpeg","characterName":"博麗霊夢","animationName":"なし","telop":"次回予告"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B7AA7844-7C53-4527-96C9-9E52CE8BBEAC","duration":6.616938775510204,"transitionName":"なし","characterName":"操夢","telop":"僕は、文と霊夢がすやすや寝ている横で、\nこの国、いや世の仕組みを１から作り替えていた。","title":"シーン 88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.088.jpeg","voiceDuration":6.016938775510204,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #88","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"744560BC-9225-40EA-AD41-1D3ED18ECC75","duration":7.573469387755102,"transitionName":"なし","characterName":"操夢","telop":"すると、みとりがやってきて、僕に進捗を聞いてくる。\n僕は、彼女にある程度進んでいると答える。","title":"シーン 89","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.089.jpeg","voiceDuration":6.973469387755102,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #89","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"59F87FB8-E435-464B-973C-C8E8D695A1A1","duration":8.587596371882086,"transitionName":"なし","characterName":"操夢","telop":"僕は、さらに、システムの作り替えを進めていく。\nそして、先方からの連絡が入ると、沖縄を離れるのだった。","title":"シーン 90","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.090.jpeg","voiceDuration":7.987596371882086,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #90","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/Gene