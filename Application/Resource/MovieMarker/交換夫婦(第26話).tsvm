628118,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #28","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"85CECB41-C083-48E0-8FFC-D43C25F345F8","duration":7.075351473922902,"transitionName":"なし","characterName":"にとり","telop":"「今現在も、アクセス元を調べていますが、\nなかなか特定できない状況です。そこで…」","title":"シーン 29","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.029.jpeg","voiceDuration":6.475351473922903,"voiceCharacter":"にとり","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","slideTitle":"スライド #29","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_にとり.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"127F3495-0BA2-4156-B0B2-51751E765FEE","duration":8.871746031746031,"transitionName":"なし","characterName":"八雲紫","telop":"私は、そこで唾を飲む。すると、彼女はヒソヒソとその内容を語った。それを聞いた私は、ある人物に電話をかけた。","title":"シーン 30","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.030.jpeg","voiceDuration":8.271746031746032,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #30","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_八雲紫.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"24A36665-AE1B-46D2-BB70-4B438C192C21","duration":7.675646258503401,"transitionName":"なし","characterName":"操夢","telop":"僕たちが、その画面…東京の某所カメラ映像を見ていると、\nそのカメラに映っている人物が電話をかける。","title":"シーン 31","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.031.jpeg","voiceDuration":7.075646258503402,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #31","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"78D3E756-2909-478D-A3B5-3926361C36D3","duration":5.575646258503401,"transitionName":"なし","characterName":"操夢","telop":"すると、霊夢のポケットから音が鳴る。\n僕は、霊夢に目で合図を送る。","title":"シーン 32","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.032.jpeg","voiceDuration":4.975646258503401,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #32","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"F333018C-737D-4E3F-AB1F-20141750E996","duration":8.632154195011337,"transitionName":"なし","characterName":"操夢","telop":"そして、霊夢が部屋から出ていくと、僕はあるニュース記事を映し出す。そして、同時進行でシステムのコードを書き換えていく。","title":"シーン 33","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.033.jpeg","voiceDuration":8.032154195011337,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #33","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"DEF5285F-6830-4897-8A43-946895499F0F","duration":3.5,"transitionName":"なし","characterName":"操夢","telop":"すると、レミリアが話しかけてくる。","title":"シーン 34","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.034.jpeg","voiceDuration":2.2778231292517006,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #34","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"20E86A5A-CA7D-40B1-923C-532B460FADF2","duration":4.054648526077098,"transitionName":"なし","characterName":"レミリア・スカーレット","telop":"「ねぇ、この記事に出てくる、幻想郷って何なの？」","title":"シーン 35","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.035.jpeg","voiceDuration":3.4546485260770976,"voiceCharacter":"レミリア・スカーレット","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideTitle":"スライド #35","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_レミリア・スカーレット.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"2D240792-9CD4-497D-892D-733F9B36A9E2","duration":6.206077097505669,"transitionName":"なし","characterName":"操夢","telop":"僕は、彼女の質問には、答えずに、\n彼女たちが見ている画面をスクロールしていく。","title":"シーン 36","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.036.jpeg","voiceDuration":5.606077097505669,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #36","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","id":"9CBC045E-4F07-4B1A-8BA4-0D7E2872B68B","duration":3.614761904761905,"transitionName":"なし","characterName":"操夢","telop":"すると、彼女たちは、驚いた表情する。","title":"シーン 37","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.037.jpeg","voiceDuration":3.014761904761905,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #37","backgroundName":"咲夜（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"E23CAC50-8420-4802-9F41-9F6DCE1AD8EC","duration":8.043038548752834,"transitionName":"なし","characterName":"操夢","telop":"「この記事は、幻想郷の地下深くを通るトンネルと、碓氷峠の地下を通るトンネルがつながったと記されています。」","title":"シーン 38","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.038.jpeg","voiceDuration":7.443038548752835,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #38","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"B21E9E1A-5329-448C-841A-F009B059B55F","duration":7.621292517006802,"transitionName":"なし","characterName":"操夢","telop":"「そして、この記事には、奥羽リニア新幹線のトンネルとつながり、自由に行き来できるとも記載されています。」","title":"シーン 39","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.039.jpeg","voiceDuration":7.021292517006803,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #39","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"E5530DC7-C455-4639-AFDC-071EB3FF6499","duration":8.303038548752834,"transitionName":"なし","characterName":"操夢","telop":"「そして、この記事の公開日は3人の猛者が組んでできたゆかりん党が結束した日の1ヶ月後に公開されています。」","title":"シーン 40","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.040.jpeg","voiceDuration":7.703038548752835,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #40","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"6530852C-1D9F-4127-94C3-CCCD8DBF7069","duration":8.775646258503402,"transitionName":"なし","characterName":"操夢","telop":"「実は、この記事の作者は、今僕が依頼した文さんで、おそらく、紫をはじめとしたゆかりん党と裏でつながってます。」","title":"シーン 41","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.041.jpeg","voiceDuration":8.162607709750567,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #41","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_041_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"C083CD18-9891-4D2A-BDB4-15C4B97ABE96","duration":8.621292517006802,"transitionName":"なし","characterName":"操夢","telop":"「その文さんが、その裏口を閉じて、紫さんたちを裏切ったと知れ渡れば、現内閣の崩壊は時間の問題でしょう。」","title":"シーン 42","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.042.jpeg","voiceDuration":7.925646258503401,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #42","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_042_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"D2640C89-7A98-458A-A6E8-51A4831D0F47","duration":3.8984126984126983,"transitionName":"なし","characterName":"レミリア・スカーレット","telop":"「もしかして、そこまであなたは考えて実行したの？」","title":"シーン 43","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.043.jpeg","voiceDuration":3.2984126984126982,"voiceCharacter":"レミリア・スカーレット","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideTitle":"スライド #43","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_レミリア・スカーレット.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"9BF282CD-83DE-4A27-A8E2-486C75CA0CA5","duration":8.98,"transitionName":"なし","characterName":"操夢","telop":"「いえ、ここまで完璧に推測ができれば、もっと素早い行動ができる様になりますよ。いずれは…そうなるかも知れませんが…」","title":"シーン 44","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.044.jpeg","voiceDuration":8.38,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #44","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"AFE113B6-34C6-4ECE-A90B-24242CEEC1FE","duration":3.5,"transitionName":"なし","characterName":"レミリア・スカーレット","telop":"「じゃあ、紫たちは、このままだと…」","title":"シーン 45","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.045.jpeg","voiceDuration":2.5046485260770974,"voiceCharacter":"レミリア・スカーレット","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideTitle":"スライド #45","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_045_レミリア・スカーレット.wav"},{"animationName":"なし","id":"FD3DE7ED-3021-4A3A-BF88-5A25BAEF921D","duration":3.5,"transitionName":"なし","characterName":"操夢","telop":"すると、彼女たちの表情が変わる。","title":"シーン 46","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.046.jpeg","voiceDuration":2.438684807256236,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #46","backgroundName":"咲夜ごくり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav"},{"animationName":"なし","id":"1152A24A-2FE2-4528-9F50-6E6F57D3BA32","duration":9.043038548752834,"transitionName":"なし","characterName":"操夢","telop":"「僕は、政党を作ることはしません。だから内閣が崩壊しても、それは実質的なことで他者から見たら、変わりません。」","title":"シーン 47","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.047.jpeg","voiceDuration":8.443038548752835,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #47","backgroundName":"咲夜ごくり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav"},{"animationName":"なし","id":"792F2ED8-E988-4174-8EF4-772B2EC4E502","duration":7.832154195011338,"transitionName":"なし","characterName":"操夢","telop":"「ですが、僕はこの国のシステムを直接操作、変更することで政党不要な新たな仕組みを築き上げます…」","title":"シーン 48","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.048.jpeg","voiceDuration":7.232154195011338,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #48","backgroundName":"咲夜ごくり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav"},{"animationName":"なし","id":"90FAF742-6D9E-4817-B7E9-23784A212190","duration":8.064761904761905,"transitionName":"なし","characterName":"操夢","telop":"「おそらく、僕の同胞がいるので、その人たちで丸ごとシステムを操ることで、実権を直接握り締めます…」","title":"シーン 49","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.049.jpeg","voiceDuration":7.464761904761905,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #49","backgroundName":"咲夜ごくり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav"},{"animationName":"なし","id":"8D3777C0-BDAE-40F4-A61D-AFA4514BD590","duration":8.219115646258503,"transitionName":"なし","characterName":"操夢","telop":"「ですので、紫さんたちを魔理沙さんたちから見たときは、これまで通りの状態なので、気にする必要なないですよ…」","title":"シーン 50","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.050.jpeg","voiceDuration":7.523469387755102,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #50","backgroundName":"咲夜ごくり.png","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_050_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"FE5AB8B7-4600-4875-80A5-195310E17700","duration":3.5,"transitionName":"なし","characterName":"レミリア・スカーレット","telop":"「そう…」","title":"シーン 51","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.051.jpeg","voiceDuration":1.5,"voiceCharacter":"レミリア・スカーレット","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideTitle":"スライド #51","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_レミリア・スカーレット.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"0C1B4342-1BF9-455C-B893-27DB13F5E772","duration":8.716938775510204,"transitionName":"なし","characterName":"操夢","telop":"すると、霊夢が部屋に戻ってくる。「とりあえず一通りの作業は済んだので、魔理沙さんたちは自由に行動して大丈夫ですよ。」","title":"シーン 52","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.052.jpeg","voiceDuration":8.116938775510205,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #52","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"F840DF4B-4E46-42DD-A356-920A00E14D3A","duration":3.5,"transitionName":"なし","characterName":"博麗霊夢","telop":"「えっと…私は…」","title":"シーン 53","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.053.jpeg","voiceDuration":1.6607482993197278,"voiceCharacter":"博麗霊夢","audioTrack":"track_voice_reimu","slideTitle":"スライド #53","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"DDFB3C5E-438A-4A01-9387-236BFB4D3F59","duration":7.197369614512471,"transitionName":"なし","characterName":"操夢","telop":"「霊夢さんは過去の馬券の購入歴について、\n聞きたいことがありますから、僕とこの部屋に残りますよ。」","title":"シーン 54","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.054.jpeg","voiceDuration":6.597369614512472,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #54","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","animationName":"なし","id":"12D269DF-22A0-4192-9D6D-E4781EE74FE7","duration":7.358253968253968,"transitionName":"なし","characterName":"操夢","telop":"僕はそういうと、霊夢の手を握り、こちらに引き寄せる。\n「魔理沙さんたちは自由に動いて大丈夫ですよ。」","title":"シーン 55","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.055.jpeg","voiceDuration":6.758253968253968,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #55","backgroundName":"咲夜困り顔.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"9D1B3931-9E76-43E6-99B5-5FC000C0B471","duration":8.515850340136055,"transitionName":"なし","characterName":"操夢","telop":"僕がそういうと、雰囲気で察したのか、魔理沙たちは、部屋から出ていき、部屋に残ったのは僕と霊夢の二人だけになった。","title":"シーン 56","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.056.jpeg","voiceDuration":7.915850340136054,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #56","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"AF355124-E8A2-497B-90E1-87260049A76B","duration":7.490861678004535,"transitionName":"なし","characterName":"操夢","telop":"「さて、あなたがこれまで購入した馬券の内容と金額、購入日時について１から教えてもらいますか…」","title":"シーン 57","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.057.jpeg","voiceDuration":6.890861678004535,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #57","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"240D7D6D-FBED-486C-BC6B-0245985370C1","duration":5.532154195011337,"transitionName":"なし","characterName":"操夢","telop":"「あと、働いている時の愚痴や不満があれば、\nここで一緒に述べてください。」","title":"シーン 58","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_