_6500dcce92\/交換夫婦（26話目）_6500dcce92.023.jpeg","voiceDuration":2.809433106575964,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #23","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_八雲紫.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"2C78786A-D0A0-4C6D-8009-055BB95E516C","duration":4.572131519274376,"transitionName":"なし","characterName":"にとり","telop":"「にとりです。今、中に入っても大丈夫でしょうか？」","title":"シーン 24","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.024.jpeg","voiceDuration":3.9721315192743765,"voiceCharacter":"にとり","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","slideTitle":"スライド #24","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_にとり.wav"},{"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"35D821BC-8028-450C-8095-74991A5902B5","duration":3.5,"transitionName":"なし","characterName":"八雲紫","telop":"「ええ、どうぞ。」","title":"シーン 25","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（26話目）_6500dcce92\/交換夫婦（26話目）_6500dcce92.025.jpeg","voiceDuration":1.5,"voiceCharacter":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","slideTitle":"スライド #25","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_八雲紫.wav"},{"animationName":"バウンス","id":"ACD426FE-2D09-43BD-A0E6-D565A8C4A376","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc7