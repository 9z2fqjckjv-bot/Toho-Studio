_voice_soumu","duration":5.7,"animationName":"なし","title":"シーン 58","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"僕は、彼女が困惑しているのを見て、目線で電話口を変わったほうがいいか、確認する。すると、彼女はポケベルを僕に渡す。","id":"F8F4F215-B7B3-4A78-B2E1-8E05CEC42280","slideTitle":"第58スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","voiceDuration":8.936507936507937,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"操夢"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.059.jpeg","seStartTimeOffset":0,"transitionName":"なし","audioTrack":"track_voice_soumu","duration":3.5,"animationName":"なし","title":"シーン 59","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"「もしもし、紅夢です…、どうしましたか？」","id":"EF6A47B8-188C-49BD-92CC-3D7A37561295","slideTitle":"第59スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","voiceDuration":2.806077097505669,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"操夢"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.060.jpeg","seStartTimeOffset":0,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","duration":5.9,"animationName":"なし","title":"シーン 60","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"「美鈴から聞いたわよ、あんたが居候している家に送ったデビットカードから、短時間で5件の入出金があったみたいじゃない。」","id":"B1759DE9-25A3-4DB3-96A4-08E0DF3B1679","slideTitle":"第60スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"パチュリー・ノーレッジ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav","voiceDuration":6.531519274376417,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"パチュリー・ノーレッジ"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.061.jpeg","seStartTimeOffset":0,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","duration":3.5,"animationName":"なし","title":"シーン 61","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"「それで、あんたたちは、これからどうするのよ？」","id":"948F1534-29DF-443E-9475-3FD900C38407","slideTitle":"第61スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"パチュリー・ノーレッジ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_パチュリー・ノーレッジ.wav","voiceDuration":2.531609977324263,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"パチュリー・ノーレッジ"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.062.jpeg","seStartTimeOffset":0,"transitionName":"なし","audioTrack":"track_voice_soumu","duration":5.7,"animationName":"なし","title":"シーン 62","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"「あれ…パチュリーさんは、知らないんですか…、例のデビットカードが送られたとき、一緒に手紙が入っていたことを…？」","id":"F3ABD8B7-91C0-4EC8-8A4F-EC76DD4137C0","slideTitle":"第62スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","voiceDuration":7.162607709750567,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"操夢"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.063.jpeg","seStartTimeOffset":0,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","duration":3.5,"animationName":"なし","title":"シーン 63","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"「えっ？何よ手紙って…？」","id":"18ED2739-5652-44DA-B942-D1A4E073F72D","slideTitle":"第63スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"パチュリー・ノーレッジ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_パチュリー・ノーレッジ.wav","voiceDuration":1.6711791383219954,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"パチュリー・ノーレッジ"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.064.jpeg","seStartTimeOffset":0,"transitionName":"なし","audioTrack":"track_voice_soumu","duration":5.4,"animationName":"なし","title":"シーン 64","bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","telop":"僕は、そう彼女に聞かれ、デビットカードともに入っていた手紙というか、遠足後の試験に関する詳細を彼女に伝える。","id":"7FE5ABDE-DF75-4977-A88E-8707A69B6CA4","slideTitle":"第64スライド","bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","voiceDuration":7.958253968253969,"voice2StartTimeOffset":0,"seVolume":1,"characterName":"操夢"},{"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","slideTitle":"第65スライド","voiceDuration":1.9939002267573696,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"パチュリー・ノーレッジ","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.065.jpeg","title":"シーン 65","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"「それで、それは誰が今持ってるの？」","id":"6422F75E-3DE0-49D7-8A08-19CA1D76E366","seVolume":1,"duration":3.5,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"パチュリー・ノーレッジ","bgmVolume":0.65},{"audioTrack":"track_voice_soumu","slideTitle":"第66スライド","voiceDuration":8.110430839002268,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.066.jpeg","title":"シーン 66","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"「僕のバックの中に入ってますよ。それに、その封筒の差出人は、学園長の名義で、ちょうど都合もいいので…」","id":"578D79ED-CE7F-4970-9004-424F9B4D33D7","seVolume":1,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"操夢","bgmVolume":0.65},{"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","slideTitle":"第67スライド","voiceDuration":3.35281179138322,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_パチュリー・ノーレッジ.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"パチュリー・ノーレッジ","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.067.jpeg","title":"シーン 67","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"「分かったわ、だけど覚悟してね…、お金は大事に使うのよ。」","id":"7980CAD5-E412-4654-8451-7D9A67D2DE09","seVolume":1,"duration":3.5,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"パチュリー・ノーレッジ","bgmVolume":0.65},{"audioTrack":"track_voice_soumu","slideTitle":"第68スライド","voiceDuration":7.20281179138322,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.068.jpeg","title":"シーン 68","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"彼女は、そう言うと、電話を切った。「終わりましたよ…、\nきっとこれで、説教電話はこないと…思います…。」","id":"2BAB578F-62C9-4575-8F86-059C6D823B56","seVolume":1,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"操夢","bgmVolume":0.65},{"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第69スライド","voiceDuration":4.437777777777778,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_アリス・マーガトロイド.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"アリス・マーガトロイド","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.069.jpeg","title":"シーン 69","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"「あっ…ありがとう…」\n私は、そう辿々しく言うと、彼からポケベルを受け取った。","id":"B7A92543-5CE4-4E28-914F-59B9BFE95433","seVolume":1,"duration":3.8000000000000003,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"アリス・マーガトロイド","bgmVolume":0.65},{"slideTitle":"中扉","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"単色背景","characterName":"","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.070.jpeg","title":"一方、学校では…","animationName":"なし","telop":"","id":"9E5A4C8E-50E4-4AE1-8CD9-BD1E8113319B","seVolume":1,"duration":2,"bgmName":"BGM: 少女綺想曲","bgmVolume":0.65},{"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","slideTitle":"第71スライド","voiceDuration":8.525714285714285,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_隠岐奈.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"隠岐奈","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.071.jpeg","title":"シーン 71","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"美鈴が部屋を去った後、私がしばらくその書類を眺めていると、ふと彼の考えが伝わってくる。「なるほど、そう言うことか。」","id":"F27DFBA8-522B-421C-9E57-84378674E487","seVolume":1,"duration":5.800000000000001,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"隠岐奈","bgmVolume":0.65},{"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","slideTitle":"第72スライド","voiceDuration":4.7521768707483,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_隠岐奈.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"隠岐奈","transitionName":"なし","seStartTimeOffset":0.3,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.072.jpeg","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","title":"シーン 72","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"すると、再び部屋の扉がノックされる。\n「いいぞ、入ってきなさい。」","id":"463AE4B1-1676-4ABC-8A27-FDF5285E5BB5","seVolume":0.85,"duration":3.5,"seName":"SE: 木のドアをノック1","bgmName":"BGM: 少女綺想曲","voiceCharacter":"隠岐奈","bgmVolume":0.65},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","slideTitle":"第73スライド","voiceDuration":5.585238095238095,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_美鈴.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"美鈴","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","bgmStartTimeOffset":0,"seStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.073.jpeg","title":"シーン 73","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"「学園長…、その手元の書類の控えとデビットカードを送ったのは、あなたって本当なのですか？総理大臣からの認可は？」","id":"6E37D5CD-D3F1-49B9-AC44-F8CE22C7B430","seVolume":1,"duration":5.6000000000000005,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"美鈴","bgmVolume":0.65},{"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","slideTitle":"第74スライド","voiceDuration":4.460204081632653,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_隠岐奈.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"隠岐奈","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.074.jpeg","title":"シーン 74","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"「えっと、それはだな…」私は、彼女の指摘に言葉が詰まる。","id":"D9B21163-35FF-45A3-A45B-0B5C9F8C4A15","seVolume":1,"duration":3.5,"bgmName":"BGM: 少女綺想曲","voiceCharacter":"隠岐奈","bgmVolume":0.65},{"telop":"「まさか…、認可も取らずに、独断で実行されたんですか…？」","slideTitle":"第75スライド","seVolume":1,"id":"50BDC090-AC40-4170-8453-94600B9EE1E5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","duration":3.5,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_美鈴.wav","characterName":"美鈴","voiceStartTimeOffset":0,"title":"シーン 75","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.075.jpeg","voice2StartTimeOffset":0,"voiceDuration":2.729342403628118,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴"},{"telop":"「うぐっ。」私は、彼女の言う通りで何も言えなくなる。","slideTitle":"第76スライド","seVolume":1,"id":"1AB75EEA-283C-47A2-898F-9B972CF8C998","duration":3.5,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_隠岐奈.wav","characterName":"隠岐奈","voiceStartTimeOffset":0,"title":"シーン 76","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.076.jpeg","voice2StartTimeOffset":0,"voiceDuration":4.095918367346939,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈"},{"telop":"「万が一の時には学園長の責任ですからね…、まったく…。ここ最近の学園長は彼に、固執しすぎじゃないですか…？」","slideTitle":"第77スライド","seVolume":1,"id":"715A7BE4-A030-4B0D-AF4B-35154D5E5B7B","duration":5.4,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_美鈴.wav","characterName":"美鈴","voiceStartTimeOffset":0,"title":"シーン 77","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.077.jpeg","voice2StartTimeOffset":0,"voiceDuration":5.458934240362812,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴"},{"telop":"「確かに、お前の言うとおりかも知れないな…。」","slideTitle":"第78スライド","seVolume":1,"id":"A4CD5202-4A8E-412D-B87C-4BFB61247DC4","duration":3.5,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_隠岐奈.wav","characterName":"隠岐奈","voiceStartTimeOffset":0,"title":"シーン 78","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.078.jpeg","voice2StartTimeOffset":0,"voiceDuration":2.8093650793650795,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈"},{"telop":"「だが、彼に固執するのには、理由があるんだよ、美鈴。」","slideTitle":"第79スライド","seVolume":1,"id":"A8B3F2B8-4EF2-41DC-8C73-860C034D7B25","duration":3.5,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_隠岐奈.wav","characterName":"隠岐奈","voiceStartTimeOffset":0,"title":"シーン 79","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.079.jpeg","voice2StartTimeOffset":0,"voiceDuration":4.128639455782313,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈"},{"telop":"「いったい、どんな理由ですか？」","slideTitle":"第80スライド","seVolume":1,"id":"DB5FADB5-2534-4102-AD23-9E7EEDC8E297","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","duration":3.5,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_美鈴.wav","characterName":"美鈴","voiceStartTimeOffset":0,"title":"シーン 80","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.080.jpeg","voice2StartTimeOffset":0,"voiceDuration":1.3261224489795918,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴"},{"telop":"「その理由は、今度教えるから。この話は、ここでやめだ。」","slideTitle":"第81スライド","seVolume":1,"id":"330C1F64-5953-4146-8F36-DA406641A83E","duration":3.5,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_隠岐奈.wav","characterName":"隠岐奈","voiceStartTimeOffset":0,"title":"シーン 81","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.081.jpeg","voice2StartTimeOffset":0,"voiceDuration":4.518208616780045,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈"},{"telop":"「そうですか…、それでは失礼します…。」\n私はそう言うと、部屋を出て行った。","slideTitle":"第82スライド","seVolume":1,"id":"67434B22-3BE0-4F62-95C9-3B4E4C06CFFB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","duration":3.7,"seStartTimeOffset":0,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_美鈴.wav","characterName":"美鈴","voiceStartTimeOffset":0,"title":"シーン 82","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.082.jpeg","voice2StartTimeOffset":0,"voiceDuration":3.4027210884353742,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴"},{"telop":"","slideTitle":"中扉","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～.wav","id":"B7603E35-85B7-4A9F-B34C-29BD29C7EDCA","seVolume":0.266015625,"duration":20,"seStartTimeOffset":13.606145124716534,"bgmName":"BGM: 少女綺想曲","bgmStartTimeOffset":0,"bgmVolume":0.65,"animationName":"なし","characterName":"","voiceStartTimeOffset":0,"title":"ご視聴ありがとうございました！","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.083.jpeg","voice2StartTimeOffset":0,"seName":"SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～","transitionName":"なし","backgroundName":"単色背景"}]