[{"voiceStartTimeOffset":0,"title":"シーン 1","transitionName":"なし","id":"CC4DAD65-187D-4F8D-BABD-6EA361F92070","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.70498866213152,"animationName":"なし","telop":"僕が、ATMから戻って、洋服店に戻ると、こいしがある列の洋服を真剣そうな表情で眺めていた。「どうしたんですか？」\n東方Project二次創作作品","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":9.30498866213152,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #1","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.001.jpeg","voiceCharacter":"操夢"},{"voiceStartTimeOffset":0,"title":"シーン 2","transitionName":"なし","id":"29039C2A-3B95-40FD-A73F-EB2687DB6ACA","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":2.6143537414965987,"animationName":"なし","telop":"「ねぇ、これどっちがいいと思う？」\n作成者：zuyasi","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","duration":3.214353741496599,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_古明地こいし.wav","characterName":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #2","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.002.jpeg","voiceCharacter":"古明地こいし"},{"voiceStartTimeOffset":0,"title":"シーン 3: 「えっと…」僕は、いきなりそう言われ、戸惑ってしまう。","transitionName":"なし","id":"C04F2053-810A-405D-A864-ED5DBEECD6C7","backgroundName":"単色背景","voiceDuration":3.72891156462585,"animationName":"なし","telop":"「えっと…」僕は、いきなりそう言われ、戸惑ってしまう。","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_char_5156","duration":4.32891156462585,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_紅夢.wav","characterName":"紅夢","slideTitle":"スライド #3","seVolume":1,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.003.jpeg","voiceCharacter":"紅夢"},{"voiceStartTimeOffset":0,"title":"シーン 4","transitionName":"なし","id":"7C30AE50-EB41-48E6-9B6A-47BA0B54342E","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.016938775510204,"animationName":"なし","telop":"だが、あることを思い出し、彼女の質問に答えを出す。\n「長く使えて、飽きない服を選ぶといいですよ。」\n制作ソフト及び協力\nGemini\nTohoStuido","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":7.616938775510204,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #4","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.004.jpeg","voiceCharacter":"操夢"},{"voiceStartTimeOffset":0,"title":"シーン 5","transitionName":"なし","id":"7727CCF3-A268-49A4-9498-2E87E31DAB45","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":10.223469387755102,"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（困る）.png","telop":"「そう…」私は、期待していた返答が得られずにため息が出る。\nそれから、私は一人で、買う服を決めるのだった。","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","duration":10.823469387755102,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav","characterName":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #5","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.005.jpeg","voiceCharacter":"古明地こいし"},{"voiceStartTimeOffset":0,"title":"シーン 6: 東方Project二次創作作品　Powerd By zuyasi","transitionName":"なし","id":"53D3A64C-B72C-4BAA-A07E-377039C0A990","backgroundName":"単色背景","animationName":"なし","telop":"元女子校の日常","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":2.5,"bgmVolume":0.7,"characterName":"操夢","slideTitle":"スライド #6","seVolume":1,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.006.jpeg"},{"voiceStartTimeOffset":0,"title":"シーン 7","transitionName":"なし","id":"2CD57BF4-D42D-4253-A272-F3E7171DC997","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.140861678004535,"animationName":"なし","telop":"それから僕たちは、こいしが歩くのに少し疲れていたので、休憩スペースで休みをとっていた。すると、アリスがやってくる。","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":8.740861678004535,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #7","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.007.jpeg","voiceCharacter":"操夢"},{"voiceStartTimeOffset":0,"title":"シーン 8","transitionName":"なし","id":"A59FF6A7-21CE-4A69-A763-4B35D1446226","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":5.362879818594104,"animationName":"なし","telop":"「こんなところで、どうしたんですか…」\n私は、本を買い終えて、戻ってくると休んでいた3人に聞く。","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":5.962879818594104,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_アリス・マーガトロイド.wav","characterName":"アリス・マーガトロイド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #8","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.008.jpeg","voiceCharacter":"アリス・マーガトロイド"},{"voiceStartTimeOffset":0,"title":"シーン 9","transitionName":"なし","id":"457CDBA5-F0A3-4782-845E-173FBB73E569","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.758253968253968,"animationName":"なし","telop":"「少しだけ歩き疲れたので、休憩してたんです。あと…」\n僕はそう言い、見事にくじ引きで当たった旅行券を出す。","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","duration":8.358253968253969,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #9","bgmStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.009.jpeg","voiceCharacter":"操夢"},{"duration":2.5,"characterName":"アリス・マーガトロイド","transitionName":"なし","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voiceDuration":1.2436507936507937,"slideTitle":"スライド #10","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_アリス・マーガトロイド.wav","id":"376D6BDC-A5E3-42F0-8E4E-BFA44D94349D","telop":"「これは…何ですか？」","seVolume":1,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","title":"シーン 10","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.010.jpeg"},{"duration":7.43,"characterName":"操夢","transitionName":"なし","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voiceDuration":6.83,"slideTitle":"スライド #11","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","id":"DD2E950D-2015-4F20-9833-DE208EF0ED9F","telop":"「アリスさんがいなくなった後、僕たちは洋服を買っていて、そのお店のくじ引きの景品でもらったんですよ。」","seVolume":1,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","title":"シーン 11","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.011.jpeg"},{"duration":8.545215419501133,"characterName":"操夢","transitionName":"なし","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voiceDuration":7.9452154195011335,"slideTitle":"スライド #12","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","id":"9E94CFBF-1078-4170-B04C-7C8B8973F92A","telop":"「チケットは4人分ありますが、どうします、アリスさんは行きますか？もし、行かないなら、誰かを別に誘いますけど…」","seVolume":1,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","title":"シーン 12","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.012.jpeg"},{"duration":7.263356009070295,"characterName":"アリス・マーガトロイド","transitionName":"なし","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voiceDuration":6.663356009070295,"slideTitle":"スライド #13","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_アリス・マーガトロイド.wav","id":"FE856E71-EC8B-4414-836B-BFABD86764DF","telop":"私は、彼が出した旅行券をよく見る。行き先は琉球郡沖縄本島とあり、そこで出発日が明日であることに気がつく。","seVolume":1,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","title":"シーン 13","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.013.jpeg"},{"duration":7.244807256235827,"characterName":"アリス・マーガトロイド","transitionName":"なし","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voiceDuration":6.644807256235827,"slideTitle":"スライド #14","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_アリス・マーガトロイド.wav","id":"F9D660EC-1A08-4BE5-88E8-0C034ECC811D","telop":"「まさか、今日中に準備して、明日の朝イチに空港集合なんて、言いませんよね…、今日は、出発日前日ですけど…。」","seVolume":1,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","title":"シーン 14","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.014.jpeg"},{"duration":8.666938775510204,"characterName":"操夢","transitionName":"なし","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voiceDuration":8.066938775510204,"slideTitle":"スライド #15","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","id":"523D3F68-0C5D-4B57-836D-E886D092DF39","telop":"「飛行機の時間が朝6時台であることを考えると、今日は家に帰らずに、空港の近くで泊まったほうがいいと思いますよ…」","seVolume":1,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","title":"シーン 15","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.015.jpeg"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"telop":"「家には帰れないって言うことですか？」","voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","seVolume":1,"title":"シーン 16","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","id":"29BA582A-037C-41C1-AEEE-775E4AAF7CAE","animationName":"なし","voiceDuration":1.7392290249433107,"voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.016.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #16","duration":2.5,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"bgmStartTimeOffset":0},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"telop":"「ええ、そうなりますね…。それで、どうしますか？」","voiceStartTimeOffset":0,"characterName":"操夢","seVolume":1,"title":"シーン 17","audioTrack":"track_voice_soumu","transitionName":"なし","id":"04530DF0-6940-488D-987C-435AB61F8FAC","animationName":"なし","voiceDuration":3.5017233560090704,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.017.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #17","duration":4.10172335600907,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","voice2StartTimeOffset":0,"bgmStartTimeOffset":0},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"telop":"私は、彼の急な誘いに、どう返すべきか迷う。\nそして、私が無言で、考えていると、彼がある発言をする。","voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","seVolume":1,"title":"シーン 18","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","id":"10A23DEE-6797-4CD9-AE20-13A950D1B00B","animationName":"なし","voiceDuration":6.710090702947846,"voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.018.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #18","duration":7.3100907029478455,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"bgmStartTimeOffset":0},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"telop":"「アリスさんは…、お酒は飲めますか…？」","voiceStartTimeOffset":0,"characterName":"操夢","seVolume":1,"title":"シーン 19","audioTrack":"track_voice_soumu","transitionName":"なし","id":"2892B681-296A-4932-8368-8DD2302F6AE0","animationName":"なし","voiceDuration":2.290861678004535,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.019.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #19","duration":2.8908616780045353,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","voice2StartTimeOffset":0,"bgmStartTimeOffset":0},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"telop":"「えっ？」私は、その発言に思わず、そう返してしまう。","voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","seVolume":1,"title":"シーン 20","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","id":"7E69E316-7F30-496D-A5BF-753E94B74642","animationName":"なし","voiceDuration":3.5300907029478457,"voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.020.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #20","duration":4.130090702947846,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"bgmStartTimeOffset":0},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","seStartTimeOffset":0,"telop":"「あの…、どう言う意図ですか…、その発言は…？」","voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","seVolume":1,"title":"シーン 21","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","id":"81635757-8A59-409F-AEA4-76EE1D87AAB9","animationName":"なし","voiceDuration":2.3213378684807258,"voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.021.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #21","duration":2.921337868480726,"bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"bgmStartTimeOffset":0},{"bgmVolume":0.7,"telop":"「一緒に来てくれれば…琉球郡のご当地のお酒から、好きなのを言って貰えば、僕が買うので、好きなだけ飲めますよ…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":6.871519274376417,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"8445E121-DC9E-4657-929A-F5EF8B3BCB5C","voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.022.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_アリス・マーガトロイド.wav","seStartTimeOffset":0,"slideTitle":"スライド #22","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","title":"シーン 22","voiceDuration":6.271519274376417},{"bgmVolume":0.7,"telop":"「えっ…」私は、彼が出した予想外の提案に驚く。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":3.731337868480726,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"9E3487D8-8840-43A6-9B59-297C22AA56E9","voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.023.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_アリス・マーガトロイド.wav","seStartTimeOffset":0,"slideTitle":"スライド #23","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","title":"シーン 23","voiceDuration":3.131337868480726},{"bgmVolume":0.7,"telop":"「あの…、いいんですか…、私だけ好きなお酒を飲んでも…、あなたたちはお酒がまだ飲めない年齢だけど…？」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":5.792108843537415,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"13595BEF-CBE8-4FBF-9C24-282760AEECC9","voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.024.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_アリス・マーガトロイド.wav","seStartTimeOffset":0,"slideTitle":"スライド #24","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","title":"シーン 24","voiceDuration":5.192108843537415},{"bgmVolume":0.7,"telop":"「ええもちろん…、それに高校生と中学生だけだと、何かと不自由なので…、ひとりばかし大人がいたほうがいいですよ…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":6.685170068027211,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B6542A87-469C-4980-B151-7C3A2EA0F159","voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.025.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_アリス・マーガトロイド.wav","seStartTimeOffset":0,"slideTitle":"スライド #25","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","title":"シーン 25","voiceDuration":6.085170068027211},{"bgmVolume":0.7,"telop":"「それじゃあ…」私は、そう言い、彼の提案を受け入れた。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":3.6649886621315195,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"27F7E1D3-F297-4B09-9326-9A6F6C48FE18","voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.026.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_アリス・マーガトロイド.wav","seStartTimeOffset":0,"slideTitle":"スライド #26","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","transitionName":"なし","title":"シーン 26","voiceDuration":3.0649886621315194},{"telop":"それから…","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationDuration":1.5,"voice2StartTimeOffset":0,"duration":2.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationNote":"表示時間：1.5秒","id":"566A434A-2710-45DA-95BF-4A1554B40F29","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.027.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"ナレーション","seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideTitle":"スライド #27","bgmVolume":0.7,"transitionName":"なし","title":"シーン 27"},{"bgmVolume":0.7,"telop":"それから、僕は諸々の手続きや、ホテル予約などを済ませ、3人はそれぞれ好きな軽食や今日の夕飯を買い出しを済ませた。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":8.993673469387755,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"9B4BE491-918F-45B4-9A9B-C9E39F978849","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.028.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","seStartTimeOffset":0,"slideTitle":"スライド #28","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","transitionName":"なし","title":"シーン 28","voiceDuration":8.393673469387755},{"bgmVolume":0.7,"telop":"「楽しみですか、旅行？」僕がそう聞くと、3人は頷く。\nそして、僕たちはそのまま今晩泊まるホテルに移動を始めた。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":9.486507936507936,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"BB77C998-96E1-4688-9A09-B07EFC4F5FFD","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.029.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","seStartTimeOffset":0,"slideTitle":"スライド #29","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","transitionName":"なし","title":"シーン 29","voiceDuration":8.886507936507936},{"telop":"一方、学校では…","backgroundName":"単色背景","voice2StartTimeOffset":0,"duration":2.5,"id":"84685CED-7E16-4F75-B4DF-7E765FF4971F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.030.jpeg","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","characterName":"操夢","seStartTimeOffset":0,"voiceStartTimeOffset":0,"slideTitle":"スライド #30","bgmVolume":0.7,"transitionName":"なし","title":"シーン 30: 一方、学校では…"},{"bgmVolume":0.7,"voiceStartTimeOffset":0,"telop":"私は、一人、学園長室で作業をしていると、戸がノックされる。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"duration":5.273219954648526,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","id":"D1764250-709F-4AB6-A583-994EA67202C9","voiceCharacter":"隠岐奈","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.031.jpeg","bgmStartTimeOffset":0,"seName":"SE: 木のドアをノック1","animationName":"なし","characterName":"隠岐奈","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_隠岐奈.wav","seStartTimeOffset":1.44,"slideTitle":"スライド #31","seVolume":0.85,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","transitionName":"なし","title":"シーン 31","voiceDuration":4.673219954648526},{"characterName":"隠岐奈","voiceStartTimeOffset":0,"seVolume":1,"voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_隠岐奈.wav","bgmVolume":0.7,"slideTitle":"スライド #32","seStartTimeOffset":0,"voiceCharacter":"隠岐奈","telop":"すると、ある人物の声がする。「入っていいぞ。」","animationName":"なし","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","title":"シーン 32","voiceDuration":3.3739455782312926,"bgmStartTimeOffset":0,"id":"A7D832CE-639D-4B1C-B9A3-075CC20F5C44","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.032.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.9739455782312927},{"characterName":"隠岐奈","voiceStartTimeOffset":0,"seVolume":1,"voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_隠岐奈.wav","bgmVolume":0.7,"slideTitle":"スライド #33","seStartTimeOffset":0,"voiceCharacter":"隠岐奈","telop":"「美鈴か、どうした、何かあったのか？」","animationName":"なし","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","title":"シーン 33","voiceDuration":2.8947845804988663,"bgmStartTimeOffset":0,"id":"A83A5C7A-B335-47E9-AE95-EE2CD2206ED8","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.033.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterIm