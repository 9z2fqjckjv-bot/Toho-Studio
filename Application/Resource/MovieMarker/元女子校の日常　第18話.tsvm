[{"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1","voiceCharacter":"操夢","id":"B0DAE482-55FC-45FE-BD73-E5D333915054","bgmStartTimeOffset":0,"telop":"僕が、ATMから戻って、洋服店に戻ると、こいしがある列の洋服を真剣そうな表情で眺めていた。「どうしたんですか？」\n東方Project二次創作作品","voiceStartTimeOffset":0,"duration":8.70498866213152,"characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":8.70498866213152,"bgmVolume":0.7,"seVolume":1,"seStartTimeOffset":0,"animationName":"なし","slideTitle":"スライド #1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.001.jpeg"},{"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_古明地こいし.wav","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 2","voiceCharacter":"古明地こいし","id":"803221E7-BBA0-4F31-A43F-41FC071BE115","bgmStartTimeOffset":0,"telop":"「ねぇ、これどっちがいいと思う？」\n作成者：zuyasi","voiceStartTimeOffset":0,"duration":2.6143537414965987,"characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":2.6143537414965987,"bgmVolume":0.7,"seVolume":1,"seStartTimeOffset":0,"animationName":"なし","slideTitle":"スライド #2","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.002.jpeg"},{"voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","backgroundName":"単色背景","transitionName":"なし","title":"シーン 3: 「えっと…」僕は、いきなりそう言われ、戸惑ってしまう。","voiceCharacter":"操夢","id":"4E47FC3C-B49D-4C17-A1D8-B77AE553B740","bgmStartTimeOffset":0,"telop":"「えっと…」僕は、いきなりそう言われ、戸惑ってしまう。","voiceStartTimeOffset":0,"duration":3.72891156462585,"characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":3.72891156462585,"bgmVolume":0.7,"seVolume":1,"seStartTimeOffset":0,"animationName":"なし","slideTitle":"スライド #3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.003.jpeg"},{"voice2StartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 4","voiceCharacter":"操夢","id":"701D1BBC-5948-4D7F-B050-BC4640B82E8C","bgmStartTimeOffset":0,"telop":"だが、あることを思い出し、彼女の質問に答えを出す。\n「長く使えて、飽きない服を選ぶといいですよ。」\n制作ソフト及び協力\nGemini\nTohoStuido","voiceStartTimeOffset":0,"duration":7.016938775510204,"characterName":"操夢","audioTrack":"track_voice_soumu","voiceDuration":7.016938775510204,"bgmVolume":0.7,"seVolume":1,"seStartTimeOffset":0,"animationName":"なし","slideTitle":"スライド #4","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.004.jpeg"},{"voice2StartTimeOffset":0,"telop":"「そう…」私は、期待していた返答が得られずにため息が出る。\nそれから、私は一人で、買う服を決めるのだった。","seVolume":1,"transitionName":"なし","duration":10.223469387755102,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（困る）.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.005.jpeg","slideTitle":"スライド #5","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"古明地こいし","voiceDuration":10.223469387755102,"characterName":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav","bgmStartTimeOffset":0,"id":"FE332802-17E9-4288-AE3E-A61F4AA295E5","title":"シーン 5"},{"voice2StartTimeOffset":0,"telop":"元女子校の日常","seVolume":1,"transitionName":"なし","duration":2.5,"backgroundName":"単色背景","slideTitle":"スライド #6","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.006.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"id":"2E3C4B68-F085-403E-A1F9-49F3C25C0C2B","title":"シーン 6: 東方Project二次創作作品　Powerd By zuyasi"},{"voice2StartTimeOffset":0,"telop":"それから僕たちは、こいしが歩くのに少し疲れていたので、休憩スペースで休みをとっていた。すると、アリスがやってくる。","seVolume":1,"transitionName":"なし","duration":8.140861678004535,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.007.jpeg","slideTitle":"スライド #7","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","voiceDuration":8.140861678004535,"characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","bgmStartTimeOffset":0,"id":"A16D17F4-3F4C-40E5-852D-21ED66A1E217","title":"シーン 7"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 8","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceCharacter":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_アリス・マーガトロイド.wav","duration":5.362879818594104,"transitionName":"なし","id":"8901A1F8-D732-4409-9BD1-1E72C9B4678F","bgmVolume":0.7,"seVolume":1,"voiceDuration":5.362879818594104,"animationName":"なし","telop":"「こんなところで、どうしたんですか…」\n私は、本を買い終えて、戻ってくると休んでいた3人に聞く。","bgmStartTimeOffset":0,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","slideTitle":"スライド #8","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.008.jpeg","voice2StartTimeOffset":0},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 9","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","duration":7.758253968253968,"transitionName":"なし","id":"5583B0E4-D10A-4388-B6D5-A85850134356","bgmVolume":0.7,"seVolume":1,"voiceDuration":7.758253968253968,"animationName":"なし","telop":"「少しだけ歩き疲れたので、休憩してたんです。あと…」\n僕はそう言い、見事にくじ引きで当たった旅行券を出す。","bgmStartTimeOffset":0,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterName":"操夢","slideTitle":"スライド #9","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.009.jpeg","voice2StartTimeOffset":0},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 10","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceCharacter":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_アリス・マーガトロイド.wav","duration":1.2436507936507937,"transitionName":"なし","id":"7C984C5A-0097-4752-A0BB-1959E3AA31FE","bgmVolume":0.7,"seVolume":1,"voiceDuration":1.2436507936507937,"animationName":"なし","telop":"「これは…何ですか？」","bgmStartTimeOffset":0,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","slideTitle":"スライド #10","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.010.jpeg","voice2StartTimeOffset":0},{"slideTitle":"スライド #11","voiceDuration":6.83,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.011.jpeg","title":"シーン 11","audioTrack":"track_voice_soumu","duration":6.83,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「アリスさんがいなくなった後、僕たちは洋服を買っていて、そのお店のくじ引きの景品でもらったんですよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"FC193B65-20BA-481F-8542-3DBBEA5E6C5C","voiceCharacter":"操夢"},{"slideTitle":"スライド #12","voiceDuration":7.9452154195011335,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.012.jpeg","title":"シーン 12","audioTrack":"track_voice_soumu","duration":7.9452154195011335,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「チケットは4人分ありますが、どうします、アリスさんは行きますか？もし、行かないなら、誰かを別に誘いますけど…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"42616DC0-3771-4140-A7DF-D6584EBD1A62","voiceCharacter":"操夢"},{"slideTitle":"スライド #13","voiceDuration":6.663356009070295,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.013.jpeg","title":"シーン 13","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":6.663356009070295,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_アリス・マーガトロイド.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私は、彼が出した旅行券をよく見る。行き先は琉球郡沖縄本島とあり、そこで出発日が明日であることに気がつく。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"F97093C1-4A0D-4E3D-AF5C-CCCB6A8BC767","voiceCharacter":"アリス・マーガトロイド"},{"slideTitle":"スライド #14","voiceDuration":6.4959410430839,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.014.jpeg","title":"シーン 14","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":6.4959410430839,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_アリス・マーガトロイド.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「まさか、今日中に準備して、明日の朝イチに空港集合なんて、言いませんよね…、今日は、出発日前日ですけど…。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"79E9685A-9BF6-4A17-AC26-BC8E28D58E34","voiceCharacter":"アリス・マーガトロイド"},{"slideTitle":"スライド #15","voiceDuration":7.871292517006803,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.015.jpeg","title":"シーン 15","audioTrack":"track_voice_soumu","duration":7.871292517006803,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「飛行機の時間が朝6時台であることを考えると、今日は家に帰らずに、空港の近くで泊まったほうがいいと思いますよ…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"B2AC7890-4341-4946-B0C7-30EB33517711","voiceCharacter":"操夢"},{"slideTitle":"スライド #16","voiceDuration":1.7392290249433107,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.016.jpeg","title":"シーン 16","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":1.7392290249433107,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_アリス・マーガトロイド.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「家には帰れないって言うことですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"A6E4DC2E-B396-4276-B880-30BCF2338D5E","voiceCharacter":"アリス・マーガトロイド"},{"slideTitle":"スライド #17","voiceDuration":3.5017233560090704,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.017.jpeg","title":"シーン 17","audioTrack":"track_voice_soumu","duration":3.5017233560090704,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ええ、そうなりますね…。それで、どうしますか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"D4ABD7B7-CA53-4884-891E-DE1FCA8F1E19","voiceCharacter":"操夢"},{"slideTitle":"スライド #18","voiceDuration":6.710090702947846,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.018.jpeg","title":"シーン 18","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":6.710090702947846,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_アリス・マーガトロイド.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私は、彼の急な誘いに、どう返すべきか迷う。\nそして、私が無言で、考えていると、彼がある発言をする。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"C3B9FFCD-DB26-423F-B694-EE29A18F9FA2","voiceCharacter":"アリス・マーガトロイド"},{"slideTitle":"スライド #19","voiceDuration":2.290861678004535,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.019.jpeg","title":"シーン 19","audioTrack":"track_voice_soumu","duration":2.290861678004535,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「アリスさんは…、お酒は飲めますか…？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"8716DD97-7A3C-452B-8DFB-A0B1F1DFDD69","voiceCharacter":"操夢"},{"slideTitle":"スライド #20","voiceDuration":3.5300907029478457,"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.020.jpeg","title":"シーン 20","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":3.5300907029478457,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_アリス・マーガトロイド.wav","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「えっ？」私は、その発言に思わず、そう返してしまう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","seVolume":1,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"D7BBA6EF-B40E-4833-9B62-A3A2C4CE816C","voiceCharacter":"アリス・マーガトロイド"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":2.3213378684807258,"id":"65F65790-F547-4AD4-A160-658DA3A006AE","telop":"「あの…、どう言う意図ですか…、その発言は…？」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 21","seVolume":1,"duration":2.3213378684807258,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"スライド #21","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.021.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.089546485260771,"id":"52B8CA4B-0E9C-4846-8BA0-306EEF6DE2F1","telop":"「一緒に来てくれれば…琉球郡のご当地のお酒から、好きなのを言って貰えば、僕が買うので、好きなだけ飲めますよ…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 22","seVolume":1,"duration":7.089546485260771,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #22","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.022.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.0759410430839003,"id":"91679F17-2785-4D15-A0E7-9826F7814299","telop":"「えっ…」私は、彼が出した予想外の提案に驚く。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 23","seVolume":1,"duration":3.0759410430839003,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"スライド #23","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.023.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":5.192108843537415,"id":"31AFB262-B7FB-4D9D-908C-7FF8C4261AA0","telop":"「あの…、いいんですか…、私だけ好きなお酒を飲んでも…、あなたたちはお酒がまだ飲めない年齢だけど…？」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 24","seVolume":1,"duration":5.192108843537415,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"スライド #24","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.024.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":6.8789115646258505,"id":"E56C0621-01AB-4886-957A-997A0A6909BC","telop":"「ええもちろん…、それに高校生と中学生だけだと、何かと不自由なので…、ひとりばかし大人がいたほうがいいですよ…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 25","seVolume":1,"duration":6.8789115646258505,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #25","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.025.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.0649886621315194,"id":"D389F255-A6EA-40A7-8484-BDFB1B84FB4A","telop":"「それじゃあ…」私は、そう言い、彼の提案を受け入れた。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 26","seVolume":1,"duration":3.0649886621315194,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"スライド #26","characterName":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.026.jpeg"},{"animationNote":"表示時間：1.5秒","bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"EF64E112-77D3-4CC8-9124-FE67159B2D90","telop":"それから…","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 27","seVolume":1,"duration":1.5,"bgmStartTimeOffset":0,"animationDuration":1.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #27","characterName":"ナレーション","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.027.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.393673469387755,"id":"F79F30B6-4304-4D2A-A51E-B70BDDE4331D","telop":"それから、僕は諸々の手続きや、ホテル予約などを済ませ、3人はそれぞれ好きな軽食や今日の夕飯を買い出しを済ませた。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 28","seVolume":1,"duration":8.393673469387755,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #28","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.028.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.886507936507936,"id":"0587FC28-3607-4D1D-9CC9-AE3AB67A1287","telop":"「楽しみですか、旅行？」僕がそう聞くと、3人は頷く。\nそして、僕たちはそのまま今晩泊まるホテルに移動を始めた。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 29","seVolume":1,"duration":8.886507936507936,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","slideTitle":"スライド #29","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.029.jpeg"},{"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"FC53BB76-0FED-40E2-B2F2-4E6D22A56D00","telop":"一方、学校では…","backgroundName":"単色背景","title":"シーン 30: 一方、学校では…","seVolume":1,"duration":2.5,"bgmStartTimeOffset":0,"slideTitle":"スライド #30","characterName":"操夢","voice2StartTimeOffset":0,"animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.030.jpeg"},{"seVolume":0.85,"seStartTimeOffset":3.69,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_隠岐奈.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #31","duration":4.673219954648526,"title":"シーン 31","voiceDuration":4.673219954648526,"telop":"私は、一人、学園長室で作業をしていると、戸がノックされる。","voice2StartTimeOffset":0,"characterName":"隠岐奈","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.031.jpeg","id":"1327313E-FD02-40B5-9E07-7278EF171637","seName":"SE: 木のドアをノック1"},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_隠岐奈.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #32","duration":3.3739455782312926,"title":"シーン 32","voiceDuration":3.3739455782312926,"telop":"すると、ある人物の声がする。「入っていいぞ。」","voice2StartTimeOffset":0,"characterName":"隠岐奈","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.032.jpeg","id":"DB4F7DB0-0F83-40A6-A1B2-C5B779B6088B","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_隠岐奈.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #33","duration":2.8947845804988663,"title":"シーン 33","voiceDuration":2.8947845804988663,"telop":"「美鈴か、どうした、何かあったのか？」","voice2StartTimeOffset":0,"characterName":"隠岐奈","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.033.jpeg","id":"C79A97FE-F3FD-4016-AEB2-55BC37ED0581","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_美鈴.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #34","duration":6.010226757369614,"title":"シーン 34","voiceDuration":6.010226757369614,"telop":"「学園長…、つい先ほど、先日例の彼が居候している家に、送ったカードから数時間のうちに5回ほどの入出金がありまして…」","voice2StartTimeOffset":0,"characterName":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.034.jpeg","id":"78B2D22A-0652-408C-94E3-650E38B02769","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_隠岐奈.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #35","duration":2.730612244897959,"title":"シーン 35","voiceDuration":2.730612244897959,"telop":"「入出金の明細は、どうなってんだ？」","voice2StartTimeOffset":0,"characterName":"隠岐奈","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.035.jpeg","id":"AC3A810E-9A2F-471F-811E-1CB561268251","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_美鈴.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #36","duration":5.761269841269841,"title":"シーン 36","voiceDuration":5.761269841269841,"telop":"「お台場のショッピングモール内の洋服店から1件、現金の引き出しと、振り込みがそれぞれ1件、ホテル関連のものが数件です。」","voice2StartTimeOffset":0,"characterName":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.036.jpeg","id":"82AEB04F-5C24-4D66-81EF-81970EA75975","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_隠岐奈.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #37","duration":0.6786394557823129,"title":"シーン 37","voiceDuration":0.6786394557823129,"telop":"「ホテル？」","voice2StartTimeOffset":0,"characterName":"隠岐奈","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.037.jpeg","id":"A4353B7A-2E78-413E-8286-70A22C62F698","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_美鈴.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #38","duration":4.998208616780046,"title":"シーン 38","voiceDuration":4.998208616780046,"telop":"「ええ、一つは立体蒲田駅近くのホテル、残りは琉球郡内の沖縄本島にあるホテルの予約になっています。」","voice2StartTimeOffset":0,"characterName":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.038.jpeg","id":"0E877EC8-D04F-4E71-AA6A-81C1A10D67CE","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_隠岐奈.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #39","duration":2.6823809523809525,"title":"シーン 39","voiceDuration":2.6823809523809525,"telop":"「デビットカードを使ったのは誰かわかるか？」","voice2StartTimeOffset":0,"characterName":"隠岐奈","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"隠岐奈","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.039.jpeg","id":"533F6DEB-1E50-4EE9-BC3E-4506FAE7BCED","seVolume":1},{"seStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_美鈴.wav","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"スライド #40","duration":5.005963718820862,"title":"シーン 40","voiceDuration":5.005963718820862,"telop":"「おそらく、例の彼本人かと…、どうしましょう、例の彼がいる班の班長に、何があったのかを聞き出しますか？」","voice2StartTimeOffset":0,"characterName":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"美鈴","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.040.jpeg","id":"D4FFC242-94A2-4D9C-B63B-B827A97F3087","seVolume":1},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.041.jpeg","voiceCharacter":"隠岐奈","slideTitle":"スライド #41","voiceDuration":6.416666666666667,"voice2StartTimeOffset":0,"telop":"「確か、あの班の班長は、パチュリーが使っている研究室で学んでいる大学院生だったよな…？」","characterName":"隠岐奈","duration":6.416666666666667,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"50154C51-33BD-4832-80E8-F26877B9C677","title":"シーン 41","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_隠岐奈.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.042.jpeg","voiceCharacter":"美鈴","slideTitle":"スライド #42","voiceDuration":2.137573696145125,"voice2StartTimeOffset":0,"telop":"「ええ、班長の名前はアリス・マーガトロイドですが…？」","characterName":"美鈴","duration":2.137573696145125,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"9CF531AF-2B2C-43F1-A17F-D0A2B28AE1BC","title":"シーン 42","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_美鈴.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.043.jpeg","voiceCharacter":"隠岐奈","slideTitle":"スライド #43","voiceDuration":8.742290249433106,"voice2StartTimeOffset":0,"telop":"「なら、パチュリーに言いつけて、確認させて、あなたがその内容を聞いて、私に報告しなさい、期限は今日の午後3時までだ。」","characterName":"隠岐奈","duration":8.742290249433106,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"A08DE521-4E47-46BA-A378-38E773815055","title":"シーン 43","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_隠岐奈.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.044.jpeg","voiceCharacter":"美鈴","slideTitle":"スライド #44","voiceDuration":1.5932199546485262,"voice2StartTimeOffset":0,"telop":"「承知しました…聞き出してきます。」","characterName":"美鈴","duration":1.5932199546485262,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"D2B1C289-2FBB-4BC6-AB4E-B14407DF04C5","title":"シーン 44","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_美鈴.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.045.jpeg","voiceCharacter":"隠岐奈","slideTitle":"スライド #45","voiceDuration":9.177687074829931,"voice2StartTimeOffset":0,"telop":"私は、彼女が去ると、手元の机からある書類を取り出す。それには、例の彼が遠足後に受ける、試験の詳細が記されていた。","characterName":"隠岐奈","duration":9.177687074829931,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"C8AC01B9-0888-4A95-B3C1-01CADAFDCF89","title":"シーン 45","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_隠岐奈.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"animationNote":"表示時間：1.5秒","animationDuration":1.5,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.046.jpeg","slideTitle":"スライド #46","voice2StartTimeOffset":0,"telop":"それから、彼らは…","characterName":"ナレーション","duration":1.5,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"0B813745-F87F-4B29-AD92-727B4F9AB3EB","title":"シーン 46","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.047.jpeg","voiceCharacter":"操夢","slideTitle":"スライド #47","voiceDuration":9.162607709750567,"voice2StartTimeOffset":0,"telop":"それから、僕たちは、ホテルに着くと、予約した四人部屋に入る。そして、入浴の順番を決めて、アリスが先に浴室に入る。","characterName":"操夢","duration":9.162607709750567,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"1B796536-EE2F-4825-84ED-A4FF07CE4E6E","title":"シーン 47","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.048.jpeg","voiceCharacter":"古明地さとり","slideTitle":"スライド #48","voiceDuration":3.088979591836735,"voice2StartTimeOffset":0,"telop":"「あの…女子3人と一緒の部屋で寝泊まりで…いいんですか？」","characterName":"古明地さとり","duration":3.088979591836735,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"D16289C0-AA55-4B35-A8AE-AF69BBE5EEB7","title":"シーン 48","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_古明地さとり.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.049.jpeg","voiceCharacter":"操夢","slideTitle":"スライド #49","voiceDuration":3.666938775510204,"voice2StartTimeOffset":0,"telop":"「ええ、条件に見合った部屋が、ここしかなかったので…。」","characterName":"操夢","duration":3.666938775510204,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"2EB92047-813E-48A9-93F3-7723490DE8FE","title":"シーン 49","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","seStartTimeOffset":0,"animationName":"なし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","transitionName":"なし","bgmStartTimeOffset":0,"bgmVolume":0.7,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.050.jpeg","voiceCharacter":"古明地さとり","slideTitle":"スライド #50","voiceDuration":2.068185941043084,"voice2StartTimeOffset":0,"telop":"「そうですか…。それならいいんですけど…」","characterName":"古明地さとり","duration":2.068185941043084,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"id":"9E208F28-74D9-417B-A69B-885EBB35C235","title":"シーン 50","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_古明地さとり.wav","seStartTimeOffset":0,"animationName":"なし"},{"id":"1C6D5284-A4D9-433C-B7B9-FDA5385FD64D","duration":7.460430839002267,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","voiceCharacter":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","title":"シーン 51","transitionName":"なし","voiceDuration":7.460430839002267,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.051.jpeg","telop":"「それより、アリスさんの入力が終わったら、こいしさんを目覚めさせてください…」僕は、そう言いながら、こいしを見る。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","bgmVolume":0.7,"slideTitle":"スライド #51","animationName":"なし"},{"id":"BAA312AF-01E0-4C6B-834C-0CEE847ACEBE","duration":8.457165532879818,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","voiceCharacter":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","title":"シーン 52","transitionName":"なし","voiceDuration":8.457165532879818,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.052.jpeg","telop":"そこには、寝落ち寸前のような表情で、こくこくと頭が動いているこいしの姿があった。「今寝ちゃうと、夜眠れませんから…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","bgmVolume":0.7,"slideTitle":"スライド #52","animationName":"なし"},{"id":"C2FDB3A4-7ED4-4218-99AB-504D0553B1E5","duration":6.592585034013606,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_古明地さとり.wav","voiceCharacter":"古明地さとり","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"古明地さとり","title":"シーン 53","transitionName":"なし","voiceDuration":6.592585034013606,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.053.jpeg","telop":"「分かりました…」私と彼がそう話していると、浴室の扉が開く。そして、妹を起こし、入浴に向かわせた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","bgmVolume":0.7,"slideTitle":"スライド #53","animationName":"なし"},{"id":"AA0ADFB4-F098-444E-AF88-B90DBE874890","duration":6.35297052154195,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"アリス・マーガトロイド","title":"シーン 54","transitionName":"なし","voiceDuration":6.35297052154195,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.054.jpeg","telop":"私は、入浴が終わると、ポケベルに着信があったことに気がつく。そして、さとりと彼の了承を得ると電話に出る。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","bgmVolume":0.7,"slideTitle":"スライド #54","animationName":"なし"},{"id":"940F06BB-EF0D-4ED3-A9FC-C33F4CC24B8F","duration":1.5932653061224489,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"アリス・マーガトロイド","title":"シーン 55","transitionName":"なし","voiceDuration":1.5932653061224489,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.055.jpeg","telop":"「もしもし、どうしたんですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","bgmVolume":0.7,"slideTitle":"スライド #55","animationName":"なし"},{"id":"244E7D8B-A653-480E-82C4-8432CF67D3AD","duration":2.383469387755102,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_パチュリー・ノーレッジ.wav","voiceCharacter":"パチュリー・ノーレッジ","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","title":"シーン 56","transitionName":"なし","voiceDuration":2.383469387755102,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.056.jpeg","telop":"「あんたたち一体、遠足で何をしてるの？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","bgmVolume":0.7,"slideTitle":"スライド #56","animationName":"なし"},{"id":"A7ABED0E-DDD9-4C9C-9D52-1863DB9CCA3C","duration":0.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"アリス・マーガトロイド","title":"シーン 57","transitionName":"なし","voiceDuration":0.5,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.057.jpeg","telop":"「えっ？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","bgmVolume":0.7,"slideTitle":"スライド #57","animationName":"なし"},{"id":"61A4D374-6C30-4DD8-8289-34A5428E892C","duration":8.936507936507937,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","voiceCharacter":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","title":"シーン 58","transitionName":"なし","voiceDuration":8.936507936507937,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.058.jpeg","telop":"僕は、彼女が困惑しているのを見て、目線で電話口を変わったほうがいいか、確認する。すると、彼女はポケベルを僕に渡す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","bgmVolume":0.7,"slideTitle":"スライド #58","animationName":"なし"},{"id":"47CC196E-3D93-4725-BB19-4F3D07687C17","duration":2.806077097505669,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","voiceCharacter":"操夢","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","title":"シーン 59","transitionName":"なし","voiceDuration":2.806077097505669,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.059.jpeg","telop":"「もしもし、紅夢です…、どうしましたか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","bgmVolume":0.7,"slideTitle":"スライド #59","animationName":"なし"},{"id":"CF176D1B-06C8-454E-86BC-7FBC37927CDC","duration":6.531519274376417,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav","voiceCharacter":"パチュリー・ノーレッジ","voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"seVolume":1,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","title":"シーン 60","transitionName":"なし","voiceDuration":6.531519274376417,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.060.jpeg","telop":"「美鈴から聞いたわよ、あんたが居候している家に送ったデビットカードから、短時間で5件の入出金があったみたいじゃない。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","bgmVolume":0.7,"slideTitle":"スライド #60","animationName":"なし"},{"slideTitle":"スライド #61","seStartTimeOffset":0,"title":"シーン 61","bgmVolume":0.7,"telop":"「それで、あんたたちは、これからどうするのよ？」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"パチュリー・ノーレッジ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":2.531609977324263,"transitionName":"なし","id":"7BD9B8A5-0389-4309-AAED-BEBFEF46DF38","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_パチュリー・ノーレッジ.wav","voiceCharacter":"パチュリー・ノーレッジ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.061.jpeg","bgmStartTimeOffset":0,"voiceDuration":2.531609977324263},{"slideTitle":"スライド #62","seStartTimeOffset":0,"title":"シーン 62","bgmVolume":0.7,"telop":"「あれ…パチュリーさんは、知らないんですか…、例のデビットカードが送られたとき、一緒に手紙が入っていたことを…？」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":7.162607709750567,"transitionName":"なし","id":"07097E99-98CF-4D38-824C-E33DBF39C76F","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.062.jpeg","bgmStartTimeOffset":0,"voiceDuration":7.162607709750567},{"slideTitle":"スライド #63","seStartTimeOffset":0,"title":"シーン 63","bgmVolume":0.7,"telop":"「えっ？何よ手紙って…？」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"パチュリー・ノーレッジ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":1.6711791383219954,"transitionName":"なし","id":"E7B39D95-240C-4A81-81BF-6357D7A1D1A0","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_パチュリー・ノーレッジ.wav","voiceCharacter":"パチュリー・ノーレッジ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.063.jpeg","bgmStartTimeOffset":0,"voiceDuration":1.6711791383219954},{"slideTitle":"スライド #64","seStartTimeOffset":0,"title":"シーン 64","bgmVolume":0.7,"telop":"僕は、そう彼女に聞かれ、デビットカードともに入っていた手紙というか、遠足後の試験に関する詳細を彼女に伝える。","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":7.958253968253969,"transitionName":"なし","id":"92C9480C-36F4-49A6-88F9-38CE143588CB","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.064.jpeg","bgmStartTimeOffset":0,"voiceDuration":7.958253968253969},{"slideTitle":"スライド #65","seStartTimeOffset":0,"title":"シーン 65","bgmVolume":0.7,"telop":"「それで、それは誰が今持ってるの？」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"パチュリー・ノーレッジ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":1.9939002267573696,"transitionName":"なし","id":"5AC3D5B2-A9EF-4365-BF22-B7A720BD30A5","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_パチュリー・ノーレッジ.wav","voiceCharacter":"パチュリー・ノーレッジ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.065.jpeg","bgmStartTimeOffset":0,"voiceDuration":1.9939002267573696},{"slideTitle":"スライド #66","seStartTimeOffset":0,"title":"シーン 66","bgmVolume":0.7,"telop":"「僕のバックの中に入ってますよ。それに、その封筒の差出人は、学園長の名義で、ちょうど都合もいいので…」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":8.110430839002268,"transitionName":"なし","id":"1D8A551D-1648-4E1C-B127-433826ACEC8F","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.066.jpeg","bgmStartTimeOffset":0,"voiceDuration":8.110430839002268},{"slideTitle":"スライド #67","seStartTimeOffset":0,"title":"シーン 67","bgmVolume":0.7,"telop":"「分かったわ、だけど覚悟してね…、お金は大事に使うのよ。」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"パチュリー・ノーレッジ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.35281179138322,"transitionName":"なし","id":"175A8BDD-2273-4CEF-8EAE-6B0828B54F94","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_パチュリー・ノーレッジ.wav","voiceCharacter":"パチュリー・ノーレッジ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.067.jpeg","bgmStartTimeOffset":0,"voiceDuration":3.35281179138322},{"slideTitle":"スライド #68","seStartTimeOffset":0,"title":"シーン 68","bgmVolume":0.7,"telop":"彼女は、そう言うと、電話を切った。「終わりましたよ…、\nきっとこれで、説教電話はこないと…思います…。」","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":7.20281179138322,"transitionName":"なし","id":"2A4D7B31-8EF3-41B2-8E10-6263BFACC6EB","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_97165b2773\/元女子校の日常　第18話_97165b2773.068.jpeg","bgmStartTimeOffset":0,"voiceDuration":7.20281179138322},{"slideTitle":"スライド #69","seStartTimeOffset":0,"title":"シーン 69","bgmVolume":0.7,"telop":"「あっ…ありがとう…」\n私は、そう辿々しく言うと、彼からポケベルを受け取った。","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"アリス・マーガトロイド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":4.437777777777778,"transitionName":"なし","id":"8A371294-49A7-4D72-8D7F-2C39CE63205C","audioTrack":"track_voice_%