ffset":0,"telop":"「なら、パチュリーに言いつけて、確認させて、あなたがその内容を聞いて、私に報告しなさい、期限は今日の午後3時までだ。」","id":"AD44E292-34A5-43AC-BF60-2BE52880BA99","seVolume":1,"bgmVolume":0.7,"bgmStartTimeOffset":0,"animationName":"なし","characterName":"隠岐奈","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","voiceCharacter":"隠岐奈"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_美鈴.wav","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","voiceDuration":1.5932199546485262,"seStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #44","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.044.jpeg","duration":2.5,"title":"シーン 44","voice2StartTimeOffset":0,"telop":"「承知しました…聞き出してきます。」","id":"6D5A4E9C-9BAF-428A-8ED1-28769861B685","seVolume":1,"bgmVolume":0.7,"bgmStartTimeOffset":0,"animationName":"なし","characterName":"美鈴","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","voiceCharacter":"美鈴"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":9.177687074829931,"seStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #45","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.045.jpeg","duration":9.777687074829931,"title":"シーン 45","voice2StartTimeOffset":0,"telop":"私は、彼女が去ると、手元の机からある書類を取り出す。それには、例の彼が遠足後に受ける、試験の詳細が記されていた。","id":"96B1773D-8257-472D-838B-3221CFE5D0F0","seVolume":1,"bgmVolume":0.7,"bgmStartTimeOffset":0,"animationName":"なし","characterName":"隠岐奈","voiceStartTimeOffset":0,"voiceCharacter":"隠岐奈"},{"seStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationDuration":1.5,"slideTitle":"スライド #46","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.046.jpeg","duration":2.5,"title":"シーン 46","voice2StartTimeOffset":0,"telop":"それから、彼らは…","id":"6C2FC708-8CFB-4356-AD68-3AA5229B2F51","animationNote":"表示時間：1.5秒","seVolume":1,"bgmVolume":0.7,"bgmStartTimeOffset":0,"animationName":"なし","characterName":"ナレーション","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":9.162607709750567,"seStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #47","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.047.jpeg","duration":9.762607709750567,"title":"シーン 47","voice2StartTimeOffset":0,"telop":"それから、僕たちは、ホテルに着くと、予約した四人部屋に入る。そして、入浴の順番を決めて、アリスが先に浴室に入る。","id":"7CE64C34-D531-4590-9DDA-D10DA1523A3B","seVolume":1,"bgmVolume":0.7,"bgmStartTimeOffset":0,"animationName":"なし","characterName":"操夢","voiceStartTimeOffset":0,"voiceCharacter":"操夢"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_古明地さとり.wav","