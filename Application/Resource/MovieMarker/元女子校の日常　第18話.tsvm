tTimeOffset":0,"voice2StartTimeOffset":0,"telop":"「えっ？」私は、その発言に思わず、そう返してしまう。","voiceDuration":3.5300907029478457,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_アリス・マーガトロイド.wav","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"第21スライド","seVolume":1,"title":"シーン 21","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.021.jpeg","id":"07403028-E05D-4C5E-B2F6-FC3E862D6C8C","voiceStartTimeOffset":0,"bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.5,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceCharacter":"アリス・マーガトロイド","characterName":"アリス・マーガトロイド","bgmName":"BGM: 少女綺想曲","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"telop":"「あの…、どう言う意図ですか…、その発言は…？」","voiceDuration":2.3213378684807258,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_アリス・マーガトロイド.wav","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"第22スライド","seVolume":1,"title":"シーン 22","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.022.jpeg","id":"6EFAC4A1-6C61-4F5A-8832-F8ECEF137A28","voiceStartTimeOffset":0,"bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":5.5,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceCharacter":"アリス・マーガトロイド","characterName":"アリス・マーガトロイド","bgmName":"BGM: 少女綺想曲","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"telop":"「一緒に来てくれれば…琉球郡のご当地のお酒から、好きなのを言って貰えば、僕が買うので、好きなだけ飲めますよ…」","voiceDuration":6.271519274376417,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_アリス・マーガトロイド.wav","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"第23スライド","seVolume":1,"title":"シーン 23","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.023.jpeg","id":"2E25AB2B-5FA5-4093-9041-37C6C6BEC7C7","voiceStartTimeOffset":0,"bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.5,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceCharacter":"アリス・マーガトロイド","characterName":"アリス・マーガトロイド","bgmName":"BGM: 少女綺想曲","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"telop":"「えっ…」私は、彼が出した予想外の提案に驚く。","voiceDuration":3.131337868480726,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_アリス・マーガトロイド.wav","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"第24スライド","seVolume":1,"title":"シーン 24","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第18話_5125d7fb95\/元女子校の日常　第18話_5125d7fb95.024.jpeg","id":"E8E3A1BA-7EB6-4BD6-AD81-E209F243A8F7","voiceStartTimeOffset":0,"bgmVolume":0.65,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":5.1000000000000005,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceCharacter":"アリス・マーガトロイド","characterName":"アリス・マーガトロイド","bgmName":"