[{"bgmVolume":0.65,"seStartTimeOffset":5.5,"voiceStartTimeOffset":0,"seName":"SE: スペルカード発動音","transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.6000000000000005,"slideTitle":"第1スライド","voiceDuration":8.947369614512471,"telop":"体力テストと、統一模試を受けてから数日が経ち、遠足まであと1週間を切った今日、僕は教室に入ると、自分の席に着く。\n東方Project二次創作作品","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"546BB2A5-F5B8-4AD7-B093-15AA8C7739DF","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.001.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","title":"シーン 1","seVolume":0.85,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第2スライド","voiceDuration":2.564761904761905,"telop":"すると、さとりがこちらに駆け寄ってくる。\n作成者：zuyasi","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"8DF2854F-EDFB-491E-8B66-C60F97648FF6","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.002.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","title":"シーン 2","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"voiceStartTimeOffset":0,"seStartTimeOffset":2.099999999999998,"seName":"SE: 決定・衝撃音","transitionName":"なし","characterName":"さ&り","duration":3,"slideTitle":"中扉","telop":"「紅夢さん、あなた学内で、有名人になってますよ。」","bgmName":"BGM: 東方妖恋談","backgroundName":"単色背景","bgmStartTimeOffset":0,"id":"6C581615-4B93-41A2-B30E-612E4364FB28","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.003.jpeg","title":"「紅夢さん、あなた学内で、有名人になってますよ。」","seVolume":0.8,"animationName":"なし","bgmVolume":0.65},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.9,"slideTitle":"第4スライド","voiceDuration":7.756077097505669,"telop":"「えっ…」僕はそう呟き、なぜ自分が有名人になったかを考える。そして、彼女に聞く。「なぜですか…？」\n制作ソフト及び協力\nGemini\nTohoStuido","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"D68386B1-DC82-4C11-A68E-2C4494B942A9","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.004.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","title":"シーン 4","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"さ&り","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.6000000000000005,"slideTitle":"第5スライド","voiceDuration":1.473469387755102,"telop":"「本来なら大学受験に使われるような高難度の問題が入り混じった模試で満点を取り、文武両道な転校生が学内にいると…」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","id":"6EAA2D9C-277B-457F-A8F6-F04566A0E04A","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.005.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav","title":"シーン 5","seVolume":1,"animationName":"なし","voiceCharacter":"古明地さとり"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"さ&り","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.2,"slideTitle":"第6スライド","voiceDuration":2.9877777777777776,"telop":"「教員側も驚愕しているっていう噂と共に、生徒の間でも話題になってますよ。それこそ遠足と学校行事よりも…」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","id":"D00FEA09-69EC-4BFE-9639-4B287F679F19","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.006.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_古明地さとり.wav","title":"シーン 6","seVolume":1,"animationName":"なし","voiceCharacter":"古明地さとり"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"さ&り","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.9,"slideTitle":"第7スライド","voiceDuration":1.280748299319728,"telop":"「私が聞いた限りだと、あなたは1500mを数分で走り切った後に受けた模試で100点が出た、転校生だと言われてますよ。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","id":"D76608E2-6B5B-46FB-864D-6571AF1FC219","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.007.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_パチュリー・ノーレッジ.wav","title":"シーン 7","seVolume":1,"animationName":"なし","voiceCharacter":"古明地さとり"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"さ&り","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.5,"slideTitle":"第8スライド","voiceDuration":2.17859410430839,"telop":"「女子は、噂に敏感で、何でもかんでもすぐに広まるので、気をつけないと、後々面倒ごとに巻き込まれちゃいますよ。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","id":"2458D034-01A2-41EA-9E28-E0E26A61C7DD","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.008.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_古明地さとり.wav","title":"シーン 8","seVolume":1,"animationName":"なし","voiceCharacter":"古明地さとり"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第9スライド","voiceDuration":4.466938775510204,"telop":"「えっと…」\n僕は、彼女から聞いたその内容に困惑するのだった。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"664580EE-C431-484C-B252-E013661B988E","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.009.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","title":"シーン 9","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"voiceStartTimeOffset":0,"seStartTimeOffset":0,"transitionName":"なし","characterName":"","duration":2,"slideTitle":"タイトル","telop":"元女子校の日常","bgmName":"BGM: 東方妖恋談","backgroundName":"単色背景","bgmStartTimeOffset":0,"id":"23125E46-9260-40A2-B9C5-B408D7A10344","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.010.jpeg","title":"東方Project二次創作作品　Powerd By zuyasi","seVolume":1,"animationName":"なし","bgmVolume":0.65},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.2,"slideTitle":"第11スライド","voiceDuration":8.25390022675737,"telop":"それから、さとりは自席に戻り、しばらくすると、教室の扉がチャイムと同時に開く。そして、担任が入ってくる。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"438EFE2F-BBD5-416E-BFE4-51CA813A9868","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.011.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","title":"シーン 11","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.2,"slideTitle":"第12スライド","voiceDuration":7.321292517006802,"telop":"僕はいつものように、素早く立ち上がり、クラスメイトと同じタイミングで礼と挨拶をすると、彼女の合図で座る。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"471BA5EE-4587-4E79-95DA-3F99901DED69","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.012.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","title":"シーン 12","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"東風谷早苗","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.7,"slideTitle":"第13スライド","voiceDuration":9.00156462585034,"telop":"「それでは、朝礼を始めます。今日は、テスト返却の後は、遠足に向けた、全校集会なので昼食後速やかに移動するように。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","id":"00B89782-11EC-4C0E-848C-88D92B98C8A6","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.013.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_東風谷早苗.wav","title":"シーン 13","seVolume":1,"animationName":"なし","voiceCharacter":"東風谷早苗"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"東風谷早苗","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.300000000000001,"slideTitle":"第14スライド","voiceDuration":7.785351473922902,"telop":"「それと藤原さんは、今学園内で流れている情報の真意を確かめるので、朝礼後、速やかに職員室を訪ねるように。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","id":"E6172AFB-23D3-4FA9-B62A-444CC4EFBCA8","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.014.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_東風谷早苗.wav","title":"シーン 14","seVolume":1,"animationName":"なし","voiceCharacter":"東風谷早苗"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"東風谷早苗","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第15スライド","voiceDuration":4.300090702947846,"telop":"「今日の連絡は以上です。今日も1日、勉学を励みましょう。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","id":"440A3F47-69A1-40D3-BE01-3F6B80AE386B","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.015.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_東風谷早苗.wav","title":"シーン 15","seVolume":1,"animationName":"なし","voiceCharacter":"東風谷早苗"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.3,"slideTitle":"第16スライド","voiceDuration":6.699546485260771,"telop":"彼女はそういうと、去っていた。\n僕は、きょとんとしながら、ふと我に帰り、職員室に向かう。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"79858C26-C4D6-40E5-A360-F8B02D2936CB","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.016.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","title":"シーン 16","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第17スライド","voiceDuration":3.7756462585034014,"telop":"そして、僕が職員室に来ると、ある女性がやってくる。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"FDC0885F-DA95-4FCF-A622-1CB0C3176F44","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.017.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","title":"シーン 17","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.1000000000000005,"slideTitle":"第18スライド","voiceDuration":6.727891156462585,"telop":"「藤原さん、早速ですが、別室に移動して、あなたの話を聞かせてもらうので、私の後についてきてください。」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"A3CD8C1A-0D63-4179-8719-A53E63C29F52","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.018.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_十六夜咲夜.wav","title":"シーン 18","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第19スライド","voiceDuration":3.0267346938775512,"telop":"僕がそう言われ、やってきたのは被服室だった。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"421F87C9-E531-417B-B8DC-47B28FE9B1EB","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.019.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","title":"シーン 19","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第20スライド","voiceDuration":2.8357823129251702,"telop":"「それで、こないだの体力テスト、どうでしたか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"F46511B6-42BA-4960-86F1-5D1D3F312C7B","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.020.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_十六夜咲夜.wav","title":"シーン 20","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第21スライド","voiceDuration":3.4984580498866213,"telop":"「えっと…僕に取っては、負荷が大きいテストでした…。」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"8FCD182F-7ADD-4E9B-889C-91C86BEA14C9","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.021.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","title":"シーン 21","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第22スライド","voiceDuration":2.9520861678004535,"telop":"「そうですか…それで、どこまでの記憶がありますか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"05C758C6-0923-46C4-9FAD-C6AD89CCED73","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.022.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_十六夜咲夜.wav","title":"シーン 22","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第23スライド","voiceDuration":3.4430385487528343,"telop":"「確か…グラウンドを全力疾走したところまでです…」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"11D342C1-427D-48D6-88CA-DD5817725232","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.023.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","title":"シーン 23","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第24スライド","voiceDuration":3.3261904761904764,"telop":"「それで、次に目が覚めた時、あなたはどこにいましたか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"FD4D8569-8016-4906-BDB6-95C814AFCED9","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.024.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_十六夜咲夜.wav","title":"シーン 24","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第25スライド","voiceDuration":1.2821541950113378,"telop":"「家の寝室です…」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"B1E1AE1B-C274-42E0-86D7-64D130F431DD","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.025.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","title":"シーン 25","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第26スライド","voiceDuration":3.1115873015873015,"telop":"「ちなみに、その間の記憶は、まったくありませんか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"59DB87A6-1549-4300-9808-6F6BBFC19411","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.026.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_十六夜咲夜.wav","title":"シーン 26","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第27スライド","voiceDuration":3.188684807256236,"telop":"「ええ…、でも僕は、ある意味、慣れっこですよ…」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"6FF370D0-5563-4400-9A6D-B4C4A407A8D5","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.027.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","title":"シーン 27","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第28スライド","voiceDuration":1.0293877551020407,"telop":"「そう言える理由は？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"AABE5A46-70DE-431C-8379-920C79B0E447","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.028.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_十六夜咲夜.wav","title":"シーン 28","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.8000000000000003,"slideTitle":"第29スライド","voiceDuration":5.5495464852607705,"telop":"「その内容話すと、少なくとも1時間は必要ですけど、\nそれでも聞きたいですか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"188428E8-648B-471E-BF34-0106817FC530","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.029.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","title":"シーン 29","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第30スライド","voiceDuration":4.160680272108843,"telop":"「ええ、あなたの心身にかかる事柄ですから、\nぜひ、聞かせてください。」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"549E1403-B385-4771-A853-8E9EE247ABDC","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.030.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_十六夜咲夜.wav","title":"シーン 30","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第31スライド","voiceDuration":4.356077097505669,"telop":"僕は、彼女の意思を確認すると、過去を思い返しながら話す。","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"9947F76A-A66E-4401-8F9D-A613C4033D28","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.031.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","title":"シーン 31","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第32スライド","voiceDuration":3.3903854875283446,"telop":"「それで、あなたはこの学校に転校して、良かったですか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"C529D5EF-8562-481B-9319-1FCC990FE759","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.032.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_十六夜咲夜.wav","title":"シーン 32","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.5,"slideTitle":"第33スライド","voiceDuration":8.435419501133786,"telop":"「ええ、前の学校と比べると、かなり良いです。母に、母の母校に転校したいと言って、良かったと僕は思っています。」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"88098E31-8230-4385-8CC0-EFF56BA6B299","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.033.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","title":"シーン 33","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.7,"slideTitle":"第34スライド","voiceDuration":6.837482993197279,"telop":"「そうですか…、ところで話の節々から、あなたの記憶には、欠けているところがありますが、何か心当たりはありますか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"726D4D02-8985-4AC8-B610-17AF354B8560","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.034.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_十六夜咲夜.wav","title":"シーン 34","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.6000000000000005,"slideTitle":"第35スライド","voiceDuration":8.410430839002268,"telop":"「…正直に言って分からないです。小さかった頃は、それこそ些細な違いで、記憶が欠け始めたのは、中学からですから…」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"7693E94A-8978-4FB0-83DD-1598117EFCEA","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.035.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","title":"シーン 35","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.6000000000000005,"slideTitle":"第36スライド","voiceDuration":7.962607709750567,"telop":"「…ただ、証拠を出せというのなら、僕のこの身体が、それを示してます…、正直にいうと人様には見せたくないですが…」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"C905FCC3-B61E-404D-8D5C-C8CF9F8BF3DD","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.036.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","title":"シーン 36","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.7,"slideTitle":"第37スライド","voiceDuration":7.084580498866213,"telop":"「そうですか…。ところで、あなたは、この間の模試を受けている時の様子と、午後の1500m走の様子を見たいですか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"5A3F0286-DBEE-4B7C-8EFC-8DF20855C5F2","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.037.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_十六夜咲夜.wav","title":"シーン 37","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第38スライド","voiceDuration":4.421292517006803,"telop":"「えっ？」僕は、彼女の急な質問に、そう返してしまう。","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"608D4CD1-FF3A-48C5-B54C-BFED67F10986","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.038.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","title":"シーン 38","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5,"slideTitle":"第39スライド","voiceDuration":5.884897959183673,"telop":"「もし、見たいのなら、教員用のPCにデータが保存されているので、お見せできますが…、どうしますか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"7F019226-FC93-4F7A-8D97-5A9837134AB1","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.039.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_十六夜咲夜.wav","title":"シーン 39","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.800000000000001,"slideTitle":"第40スライド","voiceDuration":8.561519274376417,"telop":"「えっと…」僕はふと迷う。確かに、こないだの気を失っている間に、自分が何をしてかを見たいが、見たくない気持ちもある。","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"F7641120-7B48-4EB4-8485-D0C97A7D29F5","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.040.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","title":"シーン 40","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":3.5,"slideTitle":"第41スライド","voiceDuration":3.7039002267573697,"telop":"「いや、いいです…」僕は、それから彼女にそう返す。","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_soumu","id":"292BDDD0-FC3F-494B-B89C-70250C8E451D","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.041.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","title":"シーン 41","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","duration":5.4,"slideTitle":"第42スライド","voiceDuration":6.8395918367346935,"telop":"「そうですか…、最後に一つだけ、こないだ渡した例の遠足に関する条件ですが、無事に満たしましたよ、では失礼。」","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（微笑）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"E4F2C1C5-26B4-4C75-8F58-89635151DC42","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.042.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_十六夜咲夜.wav","title":"シーン 42","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.7,"slideTitle":"第43スライド","voiceDuration":8.461519274376418,"telop":"彼女はそういうと、部屋をさっていった。僕は、ゆっくりと立ちあがろうとすると、突如として頭痛が走り、床に崩れ落ちる。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"2F3AE058-08D2-49C2-8A5A-64E569566E40","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.043.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","title":"シーン 43","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"十六夜咲夜","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","duration":3.9000000000000004,"slideTitle":"第44スライド","voiceDuration":5.049297052154195,"telop":"そして、僕の様子を見に戻ってきた彼女を、\n一瞬見ると、そのまま気を失うのだった。","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（驚く）.png","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"7615E4D0-9351-4EFF-AE87-9BDFBF0734BF","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.044.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_十六夜咲夜.wav","title":"シーン 44","seVolume":1,"animationName":"なし","voiceCharacter":"十六夜咲夜"},{"voiceStartTimeOffset":0,"seStartTimeOffset":0,"transitionName":"なし","characterName":"ナレーション","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":2,"slideTitle":"第45スライド","telop":"彼がふと気がつくと…","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"id":"AC6605DC-03FD-4D28-AB27-AB7F0B6DC788","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.045.jpeg","title":"シーン 45","seVolume":1,"animationName":"なし","bgmVolume":0.65},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.8000000000000003,"slideTitle":"第46スライド","voiceDuration":5.811519274376417,"telop":"僕はふと気がつくと、そこはトイレだった。\nそして、手を洗ってから、トイレを出る。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"4D55CE2C-4296-42CB-A365-60640A4DDDE4","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.046.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","title":"シーン 46","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.4,"slideTitle":"第47スライド","voiceDuration":8.458253968253969,"telop":"そして、学校の廊下を歩いているときに、ふと午後は、全校集会だったことを思い出す。そして、僕は体育館に向かう。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"3051F518-2056-4DFF-9A9D-640D0D910533","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.047.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","title":"シーン 47","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.5,"slideTitle":"第48スライド","voiceDuration":8.357165532879819,"telop":"僕が体育館に来ると、すでにほとんどの生徒や児童が集まっているようだった。僕は、ふと周りを見渡し、ある列に入る。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"864C24DC-0199-4851-B16B-529208F97CBE","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.048.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","title":"シーン 48","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第49スライド","voiceDuration":3.9658503401360545,"telop":"それから、数時間の間、遠足の説明を聞くのだった。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"7361223B-145D-4726-B5AA-B218FF656EDB","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.049.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","title":"シーン 49","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"voiceStartTimeOffset":0,"seStartTimeOffset":0,"transitionName":"なし","characterName":"ナレーション","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":2,"slideTitle":"第50スライド","telop":"説明会が終わり…","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"id":"EEA5EC0B-B1FA-4A9C-92C6-45784E595AF2","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.050.jpeg","title":"シーン 50","seVolume":1,"animationName":"なし","bgmVolume":0.65},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第51スライド","voiceDuration":4.50390022675737,"telop":"説明会が終わると、各自が教室に戻り、担任が入ってくる。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"BCAA1EB0-7F8B-4346-AA2B-80645181F8AA","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.051.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","title":"シーン 51","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.800000000000001,"slideTitle":"第52スライド","voiceDuration":7.766938775510204,"telop":"僕は、朝と同じように礼と挨拶をして、数分程度の短い週例を終えると、そのまま、学校の校門に向かう。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"BB7FC996-F490-4091-8C04-FAD40EDD82BE","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.052.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","title":"シーン 52","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.5,"slideTitle":"第53スライド","voiceDuration":7.132154195011338,"telop":"僕が、学校の校門に来ると、ある車が門の前に止まっていた。\nすると、中からフランが降りてくる。","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","id":"0B5D90ED-869C-476E-BB25-EC66308C1CA2","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.053.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","title":"シーン 53","seVolume":1,"animationName":"なし","voiceCharacter":"操夢"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"フランドール・スカーレット","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第54スライド","voiceDuration":5.198231292517007,"telop":"「学校、お疲れ様、紅夢。とりあえず、車に乗って。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"EF59E063-AB52-4591-A814-9D2ADB5FF610","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.054.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav","title":"シーン 54","bgmStartTimeOffset":0,"seVolume":1,"animationName":"なし","voiceCharacter":"フランドール・スカーレット"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"フランドール・スカーレット","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.9,"slideTitle":"第55スライド","voiceDuration":8.954489795918366,"telop":"僕は、彼女にそう言われ、車に乗ると、数十分で高速に入る。\n「あの、フランさん、どこに行くのですか？」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"1170AD1D-8B06-45C5-AB43-1214490894DD","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.055.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_フランドール・スカーレット.wav","title":"シーン 55","seVolume":1,"animationName":"なし","voiceCharacter":"フランドール・スカーレット"},{"bgmVolume":0.65,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"transitionName":"なし","characterName":"フランドール・スカーレット","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"第56スライド","voiceDuration":2.6419954648526076,"telop":"「それは、向こうに着くまで秘密。」","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"2B894510-E9DA-4A79-98E1-E282F8359763","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第14話_98916fb233\/元女子校の日常　第14話_98916fb233.056.jpeg","voiceAudioPath":"\/Us