[{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"僕たちは、それから話し合いを進めているうちに、すでに日が暮れ、夜になっていた。ふと時計を見ると、夜の6時過ぎだった。\n東方Project二次創作作品","duration":9.181065759637187,"voiceDuration":8.581065759637188,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.001.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #1","audioTrack":"track_voice_soumu","id":"CA378C78-68F5-41FF-BD65-4B6B88CD16CD","animationName":"なし","title":"シーン 1","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"「それで、これで遠足のプランはバッチリですか？」\n私は、話の流れで、班長になり、皆にそう尋ねる。\n作成者：zuyasi","duration":6.789115646258503,"voiceDuration":6.189115646258504,"voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.002.jpeg","voiceCharacter":"アリス・マーガトロイド","seVolume":1,"slideTitle":"スライド #2","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","id":"8B8D891D-11E4-40D8-B1E0-3A1BD63F400F","animationName":"なし","title":"シーン 2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_アリス・マーガトロイド.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"「僕は、このプランでいいと思います。」","duration":3.049546485260771,"voiceDuration":2.449546485260771,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.003.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #3","audioTrack":"track_voice_soumu","id":"B70054E3-D215-4368-99C5-4E6C5FC8A7A0","animationName":"なし","title":"シーン 3: 「僕は、このプランでいいと思います。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"「私も、紅夢さんの意見に同感です。」\n制作ソフト及び協力\nGemini\nTohoStuido","duration":2.8521995464852608,"voiceDuration":2.2521995464852607,"voiceStartTimeOffset":0,"characterName":"古明地さとり","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.004.jpeg","voiceCharacter":"古明地さとり","seVolume":1,"slideTitle":"スライド #4","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","id":"40C9B4AA-F27D-4091-9F25-7CDA82D62951","animationName":"なし","title":"シーン 4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地さとり.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"「私も同じ。」","duration":2.5,"voiceDuration":1.5,"voiceStartTimeOffset":0,"characterName":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.005.jpeg","voiceCharacter":"古明地こいし","seVolume":1,"slideTitle":"スライド #5","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","id":"864A60D2-BE6F-4222-BEE8-7E1310A1BA3F","animationName":"なし","title":"シーン 5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"「では、先に失礼しますね…」","duration":2.5,"voiceDuration":1.7403628117913832,"voiceStartTimeOffset":0,"characterName":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.006.jpeg","voiceCharacter":"アリス・マーガトロイド","seVolume":1,"slideTitle":"スライド #6","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","id":"D1DFBAD5-0BA9-4152-B863-E40E6B62EACC","animationName":"なし","title":"シーン 6","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_アリス・マーガトロイド.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"アリスさんはそういうと、帰って行った。「この教室の戸締り…、僕がするので、二人は帰っていいですよ。」","duration":7.487596371882086,"voiceDuration":6.887596371882086,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.007.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #7","audioTrack":"track_voice_soumu","id":"F4D0F884-0EB1-4AC6-B1C8-4EF11CD2B938","animationName":"なし","title":"シーン 7","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"「分かりました…、じゃあお先に失礼します…」","duration":2.77859410430839,"voiceDuration":2.17859410430839,"voiceStartTimeOffset":0,"characterName":"古明地さとり","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.008.jpeg","voiceCharacter":"古明地さとり","seVolume":1,"slideTitle":"スライド #8","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","id":"A493BC47-73CE-40BC-8502-43901D217FD8","animationName":"なし","title":"シーン 8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_古明地さとり.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc378788_文化系の部室（夜・照明ON）.jpg","telop":"そして、僕は、ただ一人残されたこの部屋で、息を吐く。そして、一度だけ深呼吸を済ますと、戸締りをして、家に帰るのだった。","duration":10.00281179138322,"voiceDuration":9.40281179138322,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.009.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #9","audioTrack":"track_voice_soumu","id":"78F44A10-4936-4AA5-9DE2-2C2DA573A97E","animationName":"なし","title":"シーン 9","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"単色背景","telop":"元女子校の日常","duration":3,"voiceStartTimeOffset":0,"characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.010.jpeg","seVolume":1,"slideTitle":"スライド #10","id":"726F39A2-3F1E-4A9E-9713-28A96616B50A","animationName":"なし","title":"シーン 10: 東方Project二次創作作品　Powerd By zuyasi"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc235080_家（夜・灯りなし）.jpg","telop":"僕はそれから、家に着くと、誰も家にいないことに気づく。\n「母さんと父さんはどうしたんだろう…。」","duration":6.816938775510204,"voiceDuration":6.216938775510204,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.011.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #11","audioTrack":"track_voice_soumu","id":"FA3A3893-88E2-499F-8A5E-14ABE65EBACC","animationName":"なし","title":"シーン 11","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc235080_家（夜・灯りなし）.jpg","telop":"僕はそう呟きながら、家の玄関を鍵を使って開ける。","duration":4.262607709750567,"voiceDuration":3.6626077097505667,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.012.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #12","audioTrack":"track_voice_soumu","id":"C3A5FCEA-93B6-4509-BBFB-33F84EE2B6E4","animationName":"なし","title":"シーン 12","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244644_家の玄関ホール（夜・照明OFF）.jpg","telop":"そして、暗い玄関口に入ると、扉に鍵をかけて、自室に向かう。","duration":5.469115646258503,"voiceDuration":4.8691156462585035,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.013.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #13","audioTrack":"track_voice_soumu","id":"E788175A-9277-49E1-8A1B-F339AE98D538","animationName":"なし","title":"シーン 13","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"一人部屋３（夜・照明ON）.jpg","telop":"僕はそれから、自室に入り、電気をつける。\nそして、荷物を下ろすと、そのままリビングに向かう。","duration":7.375646258503401,"voiceDuration":6.775646258503401,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.014.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","slideTitle":"スライド #14","audioTrack":"track_voice_soumu","id":"CF24928A-0AC4-4280-A834-869A0FE812FA","animationName":"なし","title":"シーン 14","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕が、リビングに来ると、食卓の上に、メモ書きがあった。そこには、帰りが遅いから、一人で夕飯を済ますようにとあった。","duration":9.423469387755102,"voiceDuration":8.823469387755102,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.015.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","slideTitle":"スライド #15","audioTrack":"track_voice_soumu","id":"4E9E484E-6BD8-4CF7-A8CA-9C969CE66EEB","animationName":"なし","title":"シーン 15","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そして、ふと冷蔵庫を開けて、中身を見る。\n中身は、朝見た通り、スカスカになっていた。","duration":7.010430839002267,"voiceDuration":6.4104308390022675,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.016.jpeg","voiceCharacter":"操夢","seVolume":0.85,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","seName":"SE: 冷蔵庫を開ける","slideTitle":"スライド #16","audioTrack":"track_voice_soumu","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/冷蔵庫を開ける.mp3","id":"5686BED5-B1AD-4B39-8302-4D38D77DBF5F","animationName":"なし","title":"シーン 16","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕は、冷蔵庫の扉を閉めると、上の棚を開ける。\n普段なら常備しているインスタント食品もないようだった。","duration":7.850634920634921,"voiceDuration":7.250634920634921,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.017.jpeg","voiceCharacter":"操夢","seVolume":0.85,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","seName":"SE: 冷蔵庫を閉める","slideTitle":"スライド #17","audioTrack":"track_voice_soumu","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/冷蔵庫を閉める.mp3","id":"668E55D6-36B1-4203-B23F-69E462AD53AA","animationName":"なし","title":"シーン 17","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":3.49,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕は、上の棚を閉めると、どうするか悩む。\nすると、インターホンが鳴る。","duration":5.847369614512472,"voiceDuration":5.247369614512472,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.018.jpeg","voiceCharacter":"操夢","seVolume":0.85,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","seName":"SE: ドアチャイム2","slideTitle":"スライド #18","audioTrack":"track_voice_soumu","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアチャイム2.mp3","id":"9CC61E3A-B586-4F7C-8650-4ABECC89AAB0","animationName":"なし","title":"シーン 18","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"僕は、玄関の電気をつけて、扉を開ける。すると、刀を携えた女性が、入ってくる。「あの、どんな用でしょうか？」","duration":9.48,"voiceDuration":8.88,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.019.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #19","audioTrack":"track_voice_soumu","id":"8148C8FA-3DBE-4127-B4F9-B91B3510F879","animationName":"なし","title":"シーン 19","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"すると、彼女はある手帳を取り出し、見せる。\nそこには、警察の紋章があった。「えっと…」","duration":7.232154195011337,"voiceDuration":6.632154195011338,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.020.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #20","audioTrack":"track_voice_soumu","id":"43E15818-074E-4CC6-9464-217425BAC54F","animationName":"なし","title":"シーン 20","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「私は、武蔵警察署の魂魄妖夢と申します。\n実は、急用でお伺いしたいことがございまして…」","duration":6.4681179138322,"voiceDuration":5.8681179138322,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.021.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #21","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"8631F0CD-1378-4D29-BABE-B4F0B78A3BCE","animationName":"なし","title":"シーン 21","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"彼女はそう言いながら、ある写真を見せる。\nそれは…、母の友人である魔理沙さんの写真だった。","duration":6.80063492063492,"voiceDuration":6.20063492063492,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.022.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #22","audioTrack":"track_voice_soumu","id":"D5DF9E44-F723-478E-9BDD-00373563919F","animationName":"なし","title":"シーン 22","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「この人物をご存知ですか？」","duration":2.5,"voiceDuration":1.5535374149659864,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.023.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #23","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"B73C1C1B-030B-49F7-8B38-605B447255FC","animationName":"なし","title":"シーン 23","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「ええ、母の友人ですが…」","duration":2.5604308390022674,"voiceDuration":1.9604308390022676,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.024.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #24","audioTrack":"track_voice_soumu","id":"C103F7DC-8AD0-415C-AEC6-BF311648629D","animationName":"なし","title":"シーン 24","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「あなたの母親の名前を伺ってもよろしいでしょうか？」","duration":3.3016553287981862,"voiceDuration":2.701655328798186,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.025.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #25","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"6FDF9F4C-5977-43D8-997F-ADBF37E9AE7E","animationName":"なし","title":"シーン 25","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「博麗霊夢です…」","duration":2.5,"voiceDuration":1.5,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.026.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #26","audioTrack":"track_voice_soumu","id":"40A6EF63-7D08-4AD1-AD17-39D0E6DE901D","animationName":"なし","title":"シーン 26","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「そうですか、今朝、あなたが母親の様子を\n見ていて気がかりなことはありましたか？」","duration":5.0515419501133785,"voiceDuration":4.451541950113379,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.027.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #27","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"41FCE441-7DEA-4762-AEAE-99B56476D12A","animationName":"なし","title":"シーン 27","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"僕は、彼女にそう言われ、今朝のことを思い出す…","duration":3.8952154195011337,"voiceDuration":3.2952154195011336,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.028.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #28","audioTrack":"track_voice_soumu","id":"27315391-EB1B-428C-8639-B780F370FF06","animationName":"なし","title":"シーン 28","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（日中）.jpeg","telop":"「どうしたの、母さん、そんな顔して。」","duration":3.30390022675737,"voiceDuration":2.7039002267573697,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.029.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","slideTitle":"スライド #29","audioTrack":"track_voice_soumu","id":"538C4B32-2BAE-4844-935E-19F33E27E099","animationName":"なし","title":"シーン 29","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（日中）.jpeg","telop":"「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」","duration":9.443242630385488,"voiceDuration":8.843242630385488,"voiceStartTimeOffset":0,"characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.030.jpeg","voiceCharacter":"博麗霊夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","slideTitle":"スライド #30","audioTrack":"track_voice_reimu","id":"AA9C9280-2722-4414-A0E0-70A3D25D9BC9","animationName":"なし","title":"シーン 30","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_博麗霊夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（日中）.jpeg","telop":"「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」","duration":8.695215419501134,"voiceDuration":8.095215419501134,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.031.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","slideTitle":"スライド #31","audioTrack":"track_voice_soumu","id":"8E0D1C4C-1C2D-4417-9ED7-0EC747A065C2","animationName":"なし","title":"シーン 31","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（日中）.jpeg","telop":"「それじゃあ、行ってくるわ…」","duration":2.8344897959183672,"voiceDuration":2.234489795918367,"voiceStartTimeOffset":0,"characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.032.jpeg","voiceCharacter":"博麗霊夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","slideTitle":"スライド #32","audioTrack":"track_voice_reimu","id":"5CFE3DA2-FD70-490D-B6DF-8280F47C2052","animationName":"なし","title":"シーン 32","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_博麗霊夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「今朝、テレビで母が、友人が赤信号を横断していたというニュースを見ていて、不安だから見てくると言ってました…」","duration":7.9778231292517,"voiceDuration":7.3778231292517,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.033.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #33","audioTrack":"track_voice_soumu","id":"E0CC1F9E-7821-41B7-8F82-816B32064CE3","animationName":"なし","title":"シーン 33","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「ほう…そうでしたか。それ以外には何かありましたか？」","duration":3.7522902494331065,"voiceDuration":3.1522902494331064,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.034.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #34","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"97037F1E-4B14-4B82-B965-F835697E95D6","animationName":"なし","title":"シーン 34","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「あとは、帰りが遅くなると書かれたメモ書きくらいしか…」","duration":4.134331065759637,"voiceDuration":3.534331065759637,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.035.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #35","audioTrack":"track_voice_soumu","id":"75F1D246-D542-49D8-902F-0425AAA74766","animationName":"なし","title":"シーン 35","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「そうですか。それで、あなたの父親はどんな様子でしたか？」","duration":4.037482993197279,"voiceDuration":3.437482993197279,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.036.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #36","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"97424590-7614-4EFA-B123-6ECA72B569DA","animationName":"なし","title":"シーン 36","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「父は、僕が起きた時には、すでにいませんでした。」","duration":4.164761904761905,"voiceDuration":3.564761904761905,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.037.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #37","audioTrack":"track_voice_soumu","id":"626BFCCA-B12A-40A5-B07D-B9E063A35DBC","animationName":"なし","title":"シーン 37","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「そうですか…。承知しました。\nそれで、何かご要望はありますか？」","duration":4.633945578231292,"voiceDuration":4.033945578231292,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.038.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #38","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"C2060026-BB04-4371-85DE-E6FD5037F63B","animationName":"なし","title":"シーン 38","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「要望ですか…？」","duration":2.5,"voiceDuration":1.5,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.039.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #39","audioTrack":"track_voice_soumu","id":"0DD04D29-8A7B-4E1A-9768-451B33A959C6","animationName":"なし","title":"シーン 39","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「ええ、私について来てくださるのなら、署にいるあなたの母親と話すこともできますが？どうしますか？」","duration":6.345827664399093,"voiceDuration":5.745827664399093,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.040.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #40","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"029146C1-F904-4CCC-9CED-75EE0EF76DF2","animationName":"なし","title":"シーン 40","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「いえ…大丈夫です…」","duration":2.5,"voiceDuration":1.556077097505669,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.041.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #41","audioTrack":"track_voice_soumu","id":"D5A2E1A1-F953-46F7-9887-D0E627493F9F","animationName":"なし","title":"シーン 41","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「それと、最後に一つだけ、お伺いしてもよろしいですか？」","duration":3.8662358276643993,"voiceDuration":3.2662358276643992,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.042.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #42","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"5471995A-1367-4817-B58F-74751D890064","animationName":"なし","title":"シーン 42","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「どんなことですか？」","duration":2.5,"voiceDuration":1.5,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.043.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #43","audioTrack":"track_voice_soumu","id":"A5ED446D-2401-42C8-8DBF-298F0879F540","animationName":"なし","title":"シーン 43","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「あなたは、魔理沙さんのここ\n最近の様子について知ってますか？」","duration":3.9051927437641725,"voiceDuration":3.3051927437641724,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.044.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #44","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"3D9EB242-7C69-41F8-A4C2-65E2CBC7D6A6","animationName":"なし","title":"シーン 44","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「えっと…、特にはないです…」","duration":2.5,"voiceDuration":1.8615192743764173,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.045.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #45","audioTrack":"track_voice_soumu","id":"EC14CA56-1532-4AD8-98F9-492D11EB78AD","animationName":"なし","title":"シーン 45","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"「承知しました。突如の訪問にご対応いただきありがとうございました。これにて、私は失礼致します。」","duration":6.759160997732426,"voiceDuration":6.159160997732426,"voiceStartTimeOffset":0,"characterName":"魂魄妖夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.046.jpeg","voiceCharacter":"魂魄妖夢","seVolume":1,"slideTitle":"スライド #46","audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","id":"2EF1C30F-E3E3-45FE-AC78-FF74441ACD1E","animationName":"なし","title":"シーン 46","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_魂魄妖夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc244643_家の玄関ホール（夜・照明ON）.jpg","telop":"彼女はそういうと、去っていった。\n僕は、ひとまず、リビングに戻る。","duration":5.52673469387755,"voiceDuration":4.926734693877551,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.047.jpeg","voiceCharacter":"操夢","seVolume":1,"slideTitle":"スライド #47","audioTrack":"track_voice_soumu","id":"BA3983B0-5E09-4861-A926-4F616CCC5C16","animationName":"なし","title":"シーン 47","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そして、食卓に座るとテレビをつける。\n僕は、その映像を見ているうちに、全身に痛みが走る。","duration":7.488684807256235,"voiceDuration":6.888684807256236,"voiceStartTimeOffset":0,"characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.048.jpeg","voiceCharacter":"操夢","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","slideTitle":"スライド #48","audioTrack":"track_voice_soumu","id":"B01EA0FE-C08C-4DD3-8B79-FC00EDB29EFF","animationName":"なし","title":"シーン 48","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そこには、ある女性が、街中にビームを撃ちまくる映像と、彼女との戦いに負けたのか、警察署で休む母が映っていた。","duration":9.093038548752833,"voiceDuration":8.493038548752834,"voiceStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.049.jpeg","voiceCharacter":"ナレーション","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","slideTitle":"スライド #49","audioTrack":"track_voice__E5E7","id":"DE59CF4A-748B-4B62-AAFC-F5B4817891BD","animationName":"なし","title":"シーン 49","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_ナレーション.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"今、テレビで流れている映像を見ると、父とその女性が戦っている様子が流れていたが、父はビームを避けているだけだった。","duration":8.62673469387755,"voiceDuration":8.02673469387755,"voiceStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.050.jpeg","voiceCharacter":"ナレーション","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","slideTitle":"スライド #50","audioTrack":"track_voice__E5E7","id":"CBC849F4-CDAE-4CE9-96CA-067CF057BD28","animationName":"なし","title":"シーン 50","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_ナレーション.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"きっと彼が、この映像をしっかりと目に焼き付ければ、冷静に考えて、母が映っていた警察署に向かうだろう。","duration":7.890861678004534,"voiceDuration":7.290861678004535,"voiceStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.051.jpeg","voiceCharacter":"ナレーション","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","slideTitle":"スライド #51","audioTrack":"track_voice__E5E7","id":"0DE7EC94-6B8D-4550-8EAD-EBB2F54A8AE1","animationName":"なし","title":"シーン 51","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_ナレーション.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私は、どうすればいいのかな…」っと、そう呟きながら、ある覚悟を決め、準備を済ませると、その場所に向かった。","duration":8.721292517006802,"voiceDuration":8.121292517006802,"voiceStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.052.jpeg","voiceCharacter":"ナレーション","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","slideTitle":"スライド #52","audioTrack":"track_voice__E5E7","id":"B6343656-C93F-48E8-B81A-AD9E52420B44","animationName":"なし","title":"シーン 52","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_ナレーション.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"単色背景","telop":"その頃、ある場所では…","duration":3,"voiceStartTimeOffset":0,"characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.053.jpeg","seVolume":1,"slideTitle":"スライド #53","id":"B2FF3481-CCA0-469B-B20E-CBFD40093901","animationName":"なし","title":"シーン 53: その頃、ある場所では…"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"私は、ふと部屋にある小さなテレビを見ていると、とある街中の生中継映像が流れた。私は、思わず、その映像に目を見張る。","duration":11.299478458049887,"voiceDuration":10.699478458049887,"voiceStartTimeOffset":0,"characterName":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.054.jpeg","voiceCharacter":"フランドール・スカーレット","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301379_一人部屋２（夜・照明ON）.jpg","slideTitle":"スライド #54","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"B617D141-3FA1-4728-BD58-C3356DDA4478","animationName":"なし","title":"シーン 54","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"その映像は、ビームを撃ち続ける女性と、それを避ける男性の様子が映されていた。そして、私は、ふと画面を注視する。","duration":10.464489795918366,"voiceDuration":9.864489795918367,"voiceStartTimeOffset":0,"characterName":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.055.jpeg","voiceCharacter":"フランドール・スカーレット","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_e