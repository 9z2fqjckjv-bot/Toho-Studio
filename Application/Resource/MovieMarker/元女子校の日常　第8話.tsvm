3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"461BF544-DCDA-4E48-A68A-5C0EA175BE12","animationName":"なし","title":"シーン 57","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_フランドール・スカーレット.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「どうしたのよ、フラン。そんな驚いた表情をして。」\n私は、そう妹に尋ねる。","duration":6.560907029478457,"voiceDuration":5.960907029478458,"voiceStartTimeOffset":0,"characterName":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.058.jpeg","voiceCharacter":"レミリア・スカーレット","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #58","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"F8CAC76D-76FA-4AFF-9EBE-45C12092445A","animationName":"なし","title":"シーン 58","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_レミリア・スカーレット.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、彼女は衝撃的な内容を語りだす。\n私は、その内容を聞くと、ある人物に電話をかける。","duration":7.646326530612244,"voiceDuration":7.0463265306122445,"voiceStartTimeOffset":0,"characterName":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.059.jpeg","voiceCharacter":"レミリア・スカーレット","seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"スライド #59","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"03C254A4-59F5-4765-91B5-73A939F89060","animationName":"なし","title":"シーン 59","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_レミリア・スカーレット.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"私は、職員室で作業をしていると、突如として電話が鳴る。\n私は、鳴り響く電話の受話器を取るとある声が聞こえた。","duration":7.737482993197278,"voiceDuration":7.1374829931972785,"voiceStartTimeOffset":0,"characterName":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.060.jpeg","voiceCharacter":"十六夜咲夜","seVolume":0.85,"seName":"SE: 電話の着信音","slideTitle":"スライド #60","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/電話の着信音.mp3","id":"BEFBCAEF-BDDD-4177-B47A-71183B5DDC75","animationName":"なし","title":"シーン 60","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_十六夜咲夜.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"「お嬢様、その慌てた口調、何かあったんですか？」\n私は、その電話の声…レミリアに尋ねる。","duration":6.70469387755102,"voiceDuration":6.10469387755102,"voiceStartTimeOffset":0,"characterName":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.061.jpeg","voiceCharacter":"十六夜咲夜","seVolume":1,"slideTitle":"スライド #61","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"54C8C4F4-2C42-4B2E-ADD2-0E91D0FF6B87","animationName":"なし","title":"シーン 61","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_十六夜咲夜.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"「咲夜、今すぐテレビをつけなさい。」","duration":2.9171655328798187,"voiceDuration":2.3171655328798186,"voiceStartTimeOffset":0,"characterName":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.062.jpeg","voiceCharacter":"レミリア・スカーレット","seVolume":1,"slideTitle":"スライド #62","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"33CA1EFA-5DED-4C6F-84D9-2AAA6F51A32A","animationName":"なし","title":"シーン 62","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_レミリア・スカーレット.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"私は、お嬢様にそう言われ、テレビをつける。すると、そこには衝撃的な映像が流れていた。「これは、どういうことですか？」","duration":8.219886621315192,"voiceDuration":7.619886621315192,"voiceStartTimeOffset":0,"characterName":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.063.jpeg","voiceCharacter":"十六夜咲夜","seVolume":1,"slideTitle":"スライド #63","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"0E0CD5B4-990C-4DC4-B919-9690A5250E91","animationName":"なし","title":"シーン 63","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_十六夜咲夜.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"「説明している時間は、ないわ。とにかく、その場所に、誰かを急行させて、騒ぎを鎮静化させなさい。そうじゃないと…」","duration":9.121315192743763,"voiceDuration":8.521315192743764,"voiceStartTimeOffset":0,"characterName":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.064.jpeg","voiceCharacter":"レミリア・スカーレット","seVolume":1,"slideTitle":"スライド #64","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","id":"4675B8A0-E865-41CE-AF91-77F5EC28C76C","animationName":"なし","title":"シーン 64","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_レミリア・スカーレット.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"私は、お嬢様からの命令を聞き、\n電話を終えると、ある部屋に電話をかける。","duration":5.0396825396825395,"voiceDuration":4.43968253968254,"voiceStartTimeOffset":0,"characterName":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.065.jpeg","voiceCharacter":"十六夜咲夜","seVolume":1,"slideTitle":"スライド #65","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","id":"CAE7210C-4E6D-4785-9DD7-A62A763BF3ED","animationName":"なし","title":"シーン 65","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_十六夜咲夜.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","telop":"「もしもし、こんな時間に電話をかけて、どうしたんですか？」","duration":3.187074829931973,"voiceDuration":2.587074829931973,"voiceStartTimeOffset":0,"characterName":"美鈴","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第8話_71b0ab1c5a\/元女子校の日常　第8話_71b0ab1c5a.066.jpeg","voiceCharacter":"美鈴","seVolume":1,"slideTitle":"スライド #66","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","id":"4AFC239B-0FC8-4CC3-8381-954F86D0113C","animationName":"なし","title":"シーン 66","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_美鈴.wav"},{"transitionName":"なし","seStartTimeOffset":0,"backgroundName":"nc253890_学校の職員室（夜・照明ON）.jp