[{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.001.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","voiceDuration":9.112607709750566,"id":"A5FE5B48-88F9-4883-8823-8CCAA17CFAB7","transitionName":"なし","slideTitle":"第1スライド","animationName":"なし","duration":10,"voiceCharacter":"操夢","telop":"僕は、守谷神社を出ると、間欠泉地下センターにある、発電所に来ていた。そして、この部屋に来ると、操作盤から起動する。\n東方Project二次創作作品","title":"シーン 1","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.002.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","voiceDuration":6.35172335600907,"id":"2C05E74D-9516-40C2-BE74-DC66F7FB96D5","transitionName":"なし","slideTitle":"スライド #2","animationName":"なし","duration":6.95172335600907,"voiceCharacter":"操夢","telop":"すると、溜まっていた埃が一気に消えていく。\nそして、同時に目の前にある円球が喋り出す。\n作成者：zuyasi","title":"シーン 2","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.003.jpeg","backgroundName":"単色背景","characterName":"博麗霊夢","voiceDuration":6.993038548752835,"id":"057EE19F-4823-4872-89F5-83F5327CCD48","transitionName":"なし","slideTitle":"スライド #3","animationName":"なし","duration":7.593038548752834,"voiceCharacter":"博麗霊夢","telop":"「GECSを起動中です…。\n起動が完了するまで、もうしばらくお待ちください…」","title":"シーン 3: シーン3","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_博麗霊夢.wav"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.004.jpeg","backgroundName":"単色背景","characterName":"博麗霊夢","voiceDuration":3.6365079365079365,"id":"00614CD1-5A68-446E-B24D-E7BB7F5922F2","transitionName":"なし","slideTitle":"スライド #4","animationName":"なし","duration":4.2365079365079366,"voiceCharacter":"博麗霊夢","telop":"「プログラムが破損しています。自動修復中です…」","title":"シーン 4: シーン4","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_博麗霊夢.wav"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.005.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","voiceDuration":6.247369614512472,"id":"B6393016-C007-420B-A5BA-E01763B50F56","transitionName":"なし","slideTitle":"スライド #5","animationName":"なし","duration":6.847369614512472,"voiceCharacter":"操夢","telop":"その円球がそう告げてから、機械音が鳴り響き始め、\n埃が溜まっていた発電所が動き出す。\n制作ソフト\nKeynote\nTohoStudio","title":"シーン 5","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.006.jpeg","backgroundName":"単色背景","characterName":"博麗霊夢","voiceDuration":8.762607709750567,"id":"21F3AA3D-B168-4617-9A56-E20ACE6D2D5E","transitionName":"なし","slideTitle":"スライド #6","animationName":"なし","duration":9.362607709750566,"voiceCharacter":"博麗霊夢","telop":"「修復処理が終了しました。システムの動作を確認しています…、稼働状況を確認中です…、正常に起動が完了しました。」","title":"シーン 6: シーン6","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_博麗霊夢.wav"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.007.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"ナレーション","voiceDuration":5.25390022675737,"id":"47662F97-6983-4650-9C93-B98FA342490A","transitionName":"なし","slideTitle":"スライド #7","animationName":"なし","duration":5.85390022675737,"voiceCharacter":"ナレーション","telop":"「どのようなご用件か、お申し付けいただくか、\n操作盤から指示を出してください。」","title":"シーン 7","audioTrack":"track_voice__9F71","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_ナレーション.wav"},{"slideTitle":"スライド #8","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.943038548752834,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.008.jpeg","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","transitionName":"なし","audioTrack":"track_voice_soumu","voiceDuration":4.343038548752834,"telop":"僕は、その機械がそういうと、ここに来た目的を果たし始めた。","title":"シーン 8","id":"5099240F-9E50-4814-970C-D1DEB3F519A1","voiceCharacter":"操夢","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"id":"CA5DED63-C480-484B-A9AC-FD934F6C4905","title":"シーン 9: @zuyasi　東方Project二次創作作品","animationName":"バウンス","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.009.jpeg","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第15話_default\/slide_009_anim.m4v","characterName":"","slideTitle":"タイトル","duration":12,"backgroundName":"単色背景","telop":"幼き日の夢","transitionName":"なし"},{"slideTitle":"スライド #10","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.085419501133787,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.010.jpeg","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","transitionName":"なし","audioTrack":"track_voice_soumu","voiceDuration":8.485419501133787,"telop":"僕は、ここに来た目的、とあるミサイルによって破滅してしまった、外の世界にこの幻想郷を広げるための行動を実行した。","title":"シーン 10","id":"23A521A9-CF82-4107-AA5F-B048B928BC90","voiceCharacter":"操夢","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"スライド #11","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.020204081632652,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.011.jpeg","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","transitionName":"なし","audioTrack":"track_voice_soumu","voiceDuration":8.420204081632653,"telop":"僕は、この幻想郷に来る前、ある実験を受けて、生き残ったもので、どうすれば、この世界を救出できるかを話し合った。","title":"シーン 11","id":"B9E86E3F-2A88-4679-9466-0452C05E0C43","voiceCharacter":"操夢","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"スライド #12","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":8.841950113378685,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.012.jpeg","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","transitionName":"なし","audioTrack":"track_voice_soumu","voiceDuration":8.241950113378685,"telop":"その結果、この幻想郷に賭けるしかないという結論に至り、当時、子どもの状態で実験を受けた僕が、派遣された。","title":"シーン 12","id":"BEBFA9F5-6676-4699-8D5B-23E1DA0FC556","voiceCharacter":"操夢","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"スライド #13","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.187596371882085,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.013.jpeg","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","transitionName":"なし","audioTrack":"track_voice_soumu","voiceDuration":8.587596371882086,"telop":"そして、この別世界で破滅した外の世界を覆い尽くすのが目的だった。そして、今、その目的は達成したと言えるだろう。","title":"シーン 13","id":"FBAF26C5-BCF7-4049-98CA-B9F576FE9397","voiceCharacter":"操夢","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"スライド #14","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.875646258503401,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.014.jpeg","characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","transitionName":"なし","audioTrack":"track_voice_soumu","voiceDuration":7.275646258503401,"telop":"そこで、ふと僕は、あることを思い出す。\nそして、操作盤を用いて、ある指示を、円球に対して出す。","title":"シーン 14","id":"6A65CB2F-9BB5-4FE4-88F5-76DB047E33AC","voiceCharacter":"操夢","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideTitle":"スライド #15","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.9278231292517,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.015.jpeg","characterName":"ナレーション","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_ナレーション.wav","transitionName":"なし","audioTrack":"track_voice__9F71","voiceDuration":7.3278231292517,"telop":"「システムのログを検索中です…、検索結果を絞り込んでいます…、アーカイブを解凍しています…、読み込み中です…」","title":"シーン 15","id":"BCC67868-8C17-47C1-9192-8928B8362FFF","voiceCharacter":"ナレーション","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceDuration":3.349546485260771,"characterName":"ナレーション","id":"1A2F3CD9-DD27-4F14-980D-CAA9F3F61499","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.016.jpeg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_ナレーション.wav","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice__9F71","slideTitle":"スライド #16","animationName":"なし","title":"シーン 16","duration":3.949546485260771,"telop":"「読み込みが完了しました。ログを表示します。」","voiceCharacter":"ナレーション"},{"voiceDuration":8.816938775510204,"characterName":"操夢","id":"4616E5D8-894E-4CFD-88AB-7A2E1C36F95D","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.017.jpeg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideTitle":"スライド #17","animationName":"なし","title":"シーン 17","duration":9.416938775510204,"telop":"僕は、そのログを見て、驚く。図書館で見たときにも、薄々感じていたが、どうやら、ある時点を境に世界が分かれている。","voiceCharacter":"操夢"},{"voiceDuration":8.936507936507937,"characterName":"操夢","id":"B83870A7-1767-4BF6-B715-DDE898785D90","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.018.jpeg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideTitle":"スライド #18","animationName":"なし","title":"シーン 18","duration":9.536507936507936,"telop":"ある時点とは、この施設が機能不全に陥って、発電所が爆発したときだ…、すでにそのときには、幻想郷の住人はいなかった。","voiceCharacter":"操夢"},{"voiceDuration":9.364761904761904,"characterName":"操夢","id":"8502B55E-221F-4F62-84FF-E97233E76249","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.019.jpeg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideTitle":"スライド #19","animationName":"なし","title":"シーン 19","duration":9.964761904761904,"telop":"だが、その爆発の後、一度はいなくなったはずの住人が、再び現れている…、今、幻想郷にいる住人は、この爆発を知らない…","voiceCharacter":"操夢"},{"voiceDuration":8.090861678004535,"characterName":"操夢","id":"9FB0F9F5-6CA2-4A0D-8ACF-3D0F86FA60D5","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.020.jpeg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideTitle":"スライド #20","animationName":"なし","title":"シーン 20","duration":8.690861678004534,"telop":"レミリアたちが言っていたが、ある日突然と、ぷつりと切れた記憶の原因が、この爆発にあるのは、決定的だと考えた。","voiceCharacter":"操夢"},{"voiceDuration":7.734331065759637,"characterName":"操夢","id":"72DE0FDE-86DD-4860-93A5-3FC6D97F6486","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.021.jpeg","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","slideTitle":"スライド #21","animationName":"なし","title":"シーン 21","duration":8.334331065759637,"telop":"そうだとしても…、何かがおかしい、この発電所の仕組み上、\n一度爆発してしまえば、生き物は生きられないというのに…","voiceCharacter":"操夢"},{"duration":8.60390022675737,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","id":"A83B9C31-7F9B-473E-98AE-4D416C3FB40E","telop":"「一体、何が起きたというんだ…」僕は、そう呟く。\nすると、その円球が、突如として、喋り始める。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢","slideTitle":"スライド #22","audioTrack":"track_voice_soumu","title":"シーン 22","animationName":"なし","characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.022.jpeg","voiceDuration":8.00390022675737},{"duration":8.4778231292517,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","id":"A913F96B-4180-4E06-82CF-4408403BE4AA","telop":"僕は、その内容に唖然とする。そして、これが事実だという。\nそして、並行世界の片割れがこの世だという。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢","slideTitle":"スライド #23","audioTrack":"track_voice_soumu","title":"シーン 23","animationName":"なし","characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.023.jpeg","voiceDuration":7.8778231292517},{"duration":9.481065759637188,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","id":"1BFEFEE5-8588-42FA-820A-749622CCEF3C","telop":"そして、その内容を僕は、他の幻想郷の住人に、知られることはリスキーだと判断し、機密情報として、ロックするのだった。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢","slideTitle":"スライド #24","audioTrack":"track_voice_soumu","title":"シーン 24","animationName":"なし","characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.024.jpeg","voiceDuration":8.881065759637188},{"duration":3,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1B260C9A-3CF8-481A-A829-CE0BA8B3DAA8","animationDuration":3,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"それから…","transitionName":"なし","slideTitle":"スライド #25","animationNote":"表示時間：3秒","title":"シーン 25","animationName":"なし","characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.025.jpeg"},{"duration":9.495215419501134,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","id":"EE36D88B-A847-4C9D-87CF-CCA54387B9EE","telop":"あれから、どれだけの年月が経っただろうか。あの後僕は、霊夢と共に再建された神社、そして拡大した幻想郷で過ごした。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢","slideTitle":"スライド #26","audioTrack":"track_voice_soumu","title":"シーン 26","animationName":"なし","characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.026.jpeg","voiceDuration":8.895215419501135},{"duration":4.736984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_博麗霊夢.wav","id":"491E8B14-E34E-4AEF-B140-181774A132A6","telop":"「ねぇ、あんた、お賽銭が一向に入らないのだけど…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢","slideTitle":"スライド #27","audioTrack":"track_voice_reimu","title":"シーン 27","animationName":"なし","characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.027.jpeg","voiceDuration":4.136984126984127},{"duration":7.871292517006802,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","id":"B122164C-C05A-41A3-AA10-DDD3CD11B428","telop":"「お金が入らなくてもいいじゃないですか。こうして、二人でいつも通りの平和と、幸せを感じ取れるんだったら。」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢","slideTitle":"スライド #28","audioTrack":"track_voice_soumu","title":"シーン 28","animationName":"なし","characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.028.jpeg","voiceDuration":7.271292517006803},{"duration":7.965736961451247,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_博麗霊夢.wav","id":"8AFCAA20-8189-4FD1-AD7D-B92CE532CD9F","telop":"「確かに、あんたの言うとおりだわ…」\n私はそう言い、彼と共に穏やかな生活を営むのだった。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","slideTitle":"スライド #29","voiceCharacter":"博麗霊夢","audioTrack":"track_voice_reimu","title":"シーン 29","animationName":"なし","characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.029.jpeg","voiceDuration":7.365736961451248},{"id":"1B8D09F0-8912-44CE-AF84-4888B9149288","title":"シーン 30: ご視聴ありがとうございました！","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第15話_3925d2a98d\/第15話_3925d2a98d.030.jpeg","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～.wav","seName":"SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～","characterName":"博麗霊夢","slideTitle":"スライド #30","duration":20,"backgroundName":"単色背景","telop":"ご視聴ありがとうございました！","transitionName":"なし"}]