[{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 1","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第1スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.001.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"東方Project二次創作作品\n「ねぇ…、今、どんな気持ち？」\n私は、そう彼に尋ねる。","transitionName":"クロスディゾルブ","voiceDuration":4.775646258503401,"id":"60B2A4A8-5404-4276-9EB8-06E25F157D09"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 2","duration":4.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第2スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.002.jpeg","voiceCharacter":"操夢","telop":"僕は、彼女にそう問われ、返答方法を考える。\n「僕は…」ふとそう言いかけ、ポッキーの箱を見る。\n作成者：zuyasi","transitionName":"クロスディゾルブ","voiceDuration":7.3408616780045355,"id":"F3BDC6AD-2177-48E4-B6FA-3BBA54897F89"},{"bgmName":"BGM: 東方妖恋談","id":"07C27D56-B4BE-4A2D-B405-74EA38280B60","title":"そこには、普通なら見逃す様な小さな文字で「媚薬とアルコール1%」と描かれていた。それで、僕は彼女の言動に納得する。","telop":"","duration":3,"backgroundName":"単色背景","animationName":"なし","voiceCharacter":"操夢","slideTitle":"中扉","characterName":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.003.jpeg","transitionName":"クロスディゾルブ"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 4","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第4スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.004.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「それで、どう、今の気分は。」\n私はそう彼に聞く。\n作成ソフト\nKeynote\nTohoStudio","transitionName":"クロスディゾルブ","voiceDuration":3.373469387755102,"id":"308D53DB-BA34-4B30-B391-DB8B85B80755"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 5","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第5スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.005.jpeg","voiceCharacter":"操夢","telop":"そして僕は、彼女のその問いかけに、キスで答えた。","transitionName":"クロスディゾルブ","voiceDuration":8.5278231292517,"id":"EBFC1F63-80A6-4E73-9D3C-5D03EB67D6CD"},{"bgmName":"BGM: 東方妖恋談","id":"89F3B16A-3029-4C2A-A54B-97A9BF4B893E","title":"東方Project二次創作作品　powerd by zuyasi","telop":"彷徨う二人　第9話","duration":3,"backgroundName":"単色背景","animationName":"なし","voiceCharacter":"","slideTitle":"タイトル","characterName":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.006.jpeg","transitionName":"クロスディゾルブ"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 7","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"操夢","slideTitle":"第7スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.007.jpeg","voiceCharacter":"操夢","telop":"僕たちはそれから、中央新幹線の\n真下にある巨大な空間、地底園に来ていた。","transitionName":"クロスディゾルブ","voiceDuration":2.940861678004535,"id":"5CB401B0-97DE-4C21-BC37-2F56B7ACE08C"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 8","duration":5.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"操夢","slideTitle":"第8スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.008.jpeg","voiceCharacter":"操夢","telop":"フランは、僕があのキスをした後、そのまま寝落ちしてしまったので、僕は、彼女を背負って、ここに続く階段を降りてきた。","transitionName":"クロスディゾルブ","voiceDuration":4.032154195011338,"id":"7E14687D-946C-44F5-A9F8-1097086A14ED"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 9","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"操夢","slideTitle":"第9スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.009.jpeg","voiceCharacter":"操夢","telop":"僕がしばらく、歩き進んでいると、ここの園長が現れる。","transitionName":"クロスディゾルブ","voiceDuration":8.069115646258503,"id":"0F20C755-8AFD-49B0-8A2A-CA292D6486A7"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 10","duration":4,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"古明地さとり","slideTitle":"第10スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.010.jpeg","voiceCharacter":"古明地さとり","telop":"「あら、いらっしゃい、今日は何用ですか？」\n私はそう言いながら、あることに気づく。","transitionName":"クロスディゾルブ","voiceDuration":4.689591836734694,"id":"5062D03B-42E5-4B15-9850-0917ACCCC14B"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 11","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"古明地さとり","slideTitle":"第11スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.011.jpeg","voiceCharacter":"古明地さとり","telop":"「おや、今日はお連れさんがいるのですか、珍しい…」\n私は、彼が背負っている女性を見ながらそう呟く。","transitionName":"クロスディゾルブ","voiceDuration":10.641995464852608,"id":"C3DA0C3E-993F-465B-8FDD-4BF980CAFBEB"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 12","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"操夢","slideTitle":"第12スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.012.jpeg","voiceCharacter":"操夢","telop":"「それで、どこか空き部屋はありますか？」","transitionName":"クロスディゾルブ","voiceDuration":7.475646258503401,"id":"D0C9AE0C-4C3F-49BE-9FDC-3047847FA37C"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","title":"シーン 13","duration":4.3,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","animationName":"なし","characterName":"古明地さとり","slideTitle":"第13スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.013.jpeg","voiceCharacter":"古明地さとり","telop":"「空き部屋ならありますよ。ついてきてください。」\n私はそう言い、彼を空き部屋に案内する。","transitionName":"クロスディゾルブ","voiceDuration":6.519795918367347,"id":"9EF7D09E-542C-4DD4-9899-75949B3E0938"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 14","duration":4.2,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"古明地さとり","slideTitle":"第14スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_フランドール・スカーレット.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.014.jpeg","voiceCharacter":"古明地さとり","telop":"「ここですよ。それでは、私は失礼しますね。」\n私はそういうと、その部屋から出ていった。","transitionName":"クロスディゾルブ","voiceDuration":5.634489795918367,"id":"32D00EE7-7BEB-4CE5-A33C-5295FB04B575"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 15","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第15スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.015.jpeg","voiceCharacter":"操夢","telop":"僕は、彼女がさると、\n背負っていたフランをそっと、ベッドの上に乗せる。","transitionName":"クロスディゾルブ","voiceDuration":2.7517233560090704,"id":"129A5DD2-E7AE-4360-A9A8-27DC93980832"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 16","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第16スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.016.jpeg","voiceCharacter":"操夢","telop":"すると、フランの目が覚める。","transitionName":"クロスディゾルブ","voiceDuration":2.699546485260771,"id":"0C5C879A-5C2C-4004-9F50-D32DAA152C77"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 17","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第17スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_フランドール・スカーレット.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.017.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「んん…」\n私はふと目が覚めると、そう呟きながら目を擦る。","transitionName":"クロスディゾルブ","voiceDuration":3.7719954648526075,"id":"E32B2748-76A4-44E2-B453-C31BA0A2DE15"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 18","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第18スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.018.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「あれ…ここは…どこ…？」","transitionName":"クロスディゾルブ","voiceDuration":6.190997732426304,"id":"C2FBFC3F-F388-41C0-A1D0-5654507D4673"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 19","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第19スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.019.jpeg","voiceCharacter":"操夢","telop":"「目が覚めましたか。ここは、地底園ですよ。」","transitionName":"クロスディゾルブ","voiceDuration":8.658253968253968,"id":"4BBA9278-E1BD-4860-8B09-E1AACCD58424"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 20","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第20スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_レミリア・スカーレット.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.020.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「地底園...？」","transitionName":"クロスディゾルブ","voiceDuration":3.556734693877551,"id":"2516D823-AD24-43D2-9D94-621EBE6A35ED"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 21","duration":5.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第21スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.021.jpeg","voiceCharacter":"操夢","telop":"「そうです。今から１世紀ほど前に起きたとある大地震とその後に、起こったいくつかの地震で穴が開き、できたんですよ。」","transitionName":"クロスディゾルブ","voiceDuration":7.484331065759637,"id":"D76D397F-C4DF-4ED6-8922-BDA5891FECDA"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 22","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第22スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.022.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「へぇ…」\n私は、そう返すと、お腹が空いてくる。","transitionName":"クロスディゾルブ","voiceDuration":1.4539909297052154,"id":"25E21D14-BB56-471F-A3DE-12375E5399FC"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 23","duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第23スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.023.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「ねぇ…、あなたの血…吸ってもいい？」","transitionName":"クロスディゾルブ","voiceDuration":8.032154195011337,"id":"7DD69A6B-A09E-4B96-A19D-CBCD0C65286A"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 24","duration":5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第24スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.024.jpeg","voiceCharacter":"操夢","telop":"「いいですよ。」僕は、そういうと、ベッドに腰掛ける。\nすると、フランが僕に噛みつき、血が吸われていく。","transitionName":"クロスディゾルブ","voiceDuration":4.345215419501134,"id":"FB59DFF7-4DE0-4856-B055-5F777E91180F"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 25","duration":5.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"操夢","slideTitle":"第25スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.025.jpeg","voiceCharacter":"操夢","telop":"すると、今までうまく押さえ込んでいたあのポッキーの成分が全身を駆け巡る様な感覚にさらされ、数分後には眠りについた。","transitionName":"クロスディゾルブ","voiceDuration":6.164761904761905,"id":"C7F6609B-FA85-4FB4-BC06-02AA2EFD3387"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 26","duration":4.2,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第26スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_古明地こいし.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.026.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"私は、彼の血を吸ううちに、だんだんと何かが崩れていき、\n吸血が終わるとあることを呟く。","transitionName":"クロスディゾルブ","voiceDuration":2.631995464852608,"id":"9CD2CA87-9A1C-43EE-A0AB-791D26A4383C"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 27","duration":5.2,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","characterName":"フランドール・スカーレット","slideTitle":"第27スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_ナレーション.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_9__c776604319\/_9__c776604319.027.jpeg","voiceCharacter":"フランドール・スカーレット","telop":"「えへへへ…、ねぇ…あなたに拒否権はないからね…」\n私は、そういうと、彼を跨ぐようにのると、ある行動に出た。","transitionName":"クロスディゾルブ","voiceDuration":6.988684807256236,"id":"166E41BD-E651-4EAD-9C72-D12D09FBE517"}]