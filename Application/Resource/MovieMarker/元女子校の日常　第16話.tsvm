3.399546485260771,"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"telop":"僕は、そのときの内容と全く同じ内容を、二人話す。","duration":3.5,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","title":"シーン 32","slideTitle":"第32スライド","bgmVolume":0.65,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.032.jpeg","characterName":"操夢","id":"6FA7B619-7293-4163-B6D7-3E07C2966353","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","voiceCharacter":"操夢"},{"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"telop":"「その話は本当なのかしら…、前聞いた時も驚いたけど、まさかそんな陰湿な行為が、あの男子校であったなんて…」","duration":5.300000000000001,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","title":"シーン 33","slideTitle":"第33スライド","bgmVolume":0.65,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.033.jpeg","characterName":"レミリア・スカーレット","id":"690D22BD-F8F2-4C6F-9CC8-55959AB87EAC","voiceCharacter":"レミリア・スカーレット","voiceDuration":3.702562358276644},{"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"telop":"「私たちが学校にいた時は、そんなこと聞いたことないよ…。」","duration":3.5,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","title":"シーン 34","slideTitle":"第34スライド","bgmVolume":0.65,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.034.jpeg","characterName":"フランドール・スカーレット","id":"2B97D09F-D83A-4731-959D-2A8D2174C568","voiceCharacter":"フランドール・スカーレット","voiceDuration":3.4332426303854877},{"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"telop":"私たちが、そんな話をしていると、家のインターホンが鳴る。\n「ちょっと、玄関に行って見てくるわね…。」","duration":4.9,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","title":"シーン 35","slideTitle":"第35スライド","bgmVolume":0.65,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.035.jpeg","characterName":"レミリア・スカーレット","id":"20D97EA8-BDB5-463A-9221-52C17091788B","voiceCharacter":"レミリア・スカーレット","voiceDuration":4.115079365079365},{"voiceDuration":3.5400680272108844,"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_レミリア・スカーレット_2.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"telop":"私がそう言い、外に出ると、そこには咲夜が立っていた。\n「急に、連絡なしにやって来て、どうしたのよ、咲夜？」","duration":5.2,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":