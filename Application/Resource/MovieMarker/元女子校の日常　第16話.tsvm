he\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"ナレーション","id":"820881F4-6F49-4294-B1DA-B1AEB1D6EFC7","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.018.jpeg","bgmName":"BGM: 東方妖恋談"},{"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"telop":"僕たちは、それから、家に戻り、食堂で昼食をとっていると、二人は互いの記憶を擦り合わせ、僕にどこまで覚えてるか尋ねる。","duration":5.800000000000001,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","title":"シーン 19","slideTitle":"第19スライド","bgmVolume":0.65,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.019.jpeg","characterName":"操夢","id":"6E09CE3F-930F-4C17-8FD0-3FD7DFE87187","voiceCharacter":"操夢","voiceDuration":3.0267346938775512},{"voiceDuration":0.6319954648526077,"bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceStartTimeOffset":0,"telop":"「ねぇ、紅夢、あなたはどこまで覚えてるの？」","duration":3.5,"bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","title":"シーン 20","slideTitle":"第20スライド","bgmVolume":0.65,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"nc196979_食堂(昼).png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第16話_791a4f77fa\/元女子校の日常　第16話_791a4f77fa.020.jpeg","characterName":"フランドール・スカーレット","id":"65AEE72F-4873-4F86-B6BA-8D1F8ACC2378","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoSt