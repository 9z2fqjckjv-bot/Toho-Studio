/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_パチュリー・ノーレッジ.wav","characterName":"パチュリー・ノーレッジ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第1話 〜彼は、同級生に話しかけると...〜\/パチュリー（弱る影）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #29","bgmStartTimeOffset":0,"duration":5.362698412698412,"telop":"「分かってるわよ、それくらい。こう見えても、\nあんたの比にならないくらい、長生きしてきたんだから。」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"2A71131F-9E88-4C52-8175-D23D8934DBF7","animationName":"なし","voiceDuration":5.362698412698412,"title":"シーン 29","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.030.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第1話 〜彼は、同級生に話しかけると...〜\/パチュリー（大口影）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0.91,"seVolume":0.85,"voiceCharacter":"操夢","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #30","bgmStartTimeOffset":0,"duration":8.666938775510204,"telop":"彼女はそういうと、突如地面に倒れ込み、ぜぇぜぇとした荒い息遣いをし始めた。そして、僕は、薬品棚の方に向かう。","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/倒れる.mp3","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"37A34128-7128-4582-BB05-BF6A4FBD69DE","animationName":"なし","voiceDuration":8.666938775510204,"title":"シーン 30","seName":"SE: 倒れる","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.031.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","seVolume":1,"seStartTimeOffset":0,"voiceCharacter":"操夢","backgroundName":"E53188A0-C3C2-50FD-B3FA-C2F836B679F1.jpg","slideTitle":"スライド #31","bgmStartTimeOffset":0,"duration":5.649546485260771,"telop":"僕はすぐに、目的のものが入った箱を見つけ、\n手に取ると、彼女の元に向かう。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第1話 〜彼は、同級生に話しかけると...〜\/E53188A0-C3C2-50FD-B3FA-C2F836B679F1.jpg","id":"AA49F15A-9370-4FA8-802B-E0277432887D","animationName":"なし","voiceDuration":5.649546485260771,"title":"シーン 31","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.032.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第1話 〜彼は、同級生に話しかけると...〜\/パチュリー（大口影）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #32","bgmStartTimeOffset":0,"duration":3.8843310657596373,"telop":"僕はその箱を開け、中身を取り出して、彼女に飲ませる。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"F828A9C6-693C-4589-BF25-C58C0E01B98A","animationName":"なし","voiceDuration":3.8843310657596373,"title":"シーン 32","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.033.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #33","bgmStartTimeOffset":0,"duration":9.177823129251701,"telop":"すると、それから10分ほどで、彼女は元に戻り、背もたれを起こす。「もう大丈夫ですか、博士？」僕はそう、彼女に聞く。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"C4979FE5-9B25-45AF-B9C9-18E30F6B9FAD","animationName":"なし","voiceDuration":9.177823129251701,"title":"シーン 33","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.034.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_パチュリー・ノーレッジ.wav","characterName":"パチュリー・ノーレッジ","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #34","bgmStartTimeOffset":0,"duration":5.905759637188209,"telop":"「全回復ってわけじゃないけど、ありがとね。あなたが、いなかったら私はそのまま気絶してしまっていたわ…。」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"69882B6D-FF0E-417D-A482-4307944FA43D","animationName":"なし","voiceDuration":5.905759637188209,"title":"シーン 34","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.035.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #35","bgmStartTimeOffset":0,"duration":7.347369614512472,"telop":"「とりあえず、病院の方まで一緒に、行きますよ。」\nすると彼女は、僕の手を取り、ゆっくりと立ち上がる。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"457C1A07-5BFE-4000-A801-702319624047","animationName":"なし","voiceDuration":7.347369614512472,"title":"シーン 35","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.036.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","slideTitle":"スライド #36","bgmStartTimeOffset":0,"duration":3.9049886621315193,"telop":"それから、僕と彼女は、ゆっくりと病院の方に向かった。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","id":"B52C0D16-AE5F-41F5-8526-9F80EE407976","animationName":"なし","voiceDuration":3.9049886621315193,"title":"シーン 36","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.037.jpeg","voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","characterName":"操夢","transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"backgroundName":"単色背景","slideTitle":"スライド #37","bgmStartTimeOffset":0,"duration":5,"telop":"博士兼学校教員","bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc281455_【東方アレンジ】ピアノ小曲_動く大図書館と赤い鍵盤の魔術師【ラクトガール】.mp3","bgmVolume":0.2548513663220089,"id":"C9AE4172-4911-4A58-87DE-DCEC2A2B6C5E","animationName":"なし","bgmName":"BGM: nc281455_【東方アレンジ】ピアノ小曲_動く大図書館と赤い鍵盤の魔術師【ラクトガール】","title":"シーン 37: 博士兼学校教員","voiceStartTimeOffset":0},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.038.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #38","bgmStartTimeOffset":0,"duration":7.5495464852607705,"telop":"僕は、それからパチュリーの診察結果を聞き、その内容と先ほどの出来事を彼女にいうために、家に戻ってきた。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"FA8998F9-B07D-43DA-A424-6DDB2D1558FA","animationName":"なし","voiceDuration":7.5495464852607705,"title":"シーン 38","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.039.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #39","bgmStartTimeOffset":0,"duration":3.946326530612245,"telop":"「こないだの食事の時にも、言ってたけど、なんだか不安ね…」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"0415D86D-9BDC-4F1B-BA2F-7826DBF2A05D","animationName":"なし","voiceDuration":3.946326530612245,"title":"シーン 39","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.040.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #40","bgmStartTimeOffset":0,"duration":8.318027210884354,"telop":"それから僕は、パチュリーに出勤禁止命令が出されたことにある内容を付け足す。それは、代替教員の確保についてだった。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"1BA95B1C-C96D-4CAD-A88A-9B04D12E9D70","animationName":"なし","voiceDuration":8.318027210884354,"title":"シーン 40","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.041.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/後ろ手驚く.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #41","bgmStartTimeOffset":0,"duration":7.12907029478458,"telop":"「えっ、あなたがパチュリーがいない間、代わりに教員になるって、どういうこと？あなた教員資格はないんでしょ？」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"1CC77BED-E103-42BC-8666-F8A9928D09C3","animationName":"なし","voiceDuration":7.12907029478458,"title":"シーン 41","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.042.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/後ろ手驚く.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #42","bgmStartTimeOffset":0,"duration":8.697369614512471,"telop":"「ええ、教員資格は取ってませんよ。ただ、学校側は、たとえ資格がなくとも、代替手段で臨時教員になって欲しいと…。」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"CE39DA2C-685B-4257-B2DE-E26A500B4207","animationName":"なし","voiceDuration":8.697369614512471,"title":"シーン 42","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.043.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #43","bgmStartTimeOffset":0,"duration":3.5629931972789115,"telop":"「それは、困ったわね…。それで、あなたの意見は？」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"9392A798-F158-4BBC-9D54-9663CE3E8A17","animationName":"なし","voiceDuration":3.5629931972789115,"title":"シーン 43","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.044.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #44","bgmStartTimeOffset":0,"duration":8.78,"telop":"「もし、臨時教員になれば、僕が教員免許を臨時教員の期間中に取得して、正規の教員として迎えられるようサポートすると…」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"A71BC838-45EF-4C6F-884E-31BB8593DC0D","animationName":"なし","voiceDuration":8.78,"title":"シーン 44","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.045.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #45","bgmStartTimeOffset":0,"duration":7.810430839002268,"telop":"僕はそう言ってから、彼女の質問に答える。「レミリアさんから仕事もらい続けるわけにはいかないので、それもいいかなと…」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"768D2D36-0E1C-42B8-8953-1FAC9AFA2707","animationName":"なし","voiceDuration":7.810430839002268,"title":"シーン 45","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.046.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #46","bgmStartTimeOffset":0,"duration":4.079659863945579,"telop":"「確かに、その通りだけど、話がうますぎる気がするのよね…」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"2FDE54B1-7A83-408E-B6A9-4C905E814971","animationName":"なし","voiceDuration":4.079659863945579,"title":"シーン 46","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.047.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #47","bgmStartTimeOffset":0,"duration":2.5191156462585034,"telop":"「何か、裏があるって言いたいんですか？」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"78EA7E84-4A51-4F33-BDBF-8E01971198EE","animationName":"なし","voiceDuration":2.5191156462585034,"title":"シーン 47","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.048.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_レミリア・スカーレット.wav","characterName":"レミリア・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"レミリア・スカーレット","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #48","bgmStartTimeOffset":0,"duration":3.267165532879819,"telop":"「ええ、そう。それでも、あなたはそうしたいの？」","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","id":"789CDE88-4BC2-45B0-BBC1-4C964D88A3EF","animationName":"なし","voiceDuration":3.267165532879819,"title":"シーン 48","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.049.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\