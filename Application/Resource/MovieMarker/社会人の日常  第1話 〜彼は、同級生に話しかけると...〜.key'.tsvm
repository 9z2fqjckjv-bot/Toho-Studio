tTimeOffset":0,"duration":2.4843310657596374,"telop":"僕は彼女にそう言われ、すぐに渡す。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","id":"ECCFD98E-0EA6-4C5C-A8DD-6478573A732E","animationName":"なし","voiceDuration":2.4843310657596374,"title":"シーン 58","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.059.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","seVolume":1,"seStartTimeOffset":0,"voiceCharacter":"操夢","backgroundName":"04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","slideTitle":"スライド #59","bgmStartTimeOffset":0,"duration":8.693038548752835,"telop":"すると、彼女はそのまま立ち去っていった。僕は、彼女の行動に疑問が浮かんだが、頭をふり、目的の本を取るのだった。","bgmVolume":0.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","id":"D55EDAF5-2C91-419E-94E8-CC6001ACB142","animationName":"なし","voiceDuration":8.693038548752835,"title":"シーン 59","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320\/社会人の日常__第1話_〜彼は、同級生に話しかけると___〜_d5273fd320.060.jpeg","voice2StartTimeOffset":0,"characterName":"操夢","transitionName":"なし","seVolume":1,"seStartTimeOffset":0,"backgroundName":"単色背景","slideTitle":"スライド #60","bgmStartTimeOffset":0,"duration":2.5,"telop":"続く…","bgmVolume":0.7,"id":"6DAE3EDE-B98C-4A59-BE13-D22895186CB8","animationName":"なし","title":"シーン 60: 続く…","voiceStartTimeOffset":0},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slid