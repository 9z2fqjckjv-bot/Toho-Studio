  },
  {
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第25話_0e3b7087ae/元女子校の日常　第25話_0e3b7087ae.020.jpeg",
    "voiceCharacter": "古明地さとり",
    "audioTrack": "track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A",
    "seVolume": 1,
