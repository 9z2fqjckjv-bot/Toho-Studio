  },
  {
    "slideImagePath": "/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常　第25話_0e3b7087ae/元女子校の日常　第25話_0e3b7087ae.016.jpeg",
    "voiceCharacter": "古明地さとり",
