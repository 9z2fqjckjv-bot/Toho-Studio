[{"transitionName":"なし","duration":6.1000000000000005,"animationName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","telop":"「お姉様が言ってたんだけど、私たちは、その制度がなくなるなら、実家に戻るって…」私は、言いたいことを言えずにそう話す。\n今回の迷シーン","title":"シーン 1","voiceCharacter":"フランドール・スカーレット","slideTitle":"第1スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.001.jpeg","voiceDuration":9.399478458049886,"id":"E7D73E46-4DED-4FED-BC50-DCDA12FE66A8","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":4.800000000000001,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","characterName":"操夢","telop":"「…、フランさんは、僕が誰かを選ぶなら…、いや、この質問は控えた方がいいですね…それで他には？」","title":"シーン 2","voiceCharacter":"操夢","slideTitle":"第2スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.002.jpeg","voiceDuration":8.0756462585034,"id":"AB0F0161-9B61-4751-A584-9E55F8BEAE39","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","telop":"「私は…、それより、久々に血を飲ませてくれない？」","title":"シーン 3","voiceCharacter":"フランドール・スカーレット","slideTitle":"第3スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.003.jpeg","voiceDuration":5.449478458049887,"id":"EBD3DC63-CE83-4C4D-BA35-FB1DA5028946","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":5.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","characterName":"操夢","telop":"「いいですよ。」僕はそう言うと、そっと彼女に背を向ける。\nすると、彼女がゆっくりと噛みつき、僕の血を吸い始める。","title":"シーン 4","voiceCharacter":"操夢","slideTitle":"第4スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.004.jpeg","voiceDuration":3.190861678004535,"id":"79888C83-7DB4-4590-9EDD-207AAD5E47AA","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":4.800000000000001,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","characterName":"操夢","telop":"そして、吸い終わると、僕は、ゆっくりと振り返り、彼女を見る。\n「それで、僕をここに呼んだ理由は…」","title":"シーン 5","voiceCharacter":"操夢","slideTitle":"第5スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.005.jpeg","voiceDuration":4.610430839002268,"id":"BF0E9DDC-83D7-4C78-915E-044A1CD584D0","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","telop":"「操夢…私と…」","title":"シーン 6","voiceCharacter":"フランドール・スカーレット","slideTitle":"第6スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.006.jpeg","voiceDuration":11.164489795918367,"id":"9B816F3F-C11F-4E3F-BB3D-96E6B8BE492E","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":4.1000000000000005,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","characterName":"操夢","telop":"「少しだけ、待っててもらえませんか、その返事…」\n僕は、予想通りの言葉に、そう返す。","title":"シーン 7","voiceCharacter":"操夢","slideTitle":"第7スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.007.jpeg","voiceDuration":3.1408616780045353,"id":"5C9B1258-78F0-4F42-8769-62382CFD7C5A","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","telop":"「分かった…。」私がそう返すと、彼はそのまま去ってった。","title":"シーン 8","voiceCharacter":"フランドール・スカーレット","slideTitle":"第8スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.008.jpeg","voiceDuration":4.520748299319728,"id":"9F6B2EDD-ED0C-4BDA-BA92-D5D08253A79C","bgmName":"BGM: 東方妖恋談","backgroundName":"nc301378_一人部屋２（夕方）.jpg"},{"bgmName":"BGM: 東方妖恋談","characterName":"","title":"東方Project二次創作 powerd by zuyasi　※前回の内容とは一部異なります。","backgroundName":"単色背景","voiceCharacter":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.009.jpeg","duration":3,"id":"0AAA8AC7-9888-4DBC-91D0-9B4163B6C390","telop":"交換夫婦","animationName":"なし","slideTitle":"タイトル","transitionName":"なし"},{"transitionName":"なし","duration":5.1000000000000005,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","characterName":"操夢","telop":"僕は、沖縄から帰ってくると、軽くシャワーだけ浴びて、そのままベッドに入り、眠った。そして、目が覚める。","title":"シーン 10","voiceCharacter":"操夢","slideTitle":"第10スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.010.jpeg","voiceDuration":8.016938775510203,"id":"36B3144E-EA91-4A48-8FA1-36FF19EBC7AB","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg"},{"transitionName":"なし","duration":5.7,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","characterName":"操夢","telop":"そして、廊下にくると、冷蔵庫を開け、ふと卵を手に取り、冷凍庫から冷凍ご飯を取り出し、レンチンする。","title":"シーン 11","voiceCharacter":"操夢","slideTitle":"第11スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.011.jpeg","voiceDuration":2.956077097505669,"id":"1BD15B21-99F3-4DAD-9AB8-A9F5B6C276EF","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","characterName":"操夢","telop":"そして、棚から食器と醤油と箸を出すと、レンチンしたご飯を食器に入れ、さっき出した卵をわり、箸でかき混ぜて運ぶ。","title":"シーン 12","voiceCharacter":"操夢","slideTitle":"第12スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.012.jpeg","voiceDuration":8.044126984126985,"id":"9F2FB1B2-CDC1-45A7-A9F6-83432030C35A","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","characterName":"操夢","telop":"そして、中央にあるテーブルの上で、卵かけご飯を食べる。\nそして、数分程度で食べ切り、後片付けを済ます。","title":"シーン 13","voiceCharacter":"操夢","slideTitle":"第13スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.013.jpeg","voiceDuration":8.684331065759638,"id":"F2563249-8D49-4CAB-908D-8299714E137B","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","characterName":"操夢","telop":"そして、身の回りの確認を済ますと、共同スペースに降りる。","title":"シーン 14","voiceCharacter":"操夢","slideTitle":"第14スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.014.jpeg","voiceDuration":7.694126984126984,"id":"3D08F32E-FE32-4863-B823-A4ED4D3ED960","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg"},{"transitionName":"なし","duration":5.1000000000000005,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","characterName":"操夢","telop":"そして、共同スペースに降りると、冷蔵庫の中身をチェックする、どうやら、食材が入ったまま放置されていた。","title":"シーン 15","voiceCharacter":"操夢","slideTitle":"第15スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.015.jpeg","voiceDuration":7.612607709750567,"id":"BFBF35FC-7247-43DB-A8B0-A3A301B79AE9","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg"},{"transitionName":"なし","duration":5.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","characterName":"操夢","telop":"念の為に、消費期限と賞味期限を見ると、何個か切れているものがあり、僕は、それらを順々に自室の冷蔵庫に運び込む。","title":"シーン 16","voiceCharacter":"操夢","slideTitle":"第16スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.016.jpeg","voiceDuration":2.476734693877551,"id":"4D88E30B-14FA-41F8-8E24-1C3E4D025EC0","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg"},{"transitionName":"なし","duration":4.2,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","characterName":"操夢","telop":"そして、それが終わると、ふと窓の外を見る。\nそして、今の時間を見ると、朝の9時だった。","title":"シーン 17","voiceCharacter":"操夢","slideTitle":"第17スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.017.jpeg","voiceDuration":2.066938775510204,"id":"85F31514-6509-4C89-A788-BB5F90BA9169","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg"},{"transitionName":"なし","duration":3.6,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","characterName":"操夢","telop":"僕は、暇な時間に何しようか、そう考えながら、\n何気ない足取りで、家を出る。","title":"シーン 18","voiceCharacter":"操夢","slideTitle":"第18スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.018.jpeg","voiceDuration":3.1256462585034015,"id":"6CF7EBFD-1760-40D0-8675-7A49D56C7D8B","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","characterName":"操夢","telop":"そして、ふと最寄駅に来ると、到着放送が流れる。","title":"シーン 19","voiceCharacter":"操夢","slideTitle":"第19スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.019.jpeg","voiceDuration":5.360430839002268,"id":"0A96B586-EFF1-4A5E-955D-9A3F4D89137E","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.1000000000000005,"animationName":"なし","characterName":"ナレーション","telop":"「まもなく、埼玉本線、普通、高崎行きが参ります。危ないですから、黄色い線の内側までお下がりください。」","title":"シーン 20","voiceCharacter":"ナレーション","slideTitle":"第20スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.020.jpeg","bgmName":"BGM: 東方妖恋談","id":"57CB37C6-719C-42FA-93FB-F603A71EFC93","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","characterName":"操夢","telop":"僕は、その列車に、そのまま乗り込んだ。","title":"シーン 21","voiceCharacter":"操夢","slideTitle":"第21スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.021.jpeg","voiceDuration":5.631065759637188,"id":"77458866-E3CB-4D63-B8CE-35FB5C139DD9","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","characterName":"操夢","telop":"そして、大宮駅の地上ホームに来て、\nしばらく経つと、到着放送が流れる。","title":"シーン 22","voiceCharacter":"操夢","slideTitle":"第22スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.022.jpeg","voiceDuration":2.4473696145124717,"id":"B5386793-6C15-464F-B61F-266B352DCDBF","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.7,"animationName":"なし","characterName":"ナレーション","telop":"「まもなく、さいポートエクスプレス、羽田空港行きが参ります。危ないですから、黄色い線の内側までお下がりください。」","title":"シーン 23","voiceCharacter":"ナレーション","slideTitle":"第23スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.023.jpeg","bgmName":"BGM: 東方妖恋談","id":"C2D6E4A4-3E9C-4873-ACD0-251228D3598F","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":4.6000000000000005,"animationName":"なし","characterName":"ナレーション","telop":"「この列車は、全車普通車グリーン席です。\n乗車には普通乗車券の他に、グリーン券が必要です。」","title":"シーン 24","voiceCharacter":"ナレーション","slideTitle":"第24スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.024.jpeg","bgmName":"BGM: 東方妖恋談","id":"7956436B-D723-4E2C-98DD-7A08E76097F5","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.5,"animationName":"なし","characterName":"ナレーション","telop":"「グリーン車には、指定席はありません。ポケベルチケットもご利用いただけます。紙のチケットは車内で販売中です。」","title":"シーン 25","voiceCharacter":"ナレーション","slideTitle":"第25スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.025.jpeg","bgmName":"BGM: 東方妖恋談","id":"436CF874-6038-4F91-B0C8-48C7E88B103A","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.2,"animationName":"なし","characterName":"ナレーション","telop":"「途中の停車駅は、新宿のみです。上野、東京方面には参りませんので、ご注意ください。まもなく到着します。」","title":"シーン 26","voiceCharacter":"ナレーション","slideTitle":"第26スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.026.jpeg","bgmName":"BGM: 東方妖恋談","id":"CF65C592-B953-496B-9C3A-22CF386D9D2E","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":4.4,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","characterName":"操夢","telop":"僕は、その列車が来ると、さっそく乗り込み、\nポケベルにチケットを追加してから、席についた。","title":"シーン 27","voiceCharacter":"操夢","slideTitle":"第27スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.027.jpeg","voiceDuration":5.946303854875284,"id":"4F78F911-4208-46FD-8E19-D443CB007E32","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"bgmName":"BGM: 東方妖恋談","characterName":"博麗霊夢","title":"その頃、霊夢たちは…","backgroundName":"単色背景","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.028.jpeg","duration":3,"id":"9BCFE001-94F0-4268-B6E0-1EAD58368737","telop":"","animationName":"なし","slideTitle":"中扉","transitionName":"なし"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_射命丸文.wav","characterName":"博麗霊夢","telop":"私たちは、目が覚めると、この部屋に集まっていた。","title":"シーン 29","voiceCharacter":"博麗霊夢","slideTitle":"第29スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.029.jpeg","voiceDuration":3.6015873015873017,"id":"E7339563-B687-4483-979D-B6C58A158355","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":6,"animationName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「霊夢さんたちが寝静まった後、彼から連絡が来て、無事に帰宅でき、霊夢さんたちのポケベルにチケットも入れたようです。」","title":"シーン 30","voiceCharacter":"博麗霊夢","slideTitle":"第30スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.030.jpeg","voiceDuration":8.316938775510204,"id":"6B9294C3-9714-46CD-B6B6-90DA42B1D022","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.6,"animationName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「えっ？」私は、彼女の言葉に驚かされる。\n「そんな簡単に、帰宅できたの？」","title":"シーン 31","voiceCharacter":"博麗霊夢","slideTitle":"第31スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.031.jpeg","voiceDuration":8.273469387755101,"id":"7073B16C-D892-45CB-8DB0-1CDC6D9C6685","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.800000000000001,"animationName":"なし","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_にとり.wav","characterName":"射命丸文","telop":"「ええ、あと文さんに関しては、元の家に戻るか、既存の空き部屋に住むか、選んで欲しいと、今朝メッセージで来ました。」","title":"シーン 32","voiceCharacter":"射命丸文","slideTitle":"第32スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.032.jpeg","voiceDuration":7.4812925170068025,"id":"39A39F34-7FC7-4801-9336-2EF478A3B406","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_博麗霊夢.wav","characterName":"博麗霊夢","telop":"「ねぇ、ところで、その飛行機の時間は？」","title":"シーン 33","voiceCharacter":"博麗霊夢","slideTitle":"第33スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.033.jpeg","voiceDuration":6.641995464852608,"id":"3DBF0350-A01D-45E6-B351-86D0526020BE","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":6.2,"animationName":"なし","audioTrack":"track_voice_%E3%82%AD%E3%83%A3%E3%83%A9%E3%82%AF%E3%82%BF%E3%83%BC","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_博麗霊夢.wav","characterName":"キャラクター","telop":"「えっと…」私はそう言い、昨晩見ていた彼女たちのチケットを確認する。「12時ちょうどに那覇から出るYJA便ですよ。」","title":"シーン 34","voiceCharacter":"キャラクター","slideTitle":"第34スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.034.jpeg","voiceDuration":8.807732426303854,"id":"EB78D630-918D-412D-8EC0-6FC82D442B80","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.8000000000000003,"animationName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_博麗霊夢.wav","characterName":"博麗霊夢","telop":"私はそれを聞き、ハッとしポケベルを確認する。\nそこには、10時30分とあった。","title":"シーン 35","voiceCharacter":"博麗霊夢","slideTitle":"第35スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.035.jpeg","voiceDuration":2.7094784580498867,"id":"A240107C-4694-4CFC-9801-9B2587D930CE","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":4.5,"animationName":"なし","audioTrack":"track_voice_%E3%82%AD%E3%83%A3%E3%83%A9%E3%82%AF%E3%82%BF%E3%83%BC","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","characterName":"キャラクター","telop":"「そんなに慌てなくても、大丈夫ですよ。\nこの施設は、空港に直結してますから、案内しますね。」","title":"シーン 36","voiceCharacter":"キャラクター","slideTitle":"第36スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.036.jpeg","voiceDuration":3.434331065759637,"id":"16806706-E917-4AC1-BF33-EDF6E2C3D1F0","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.9000000000000004,"animationName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_博麗霊夢.wav","characterName":"博麗霊夢","telop":"私たちは、少し不安になりながら、\n彼女の案内に沿って、空港へと移動するのだった。","title":"シーン 37","voiceCharacter":"博麗霊夢","slideTitle":"第37スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.037.jpeg","voiceDuration":1.8919954648526076,"id":"E624CEC4-B028-4446-B5A5-B10CB34D1D0A","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3,"animationName":"なし","characterName":"ナレーション","telop":"彼に視点が戻り…","title":"シーン 38","voiceCharacter":"ナレーション","slideTitle":"第38スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.038.jpeg","bgmName":"BGM: 東方妖恋談","id":"CD1C2239-C322-4D2B-8C80-9D6D434B7A2E","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.1000000000000005,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","characterName":"操夢","telop":"僕は、空港に着くと、空港内のショッピングモールに来ていた。\n僕は、そのままさまざまなお店を見ながら歩く。","title":"シーン 39","voiceCharacter":"操夢","slideTitle":"第39スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.039.jpeg","voiceDuration":8.03,"id":"9BD2AA8A-8E55-4C55-AC11-546B209CF96F","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":4.800000000000001,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","characterName":"操夢","telop":"そして、ふと見かけたゲームセンターに入る。そして、ふと小銭がないことを思い出し、ATMに向かう。","title":"シーン 40","voiceCharacter":"操夢","slideTitle":"第40スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.040.jpeg","voiceDuration":13.535419501133786,"id":"60831CE9-B6DD-4FE7-B146-1AC319270CFC","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","characterName":"操夢","telop":"そして、ATMで残高を確認し、0が4つ入った、お札を5枚出す。","title":"シーン 41","voiceCharacter":"操夢","slideTitle":"第41スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.041.jpeg","voiceDuration":7.412607709750567,"id":"C675800A-CD4D-4E38-A525-DF6B78FD92AB","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","characterName":"操夢","telop":"そして、数千円分の小銭を出すと、その小銭が尽きるまでの小1時間ほど、過ごすと、ゲームセンターを出る。","title":"シーン 42","voiceCharacter":"操夢","slideTitle":"第42スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.042.jpeg","voiceDuration":8.803900226757369,"id":"333896B3-20A6-4A90-A1F9-775773259858","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":5.7,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","characterName":"操夢","telop":"そして、僕は、スーパーを探す。そして、スーパーで共同スペースの冷蔵庫の中身を思い出しながら、食材を買い、発送する。","title":"シーン 43","voiceCharacter":"操夢","slideTitle":"第43スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.043.jpeg","voiceDuration":8.316938775510204,"id":"9C05CCED-5B2A-4B9F-96DC-ED58D893DACA","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":3.5,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","characterName":"操夢","telop":"そして、そのまま僕は到着ロビーに向かう。","title":"シーン 44","voiceCharacter":"操夢","slideTitle":"第44スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（28話目）_fc328122db\/交換夫婦（28話目）_fc328122db.044.jpeg","voiceDuration":7.069115646258504,"id":"DADADF9A-5ADF-46BA-9529-C1EB2CB51A63","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"transitionName":"なし","duration":4.2,"animationName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","characterName":"操夢","telop":"そして、到着ロビーに来ると、彼女たちを待つ。\nそれから、数十分程度で彼女たちが現れた。","title":"シーン 45","voiceCharacter":"操夢","slideTitle":"第45スライド","slideImagePath":"\/Volumes\/ZSS