yasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","slideTitle":"第45スライド","title":"シーン 45"},{"telop":"「どうしたのよ…、私のとこに来て？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.046.jpeg","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"67271AF9-14F3-4FB7-A42D-44E537FC9368","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"レミリア・スカーレット","voiceDuration":3.500748299319728,"transitionName":"なし","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_レミリア・スカーレット.wav","slideTitle":"第46スライド","title":"シーン 46"},{"telop":"「レミリアさんに、謝りたいことがあってきたんですよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.047.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"8A3B7066-C7AD-48A1-8B1A-CD66538F12BE","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"操夢","voiceDuration":3.879501133786848,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","slideTitle":"第47スライド","title":"シーン 47"},{"telop":"「謝りたいこと？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.048.jpeg","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"14F5B6E2-CBCC-471A-82CF-2FCC0C9D7E64","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"レミリア・スカーレット","voiceDuration":1.7351020408163265,"transitionName":"なし","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_レミリア・スカーレット.wav","slideTitle":"第48スライド","title":"シーン 48"},{"telop":"「僕が、フランに指輪を渡す瞬間を見せてしまったことを謝りたくて…、フランの部屋で渡せば良かったなって反省してます。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.049.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"20618F48-5474-472F-824C-9E2035E0F5DE","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.800000000000001,"characterName":"操夢","voiceDuration":8.989478458049886,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","slideTitle":"第49スライド","title":"シーン 49"},{"telop":"「それは、もういいわよ。暴れたのは私で、過ぎたことだし。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.050.jpeg","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"59EAB790-AEE9-4AA0-98BC-5794F3C04C00","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"レミリア・スカーレット","voiceDuration":6.275759637188209,"transitionName":"なし","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_レミリア・スカーレット.wav","slideTitle":"第50スライド","title":"シーン 50"},{"telop":"「そうですか…でももし今度、何かあったら言ってください…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.051.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"A0B258C8-78AC-4A31-B39A-3BA2D48A465C","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"操夢","voiceDuration":4.3894784580498865,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","slideTitle":"第51スライド","title":"シーン 51"},{"telop":"「それなら、一つだけ、いいかしら…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.052.jpeg","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"9563A320-6B2F-4973-842D-E22BE7DFACFB","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"レミリア・スカーレット","voiceDuration":3.6538548752834465,"transitionName":"なし","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_レミリア・スカーレット.wav","slideTitle":"第52スライド","title":"シーン 52"},{"telop":"「はい、いいですよ。それで何でしょう？」\n僕がそう尋ねると、彼女が僕の背中に回る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.053.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"836D601C-88EC-4870-8AA3-5CC03E8557D4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4,"characterName":"操夢","voiceDuration":7.4819954648526075,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","slideTitle":"第53スライド","title":"シーン 53"},{"telop":"すると、僕に彼女は背後から抱きつき、\n顔を背中に埋めているが、感覚で伝わってくる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.054.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"C778011B-08EF-40DC-A3AA-4D5CDCC147F3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4,"characterName":"操夢","voiceDuration":6.936984126984127,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","slideTitle":"第54スライド","title":"シーン 54"},{"telop":"「私がたまに、あなたを呼んだらこうやってくれないかしら？こうしてくれると、心が温まるし、2度とはああならないから…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.055.jpeg","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"52BA5B79-2B72-4AC3-80B7-0CE4EA1287FF","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.800000000000001,"characterName":"レミリア・スカーレット","voiceDuration":11.525759637188209,"transitionName":"なし","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_レミリア・スカーレット.wav","slideTitle":"第55スライド","title":"シーン 55"},{"telop":"「ええ、お安い御用ですよ。」僕は、そう言いながら、\n彼女の背後に回り、そっと頭を撫でる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.056.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"76FCF721-2F77-4FC3-9224-DE0342308173","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.3,"characterName":"操夢","voiceDuration":7.7319954648526075,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","slideTitle":"第56スライド","title":"シーン 56"},{"telop":"「ありがとう、操夢。これから、私たちの一員として、\nよろしくね…、フランの…、旦那さん…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.057.jpeg","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"78F485A9-8EBA-4E65-849F-96F731517070","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.4,"characterName":"レミリア・スカーレット","voiceDuration":9.644489795918368,"transitionName":"なし","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_レミリア・スカーレット.wav","slideTitle":"第57スライド","title":"シーン 57"},{"telop":"「ええ、もちろん。」\n僕たちは、そう言って、新生活が始まった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.058.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"CDCCF936-1044-4BFC-8D3B-27578B05D25C","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"操夢","voiceDuration":5.646984126984127,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","slideTitle":"第58スライド","title":"シーン 58"},{"animationName":"なし","characterName":"ナレーション","title":"シーン 59","duration":3,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"ナレーション","slideTitle":"第59スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"時代が進み…\n※詳細は、彷徨う二人の5話目を参照してください。","id":"E2056DB2-DFE1-4BDD-A361-4A987315BC8B","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.059.jpeg"},{"telop":"私は、久々にフランと対面したが、どうやらフレラとの違いは、この記録を見る限り見た目だけだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.060.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"BC4FBE5C-2E2C-4C6C-BF5F-AF213EDF6FF1","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":4.7,"characterName":"パチュリー・ノーレッジ","voiceDuration":6.539614512471656,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_パチュリー・ノーレッジ.wav","slideTitle":"第60スライド","title":"シーン 60"},{"telop":"「でも、あれから少なくとも１世紀以上経ってるのよね…」\n私は、幻想郷にいた頃が遠い昔のように感じられる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.061.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"E4C3A238-E96E-4DEF-B494-C7310C60E491","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.1000000000000005,"characterName":"パチュリー・ノーレッジ","voiceDuration":7.3592517006802725,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_パチュリー・ノーレッジ.wav","slideTitle":"第61スライド","title":"シーン 61"},{"telop":"21世紀半ばに、幻想郷から外の世界へ大移動、そして21世紀の後半には、彼の先祖が誕生、そして、さらに、時がたち今…。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.062.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"DE9E1A31-0EC5-495F-B797-2221ECD8A38B","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.800000000000001,"characterName":"パチュリー・ノーレッジ","voiceDuration":9.783854875283447,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_パチュリー・ノーレッジ.wav","slideTitle":"第62スライド","title":"シーン 62"},{"telop":"彼の先祖は、代々とその記憶を受け継ぎ、彼の種族は、世界のシステムと覇権を握り締め、その一端が彼になっている。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.063.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"D365A0A8-DF4A-41BD-B265-B7486B5672FC","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.4,"characterName":"パチュリー・ノーレッジ","voiceDuration":7.909863945578231,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_パチュリー・ノーレッジ.wav","slideTitle":"第63スライド","title":"シーン 63"},{"telop":"そして、「その記憶のバックアップ本」がこの図書館に眠っていると…、「誰が予想してたのかしら、こんな未来…。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.064.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"31BF4A6E-40F3-4761-AFB6-A7644FEE7ECF","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.4,"characterName":"パチュリー・ノーレッジ","voiceDuration":6.442471655328799,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_パチュリー・ノーレッジ.wav","slideTitle":"第64スライド","title":"シーン 64"},{"telop":"すると、フレラが、私のもとにやってくる。\n「フレラ、この本の山、片付けてくれるかしら？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.065.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"D128F77A-BAA8-4205-BC28-CD8C784F420D","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":4.3,"characterName":"パチュリー・ノーレッジ","voiceDuration":6.170498866213152,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_パチュリー・ノーレッジ.wav","slideTitle":"第65スライド","title":"シーン 65"},{"telop":"「分かった。」私はそう言うと、その本の山を片付ける。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.066.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"B4CC15B8-9EF8-4EFC-9509-FB3A6E6BC1D3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":4.780748299319728,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_フランドール・スカーレット.wav","slideTitle":"第66スライド","title":"シーン 66"},{"telop":"「それで、あのバックアップ本で何を調べていたの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.067.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"8DF0D050-A0F7-4D64-9890-CA518716F43A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":3.7394784580498865,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_フランドール・スカーレット.wav","slideTitle":"第67スライド","title":"シーン 67"},{"telop":"「ちょっと、昔を思い出したくてね…、\nそれで、フランからどんな話を聞いていたの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.068.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"0159618A-E803-4DB4-8430-5BD0E05339A9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":4,"characterName":"パチュリー・ノーレッジ","voiceDuration":5.13625850340136,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_パチュリー・ノーレッジ.wav","slideTitle":"第68スライド","title":"シーン 68"},{"telop":"「例えばね…」\n私はそう、私の先祖であるフランから聞いた話をする。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.069.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"AD8D0DEF-516F-4D25-A9E9-E7E296581369","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":5.629478458049887,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_フランドール・スカーレット.wav","slideTitle":"第69スライド","title":"シーン 69"},{"telop":"私は、彼女の話を聞き、ふとさっきまで読んでいた本当の違いに気づく。幻想郷と外の世界では時間軸がずれているようだ。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.070.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"74CDF369-A24A-43A6-8251-D2F80F4855B7","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.6000000000000005,"characterName":"パチュリー・ノーレッジ","voiceDuration":8.456485260770975,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_パチュリー・ノーレッジ.wav","slideTitle":"第70スライド","title":"シーン 70"},{"telop":"「だとしても、おかしいわね…、\nフランは、何か日付に関することを言ってたかしら？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.071.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"274DE639-E00E-45EB-BC1A-EECBF670979C","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":4.1000000000000005,"characterName":"パチュリー・ノーレッジ","voiceDuration":5.131746031746032,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_パチュリー・ノーレッジ.wav","slideTitle":"第71スライド","title":"シーン 71"},{"telop":"「いや、特に言ってなかった。\nただ、レミリアに追い出されたって。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.072.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"7CD958AE-AD24-4B72-A4B5-CBD730482330","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":5.101995464852608,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_フランドール・スカーレット.wav","slideTitle":"第72スライド","title":"シーン 72"},{"telop":"「悪いけど、さっき片付けた本の収納棚から、\n2070年前後の記録を撮ってきてくれるかしら…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.073.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"05C0CE9D-7E16-4284-9431-078553D35CCB","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":4.5,"characterName":"パチュリー・ノーレッジ","voiceDuration":6.508616780045352,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_パチュリー・ノーレッジ.wav","slideTitle":"第73スライド","title":"シーン 73"},{"telop":"「分かった。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.074.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"B25FDE0C-57B8-4A11-99F5-7FA310FC7F67","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":4.780748299319728,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_フランドール・スカーレット.wav","slideTitle":"第74スライド","title":"シーン 74"},{"telop":"私は、彼がここに立ち寄った際に、もらった紅茶を嗜みながら、先ほどの矛盾点を考える…「時代錯誤かしら…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.075.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"210FDE30-780F-4741-88B5-842F9CBBEA3D","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.1000000000000005,"characterName":"パチュリー・ノーレッジ","voiceDuration":7.532743764172336,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_パチュリー・ノーレッジ.wav","slideTitle":"第75スライド","title":"シーン 75"},{"telop":"「持ってきたよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.076.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"79B21AED-0D68-4603-9C13-A2C379C976DA","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":1.5,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_フランドール・スカーレット.wav","slideTitle":"第76スライド","title":"シーン 76"},{"telop":"「どれどれ…」私は先ほど、読んだ本をもう一度、読み直す。\nそこには、彼の先祖とフランの結婚生活が描かれていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.077.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"4BEA4984-9853-4497-BD82-A649D4683ED9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.4,"characterName":"パチュリー・ノーレッジ","voiceDuration":8.238480725623583,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_パチュリー・ノーレッジ.wav","slideTitle":"第77スライド","title":"シーン 77"},{"telop":"だが、ある日の記載に疑問を抱く。\nその日の記録にはこう書いてあった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.078.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"5EE5D664-C62C-43DF-974D-027071EF7647","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"パチュリー・ノーレッジ","voiceDuration":4.454489795918367,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_パチュリー・ノーレッジ.wav","slideTitle":"第78スライド","title":"シーン 78"},{"telop":"207×年、4月⚪︎日。僕は、新生活の始まりから×年目のある日、僕は、2年前に手がけたシステムからある情報を入手した。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.079.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"F32463D0-69A2-4066-8E30-20583FB1A2AF","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":6.1000000000000005,"characterName":"操夢","voiceDuration":2.1744897959183676,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","slideTitle":"第79スライド","title":"シーン 79"},{"telop":"僕は、その日、フランとの予定に断りを入れて、急ぎ東京の某所にある円球機械室に入り、操作盤を触る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.080.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"2E2476D1-2F14-47B4-A505-DF192344F820","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.800000000000001,"characterName":"操夢","voiceDuration":8.879478458049887,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","slideTitle":"第80スライド","title":"シーン 80"},{"telop":"そして、そこで見た情報は、年表に関する事柄だった。\nどうやら、フランたちが元々いた幻想郷からの伝達だった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.081.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"F7E2E14E-3FBD-4660-87B3-C9DBC68E2D6A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.2,"characterName":"操夢","voiceDuration":9.769501133786848,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_操夢.wav","slideTitle":"第81スライド","title":"シーン 81"},{"telop":"前々から総理には、幻想郷の今を調べてほしいと依頼されていたので、僕はその情報の通知が自分のPCに出てすぐにきた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.082.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"EC711478-E462-424A-B0E6-1B3217FD8236","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.6000000000000005,"characterName":"操夢","voiceDuration":9.820249433106577,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav","slideTitle":"第82スライド","title":"シーン 82"},{"telop":"そして、幻想郷の某所から送られた情報を調べると…、不可解な事実が浮かび上がる…。僕はさらに、深掘りする。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.083.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"43C12846-B051-49A7-9A26-1BC710EC2C47","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.6000000000000005,"characterName":"操夢","voiceDuration":9.820249433106577,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_操夢.wav","slideTitle":"第83スライド","title":"シーン 83"},{"telop":"そして、ある事実が判明する。それは、2000年代初頭に閉鎖されたとある発電所の残骸が、幻想郷に存在すると言うことだ。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.084.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"1BA8D8D2-9E32-482B-92C4-E74079661AC6","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.800000000000001,"characterName":"操夢","voiceDuration":10.782743764172336,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav","slideTitle":"第84スライド","title":"シーン 84"},{"telop":"その施設から、送られてきた内容は、ある日、施設が爆発を起こし、その影響で、あるものが歪んでしまっていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.085.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"0CC53BFB-D4EF-4BB2-BF79-EFCC7903D781","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.2,"characterName":"操夢","voiceDuration":9.039501133786848,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav","slideTitle":"第85スライド","title":"シーン 85"},{"telop":"僕はそこから、ある仮説を立てる。実は、総理たちがこっちにきたと言う事実が、その爆発で消えているのではないかと…。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.086.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"A87BA7BC-1C6A-43F5-B78F-2C1BB7B95710","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.6000000000000005,"characterName":"操夢","voiceDuration":9.339478458049886,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_操夢.wav","slideTitle":"第86スライド","title":"シーン 86"},{"telop":"そして、彼女たちがこちらにきた後、ふと彼女が確認を試みようとした時には確認できなかったため、その間に爆発が起きる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.087.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"5412947B-F8EA-480D-8B27-3CA97A887676","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.7,"characterName":"操夢","voiceDuration":10.297732426303854,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_操夢.wav","slideTitle":"第87スライド","title":"シーン 87"},{"telop":"僕は、その仮説にさらにこう付け足す。その爆発によって、一度消えたものが再び現れていると。爆発から生を生み出したのだ。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.088.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"6820311D-0F13-4AEB-8835-D6A2799F3978","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.800000000000001,"characterName":"操夢","voiceDuration":10.528231292517006,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_操夢.wav","slideTitle":"第88スライド","title":"シーン 88"},{"telop":"これは、何かのいたずらだ…僕はそう決定づけ、その事後報告を総理に伝えてから、フランのとこに戻るのだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.089.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"EE00B7B1-756D-4063-A412-5B6FC9C5526B","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.2,"characterName":"操夢","voiceDuration":8.890725623582766,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav","slideTitle":"第89スライド","title":"シーン 89"},{"telop":"「これって、もしかしたら…、幻想郷で再び芽生えた彼女が、\nこの世界に来たと言うことになるのかしら…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.090.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"9A0845EA-CBC6-4D85-BF8D-AFC096CD84CD","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":4.9,"characterName":"パチュリー・ノーレッジ","voiceDuration":6.512721088435375,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_パチュリー・ノーレッジ.wav","slideTitle":"第90スライド","title":"シーン 90"},{"telop":"私は機械音痴だから、詳細は解りかねたが、そう言う言葉を述べた。「破壊と生は常に一つなり…、どこかにありそうだわ…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.091.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"84003472-0270-44F1-9D65-57D8E536EDFF","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":5.7,"characterName":"パチュリー・ノーレッジ","voiceDuration":7.967233560090703,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_パチュリー・ノーレッジ.wav","slideTitle":"第91スライド","title":"シーン 91"},{"telop":"「ありがとう、フレラ、本を戻してきてちょうだい。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.092.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"978B692E-46D6-449A-A6B6-53209F58C8A0","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"パチュリー・ノーレッジ","voiceDuration":3.009251700680272,"transitionName":"なし","audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_パチュリー・ノーレッジ.wav","slideTitle":"第92スライド","title":"シーン 92"},{"telop":"「分かった。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.093.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"DE71F5BE-13BE-4444-84DD-F928B9289944","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":4.780748299319728,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_フランドール・スカーレット.wav","slideTitle":"第93スライド","title":"シーン 93"},{"telop":"私は、それから彼にもらった紅茶を嗜みながら、「ふぅ…」と吐く。私では、この世界を把握するには足りないようだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.094.jpeg","voiceCharacter":"パチュリー・ノーレッジ","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","animationName":"なし","id":"FE9E7D59-0FC4-46DF-8BBE-197633AFA50A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","d