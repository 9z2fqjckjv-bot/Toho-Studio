[{"animationName":"なし","characterName":"","title":"東方Project二次創作 powerd by zuyasi","duration":3,"voiceCharacter":"","slideTitle":"タイトル","backgroundName":"単色背景","telop":"交換夫婦","id":"76B83072-97EB-4514-80A5-E468B37D6FAC","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.001.jpeg"},{"telop":"僕は、それから、自室に戻ってくると、感慨の気持ちに触れる。\n「短期間だったけど、色々とあったな…」っと。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.002.jpeg","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","animationName":"なし","id":"E3F2C57F-F872-4E95-BF9C-B975F0D96C73","duration":5.1000000000000005,"characterName":"操夢","voiceDuration":9.170748299319728,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","slideTitle":"第2スライド","title":"シーン 2"},{"telop":"そして、そんな回想を終わらせると、荷物整理を始める。といっても、事前に大きなものは配送済みなので、ポケベルだけ持つ。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.003.jpeg","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","animationName":"なし","id":"E03239AA-130D-4702-A2BA-470EE496DD7A","duration":5.800000000000001,"characterName":"操夢","voiceDuration":10.011995464852607,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","slideTitle":"第3スライド","title":"シーン 3"},{"telop":"そして、共同スペースに降りてくると、それぞれが準備を済ませたようだった。そして、早く帰宅した霊夢が話し始める。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.004.jpeg","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"11FDC163-B149-4F8C-BD07-2D2D11CD7E82","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":4.9,"characterName":"操夢","voiceDuration":8.250748299319728,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","slideTitle":"第4スライド","title":"シーン 4"},{"telop":"「あんたたち、そろそろ、家を出るんでしょ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.005.jpeg","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"46D13745-2D6B-4E46-9245-1F6BD87026C9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":3.5,"characterName":"博麗霊夢","voiceDuration":3.2194784580498865,"transitionName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","slideTitle":"第5スライド","title":"シーン 5"},{"telop":"「ええ、そうですよ。けど、魔理沙さんは、電話で聞けば、家に残るといって、さとりとこいしさんも残るみたいですよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.006.jpeg","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"F4B26FDF-A9E7-4A6B-A589-00174057A232","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":5.6000000000000005,"characterName":"操夢","voiceDuration":9.255736961451246,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","slideTitle":"第6スライド","title":"シーン 6"},{"telop":"「でも…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.007.jpeg","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"25637D58-6BF3-4EE2-A02E-8F2A93A7204B","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":3.5,"characterName":"博麗霊夢","voiceDuration":1.5,"transitionName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav","slideTitle":"第7スライド","title":"シーン 7"},{"telop":"「僕が時折こっちに来ますから、寂しい思いはさせませんよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.008.jpeg","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"C27A009A-7822-4026-9CE1-0F22F03363D9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":3.5,"characterName":"操夢","voiceDuration":4.629501133786848,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","slideTitle":"第8スライド","title":"シーン 8"},{"telop":"「そう…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.009.jpeg","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"8C68007F-1BB6-40B3-8E30-4116301F3A80","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":3.5,"characterName":"博麗霊夢","voiceDuration":1.5,"transitionName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_博麗霊夢.wav","slideTitle":"第9スライド","title":"シーン 9"},{"telop":"僕は、それでも不安そうな彼女の背中に回り、そっと頭を撫でる。「これで、安心できますか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.010.jpeg","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"CD69C695-E6E5-40E1-9670-80F48F094A3B","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":4.4,"characterName":"博麗霊夢","voiceDuration":7.736984126984127,"transitionName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_博麗霊夢.wav","slideTitle":"第10スライド","title":"シーン 10"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","telop":"「ええ、ありがとう、操夢。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.011.jpeg","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"657CB773-43A0-49A6-A2CC-38B3D727AE3A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":3.5,"characterName":"博麗霊夢","voiceDuration":2.2419954648526077,"transitionName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","slideTitle":"第11スライド","title":"シーン 11"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","telop":"「操夢、車が来たみたいだよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.012.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"788BF0AA-46D3-4D0F-9225-6E99A268D614","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":2.5894784580498866,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_フランドール・スカーレット.wav","slideTitle":"第12スライド","title":"シーン 12"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","telop":"「それじゃあ、行ってきますね。あと、魔理沙さんに、こないだの件、頼んでありますから、耳立てて聞いてください。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.013.jpeg","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"3CC40392-26AD-4976-B061-94458B934113","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":5.5,"characterName":"操夢","voiceDuration":9.226984126984126,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","slideTitle":"第13スライド","title":"シーン 13"},{"telop":"「えっ…」私は彼の一言に、そう呟いているうちに、彼は、そのまま、フランたちの元に向かって言った。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.014.jpeg","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","animationName":"なし","id":"1D911C26-DDF7-4C81-BBB6-3F12BC726735","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","duration":4.800000000000001,"characterName":"博麗霊夢","voiceDuration":8.593242630385488,"transitionName":"なし","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav","slideTitle":"第14スライド","title":"シーン 14"},{"animationName":"なし","characterName":"フランドール・スカーレット","title":"彼がフランたちの実家に着くと…","duration":3,"voiceCharacter":"フランドール・スカーレット","slideTitle":"中扉","backgroundName":"単色背景","telop":"","id":"1CB515E9-15ED-4919-BA3F-0741891C2883","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.015.jpeg"},{"telop":"「想定よりも、大きいですね…、この屋敷…」\n僕は、フランたちと共にこの屋敷に入って最初の一言を言う。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.016.jpeg","voiceCharacter":"操夢","backgroundName":"nc213186_紅魔館ロビー.jpeg","animationName":"なし","id":"8C2F5C4E-5002-4903-A3A5-EB82692642A0","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd","duration":4.9,"characterName":"操夢","voiceDuration":8.701473922902494,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","slideTitle":"第16スライド","title":"シーン 16"},{"telop":"「でも、慣れて仕舞えば、こんなもんですよ。」\n私は、彼の一言にそう返す。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.017.jpeg","voiceCharacter":"十六夜咲夜","backgroundName":"nc213186_紅魔館ロビー.jpeg","animationName":"なし","id":"042A5F75-2253-474A-B766-37541369F2ED","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd","duration":3.5,"characterName":"十六夜咲夜","voiceDuration":6.1065986394557825,"transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_十六夜咲夜.wav","slideTitle":"第17スライド","title":"シーン 17"},{"telop":"「そうですか…、それで、僕の部屋は？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.018.jpeg","voiceCharacter":"操夢","backgroundName":"nc213186_紅魔館ロビー.jpeg","animationName":"なし","id":"FEC120A8-DD8B-4CB3-AB46-A8562290D9E9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd","duration":3.5,"characterName":"操夢","voiceDuration":2.971972789115646,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","slideTitle":"第18スライド","title":"シーン 18"},{"telop":"「今から、案内しますね。」\n私はそう言うと、彼に割り当てた部屋の場所に彼を案内する。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.019.jpeg","voiceCharacter":"十六夜咲夜","backgroundName":"nc213186_紅魔館ロビー.jpeg","animationName":"なし","id":"413D0724-F23A-4713-A257-AD36409E9E2D","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd","duration":4.1000000000000005,"characterName":"十六夜咲夜","voiceDuration":6.7457596371882085,"transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_十六夜咲夜.wav","slideTitle":"第19スライド","title":"シーン 19"},{"telop":"「ここが、今日から、あなたの部屋です。\n何かありましたら、お気軽にお申し付けください…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.020.jpeg","voiceCharacter":"十六夜咲夜","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"BCEAF014-47C8-43ED-8A05-80D6EC73EFB8","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.3,"characterName":"十六夜咲夜","voiceDuration":6.614603174603174,"transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_十六夜咲夜.wav","slideTitle":"第20スライド","title":"シーン 20"},{"telop":"彼女はそう何かに言い淀むような言い方をして、部屋を出ていった。すると、誰かが部屋の扉をノックする。「どうぞ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.021.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"F7E663D9-3D03-4E9B-B75C-16513CF4FF14","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.5,"characterName":"操夢","voiceDuration":9.045736961451247,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","slideTitle":"第21スライド","title":"シーン 21"},{"telop":"「おや、今日から新たな住人になった、操夢さんですか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.022.jpeg","voiceCharacter":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"3FDBABFD-6B5C-483D-9FBD-A7B323085507","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"美鈴","voiceDuration":3.9526077097505667,"transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_美鈴.wav","slideTitle":"第22スライド","title":"シーン 22"},{"telop":"「それで、あなたは…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.023.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"85FEA89E-20AE-4B59-A742-60CF6BDA20B0","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"操夢","voiceDuration":1.646984126984127,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","slideTitle":"第23スライド","title":"シーン 23"},{"telop":"「私の名前は、本美鈴です。夕食ができたので、操夢さんを食堂に案内せよと、レミリアが言ってまして…。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.024.jpeg","voiceCharacter":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"42AC3BCE-D9F6-4E30-8DC5-2172F74388F3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5,"characterName":"美鈴","voiceDuration":8.120839002267573,"transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_美鈴.wav","slideTitle":"第24スライド","title":"シーン 24"},{"telop":"「そうですか…、ちょっと待ってください。」\n僕はそう言い、辺りを一瞬見渡す。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.025.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"21CE0AA8-E3AA-41D0-BD76-99F3A95B65D0","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.7,"characterName":"操夢","voiceDuration":5.8894784580498865,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","slideTitle":"第25スライド","title":"シーン 25"},{"telop":"「今から、動いて大丈夫ですよ。」僕はそう返す。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.026.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"3EF38911-53D7-4BBD-B5F8-04E74EBE768D","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"操夢","voiceDuration":4.321995464852607,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","slideTitle":"第26スライド","title":"シーン 26"},{"telop":"「そうですか、それなら案内しましょう。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.027.jpeg","voiceCharacter":"美鈴","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"B2680223-6CE3-4053-B2D0-B3EA59047347","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.4,"characterName":"美鈴","voiceDuration":8.075850340136055,"transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_美鈴.wav","slideTitle":"第27スライド","title":"シーン 27"},{"telop":"そして、僕が食堂に入ると、すでに夕食が配膳されていた。\nそして挨拶を済ますと、皆が食べ始めた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.028.jpeg","voiceCharacter":"操夢","backgroundName":"nc196982_食堂(夜2).png","animationName":"なし","id":"8CF29C0F-8AF6-4CAF-A1EC-57E9E2CC4978","duration":4.6000000000000005,"characterName":"操夢","voiceDuration":8.859478458049887,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","slideTitle":"第28スライド","title":"シーン 28"},{"animationName":"なし","characterName":"ナレーション","title":"シーン 29","duration":3,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"ナレーション","slideTitle":"第29スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"それからしばらくたち…","id":"8599166E-DC27-471E-81AA-BC92EBB2B2AA","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.029.jpeg"},{"telop":"僕が食事を終えて、歯を磨いた後、部屋でくつろいでると、\n再び、部屋の扉がノックされる。「どうぞ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.030.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"C38F4C64-0927-4C7A-9C07-B46D2D5632E2","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.800000000000001,"characterName":"操夢","voiceDuration":8.296984126984126,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","slideTitle":"第30スライド","title":"シーン 30"},{"telop":"すると、入ってきたのはフランだった。\n「どうしたんですか、そんな表情をして？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.031.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"6B573340-19F4-4AF6-B85E-2F923B949EBD","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.8000000000000003,"characterName":"操夢","voiceDuration":5.883219954648526,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","slideTitle":"第31スライド","title":"シーン 31"},{"telop":"「操夢…一緒に、お風呂入ろう…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.032.jpeg","voiceCharacter":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"5304B57B-1215-49F4-AFDA-4D5723CF023A","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"characterName":"フランドール・スカーレット","voiceDuration":2.7819954648526077,"transitionName":"なし","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_フランドール・スカーレット.wav","slideTitle":"第32スライド","title":"シーン 32"},{"telop":"僕は、少し考え込む。そして、彼女が何を言わんとしているかを把握する。「いいですよ。一緒に入っても。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.033.jpeg","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"E65F269C-87F8-422C-9353-14D5E077A081","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5,"characterName":"操夢","voiceDuration":9.044467120181405,"transitionName":"なし","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","slideTitle":"第33スライド","title":"シーン 33"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","telop":"「それじゃあ、先に言って待ってるね！」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（30話目）_9043eff474\/交換夫婦（30話目）_9043eff474.034.jpeg","v