5,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":8.5,"slideTitle":"第38スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"彼らはここで茶を飲み、ここで休息する外に、ここで海水着を洗濯させたり、ここで鹹はゆい身体を清めたり、ここへ帽子や傘を預けたりするのである。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 38","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"3A37375D-CBFA-4479-B8BF-8F762541A38F"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.039.jpeg","voiceDuration":7.021292517006803,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":7.2,"slideTitle":"第39スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"海水着を持たない私にも持物を盗まれる恐れはあったので、\n私は海へはいるたびにその茶屋へ一切を脱ぎ棄てる事にしていた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 39","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"4532A304-E0E4-4B01-965F-64BE8817CF2F"},{"title":"提供","voiceCharacter":"操夢","duration":3,"backgroundName":"単色背景","slideTitle":"中扉","characterName":"操夢","telop":"","animationName":"なし","id":"2B42E342-CD54-4AF2-8455-B2D3F6AA996A","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.040.jpeg","bgmName":"BGM: 東方妖恋談"}]