SD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.009.jpeg","voiceDuration":7.8789115646258505,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":3.5,"slideTitle":"第9スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"その時私はまだ若々しい書生であった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 9","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"BB8FC874-E6CA-411A-BE02-4DF5BB5EF044"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.010.jpeg","voiceDuration":3.7353514739229023,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_ナレーション.wav","bgmName":"BGM: 東方妖恋談","duration":7.9,"slideTitle":"第10スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"暑中休暇を利用して海水浴に行った友達からぜひ来いという端書を受け取ったので、私は多少の金を工面して、出掛ける事にした。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 10","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"CF24F8DE-8C7C-4FDD-925E-93CAA807B572"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.011.jpeg","voiceDuration":1.9756462585034014,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":3.5,"slideTitle":"第11スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"私は金の工面に二、三日を費やした。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 11","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"10843897-77DC-48D6-82EF-67F1878E3CE9"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.012.jpeg","voiceDuration":2.7039002267573697,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":6.9,"slideTitle":"第12スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"ところが私が鎌倉に着いて三日と経たないうちに、私を呼び寄せた友達は、急に国元から帰れという電報を受け取った。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 12","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"1AB7467B-5FC2-4F85-9D0D-43A2A9EB0B3E"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.013.jpeg","voiceDuration":3.473469387755102,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":4.5,"slideTitle":"第13スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"電報には母が病気だからと断って\nあったけれども友達はそれを信じなかった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 13","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"E529FA11-0A9F-4E46-BDBB-798F2462BC7C"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.014.jpeg","voiceDuration":1.9039002267573697,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":4,"slideTitle":"第14スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"友達はかねてから国元にいる親たちに\n勧まない結婚を強いられていた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 14","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"0010C29E-69F1-4E08-A9FF-D72B9AF3C79F"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.015.jpeg","voiceDuration":4.737596371882086,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":3.8000000000000003,"slideTitle":"第15スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"彼は現代の習慣からいうと結婚するにはあまり年が若過ぎた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 15","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"0D509178-5AA4-4DA3-B774-3E2FFE410FC7"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.016.jpeg","voiceDuration":5.560430839002268,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","bgmName":"BGM: 東方妖恋談","duration":3.5,"slideTitle":"第16スライド","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","telop":"それに肝心の当人が気に入らなかった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 16","audioTrack":"track_voice_soumu","voiceCharacter":"操夢","id":"06E9E194-BFB4-4F99-B5F9-B1611CB85D11"},{"slideImagePath":"\/Volume