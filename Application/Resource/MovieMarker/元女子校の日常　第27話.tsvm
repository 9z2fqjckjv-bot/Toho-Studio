[{"id":"1E14F2DB-1CE2-4E9C-AACD-B668B2C820AC","bgmVolume":0.7,"voiceCharacter":"操夢","slideTitle":"スライド #1","transitionName":"なし","seVolume":0.85,"duration":8.636507936507936,"seName":"SE: 木のドアをノック1","voiceDuration":8.636507936507936,"title":"シーン 1","backgroundName":"単色背景","audioTrack":"track_voice_soumu","animationName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":8.11,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"telop":"僕は昼食と歯磨きを済ますと、フランと僕の二人部屋で一人、ベッドに座り、休んでいた。すると部屋の扉がノックされる。\n東方Project二次創作作品","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/木のドアをノック1.mp3"},{"id":"46E5E5B6-2484-4E5E-A079-E255AB8791DC","bgmVolume":0.7,"voiceCharacter":"操夢","slideTitle":"スライド #2","transitionName":"なし","seVolume":0.85,"duration":3.566938775510204,"seName":"SE: ドアを開ける3","voiceDuration":3.566938775510204,"title":"シーン 2","backgroundName":"単色背景","audioTrack":"track_voice_soumu","animationName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":2.15,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"telop":"「どうぞ。」僕がそう言うと、部屋の扉が開く。\n作成者：zuyasi","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/ドアを開ける3.mp3"},{"id":"FB1502D1-AD49-4660-8E41-6E1FC7F56BE5","bgmVolume":0.7,"voiceCharacter":"操夢","slideTitle":"スライド #3","transitionName":"なし","seVolume":1,"duration":3.437596371882086,"voiceDuration":3.437596371882086,"title":"シーン 3: そして、部屋に入ってきたのは、こいしとフランだった。","backgroundName":"単色背景","audioTrack":"track_voice_soumu","animationName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"telop":"そして、部屋に入ってきたのは、こいしとフランだった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav"},{"id":"9555F5EC-1AF9-4E95-9332-F82A61301EE5","bgmVolume":0.7,"voiceCharacter":"古明地こいし","slideTitle":"スライド #4","transitionName":"なし","seVolume":1,"duration":2.6171201814058955,"voiceDuration":2.6171201814058955,"title":"シーン 4","backgroundName":"単色背景","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","animationName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"telop":"「紅夢、一緒に出かけようよ！」\n制作ソフト及び協力\nGemini\nTohoStuido","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地こいし.wav"},{"voiceCharacter":"操夢","title":"シーン 5","id":"EF6DE709-CFE9-4C5A-A248-88182EFA4E42","telop":"「えっ？」僕がそう突如の誘いに戸惑っていると、\nフランが補足説明をする。","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_soumu","voiceDuration":5.395215419501134,"duration":5.395215419501134,"voice2StartTimeOffset":0,"slideTitle":"スライド #5","characterName":"操夢","bgmVolume":0.7,"backgroundName":"単色背景","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","bgmStartTimeOffset":0},{"voiceCharacter":"フランドール・スカーレット","title":"シーン 6","id":"EBCDA6FF-655B-4AD7-8246-47A44C83669F","telop":"「お姉様の許可はとったから、私は、紅夢の意見に任せるよ。」","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":5.156984126984127,"duration":5.156984126984127,"voice2StartTimeOffset":0,"slideTitle":"スライド #6","characterName":"フランドール・スカーレット","bgmVolume":0.7,"backgroundName":"単色背景","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_フランドール・スカーレット.wav","bgmStartTimeOffset":0},{"voiceCharacter":"操夢","title":"シーン 7","id":"DACF1E8C-45EC-48FA-A489-22101540EE45","telop":"「そうですか…、でも大丈夫なんですか？」","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_soumu","voiceDuration":2.514761904761905,"duration":2.514761904761905,"voice2StartTimeOffset":0,"slideTitle":"スライド #7","characterName":"操夢","bgmVolume":0.7,"backgroundName":"単色背景","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","bgmStartTimeOffset":0},{"voiceCharacter":"フランドール・スカーレット","title":"シーン 8","id":"150B767E-A793-48AE-831A-DD69FBA67BF3","telop":"「私が、常にそばにいれば、大丈夫だよ…。」","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":3.7294784580498868,"duration":3.7294784580498868,"voice2StartTimeOffset":0,"slideTitle":"スライド #8","characterName":"フランドール・スカーレット","bgmVolume":0.7,"backgroundName":"単色背景","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav","bgmStartTimeOffset":0},{"voiceCharacter":"操夢","title":"シーン 9","id":"B2EA684F-D742-4F52-9F82-3B412B6A2253","telop":"「分かりました…、それでどこに行きますか？」僕がそう言うと、彼女はある場所の名前を言い、僕たちは家を出るのだった。","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_soumu","voiceDuration":7.689773242630386,"duration":7.689773242630386,"voice2StartTimeOffset":0,"slideTitle":"スライド #9","characterName":"操夢","bgmVolume":0.7,"backgroundName":"単色背景","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","bgmStartTimeOffset":0},{"title":"シーン 10: 東方Project二次創作作品　Powerd By zuyasi","id":"7EB8D0A0-9459-46EA-9F07-1BEE894446EC","telop":"元女子校の日常","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"voice2StartTimeOffset":0,"duration":2.5,"slideTitle":"スライド #10","characterName":"操夢","bgmVolume":0.7,"backgroundName":"単色背景","animationName":"なし","transitionName":"なし","bgmStartTimeOffset":0},{"voiceCharacter":"操夢","title":"シーン 11","id":"24DA55AD-D55C-4CC3-A7F3-AA53D3EBE904","telop":"僕がこいしに連れられ、やってきたのは遊園地だった。\nそして、僕はこいしあれこれと半日の間、連れ回される。","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_soumu","voiceDuration":7.626734693877551,"duration":7.626734693877551,"voice2StartTimeOffset":0,"slideTitle":"スライド #11","characterName":"操夢","bgmVolume":0.7,"backgroundName":"nc310548_遊園地.jpg","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","bgmStartTimeOffset":0},{"voiceCharacter":"操夢","title":"シーン 12","id":"C6F93AB5-A45A-4D53-BC8B-79BF4FA6F9AC","telop":"そして、気がつけば夕日が差し込む時間帯になっていた。\nすると、こいしが観覧車を指差しながら、あることを言う。","voice2Duration":3.6517233560090703,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_soumu","voiceDuration":3.5365079365079364,"voice2Character":"操夢","duration":7.188231292517006,"voice2StartTimeOffset":3.5365079365079364,"slideTitle":"スライド #12","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢_2.wav","characterName":"操夢","bgmVolume":0.7,"backgroundName":"2026-11-15_13-37.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","bgmStartTimeOffset":0},{"voiceCharacter":"古明地こいし","title":"シーン 13","id":"A1FCE6CE-4143-489F-B12A-C3CB0CBF55CD","telop":"「ねぇ、最後に観覧車に乗ろうよ。」","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":2.9983219954648526,"duration":2.9983219954648526,"voice2StartTimeOffset":0,"slideTitle":"スライド #13","characterName":"古明地こいし","bgmVolume":0.7,"backgroundName":"2026-11-15_13-37.png","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_古明地こいし.wav","bgmStartTimeOffset":0},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"5A4F0F94-C45F-4CE7-8F3F-F14D0B98FFE4","backgroundName":"2026-11-15_13-37.png","duration":2.30172335600907,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","voiceCharacter":"操夢","telop":"「それじゃあ、観覧車にのりますか…。」","voiceDuration":2.30172335600907,"seVolume":1,"characterName":"操夢","transitionName":"なし","title":"シーン 14","bgmStartTimeOffset":0,"slideTitle":"スライド #14","audioTrack":"track_voice_soumu"},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"7A9A9433-52B0-41C8-BB6E-E13E013FB411","backgroundName":"2026-11-15_13-37.png","duration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_古明地こいし.wav","voiceCharacter":"古明地こいし","telop":"「うん！」","voiceDuration":1.5,"seVolume":1,"characterName":"古明地こいし","transitionName":"なし","title":"シーン 15","bgmStartTimeOffset":0,"slideTitle":"スライド #15","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97"},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"F81C3D25-E976-4539-B83F-57C9D2F1AD62","backgroundName":"2026-11-15_13-37.png","duration":2.7778231292517006,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voiceCharacter":"操夢","telop":"僕たちは、それから観覧車乗り場に向かう。","voiceDuration":2.7778231292517006,"seVolume":1,"characterName":"操夢","transitionName":"なし","title":"シーン 16","bgmStartTimeOffset":0,"slideTitle":"スライド #16","audioTrack":"track_voice_soumu"},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"D428E4DD-213F-44B3-A5AA-107EB2786831","backgroundName":"nc230674_観覧車の中（夕方）.jpg","duration":3.2560770975056688,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","voiceCharacter":"操夢","telop":"僕たちが観覧車に乗ると、こいしがあることを聞く。","voiceDuration":3.2560770975056688,"seVolume":1,"characterName":"操夢","transitionName":"なし","title":"シーン 17","bgmStartTimeOffset":0,"slideTitle":"スライド #17","audioTrack":"track_voice_soumu"},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"AA57CEAC-5DCB-4B4E-9797-BDEE07F56E88","backgroundName":"nc230674_観覧車の中（夕方）.jpg","duration":2.3809297052154195,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_古明地こいし.wav","voiceCharacter":"古明地こいし","telop":"「遊園地、楽しかった？」","voiceDuration":2.3809297052154195,"seVolume":1,"characterName":"古明地こいし","transitionName":"なし","title":"シーン 18","bgmStartTimeOffset":0,"slideTitle":"スライド #18","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97"},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"35F1D259-2233-4B44-8068-7F4DBAB8E66E","backgroundName":"nc230674_観覧車の中（夕方）.jpg","duration":6.159342403628118,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","voiceCharacter":"操夢","telop":"「まぁまぁ…」僕は、曖昧にそう返す。\n実際のところ、楽しめたとは言い切れなかった。","voiceDuration":6.159342403628118,"seVolume":1,"characterName":"操夢","transitionName":"なし","title":"シーン 19","bgmStartTimeOffset":0,"slideTitle":"スライド #19","audioTrack":"track_voice_soumu"},{"animationName":"なし","voice2StartTimeOffset":0,"bgmVolume":0.7,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"id":"0D4C1DBB-D135-4347-9E9A-4278A497DA36","backgroundName":"nc230674_観覧車の中（夕方）.jpg","duration":1.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_古明地こいし.wav","voiceCharacter":"古明地こいし","telop":"「そう…」","voiceDuration":1.5,"seVolume":1,"characterName":"古明地こいし","transitionName":"なし","title":"シーン 20","bgmStartTimeOffset":0,"slideTitle":"スライド #20","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #21","duration":7.110430839002268,"title":"シーン 21","voiceDuration":7.110430839002268,"id":"3EA68ACE-B372-46CA-B652-19727E0BC529","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"僕たちは、それから観覧車に乗るまでの空気感が一気になくなり、ただ静けさと気まずさだけに包まれていた。"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #22","duration":8.169115646258504,"title":"シーン 22","voiceDuration":8.169115646258504,"id":"988D408C-9070-49DA-8CD0-7F22F28BB313","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"そのまま、観覧車が進み、ちょうど真上にくると、観覧車の動きが突如止まる。僕は、ふと気になって立とうとする。"},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/地震で部屋が揺れる.mp3","backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seName":"SE: 地震で部屋が揺れる","seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #23","duration":7.740861678004535,"title":"シーン 23","voiceDuration":7.740861678004535,"id":"F3B9E980-BD08-42F4-B4F7-78BFFC5BA23E","voice2StartTimeOffset":0,"seVolume":0.85,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"だが、立とうとした習慣に大きな揺れがきて、僕は思わず、前のめりに倒れ、フランと間に手をつくように倒れ込む。"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #24","duration":6.5843310657596374,"title":"シーン 24","voiceDuration":6.5843310657596374,"id":"E4C8E131-00B8-43E5-B21F-CE71CE41C753","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"僕は、はっと気がつくと、元の位置に戻る。\nすると、二人は頬照った状態で固まっていた。"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #25","duration":7.743038548752835,"title":"シーン 25","voiceDuration":7.743038548752835,"id":"109BC1F2-F6B8-43D5-9B37-E613E9686223","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"僕は、戸惑っていると、嫌な予感が走り、反射的にフランとこいしの間に座り込むと、二人の手をぎゅっと掴む。"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #26","duration":5.643038548752834,"title":"シーン 26","voiceDuration":5.643038548752834,"id":"773650A7-7455-4AF2-A341-D2A1138B94EC","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"すると案の定、観覧車の扉が開き、\n明らかに様子がおかしいさとりが入ってきた。"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #27","duration":1.9234693877551021,"title":"シーン 27","voiceDuration":1.9234693877551021,"id":"A39436B9-86DB-480C-BEFC-79F271E5675B","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"「一体、何の用ですか？」"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"古明地さとり","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"古明地さとり","slideTitle":"スライド #28","duration":2.1779818594104308,"title":"シーン 28","voiceDuration":2.1779818594104308,"id":"9C265F20-A845-4DAD-990B-2DD512BDA170","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_古明地さとり.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「そんなこと、決まっているではありませんか。」"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #29","duration":5.534331065759638,"title":"シーン 29","voiceDuration":5.534331065759638,"id":"83BE037F-9194-4929-9629-2A7692F5462B","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"彼女はそう言いながら、こいしに視線を当てる。\n僕は、その隙に彼女を蹴り上げる。"},{"backgroundName":"nc230674_観覧車の中（夕方）.jpg","characterName":"操夢","bgmStartTimeOffset":0,"animationName":"なし","transitionName":"なし","bgmVolume":0.7,"seStartTimeOffset":0,"voiceCharacter":"操夢","slideTitle":"スライド #30","duration":8.400634920634921,"title":"シーン 30","voiceDuration":8.400634920634921,"id":"5DBA3D9F-A806-4078-AE26-F290945D4FFC","voice2StartTimeOffset":0,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"だが、彼女は僕が蹴り上げた足を、強く蹴り返す。\nすると、僕の全身に強い衝撃が入り、気を失ってしまった。"},{"duration":2.589591836734694,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":2.589591836734694,"characterName":"古明地さとり","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_古明地さとり.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"C25AE4B8-5233-49EF-8F00-0660579A8E71","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #31","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","title":"シーン 31","telop":"「ほら、こいし、私と一緒に家に戻りましょ。」","voiceCharacter":"古明地さとり","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":7.953900226757369,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":7.953900226757369,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_サブ.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"62084839-254E-45E5-8E65-3A0578F51AC0","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #32","audioTrack":"track_voice_sub","title":"シーン 32","telop":"私は、ハッとして気がつくと、目の前には怖気付く少女と黒い笑みを浮かべる彼女がいた。そして、状況を察する。","voiceCharacter":"サブ","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":7.662154195011338,"voice2Character":"サブ","transitionName":"なし","bgmVolume":0.7,"voice2StartTimeOffset":4.406077097505669,"voiceDuration":4.406077097505669,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_サブ.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"11105830-7E0C-445A-815D-93ECC1A8BFA9","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #33","audioTrack":"track_voice_sub","title":"シーン 33","telop":"そして、彼女が少女を手で掴みかけると、私はその手を叩く。\nすると、彼女の動作が止まり、表情が変わる。","voiceCharacter":"サブ","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_サブ_2.wav","voice2Duration":3.2560770975056688,"seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":6.527777777777778,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":6.527777777777778,"characterName":"古明地さとり","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_古明地さとり.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"80BB599C-51AF-4021-885A-6552C3F15E6B","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #34","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","title":"シーン 34","telop":"「おや、手出しをしなければ、私は黙っていたんですがね…、仕方ありません。今日のところは引き上げましょう。では失礼。」","voiceCharacter":"古明地さとり","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":5.254988662131519,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":5.254988662131519,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_サブ.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"640DA09D-7E65-4D91-8521-722B40463E1C","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #35","audioTrack":"track_voice_sub","title":"シーン 35","telop":"彼女がそう言って、立ち去ると、\n席の片隅で固まっていた彼女が話し出す。","voiceCharacter":"サブ","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":5.079478458049887,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":5.079478458049887,"characterName":"フランドール・スカーレット","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_フランドール・スカーレット.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"419BB408-7037-4EDD-8CF1-36D0DBFF21FE","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #36","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","title":"シーン 36","telop":"「ごめんなさい…、私…、彼女に心が読まれて、抑止された…」","voiceCharacter":"フランドール・スカーレット","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":3.6539002267573695,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":3.6539002267573695,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_サブ.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"4C99E44B-E4B5-48EC-A078-9D74C16260E1","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #37","audioTrack":"track_voice_sub","title":"シーン 37","telop":"彼女がそう言っていると、観覧車が再び動き始めた。","voiceCharacter":"サブ","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc393553_【東方アレンジ】少女さとり【バロック風】.wav","animationNote":"5秒","duration":5,"bgmVolume":0.65,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","bgmStartTimeOffset":0,"bgmName":"BGM: nc393553_【東方アレンジ】少女さとり【バロック風】","seVolume":1,"id":"37E6C959-0981-460D-AF05-C28A8F4122A6","backgroundName":"nc230674_観覧車の中（夕方）.jpg","slideTitle":"スライド #38","animationDuration":5,"title":"シーン 38","telop":"何者かに乗っ取られた状態\nさとりが邪道派の襲撃によって、拉致されると、突如としてフランたちの家にいたこいしの元を訪ねる。彼女のその表情は、暗闇とも言える影に覆われ、1度目は、彼が彼女を気絶させ、正気に戻すも2度目は、意味深なセリフを残し、その場から去っていった。\n黒いさとり","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":8.065419501133787,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":8.065419501133787,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_サブ.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"AC045B1B-4F01-4E8B-86C0-0678CF4FA7DC","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #39","audioTrack":"track_voice_sub","title":"シーン 39","telop":"あれから、私たちはフランの家に戻ってくると、夕方の出来事とその出来事から推測できる事象をレミリアに伝えていた。","voiceCharacter":"サブ","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"duration":8.521315192743764,"bgmVolume":0.7,"transitionName":"なし","voice2StartTimeOffset":0,"voiceDuration":8.521315192743764,"characterName":"レミリア・スカーレット","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_レミリア・スカーレット.wav","bgmStartTimeOffset":0,"seVolume":1,"id":"14545054-5EB7-43DC-9E8B-49A0D2BB3E78","backgroundName":"nc107556_紅魔的館内.jpg","slideTitle":"スライド #40","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","title":"シーン 40","telop":"「これは、私の責任よ。私が外出を許可したばかりに…。にしても、厄介ね…、グループ内の派閥争いっていうものは…。」","voiceCharacter":"レミリア・スカーレット","seStartTimeOffset":0,"voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_サブ.wav","seStartTimeOffset":0,"voiceDuration":8.169115646258504,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"サブ","duration":8.169115646258504,"audioTrack":"track_voice_sub","animationName":"なし","slideTitle":"スライド #41","title":"シーン 41","id":"E760474F-7689-4CDB-8694-D658F684BA5D","characterName":"サブ","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「とりあえず、彼女は再び、こいしの元に現れると言ってましたから、しばらくの間は、誰か護衛をつけた方がいいですよ。」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_レミリア・スカーレット.wav","seStartTimeOffset":0,"voiceDuration":4.987414965986394,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","duration":4.987414965986394,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"スライド #42","title":"シーン 42","id":"1C827F84-10B7-4DDF-BF81-EB7C904C162D","characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「ごめんなさいね…、あなたに頼るつもりはなかったけど、\nこんなことになってしまって…。」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_サブ.wav","seStartTimeOffset":0,"voiceDuration":7.022380952380952,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"サブ","duration":7.022380952380952,"audioTrack":"track_voice_sub","animationName":"なし","slideTitle":"スライド #43","title":"シーン 43","id":"7650C44D-8011-4F0E-9CEE-2A62B73ABFB5","characterName":"サブ","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「きっと次来る時も、向こうはあなたたちが吸血鬼であることを逆手にとって、逆らえないようにしてきますよ。」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_レミリア・スカーレット.wav","seStartTimeOffset":0,"voiceDuration":8.142154195011338,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","duration":8.142154195011338,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"スライド #44","title":"シーン 44","id":"99F86D68-BC47-42A5-9939-EE252A1C9D89","characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「確かに、でもあなたは大丈夫なの？文脈から察するに、あなたの存在に関する情報が、向こうに流れるみたいだけど？」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_サブ.wav","seStartTimeOffset":0,"voiceDuration":8.382154195011339,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"サブ","duration":8.382154195011339,"audioTrack":"track_voice_sub","animationName":"なし","slideTitle":"スライド #45","title":"シーン 45","id":"1442E31F-2384-4207-A68B-E317905B56EF","characterName":"サブ","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「それは…、別に構いませんよ。ただ、彼女に従えば、吸血鬼という情報が流れ出さないなんていう保証はありませんよ。」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_サブ.wav","seStartTimeOffset":0,"voiceDuration":6.358253968253968,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"サブ","duration":6.358253968253968,"audioTrack":"track_voice_sub","animationName":"なし","slideTitle":"スライド #46","title":"シーン 46","id":"ED156E6F-EC62-4CA5-81E6-B830DC78C672","characterName":"サブ","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「その上で、この派閥争いを鎮めて、\n次のステップに踏むべきだと、私は感じますがね…。」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_レミリア・スカーレット.wav","seStartTimeOffset":0,"voiceDuration":4.183832199546485,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","duration":4.183832199546485,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","animationName":"なし","slideTitle":"スライド #47","title":"シーン 47","id":"5D17DFCA-678C-4C99-BF86-0DBA261F2853","characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"「確かにあなたのいうとおりね…。\nとりあえず、夕飯にしましょうか。」","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_サブ.wav","seStartTimeOffset":0,"voiceDuration":9.059342403628118,"backgroundName":"nc107556_紅魔的館内.jpg","voiceCharacter":"サブ","duration":9.059342403628118,"audioTrack":"track_voice_sub","animationName":"なし","slideTitle":"スライド #48","title":"シーン 48","id":"483277E6-38D2-4F92-911F-903D9A190531","characterName":"サブ","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"彼女はそう言い、部屋をさると、私も出る。そして、食事が終わると霊の如く、全身に衝撃が入り、彼が出てくるのだった。","voiceStartTimeOffset":0},{"animationNote":"5秒","seStartTimeOffset":0,"backgroundName":"nc107556_紅魔的館内.jpg","bgmName":"BGM: Mellotron Flute森近霖之助テーマ曲_1","duration":5,"bgmAudioPath":"\/Users\/zuyasi\/Music\/Logic\/Mellotron Flute森近霖之助テーマ曲_1.aif","animationName":"なし","slideTitle":"スライド #49","title":"シーン 49","id":"21C8EED9-FDD9-4BF9-90A2-0736F48E8FA0","characterName":"博麗霊夢","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.65,"seVolume":1,"animationDuration":5,"voice2StartTimeOffset":0,"telop":"？\n霊夢の母に霖之助と呼ばれていた。そして、後継に困る彼女に、後継を手配するともに、地下底国グループの内部分裂の情報、謎の封筒を手渡していた。そして、霊夢に封筒の中身が賄賂ではないかと聞かれると、賄賂ではないと言っていた。謎多き人物。\n？","voiceStartTimeOffset":0},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","seStartTimeOffset":0,"voiceDuration":8.085419501133787,"backgroundName":"nc196982_食堂(夜2).png","voiceCharacter":"操夢","duration":8.085419501133787,"audioTrack":"track_voice_soumu","animationName":"なし","slideTitle":"スライド #50","title":"シーン 50","id":"7B032AEF-29CA-41CC-9371-CD4D3469FAEF","characterName":"操夢","bgmStartTimeOffset":0,"transitionName":"なし","bgmVolume":0.7,"seVolume":1,"voice2StartTimeOffset":0,"telop":"僕はふと気がつくと、そこは食堂だった。すると、こいしが驚いた様子で僕を見る。「どうしたんですか、こいしさん？」","voiceStartTimeOffset":0},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"DFD84ACC-F51B-40BE-9642-54CD4BD3701F","voiceStartTimeOffset":0,"slideTitle":"スライド #51","title":"シーン 51","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","duration":1.5,"telop":"「何でもないよ。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","seStartTimeOffset":0,"voiceDuration":1.5,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"913EF2FF-0CD2-4484-B57E-49F21D0085AB","voiceStartTimeOffset":0,"slideTitle":"スライド #52","title":"シーン 52","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"nc196982_食堂(夜2).png","duration":7.783242630385487,"telop":"「そうですか…」僕はそう呟くと、既に空になっている食器を片付け、歯を磨くと、そのまま二人部屋に向かった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","seStartTimeOffset":0,"voiceDuration":7.783242630385487,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"4B14EE63-77C4-4AC2-AAAC-23C72E403855","voiceStartTimeOffset":0,"slideTitle":"スライド #53","title":"シーン 53","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","duration":3.3082539682539682,"telop":"僕が二人部屋に来ると、こいしがあることを聞いてくる。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","seStartTimeOffset":0,"voiceDuration":3.3082539682539682,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","id":"6BFBD9DB-F332-4305-8CA6-5B53F49B36A5","voiceStartTimeOffset":0,"slideTitle":"スライド #54","title":"シーン 54","voice2StartTimeOffset":0,"voiceCharacter":"古明地こいし","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","duration":3.973469387755102,"telop":"「ねぇ、紅夢くんは誰か、好きな人はいるの？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_古明地こいし.wav","seStartTimeOffset":0,"voiceDuration":3.973469387755102,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"FFAA70F0-77D2-4B8D-B20C-27EC25CD55D1","voiceStartTimeOffset":0,"slideTitle":"スライド #55","title":"シーン 55","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","duration":9.190861678004536,"telop":"「えっ？」僕は、思わずそう返す。だが、しばらく考えてからいう。「この部屋は、元々フランと僕の二人部屋だったんですよ。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","seStartTimeOffset":0,"voiceDuration":9.190861678004536,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"7882F66B-AF23-4BD8-8514-05B9049AFC56","voiceStartTimeOffset":0,"slideTitle":"スライド #56","title":"シーン 56","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","duration":5.847369614512472,"telop":"僕がそういうと、彼女の頬が頰照る。\n「僕は、単純にただ事実を述べただけですけど…。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","seStartTimeOffset":0,"voiceDuration":5.847369614512472,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","id":"25505374-4FBA-4732-BEF0-6ED8963D4226","voiceStartTimeOffset":0,"slideTitle":"スライド #57","title":"シーン 57","voice2StartTimeOffset":0,"voiceCharacter":"古明地こいし","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","duration":1.8988888888888888,"telop":"「あなた、馬鹿なの？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_古明地こいし.wav","seStartTimeOffset":0,"voiceDuration":1.8988888888888888,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"93BED824-C0D3-42AD-8B8B-CA80B80BD6CD","voiceStartTimeOffset":0,"slideTitle":"スライド #58","title":"シーン 58","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/衣擦れ2.mp3","seVolume":2,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"2026-10-26_19-50.png","duration":5.222380952380952,"seName":"SE: 衣擦れ2","telop":"「えっ？」僕は、そう返すと、\n彼女は黙って、僕をベッドに押し倒す。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","seStartTimeOffset":3.45,"voiceDuration":5.222380952380952,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","id":"7C485D1E-E27E-4F6F-BD2A-77E98F13439A","voiceStartTimeOffset":0,"slideTitle":"スライド #59","title":"シーン 59","voice2StartTimeOffset":0,"voiceCharacter":"古明地こいし","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","duration":3.8270521541950115,"telop":"「もういい、あんたに私の気持ちを分からせるわ。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_古明地こいし.wav","seStartTimeOffset":0,"voiceDuration":3.8270521541950115,"animationName":"なし"},{"bgmVolume":0.7,"characterName":"操夢","audioTrack":"track_voice_soumu","id":"0922B846-4B5D-46F7-B6FB-7C7177177D7A","voiceStartTimeOffset":0,"slideTitle":"スライド #60","title":"シーン 60","voice2StartTimeOffset":0,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"transitionName":"なし","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","duration":4.421292517006803,"telop":"僕は、彼女の突如の変化に戸惑いながらも、そっとキスをする。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","seStartTimeOffset":0,"voiceDuration":4.421292517006803,"animationName":"なし"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #61","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav","transitionName":"なし","voiceDuration":8.225646258503401,"telop":"すると、彼女の全身が頬照ったように赤みを帯び、固まってしまう。僕は、その彼女の手を取り、ある存在を示す。","characterName":"操夢","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"D8B14C49-15CB-4DC5-88BB-8D7CB10973BF","duration":8.225646258503401,"title":"シーン 61","voiceCharacter":"操夢"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #62","seName":"SE: 重いパンチ2","seVolume":1.5078125,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":6.13,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","transitionName":"なし","voiceDuration":8.486507936507936,"telop":"すると、彼女はますます赤く染まっていき、僕を押し倒したことを疑うくらいになっていた。だが、彼女は強烈なビンタをする。","characterName":"操夢","audioTrack":"track_voice_soumu","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/重いパンチ2.mp3","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"9C00B2B8-B03D-4A3B-A26D-D62599C02E2E","duration":8.486507936507936,"title":"シーン 62","voiceCharacter":"操夢"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #63","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_古明地こいし.wav","transitionName":"なし","voiceDuration":3.197233560090703,"telop":"「あんた、今まで私を騙してたの！」","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"9FFA7AE8-17A7-433A-8D36-63239F71413C","duration":3.197233560090703,"title":"シーン 63","voiceCharacter":"古明地こいし"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #64","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","transitionName":"なし","voiceDuration":8.30607709750567,"telop":"「いえ、僕は戸籍上は男ですが、医者からは生まれつき、女性と男性、双方の臓器や体の部位があるって言われたんです。」","characterName":"操夢","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"18668344-3096-46EF-97D9-85923AA2EBAF","duration":8.30607709750567,"title":"シーン 64","voiceCharacter":"操夢"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #65","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_古明地こいし.wav","transitionName":"なし","voiceDuration":5.567392290249433,"telop":"「何、それどういうこと？あんたは男と女、どっちなの？」","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"15BC8CE6-3AA2-402B-BEA7-09F02F9BDE3D","duration":5.567392290249433,"title":"シーン 65","voiceCharacter":"古明地こいし"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #66","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","transitionName":"なし","voiceDuration":7.714761904761905,"telop":"「性別の判断基準は分かりませんが、僕は小さい頃から男として今まで、生きてきましたよ、記憶の限りでは。」","characterName":"操夢","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"9146207C-E5B3-4A15-B09A-BAAE58510CDD","duration":7.714761904761905,"title":"シーン 66","voiceCharacter":"操夢"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #67","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_古明地こいし.wav","transitionName":"なし","voiceDuration":5.003854875283447,"telop":"「ふぅん…、まぁいいわ…、\nあなたを奪うことには変わりはないのだから。」","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"96B476CF-25CE-4FFE-B0D8-9ECC73012831","duration":5.003854875283447,"title":"シーン 67","voiceCharacter":"古明地こいし"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #68","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_古明地こいし.wav","transitionName":"なし","voiceDuration":8.843628117913832,"telop":"「それでどうしますか、このままいきますか？\n僕は、特殊な体つきなので、子どもはできないですけど。」","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"D12FA775-46C0-4831-8A8E-70EE7D1CD662","duration":8.843628117913832,"title":"シーン 68","voiceCharacter":"古明地こいし"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #69","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","transitionName":"なし","voiceDuration":2.9473696145124717,"telop":"すると彼女は再び赤らみを帯びて、驚く。","characterName":"操夢","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"6222E2A3-A994-468B-89AF-2CAF558E87F5","duration":2.9473696145124717,"title":"シーン 69","voiceCharacter":"操夢"},{"bgmStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #70","seVolume":1,"backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_古明地こいし.wav","transitionName":"なし","voiceDuration":9.503854875283446,"telop":"「そんなことどうだっていいわ、あなたが私をその気にさせたんだから。何かあっても、絶対に責任とってよね。」","characterName":"古明地こいし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"animationName":"なし","id":"DC8D2EF5-14F4-459D-9816-EA3B28D2F266","duration":9.503854875283446,"title":"シーン 70","voiceCharacter":"古明地こいし"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","id":"16FE07EA-B620-4415-9B23-B7042CA566C7","slideTitle":"スライド #71","transitionName":"なし","bgmVolume":0.7,"animationName":"なし","duration":3.3484580498866214,"title":"シーン 71","bgmStartTimeOffset":0,"voiceDuration":3.3484580498866214,"voiceCharacter":"操夢","audioTrack":"track_voice_soumu","voice2StartTimeOffset":0,"characterName":"操夢","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","seStartTimeOffset":0,"seVolume":1,"telop":"彼女はそういうと、無理やり僕の服を脱がすのだった。","voiceStartTimeOffset":0},{"id":"29FE5485-C29C-4E95-810C-B8FA46DF73B1","slideTitle":"中扉","transitionName":"なし","bgmVolume":0.7,"animationName":"なし","bgmStartTimeOffset":0,"title":"シーン 72: ご視聴ありがとうございました！","duration":20,"voice2StartTimeOffset":0,"characterName":"","backgroundName":"単色背景","seStartTimeOffset":0,"seVolume":1,"telop":"","voiceStartTimeOffset":0}]