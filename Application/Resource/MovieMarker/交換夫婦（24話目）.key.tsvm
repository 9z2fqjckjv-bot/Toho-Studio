[{"title":"シーン 1","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_八雲紫.wav","telop":"私が、記者会見中ふと、周りを見ると、橙が私に視線を向けていることに気がつき、彼女に小声で言う。「どうしたのよ、橙。」","duration":6,"animationName":"なし","slideTitle":"第1スライド","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.001.jpeg","voiceCharacter":"八雲紫","transitionName":"クロスディゾルブ","voiceDuration":1.2600226757369615,"bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"八雲紫","id":"8298C74D-705C-4A91-9BDB-DDFD78937E5C"},{"title":"シーン 2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_橙.wav","telop":"「えっと…円球機械室を見回りしたものが、誰かが、円球の権限を乗っ取り、遠隔操作しているって…騒いでいて…」","duration":5.300000000000001,"animationName":"なし","slideTitle":"第2スライド","audioTrack":"track_voice_%E6%A9%99","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.002.jpeg","voiceCharacter":"橙","transitionName":"クロスディゾルブ","voiceDuration":7.360702947845805,"bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"橙","id":"9A9ECEF8-C2EE-4864-B06E-BF0905059202"},{"title":"シーン 3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_八雲紫.wav","telop":"私は、その一言に嫌な予感し、\n橙に会見の続きを任せて、そのまま円球機械室に向かう。","duration":4,"animationName":"なし","slideTitle":"第3スライド","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第