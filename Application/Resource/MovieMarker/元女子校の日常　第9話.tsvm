[{"characterName":"サブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_サブ.wav","title":"シーン 1","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"私が、テレビに映っていた場所に来ると、そこでは、彼女が箒に跨って空を飛び回りながら、ビームを周囲に放っていた。\n東方Project二次創作作品","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.001.jpeg","duration":9.209999999999999,"voiceCharacter":"サブ","voiceDuration":8.61,"slideTitle":"スライド #1","audioTrack":"track_voice_sub","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"C5CE9625-E471-4286-B208-C4F0E63E0F73"},{"characterName":"サブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_サブ.wav","title":"シーン 2","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"そして、ふと周りを見ると、父が困惑しながら、\nひたすらにそのビームを避けている様子だった。\n作成者：zuyasi","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.002.jpeg","duration":6.6506349206349205,"voiceCharacter":"サブ","voiceDuration":6.050634920634921,"slideTitle":"スライド #2","audioTrack":"track_voice_sub","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"EC557C6F-9235-48DF-BF58-97488D005788"},{"characterName":"サブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_サブ.wav","title":"シーン 3: すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.003.jpeg","duration":9.561519274376417,"voiceCharacter":"サブ","voiceDuration":8.961519274376418,"slideTitle":"スライド #3","audioTrack":"track_voice_sub","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"125C75F0-6699-451B-BB34-27A6E9684C35"},{"characterName":"サブ","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_サブ.wav","title":"シーン 4","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"だが、空腹に抗えるわけでもなく、私はある飲食店に入った。\n制作ソフト及び協力\nGemini\nTohoStuido","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.004.jpeg","duration":5.174557823129251,"voiceCharacter":"サブ","voiceDuration":4.574557823129251,"slideTitle":"スライド #4","audioTrack":"track_voice_sub","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"2675FCDE-3490-4980-A673-F63445C9C648"},{"characterName":"操夢","title":"シーン 5: 東方Project二次創作作品　Powerd By zuyasi　※久々の100スライド越えの122スライドです。","transitionName":"なし","backgroundName":"単色背景","telop":"元女子校の日常","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.005.jpeg","duration":3,"slideTitle":"スライド #5","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"F173123A-EDEF-44AA-8DEC-D0153C29062E"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","title":"シーン 6","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「んっ…」僕は、ふと気がつくと、そこは夜の街中だった。\nそして、ふと周りを見渡していると、魔理沙さんと父が見える。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.006.jpeg","duration":9.146303854875283,"voiceCharacter":"操夢","voiceDuration":8.546303854875283,"slideTitle":"スライド #6","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"EF33347F-D420-4687-8AD9-37855CBDD46A"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","title":"シーン 7","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"ふともう一度見ると、魔理沙さんはビームを父やビルに向かって乱射するように放ち、父はそれを困った表情で避けていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.007.jpeg","duration":8.290430839002267,"voiceCharacter":"操夢","voiceDuration":7.690430839002268,"slideTitle":"スライド #7","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"51F70788-D5E5-449F-8F52-A2BD86BB30BF"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","title":"シーン 8: シーン 9","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"すると、後ろから僕の肩が叩かれる。その方向に振り向くと、この前、夜の学校の廊下で会った女性だった。「こんばんは。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.009.jpeg","duration":9.487596371882086,"voiceCharacter":"操夢","voiceDuration":8.887596371882086,"slideTitle":"スライド #8","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"C0355E9D-46B6-4353-A65E-CF38B87A046C"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_フランドール・スカーレット.wav","title":"シーン 9: シーン 10","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「こんばんは。こんなところで、どうしたの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.010.jpeg","duration":4.0869841269841265,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.486984126984127,"slideTitle":"スライド #9","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"A8C0E411-497A-4652-9E8E-2E945DAE7006"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","title":"シーン 10: シーン 11","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「えっと…」僕はそう言い、なぜ自分がこんな場所に来たかを思い出そうとするが、思い出せない。「分からないです…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.011.jpeg","duration":7.9071655328798185,"voiceCharacter":"操夢","voiceDuration":7.307165532879819,"slideTitle":"スライド #10","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"A6D215BB-07A7-4A55-871A-E48005F1F6F7"},{"characterName":"操夢","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_011_操夢.wav","title":"シーン 11: シーン 12","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「そう、それより、あなたは、これから、何かの予定はある？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.012.jpeg","duration":4.786507936507936,"voiceCharacter":"操夢","voiceDuration":4.186507936507937,"slideTitle":"スライド #11","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"A1349245-A7CA-4CFE-ABDE-482E68AE933B"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","title":"シーン 12: シーン 13","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「えっと…ないです…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.013.jpeg","duration":2.5,"voiceCharacter":"操夢","voiceDuration":1.5,"slideTitle":"スライド #12","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"5E745910-DF05-4719-B191-C5E6847CC267"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_フランドール・スカーレット.wav","title":"シーン 13: シーン 14","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「そう、なら私と一緒に、夜の街を歩いてみない？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.014.jpeg","duration":4.776984126984127,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.176984126984127,"slideTitle":"スライド #13","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"6A8E2C9D-C422-46A0-B7FB-E8B4262E38A4"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","title":"シーン 14: シーン 15","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「えっと…」僕は、彼女からの誘いに、どう返そうか考えていると、誰かがビルに激突し、僕はその方を見る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.015.jpeg","duration":8.424557823129252,"voiceCharacter":"操夢","voiceDuration":7.824557823129251,"slideTitle":"スライド #14","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"057784DB-A209-4107-BE43-0390A5F44C26"},{"characterName":"妹紅","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_015_妹紅.wav","title":"シーン 15: シーン 16","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「痛てぇ…、ついよそ見をしちまったぜ…」私は、彼女からのビームが来ているのにも関わらず、逆ナンを受けている息子を見た。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.016.jpeg","duration":8.27249433106576,"voiceCharacter":"妹紅","voiceDuration":7.67249433106576,"slideTitle":"スライド #15","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"8A974B48-9D71-42D7-BB5D-0FD19A7FE9C9"},{"characterName":"霧雨魔理沙","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_霧雨魔理沙.wav","title":"シーン 16: シーン 17","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「二ヒヒィ、まだまだ足りないぜ…。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.017.jpeg","duration":3.059478458049887,"voiceCharacter":"霧雨魔理沙","voiceDuration":2.4594784580498867,"slideTitle":"スライド #16","audioTrack":"track_voice_marisa","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"3C98E417-3770-4176-B060-336273CA0DE0"},{"characterName":"妹紅","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_妹紅.wav","title":"シーン 17: シーン 18","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「くっ…」私には、息子にサインを送る余裕もなく、\n彼女からやってくるビームを再び、避け始めた。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.018.jpeg","duration":7.318321995464852,"voiceCharacter":"妹紅","voiceDuration":6.718321995464852,"slideTitle":"スライド #17","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"9A9413FB-9A36-4134-9841-506775C497CC"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav","title":"シーン 18: シーン 19","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「それで、どう。私と一緒に夜の街をお散歩する？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.019.jpeg","duration":5.104489795918367,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.504489795918367,"slideTitle":"スライド #18","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"B6D291CC-FB30-40FE-BC27-72B9DAB66595"},{"characterName":"操夢","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_019_操夢.wav","title":"シーン 19: シーン 20","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「いや、今用事を思い出したので、\nそれを済ませたら、家に帰ります。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.020.jpeg","duration":5.253900226757369,"voiceCharacter":"操夢","voiceDuration":4.6539002267573695,"slideTitle":"スライド #19","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"982D753D-5E36-453B-AB92-1877A02DB293"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav","title":"シーン 20: シーン 21","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「そう…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.021.jpeg","duration":2.5,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.5,"slideTitle":"スライド #20","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"316B26FA-92ED-47E3-AFA5-A76FE827D89A"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","title":"シーン 21: シーン 22","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"僕は、その彼女の表情を見ると、なんだか断るのは、申し訳なく感じてくる。「散歩とは違いますが…僕の用事に付き合ってくれませんか…？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.022.jpeg","duration":10.388684807256235,"voiceCharacter":"操夢","voiceDuration":9.788684807256235,"slideTitle":"スライド #21","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"DEC876FF-B9AA-46BE-BC86-9EE2A8965081"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav","title":"シーン 22: シーン 23","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「ありがとう！」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.023.jpeg","duration":2.5,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.5,"slideTitle":"スライド #22","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"65A25B6B-2FE3-4389-B3D4-AC8AD5B323A6"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","title":"シーン 23: シーン 24","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"僕は、そう彼女が笑うと、どこかで見たことのあるようなその表情に、過去を思い出しながら、一緒に歩き始めた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.024.jpeg","duration":8.256077097505669,"voiceCharacter":"操夢","voiceDuration":7.656077097505669,"slideTitle":"スライド #23","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"F64B4662-C15F-43BA-9E3F-39635B4D12C9"},{"characterName":"美鈴","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_美鈴.wav","title":"シーン 24: シーン 25","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"私が、その場所につき、そっと影から覗くと、一方の男女は戦い、もう一方の男女は一緒にどこかに歩き出していた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.025.jpeg","duration":6.182721088435374,"voiceCharacter":"美鈴","voiceDuration":5.582721088435374,"slideTitle":"スライド #24","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"0B129A30-4712-44DC-B167-5F045D45BEAF"},{"characterName":"美鈴","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_美鈴.wav","title":"シーン 25: シーン 26","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"「一体、何があったんでしょうか…」私は、そう呟く。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.026.jpeg","duration":3.2998185941043086,"voiceCharacter":"美鈴","voiceDuration":2.6998185941043085,"slideTitle":"スライド #25","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"2237EAEB-74D9-41CF-B7E4-868DAC8B84E2"},{"characterName":"美鈴","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_美鈴.wav","title":"シーン 26: シーン 27","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"だが、歩き出した二人の方は、あっという間に姿が消え、残ったのは、元学園生の霧雨魔理沙とある男性だけだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.027.jpeg","duration":6.154421768707483,"voiceCharacter":"美鈴","voiceDuration":5.554421768707483,"slideTitle":"スライド #26","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"4B9D5937-2FDE-4A4C-958A-A6EAAD699DFD"},{"characterName":"フランドール・スカーレット","title":"シーン 27: シーン 28","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"歩き始めたフランと彼は…","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.028.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"slideTitle":"スライド #27","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"6994A455-DF7B-4B0F-8397-D7B684BFCE52"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","title":"シーン 28: シーン 29","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕とその女性、フランさんはあるスーパーに寄って行った。\n冷蔵庫がスカスカなために、買い出しにやって来た。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.029.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.535419501133786,"voiceCharacter":"操夢","voiceDuration":6.9354195011337865,"slideTitle":"スライド #28","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"E2EE98E1-DE54-49E5-9865-687932A5C7E3"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","title":"シーン 29: シーン 30","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そういえば、フランさんって、過去に僕と会ってましたか？」\n僕は、過去の記憶を確かめるために、彼女にそう尋ねる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.030.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":8.702811791383219,"voiceCharacter":"操夢","voiceDuration":8.10281179138322,"slideTitle":"スライド #29","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"E3DF9202-FBD4-4C69-B55E-500E71FCECD6"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_フランドール・スカーレット.wav","title":"シーン 30: シーン 31","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「さあ、どうだろうね。あなたは、思い出せるかしら…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.031.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.901995464852607,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.301995464852608,"slideTitle":"スライド #30","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","seVolume":1,"animationName":"なし","id":"C33CD93E-2792-4F5B-8878-2624FE41D2B3"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","title":"シーン 31: シーン 32","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、その彼女の表情を見て、僕がそれを思い出すまでは、答えなささそうなので、献立を考え、食材を見ていく。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.032.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":8.866938775510203,"voiceCharacter":"操夢","voiceDuration":8.266938775510203,"slideTitle":"スライド #31","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","seVolume":1,"animationName":"なし","id":"0D543E82-2AF0-47E8-9CC5-FDDF0C55E5FB"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","title":"シーン 32: シーン 33","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「フランさんは、夕飯はもう食べましたか？」\n僕はそう彼女に聞く。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.033.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.1778231292517,"voiceCharacter":"操夢","voiceDuration":4.5778231292517,"slideTitle":"スライド #32","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","seVolume":1,"animationName":"なし","id":"F816C5E6-DCE3-4801-A856-B69EEAC5AE41"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_フランドール・スカーレット.wav","title":"シーン 33: シーン 34","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「いや…まだ食べてないよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.034.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":2.619478458049887,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.019478458049887,"slideTitle":"スライド #33","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"5B5F944A-7CE4-423C-8EBD-C29ADD9BB51F"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","title":"シーン 34: シーン 35","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「何か、食べたい料理とかってありますか？僕は、親にガスコンロは危ないから使うなって言われてますが…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.035.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.506077097505669,"voiceCharacter":"操夢","voiceDuration":6.906077097505669,"slideTitle":"スライド #34","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"7DEB68BC-16D6-47FF-825B-594A3CD31564"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_フランドール・スカーレット.wav","title":"シーン 35: シーン 36","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そう…、もしあれだったら、私も手伝うよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.036.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.1394784580498865,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.539478458049887,"slideTitle":"スライド #35","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"DD68429E-D8D1-4242-B95E-D03993748E7B"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","title":"シーン 36: シーン 37","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…、何か食べたい物はありますか…？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.037.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.4973696145124715,"voiceCharacter":"操夢","voiceDuration":2.8973696145124714,"slideTitle":"スライド #36","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"B0CBA370-E2B0-4824-8C94-E432F39182C9"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_フランドール・スカーレット.wav","title":"シーン 37: シーン 38","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「どうしようかな…、あなたは何か得意な料理でもあるの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.038.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.641995464852608,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.041995464852608,"slideTitle":"スライド #37","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"E75BBB5D-B3CB-444B-8349-B30D551B833F"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","title":"シーン 38: シーン 39","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「得意な料理ですか…、強いていえば、ガスコンロと包丁を使わない料理だったら、僕でもできますよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.039.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.062607709750567,"voiceCharacter":"操夢","voiceDuration":6.462607709750567,"slideTitle":"スライド #38","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"F993FF01-E0EA-4806-A46A-808A86C12321"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_フランドール・スカーレット.wav","title":"シーン 39: シーン 40","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そう…、なら…リゾットはどう？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.040.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.056984126984127,"voiceCharacter":"フランドール・スカーレット","voiceDuration":2.456984126984127,"slideTitle":"スライド #39","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"FB177F85-BD32-4A09-8273-CD5A22373CF6"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","title":"シーン 40: シーン 41","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「リゾットですか…」僕はそう言いながら、献立を思いつく。\nそして、目的の食材がある売り場に向かう。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.041.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.743038548752834,"voiceCharacter":"操夢","voiceDuration":7.143038548752834,"slideTitle":"スライド #40","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"973C6EDB-3A82-4071-9976-F06BAF88ABDB"},{"characterName":"操夢","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_041_操夢.wav","title":"シーン 41: シーン 42","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、サバ味噌煮缶とチーズ、パックご飯をカゴに入れて歩く。\nそして、去り際に、ふりかけが目に入り、それもカゴに入れる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.042.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.216938775510204,"voiceCharacter":"操夢","voiceDuration":8.616938775510205,"slideTitle":"スライド #41","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"980F906D-C1C2-47ED-B3AE-12E0E432152B"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","title":"シーン 42: シーン 43","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、卵売り場に向かい、卵を手に取る。ふと、振り返ると、彼女の姿が見えなかった。僕は、彼女を探す。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.043.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.365850340136054,"voiceCharacter":"操夢","voiceDuration":8.765850340136055,"slideTitle":"スライド #42","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"E8724753-4FBD-419A-9A7E-81B519B352DE"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","title":"シーン 43: シーン 44","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕が、彼女を探し、ワインの売り場に来ると、彼女はあるワインを見つめていた。「それ、飲みたいんですか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.044.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.656077097505668,"voiceCharacter":"操夢","voiceDuration":7.056077097505669,"slideTitle":"スライド #43","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"D973ADD7-4935-430F-9F82-7476354A1E0E"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_フランドール・スカーレット.wav","title":"シーン 44: シーン 45","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「なんだか、良さげなワイン見つけちゃって…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.045.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.618231292517007,"voiceCharacter":"フランドール・スカーレット","voiceDuration":3.0182312925170067,"slideTitle":"スライド #44","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"2D451CC9-B9AB-40B9-A807-DFB30D606B2D"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","title":"シーン 45: シーン 46","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…」僕は、そう言い考える、ここでワインを買って行ってもいいが、母がそれ見たら、どんな反応をするかと…。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.046.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":8.286507936507936,"voiceCharacter":"操夢","voiceDuration":7.686507936507937,"slideTitle":"スライド #45","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"A14FDD92-655F-4890-9D0E-A16019026DE4"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","title":"シーン 46: シーン 47","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、数十秒、そう深く考えると、\nまぁいいかと括り、そのワインをカゴに入れた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.047.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":6.356077097505668,"voiceCharacter":"操夢","voiceDuration":5.756077097505669,"slideTitle":"スライド #46","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"41A3D331-7017-45EC-8299-A7F9965348B8"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_フランドール・スカーレット.wav","title":"シーン 47: シーン 48","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ありがとう。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.048.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":2.5,"voiceCharacter":"フランドール・スカーレット","voiceDuration":1.5,"slideTitle":"スライド #47","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"A811282A-A9B6-4F98-A5F4-35599658EF96"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","title":"シーン 48: シーン 49","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「いえいえ。」僕はそう言い、彼女を見る。\nすると、ハッと過去を思い出す。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.049.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":5.866938775510204,"voiceCharacter":"操夢","voiceDuration":5.266938775510204,"slideTitle":"スライド #48","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"CDDDAB31-8D50-4B32-A380-2008BE502609"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","title":"シーン 49: シーン 50","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"それは、今から10年ほど前の、ある劇の発表日だった。その日は、参観日だったが、周りの同級生と違い、両親は来なかった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.050.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":10.188684807256235,"voiceCharacter":"操夢","voiceDuration":9.588684807256236,"slideTitle":"スライド #49","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"EDCF2857-0CCB-4BA2-A9CB-D189CDD5DA61"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","title":"シーン 50: シーン 51","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、その発表をつまらなく感じ、ぼっと席を立ち、当時の先生、初恋であった彼女…フランを一瞬見て、教室を飛び出す。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.051.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.677823129251701,"voiceCharacter":"操夢","voiceDuration":9.077823129251701,"slideTitle":"スライド #50","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"6C8459FF-57A8-4D58-8721-ABBDB4D0B914"},{"characterName":"操夢","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_051_操夢.wav","title":"シーン 51: シーン 52","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、彼女にある告白をする。その当時は、単に「ありがとう。」と返される程度だった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.052.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":7.359342403628117,"voiceCharacter":"操夢","voiceDuration":6.759342403628118,"slideTitle":"スライド #51","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seVolume":1,"animationName":"なし","id":"93405074-226A-4DA1-854C-68CBD7AD9D89"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","title":"シーン 52: シーン 53","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「あれから、10年ちょっとなんですね…」\n僕はそうぼさっと呟く。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.053.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.838684807256236,"voiceCharacter":"操夢","voiceDuration":4.238684807256236,"slideTitle":"スライド #52","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"4AFE010C-7949-478F-BFCC-6D3958C19AE0"},{"characterName":"操夢","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_053_操夢.wav","title":"シーン 53: シーン 54","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、彼女は驚きの表情を見せる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.054.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":3.2691156462585034,"voiceCharacter":"操夢","voiceDuration":2.6691156462585033,"slideTitle":"スライド #53","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seVolume":1,"animationName":"なし","id":"4D74A793-3FCA-4154-B0CE-8A727F3BA851"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav","title":"シーン 54: シーン 55","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ようやく思い出せたか…、それで、今でも…はあるの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.055.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":4.8894784580498865,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.289478458049887,"slideTitle":"スライド #54","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"AF86D9FB-E4DC-4BE8-BEA5-276C45582F83"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","title":"シーン 55: シーン 56","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、そう彼女に聞かれ、一瞬迷う。彼女に初恋してからは、ずっと男子だけに囲まれて育ったので、別の恋をしていなかった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.056.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.837596371882086,"voiceCharacter":"操夢","voiceDuration":9.237596371882086,"slideTitle":"スライド #55","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"353505E7-D53B-4202-BB8F-ABF4FBD22B9B"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","title":"シーン 56: シーン 57","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ええ、変わってませんよ…。」\n僕は、少し恥ずかしさを覚えながら、そう彼女に返すのだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.057.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":6.9636734693877544,"voiceCharacter":"操夢","voiceDuration":6.363673469387755,"slideTitle":"スライド #56","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"2DAE4875-8A41-4F4B-86CD-6C48DFD17061"},{"characterName":"霧雨魔理沙","title":"シーン 57: その頃、妹紅と魔理沙は…","transitionName":"なし","backgroundName":"単色背景","telop":"その頃、妹紅と魔理沙は…","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.058.jpeg","duration":3,"slideTitle":"スライド #57","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"10DE8310-33A3-4081-9FD4-0D2B4E04338D"},{"characterName":"妹紅","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_妹紅.wav","title":"シーン 58: シーン 59","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"私は、一瞬の隙があれから、時々でき、その度に彼女のビームの餌食になっていた。いつの間にか、息も切れかけている。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.059.jpeg","duration":8.984988662131519,"voiceCharacter":"妹紅","voiceDuration":8.38498866213152,"slideTitle":"スライド #58","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"D8A6BA30-7FB6-4882-B692-02E2919C00B8"},{"characterName":"妹紅","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_妹紅.wav","title":"シーン 59: シーン 60","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"あと数発のビームを喰らえば、倒れ込むのは確実な、その状況で、彼女に反撃もできずに、私は、それを避け続けた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.060.jpeg","duration":8.889160997732425,"voiceCharacter":"妹紅","voiceDuration":8.289160997732425,"slideTitle":"スライド #59","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"9CDEC689-0475-46B5-95C0-A56D647B0E5C"},{"characterName":"妹紅","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav","title":"シーン 60: シーン 61","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"すると、突如彼女が、これまでとは異なり、手に力を込め始める。「次のビームを食らったら、終わりだな…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.061.jpeg","duration":7.739160997732426,"voiceCharacter":"妹紅","voiceDuration":7.139160997732426,"slideTitle":"スライド #60","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"39C2F86E-2B2D-413A-9CA9-8BB85ABA386D"},{"characterName":"妹紅","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_妹紅.wav","title":"シーン 61: シーン 62","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"そして、これまでより高火力のビームを受け終わると、\n私は、その場に倒れ込んだ。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.062.jpeg","duration":5.726666666666667,"voiceCharacter":"妹紅","voiceDuration":5.126666666666667,"seName":"SE: 倒れる","slideTitle":"スライド #61","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":3.57,"voiceStartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3","animationName":"なし","seVolume":0.85,"id":"41C711CA-5751-4B7E-8653-BAC4A1743451"},{"characterName":"美鈴","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_美鈴.wav","title":"シーン 62: シーン 63","transitionName":"なし","backgroundName":"nc247232_都会の街中（夜）.jpg","telop":"私は、彼が倒れ込むとその隙をつき、彼女の背後に立つ。\nそして、彼女の首筋に強力な打撃を与えて、気絶させるのだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.063.jpeg","duration":6.935963718820862,"voiceCharacter":"美鈴","voiceDuration":6.335963718820862,"seName":"SE: 打撃1","slideTitle":"スライド #62","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":3.3,"voiceStartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/打撃1.mp3","animationName":"なし","seVolume":0.85,"id":"7ADF00CC-BC69-4D8A-8C62-E912883AA145"},{"characterName":"フランドール・スカーレット","title":"シーン 63: フランと彼が家に着くと…","transitionName":"なし","backgroundName":"単色背景","telop":"フランと彼が家に着くと…","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.064.jpeg","duration":3,"slideTitle":"スライド #63","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"2A5347E5-33FB-4391-BC6F-AA7A3A814AFF"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","title":"シーン 64: シーン 65","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"あれから、レジで僕が財布を忘れたので、彼女が立て替えて、家に帰ってくると、パックごはんをレンチンする。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.065.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":7.6821541950113374,"voiceCharacter":"操夢","voiceDuration":7.082154195011338,"slideTitle":"スライド #64","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"EE2893D8-A63D-47BF-897D-50D600AF2192"},{"characterName":"操夢","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_065_操夢.wav","title":"シーン 65: シーン 66","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そして、レンチンが終わると、蓋を開け、その上に鯖の味噌煮缶とチーズをそのままのせて、再びレンチンする。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.066.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":7.806077097505669,"voiceCharacter":"操夢","voiceDuration":7.206077097505669,"slideTitle":"スライド #65","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"7DC26E8E-11B3-4D46-B753-78AAA60279EE"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","title":"シーン 66: シーン 67","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"それから、手袋をつけて、レンチンした料理を取り出し、彼女が座っている食卓に運ぶ。「できましたよ、フランさん。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.067.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":8.662607709750567,"voiceCharacter":"操夢","voiceDuration":8.062607709750568,"slideTitle":"スライド #66","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"D064D5FE-DA43-47B1-971C-C6113A5B83F1"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_フランドール・スカーレット.wav","title":"シーン 67: シーン 68","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「ありがとう、紅夢くん。」私はそう言い、彼から箸を受け取ると、そのまま熱々の料理を口に頬張る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.068.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":8.839478458049886,"voiceCharacter":"フランドール・スカーレット","voiceDuration":8.239478458049886,"slideTitle":"スライド #67","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seVolume":1,"animationName":"なし","id":"B598B616-6806-4A07-B834-96FE33419EF1"},{"characterName":"フランドール・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_フランドール・スカーレット.wav","title":"シーン 68: シーン 69","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「あっち…」私はそう言いながら、口をハフハフさせる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.069.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":4.698231292517007,"voiceCharacter":"フランドール・スカーレット","voiceDuration":4.098231292517007,"slideTitle":"スライド #68","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（困り）.png","seVolume":1,"anima