[{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.209999999999999,"audioTrack":"track_voice_sub","seStartTimeOffset":0,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_サブ.wav","seVolume":1,"telop":"私が、テレビに映っていた場所に来ると、そこでは、彼女が箒に跨って空を飛び回りながら、ビームを周囲に放っていた。\n東方Project二次創作作品","voiceCharacter":"サブ","id":"B4EC348A-80C9-456D-8266-E948EE2F364A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.001.jpeg","slideTitle":"スライド #1","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":8.61,"title":"シーン 1"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.6506349206349205,"audioTrack":"track_voice_sub","seStartTimeOffset":0,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_サブ.wav","seVolume":1,"telop":"そして、ふと周りを見ると、父が困惑しながら、\nひたすらにそのビームを避けている様子だった。\n作成者：zuyasi","voiceCharacter":"サブ","id":"C68E1DE7-D150-4CC4-A695-5805B2908EC4","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.002.jpeg","slideTitle":"スライド #2","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":6.050634920634921,"title":"シーン 2"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.561519274376417,"audioTrack":"track_voice_sub","seStartTimeOffset":0,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_サブ.wav","seVolume":1,"telop":"すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。","voiceCharacter":"サブ","id":"504DD18F-7B7D-48FF-B0C5-256965B36554","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.003.jpeg","slideTitle":"スライド #3","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":8.961519274376418,"title":"シーン 3: すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.174557823129251,"audioTrack":"track_voice_sub","seStartTimeOffset":0,"characterName":"サブ","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_サブ.wav","seVolume":1,"telop":"だが、空腹に抗えるわけでもなく、私はある飲食店に入った。\n制作ソフト及び協力\nGemini\nTohoStuido","voiceCharacter":"サブ","id":"311494AE-B0E5-43E6-9C33-85F171DF2329","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.004.jpeg","slideTitle":"スライド #4","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":4.574557823129251,"title":"シーン 4"},{"transitionName":"なし","seStartTimeOffset":0,"duration":3,"characterName":"操夢","animationName":"なし","seVolume":1,"telop":"元女子校の日常","id":"A99DF8F2-1702-4FA9-9FD7-12D6C4D80865","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.005.jpeg","slideTitle":"スライド #5","backgroundName":"単色背景","voiceStartTimeOffset":0,"title":"シーン 5: 東方Project二次創作作品　Powerd By zuyasi　※久々の100スライド越えの122スライドです。"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.146303854875283,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","seVolume":1,"telop":"「んっ…」僕は、ふと気がつくと、そこは夜の街中だった。\nそして、ふと周りを見渡していると、魔理沙さんと父が見える。","voiceCharacter":"操夢","id":"7122C701-DE21-41A2-A6AD-B5E8D89170B5","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.006.jpeg","slideTitle":"スライド #6","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":8.546303854875283,"title":"シーン 6"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.290430839002267,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","seVolume":1,"telop":"ふともう一度見ると、魔理沙さんはビームを父やビルに向かって乱射するように放ち、父はそれを困った表情で避けていた。","voiceCharacter":"操夢","id":"58398A90-1D79-4D96-8142-AC21B7244095","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.007.jpeg","slideTitle":"スライド #7","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":7.690430839002268,"title":"シーン 7"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.487596371882086,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","seVolume":1,"telop":"すると、後ろから僕の肩が叩かれる。その方向に振り向くと、この前、夜の学校の廊下で会った女性だった。「こんばんは。」","voiceCharacter":"操夢","id":"BEC1F99F-013B-4422-A710-FFD096C62E8B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.008.jpeg","slideTitle":"スライド #8","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":8.887596371882086,"title":"シーン 8"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.0869841269841265,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_フランドール・スカーレット.wav","seVolume":1,"telop":"「こんばんは。こんなところで、どうしたの？」","voiceCharacter":"フランドール・スカーレット","id":"2A9362C5-2905-4896-A931-44E47855A510","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.009.jpeg","slideTitle":"スライド #9","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":3.486984126984127,"title":"シーン 9"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.9071655328798185,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","seVolume":1,"telop":"「えっと…」僕はそう言い、なぜ自分がこんな場所に来たかを思い出そうとするが、思い出せない。「分からないです…」","voiceCharacter":"操夢","id":"829DBEEE-8CA8-460C-95CE-AF7F0B86F34B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.010.jpeg","slideTitle":"スライド #10","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":7.307165532879819,"title":"シーン 10"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.414489795918367,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_フランドール・スカーレット.wav","seVolume":1,"telop":"「そう、それより、あなたは、これから、何かの予定はある？」","voiceCharacter":"フランドール・スカーレット","id":"FBADC252-AB8C-4D5E-9B51-FCFFEF3832CC","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.011.jpeg","slideTitle":"スライド #11","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":4.814489795918368,"title":"シーン 11"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","seVolume":1,"telop":"「えっと…ないです…」","voiceCharacter":"操夢","id":"D0D1AC8C-02F0-4887-9B1E-CAEBC8B792F7","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.012.jpeg","slideTitle":"スライド #12","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":1.5,"title":"シーン 12"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.776984126984127,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_フランドール・スカーレット.wav","seVolume":1,"telop":"「そう、なら私と一緒に、夜の街を歩いてみない？」","voiceCharacter":"フランドール・スカーレット","id":"CFDF5DA9-A232-421D-8453-AD7CD3DB1B9B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.013.jpeg","slideTitle":"スライド #13","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":4.176984126984127,"title":"シーン 13"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.424557823129252,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","seVolume":1,"telop":"「えっと…」僕は、彼女からの誘いに、どう返そうか考えていると、誰かがビルに激突し、僕はその方を見る。","voiceCharacter":"操夢","id":"589519B7-F199-4598-95A2-F154D926BC78","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.014.jpeg","slideTitle":"スライド #14","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":7.824557823129251,"title":"シーン 14"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.27249433106576,"audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"characterName":"妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_妹紅.wav","seVolume":1,"telop":"「痛てぇ…、ついよそ見をしちまったぜ…」私は、彼女からのビームが来ているのにも関わらず、逆ナンを受けている息子を見た。","voiceCharacter":"妹紅","id":"F1D37D2B-E1DC-4C56-B7C5-7FD2D91BB723","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.015.jpeg","slideTitle":"スライド #15","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":7.67249433106576,"title":"シーン 15"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":3.059478458049887,"audioTrack":"track_voice_marisa","seStartTimeOffset":0,"characterName":"霧雨魔理沙","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_霧雨魔理沙.wav","seVolume":1,"telop":"「二ヒヒィ、まだまだ足りないぜ…。」","voiceCharacter":"霧雨魔理沙","id":"098FDAB8-22AF-49CF-85D9-A32FB9BCED14","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.016.jpeg","slideTitle":"スライド #16","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":2.4594784580498867,"title":"シーン 16"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.318321995464852,"audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"characterName":"妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_妹紅.wav","seVolume":1,"telop":"「くっ…」私には、息子にサインを送る余裕もなく、\n彼女からやってくるビームを再び、避け始めた。」","voiceCharacter":"妹紅","id":"DCDA01E6-D24A-4D87-A84C-CF0E3E881B84","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.017.jpeg","slideTitle":"スライド #17","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":6.718321995464852,"title":"シーン 17"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.104489795918367,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav","seVolume":1,"telop":"「それで、どう。私と一緒に夜の街をお散歩する？」","voiceCharacter":"フランドール・スカーレット","id":"7FCBBA14-2B3A-4CBF-B5A3-CFFC4FAB30C9","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.018.jpeg","slideTitle":"スライド #18","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":4.504489795918367,"title":"シーン 18"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.253900226757369,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","seVolume":1,"telop":"「いや、今用事を思い出したので、\nそれを済ませたら、家に帰ります。」","voiceCharacter":"操夢","id":"EFAFE3AB-C657-49E0-B783-9ADEBC460A4A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.019.jpeg","slideTitle":"スライド #19","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":4.6539002267573695,"title":"シーン 19"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav","seVolume":1,"telop":"「そう…」","voiceCharacter":"フランドール・スカーレット","id":"57EA075A-D664-4893-ADC1-38DD8CF33F8F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.020.jpeg","slideTitle":"スライド #20","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":1.5,"title":"シーン 20"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.388684807256235,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","seVolume":1,"telop":"僕は、その彼女の表情を見ると、なんだか断るのは、申し訳なく感じてくる。「散歩とは違いますが…僕の用事に付き合ってくれませんか…？」","voiceCharacter":"操夢","id":"E2F6733F-644B-4071-A543-8E2BDBC7C3CA","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.021.jpeg","slideTitle":"スライド #21","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":9.788684807256235,"title":"シーン 21"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_フランドール・スカーレット.wav","seVolume":1,"telop":"「ありがとう！」","voiceCharacter":"フランドール・スカーレット","id":"BCC9C7A2-FFED-415A-B885-DFFE89064857","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.022.jpeg","slideTitle":"スライド #22","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":1.5,"title":"シーン 22"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.256077097505669,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","seVolume":1,"telop":"僕は、そう彼女が笑うと、どこかで見たことのあるようなその表情に、過去を思い出しながら、一緒に歩き始めた。","voiceCharacter":"操夢","id":"6652B4B1-5027-44D8-8857-44F98D2B2141","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.023.jpeg","slideTitle":"スライド #23","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":7.656077097505669,"title":"シーン 23"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.182721088435374,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":0,"characterName":"美鈴","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_美鈴.wav","seVolume":1,"telop":"私が、その場所につき、そっと影から覗くと、一方の男女は戦い、もう一方の男女は一緒にどこかに歩き出していた。","voiceCharacter":"美鈴","id":"2163F658-EF11-4097-8F2D-78D0D0006208","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.024.jpeg","slideTitle":"スライド #24","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":5.582721088435374,"title":"シーン 24"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":3.2998185941043086,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":0,"characterName":"美鈴","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_美鈴.wav","seVolume":1,"telop":"「一体、何があったんでしょうか…」私は、そう呟く。","voiceCharacter":"美鈴","id":"981578F5-0314-4EE7-9B91-09B827CFD429","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.025.jpeg","slideTitle":"スライド #25","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":2.6998185941043085,"title":"シーン 25"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.154421768707483,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":0,"characterName":"美鈴","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_美鈴.wav","seVolume":1,"telop":"だが、歩き出した二人の方は、あっという間に姿が消え、残ったのは、元学園生の霧雨魔理沙とある男性だけだった。","voiceCharacter":"美鈴","id":"ED7FA540-4B24-466D-81D7-D5112CFFD290","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.026.jpeg","slideTitle":"スライド #26","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":5.554421768707483,"title":"シーン 26"},{"transitionName":"なし","seStartTimeOffset":0,"duration":3.5,"characterName":"フランドール・スカーレット","animationName":"なし","seVolume":1,"telop":"歩き始めたフランと彼は…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"58D331B4-9C7A-4DE4-A4E5-61B0CF845C11","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.027.jpeg","slideTitle":"スライド #27","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceStartTimeOffset":0,"title":"シーン 27"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.535419501133786,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","seVolume":1,"telop":"僕とその女性、フランさんはあるスーパーに寄って行った。\n冷蔵庫がスカスカなために、買い出しにやって来た。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"94505A63-22F3-4BFA-86A8-2BBD6665549C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.028.jpeg","slideTitle":"スライド #28","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":6.9354195011337865,"title":"シーン 28"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.702811791383219,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","seVolume":1,"telop":"「そういえば、フランさんって、過去に僕と会ってましたか？」\n僕は、過去の記憶を確かめるために、彼女にそう尋ねる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"D1F51527-CC8E-4133-B3E1-7924B49E8B8D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.029.jpeg","slideTitle":"スライド #29","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.10281179138322,"title":"シーン 29"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.901995464852607,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_フランドール・スカーレット.wav","seVolume":1,"telop":"「さあ、どうだろうね。あなたは、思い出せるかしら…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"F2FE39F7-6B3D-4109-86EA-FE6820664C34","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.030.jpeg","slideTitle":"スライド #30","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.301995464852608,"title":"シーン 30"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.866938775510203,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","seVolume":1,"telop":"僕は、その彼女の表情を見て、僕がそれを思い出すまでは、答えなささそうなので、献立を考え、食材を見ていく。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"79DE8838-1996-4F98-A8A1-630091A4D618","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.031.jpeg","slideTitle":"スライド #31","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.266938775510203,"title":"シーン 31"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.1778231292517,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","seVolume":1,"telop":"「フランさんは、夕飯はもう食べましたか？」\n僕はそう彼女に聞く。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"E1630703-863D-48FB-82FB-04E4111CE25B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.032.jpeg","slideTitle":"スライド #32","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.5778231292517,"title":"シーン 32"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.619478458049887,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_フランドール・スカーレット.wav","seVolume":1,"telop":"「いや…まだ食べてないよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"AE18184C-E623-4052-88DF-124DB318BB2B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.033.jpeg","slideTitle":"スライド #33","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":2.019478458049887,"title":"シーン 33"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.506077097505669,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","seVolume":1,"telop":"「何か、食べたい料理とかってありますか？僕は、親にガスコンロは危ないから使うなって言われてますが…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"33285433-1AD9-4340-BB26-833A50C75D81","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.034.jpeg","slideTitle":"スライド #34","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":6.906077097505669,"title":"シーン 34"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.1394784580498865,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_フランドール・スカーレット.wav","seVolume":1,"telop":"「そう…、もしあれだったら、私も手伝うよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"BBA17F11-3B18-4C6B-95D3-17BB49CDC712","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.035.jpeg","slideTitle":"スライド #35","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":3.539478458049887,"title":"シーン 35"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":3.4973696145124715,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","seVolume":1,"telop":"「そうですか…、何か食べたい物はありますか…？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"D2EFB347-EB43-47F5-9DCD-069E55C5C0E8","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.036.jpeg","slideTitle":"スライド #36","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":2.8973696145124714,"title":"シーン 36"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.641995464852608,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_フランドール・スカーレット.wav","seVolume":1,"telop":"「どうしようかな…、あなたは何か得意な料理でもあるの？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"8E81A909-7C1F-4006-A7E7-7E8F72ADFC73","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.037.jpeg","slideTitle":"スライド #37","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.041995464852608,"title":"シーン 37"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.062607709750567,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","seVolume":1,"telop":"「得意な料理ですか…、強いていえば、ガスコンロと包丁を使わない料理だったら、僕でもできますよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"18FA5488-981F-4697-8361-DAA4FBBC71E1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.038.jpeg","slideTitle":"スライド #38","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":6.462607709750567,"title":"シーン 38"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":3.056984126984127,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_フランドール・スカーレット.wav","seVolume":1,"telop":"「そう…、なら…リゾットはどう？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"548BFE90-BC26-47AD-9E49-97278389A845","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.039.jpeg","slideTitle":"スライド #39","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":2.456984126984127,"title":"シーン 39"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.743038548752834,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","seVolume":1,"telop":"「リゾットですか…」僕はそう言いながら、献立を思いつく。\nそして、目的の食材がある売り場に向かう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"CCCDD876-50CC-4227-B7D0-60045F6B54D1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.040.jpeg","slideTitle":"スライド #40","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.143038548752834,"title":"シーン 40"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.234331065759637,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","seVolume":1,"telop":"そして、サバ味噌煮缶とチーズ、パックご飯をカゴに入れて歩く。\nそして、去り際に、ふりかけが目に入り、それもカゴに入れる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"CE4D18B9-5D2E-4EB5-BC69-D084D2AD580A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.041.jpeg","slideTitle":"スライド #41","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.634331065759637,"title":"シーン 41"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.365850340136054,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","seVolume":1,"telop":"そして、卵売り場に向かい、卵を手に取る。ふと、振り返ると、彼女の姿が見えなかった。僕は、彼女を探す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"B33DFBDF-77E9-42BD-B008-11AA909A28F5","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.042.jpeg","slideTitle":"スライド #42","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.765850340136055,"title":"シーン 42"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.656077097505668,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","seVolume":1,"telop":"僕が、彼女を探し、ワインの売り場に来ると、彼女はあるワインを見つめていた。「それ、飲みたいんですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"829D5214-EB52-4D86-9DE4-DE8392B1EACF","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.043.jpeg","slideTitle":"スライド #43","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.056077097505669,"title":"シーン 43"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":3.618231292517007,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_フランドール・スカーレット.wav","seVolume":1,"telop":"「なんだか、良さげなワイン見つけちゃって…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"90BECB6A-AC89-45F8-BB92-19C772E279D0","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.044.jpeg","slideTitle":"スライド #44","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":3.0182312925170067,"title":"シーン 44"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.286507936507936,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","seVolume":1,"telop":"「そうですか…」僕は、そう言い考える、ここでワインを買って行ってもいいが、母がそれ見たら、どんな反応をするかと…。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"59010D5E-8B01-4619-99BE-B39250CB0FF3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.045.jpeg","slideTitle":"スライド #45","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.686507936507937,"title":"シーン 45"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.356077097505668,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","seVolume":1,"telop":"僕は、数十秒、そう深く考えると、\nまぁいいかと括り、そのワインをカゴに入れた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"6EB44F28-DE0B-4CDF-A18D-1B5F2DB6AEF3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.046.jpeg","slideTitle":"スライド #46","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":5.756077097505669,"title":"シーン 46"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_フランドール・スカーレット.wav","seVolume":1,"telop":"「ありがとう。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"A241AED1-1B91-45E9-8F51-74A2348CB56B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.047.jpeg","slideTitle":"スライド #47","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":1.5,"title":"シーン 47"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.866938775510204,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","seVolume":1,"telop":"「いえいえ。」僕はそう言い、彼女を見る。\nすると、ハッと過去を思い出す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"53E77624-23CC-4DBA-B685-6AD62D224EBC","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.048.jpeg","slideTitle":"スライド #48","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":5.266938775510204,"title":"シーン 48"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.188684807256235,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","seVolume":1,"telop":"それは、今から10年ほど前の、ある劇の発表日だった。その日は、参観日だったが、周りの同級生と違い、両親は来なかった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"EE5044A2-B5B7-48F8-AD74-8732AEC01BBB","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.049.jpeg","slideTitle":"スライド #49","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":9.588684807256236,"title":"シーン 49"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.677823129251701,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","seVolume":1,"telop":"僕は、その発表をつまらなく感じ、ぼっと席を立ち、当時の先生、初恋であった彼女…フランを一瞬見て、教室を飛び出す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"899CC756-D71B-4604-A6C6-E49546760885","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.050.jpeg","slideTitle":"スライド #50","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":9.077823129251701,"title":"シーン 50"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.265850340136055,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","seVolume":1,"telop":"そして、彼女にある告白をする。その当時は、単に「ありがとう。」と返される程度だった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"BBF994DF-7437-454C-96B7-DAF0B665E9D0","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.051.jpeg","slideTitle":"スライド #51","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.665850340136055,"title":"シーン 51"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.838684807256236,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","seVolume":1,"telop":"「あれから、10年ちょっとなんですね…」\n僕はそうぼさっと呟く。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"6C2778A7-3331-4024-A1BF-96DAE13F5FB8","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.052.jpeg","slideTitle":"スライド #52","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.238684807256236,"title":"シーン 52"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":3.2691156462585034,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","seVolume":1,"telop":"すると、彼女は驚きの表情を見せる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"9C3E2493-E544-4308-B6A4-9139CBE68F18","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.053.jpeg","slideTitle":"スライド #53","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":2.6691156462585033,"title":"シーン 53"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.8894784580498865,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_フランドール・スカーレット.wav","seVolume":1,"telop":"「ようやく思い出せたか…、それで、今でも…はあるの？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"フランドール・スカーレット","id":"54A443DC-5FEC-465B-A2D6-98F4525DE425","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.054.jpeg","slideTitle":"スライド #54","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.289478458049887,"title":"シーン 54"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.837596371882086,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","seVolume":1,"telop":"僕は、そう彼女に聞かれ、一瞬迷う。彼女に初恋してからは、ずっと男子だけに囲まれて育ったので、別の恋をしていなかった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"91A9183B-611A-4179-9F74-DC1636B03A45","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.055.jpeg","slideTitle":"スライド #55","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":9.237596371882086,"title":"シーン 55"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.9636734693877544,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","seVolume":1,"telop":"「ええ、変わってませんよ…。」\n僕は、少し恥ずかしさを覚えながら、そう彼女に返すのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","id":"DF11B614-3ABB-48C6-BF20-E885C17F71FC","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.056.jpeg","slideTitle":"スライド #56","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":6.363673469387755,"title":"シーン 56"},{"transitionName":"なし","seStartTimeOffset":0,"duration":3,"characterName":"霧雨魔理沙","animationName":"なし","seVolume":1,"telop":"その頃、妹紅と魔理沙は…","id":"EA412784-45F3-48AF-8B75-49E514DDC496","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.057.jpeg","slideTitle":"スライド #57","backgroundName":"単色背景","voiceStartTimeOffset":0,"title":"シーン 57: その頃、妹紅と魔理沙は…"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.984988662131519,"audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"characterName":"妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_妹紅.wav","seVolume":1,"telop":"私は、一瞬の隙があれから、時々でき、その度に彼女のビームの餌食になっていた。いつの間にか、息も切れかけている。","voiceCharacter":"妹紅","id":"F1F88177-39DE-49C0-9ABA-8E7A3BAB360F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.058.jpeg","slideTitle":"スライド #58","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":8.38498866213152,"title":"シーン 58"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.889160997732425,"audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"characterName":"妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_妹紅.wav","seVolume":1,"telop":"あと数発のビームを喰らえば、倒れ込むのは確実な、その状況で、彼女に反撃もできずに、私は、それを避け続けた。","voiceCharacter":"妹紅","id":"829BCC4A-0068-45AE-BF1A-60C7FD6E8A6F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.059.jpeg","slideTitle":"スライド #59","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":8.289160997732425,"title":"シーン 59"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.739160997732426,"audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":0,"characterName":"妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav","seVolume":1,"telop":"すると、突如彼女が、これまでとは異なり、手に力を込め始める。「次のビームを食らったら、終わりだな…」","voiceCharacter":"妹紅","id":"7B599463-069A-4754-A7AC-6616DFA2C168","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.060.jpeg","slideTitle":"スライド #60","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":7.139160997732426,"title":"シーン 60"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.726666666666667,"audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","seStartTimeOffset":3.57,"characterName":"妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_妹紅.wav","seVolume":0.85,"telop":"そして、これまでより高火力のビームを受け終わると、\n私は、その場に倒れ込んだ。","voiceCharacter":"妹紅","id":"CDD73DB8-757A-4647-B903-7BA48395FCE8","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.061.jpeg","seName":"SE: 倒れる","slideTitle":"スライド #61","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":5.126666666666667,"title":"シーン 61"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.935963718820862,"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","seStartTimeOffset":3.3,"characterName":"美鈴","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_美鈴.wav","seVolume":0.85,"telop":"私は、彼が倒れ込むとその隙をつき、彼女の背後に立つ。\nそして、彼女の首筋に強力な打撃を与えて、気絶させるのだった。","voiceCharacter":"美鈴","id":"49255DAC-685D-4051-B310-0AAE1BCF1EDC","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/打撃1.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.062.jpeg","seName":"SE: 打撃1","slideTitle":"スライド #62","backgroundName":"nc247232_都会の街中（夜）.jpg","voiceDuration":6.335963718820862,"title":"シーン 62"},{"transitionName":"なし","seStartTimeOffset":0,"duration":3,"characterName":"フランドール・スカーレット","animationName":"なし","seVolume":1,"telop":"フランと彼が家に着くと…","id":"DC7184D6-02B6-4AF3-A906-F4B9E714D53E","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.063.jpeg","slideTitle":"スライド #63","backgroundName":"単色背景","voiceStartTimeOffset":0,"title":"シーン 63: フランと彼が家に着くと…"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.6821541950113374,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","seVolume":1,"telop":"あれから、レジで僕が財布を忘れたので、彼女が立て替えて、家に帰ってくると、パックごはんをレンチンする。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"C0C7B2A2-08D1-4DFF-ACC0-B7912157E9A3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.064.jpeg","slideTitle":"スライド #64","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":7.082154195011338,"title":"シーン 64"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.8278231292517,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","seVolume":1,"telop":"そして、レンチンが終わると、蓋を開け、その上に鯖の味噌煮缶とチーズをそのままのせて、再びレンチンする。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"E718B784-BBD8-4344-802F-5CDA540343B7","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.065.jpeg","slideTitle":"スライド #65","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":7.227823129251701,"title":"シーン 65"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.662607709750567,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","seVolume":1,"telop":"それから、手袋をつけて、レンチンした料理を取り出し、彼女が座っている食卓に運ぶ。「できましたよ、フランさん。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"D711AA1B-7A20-4A75-914D-7DC5FFD53F47","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.066.jpeg","slideTitle":"スライド #66","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":8.062607709750568,"title":"シーン 66"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.839478458049886,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_フランドール・スカーレット.wav","seVolume":1,"telop":"「ありがとう、紅夢くん。」私はそう言い、彼から箸を受け取ると、そのまま熱々の料理を口に頬張る。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"フランドール・スカーレット","id":"233BA7F4-46AD-4AF3-8B54-D80734334DF1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.067.jpeg","slideTitle":"スライド #67","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":8.239478458049886,"title":"シーン 67"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.698231292517007,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（困り）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_フランドール・スカーレット.wav","seVolume":1,"telop":"「あっち…」私はそう言いながら、口をハフハフさせる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"フランドール・スカーレット","id":"F622112A-5573-424E-9226-DA8D8D78D8D7","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.068.jpeg","slideTitle":"スライド #68","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":4.098231292517007,"title":"シーン 68"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.482154195011338,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（困り）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","seVolume":1,"telop":"「そんなに焦らなくて大丈夫ですよ、ご飯は逃げませんから。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"810D773A-63E9-4FFB-BABA-AC7A376B0B8D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.069.jpeg","slideTitle":"スライド #69","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":3.882154195011338,"title":"シーン 69"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.114489795918367,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（困り）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_フランドール・スカーレット.wav","seVolume":1,"telop":"「そうだね…。」私はそう言い、今度は冷ましてから食べる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"フランドール・スカーレット","id":"D19EB551-BC67-4593-B726-0F71C5E2734A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.070.jpeg","slideTitle":"スライド #70","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":4.514489795918367,"title":"シーン 70"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.239478458049886,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_フランドール・スカーレット.wav","seVolume":1,"telop":"「おいしい！」私は、思わずそう声を発する。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"フランドール・スカーレット","id":"DD8D69A4-3E0F-449C-9A43-FE058F57060B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.071.jpeg","slideTitle":"スライド #71","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":3.6394784580498865,"title":"シーン 71"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.797369614512471,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_操夢.wav","seVolume":1,"telop":"「ふっ。」僕は、彼女のその仕草に思わず笑ってしまう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"3923DCDD-E368-48A8-A58E-73AD9C965C9F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.072.jpeg","slideTitle":"スライド #72","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":4.197369614512471,"title":"シーン 72"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.791995464852608,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_フランドール・スカーレット.wav","seVolume":1,"telop":"私はそれから、あっという間にごはんを食べ切ると彼を見る。\n「ねぇ、さっき買ってきたワインとグラスを出してくれない？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"フランドール・スカーレット","id":"65CF236A-8AAA-4C82-A47F-22B21CD45FBC","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.073.jpeg","slideTitle":"スライド #73","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":8.191995464852608,"title":"シーン 73"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.543038548752834,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav","seVolume":0.85,"telop":"「いいですよ。ちょっと待ってください。」僕はそう言い、冷蔵庫にしまったワインを取り出してグラスに注ぐ。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"AB950264-9A20-47FB-85FD-64D87464DEC3","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/グラスにワインを注ぐ.mp3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.074.jpeg","seName":"SE: グラスにワインを注ぐ","slideTitle":"スライド #74","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":6.943038548752835,"title":"シーン 74"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.13,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","seVolume":1,"telop":"そして、ワインを注ぐと、彼女の前に置く。すると、彼女が僕の手を掴む。「あの、どうしたんですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"2380E857-0F79-4A28-8A53-D2D73A759088","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.075.jpeg","slideTitle":"スライド #75","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":7.53,"title":"シーン 75"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.947369614512471,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_操夢.wav","seVolume":1,"telop":"そういうと、彼女は席を立ち、僕の隣に立つと、頬に何かが触れる感触がする。その途端に、強烈な恥ずかしさを僕は覚える。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"5D78322B-30C8-45B5-9C76-F449126CB950","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.076.jpeg","slideTitle":"スライド #76","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":9.347369614512472,"title":"シーン 76"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.794489795918367,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"フランドール・スカーレット","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_フランドール・スカーレット.wav","seVolume":1,"telop":"「どう、私からのキスは？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"フランドール・スカーレット","id":"447F957B-2DD6-44A8-809F-EF5C75C470D1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.077.jpeg","slideTitle":"スライド #77","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":2.194489795918367,"title":"シーン 77"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":7.4354195011337865,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav","seVolume":1,"telop":"彼女はワインを飲みながら、そう僕に聞く。\n「えっと…」僕は返すべき言葉が分からず、戸惑ってしまう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"CE34D3DA-F028-47FB-AB65-0BBF7376146B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.078.jpeg","slideTitle":"スライド #78","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":6.835419501133787,"title":"シーン 78"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.490861678004535,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","seVolume":1,"telop":"僕は、わずかに彼女と帰宅したことを、後悔した。だが、それよりも、彼女の表情やその声が頭の中に入り込んでくる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"B8249E52-10E6-4B1E-A35D-29A8C100CBA9","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.079.jpeg","slideTitle":"スライド #79","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":8.890861678004535,"title":"シーン 79"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.774557823129252,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","seVolume":1,"telop":"「…少しばかし、恥ずかしいです…」僕は、そう返すのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","voiceCharacter":"操夢","id":"C895427C-50F9-4972-9A76-15BD14D39F6D","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.080.jpeg","slideTitle":"スライド #80","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","voiceDuration":4.174557823129252,"title":"シーン 80"},{"transitionName":"なし","seStartTimeOffset":0,"duration":3,"characterName":"博麗霊夢","animationName":"なし","seVolume":1,"telop":"その頃、霊夢は…","id":"20F57908-9224-4D6D-BA3E-FDA817F3CBE1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.081.jpeg","slideTitle":"スライド #81","backgroundName":"単色背景","voiceStartTimeOffset":0,"title":"シーン 81: その頃、霊夢は…"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":4.966984126984126,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_博麗霊夢.wav","seVolume":1,"telop":"私は、この取調室でふと今朝のことを思い出していた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","id":"1C9A0494-4371-4B94-9F89-097BEDA1C1A2","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.082.jpeg","slideTitle":"スライド #82","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.366984126984127,"title":"シーン 82"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.356984126984127,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_博麗霊夢.wav","seVolume":1,"telop":"私は、家を出てから、魔理沙の家に着くと、彼女は、ため息をつきながら、どこか暗く感じる表情をしていた。","voiceCharacter":"博麗霊夢","id":"64EF3230-C222-4795-ABA0-106D7A7988FE","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.083.jpeg","slideTitle":"スライド #83","backgroundName":"nc238754_一人部屋（日中）.jpg","voiceDuration":8.756984126984127,"title":"シーン 83"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.294489795918366,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_博麗霊夢.wav","seVolume":1,"telop":"私が、彼女にそんな表情をしている理由を問うと、昨晩の就寝時に、やけ酒をしていると、ふと不思議な声が聞こえたという。","voiceCharacter":"博麗霊夢","id":"64A7D24F-28DF-4977-903D-3A587DCF2046","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.084.jpeg","slideTitle":"スライド #84","backgroundName":"nc238754_一人部屋（日中）.jpg","voiceDuration":9.694489795918367,"title":"シーン 84"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.169478458049886,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_博麗霊夢.wav","seVolume":1,"telop":"そして、気がつけば、赤信号の横断歩道を渡っており、彼が止めなければ、きっとあのまま車に轢かれていたという。","voiceCharacter":"博麗霊夢","id":"2783AAD5-BC46-4916-8B35-A15C861FA8CE","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.085.jpeg","slideTitle":"スライド #85","backgroundName":"nc238754_一人部屋（日中）.jpg","voiceDuration":8.569478458049886,"title":"シーン 85"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.646984126984126,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_博麗霊夢.wav","seVolume":1,"telop":"私は、その症状が時折彼女に現れることを知っていて、だが、出来事が起きてから、翌朝には記憶から消えることを知っていた。","voiceCharacter":"博麗霊夢","id":"A7300CFB-2C39-4EED-B84E-850060484278","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.086.jpeg","slideTitle":"スライド #86","backgroundName":"nc238754_一人部屋（日中）.jpg","voiceDuration":10.046984126984126,"title":"シーン 86"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":11.003242630385488,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_博麗霊夢.wav","seVolume":1,"telop":"だが、彼女はあの後も、悪夢に悩まされていて、今日1日を無事に過ごせるかが不安だというので、励まし、私は仕事に向かった。","voiceCharacter":"博麗霊夢","id":"8050DD7B-1D39-4331-B20C-577C56AB6D16","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.087.jpeg","slideTitle":"スライド #87","backgroundName":"nc238754_一人部屋（日中）.jpg","voiceDuration":10.403242630385488,"title":"シーン 87"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":8.404489795918368,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_博麗霊夢.wav","seVolume":1,"telop":"それから、時が進み、夕陽がさしていた頃、\n彼女が突如として私が勤めている神社に現れた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc73538_【背景素材】博麗神社.pxd","voiceCharacter":"博麗霊夢","id":"374A331E-D7B9-45F6-BA65-463C9F83ADB0","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.088.jpeg","slideTitle":"スライド #88","backgroundName":"nc73538_【背景素材】博麗神社.pxd","voiceDuration":7.804489795918367,"title":"シーン 88"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.565736961451247,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_博麗霊夢.wav","seVolume":1,"telop":"すると、彼女は、私にあることを聞いてくる。それは、以前の彼女なら気にすることもなかったはずの内容だった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc73538_【背景素材】博麗神社.pxd","voiceCharacter":"博麗霊夢","id":"450F5AE0-5777-4F3B-8BC1-74F4D8D1E3CD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.089.jpeg","slideTitle":"スライド #89","backgroundName":"nc73538_【背景素材】博麗神社.pxd","voiceDuration":8.965736961451247,"title":"シーン 89"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.943242630385488,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_博麗霊夢.wav","seVolume":1,"telop":"今考えれば、それはある予兆だったのだとわかる。\nだが、その時の私は、再度、励ます程度で済ませてしまった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc73538_【背景素材】博麗神社.pxd","voiceCharacter":"博麗霊夢","id":"61E4A77A-8DAD-4D5A-9223-C6FAF6F4738A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.090.jpeg","slideTitle":"スライド #90","backgroundName":"nc73538_【背景素材】博麗神社.pxd","voiceDuration":9.343242630385488,"title":"シーン 90"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.396984126984126,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_博麗霊夢.wav","seVolume":1,"telop":"一応励ましたものの、様子が気になった私は、神社を早く出て、彼女を再度見ると、顔色が先ほどよりも悪くなっていた。","voiceCharacter":"博麗霊夢","id":"29F3C974-A225-4681-9F4C-A148D031D256","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.091.jpeg","slideTitle":"スライド #91","backgroundName":"nc247230_都会の街中（夕方）.jpg","voiceDuration":9.796984126984126,"title":"シーン 91"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.666984126984127,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_博麗霊夢.wav","seVolume":1,"telop":"そして、彼女は、ある言葉を私にいう。私は、その言葉に思わず彼女を平手打ちし、なぜそんなことを言うのかと問いただす。","voiceCharacter":"博麗霊夢","id":"5E2140A7-F408-4129-BBF5-F03680EC3A86","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.092.jpeg","slideTitle":"スライド #92","backgroundName":"nc247230_都会の街中（夕方）.jpg","voiceDuration":10.066984126984128,"title":"シーン 92"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.659478458049886,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_博麗霊夢.wav","seVolume":1,"telop":"すると、彼女は、謎に笑い出し、だんだんと様子が変わっていき、まるで悩みなどなかったように笑うと、ビームを出した。","voiceCharacter":"博麗霊夢","id":"C9386A87-0E9D-4702-8471-E90563F152CA","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.093.jpeg","slideTitle":"スライド #93","backgroundName":"nc247230_都会の街中（夕方）.jpg","voiceDuration":9.059478458049886,"title":"シーン 93"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.073242630385487,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_博麗霊夢.wav","seVolume":1,"telop":"結果的に、私は、彼女のビームを避けて、戦うことになってしまい、だんだんと周りのビル群に影響が出始めていった。","voiceCharacter":"博麗霊夢","id":"4722C83E-32AD-4BB5-B1FF-5631B4125173","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.094.jpeg","slideTitle":"スライド #94","backgroundName":"nc247230_都会の街中（夕方）.jpg","voiceDuration":9.473242630385487,"title":"シーン 94"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.073242630385487,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_博麗霊夢.wav","seVolume":1,"telop":"あれから、数時間程度の間、私は彼女からのビームを避け続けていたが、それでもビームを喰らい、気づけば倒れてしまった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","id":"AECB1065-188C-4095-BF0B-71C5DA6B9946","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.095.jpeg","slideTitle":"スライド #95","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":9.473242630385487,"title":"シーン 95"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":10.906984126984126,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_096_博麗霊夢.wav","seVolume":1,"telop":"そして、目が覚めてからは、ここで時折警官と話したり、考え事をしたりしていた。そして、彼と息子の今の様子が気になる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"博麗霊夢","id":"E8D73389-A42D-4AB2-8E46-B81555D19B99","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.096.jpeg","slideTitle":"スライド #96","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":10.306984126984126,"title":"シーン 96"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":6.586031746031746,"audioTrack":"track_voice_%E9%AD%82%E9%AD%84%E5%A6%96%E5%A4%A2","seStartTimeOffset":0,"characterName":"魂魄妖夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_097_魂魄妖夢.wav","seVolume":1,"telop":"「お待たせしました、あなたが解放されることになったので、いまから、玄関口まで私が、ご案内します。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"魂魄妖夢","id":"5E13092E-6265-4E40-A5C7-DF3A92A6C243","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.097.jpeg","slideTitle":"スライド #97","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":5.986031746031746,"title":"シーン 97"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":9.613242630385487,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_博麗霊夢.wav","seVolume":1,"telop":"私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","voiceCharacter":"博麗霊夢","id":"CB59F35F-2948-4B0A-A7A0-A940AEA9FB78","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.098.jpeg","slideTitle":"スライド #98","backgroundName":"nc256639_警察署（夜）.jpg","voiceDuration":9.013242630385488,"title":"シーン 98"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":5.781746031746032,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"characterName":"レミリア・スカーレット","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_099_レミリア・スカーレット.wav","seVolume":1,"telop":"「実は、あなたの息子さんの将来に関わることで、\n折行ってご相談がありまして…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","voiceCharacter":"レミリア・スカーレット","id":"49226277-73F6-4293-AC1F-B3818E69C95A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_dace56b32e\/元女子校の日常　第9話_dace56b32e.099.jpeg","slideTitle":"スライド #99","backgroundName":"nc256639_警察署（夜）.jpg","voiceDuration":5.181746031746032,"title":"シーン 99"},{"voiceStartTimeOffset":0,"transitionName":"なし","duration":2.5,"audioTrack":"track_voice_reimu","seStartTimeOffset":0,"characterName":"博麗霊夢","a