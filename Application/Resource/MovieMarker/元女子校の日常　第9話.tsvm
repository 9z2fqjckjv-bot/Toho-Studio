F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"B40C7D1A-832E-44F3-91CD-0BF102A56466"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_102_博麗霊夢.wav","title":"シーン 102: シーン 103","transitionName":"なし","backgroundName":"nc256639_警察署（夜）.jpg","telop":"私はそれを聞き、驚く。「とりあえず、私の家に来ますか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.103.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","duration":5.759478458049887,"voiceCharacter":"博麗霊夢","voiceDuration":5.159478458049887,"slideTitle":"スライド #102","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"B25CFC83-DB32-475E-A602-8671B1BC14F6"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_103_レミリア・スカーレット.wav","title":"シーン 103: シーン 104","transitionName":"なし","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「ええ…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.104.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc256639_警察署（夜）.jpg","duration":2.5,"voiceCharacter":"レミリア・スカーレット","voiceDuration":1.5,"slideTitle":"スライド #103","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"BC87751A-A9BD-4229-B50B-2B7900376986"},{"characterName":"操夢","title":"シーン 104: 二人が家に着くと…","transitionName":"なし","backgroundName":"単色背景","telop":"二人が家に着くと…","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.105.jpeg","duration":3,"slideTitle":"スライド #104","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"96C13F19-6057-460B-A16D-429517C9B14E"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_105_博麗霊夢.wav","title":"シーン 105: シーン 106","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.106.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":10.668231292517007,"voiceCharacter":"博麗霊夢","voiceDuration":10.068231292517007,"slideTitle":"スライド #105","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"1A834B91-A395-432D-A14D-8DE76331260C"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_106_博麗霊夢.wav","title":"シーン 106: シーン 107","transitionName":"なし","backgroundName":"一人部屋３（夜・照明OFF）.jpg","telop":"そして、そっと彼の部屋の扉を開けて、中を覗く。すると、彼女が言っていた女性が、スヤスヤとベッドで寝ていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.107.jpeg","duration":9.904489795918368,"voiceCharacter":"博麗霊夢","voiceDuration":9.304489795918368,"slideTitle":"スライド #106","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）叡智シーンのみ\/後ろ手すやすや頬照り寝顔.png","seVolume":1,"animationName":"なし","id":"8D07F68A-91E5-4079-A6EF-D5041C4659E8"},{"characterName":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_107_操夢.wav","title":"シーン 107: シーン 108","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、私と彼の部屋に入ると、紅夢がベッドの片方で寝ていた。私は、それを確認すると、リビングで待つ彼女の元に戻る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.108.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":9.964761904761904,"voiceCharacter":"操夢","voiceDuration":9.364761904761904,"slideTitle":"スライド #107","audioTrack":"track_voice_soumu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"46A77B62-B8E3-40C7-8C22-71BB7498657B"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_108_レミリア・スカーレット.wav","title":"シーン 108: シーン 109","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「それで、各部屋の様子はどうでしたか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.109.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":3.1609070294784583,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.560907029478458,"slideTitle":"スライド #108","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"B5CE25CF-CBDF-4670-8F2A-50ACBBB01957"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_109_博麗霊夢.wav","title":"シーン 109: シーン 110","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「あなたに指摘された通りです。それで…本当に私の息子の許嫁に妹さんをもらって大丈夫でしょうか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.110.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":9.345238095238095,"voiceCharacter":"博麗霊夢","voiceDuration":8.745238095238095,"slideTitle":"スライド #109","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"DFDCAD66-819E-4ECA-8396-85FEFD85A70A"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_110_レミリア・スカーレット.wav","title":"シーン 110: シーン 111","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「ええ、妹がきっとそれを望みますから…。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.111.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":3.2713151927437645,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.6713151927437644,"slideTitle":"スライド #110","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"2D15EDA3-6C9B-4AFF-B29A-1030F217E53A"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_111_博麗霊夢.wav","title":"シーン 111: シーン 112","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「建設会社の方は、後継者はいるのですか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.112.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":4.314489795918367,"voiceCharacter":"博麗霊夢","voiceDuration":3.714489795918367,"slideTitle":"スライド #111","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"99FA261D-7541-4E60-BDD1-328145C4B900"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_112_レミリア・スカーレット.wav","title":"シーン 112: シーン 113","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「後継者は今は、いませんが…、それが何か？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.113.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":3.6629931972789116,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.0629931972789115,"slideTitle":"スライド #112","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"23E1720F-5F91-4201-B8A6-4CC2B664D26F"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_113_博麗霊夢.wav","title":"シーン 113: シーン 114","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"私は、息子の事情を話すべきか迷う、だが、ここで話しておかないと後々大変になるのは目に見えていた。「実は…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.114.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":10.147732426303854,"voiceCharacter":"博麗霊夢","voiceDuration":9.547732426303854,"slideTitle":"スライド #113","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"94829ACB-A715-4188-ABF9-E9C3890D8576"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_114_レミリア・スカーレット.wav","title":"シーン 114: シーン 115","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"私は、彼女の話にとても驚く。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.115.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":3.156734693877551,"voiceCharacter":"レミリア・スカーレット","voiceDuration":2.556734693877551,"slideTitle":"スライド #114","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"2D9FC1A7-BD29-4422-BA54-DC570845D2C6"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_115_レミリア・スカーレット.wav","title":"シーン 115: シーン 116","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうですか…」私は、このままでは養子を迎え入れるか、企業合併以外の選択肢しか残されない事実に考え込む。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.116.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":8.156734693877551,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.556734693877551,"slideTitle":"スライド #115","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seVolume":1,"animationName":"なし","id":"EDCEBE7E-11EA-4509-A428-3BC29CBA3388"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_116_レミリア・スカーレット.wav","title":"シーン 116: シーン 117","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「承知しました…。それでもう一つお願いがあるのですか…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.117.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":4.215079365079365,"voiceCharacter":"レミリア・スカーレット","voiceDuration":3.615079365079365,"slideTitle":"スライド #116","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"D3A7D545-B063-42F3-B719-7FB8C7A44865"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_117_博麗霊夢.wav","title":"シーン 117: シーン 118","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"私はその内容に驚く。そして考えこむ。それから数分程度の間の後、告げる。「それでは、息子の今後については頼みます。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.118.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":11.659478458049886,"voiceCharacter":"博麗霊夢","voiceDuration":11.059478458049886,"slideTitle":"スライド #117","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"6D1900E1-0FAE-4136-BDDD-34B93C862E0B"},{"characterName":"レミリア・スカーレット","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_118_レミリア・スカーレット.wav","title":"シーン 118: シーン 119","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私からの二つの願いに答えていただき、ありがとうございます。このご恩は、近いうちに必ずお返しします。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.119.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":7.790068027210884,"voiceCharacter":"レミリア・スカーレット","voiceDuration":7.190068027210884,"slideTitle":"スライド #118","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"ABF3D051-F5BF-4543-9467-36A6CD67B6AE"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_119_博麗霊夢.wav","title":"シーン 119: シーン 120","transitionName":"なし","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"彼女はそういうと、家を去っていった。私は、「はぁ…」吐息を吐くと、そのまま入浴を済ませて、寝室に向かう。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.120.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","duration":9.723242630385487,"voiceCharacter":"博麗霊夢","voiceDuration":9.123242630385487,"slideTitle":"スライド #119","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"AFECBE93-C0B8-446F-BA15-AE518A3E3B88"},{"characterName":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_120_博麗霊夢.wav","title":"シーン 120: シーン 121","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、部屋にそっと入って気づく。「今日は久々の添い寝ね…」私はそう呟きながら、彼の横に入り、寝付くのだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.121.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","duration":10.403242630385487,"voiceCharacter":"博麗霊夢","voiceDuration":9.803242630385487,"slideTitle":"スライド #120","audioTrack":"track_voice_reimu","seStartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"EBB84603-181F-4220-B7DA-AC081F7E1C90"},{"characterName":"操夢","title":"シーン 121: ご視聴ありがとうございました！","transitionName":"なし","backgroundName":"単色背景","telop":"ご視聴ありがとうございました！","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第9話_4357e03f5b\/元女子校の日常　第9話_4357e03f5b.122.jpeg","duration":20,"slideTitle":"スライド #121","voiceStartTimeOffset":0,"seStartTimeOffset":0,"seVolume":1,"animationName":"なし","id":"B7E566A8-7C79-4F66-9DE8-2409682A5579"}]