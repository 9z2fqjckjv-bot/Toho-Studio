[{"characterName":"操夢","voiceDuration":8.547369614512471,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.001.jpeg","transitionName":"なし","slideTitle":"第1スライド","duration":3.5,"voiceCharacter":"操夢","animationName":"なし","id":"835CF5A4-8EA4-41BC-BA6E-9DC3F8680CA5","telop":"「んっ…ここは…」僕はふと目が覚めると、そう呟く。\n東方Project二次創作作品","audioTrack":"track_voice_soumu","title":"シーン 1","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"霧雨魔理沙","voiceDuration":2.876984126984127,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.002.jpeg","transitionName":"なし","slideTitle":"第2スライド","duration":3.5,"voiceCharacter":"霧雨魔理沙","animationName":"なし","id":"90443026-7A33-4F37-8C70-C524C7DDA481","telop":"「おや、目が覚めたかい…、紅夢君…」\n作成者：zuyasi","audioTrack":"track_voice_marisa","title":"シーン 2","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"duration":3,"slideTitle":"中扉","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","telop":"","id":"976A6B54-6063-47D6-A544-EB682295E983","title":"「あなたは…魔理沙さんですか…母の友達の…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.003.jpeg","bgmName":"BGM: 東方妖恋談"},{"characterName":"霧雨魔理沙","voiceDuration":4.464489795918367,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.004.jpeg","transitionName":"なし","slideTitle":"第4スライド","duration":3.5,"voiceCharacter":"霧雨魔理沙","animationName":"なし","id":"BDF30F0A-0B7D-483F-88B3-9A4CBBC59A01","telop":"「ああ…そうだ…。それより…」\n制作ソフト及び協力\nGemini\nTohoStuido","audioTrack":"track_voice_marisa","title":"シーン 4","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"操夢","voiceDuration":4.610430839002268,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.005.jpeg","transitionName":"なし","slideTitle":"第5スライド","duration":3.5,"voiceCharacter":"操夢","animationName":"なし","id":"D1C4B4D5-A387-4587-94D3-BC319A7A56B6","telop":"「何か、言いたいことでもあるのですか？」","audioTrack":"track_voice_soumu","title":"シーン 5","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"霧雨魔理沙","voiceDuration":7.2182312925170065,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.006.jpeg","transitionName":"なし","slideTitle":"第6スライド","duration":3.5,"voiceCharacter":"霧雨魔理沙","animationName":"なし","id":"278B6121-78B6-4D30-A0EF-FF0CA86FB5BD","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","audioTrack":"track_voice_marisa","title":"シーン 6","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"操夢","voiceDuration":3.1408616780045353,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.007.jpeg","transitionName":"なし","slideTitle":"第7スライド","duration":3.7,"voiceCharacter":"操夢","animationName":"なし","id":"97B24E51-0BEB-45B6-81E5-81F252A1643B","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","audioTrack":"track_voice_soumu","title":"シーン 7","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"霧雨魔理沙","voiceDuration":7.018231292517007,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.008.jpeg","transitionName":"なし","slideTitle":"第8スライド","duration":4.5,"voiceCharacter":"霧雨魔理沙","animationName":"なし","id":"7795C2AF-9B74-45CD-8748-44FA15BF0399","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","audioTrack":"track_voice_marisa","title":"シーン 8","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"操夢","voiceDuration":2.7723809523809524,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.009.jpeg","transitionName":"カラーでフェード","slideTitle":"第9スライド","duration":3.7,"voiceCharacter":"操夢","animationName":"なし","id":"8E492A70-DB83-41A5-A806-0524A8D87D0F","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","audioTrack":"track_voice_soumu","title":"シーン 9","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第3話_c997bea981\/slide_010_anim.m4v","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.010.jpeg","transitionName":"なし","slideTitle":"タイトル","duration":19,"voiceCharacter":"","animationName":"バウンス","id":"C62987AA-0755-478B-BCAB-6B43DCEC9C5B","telop":"元女子校の日常","bgmName":"BGM: 東方妖恋談","title":"東方Project二次創作作品　Powerd By zuyasi","backgroundName":"単色背景"},{"characterName":"操夢","voiceDuration":2.956077097505669,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.011.jpeg","transitionName":"なし","slideTitle":"第11スライド","duration":3.5,"voiceCharacter":"操夢","animationName":"なし","id":"A53E4EE5-719F-4FC6-ADD6-15F50F7F4E14","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","audioTrack":"track_voice_soumu","title":"シーン 11","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"博麗霊夢","voiceDuration":6.755736961451247,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.012.jpeg","transitionName":"なし","slideTitle":"第12スライド","duration":4.4,"voiceCharacter":"博麗霊夢","animationName":"なし","id":"DC31B87D-CE3F-4EDE-A805-529DEA0B9631","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","audioTrack":"track_voice_reimu","title":"シーン 12","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"操夢","voiceDuration":5.015850340136055,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.013.jpeg","transitionName":"なし","slideTitle":"第13スライド","duration":4.2,"voiceCharacter":"操夢","animationName":"なし","id":"03F4032B-3D22-4635-82F9-82E9F0DB4C2C","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","audioTrack":"track_voice_soumu","title":"シーン 13","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"博麗霊夢","voiceDuration":3.9094784580498865,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.014.jpeg","transitionName":"なし","slideTitle":"第14スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","id":"D90C6B24-1724-45F6-A8A6-64C6C200746F","telop":"「それに…最近…魔理沙の様子が変なのよね…」","audioTrack":"track_voice_reimu","title":"シーン 14","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"操夢","voiceDuration":4.156077097505669,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.015.jpeg","transitionName":"なし","slideTitle":"第15スライド","duration":4.7,"voiceCharacter":"操夢","animationName":"なし","id":"6E0FCE5F-DE81-42AE-A56B-D1038F15D9E1","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","audioTrack":"track_voice_soumu","title":"シーン 15","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"博麗霊夢","voiceDuration":10.184489795918367,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.016.jpeg","transitionName":"なし","slideTitle":"第16スライド","duration":5.800000000000001,"voiceCharacter":"博麗霊夢","animationName":"なし","id":"B276F347-477C-420C-B4EE-42DECF8519B6","telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","audioTrack":"track_voice_reimu","title":"シーン 16","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","backgroundName":"nc256897_病室-夕方-電気あり.png","bgmName":"BGM: 東方妖恋談"},{"characterName":"操夢","voiceDuration":5.645215419501134,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.017.jpeg","transitionName":"なし","slideTitle":"第17スライド","duration":4.3,"voiceCharacter":"操夢","animationName":"なし","id":"E30BC9A4-7C9B-473C-B5E3-B0DBB6403795","telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","audioTrack":"track_voice_soumu","title":"シーン 17","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"操夢","voiceDuration":3.1256462585034015,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.018.jpeg","transitionName":"なし","slideTitle":"第18スライド","duration":3.5,"voiceCharacter":"操夢","animationName":"なし","id":"71F6AFF0-28D2-4607-ACC9-83927EBBA63A","telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","audioTrack":"track_voice_soumu","title":"シーン 18","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.019.jpeg","transitionName":"なし","slideTitle":"第19スライド","duration":3.5,"voiceCharacter":"ナレーション","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B87C75B9-CEFF-4B7D-93D9-B88022659B2B","telop":"附属病院のある診察室では…","bgmName":"BGM: 東方妖恋談","title":"シーン 19","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":5.656938775510204,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_永琳.wav.bak","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.020.jpeg","transitionName":"なし","slideTitle":"第20スライド","duration":3.7,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"7A03DE37-DFFD-4C5C-878A-0887036B7B6D","telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 20","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":9.21374149659864,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_永琳.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.021.jpeg","transitionName":"なし","slideTitle":"第21スライド","duration":5.800000000000001,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"EC392255-60B3-4234-AFB0-B2AE732A1E72","telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 21","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":8.210839002267575,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_永琳.wav.bak","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.022.jpeg","transitionName":"なし","slideTitle":"第22スライド","duration":4.5,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"619CF275-E039-41EB-AA58-42788DBBDE9D","telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 22","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":8.678934240362812,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.023.jpeg","transitionName":"なし","slideTitle":"第23スライド","duration":6,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"E59EE0C8-8C30-4D24-801E-CC1A721DCE09","telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 23","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":9.371814058956916,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_永琳.wav.bak","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.024.jpeg","transitionName":"なし","slideTitle":"第24スライド","duration":5.300000000000001,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"FAA2D4E3-7BBE-4326-9E7A-29138DD5E59C","telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 24","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":7.20421768707483,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.025.jpeg","transitionName":"なし","slideTitle":"第25スライド","duration":4.3,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"E1CECF4A-708C-422D-8CC1-B0BD97818BD8","telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 25","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"射命丸文","voiceDuration":7.111587301587302,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.026.jpeg","transitionName":"なし","slideTitle":"第26スライド","duration":4.9,"voiceCharacter":"射命丸文","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"563FDD61-0D93-43B5-8BAD-F4D3EF352007","telop":"「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","title":"シーン 26","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmName":"BGM: 東方妖恋談"},{"characterName":"射命丸文","voiceDuration":8.62358276643991,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.027.jpeg","transitionName":"なし","slideTitle":"第27スライド","duration":5.800000000000001,"voiceCharacter":"射命丸文","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"16832528-AC32-4A32-8564-7233107ADF3C","telop":"「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","title":"シーン 27","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmName":"BGM: 東方妖恋談"},{"characterName":"射命丸文","voiceDuration":7.520181405895691,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.028.jpeg","transitionName":"なし","slideTitle":"第28スライド","duration":5.7,"voiceCharacter":"射命丸文","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1F035970-D8E8-407A-9237-342A948543A9","telop":"「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","title":"シーン 28","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmName":"BGM: 東方妖恋談"},{"characterName":"射命丸文","voiceDuration":3.6015873015873017,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.029.jpeg","transitionName":"なし","slideTitle":"第29スライド","duration":3.5,"voiceCharacter":"射命丸文","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"42A08BBE-F750-4935-8355-BB09881A7754","telop":"「それと、息子さんの言ってたことは全て事実だそうですよ。」","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","title":"シーン 29","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmName":"BGM: 東方妖恋談"},{"characterName":"八意永琳","voiceDuration":8.250113378684807,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_永琳.wav.bak","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.030.jpeg","transitionName":"なし","slideTitle":"第30スライド","duration":4.800000000000001,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"647E02C5-83D3-4BD2-A7B9-41AE657AFD5A","telop":"「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 30","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmName":"BGM: 東方妖恋談"},{"characterName":"射命丸文","voiceDuration":4.105578231292517,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.031.jpeg","transitionName":"なし","slideTitle":"第31スライド","duration":3.5,"voiceCharacter":"射命丸文","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"5478646A-3A76-4767-843D-69719139203B","telop":"「代金、確かにいただきました。それでは、またのご利用を。」","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","title":"シーン 31","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmName":"BGM: 東方妖恋談"},{"characterName":"八意永琳","voiceDuration":7.0875963718820865,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_永琳.wav.bak","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.032.jpeg","transitionName":"なし","slideTitle":"第32スライド","duration":4.7,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"50261DBD-8762-42A6-97C1-DD7420810804","telop":"彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 32","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"八意永琳","voiceDuration":8.360249433106576,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav.bak","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.033.jpeg","transitionName":"なし","slideTitle":"第33スライド","duration":5,"voiceCharacter":"永琳","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"239C128C-BFE8-43BA-B455-C3492E2B39FB","telop":"私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","title":"シーン 33","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.034.jpeg","transitionName":"なし","slideTitle":"第34スライド","duration":3.5,"voiceCharacter":"ナレーション","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"9572D1AE-453E-457D-A822-8F490383D2C8","telop":"彼に視点が戻り…","bgmName":"BGM: 東方妖恋談","title":"シーン 34","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":2.5463038548752834,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.035.jpeg","transitionName":"なし","slideTitle":"第35スライド","duration":5.9,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"38F3EE2F-4477-409C-8EAF-CA2AE14E263A","telop":"僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…","audioTrack":"track_voice_soumu","title":"シーン 35","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":3.434331065759637,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.036.jpeg","transitionName":"なし","slideTitle":"第36スライド","duration":5.300000000000001,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"89B06C11-B4B9-4C37-A9BB-70D26F976800","telop":"だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。","audioTrack":"track_voice_soumu","title":"シーン 36","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":11.247369614512472,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.037.jpeg","transitionName":"なし","slideTitle":"第37スライド","duration":5.5,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"FD1AD0FF-30F1-479C-9621-9C8DEE1A80A1","telop":"だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。","audioTrack":"track_voice_soumu","title":"シーン 37","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":10.171292517006803,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.038.jpeg","transitionName":"なし","slideTitle":"第38スライド","duration":5.6000000000000005,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"EAF4CECB-C309-4509-A1CD-B03D92BA1D59","telop":"一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。","audioTrack":"track_voice_soumu","title":"シーン 38","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":8.1278231292517,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.039.jpeg","transitionName":"なし","slideTitle":"第39スライド","duration":5.300000000000001,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"30A91F5A-8F53-487D-A986-CD495A90D8D8","telop":"だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。","audioTrack":"track_voice_soumu","title":"シーン 39","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":13.535419501133786,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.040.jpeg","transitionName":"なし","slideTitle":"第40スライド","duration":5,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"88AE713E-9C3C-49C3-AA85-BE624A53E404","telop":"そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。","audioTrack":"track_voice_soumu","title":"シーン 40","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":6.240861678004535,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.041.jpeg","transitionName":"なし","slideTitle":"第41スライド","duration":3.8000000000000003,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"33037F44-4AF0-4375-9A3D-C94E840D36CC","telop":"そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。","audioTrack":"track_voice_soumu","title":"シーン 41","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":8.803900226757369,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.042.jpeg","transitionName":"なし","slideTitle":"第42スライド","duration":5.6000000000000005,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"2E304264-F9A6-48DD-855B-612EBABB2D51","telop":"そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。","audioTrack":"track_voice_soumu","title":"シーン 42","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":8.601723356009071,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.043.jpeg","transitionName":"なし","slideTitle":"第43スライド","duration":5.2,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"360BF765-2617-400B-8BCC-8EE61CE43A32","telop":"僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…","audioTrack":"track_voice_soumu","title":"シーン 43","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"操夢","voiceDuration":8.769115646258504,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.044.jpeg","transitionName":"なし","slideTitle":"第44スライド","duration":3.5,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"72CB9040-B99F-4028-81E4-44755383CC76","telop":"そう、それは…","audioTrack":"track_voice_soumu","title":"シーン 44","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"博麗霊夢","voiceDuration":2.481995464852608,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.045.jpeg","transitionName":"なし","slideTitle":"第45スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","id":"2F35B219-68D1-48B6-8E7B-52F78E8EF068","telop":"「よかったわ、目が覚めたようで。」","audioTrack":"track_voice_reimu","title":"シーン 45","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256899_病室-夜-電気あり.png"},{"characterName":"博麗霊夢","voiceDuration":3.186984126984127,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.046.jpeg","transitionName":"なし","slideTitle":"第46スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","id":"7C40BD07-D51E-4889-990A-33CA50A3F313","telop":"「母さん…」\n僕は、そう彼女に返す。","audioTrack":"track_voice_reimu","title":"シーン 46","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256899_病室-夜-電気あり.png"},{"characterName":"博麗霊夢","voiceDuration":7.301995464852608,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.047.jpeg","transitionName":"なし","slideTitle":"第47スライド","duration":4.4,"voiceCharacter":"博麗霊夢","animationName":"なし","id":"C05CBB9D-E6AA-478D-BC7B-6E30FC2C1332","telop":"「あんたが、呻いてるから、私が何度も声かけたのよ…、\n私に心配かけさせないでちょうだい…」","audioTrack":"track_voice_reimu","title":"シーン 47","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256899_病室-夜-電気あり.png"},{"characterName":"操夢","voiceDuration":7.022380952380952,"voiceAudioPath":"\/Us