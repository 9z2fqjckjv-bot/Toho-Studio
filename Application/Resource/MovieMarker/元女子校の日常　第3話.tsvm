\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.051.jpeg","transitionName":"なし","slideTitle":"第51スライド","duration":5.6000000000000005,"voiceCharacter":"操夢","animationName":"なし","id":"A37C4E61-0FD5-4CA0-A1B8-38EB6F41A533","telop":"彼女は、そういうと、涙を拭いながら、病室を出ていった。\n僕は、先ほどの悪夢で疲れ込んだのか、そのまま眠りに落ちた。","audioTrack":"track_voice_soumu","title":"シーン 51","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256899_病室-夜-電気あり.png"},{"characterName":"博麗霊夢","voiceDuration":7.971587301587301,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.052.jpeg","transitionName":"なし","slideTitle":"第52スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D9370AEB-0685-44DC-9814-78B817497B55","telop":"霊夢が家に帰ると…","audioTrack":"track_voice_reimu","title":"シーン 52","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"博麗霊夢","voiceDuration":4.031995464852607,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.053.jpeg","transitionName":"なし","slideTitle":"第53スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"D702BD48-A8A4-4927-9543-E599B2987CE2","telop":"私が家に帰ってくると、すでに夫がリビングにいた。","audioTrack":"track_voice_reimu","title":"シーン 53","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":6.243333333333333,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.054.jpeg","transitionName":"なし","slideTitle":"第54スライド","duration":4.3,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"98C73447-296D-457C-891D-15D7634724D4","telop":"「霊夢、お前その顔どうした？」\n私は、彼女が泣いた後の表情をしていたのでそう問いかける。","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 54","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"博麗霊夢","voiceDuration":4.3644897959183675,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.055.jpeg","transitionName":"なし","slideTitle":"第55スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"8DC24325-9DF9-49EC-9406-20F3E976A9F6","telop":"「そんなことどうだっていいわ、それより、夕飯は食べたの？」","audioTrack":"track_voice_reimu","title":"シーン 55","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":3.26,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.056.jpeg","transitionName":"なし","slideTitle":"第56スライド","duration":3.5,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"C29C4788-B5F9-477E-8331-6C06DC4D8444","telop":"「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 56","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"博麗霊夢","voiceDuration":3.316984126984127,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.057.jpeg","transitionName":"なし","slideTitle":"第57スライド","duration":4.5,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"A5474D69-2300-4026-9FE0-C0C259DD4AE6","telop":"「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。","audioTrack":"track_voice_reimu","title":"シーン 57","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"博麗霊夢","voiceDuration":3.2244897959183674,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.058.jpeg","transitionName":"なし","slideTitle":"第58スライド","duration":3.5,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"79BDC6EA-0E01-4113-B82D-E494F3CAA5AE","telop":"霊夢がお風呂を澄ますと…","audioTrack":"track_voice_reimu","title":"シーン 58","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"characterName":"博麗霊夢","voiceDuration":5.125736961451247,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.059.jpeg","transitionName":"なし","slideTitle":"第59スライド","duration":5.1000000000000005,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"703F00E7-A3AF-418E-AB65-E5F8A217C346","telop":"私がお風呂から戻ってくると、彼はビール缶をあけ、ため息をついていた。「何か現場仕事に不満でもあるの？」","audioTrack":"track_voice_reimu","title":"シーン 59","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":3.305827664399093,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.060.jpeg","transitionName":"なし","slideTitle":"第60スライド","duration":3.5,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"BF360837-01BF-4DED-A191-66879028E920","telop":"「今日は、例の紅魔建設からの依頼だったんだけど…」","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 60","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"博麗霊夢","voiceDuration":11.514739229024944,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.061.jpeg","transitionName":"なし","slideTitle":"第61スライド","duration":5.800000000000001,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"4A4A5575-1DC8-4ADE-8FEE-3EC9067580D1","telop":"彼はそういうと、その話を始める。特殊な力で一瞬で建造物を破壊できる女性がいる一族経営の館の解体工事中の出来事だった。","audioTrack":"track_voice_reimu","title":"シーン 61","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":7.374580498866213,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.062.jpeg","transitionName":"なし","slideTitle":"第62スライド","duration":4.800000000000001,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"C55B83FC-A769-49A5-B5DF-AA742EBAC494","telop":"「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 62","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":6.796439909297052,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.063.jpeg","transitionName":"なし","slideTitle":"第63スライド","duration":5.5,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"33BCC25C-383F-45B8-9233-746192DAD1B2","telop":"「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 63","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":7.026666666666666,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.064.jpeg","transitionName":"なし","slideTitle":"第64スライド","duration":5.2,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"06E728E9-E3D1-4DF7-AC82-9A5B26C35ED9","telop":"「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 64","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"藤原妹紅","voiceDuration":7.868321995464853,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.065.jpeg","transitionName":"なし","slideTitle":"第65スライド","duration":5.6000000000000005,"voiceCharacter":"妹紅","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"02D99149-0389-4F68-9963-0F820B8C0BFD","telop":"「だが、そんなことよりも、今日もこうして、霊夢のところに帰って来れて、俺は幸せ者だぜ。」私はそう笑みを浮かべる。","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","title":"シーン 65","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"博麗霊夢","voiceDuration":9.241995464852607,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.066.jpeg","transitionName":"なし","slideTitle":"第66スライド","duration":5.300000000000001,"voiceCharacter":"博麗霊夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","id":"653A1EAE-19BD-4B80-A34A-03895BEEFD8A","telop":"「そうね…」私は、夫のその発言こう返すことしかできなかった。そして、なんだか距離を感じてしまったのだった。","audioTrack":"track_voice_reimu","title":"シーン 66","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg"},{"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.067.jpeg","transitionName":"なし","slideTitle":"第67スライド","duration":2,"voiceCharacter":"ナレーション","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"7AF5AA95-4C74-484A-9867-6B0E635FF8E1","telop":"続く","bgmName":"BGM: 東方妖恋談","title":"シーン 67","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"duration":20,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","telop":"","id":"D2F79EF5-7F36-467A-8EAB-216FA43E6E18","title":"ご視聴ありがとうございました！","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.068.jpeg","bgmName":"BGM: 東方妖恋談"}]