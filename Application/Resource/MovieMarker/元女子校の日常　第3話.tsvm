[{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","telop":"「んっ…ここは…」僕はふと目が覚めると、そう呟く。\n東方Project二次創作作品","title":"シーン 1","transitionName":"なし","characterName":"操夢","id":"F3F28938-5428-4226-AA28-E63860B2CC5D","voiceDuration":3.814761904761905,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.001.jpeg","animationName":"なし","slideTitle":"スライド #1","audioTrack":"track_voice_soumu","duration":4.414761904761905,"voiceCharacter":"操夢","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_霧雨魔理沙.wav","telop":"「おや、目が覚めたかい…、紅夢君…」\n作成者：zuyasi","title":"シーン 2","transitionName":"なし","characterName":"霧雨魔理沙","id":"47460A28-A047-4E4E-9353-7F8C21BA4A69","voiceDuration":2.876984126984127,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.002.jpeg","animationName":"なし","slideTitle":"スライド #2","audioTrack":"track_voice_marisa","duration":3.5,"voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png"},{"backgroundName":"nc256897_病室-夕方-電気あり.png","audioTrack":"track_voice_soumu","duration":3.916938775510204,"title":"シーン 3: 「あなたは…魔理沙さんですか…母の友達の…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","slideTitle":"スライド #3","characterName":"操夢","voiceCharacter":"操夢","id":"1D081C50-7672-4863-BF39-256005952005","telop":"「あなたは…魔理沙さんですか…母の友達の…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.003.jpeg","voiceDuration":3.316938775510204,"transitionName":"なし","animationName":"なし"},{"backgroundName":"nc256897_病室-夕方-電気あり.png","audioTrack":"track_voice_marisa","duration":3.5,"title":"シーン 4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","slideTitle":"スライド #4","characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","id":"7BEC697C-9089-42C4-BD9B-F668EEE0AA2B","telop":"「ああ…そうだ…。それより…」\n制作ソフト及び協力\nGemini\nTohoStuido","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.004.jpeg","voiceDuration":2.4344897959183673,"transitionName":"なし","animationName":"なし"},{"backgroundName":"nc256897_病室-夕方-電気あり.png","audioTrack":"track_voice_soumu","duration":3.5,"title":"シーン 5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","slideTitle":"スライド #5","characterName":"操夢","voiceCharacter":"操夢","id":"62E0F08C-7D9E-4FA8-B3D9-BBB4957A6CA9","telop":"「何か、言いたいことでもあるのですか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.005.jpeg","voiceDuration":2.5930385487528347,"transitionName":"なし","animationName":"なし"},{"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav","voiceDuration":5.053242630385488,"id":"CE2BEF60-E92D-41CA-BFCB-7A8551BA644C","animationName":"なし","title":"シーン 6","audioTrack":"track_voice_marisa","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #6","duration":5.7182312925170065,"characterName":"霧雨魔理沙","transitionName":"なし","voiceCharacter":"霧雨魔理沙","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.006.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","voiceDuration":6.027823129251701,"id":"6544D75C-1540-42EF-841B-D32244286E83","animationName":"なし","title":"シーン 7","audioTrack":"track_voice_soumu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #7","duration":6.6278231292517,"characterName":"操夢","transitionName":"なし","voiceCharacter":"操夢","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.007.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_霧雨魔理沙.wav","voiceDuration":7.018231292517007,"id":"8B196C64-49B8-4D56-891D-1A7CF5ADFC80","animationName":"なし","title":"シーン 8","audioTrack":"track_voice_marisa","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #8","duration":7.618231292517007,"characterName":"霧雨魔理沙","transitionName":"なし","voiceCharacter":"霧雨魔理沙","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.008.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","voiceDuration":5.20498866213152,"id":"50F0E544-47E8-45C9-A8A3-EBC6B8DA2965","animationName":"なし","title":"シーン 9","audioTrack":"track_voice_soumu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #9","duration":5.804988662131519,"characterName":"操夢","transitionName":"カラーでフェード","voiceCharacter":"操夢","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.009.jpeg"},{"backgroundName":"単色背景","transitionName":"なし","id":"08778F1C-7F02-479A-B060-7A02DC4BC529","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第3話_c997bea981\/slide_010_anim.m4v","slideTitle":"スライド #10","duration":19,"characterName":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.010.jpeg","title":"シーン 10: 東方Project二次創作作品　Powerd By zuyasi","animationName":"バウンス","telop":"元女子校の日常"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","voiceDuration":3.490861678004535,"id":"6F6540CD-F6EE-4C05-A5AE-4C9EC8B913DC","animationName":"なし","title":"シーン 11","audioTrack":"track_voice_soumu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #11","duration":4.090861678004535,"characterName":"操夢","transitionName":"なし","voiceCharacter":"操夢","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.011.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav","voiceDuration":6.755736961451247,"id":"E9AA48E1-ED29-4C1A-9989-F68505565136","animationName":"なし","title":"シーン 12","audioTrack":"track_voice_reimu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #12","duration":7.355736961451247,"characterName":"博麗霊夢","transitionName":"なし","voiceCharacter":"博麗霊夢","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.012.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","voiceDuration":6.414761904761905,"id":"FE9D84F8-C363-4974-9E11-648F7B918CC2","animationName":"なし","title":"シーン 13","audioTrack":"track_voice_soumu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #13","duration":7.0147619047619045,"characterName":"操夢","transitionName":"なし","voiceCharacter":"操夢","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.013.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav","voiceDuration":3.9094784580498865,"id":"9DE37A28-58F0-461D-8FB8-EDBB73BD9857","animationName":"なし","title":"シーン 14","audioTrack":"track_voice_reimu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #14","duration":4.509478458049887,"characterName":"博麗霊夢","transitionName":"なし","voiceCharacter":"博麗霊夢","telop":"「それに…最近…魔理沙の様子が変なのよね…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.014.jpeg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","voiceDuration":6.35172335600907,"id":"1D5591F1-08D0-4F3F-BC84-CC974A6C7164","animationName":"なし","title":"シーン 15","audioTrack":"track_voice_soumu","backgroundName":"nc256897_病室-夕方-電気あり.png","slideTitle":"スライド #15","duration":6.95172335600907,"characterName":"操夢","transitionName":"なし","voiceCharacter":"操夢","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.015.jpeg"},{"telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","audioTrack":"track_voice_reimu","characterName":"博麗霊夢","voiceCharacter":"博麗霊夢","slideTitle":"スライド #16","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","voiceDuration":10.184489795918367,"id":"8E75486C-516A-47E4-A62E-D8495DE0FE11","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.016.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav","title":"シーン 16","duration":10.784489795918367,"backgroundName":"nc256897_病室-夕方-電気あり.png","transitionName":"なし"},{"telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","audioTrack":"track_voice_soumu","characterName":"操夢","voiceCharacter":"操夢","slideTitle":"スライド #17","voiceDuration":6.690861678004535,"id":"8C561330-3EAF-4301-A332-DC876D33CF45","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.017.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","title":"シーン 17","duration":7.290861678004535,"backgroundName":"nc256897_病室-夕方-電気あり.png","transitionName":"なし"},{"telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","audioTrack":"track_voice_soumu","characterName":"操夢","voiceCharacter":"操夢","slideTitle":"スライド #18","voiceDuration":4.321292517006802,"id":"3FCCED6E-80F7-443B-99B1-24DC7780A0AA","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.018.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","title":"シーン 18","duration":4.921292517006802,"backgroundName":"nc256897_病室-夕方-電気あり.png","transitionName":"なし"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"87254C8C-D875-4B18-8FCC-B12FD61B5790","slideTitle":"スライド #19","duration":3.5,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.019.jpeg","title":"シーン 19","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","animationName":"なし","telop":"附属病院のある診察室では…"},{"telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"永琳","voiceCharacter":"永琳","slideTitle":"スライド #20","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.956916099773243,"id":"C5001225-F268-46CE-A1FE-828AEE7A543E","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.020.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_永琳.wav","title":"シーン 20","duration":5.556916099773242,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし"},{"telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"永琳","voiceCharacter":"永琳","slideTitle":"スライド #21","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":9.21374149659864,"id":"0A26E0FF-AD4D-46AF-9D22-CE5E2B8EE792","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.021.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_永琳.wav","title":"シーン 21","duration":9.81374149659864,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし"},{"telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"永琳","voiceCharacter":"永琳","slideTitle":"スライド #22","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.1946031746031744,"id":"7F3D70D5-2525-4D56-9C61-D700AEE3AEF3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.022.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_永琳.wav","title":"シーン 22","duration":7.794603174603174,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし"},{"telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"永琳","voiceCharacter":"永琳","slideTitle":"スライド #23","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.678934240362812,"id":"EDE1B88F-33B4-4007-BB0A-38A3DF812244","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.023.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav","title":"シーン 23","duration":9.278934240362812,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし"},{"telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"永琳","voiceCharacter":"永琳","slideTitle":"スライド #24","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.215668934240362,"id":"0C8D4D45-9532-4947-987B-C1683AFE4AA8","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.024.jpeg","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_永琳.wav","title":"シーン 24","duration":8.815668934240362,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし"},{"telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"永琳","voiceCharacter":"永琳","slideTitle":"スライド #25","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.20421768707483,"seAudioPath":"\/Volumes\/ZSSD\/GitHu