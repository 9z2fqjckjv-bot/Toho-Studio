3","seStartTimeOffset":-74.2991836734694,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","voiceCharacter":"古明地こいし","title":"シーン 56","animationName":"なし","characterName":"古明地こいし","bgmVolume":0.7},{"id":"D40CE736-263C-45BC-B150-4F590456067A","backgroundName":"image74.jpeg","seName":"[SE] 海岸1.mp3","seVolume":0.5062235617597292,"voiceStartTimeOffset":0,"telop":"「えっ…？」僕がそう返すと、もう一度彼女はビンタをする。","slideTitle":"スライド #57","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav","voice2StartTimeOffset":0,"duration":4.056077097505669,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.057.jpeg","transitionName":"なし","voiceDuration":4.056077097505669,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","seStartTimeOffset":-78.17045351473925,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","voiceCharacter":"操夢","title":"シーン 57","animationName":"なし","characterName":"操夢","bgmVolume":0.7},{"id":"068D474A-7DAE-4F4D-894B-398617460BBD","backgroundName":"image74.jpeg","seName":"[SE] 海岸1.mp3","seVolume":0.5062235617597292,"voiceStartTimeOffset":0,"telop":"「もういいわ…、この旅行が終わったら、\nあんたを奪い取るんだから…。」","slideTitle":"スライド #58","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_古明地こいし.wav","voice2StartTimeOffset":0,"duration":4.926507936507937,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.058.jpeg","transitionName":"なし","voiceDuration":4.926507936507937,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","seStartTimeOffset":-82.22653061224494,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","voiceCharacter":"古明地こいし","title":"シーン 58","animationName":"なし","characterName":"古明地こいし","bgmVolume":0.7},{"id":"C0605215-7B1A-4B69-94F6-165571A56BF7","backgroundName":"image74.jpeg","seName":"[SE] 海岸1.mp3","seVolume":0.5062235617597292,"voiceStartTimeOffset":0,"telop":"彼女はそういうと、首を傾げる僕を置き去りにしたまま、数時間ほど、一度も岸に戻らず、海をただ泳ぎ続けるのだった。","slideTitle":"スライド #59","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","voice2StartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","duration":8.441950113378685,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.059.jpeg","transitionName":"なし","voiceDuration":8.441950113378685,"seStartTimeOffset":-87.1530385487529,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","voiceCharacter":"操夢","title":"シーン 59","animationName":"なし","characterName":"操夢","bgmVolume":0.7},{"id":"D40CD18F-08BD-43CA-A21D-5055E67450AF","backgroundName":"image74.jpeg","seName":"[SE] 海岸1.mp3","seVolume":0.5062235617597292,"voiceStartTimeOffset":0,"telop":"僕とさとりとアリスはただそれを眺めるのだった。","slideTitle":"スライド #60","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","voice2StartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","duration":2.841950113378685,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.060.jpeg","transitionName":"なし","voiceDuration":2.841950113378685,"seStartTimeOffset":-95.59498866213161,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","voiceCharacter":"操夢","title":"シーン 60","animationName":"なし","characterName":"操夢","bgmVolume":0.7},{"id":"E997AEB8-B6E0-404B-98FD-10369C1813D7","backgroundName":"image74.jpeg","seVolume":1,"voiceStartTimeOffset":0,"telop":"主人公の父親\n主人公の彼の父親。大人の男性。彼を、男子校に通わせた張本人であり、厳しめの態度を貫き通してきた。だが、その態度は妻の霊夢の考えとすれ違ってしまう。そして、魔理沙がやってくると、3人同時〇〇〇〇をさせられる。彼は、魔理沙と霊夢の行動に困り果てており、彼が家に帰ってきて欲しいと願う。仕事は、現場仕事で、紅魔建設が発注元の仕事をしたこともある。そして、母には永琳がいる。\n藤原妹紅","slideTitle":"スライド #61","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/やる.png","voice2StartTimeOffset":0,"animationNote":"5秒","animationDuration":5,"duration":5,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.061.jpeg","transitionName":"なし","bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc289847_四季巡々_(夏).mp3","bgmName":"BGM: nc289847_四季巡々_(夏)","seStartTimeOffset":0,"bgmStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","title":"シーン 61","animationName":"なし","characterName":"博麗霊夢","bgmVolume":0.65},{"id":"FD7193C3-840C-452F-8A63-7E42591B16F0","backgroundName":"image74.jpeg","seName":"[SE] 海岸1.mp3","seVolume":0.35224609375,"voiceStartTimeOffset":0,"telop":"あれから、数時間経つと、こいしがトボトボと岸に戻ってくる。","slideTitle":"スライド #62","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第