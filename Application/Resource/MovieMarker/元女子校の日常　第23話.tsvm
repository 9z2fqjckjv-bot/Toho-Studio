[{"audioTrack":"track_voice_soumu","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.001.jpeg","telop":"あれから僕たちは、途中で朝食をとり、恩納村にあるホテルにお昼前に着いた。そして、アリスが車を停めに向かう。\n東方Project二次創作作品","transitionName":"なし","id":"A85604E9-4923-422D-A89C-CE3EA953DC77","title":"シーン 1","duration":7.973469387755102,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第1スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.973469387755102,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image69.jpeg","backgroundName":"image69.jpeg","seStartTimeOffset":0},{"audioTrack":"track_voice_soumu","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.002.jpeg","telop":"アリスが車を停めに行っている間、僕はチェックインの手続きを済ませる。そして、ロビーのソファで休んでいる二人の元に戻った。\n作成者：zuyasi","transitionName":"なし","id":"042FFFB2-BF63-4251-9615-8C356AAFB6F9","title":"シーン 2","duration":8.35063492063492,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第2スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.35063492063492,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","backgroundName":"image70.jpeg","seStartTimeOffset":0},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.003.jpeg","telop":"僕が二人の元に戻ると、二人はここまでの道中やホテルに対する感想を話していた。「お昼ご飯までは、休憩の時間にしますか？」","transitionName":"なし","id":"0C925B6A-DDB2-4696-8F55-1FFB47D8B9AD","title":"僕が二人の元に戻ると、二人はここまでの道中やホテルに対する感想を話していた。「お昼ご飯までは、休憩の時間にしますか？」","duration":8.573469387755102,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"中扉","animationName":"なし","characterName":"操夢","voiceDuration":8.573469387755102,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","backgroundName":"image70.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.004.jpeg","telop":"「そうしようかな…」\n制作ソフト及び協力\nGemini\nTohoStuido","transitionName":"なし","id":"1C6E2644-1700-49B7-B8F3-20B9634794C9","title":"シーン 4","duration":1.4265079365079365,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第4スライド","animationName":"なし","characterName":"古明地こいし","voiceDuration":1.4265079365079365,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地こいし.wav","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","backgroundName":"image70.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"au