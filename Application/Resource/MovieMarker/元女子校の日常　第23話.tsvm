dio\/Slide_013_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","seVolume":1,"seStartTimeOffset":0,"slideTitle":"スライド #13","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","transitionName":"なし","backgroundName":"image71.jpeg","bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png","animationName":"なし"},{"duration":6.835419501133787,"voiceDuration":6.835419501133787,"title":"シーン 14","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_soumu","telop":"僕がそう言うと、3人は頷き、その通りになった。\n「それで、アリスさんは、これからどうしますか？」","id":"147369D5-0195-4A1D-915C-136476933909","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.014.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","seVolume":1,"seStartTimeOffset":0,"slideTitle":"スライド #14","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","transitionName":"なし","backgroundName":"image71.jpeg","bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png","animationName":"なし"},{"duration":2.8740362811791385,"voiceDuration":2.8740362811791385,"title":"シーン 15","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","telop":"「特にやりたいこともないわよ…、何か計画でもあるの？」","id":"4F43E457-FE39-4B39-B679-468B23958AB0","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.015.jpeg","voiceAudioPath"