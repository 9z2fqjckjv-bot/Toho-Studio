rtTimeOffset":0,"seName":"[SE] 風が吹く1.mp3","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/風が吹く1.mp3","duration":7.990861678004535,"bgmStartTimeOffset":0,"characterName":"操夢","slideTitle":"スライド #23","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.023.jpeg","telop":"僕たちはあれから、万座毛と言う場所に来ていた。すると、風がこっちに吹いてくる。「少しばかし、冷え込んでるな…」","title":"シーン 23","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","voiceDuration":3.2190249433106577,"bgmVolume":0.7,"backgroundName":"image72.jpeg","seStartTimeOffset":-7.990861678004535,"id":"3BFC650C-C9D9-4592-A385-94AD994912D4","seVolume":0.30776491116751253,"voiceStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voice2StartTimeOffset":0,"seName":"[SE] 風が吹く1.mp3","voiceCharacter":"アリス・マーガトロイド","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/風が吹く1.mp3","duration":3.2190249433106577,"bgmStartTimeOffset":0,"characterName":"アリス・マーガトロイド","slideTitle":"スライド #24","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.024.jpeg","telop":"「なんだか、肌寒いわね…」私はそう、彼に呟く。","title":"シーン 24","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_アリス・マーガトロイド.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","voiceDuration":8.509342403628118,"bgmVolume":0.7,"backgroundName":"image72.jpeg","seStartTimeOffset":-11.209886621315192,"id":"5B057DAE-F5BE-40C4-9BAF-929BEC83EDAA","seVolume":0.30776491116751253,"voiceStartTimeOffset":0,"animationName":"なし","transitionName":"なし","voice2StartTimeOffset":0,"seName":"[SE] 風が吹く1.mp3","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/風が吹く1.mp3","duration":8.509342403628118,"bgmStartTimeOffset":0,"characterName":"操夢","slideTitle":"スライド #25","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.025.jpeg","telop":"「確かにそうですね…。とりあえず、施設に戻りますか…。」\nそれから僕たちは、ここにくる前に通った案内施設に戻った。","title":"シーン 25","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/霧雨魔理沙_通常.png","seStartTimeOffset":0,"seVolume":0.85,"backgroundName":"image72.jpeg","id":"95C657B3-9149-459B-B740-AAC921BF222D","voiceStartTimeOffset":0,"animationName":"なし","transitionName":"なし","animationDuration":5,"animationNote":"5秒","voice2StartTimeOffset":0,"seName":"SE: nc356864_【ジングル？】恋色マジック","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc356864_【ジングル？】恋色マジック.mp3","duration":5,"bgmStartTimeOffset":0,"characterName":"博麗霊夢","slideTitle":"スライド #26","title":"シーン 26","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.026.jpeg","telop":"主人公の母の友人\n主人公の彼の母、博麗霊夢の友人。彼とは、霊夢を介して一緒に、カラオケに出かける仲。そして、彼に、ときどき謎の小瓶を手渡しては、それを飲ませ、対価として小遣いを与えていた。だが、ある日、突如として繁華街で暴れた彼女は、学校の命令で、彼と交代する形で霊夢と妹紅と同じ家で共に暮らすことになった。\n霧雨魔理沙","backgrou