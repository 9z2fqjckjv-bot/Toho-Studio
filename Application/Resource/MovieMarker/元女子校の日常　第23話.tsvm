話_17cc036f5a.065.jpeg","bgmVolume":2,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png"},{"seVolume":0.35224609375,"id":"FFD6F2D1-BD5F-4095-A50D-6C0858C514FA","slideTitle":"スライド #66","voiceDuration":7.6223809523809525,"voiceStartTimeOffset":0,"voiceCharacter":"操夢","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","seStartTimeOffset":-24.08875283446713,"backgroundName":"image74.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","bgmStartTimeOffset":0,"duration":7.6223809523809525,"audioTrack":"track_voice_soumu","bgmVolume":0.7,"telop":"僕は、背後からついてくる二人の機嫌が悪くなっているのを感じながら、こいしを起こさぬように、車までおんぶしていった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.066.jpeg","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 66","seName":"[SE] 海岸1.mp3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（怒り）.png"},{"seVolume":1,"id":"075FB735-6AC4-4F55-82F2-CE25584AD405","slideTitle":"スライド #67","voiceStartTimeOffset":0,"animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","seStartTimeOffset":0,"backgroundName":"image74.jpeg","bgmStartTimeOffset":0,"duration":5,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc458855_【東方アレンジ】応援スカーレット!.mp3","animationDuration":5,"bgmVolume":0.25141248153618906,"telop":"紅魔建設代表\nフランと営む紅魔建設の代表であり、フランの姉である。かつて紅魔建設は、複数の身内従業員を抱える企業であったが、今では彼女と妹のフランの二人だけで営んでいる。そして、フランが主人公の彼に好意を抱いていると知ると、彼と結ばれるように、彼女を応援し、婚姻届のサインを彼の副人格にさせた。彼の同意があれば、フランと彼は見事結ばれる。だが、それが危うくなっている今は、学校と彼の両親を裏切って、彼を取り込もうとしている。\nレミリア・スカーレット","bgmName":"BGM: nc458855_【東方アレンジ】応援スカーレット!","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.067.jpeg","characterName":"フランドール・スカーレット","animationNote":"5秒","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 67","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/レミリアジト涙目.png"},{"id":"D3191089-1352-445E-BECD-0C14E1376DEC","slideTitle":"スライド #68","voiceDuration":8.40716553287982,"voiceStartTimeOffset":0,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"backgroundName":"image75.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","bgmStartTimeOffset":0,"duration":8.40716553287982,"audioTrack":"track_voice_soumu","bgmVolume":0.7,"telop":"僕たちは、それからホテルに戻る。そして、こいしは車内で目覚め、頬照りながら、せっせと部屋の浴室に駆け込んで行った。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.068.jpeg","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 68","seVolume":1},{"id":"23ACEE78-F145-427C-A2FB-51FE3CF10D7A","slideTitle":"スライド #69","voiceDuration":3.612607709750567,"voiceStartTimeOffset":0,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"backgroundName":"image75.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","bgmStartTimeOffset":0,"duration":3.612607709750567,"audioTrack":"track_voice_soumu","bgmVolume":0.7,"telop":"そして、僕たちは、窓に差し込む夕陽を眺めていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.069.jpeg","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 69","seVolume":1},{"seVolume":1,"id":"21D2CB3D-FE12-4A36-BD1C-5166A4AB9C86","slideTitle":"スライド #70","voiceDuration":2.109024943310658,"voiceStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"backgroundName":"image75.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_アリス・マーガトロイド.wav","bgmStartTimeOffset":0,"duration":2.109024943310658,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","bgmVolume":0.7,"telop":"「それで、今晩の夕食はどうするの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.070.jpeg","characterName":"アリス・マーガトロイド","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 70","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png"},{"seVolume":1,"id":"CD8AB455-2440-41EB-9433-B239D9E77314","slideTitle":"スライド #71","voiceDuration":7.721292517006803,"voiceStartTimeOffset":0,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"backgroundName":"image75.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","bgmStartTimeOffset":0,"duration":7.721292517006803,"audioTrack":"track_voice_soumu","bgmVolume":0.7,"telop":"「今晩は、ホテル内のレストランでバイキングですよ。もちろん、お酒が飲みたいなら、ホテル内のバーにもいいですけど。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.071.jpeg","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 71","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png"},{"seVolume":1,"id":"6119D985-0F2D-42E9-BCD5-43F4E1197BEA","slideTitle":"スライド #72","voiceDuration":2.255283446712018,"voiceStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"backgroundName":"image75.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_アリス・マーガトロイド.wav","bgmStartTimeOffset":0,"duration":2.255283446712018,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","bgmVolume":0.7,"telop":"「それって、自由にお酒が飲めるってこと？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.072.jpeg","characterName":"アリス・マーガトロイド","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 72","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"seVolume":1,"id":"8912E5B0-58A5-48CD-A377-4945B9FC9653","slideTitle":"スライド #73","voiceDuration":7.289342403628118,"voiceStartTimeOffset":0,"voiceCharacter":"操夢","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"backgroundName":"image75.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_操夢.wav","bgmStartTimeOffset":0,"duration":7.289342403628118,"audioTrack":"track_voice_soumu","bgmVolume":0.7,"telop":"「ええ、昨日は不意打ちでしたが、今晩は夕食後に部屋に戻る二人とアリスさんと僕で別行動の予定ですよ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.073.jpeg","characterName":"操夢","voice2StartTimeOffset":0,"transitionName":"なし","title":"シーン 73","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png"},{"bgmVolume":0.7,"voiceCharacter":"古明地さとり","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.074.jpeg","duration":2.311791383219955,"voice2StartTimeOffset":0,"animationName":"なし","id":"5D38133A-74E4-4B4C-A8BE-C21BC0A9A3B5","title":"シーン 74","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png","voiceDuration":2.311791383219955,"slideTitle":"スライド #74","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"古明地さとり","telop":"「それだと、こいしがまた怒り出しそうだけど…」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.075.jpeg","duration":7.397369614512471,"voice2StartTimeOffset":0,"animationName":"なし","id":"B5A67B6C-B7F8-4179-B712-6B4A59A7EC20","title":"シーン 75","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png","voiceDuration":7.397369614512471,"slideTitle":"スライド #75","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"操夢","telop":"「そこで、一つ名案です。」僕はそう言いながら、ある券が入った首からぶら下げるカードケースをさとりにかける。","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"古明地さとり","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.076.jpeg","duration":1.5,"voice2StartTimeOffset":0,"animationName":"なし","id":"F5443460-542E-4230-BE45-616E8BEA8806","title":"シーン 76","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png","voiceDuration":1.5,"slideTitle":"スライド #76","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"古明地さとり","telop":"「これは…何？」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.077.jpeg","duration":8.553900226757369,"voice2StartTimeOffset":0,"animationName":"なし","id":"396F9BE9-1923-4E4F-91C5-08A0569E3A9C","title":"シーン 77","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png","voiceDuration":8.553900226757369,"slideTitle":"スライド #77","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"操夢","telop":"「ナイトプールの利用券ですよ。その券を見せれば、最大二人まで、日付が変わるまで遊び放題なので、楽しんでください。」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"古明地さとり","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.078.jpeg","duration":1.5,"voice2StartTimeOffset":0,"animationName":"なし","id":"D4871399-865D-43F4-B10D-36C8F91580BD","title":"シーン 78","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","voiceDuration":1.5,"slideTitle":"スライド #78","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"古明地さとり","telop":"「えっ？」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.079.jpeg","duration":7.33,"voice2StartTimeOffset":0,"animationName":"なし","id":"D8DCE3F9-792E-46DD-8BB2-4C31C99EDA17","title":"シーン 79","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","voiceDuration":7.33,"slideTitle":"スライド #79","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"操夢","telop":"「後一つ、もしナイトプールで寝ることなく、日付が変わるまで遊び尽くしたら、僕からお祝いがあると言ってください。」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.080.jpeg","duration":7.266938775510204,"voice2StartTimeOffset":0,"animationName":"なし","id":"89973100-87F1-4672-BB6B-5A34F55BA2CF","title":"シーン 80","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","voiceDuration":7.266938775510204,"slideTitle":"スライド #80","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"操夢","telop":"「ただし、事故が起きるのも嫌なので、その限度は弁えることができるように、さとりさんが彼女を見ててください。」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"古明地さとり","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.081.jpeg","duration":3.47859410430839,"voice2StartTimeOffset":0,"animationName":"なし","id":"6FA08C17-AEAC-49FE-AE6B-D17C78A1120C","title":"シーン 81","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","voiceDuration":3.47859410430839,"slideTitle":"スライド #81","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"古明地さとり","telop":"「あの、いいんですか…、\n彼女がそこまであなたに甘えさせてもらっても…」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"操夢","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.082.jpeg","duration":8.523469387755101,"voice2StartTimeOffset":0,"animationName":"なし","id":"7D92FDBD-E6A7-4151-BFD7-11F366E372BE","title":"シーン 82","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.tiff","voiceDuration":8.523469387755101,"slideTitle":"スライド #82","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"操夢","telop":"「彼女が、純粋に僕に甘えられるのは、この旅行までなんですから、残りの短い期間、思う存分懐かせたくはないですか？」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0},{"bgmVolume":0.7,"voiceCharacter":"古明地さとり","seVolume":1,"bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_古明地さとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.083.jpeg","duration":5.307891156462585,"voice2StartTimeOffset":0,"animationName":"なし","id":"CD3C60EA-D42A-405F-AD42-1E6F28AC8C89","title":"シーン 83","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","voiceDuration":5.307891156462585,"slideTitle":"スライド #83","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","seStartTimeOffset":0,"characterName":"古明地さとり","telop":"「分かりました…、ただ覚悟してくださいね…、彼女は人に懐くと固執しがちでヤキモチも妬きやすいので…」","transitionName":"なし","backgroundName":"image75.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceStartTimeOffset":0},{"telop":"「それくらいできてますよ。それに、さとりさんとアリスさんも本当なら、彼女みたいに…したくはありませんか？」","seVolume":1,"characterName":"操夢","backgroundName":"image75.jpeg","voiceDuration":7.282154195011338,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav","audioTrack":"track_voice_soumu","animationName":"なし","id":"66C4F589-6FC5-4407-80CE-3FD659132674","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","duration":7.282154195011338,"slideTitle":"スライド #84","voiceCharacter":"操夢","title":"シーン 84","bgmVolume":0.7,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.084.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"telop":"僕がそういうと、二人とも驚いた様子を浮かべる。","seVolume":1,"characterName":"操夢","backgroundName":"image75.jpeg","voiceDuration":3.182154195011338,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav","audioTrack":"track_voice_soumu","animationName":"なし","id":"77E50117-349B-4BDE-A8F0-843774B7160C","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","duration":3.182154195011338,"slideTitle":"スライド #85","voiceCharacter":"操夢","title":"シーン 85","bgmVolume":0.7,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.085.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png"},{"telop":"「あなたには…勝てませんよ…」私は、思わずそう呟く。","seVolume":1,"characterName":"古明地さとり","backgroundName":"image75.jpeg","voiceDuration":3.2419954648526077,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_古明地さとり.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","id":"0C2DDA8B-9F8A-4D78-A6A7-579A3B0FFC34","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","duration":3.2419954648526077,"slideTitle":"スライド #86","voiceCharacter":"古明地さとり","title":"シーン 86","bgmVolume":0.7,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.086.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"telop":"「私も、さとりさんの意見に同感ですよ…」","seVolume":1,"characterName":"アリス・マーガトロイド","backgroundName":"image75.jpeg","voiceDuration":2.4240362811791383,"transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","animationName":"なし","id":"55616C13-EF