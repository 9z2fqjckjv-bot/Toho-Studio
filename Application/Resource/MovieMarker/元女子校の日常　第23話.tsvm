SD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","backgroundName":"image73.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/「ねぇ」-88220.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.036.jpeg","telop":"僕は、彼女が何か言い淀んでいるような気がして、尋ねてみる。\n「何か、言いたいことがあるんじゃないですか…？」","transitionName":"なし","id":"13A98651-2CD2-4A84-8C5B-DD1AC3A84102","title":"シーン 36","duration":7.527823129251701,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第36スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.527823129251701,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","backgroundName":"image73.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/「ねぇ」-88220.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.037.jpeg","telop":"すると、彼女は表情が一瞬だけ変わる。だが、直後に注文したステーキが運ばれてきたため、それは聞けずじまいになった。","transitionName":"なし","id":"91AE4D4B-C04B-48EE-B20E-EAFAF4306B4C","title":"シーン 37","duration":8.839773242630386,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第37スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.839773242630386,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","backgroundName":"image73.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/「ねぇ」-88220.png"},{"seStartTimeOffset":0,"seVolume":0.252734375,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.038.jpeg","telop":"主人公のクラスメイト\n主人公のクラスメイト。彼が、転校してきて当初は、あれこれを彼に教えていた。彼が頼れる唯一の女子であり、何かと頼っている。彼がこいしの裸を見て、こいしが巨大組織、地下底国グループのご令嬢だと判明してからは、若干、彼との距離ができた。妹のこいしとは対照的な存在。\n古明地さとり","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc393553_【東方アレンジ】少女さとり【バロック風】.wav","transitionName":"なし","id":"24396AFE-B8CF-456A-9B8E-3F825071053E","title":"シーン 38","seName":"SE: nc393553_【東方アレンジ】少女さとり【バロック風】","duration":5,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第38スライド","animationName":"なし","characterName":"古明地さとり","bgmVolume":0.7,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/さとりごくり.png","backgroundName":"image73.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg"},{"audioTrack":"track_voice_soumu","seVolume":0.5062235617597292,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.039.jpeg","telop":"僕たちは、ステーキハウスからホテルに戻る途中にある小さな、市民ビーチに来ていた。周りには人が一人もいなかった。","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","transitionName":"なし","id":"C34237F8-86D2-44D6-954F-48AE98733E9A","title":"シーン 39","seName":"[SE] 海岸1.mp3","duration":7.850634920634921,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第39スライド","animationName":"なし","ch