:"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.035.jpeg","voiceCharacter":"古明地さとり","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","backgroundName":"image73.jpeg","characterName":"古明地さとり","seStartTimeOffset":0,"telop":"「私は…特にないので、紅夢さんたちに合わせますよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/「ねぇ」-88220.png","title":"シーン 35","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_古明地さとり.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"transitionName":"なし","duration":3.0205895691609976,"slideTitle":"スライド #35","voiceDuration":3.0205895691609976,"bgmStartTimeOffset":0,"id":"C1769A59-2EDC-4239-8520-F9A9FAACC485","animationName":"なし","bgmVolume":0.7},{"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.036.jpeg","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","audioTrack":"track_voice_soumu","backgroundName":"image73.jpeg","characterName":"操夢","seStartTimeOffset":0,"telop":"僕は、彼女が何かに、言い淀んでいる感じがし、それを尋ねる。\n「何か、言いたいことがあるんじゃないですか…？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/「ねぇ」-88220.png","title":"シーン 36","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"transitionName":"なし","duration":7.419115646258503,"slideTitle":"スライド #36","voiceDuration":7.419115646258503,"bgmStartTimeOffset":0,"id":"BC6EE2EE-C92F-4267-BDA2-422339B8FCE4","animationName":"なし","bgmVolume":0.7},{"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.037.jpeg","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","audioTrack":"track_voice_soumu","backgroundName":"image73.jpeg","characterName":"操夢","seStartTimeOffset":0,"telop":"すると、彼女は表情が一瞬だけ、変わる。だが、直後に注文したステーキが運ばれてきたのでは、それは聞けずじまいになった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/「ねぇ」-88220.png","title":"シーン 37","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"transitionName":"なし","duration":8.885419501133788,"slideTitle":"スライド #37","voiceDuration":8.885419501133788,"bgmStartTimeOffset":0,"id":"0AE36620-87DC-4F51-8E64-9E99E95EC5E9","animationName":"なし","bgmVolume":0.7},{"seVolume":0.252734375,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.038.jpeg","seName":"SE: nc393553_【東方アレンジ】少女さとり【バロック風】","backgroundName":"image73.jpeg","animationDuration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image73.jpeg","characterName":"古明地さとり","seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc393553_【東方アレンジ】少女さとり【バロック風】.wav","seStartTimeOffset":0,"telop":"主人公のクラスメイト\n主人公のクラスメイト。彼が、転校してきて当初は、あれこれを彼に教えていた。彼が頼れる唯一の女子であり、何かと頼っている。彼がこいしの裸を見て、こいしが巨大組織、地下底国グループのご令嬢だと判明してからは、若干、彼との距離ができた。妹のこいしとは対照的な存在。\n古明地さとり","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/さとりごくり.png","title":"シーン 38","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"transitionName":"なし","animationNote":"5秒","slideTitle":"スライド #38","duration":5,"bgmStartTimeOffset":0,"id":"84CF10F0-8B9B-47A7-B1A8-6E7D43EF94C5","animationName":"なし","bgmVolume":0.7},{"seVolume":0.5062235617597292,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.039.jpeg","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","audioTrack":"track_voice_soumu","backgroundName":"image74.jpeg","characterName":"操夢","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","seName":"[SE] 海岸1.mp3","seStartTimeOffset":0,"telop":"僕たちは、ステーキハウスからホテルに戻る途中にある小さな、市民ビーチに来ていた。周りには人が一人もいなかった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","title":"シーン 39","voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"transitionName":"なし","duration":7.850634920634921,"slideTitle":"スライド #39","voiceDuration":7.850634920634921,"bgmStartTimeOffset":0,"id":"BCEF1B9B-5173-47B5-8B1B-2D98781D298D","animationName":"なし","bgmVolume":0.7},{"seVolume":0.5062235617597292,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.040.jpeg","voiceCharacter":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","backgroundName":"image74.jpeg","characterName":"古明地こいし","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","seName":"[SE] 海岸1.mp3","seStartTimeOffset":-7.850634920634917,"telop":"「紅夢くんも一緒に、海で泳ごうよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","title":"シーン 40","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Sl