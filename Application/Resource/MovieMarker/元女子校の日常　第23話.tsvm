e74.jpeg","bgmStartTimeOffset":0,"backgroundName":"image74.jpeg","characterName":"古明地こいし","transitionName":"なし","seName":"[SE] 海岸1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-13.652993197278903,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"古明地こいし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_古明地こいし.wav","title":"シーン 43","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.043.jpeg","seVolume":0.5062235617597292,"duration":3.269047619047619,"bgmVolume":0.7,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","voiceDuration":3.269047619047619,"slideTitle":"第43スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","id":"DC239862-A571-4012-9E53-B207CD982F77"},{"audioTrack":"track_voice_soumu","seVolume":0.5062235617597292,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.044.jpeg","telop":"彼女はそう言うと、海の方へと駆け出していった。\n僕がふと砂浜に座り込むと、アリスが声をかけてくる。","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","transitionName":"なし","id":"366E3EB7-E92D-4EE9-AC51-C4D58C281150","title":"シーン 44","seName":"[SE] 海岸1.mp3","duration":7.213673469387755,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第44スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.213673469387755,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","backgroundName":"image74.jpeg","seStartTimeOffset":-16.92204081632653},{"telop":"「いいのかしら？ 彼女だけあんなにはしゃいでしまって。」","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","bgmStartTimeOffset":0,"backgroundName":"image74.jpeg","characterName":"アリス・マーガトロイド","transitionName":"なし","seName":"[SE] 海岸1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-24.135714285714272,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_アリス・マーガトロイド.wav","title":"シーン 45","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.045.jpeg","seVolume":0.5062235617597292,"duration":2.7670975056689344,"bgmVolume":0.7,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","voiceDuration":2.7670975056689344,"slideTitle":"第45スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","id":"748B937D-3CEE-4EEC-B753-BC5A51B92591"},{"telop":"「別にいいですよ。僕は、\nその姿を遠くから見るだけで十分満足ですから…。」","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","bgmStartTimeOffset":0,"backgroundName":"image74.jpeg","characterName":"操夢","transitionName":"なし","seName":"[SE] 海岸1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-26.902811791383215,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","title":"シーン 46","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.046.jpeg","seVolume":0