0-F47D8519DE9C"},{"telop":"僕は、その問いかけに衝撃を受け、時間が止まったのかと思ってしまう。それは、アリスとさとりも同じみたいだった。","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","bgmStartTimeOffset":0,"backgroundName":"image74.jpeg","characterName":"操夢","transitionName":"なし","seName":"[SE] 海岸1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-8.0331065759637,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","title":"シーン 64","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.064.jpeg","seVolume":0.35224609375,"duration":7.809342403628118,"bgmVolume":0.7,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","voiceDuration":7.809342403628118,"slideTitle":"第64スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","audioTrack":"track_voice_soumu","id":"F7B8C43A-14D7-4019-9FCB-71CC78F4898C"},{"telop":"彼女はそう言うと、いきなり僕に倒れかかってくる。\n僕はそれを受け止めると、そっと彼女をおんぶした。","bgmAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ2.mp3","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","bgmStartTimeOffset":2.22,"backgroundName":"image74.jpeg","characterName":"操夢","transitionName":"なし","seName":"[SE] 海岸1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-15.842448979591836,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","title":"シーン 65","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.065.jpeg","seVolume":0.35224609375,"bgmName":"BGM: 衣擦れ2","duration":7.338684807256236,"bgmVolume":2,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","voiceDuration":7.338684807256236,"slideTitle":"第65スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","audioTrack":"track_voice_soumu","id":"33EDFE6D-E536-42A1-A6DF-3A6D566792C3"},{"telop":"僕は、背後からついてくる二人の機嫌が悪くなっているのを感じながら、こいしを起こさぬように、車までおんぶしていった。","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","bgmStartTimeOffset":0,"backgroundName":"image74.jpeg","characterName":"操夢","transitionName":"なし","seName":"[SE] 海岸1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-23.18113378684808,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","title":"シーン 66","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.066.jpeg","seVolume":0.35224609375,"duration":7.6223809523809525,"bgmVolume":0.7,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","voiceDuration":7.6223809523809525,"slideTitle":"第66スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（怒り）.png","audioTrack":"track_voice_soumu","id":"92D6BA14-333C-4F9D-B9B5-6BB5295A937E"},{"seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.067.jpeg","telop":"紅魔建設代表\nフランと営む紅魔建設の代表であり、フランの姉である。かつて紅魔建設は、複数の身内従業員を抱える企業であったが、今では彼女と妹のフランの二人だけで営んでいる。そして、フランが主人公の彼に好意を抱いていると知ると、彼と結ばれるように、彼女を応援し、婚姻届のサインを彼の副人格にさせた。彼の同意があれば、フランと彼は見事結ばれる。だが、それが危うくなっている今は、学校と彼の両親を裏切って、彼を取り込もうとしている。\nレミリア・スカーレット","bgmName":"BGM: nc458855_【東方アレンジ】応援スカーレット!","transitionName":"なし","id":"A92BFB2F-203C-4731-AC6B-22365D082DDE","title":"シーン 67","duration":5,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc458855_【東方アレンジ】応援スカーレット!.mp3","showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第67スライド","animationName":"なし","characterName":"フランドール・スカーレット","bgmVolume":0.25141248153618906,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/レミリアジト涙目.png","backgroundName":"image74.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg"},{"audioTrack":"track_voice_soumu","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.068.jpeg","telop":"僕たちは、それからホテルに戻る。そして、車内で目覚めたこいしは、頬を赤らめながら、せっせと部屋の浴室に駆け込んでいった。","transitionName":"なし","id":"347737D7-186C-4B8C-9401-5B8BF5969FE8","title":"シーン 68","duration":8.822380952380952,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第68スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.822380952380952,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","seStartTimeOffset":0},{"audioTrack":"track_voice_soumu","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.069.jpeg","telop":"部屋に残った僕たちは、窓に差し込む夕陽を眺めていた。","transitionName":"なし","id":"ABAFBBFB-CFED-495E-AB93-9C33062A2E5D","title":"シーン 69","duration":3.762607709750567,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第69スライド","animationName":"なし","characterName":"操夢","voiceDuration":3.762607709750567,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","seStartTimeOffset":0},{"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.070.jpeg","telop":"「それで、今晩の夕食はどうするの？」","transitionName":"なし","id":"D15F2E99-D4DA-472F-BD12-2D4C56A6A57F","title":"シーン 70","duration":2.109024943310658,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第70スライド","animationName":"なし","characterName":"アリス・マーガトロイド","voiceDuration":2.109024943310658,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.071.jpeg","telop":"「今晩は、ホテル内のレストランでバイキングですよ。もちろん、お酒が飲みたいなら、ホテル内にバーもありますけど。」","transitionName":"なし","id":"FB198F3F-942E-400F-A9B6-0CBD2309996E","title":"シーン 71","duration":7.6256462585034015,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第71スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.6256462585034015,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png"},{"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.072.jpeg","telop":"「それって、自由にお酒が飲めるってこと？」","transitionName":"なし","id":"BD078D3A-7346-4FA9-B4B4-928445E80CC9","title":"シーン 72","duration":2.255283446712018,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第72スライド","animationName":"なし","characterName":"アリス・マーガトロイド","voiceDuration":2.255283446712018,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.073.jpeg","telop":"「ええ、昨日は不意打ちでしたが、今晩は夕食後にさとりさんとこいしさんの二人とアリスさんと僕で別行動の予定ですよ。」","transitionName":"なし","id":"F521228D-29E0-4683-A9DE-365E81135125","title":"シーン 73","duration":8.11390022675737,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第73スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.11390022675737,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.074.jpeg","telop":"「それだと、こいしがまた怒り出しそうですけど…」","transitionName":"なし","id":"7ED87E72-EC16-4A8A-9AE1-CD505D85D8EE","title":"シーン 74","duration":2.308390022675737,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第74スライド","animationName":"なし","characterName":"さ&り","voiceDuration":2.308390022675737,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_古明地さとり.wav","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.075.jpeg","telop":"「そこで、一つ名案があります。」僕はそう言いながら、ある券が入った首掛けのカードケースをさとりにかける。","transitionName":"なし","id":"C36C10D8-CC09-4412-845E-B276DE2D0160","title":"シーン 75","duration":7.310430839002268,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第75スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.310430839002268,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.076.jpeg","telop":"「これは…何ですか？」","transitionName":"なし","id":"49D2C413-1EB3-4A16-8C98-B38613B0F4FF","title":"シーン 76","duration":1.2077777777777778,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第76スライド","animationName":"なし","characterName":"さ&り","voiceDuration":1.2077777777777778,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_古明地さとり.wav","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/困り顔.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volum