seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.079.jpeg","telop":"「もう一つ、もしナイトプールで寝ることなく、日付が変わるまで遊び尽くしたら、僕からご褒美があると言ってください。」","transitionName":"なし","id":"AE9B2156-3827-44BF-BA1B-57FBC90BB9BE","title":"シーン 79","duration":7.50390022675737,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第79スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.50390022675737,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.080.jpeg","telop":"「ただし、事故が起きるのも嫌なので、その限度は弁えることができるように、さとりさんが彼女を見ててください。」","transitionName":"なし","id":"074C446D-DBE3-47AF-A5D3-41515346BEB0","title":"シーン 80","duration":7.266938775510204,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第80スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.266938775510204,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.081.jpeg","telop":"「あの、いいんですか…？\n彼女がそこまであなたに甘えてしまっても…」","transitionName":"なし","id":"E456C13B-7915-456A-97B8-E3714C7EA164","title":"シーン 81","duration":3.2949886621315194,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第81スライド","animationName":"なし","characterName":"さ&り","voiceDuration":3.2949886621315194,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_古明地さとり.wav","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.082.jpeg","telop":"「彼女が、純粋に僕に甘えられるのは、この旅行までなんですから、残りの短い期間、思う存分甘えさせたくはないですか？」","transitionName":"なし","id":"E54F38E2-C12D-4DE4-980B-2BF312440AA1","title":"シーン 82","duration":8.601723356009071,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第82スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.601723356009071,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.tiff"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.083.jpeg","telop":"「分かりました…、ただ覚悟してくださいね…、彼女は人に懐くと固執しがちでヤキモチも妬きやすいので…」","transitionName":"なし","id":"27874E2D-1AA6-41DA-AAE1-C0A78531AFCE","title":"シーン 83","duration":5.348684807256236,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第83スライド","animationName":"なし","characterName":"さ&り","voiceDuration":5.348684807256236,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_古明地さとり.wav","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.084.jpeg","telop":"「それくらいの覚悟はできてますよ。それに、さとりさんとアリスさんも本当なら、彼女みたいに…したくはありませんか？」","transitionName":"なし","id":"850CEE92-B628-4DDD-9E29-61F1E302F597","title":"シーン 84","duration":7.8691156462585035,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第84スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.8691156462585035,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.085.jpeg","telop":"僕がそう言うと、二人とも驚いた表情を浮かべる。","transitionName":"なし","id":"24CE7218-DA9E-4EBA-9E8D-EC6004F96B60","title":"シーン 85","duration":3.182154195011338,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第85スライド","animationName":"なし","characterName":"操夢","voiceDuration":3.182154195011338,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image75.jpeg","backgroundName":"image75.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.086.jpeg","telop":"「あなたには…敵いませんよ…」私は、思わずそう呟く。","transitionName":"なし","id":"C9336787-1796-4741-B571-E797671FFB3A","title":"シーン 86","duration":3.3065986394557823,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第86スライド","animationName":"なし","characterName":"さ&り","voiceDuration":3.3065986394557823,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_古明地さとり.wav","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"backgroundI