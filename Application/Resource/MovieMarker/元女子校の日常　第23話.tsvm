itHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.007.jpeg","telop":"元女子校の日常","transitionName":"なし","id":"D2168DF7-3AF9-47A8-BF6B-46DB6291FD8B","title":"東方Project二次創作作品　Powerd By zuyasi","duration":2.5,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"タイトル","animationName":"なし","characterName":"","bgmVolume":0.7,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"backgroundName":"単色背景","seStartTimeOffset":0},{"audioTrack":"track_voice_soumu","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.008.jpeg","telop":"僕たちが泊まる部屋に入ると、その部屋は和洋折衷の4人部屋だった。すると、後ろから感嘆の声が上がる。","transitionName":"なし","id":"C50DC246-CA23-4D39-8FE1-3A2E5EAC7A95","title":"シーン 8","duration":8.259342403628118,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第8スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.259342403628118,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","seStartTimeOffset":0},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.009.jpeg","telop":"「ここは4人部屋で、ベッドが2つに、布団が2組ある部屋ですよ。それで、誰がベッドを使いますか？」僕はそう、3人に聞く。","transitionName":"なし","id":"935C08C9-7A09-49CC-95D4-B4A05BCE8BFF","title":"シーン 9","duration":9.736507936507936,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第9スライド","animationName":"なし","characterName":"操夢","voiceDuration":9.736507936507936,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png"},{"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.010.jpeg","telop":"「私は、どっちでもいいわよ。」","transitionName":"なし","id":"5A307861-A0CE-4494-B6C4-8544BB1BF556","title":"シーン 10","duration":1.6573015873015873,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第10スライド","animationName":"なし","characterName":"アリス・マーガトロイド","voiceDuration":1.6573015873015873,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/アリス（微笑）.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.011.jpeg","telop":"「私は、ベッドがいいな…。」","transitionName":"なし","id":"EE7817FC-7A9B-4F11-A7FE-3B71B262B683","title":"シーン 11","duration":2.3685034013605444,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第11スライド","animationName":"なし","characterName":"古明地こいし","voiceDuration":2.3685034013605444,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_古明地こいし.wav","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.012.jpeg","telop":"「私は、紅夢さんの意見に合わせますよ。」","transitionName":"なし","id":"0D61BC4D-A83D-47E4-85DD-923153B2DAC3","title":"シーン 12","duration":2.266984126984127,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第12スライド","animationName":"なし","characterName":"さ&り","voiceDuration":2.266984126984127,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_古明地さとり.wav","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.013.jpeg","telop":"「それじゃあ、ベッドはこいしさんとさとりさん、\n布団で寝るのは、僕とアリスさんで構いませんか？」","transitionName":"なし","id":"81C1991A-2378-4F9E-8E96-E0354448AAF2","title":"シーン 13","duration":5.977823129251701,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第13スライド","animationName":"なし","characterName":"操夢","voiceDuration":5.977823129251701,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.014.jpeg","telop":"僕がそう言うと、3人は頷き、部屋の割り振りが決まった。\n「それで、アリスさんは、これからどうしますか？」","transitionName":"なし","id":"9F3D4083-5358-45F8-9350-CE1A7A11999B","title":"シーン 14","duration":7.174557823129252,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第14スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.174557823129252,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png"},{"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.015.jpeg","telop":"「特にやりたいこともないわよ…、何か計画でもあるの？」","transitionName":"なし","id":"B5827DC4-32E6-4FB5-89BC-F9CFD3041B1C","title":"シーン 15","duration":2.8740362811791385,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第15スライド","animationName":"なし","characterName":"アリス・マーガトロイド","voiceDuration":2.8740362811791385,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.016.jpeg","telop":"僕は、彼女にそう言われ、少しばかし考え込む。こいしとさとりが休んでいる間に、アリスと出かけてもいいのかな…と。","transitionName":"なし","id":"FF570438-105C-4D09-A00D-5359EBACF369","title":"シーン 16","duration":8.147369614512472,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第16スライド","animationName":"なし","characterName":"操夢","voiceDuration":8.147369614512472,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.017.jpeg","telop":"「私たちのことは、今は気にしなくていいよ、紅夢。」","transitionName":"なし","id":"5A10FC2D-6394-4029-91D1-EBD00DDCCA81","title":"シーン 17","duration":4.625396825396826,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第17スライド","animationName":"なし","characterName":"古明地こいし","voiceDuration":4.625396825396826,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_古明地こいし.wav","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.018.jpeg","telop":"「そうですか…、少し昼食のタイミングが遅くなるかもしれませんが、それでも大丈夫なら…、提案できますけど…。」","transitionName":"なし","id":"502A2471-1041-4D77-A7E0-0CE55857FC3D","title":"シーン 18","duration":7.166938775510204,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第18スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.166938775510204,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.019.jpeg","telop":"「分かった…。」","transitionName":"なし","id":"2738B50B-FFCB-436A-8405-85C41674DB18","title":"シーン 19","duration":1.0300907029478459,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第19スライド","animationName":"なし","characterName":"古明地こいし","voiceDuration":1.0300907029478459,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_古明地こいし.wav","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.020.jpeg","telop":"「それなら、近くに観光スポットがあるので、\nそこに行きますか？アリスさん？」","transitionName":"なし","id":"4254DCB1-8186-4838-BF53-F49D9529697B","title":"シーン 20","duration":5.243038548752835,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第20スライド","animationName":"なし","characterName":"操夢","voiceDuration":5.243038548752835,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png"},{"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.021.jpeg","telop":"「分かったわ。それじゃあ、行きましょうか…。」\n私は、それから彼と共に観光スポットに車で向かった。","transitionName":"なし","id":"E3049D3C-2056-4D75-87BC-DB555876AD63","title":"シーン 21","duration":5.807573696145124,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第21スライド","animationName":"なし","characterName":"アリス・マーガトロイド","voiceDuration":5.807573696145124,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_アリス・マーガトロイド.wav","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/アリス（微笑）.png"},{"seStartTimeOffset":0,"seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.022.jpeg","telop":"主人公の副人格\n主人公の彼が、以前に通っていた男子校での陰湿な出来事からくるダメージにより、徐々に分離していった彼の副人格。実際に目に見える様に、現れたのは中学以降で、彼女は彼の記憶を見て、彼と同様の頭の良さがあり、運動も得意。彼が貧血などの特定の現象を起こすと、現れるのが特徴。","bgmName":"BGM: video","transitionName":"なし","id":"B38E0F51-CD46-4DFB-A34D-C5002AA66DA0","title":"シーン 22","duration":5,"bgmAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/video.mp4","showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第22スライド","animationName":"なし","characterName":"キャラクター","bgmVolume":0.2577824963072378,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/微笑.png","backgroundName":"image71.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg"},{"telop":"僕たちはあれから、万座毛という場所に来ていた。すると、海風が吹いてくる。「少し肌寒くなってきたな…」","bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg","bgmStartTimeOffset":0,"backgroundName":"image72.jpeg","characterName":"操夢","transitionName":"なし","seName":"[SE] 風が吹く1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":0,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","title":"シーン 23","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.023.jpeg","seVolume":0.30776491116751253,"bgmName":"[BGM] 海岸1.mp3","duration":7.593038548752834,"bgmVolume":0.4099328468697123,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/風が吹く1.mp3","voiceDuration":7.593038548752834,"slideTitle":"第23スライド","audioTrack":"track_voice_soumu","id":"9DC9AF30-3CAC-47BE-863D-D3AB78EEE3C6"},{"telop":"「なんだか、肌寒いわね…」私はそう、彼に呟く。","bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg","bgmStartTimeOffset":-7.59303854875283,"backgroundName":"image72.jpeg","characterName":"アリス・マーガトロイド","transitionName":"なし","seName":"[SE] 風が吹く1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-7.59303854875283,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"アリス・マーガトロイド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_アリス・マーガトロイド.wav","title":"シーン 24","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.024.jpeg","seVolume":0.30776491116751253,"bgmName":"[BGM] 海岸1.mp3","duration":3.2190249433106577,"bgmVolume":0.4099328468697123,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/風が吹く1.mp3","voiceDuration":3.2190249433106577,"slideTitle":"第24スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","id":"2D9CB76D-DF63-41F8-8DEA-54612EBCD82D"},{"telop":"「確かにそうですね…。とりあえず、施設に戻りますか…。」\nそれから僕たちは、ここにくる前に通った案内施設に戻った。","bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/海岸1.mp3","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg","bgmStartTimeOffset":-10.812063492063487,"backgroundName":"image72.jpeg","characterName":"操夢","transitionName":"なし","seName":"[SE] 風が吹く1.mp3","voiceStartTimeOffset":0,"seStartTimeOffset":-10.812063492063487,"voice2StartTimeOffset":0,"showTelopOverlay":false,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","title":"シーン 25","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.025.jpeg","seVolume":0.30776491116751253,"bgmName":"[BGM] 海岸1.mp3","duration":8.509342403628118,"bgmVolume":0.4099328468697123,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/風が吹く1.mp3","voiceDuration":8.509342403628118,"slideTitle":"第25スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","audioTrack":"track_voice_soumu","id":"D5EA0598-BE4E-4309-BF44-A658605932D7"},{"seStartTimeOffset":0,"seVolume":0.85,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.026.jpeg","telop":"主人公の母の友人\n主人公の彼の母、博麗霊夢の友人。彼とは、霊夢を介して一緒に、カラオケに出かける仲。そして、彼に、ときどき謎の小瓶を手渡しては、それを飲ませ、対価として小遣いを与えていた。だが、ある日、突如として繁華街で暴れた彼女は、学校の命令で、彼と交代する形で霊夢と妹紅と同じ家で共に暮らすことになった。\n霧雨魔理沙","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc356864_【ジングル？】恋色マジック.mp3","transitionName":"なし","id":"17BCFA45-1728-4697-BFE4-645C4328BB41","title":"シーン 26","seName":"SE: nc356864_【ジングル？】恋色マジック","duration":5,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第26スライド","animationName":"なし","characterName":"博麗霊夢","bgmVolume":0.7,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/霧雨魔理沙_通常.png","backgroundName":"image72.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image72.jpeg"},{"audioTrack":"track_voice_soumu","seVolume":1,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_d9b92beffa\/元女子校の日常　第23話_d9b92beffa.027.jpeg","telop":"僕とアリスがホテルに早めに戻ると、僕が提案した、\n全国展開をしているステーキハウスに四人でやってきた。","transitionName":"なし","id":"425FD33E-B66D-4CB8-B993-35333A419083","title":"シーン 27","duration":7.073469387755102,"showTelopOverlay":false,"bgmStartTimeOffset":0,"slideTitle":"第27スライド","animationName":"なし","characterName":"操夢","voiceDuration":7.073469387755102,"bgmVolume":0.7,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","voiceCharacter":"操夢","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/reposit