[{"seVolume":1,"id":"CA1EED2E-7BA5-4EFD-B9B3-69BFAE9832E2","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image69.jpeg","animationName":"なし","audioTrack":"track_voice_soumu","transitionName":"なし","voiceDuration":7.857165532879819,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.001.jpeg","characterName":"操夢","title":"シーン 1","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","bgmStartTimeOffset":0,"backgroundName":"image69.jpeg","slideTitle":"スライド #1","bgmVolume":0.7,"voiceStartTimeOffset":0,"telop":"あれから僕たちは、朝食を間にとって、恩納村にあるホテルにお昼前に着いた。そして、アリスが車を停めに向かう。\n東方Project二次創作作品","seStartTimeOffset":0,"duration":7.857165532879819,"voiceCharacter":"操夢"},{"seVolume":1,"id":"363903C3-3045-4C9D-93EC-4097608E419F","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","animationName":"なし","audioTrack":"track_voice_soumu","transitionName":"なし","voiceDuration":8.09954648526077,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.002.jpeg","characterName":"操夢","title":"シーン 2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","bgmStartTimeOffset":0,"backgroundName":"image70.jpeg","slideTitle":"スライド #2","bgmVolume":0.7,"voiceStartTimeOffset":0,"telop":"アリスが車を停めに行っている間、僕はチェックインの手続きを済ます。そして、ロビーのソファで休んでいる二人の元に戻る。\n作成者：zuyasi","seStartTimeOffset":0,"duration":8.09954648526077,"voiceCharacter":"操夢"},{"seVolume":1,"id":"4EBB82E6-A721-48F7-A793-3DEE61F88809","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","animationName":"なし","audioTrack":"track_voice_soumu","transitionName":"なし","voiceDuration":8.573469387755102,"voice2StartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.003.jpeg","characterName":"操夢","title":"シーン 3: 僕が二人の元に来ると、ここまでの道中やホテルに対する感想を呟いていた。「お昼ご飯までは、休憩の時間にしますか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","bgmStartTimeOffset":0,"backgroundName":"image70.jpeg","slideTitle":"スライド #3","bgmVolume":0.7,"voiceStartTimeOffset":0,"telop":"僕が二人の元に来ると、ここまでの道中やホテルに対する感想を呟いていた。「お昼ご飯までは、休憩の時間にしますか？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png","seStartTimeOffset":0,"duration":8.573469387755102,"voiceCharacter":"操夢"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png","characterName":"古明地こいし","telop":"「そうしようかな…」\n制作ソフト及び協力\nGemini\nTohoStuido","voice2StartTimeOffset":0,"voiceDuration":1.5,"voiceCharacter":"古明地こいし","id":"B7A5358F-77AA-4E2D-B167-7C81D36E82E9","bgmVolume":0.7,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"image70.jpeg","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.004.jpeg","slideTitle":"スライド #4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","title":"シーン 4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地こいし.wav","duration":1.5,"transitionName":"なし","bgmStartTimeOffset":0,"animationName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png","characterName":"古明地さとり","telop":"「私も、こいしと同様に休憩の時間を取りたいです…」","voice2StartTimeOffset":0,"voiceDuration":2.9151927437641723,"voiceCharacter":"古明地さとり","id":"A11F3FD8-29BC-4FD6-9425-421E4BBCD518","bgmVolume":0.7,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"image70.jpeg","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.005.jpeg","slideTitle":"スライド #5","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","title":"シーン 5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地さとり.wav","duration":2.9151927437641723,"transitionName":"なし","bgmStartTimeOffset":0,"animationName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/困った笑み小口笑い.png","characterName":"操夢","telop":"「分かりました…」僕たちがそう話していると、アリスがやってくる。それから、僕たちは、今日から泊まる4人部屋に移動した。","voice2StartTimeOffset":0,"voiceDuration":8.366938775510205,"voiceCharacter":"操夢","id":"E874D5A6-B083-4032-8D1A-EA1A48724A76","bgmVolume":0.7,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"image70.jpeg","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.006.jpeg","slideTitle":"スライド #6","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image70.jpeg","title":"シーン 6","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","duration":8.366938775510205,"transitionName":"なし","bgmStartTimeOffset":0,"animationName":"なし","audioTrack":"track_voice_soumu"},{"characterName":"操夢","telop":"元女子校の日常","voice2StartTimeOffset":0,"seStartTimeOffset":0,"bgmVolume":0.7,"id":"D222D784-E761-4BF6-B0C5-26AC8DC49FD0","seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"単色背景","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.007.jpeg","slideTitle":"スライド #7","title":"シーン 7: 東方Project二次創作作品　Powerd By zuyasi","duration":2.5,"transitionName":"なし","bgmStartTimeOffset":0,"animationName":"なし"},{"characterName":"操夢","telop":"僕たちがそれから、泊まる部屋にやってくると、その部屋は和洋折衷の4人部屋だった。すると、後ろから驚きの声がする。","voice2StartTimeOffset":0,"voiceDuration":8.420204081632653,"voiceCharacter":"操夢","id":"188D9220-13E4-47D0-AC8D-7F74FE81E6C7","bgmVolume":0.7,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"image71.jpeg","voiceStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.008.jpeg","slideTitle":"スライド #8","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","title":"シーン 8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","duration":8.420204081632653,"transitionName":"なし","bgmStartTimeOffset":0,"animationName":"なし","audioTrack":"track_voice_soumu"},{"title":"シーン 9","voice2StartTimeOffset":0,"seVolume":1,"backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","voiceDuration":9.623469387755103,"characterName":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","seStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.009.jpeg","telop":"「ここは、4人部屋で、ベッドが2つに、布団が2つある部屋ですよ。それで、誰がベッドを使いますか？」僕はそう、3人に聞く。","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","audioTrack":"track_voice_soumu","duration":9.623469387755103,"slideTitle":"スライド #9","bgmVolume":0.7,"voiceStartTimeOffset":0,"id":"43A9DE37-5473-422B-A368-702DE67B391D"},{"title":"シーン 10","voice2StartTimeOffset":0,"seVolume":1,"backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/アリス（微笑）.png","voiceDuration":1.6573015873015873,"characterName":"アリス・マーガトロイド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","seStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.010.jpeg","telop":"「私は、どっちでもいいわよ。」","animationName":"なし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","duration":1.6573015873015873,"slideTitle":"スライド #10","bgmVolume":0.7,"voiceStartTimeOffset":0,"id":"610C0A34-A280-4A13-99E4-D7EDC8F6387D"},{"title":"シーン 11","voice2StartTimeOffset":0,"seVolume":1,"backgroundName":"image71.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/こいし（微笑）.png","voiceDuration":2.3685034013605444,"characterName":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image71.jpeg","seStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/