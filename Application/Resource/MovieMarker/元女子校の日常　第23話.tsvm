eName":"[SE] 海岸1.mp3","seStartTimeOffset":-33.455532879818605,"telop":"「あなた、それ本音なのですか？」\n私は、彼の発言に思わず驚き、そう尋ねてしまう。"},{"characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"backgroundName":"image74.jpeg","voiceStartTimeOffset":0,"duration":2.53,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","seVolume":0.5062235617597292,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","voiceCharacter":"操夢","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.048.jpeg","bgmStartTimeOffset":0,"slideTitle":"スライド #48","audioTrack":"track_voice_soumu","id":"BF316543-B0E7-4E4D-8C02-D4D0BC948474","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/image74.jpeg","title":"シーン 48","voiceDuration":2.53,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/海岸1.mp3","seName":"[SE] 海岸1.mp3","seStartTimeOffset":-38.731383219954665,"telop":"「ええ、そうですけど…、それが何か？」"},{"characterName":"操夢","bgmVolume":0.7,"voice2StartTimeOffset":0,"backgroundName":"image74.jpeg","voiceStartTimeOffset":0,"duration":3.973469387755102,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","seVolume":0.5062235617597292,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voiceCharacter":"操夢","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第23話_17cc036f5a\/元女子校の日常　第23話_17cc036f5a.049.jpeg","bgmStartTimeOffset":0,"slideTitle":"スライド #49","audioTrack":"track_voice_soumu","id":"5C654DEF-2D6B-419E-80F3-37EA83820556","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.