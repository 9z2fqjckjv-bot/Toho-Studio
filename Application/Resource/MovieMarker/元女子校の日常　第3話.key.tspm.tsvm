[{"id":"C2ADE1AC-9F2C-4529-8E60-5851A13BB254","voiceDuration":3.814761904761905,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.001.jpeg","slideTitle":"第1スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「んっ…ここは…」僕はふと目が覚めると、そう呟く。\n東方Project二次創作作品","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 1","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"05C159CC-F0C3-4373-A96E-8DDD92FBEE09","voiceDuration":2.876984126984127,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.002.jpeg","slideTitle":"第2スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「おや、目が覚めたかい…、紅夢君…」\n作成者：zuyasi","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_霧雨魔理沙.wav","characterName":"霧雨魔理沙","animationName":"なし","title":"シーン 2","audioTrack":"track_voice_marisa","transitionName":"なし","voiceCharacter":"霧雨魔理沙"},{"id":"D10AE88C-7463-4E8E-8676-6FAF2234383F","voiceDuration":3.316938775510204,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.003.jpeg","slideTitle":"中扉","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"","duration":3,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","characterName":"操夢","animationName":"なし","title":"「あなたは…魔理沙さんですか…母の友達の…」","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"DC437BCD-185E-4C29-9A37-8904B10888A7","voiceDuration":2.4344897959183673,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.004.jpeg","slideTitle":"第4スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「ああ…そうだ…。それより…」\n制作ソフト及び協力\nGemini\nTohoStuido","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","characterName":"霧雨魔理沙","animationName":"なし","title":"シーン 4","audioTrack":"track_voice_marisa","transitionName":"なし","voiceCharacter":"霧雨魔理沙"},{"id":"ECB6984C-28F4-45B5-8049-CD5D97DD7DC5","voiceDuration":2.5930385487528347,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.005.jpeg","slideTitle":"第5スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「何か、言いたいことでもあるのですか？」","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 5","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"8C57F805-2ACE-489E-ABFF-008D869A535F","voiceDuration":5.053242630385488,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.006.jpeg","slideTitle":"第6スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","duration":3.5,"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav","characterName":"霧雨魔理沙","animationName":"なし","title":"シーン 6","audioTrack":"track_voice_marisa","transitionName":"なし","voiceCharacter":"霧雨魔理沙"},{"id":"4F44192A-6219-4F23-AC02-2D3C1B4CA897","voiceDuration":6.027823129251701,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.007.jpeg","slideTitle":"第7スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","duration":3.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 7","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"C1DDF62A-DB91-4175-93C7-6BA23FB61CAA","voiceDuration":7.018231292517007,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.008.jpeg","slideTitle":"第8スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","duration":4.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_霧雨魔理沙.wav","characterName":"霧雨魔理沙","animationName":"なし","title":"シーン 8","audioTrack":"track_voice_marisa","transitionName":"なし","voiceCharacter":"霧雨魔理沙"},{"id":"6C944156-F35D-4D94-97CE-A520EAF45CCE","voiceDuration":5.20498866213152,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.009.jpeg","slideTitle":"第9スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","duration":3.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 9","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"backgroundName":"単色背景","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第3話_c997bea981\/slide_010_anim.m4v","telop":"元女子校の日常","voiceCharacter":"","slideTitle":"タイトル","characterName":"","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.010.jpeg","animationName":"バウンス","duration":19,"id":"6B5DFB21-1E2C-4078-A480-C05F1BF8D7FD","title":"東方Project二次創作作品　Powerd By zuyasi"},{"id":"DB79B539-8C9B-4C26-8B67-1109D66ABE11","voiceDuration":3.490861678004535,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.011.jpeg","slideTitle":"第11スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 11","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"806F1048-2CB5-44BB-9BB8-8C55DF3B4E4B","voiceDuration":6.755736961451247,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.012.jpeg","slideTitle":"第12スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 12","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"2ED38CCB-0E03-4E81-A666-1061C891E11A","voiceDuration":6.414761904761905,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.013.jpeg","slideTitle":"第13スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","duration":4.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 13","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"C642960E-0873-4FD3-B019-ADD0D64BA798","voiceDuration":3.9094784580498865,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.014.jpeg","slideTitle":"第14スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「それに…最近…魔理沙の様子が変なのよね…」","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 14","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"6615AF15-0078-4E63-8A65-692D51704698","voiceDuration":6.35172335600907,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.015.jpeg","slideTitle":"第15スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","duration":4.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 15","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"6B966A7A-FE30-448B-B5D6-50091B00F823","voiceDuration":10.184489795918367,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.016.jpeg","slideTitle":"第16スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":5.800000000000001,"title":"シーン 16","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"7C094679-16BD-458C-B9AA-CCE01DE3C70F","voiceDuration":6.690861678004535,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.017.jpeg","slideTitle":"第17スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","duration":4.3,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 17","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"E25B6057-7A71-435D-A5D2-6C4B6D32B15E","voiceDuration":4.321292517006802,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.018.jpeg","slideTitle":"第18スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 18","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"附属病院のある診察室では…","voiceCharacter":"ナレーション","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第19スライド","characterName":"ナレーション","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.019.jpeg","animationName":"なし","duration":3.5,"id":"011E8A2A-78F1-48EB-BCE0-1A681B5C78E2","title":"シーン 19"},{"id":"253EE2E1-AA43-4E2F-A380-B41E1652FBCE","voiceDuration":4.969614512471655,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.020.jpeg","slideTitle":"第20スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","duration":3.7,"title":"シーン 20","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"B5F453DA-2227-4639-AC9A-524720308BEB","voiceDuration":9.234897959183673,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.021.jpeg","slideTitle":"第21スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","duration":5.800000000000001,"title":"シーン 21","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"6E03DD30-B781-4C41-B62E-2F5760297D55","voiceDuration":7.198843537414966,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.022.jpeg","slideTitle":"第22スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","duration":4.5,"title":"シーン 22","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"B4E5C588-30DF-478D-84B5-44547CC17382","voiceDuration":8.691632653061225,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.023.jpeg","slideTitle":"第23スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","duration":6,"title":"シーン 23","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"A8FAA697-4CB3-4C5A-83DE-AC87E1D87973","voiceDuration":8.215668934240362,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.024.jpeg","slideTitle":"第24スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","duration":5.300000000000001,"title":"シーン 24","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","id":"A81F7403-0E46-40FA-89E7-8CE428A4618E","voiceDuration":7.20421768707483,"seName":"SE: 木のドアをノック1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.025.jpeg","slideTitle":"第25スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","duration":4.3,"title":"シーン 25","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"4EF31211-A9C2-4030-8906-E7DE1F99B536","voiceDuration":7.111587301587302,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.026.jpeg","slideTitle":"第26スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","duration":4.9,"title":"シーン 26","characterName":"射命丸文","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_射命丸文.wav","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"射命丸文"},{"id":"34409548-7AA4-4846-871F-A14EA5847931","voiceDuration":8.62358276643991,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.027.jpeg","slideTitle":"第27スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","duration":5.800000000000001,"title":"シーン 27","characterName":"射命丸文","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_射命丸文.wav","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"射命丸文"},{"id":"822CCB44-E5E7-4023-8C77-16E2165759C8","voiceDuration":7.520181405895691,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.028.jpeg","slideTitle":"第28スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","duration":5.7,"title":"シーン 28","characterName":"射命丸文","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_射命丸文.wav","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"射命丸文"},{"id":"CC19BE2D-EF0C-43C3-98DD-B7C9522B097A","voiceDuration":3.6015873015873017,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.029.jpeg","slideTitle":"第29スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それと、息子さんの言ってたことは全て事実だそうですよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","duration":3.5,"title":"シーン 29","characterName":"射命丸文","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_射命丸文.wav","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"射命丸文"},{"id":"D50B8A6C-5F08-4331-B78B-073363C7C46D","voiceDuration":7.237573696145125,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.030.jpeg","slideTitle":"第30スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","duration":4.800000000000001,"title":"シーン 30","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"FD1EE89E-D993-4401-8E8D-DB3D59B118CC","voiceDuration":4.105578231292517,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.031.jpeg","slideTitle":"第31スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「代金、確かにいただきました。それでは、またのご利用を。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","duration":3.5,"title":"シーン 31","characterName":"射命丸文","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_射命丸文.wav","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"射命丸文"},{"id":"9884E78D-20D5-4019-83E9-3BFEE9C88E8E","voiceDuration":6.213832199546485,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.032.jpeg","slideTitle":"第32スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」","duration":4.7,"title":"シーン 32","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"id":"13C1A9F1-9033-4621-8532-EE188E3F7533","voiceDuration":7.338072562358277,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.033.jpeg","slideTitle":"第33スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。","duration":5,"title":"シーン 33","characterName":"八意永琳","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"永琳"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼に視点が戻り…","voiceCharacter":"ナレーション","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第34スライド","characterName":"ナレーション","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.034.jpeg","animationName":"なし","duration":3.5,"id":"C9C25E72-3625-4B70-9067-7D2A35711DCA","title":"シーン 34"},{"id":"6EE3CFA9-5905-43FF-B175-448A3AA9A3F2","voiceDuration":9.285419501133786,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.035.jpeg","slideTitle":"第35スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…","duration":5.9,"title":"シーン 35","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"3CDCF089-CFF9-41C9-A8FF-54FDBF137507","voiceDuration":8.366938775510205,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.036.jpeg","slideTitle":"第36スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。","duration":5.300000000000001,"title":"シーン 36","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"C2EAF86B-6C5B-46CF-96FC-BD32EAD9342F","voiceDuration":8.261519274376417,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.037.jpeg","slideTitle":"第37スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。","duration":5.5,"title":"シーン 37","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"F1FF774D-FDC9-49DC-8B5F-7D47225F7E7F","voiceDuration":8.697369614512471,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.038.jpeg","slideTitle":"第38スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。","duration":5.6000000000000005,"title":"シーン 38","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"DEE397A5-C0C7-42FA-8F7D-A7BC4C43291A","voiceDuration":8.525646258503402,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.039.jpeg","slideTitle":"第39スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。","duration":5.300000000000001,"title":"シーン 39","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"8A8622EF-E7B9-4F51-B5E8-060DF587C577","voiceDuration":7.856077097505669,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.040.jpeg","slideTitle":"第40スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。","duration":5,"title":"シーン 40","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"DEF0C471-2FFA-475D-A9EB-217026276CD8","voiceDuration":6.240861678004535,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.041.jpeg","slideTitle":"第41スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。","duration":3.8000000000000003,"title":"シーン 41","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"0070BA06-B588-4D06-BBC0-DBFE2F531A11","voiceDuration":8.803900226757369,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.042.jpeg","slideTitle":"第42スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。","duration":5.6000000000000005,"title":"シーン 42","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"B5DC46E0-D015-460A-BA19-8A52FD10453D","voiceDuration":8.601723356009071,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.043.jpeg","slideTitle":"第43スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…","duration":5.2,"title":"シーン 43","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"7CA8B78B-959E-4B6F-9A78-D82DA80E9142","voiceDuration":1.5,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.044.jpeg","slideTitle":"第44スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そう、それは…","duration":3.5,"title":"シーン 44","characterName":"操夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","audioTrack":"track_voice_soumu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceCharacter":"操夢"},{"id":"BE6F8F24-3B37-4761-BD57-9DC3E8A10BDE","voiceDuration":2.481995464852608,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.045.jpeg","slideTitle":"第45スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"「よかったわ、目が覚めたようで。」","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 45","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"467A9584-DEB7-419D-8DE1-6D34D856F7F2","voiceDuration":3.186984126984127,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.046.jpeg","slideTitle":"第46スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"「母さん…」\n僕は、そう彼女に返す。","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 46","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"41B4EBD7-9EAD-4930-B0F8-7FF91280FB1D","voiceDuration":7.301995464852608,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.047.jpeg","slideTitle":"第47スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"「あんたが、呻いてるから、私が何度も声かけたのよ…、\n私に心配かけさせないでちょうだい…」","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 47","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"53AC39B4-54C3-4F14-B416-8B278FE57CC2","voiceDuration":1.5,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.048.jpeg","slideTitle":"第48スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"「ご…ごめんなさい…」","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 48","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"id":"2E8662A5-914D-43F9-8BD3-2B31DC55234A","voiceDuration":7.1394784580498865,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.049.jpeg","slideTitle":"第49スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"「いいわよ、謝らなくて、とりあえず、\n今晩はゆっくりと寝て、疲労回復に努めなさいね…」","duration":4.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 49","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"DB0A29F0-05D9-4E1F-B59C-0D5F745A2F87","voiceDuration":3.754489795918367,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.050.jpeg","slideTitle":"第50スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"「これから私は家に帰るから、しっかりするのよ…」","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_博麗霊夢.wav","characterName":"博麗霊夢","animationName":"なし","title":"シーン 50","audioTrack":"track_voice_reimu","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"FED39CE6-044F-4E40-A68E-5F9E601F8F93","voiceDuration":8.90281179138322,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.051.jpeg","slideTitle":"第51スライド","backgroundName":"nc256899_病室-夜-電気あり.png","telop":"彼女は、そういうと、涙を拭いながら、病室を出ていった。\n僕は、先ほどの悪夢で疲れ込んだのか、そのまま眠りに落ちた。","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","characterName":"操夢","animationName":"なし","title":"シーン 51","audioTrack":"track_voice_soumu","transitionName":"なし","voiceCharacter":"操夢"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"霊夢が家に帰ると…","voiceCharacter":"博麗霊夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第52スライド","characterName":"博麗霊夢","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.052.jpeg","animationName":"なし","duration":3.5,"id":"D14D6CD2-2AD3-4BD1-9C9A-12FB8BDDBE08","title":"シーン 52"},{"id":"7BAE1927-A09E-43F7-BBD0-4F5550E7DD8A","voiceDuration":4.031995464852607,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.053.jpeg","slideTitle":"第53スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"私が家に帰ってくると、すでに夫がリビングにいた。","duration":3.5,"title":"シーン 53","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav","audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"E0CA8688-B14B-4B4B-BD91-9837F5256704","voiceDuration":6.243333333333333,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.054.jpeg","slideTitle":"第54スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「霊夢、お前その顔どうした？」\n私は、彼女が泣いた後の表情をしていたのでそう問いかける。","duration":4.3,"title":"シーン 54","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"362E742D-5929-41E7-B1C8-5811492E9A53","voiceDuration":4.3644897959183675,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.055.jpeg","slideTitle":"第55スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そんなことどうだっていいわ、それより、夕飯は食べたの？」","duration":3.5,"title":"シーン 55","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav","audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"8C55C272-5E63-4B95-8411-E37CDF4EF09D","voiceDuration":3.26,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.056.jpeg","slideTitle":"第56スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」","duration":3.5,"title":"シーン 56","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"007A59D6-5222-4390-9230-EFA4B437F64A","voiceDuration":6.735736961451247,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.057.jpeg","slideTitle":"第57スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。","duration":4.5,"title":"シーン 57","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav","audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"霊夢がお風呂を澄ますと…","voiceCharacter":"博麗霊夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第58スライド","characterName":"博麗霊夢","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.058.jpeg","animationName":"なし","duration":3.5,"id":"AE5922B7-8DF4-4F3E-828B-B17AC72C5E0F","title":"シーン 58"},{"id":"8BF4CE3A-C642-46F6-909A-0FB1089C8585","voiceDuration":8.424489795918367,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.059.jpeg","slideTitle":"第59スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"私がお風呂から戻ってくると、彼はビール缶をあけ、ため息をついていた。「何か現場仕事に不満でもあるの？」","duration":5.1000000000000005,"title":"シーン 59","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav","audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"833CF449-FB30-4DDB-996D-01D8ECD3D279","voiceDuration":3.305827664399093,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.060.jpeg","slideTitle":"第60スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「今日は、例の紅魔建設からの依頼だったんだけど…」","duration":3.5,"title":"シーン 60","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"7B7AF7F2-EA34-4BD9-B1D3-6EFFDAE72F31","voiceDuration":11.514739229024944,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.061.jpeg","slideTitle":"第61スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"彼はそういうと、その話を始める。特殊な力で一瞬で建造物を破壊できる女性がいる一族経営の館の解体工事中の出来事だった。","duration":5.800000000000001,"title":"シーン 61","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_博麗霊夢.wav","audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢"},{"id":"4206FC2A-E8A4-479E-A4CB-156892A08260","voiceDuration":7.374580498866213,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.062.jpeg","slideTitle":"第62スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」","duration":4.800000000000001,"title":"シーン 62","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"8FE6DC02-AE57-40D4-B74B-1594ECF5137E","voiceDuration":6.796439909297052,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.063.jpeg","slideTitle":"第63スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」","duration":5.5,"title":"シーン 63","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"837BDDCE-C704-4982-94B2-77026FAD8D36","voiceDuration":7.026666666666666,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.064.jpeg","slideTitle":"第64スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」","duration":5.2,"title":"シーン 64","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"D06D42BD-E62A-4869-A0FC-D459C05EC48D","voiceDuration":7.868321995464853,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.065.jpeg","slideTitle":"第65スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「だが、そんなことよりも、今日もこうして、霊夢のところに帰って来れて、俺は幸せ者だぜ。」私はそう笑みを浮かべる。","duration":5.6000000000000005,"title":"シーン 65","characterName":"藤原妹紅","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"妹紅"},{"id":"8DC0179F-7100-4601-8230-719860A1781F","voiceDuration":9.241995464852607,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第3話_c997bea981\/元女子校の日常　第3話_c997bea981.066.jpeg","slideTitle":"第66スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうね…」私は、夫のその発言こう返すことしかできなかった。そして、なんだか距離を感じてしまったのだった。","duration":5.300000000000001,"title":"シーン 66","characterName":"博麗霊夢","animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav","audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","transitionName":"なし","voiceCharacter":"博麗霊夢"}]