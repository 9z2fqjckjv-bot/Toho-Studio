62854B4-2748-4544-B4BA-98A238F98181","telop":"「ええ。」私は、彼が私の裸を見るまでは…、ただ甘えたい時に甘えられていた…、だが今となっては、それは過去の話だった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.057.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第57スライド","characterName":"古明地こいし","voiceDuration":6.746485260770975,"duration":5.800000000000001},{"backgroundName":"単色背景","animationName":"なし","voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","bgmVolume":0.65,"voiceStartTimeOffset":0,"transitionName":"なし","title":"一方彼は…","showTelopOverlay":false,"id":"0049E964-DCC5-4AB1-8013-B9FBA4D7E1C0","telop":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.058.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"中扉","characterName":"","bgmStartTimeOffset":0,"duration":2.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","backgroundName":"nc283172_商店街（夜）.jpg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/nc283172_商店街（夜）.jpg","audioTrack":"track_voice_soumu","title":"シーン 59","transitionName":"なし","showTelopOverlay":false,"id":"C937E3EF-6B24-4EF1-A972-0C1B7C5C54CF","telop":"僕は、彼女が長電話をする中、なんとなく気まずくなり、\n部屋を出て、夜の国際通りを歩いていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.059.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第59スライド","characterName":"操夢","voiceDuration":7.416938775510204,"duration":4.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","backgroundName":"nc283172_商店街（夜）.jpg","animation