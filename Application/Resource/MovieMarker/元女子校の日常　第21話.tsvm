ry\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 62","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"940767F2-A8C8-4FDD-9BAF-53A3997AAF1E","telop":"すると、見事にその予感は当たり、頬照り、困った様子で、生ビールとおつまみらしきものを嗜む彼女の姿があった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.062.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第62スライド","characterName":"操夢","voiceDuration":3.976734693877551,"duration":5.300000000000001},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 63","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","showTelopOverlay":false,"id":"CE8998FF-D624-4461-BA54-9AC195559214","telop":"すると、彼女は僕の存在に気がついたのか、驚いた表情をする。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.063.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第63スライド","characterName":"操夢","voiceDuration":6.788684807256236,"duration":3.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 64","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"1BFC40E0-052E-4E87-8AB9-6A64C1C9D158","telop":"「どうしたの…、紅夢くん…、高校生が来る場所じゃないわよ、ここは…、何か困ったことでもあったの？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.064.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第64スライド","characterName":"操夢","voiceDuration":7.958253968253969,"duration":4.9},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 65","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"93FFF085-1D66-46E6-A254-5659B1F8CD39","telop":"「アリスさん、その生ビールは何杯目ですか？」僕は、ジョッキグラスの半分ほど残っている、生ビールを見て言う。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.065.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第65スライド","characterName":"操夢","voiceDuration":8.128458049886621,"duration":5.300000000000001},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 66","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"9114B080-20BE-43EF-8309-ECA454E97554","telop":"「そんなことは、どうだっていいのよ…、それより彼女たちはどうしたのよ…、ここにいないならホテルにいるのでしょ？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.066.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第66スライド","characterName":"操夢","voiceDuration":3.8712925170068027,"duration":5.6000000000000005},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 67","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"81E7ED6A-E424-41CA-B8CA-FBA69104AA24","telop":"彼女がそう言うと、カウンター越しに、お店の人が驚いた様子で僕を見る。僕は、慌てて首を横に振り、あることを聞く。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.067.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第67スライド","characterName":"操夢","voiceDuration":4.234331065759637,"duration":5.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 68","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"F4AD4623-8289-4783-A1DD-881D709F5437","telop":"「彼女が飲んでいるお酒は、今何杯目ですか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.068.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第68スライド","characterName":"操夢","voiceDuration":7.20281179138322,"duration":3.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 69","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"4E029746-324B-47DD-8114-EF721895D7D5","telop":"僕がそう聞くと、その人は、ひっそりと指を立てる。\nその指は3本だった。僕は、それで価格に見当がつく。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.069.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第69スライド","characterName":"操夢","voiceDuration":8.773469387755101,"duration":4.9},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 70","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"1922001E-D787-4FA4-B732-D2E90199A984","telop":"そして、部屋から背負ってきたバックから財布を取り出す。\n「代金は、3000円ですよね…？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.070.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第70スライド","characterName":"操夢","voiceDuration":8.24845804988662,"duration":4.4},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_操夢.wav","backgroundName":"image67.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","bgmVolume":0.65,"voiceStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/image67.jpeg","audioTrack":"track_voice_soumu","title":"シーン 71","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（困る）.png","showTelopOverlay":false,"id":"61C7EEA5-C657-4982-9EB6-66184EA55F2A","telop":"すると、その人は驚いた様子をするが、\nハッと気を取り直し、お金を受け取り、笑って見せた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第21話_5cc8f81983\/元女子校の日常　第21話_5cc8f81983.071.jpeg","seStartTimeOffset":0,"seVolume":1,"slideTitle":"第71スライド","characterName":"操夢","voiceDuration":8.121292517006802,"duration":4.3},{"voiceAudioPath