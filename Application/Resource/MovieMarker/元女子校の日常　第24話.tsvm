ub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"nc232269_バー.jpg"},{"animationName":"なし","seVolume":1,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.007.jpeg","showTelopOverlay":false,"characterName":"","transitionName":"なし","voice2StartTimeOffset":0,"title":"東方Project二次創作作品　Powerd By zuyasi","telop":"元女子校の日常","id":"C1799167-C783-4F9D-B3B4-906BE92E10D4","seStartTimeOffset":0,"slideTitle":"タイトル","bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","duration":2.5,"voiceStartTimeOffset":0,"backgroundName":"単色背景"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（怒り）.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.008.jpeg","voiceDuration":8.259342403628118,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 8","telop":"それから、僕は数時間ほど彼女の話を聞いていると、時刻は夜の9時ごろを指していた。「そろそろ、部屋に戻りますか？」","id":"639B5E71-6802-4648-8AED-56D100DDDBF9","seStartTimeOffset":0,"slideTitle":"第8スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"nc232269_バー.jpg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"アリス・マーガトロイド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.009.jpeg","voiceDuration":0.5,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","characterName":"アリス・マーガトロイド","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_アリス・マーガトロイド.wav","voice2StartTimeOffset":0,"title":"シーン 9","telop":"「確かに、そろそろ戻ったほうがいいわね…」","id":"A5095902-956A-4676-9C97-BFE1550A9199","seStartTimeOffset":0,"slideTitle":"第9スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"nc232269_バー.jpg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.010.jpeg","voiceDuration":7.045215419501134,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 10","telop":"僕は、彼女の意思を確認すると、席を立ち上がる。僕は、彼女が席を立つと、そっと手を繋ぐ。そして、部屋に向けて歩き出す。","id":"72C9BA82-C572-408C-8DB1-8F851A967CF2","seStartTimeOffset":0,"slideTitle":"第10スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"nc232269_バー.jpg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.011.jpeg","voiceDuration":6.585419501133787,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 11","telop":"僕たちが部屋に戻ったときには、まだこいしとさとりのすがたはなかった。そして、彼女は、そのまま入浴を始めた。","id":"6F77F591-D123-4B3C-B5F5-FDBDA919326E","seStartTimeOffset":0,"slideTitle":"第11スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.012.jpeg","voiceDuration":7.498458049886621,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 12","telop":"僕は、ふと暇になり、テレビをつける。すると、テレビでは地下底国グループが突如、発表したご令嬢の今後について流れていた。","id":"94D82121-061E-42B2-99E3-F979940202EF","seStartTimeOffset":0,"slideTitle":"第12スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.9,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.013.jpeg","voiceDuration":5.977823129251701,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 13","telop":"それも、ご令嬢は以前から、次期グループの長に適した婿養子を取ることが決まっていて、その候補の名前は不明となっていた。","id":"63FC7054-35BE-4E65-9B7F-19E7ED11D674","seStartTimeOffset":0,"slideTitle":"第13スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.014.jpeg","voiceDuration":7.174557823129252,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 14","telop":"だが、その発表では、目的人物が決まったとされ、そして、紅魔建設や学園で同タイミングでの発表から、憶測がされていた。","id":"2FAC5825-57F9-4E40-97D6-4BFA3CFBCA54","seStartTimeOffset":0,"slideTitle":"第14スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.015.jpeg","voiceDuration":8.040861678004536,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 15","telop":"だが、そのテレビの報道を見る限り、あくまで噂程度だった。\nそれでも、僕はなんとなく、自分の将来を不安に感じた。","id":"3C4B1151-A289-45F4-A75A-C3B8ABE954C4","seStartTimeOffset":0,"slideTitle":"第15スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.4,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.016.jpeg","voiceDuration":8.147369614512472,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 16","telop":"すると、報道の内容が、グールプの今までの流れとこいしやさとりが小さかった頃のことがピックアップされていく。","id":"428CF2F6-3B85-4F46-AB1F-760A16C5325F","seStartTimeOffset":0,"slideTitle":"第16スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.017.jpeg","voiceDuration":8.921292517006803,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 17","telop":"僕は、その報道を集中して見てたからか、アリスが肩を叩くまで、彼女が入浴を終えたことに気が付かなかった。","id":"29D5DAA2-27B2-464F-BBA7-C8ACC3CF929B","seStartTimeOffset":0,"slideTitle":"第17スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image76.jpeg","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"image76.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/早苗（微笑）.png","seVolume":1,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.018.jpeg","showTelopOverlay":false,"characterName":"古明地さとり","transitionName":"なし","voice2StartTimeOffset":0,"title":"主人公がいるクラスの担任","telop":"主人公の彼が通っている学園の教員であり、彼のクラスの担任。彼が初めて学園に登校した際には、威勢のいい挨拶をしない彼を指摘し、彼を近くに呼び寄せると、挨拶とお辞儀をする練習をさせる。そして、これまでの人生を10分で語るという難題で彼を気絶させた。","id":"8E17A922-6BB8-4A24-A11E-3592013F2C50","seStartTimeOffset":0,"slideTitle":"タイトル","bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","duration":5,"voiceStartTimeOffset":0,"backgroundName":"単色背景"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/頬照り笑い.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.019.jpeg","voiceDuration":4.677823129251701,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 19","telop":"僕が入浴を終えると、僕とアリスは、寝るための布団を敷き談笑をしていた。すると、いきなり部屋の扉が開く。","id":"17DF640C-E9A3-4F37-BE58-A5691F48AE0E","seStartTimeOffset":0,"slideTitle":"第19スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.020.jpeg","voiceDuration":5.243038548752835,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 20","telop":"そして入ってきたのは、暗い影と涙があるこいしだった。\n彼女は入ってくるや否や、ドアを急いで閉めて、鍵をかける。","id":"30FD0A8C-8027-4762-8D0F-CC0DCFC23667","seStartTimeOffset":0,"slideTitle":"第20スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.4,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.021.jpeg","voiceDuration":7.845215419501134,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 21","telop":"すると、廊下の方からドンドンとドアを叩く音がする。\nそして、こいしは僕に抱きつき、泣きながら言葉を出す。","id":"E6AF0F80-E4AE-4C4D-B7D5-D8AF7DAB0363","seStartTimeOffset":0,"slideTitle":"第21スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.022.jpeg","voiceDuration":8.001995464852607,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_ナレーション.wav","voice2StartTimeOffset":0,"title":"シーン 22","telop":"「お兄ちゃん…、助けて…、お姉ちゃんが…、お姉ちゃんが…。」","id":"9E7BA7A3-3D47-4EDA-AA5A-FF3B843A8C0E","seStartTimeOffset":0,"slideTitle":"第22スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.023.jpeg","voiceDuration":7.593038548752834,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 23","telop":"彼女が小さくそう呟きがなら、ひたすら泣き、僕は事態を把握する。廊下の人物は、扉を叩く代わりにをこじ開けようとする。","id":"55BB5154-4C65-4517-9822-79A4CAFE06E3","seStartTimeOffset":0,"slideTitle":"第23スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.024.jpeg","voiceDuration":9.23,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 24","telop":"僕は、ここはこいしの頭をそっと撫でて、少しだけ落ち着かせると、部屋の電話を取り、ロビーに電話をかける。","id":"1689EDCD-7FC0-4535-B9FD-F1AA6E546305","seStartTimeOffset":0,"slideTitle":"第24スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.025.jpeg","voiceDuration":8.509342403628118,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 25","telop":"それから、さらに時間が経ち、こいしがそのまま泣き疲れて、僕の腕の中で眠り出した頃には、廊下は静かになっていた。","id":"AA20B18B-12E5-4FD6-8C40-3E99710B366B","seStartTimeOffset":0,"slideTitle":"第25スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.026.jpeg","voiceDuration":3.0104308390022676,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 26","telop":"僕は、こいしをベッドで寝かせ、アリスもいつの間にか就寝していることを知ると、部屋の電話である場所に電話をかける。","id":"3A7ECE92-12D0-4162-B356-FC470C80B131","seStartTimeOffset":0,"slideTitle":"第26スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.027.jpeg","voiceDuration":7.706734693877551,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","characterName":"レミリア・スカーレット","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"title":"シーン 27","telop":"「もしもし、どちら様ですか？」","id":"8E781729-CFD4-40E9-AF39-F408EE41DA01","seStartTimeOffset":0,"slideTitle":"第27スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.028.jpeg","voiceDuration":8.643038548752834,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 28","telop":"「レミリアさん…、僕からのお願いを聞いてくれませんか…。」\n僕はそう言い始め、今までの出来事をそのまま伝えていった。","id":"08381479-BE25-48FF-BA8D-F439685705F4","seStartTimeOffset":0,"slideTitle":"第28スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image77.jpeg","duration":5.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image77.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/目閉じ困る.png","seVolume":1,"bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.029.jpeg","showTelopOverlay":false,"characterName":"古明地こいし","transitionName":"なし","voice2StartTimeOffset":0,"title":"学園の体育科担当教員","telop":"主人公の彼が通っている学園の体育科を担当する教員。性格は、比較的穏やかで優しいが、学校の教育方針の関係から厳しいことをいうこともある。初登場は、第2話で突如教室にいる彼を校庭に連れ出し、1500m走を彼に走らせた。ちなみに第4話のエンドレスランでは、後ろから彼とこいしを監視する形で、共に走っていた。","id":"E1B48194-36DF-4ABE-A208-80533A46C55D","seStartTimeOffset":0,"slideTitle":"タイトル","bgmVolume":0.65,"bgmName":"BGM: 東方妖恋談","duration":5,"voiceStartTimeOffset":0,"backgroundName":"単色背景"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.030.jpeg","voiceDuration":4.006077097505669,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 30","telop":"「んっ…」僕は、あれからふと気がつくと、窓から朝日が差し込んでいた。レミリアとの電話の後、僕はそのまま眠った。","id":"821C2F40-CD95-4F31-918D-04D589941DD2","seStartTimeOffset":0,"slideTitle":"第30スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/寝起き顔.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.031.jpeg","voiceDuration":8.30607709750567,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 31","telop":"そして周りを見ると、こいしとアリスも目が覚めたみたいだった。そして、さとりは部屋にはいなかった。","id":"69892C9C-1E34-4651-BD09-198817D158AE","seStartTimeOffset":0,"slideTitle":"第31スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.032.jpeg","voiceDuration":3.3739455782312926,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_隠岐奈.wav","voice2StartTimeOffset":0,"title":"シーン 32","telop":"「お姉ちゃんはどこにいるの…」","id":"09116871-9164-4C8B-B2DA-C160BCF7A077","seStartTimeOffset":0,"slideTitle":"第32スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第23話\/生成された画像.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.033.jpeg","voiceDuration":3.156077097505669,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 33","telop":"僕は、そう聞いてくる彼女に、昨夜のナイトプールで一体何があったのかを、優しく尋ねると、彼女は泣きながら、説明をした。","id":"812A67CA-B4A6-48CE-BA6F-A3971CC83382","seStartTimeOffset":0,"slideTitle":"第33スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/パチュリー真顔小口開け.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"パチュリー・ノーレッジ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.034.jpeg","voiceDuration":5.1820634920634925,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","characterName":"パチュリー・ノーレッジ","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_パチュリー・ノーレッジ.wav","voice2StartTimeOffset":0,"title":"シーン 34","telop":"学園の科学担当教員兼博士\n主人公の彼が通っている学園の科学を担当する傍ら、魔法や化学などを研究している教員兼博士。かつては、紅美鈴、十六夜咲夜、パチュリー・ノーレッジの3人は、レミリアたちの家で生活し、共に紅魔建設を営んでいた。だが、3人は学校教員になり、美鈴は体育、咲夜は家庭、パチュリーは科学を担当している。ちなみに、彼女が博士を務める研究室には、アリスも属している。\nパチュリー・ノーレッジ","id":"1D9B893A-77CC-41B1-97ED-CD04062A8929","seStartTimeOffset":0,"slideTitle":"第34スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.035.jpeg","voiceDuration":10.813242630385487,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_古明地こいし.wav","voice2StartTimeOffset":0,"title":"シーン 35","telop":"「それで、これから、どうするの…？\nお姉ちゃんは、あの人たちに捕まっているけど…。」","id":"9E5FD2A2-D5E4-43C9-9730-72B6F8C58694","seStartTimeOffset":0,"slideTitle":"第35スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.036.jpeg","voiceDuration":7.527823129251701,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 36","telop":"こいしは、着替えた後にそう僕に聞いてくる。「とりあえず、ホテル内の安全確保はできたので、朝食を取りませんか？」","id":"3DD84DE1-AF92-4364-A387-DE945224C337","seStartTimeOffset":0,"slideTitle":"第36スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.037.jpeg","voiceDuration":1.7082766439909296,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_古明地こいし.wav","voice2StartTimeOffset":0,"title":"シーン 37","telop":"「そう…」","id":"53FF58D8-828D-45BC-942C-9E24B9A40FA5","seStartTimeOffset":0,"slideTitle":"第37スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.038.jpeg","voiceDuration":3.434331065759637,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 38","telop":"「こいしさんのいう、邪道派が昨日、襲ってきた彼らなら、きっとまたやってくるはずです。いずれは、戦いましょう。」","id":"EDBE87CA-2267-427B-8CAF-D99B3490C7EA","seStartTimeOffset":0,"slideTitle":"第38スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.039.jpeg","voiceDuration":2.3541269841269843,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_古明地こいし.wav","voice2StartTimeOffset":0,"title":"シーン 39","telop":"「わかった…」","id":"11E3E8B8-2ECB-4160-8487-BAC3742F6FF2","seStartTimeOffset":0,"slideTitle":"第39スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.040.jpeg","voiceDuration":8.10281179138322,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 40","telop":"僕たちがそう話していると、部屋の電話が鳴る。受話器を取ると、ロビーの人から通話相手を知り、繋げてもらう。","id":"D21873C4-303E-46D6-B86A-D457E61D4CA3","seStartTimeOffset":0,"slideTitle":"第40スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.2,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.041.jpeg","voiceDuration":1.93,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 41","telop":"「もしもし…、フランさん？」","id":"238D0F31-CD2D-41F3-8027-E149D60D2E33","seStartTimeOffset":0,"slideTitle":"第41スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.042.jpeg","voiceDuration":9.720748299319729,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","characterName":"フランドール・スカーレット","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"title":"シーン 42","telop":"「紅夢、昨日、お姉様に伝えてくれたお願いに、応えることにしたの、それで私が、今飛行機に乗るから、ホテルで待ってて。」","id":"40C3618E-C0B1-42CB-A330-CF1643F428B1","seStartTimeOffset":0,"slideTitle":"第42スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.043.jpeg","voiceDuration":8.934331065759638,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 43","telop":"「わかりました。今日の間は、ホテルから出ないように、言っておきますね。」僕は、それと部屋番号を言うと、電話を切った。","id":"FC26BEBC-11BA-4C58-9C73-0BC61BF37175","seStartTimeOffset":0,"slideTitle":"第43スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.044.jpeg","voiceDuration":7.213673469387755,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 44","telop":"「今、フランさんから連絡があって、あと数分で出発する飛行機に乗ったようなので、昼過ぎには、こっちに着くそうです。」","id":"61D3C414-354E-4EC7-8F0C-EAD1EF5D8368","seStartTimeOffset":0,"slideTitle":"第44スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.045.jpeg","voiceDuration":10.075668934240364,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_古明地こいし.wav","voice2StartTimeOffset":0,"title":"シーン 45","telop":"「そう…、ありがとう…」","id":"622C89E7-CFCE-4602-8930-396FCCA21606","seStartTimeOffset":0,"slideTitle":"第45スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.046.jpeg","voiceDuration":5.562607709750567,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 46","telop":"「とりあえず、朝食をホテルのレストランで取ったら、フランさんが着くまでの間は、部屋の中で待ってるのが安全ですよ。」","id":"C92C5D46-96C3-44EB-8A9D-8B2C597D97BB","seStartTimeOffset":0,"slideTitle":"第46スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"古明地こいし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.047.jpeg","voiceDuration":3.474512471655329,"showTelopOverlay":false,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_古明地こいし.wav","voice2StartTimeOffset":0,"title":"シーン 47","telop":"「わかった…」","id":"46EE0158-52B5-4AB0-9625-FF410C8FC583","seStartTimeOffset":0,"slideTitle":"第47スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.5,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.048.jpeg","voiceDuration":2.53,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 48","telop":"それから僕たちは、朝食を済ませたあと、\nフランがホテルに着くまでの間、部屋の中で過ごすのだった。","id":"9A2B9DB0-040E-4054-900E-7CD39283DEC0","seStartTimeOffset":0,"slideTitle":"第48スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":4.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"パチュリー・ノーレッジ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.049.jpeg","voiceDuration":5.909478458049887,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","characterName":"パチュリー・ノーレッジ","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"title":"シーン 49","telop":"学園の家庭科担当教員\n主人公の彼が通っている学園の家庭科を担当する教員。かつてはパチュリーなどと同じく、レミリアの家に住み、紅魔建設を営む傍ら、メイドをしていた。いまでも、当時の名残で、メイド服のまま勤務している。そして、遠足まで1週間を切ったある日、さとりたちがテストを受ける中、彼女は彼から、過去についてを聞き出した。\n十六夜咲夜","id":"17747D78-5837-4EA7-9C4A-1CCC6FDC5066","seStartTimeOffset":0,"slideTitle":"第49スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/咲夜頬照り困った笑み.png","duration":5,"bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜頬照り困った笑み.png"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.050.jpeg","voiceDuration":7.561519274376417,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 50","telop":"僕たちが、いろいろと話していると、部屋のチャイムが鳴る。","id":"565A2925-F7BC-48A9-A1C1-91A70DC92204","seStartTimeOffset":0,"slideTitle":"第50スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.