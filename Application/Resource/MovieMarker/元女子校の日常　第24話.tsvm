eStartTimeOffset":0,"slideTitle":"第52スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":5.7,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.053.jpeg","voiceDuration":5.859478458049886,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","characterName":"フランドール・スカーレット","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"title":"シーン 53","telop":"「そう…、とりあえず、これからどうするの？\n旅行を続けるわけじゃないんでしょ？」","id":"CFC0E659-CC7D-45B2-8FC3-282460A660C4","seStartTimeOffset":0,"slideTitle":"第53スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.054.jpeg","voiceDuration":2.4473696145124717,"showTelopOverlay":false,"audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","voice2StartTimeOffset":0,"title":"シーン 54","telop":"「まだ…今後のことは決めてないです。\n何よりこいしさんは、連絡手段がないので…。」","id":"BF46D0C2-6BD2-4E35-BFA5-8984715F68B3","seStartTimeOffset":0,"slideTitle":"第54スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":4,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\/元女子校の日常　第24話_491cf8c59c.055.jpeg","voiceDuration":4.446984126984127,"showTelopOverlay":false,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","characterName":"フランドール・スカーレット","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"title":"シーン 55","telop":"「そう…。」私がそう言っていると、私のポケベルがなる。\n「ちょっと、電話してくるから、待ってて。」","id":"AAC842D5-9672-4866-8618-961016F4ABF8","seStartTimeOffset":0,"slideTitle":"第55スライド","bgmVolume":0.65,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/image78.jpeg","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","backgroundName":"image78.jpeg"},{"animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/影あり困り.png","seVolume":1,"voiceStartTimeOffset":0,"bgmStartTimeOffset":0,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第24話_491cf8c59c\