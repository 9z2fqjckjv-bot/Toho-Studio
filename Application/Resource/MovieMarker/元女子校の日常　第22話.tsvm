[{"telop":"僕は、アリスを入浴させると、彼女が一人で出られるといい、僕は、一人ベッドに座り、ぼんやりとしていた。\n東方Project二次創作作品","title":"シーン 1","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.35390022675737,"voice2StartTimeOffset":0,"id":"8DF50C63-7B5A-4AB8-B6E1-B2586E2FA20D","seVolume":1,"duration":7.35390022675737,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #1","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.001.jpeg"},{"telop":"ふと時計を見ると、夜の9時だった。そして、僕は背伸びをする。\n作成者：zuyasi","title":"シーン 2","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":4.581065759637188,"voice2StartTimeOffset":0,"id":"133E6081-09BE-49B3-A19C-5BF930005F4F","seVolume":1,"duration":4.581065759637188,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #2","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.002.jpeg"},{"telop":"僕が、ぼんやりと過ごしていると、浴室から大きな物音がする。僕は、なんだか嫌な予感がし、扉越しに様子を尋ねる。","title":"シーン 3: 僕が、ぼんやりと過ごしていると、浴室から大きな物音がする。\n僕は、なんだか嫌な予感がし、扉越しに様子を尋ねる。","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.710430839002267,"voice2StartTimeOffset":0,"id":"36F71117-B291-4DE6-8136-94980EAFD1F5","seVolume":1,"duration":8.710430839002267,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #3","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.003.jpeg"},{"telop":"だが、返事は返ってこず、僕は一度外したアイマスクをつけ、\n扉を開けて中に、入ると、そこには気絶した彼女がいた。\n制作ソフト及び協力\nGemini\nTohoStuido","title":"シーン 4","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.464761904761906,"voice2StartTimeOffset":0,"id":"3B04E86F-5C90-4CA6-A5D2-0FFE870DA745","seVolume":1,"duration":8.464761904761906,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #4","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.004.jpeg"},{"telop":"僕は、強めに彼女の頬を叩くと、彼女は意識を取り戻し、\nなんとかことなきを得るのだった。","title":"シーン 5","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":6.291950113378685,"voice2StartTimeOffset":0,"id":"61F2157E-2683-48FB-93AF-B0D8112A3FA1","seVolume":1,"duration":6.291950113378685,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #5","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.005.jpeg"},{"telop":"元女子校の日常","title":"シーン 6: 東方Project二次創作作品　Powerd By zuyasi","bgmVolume":0.7,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"seVolume":1,"id":"C499CA65-062D-4B4B-9A5A-D29073CD3704","duration":2.5,"characterName":"操夢","bgmStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #6","backgroundName":"単色背景","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.006.jpeg"},{"telop":"「あの…、ごめんなさい…私ったら…」","title":"シーン 7","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":2.0115192743764174,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","id":"2CCD627A-A958-4442-BECE-48019A1B6F45","voice2StartTimeOffset":0,"duration":2.0115192743764174,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #7","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"アリス・マーガトロイド","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.007.jpeg"},{"telop":"「別にいいですよ…、酔った両親の相手を、少し前までは普通にしてたので…、僕は慣れてますから…」","title":"シーン 8","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":6.362607709750567,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","id":"EE7C441E-C0A4-485C-986E-B60B204F04A6","voice2StartTimeOffset":0,"duration":6.362607709750567,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #8","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.008.jpeg"},{"telop":"「そう…」","title":"シーン 9","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":0.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","id":"1AF61862-BFDE-4F02-B5A3-1BCF54749383","voice2StartTimeOffset":0,"duration":0.5,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #9","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"アリス・マーガトロイド","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.009.jpeg"},{"telop":"「とりあえず、僕がこれから、入浴しますね。」\n僕はそう言うと、着替えを持って、浴室に入った。","title":"シーン 10","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.045215419501134,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","id":"BB090613-7170-4E7D-A3AC-B7750B19EDB8","voice2StartTimeOffset":0,"duration":7.045215419501134,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #10","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.010.jpeg"},{"telop":"主人公\nこのシリーズの主人公。\n素直で正直もの。頭がいい。\nだが、それを疑うこともある。\n彼が、幼児の時に、告白した当時の先生であるフランの家に居候中。\n彼は、特殊な体つきをしている。\n藤原紅夢","animationDuration":5,"title":"シーン 11","bgmVolume":0.15563146233382572,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/困った笑み.png","id":"920906DD-9E91-4348-830F-70238A2563DE","seVolume":1,"duration":5,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/video.mp4","animationNote":"5秒","slideTitle":"スライド #11","backgroundName":"image65.jpeg","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","bgmName":"BGM: video","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.011.jpeg"},{"telop":"僕が、浴室から戻ってくると、アリスはすでに眠ってしまっているようだった。僕も、ふと大きなあくびが出る。","title":"シーン 12","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.498458049886621,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/頬照り寝顔.pxd","id":"F3CE6F09-86D5-4982-AD53-6DBF951D2E87","voice2StartTimeOffset":0,"duration":7.498458049886621,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #12","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.012.jpeg"},{"telop":"僕はそれから、電気を消し、カーテンを閉めて、\nベッド横の照明を切ると、そのまま眠りにつくのだった。","title":"シーン 13","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":6.961519274376418,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/頬照り寝顔.pxd","id":"88A4B304-1926-4192-8778-CA68E88D72B0","voice2StartTimeOffset":0,"duration":6.961519274376418,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #13","backgroundName":"image65.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.013.jpeg"},{"telop":"大学院生\nパチュリーが普段いる学園のある研究室で何かの研究をしている。\n紅夢の先輩にあたる。\n彼女のそばには、小さな人形がいる。\n前回のラストシーンではアイマスクを彼に被され、彼もアイマスクを被り、共に浴室に入った。\nアリス・マーガトロイド","animationDuration":5,"title":"シーン 14","bgmVolume":0.2550129246676514,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/頬照り寝顔.png","id":"D3B030C2-91DE-4EA0-8954-DCE4819EFEE1","seVolume":1,"duration":5,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc210382_人形裁判[東方アレンジ][キラキラBGM][幻想].mp3","animationNote":"5秒","slideTitle":"スライド #14","backgroundName":"image65.jpeg","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image65.jpeg","bgmName":"BGM: nc210382_人形裁判[東方アレンジ][キラキラBGM][幻想]","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.014.jpeg"},{"telop":"僕は、ふと目が覚めると、大きく背伸びをし、隣を見る。\nそして、彼女が寝ているのを発見すると、そっと起こす。","title":"シーン 15","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.040861678004536,"voice2StartTimeOffset":0,"id":"45CD75DF-BA0D-464B-A6CF-4667784005AA","seVolume":1,"duration":8.040861678004536,"characterName":"操夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #15","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.015.jpeg"},{"telop":"「んっ…、もう朝なの…。」","title":"シーン 16","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":1.2349886621315194,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/寝起き顔.png","id":"D6ADF216-A6FB-4919-8CDE-A4AD3ECFB58E","voice2StartTimeOffset":0,"duration":1.2349886621315194,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #16","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"アリス・マーガトロイド","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.016.jpeg"},{"telop":"「ええ、そうですよ。今日は、北上する日なので、ささっと準備を済ませたら、出発しますよ。途中で朝食も取るので。」","title":"シーン 17","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.921292517006803,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/寝起き顔.png","id":"13845028-AC32-4800-8453-8C92FFA2BC68","voice2StartTimeOffset":0,"duration":8.921292517006803,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #17","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.017.jpeg"},{"telop":"「北上するって、どこに向かうの？」","title":"シーン 18","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":1.910861678004535,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","id":"37F133E5-D633-4113-8F79-FD16DF591725","voice2StartTimeOffset":0,"duration":1.910861678004535,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #18","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"アリス・マーガトロイド","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.018.jpeg"},{"telop":"「恩納村です。高速は使わないので、お金は必要ないですよ。」","title":"シーン 19","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":4.677823129251701,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","id":"AAF8DA09-8B06-45D0-BF62-41E9BADA9BA7","voice2StartTimeOffset":0,"duration":4.677823129251701,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #19","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.019.jpeg"},{"telop":"「そう…」","title":"シーン 20","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_アリス・マーガトロイド.wav","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","voiceDuration":0.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","id":"156C640E-73CD-4516-9F5C-81BFF830DD76","voice2StartTimeOffset":0,"duration":0.5,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #20","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"アリス・マーガトロイド","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.020.jpeg"},{"telop":"僕たちは、そんな話をしていると、玄関のチャイムが鳴る。\nすると、扉が開き、さとりとこいしが入ってきた。","title":"シーン 21","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.845215419501134,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困り）.png","id":"A496466A-B568-43A6-A5C1-0EE924EE70B0","voice2StartTimeOffset":0,"duration":7.845215419501134,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":0.85,"voiceStartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/効果音\/ドアチャイム1.mp3","seStartTimeOffset":2.55,"slideTitle":"スライド #21","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","seName":"SE: ドアチャイム1","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.021.jpeg"},{"telop":"すると、彼女はある書面を机上に置き、ペンを僕に渡し、サインをするように言ってくる。僕は、その書面の内容を読む。","title":"シーン 22","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.216938775510204,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"B5D6CB8B-86BA-4637-9988-9F3C98DEB3F1","voice2StartTimeOffset":0,"duration":8.216938775510204,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #22","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.022.jpeg"},{"telop":"「それで、あなたはこの内容に同意してくれるの？」","title":"シーン 23","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":3.937551020408163,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"B65BE20A-DC37-407A-8B35-01D61718799D","voice2StartTimeOffset":0,"duration":3.937551020408163,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #23","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.023.jpeg"},{"telop":"僕は、その書面に記された文章を見る。書面の下には、彼女のサインと何かの印章が貼られていた。すると、彼女が急かす。","title":"シーン 24","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":9.216938775510204,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"34288AB2-29DE-4A3C-95A1-3B2A70A8C0C4","voice2StartTimeOffset":0,"duration":9.216938775510204,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #24","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.024.jpeg"},{"telop":"「まだ？」","title":"シーン 25","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":0.7386621315192744,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"6F72640E-CA38-4B98-BB48-214946459F54","voice2StartTimeOffset":0,"duration":0.7386621315192744,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #25","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.025.jpeg"},{"telop":"「この内容…、フランさんたちは知ってるんですか？」","title":"シーン 26","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":3.0104308390022676,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"7CD88AF9-594B-4B23-ABEF-E1A2EDD8EBED","voice2StartTimeOffset":0,"duration":3.0104308390022676,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #26","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.026.jpeg"},{"telop":"「ええ、彼女たちに宣戦布告したのよ。昨日も言ったけど、もう以前の関係には戻れない、これは…」","title":"シーン 27","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":8.954126984126985,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"F98CDC06-1592-4E65-BEFC-3264F9B83D2F","voice2StartTimeOffset":0,"duration":8.954126984126985,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #27","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.027.jpeg"},{"telop":"そこまで言うと、彼女は頬を赤らめ、数秒の間の後、言う。","title":"シーン 28","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":4.10172335600907,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"9DF8D405-BA9A-40C0-980B-FA851AE29E64","voice2StartTimeOffset":0,"duration":4.10172335600907,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #28","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.028.jpeg"},{"telop":"「これは…、あなたの結婚相手…いや、後継をめぐる紅魔建設と私たち…、地下底国グループが戦うための文書なのよ。」","title":"シーン 29","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":10.520430839002268,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"92183636-287A-4E39-8C08-1895DA2D7DE7","voice2StartTimeOffset":0,"duration":10.520430839002268,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #29","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.029.jpeg"},{"telop":"「それに、学校側だって、あなたが欲しいから、きっとこの戦いに参戦してくるわ。あなたは、その戦いの主軸なのよ。」","title":"シーン 30","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":10.994195011337869,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"BC939AA0-D1E2-4AC4-AD65-7E7CE0CA2381","voice2StartTimeOffset":0,"duration":10.994195011337869,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #30","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.030.jpeg"},{"telop":"「…」僕は、次々と述べられる彼女の言葉の意味をうまく受け取れずに、ただ困惑してしまう。そして、さとりに視線を向ける。","title":"シーン 31","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.30607709750567,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"A416A4DC-99D4-47CC-8958-5C51FB41C865","voice2StartTimeOffset":0,"duration":8.30607709750567,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #31","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.031.jpeg"},{"telop":"「これは…、一体どう言うことですか…、さとりさん…？」","title":"シーン 32","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":3.156077097505669,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"6340E670-37E9-48CF-B27B-5D7F2C84D76C","voice2StartTimeOffset":0,"duration":3.156077097505669,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #32","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.032.jpeg"},{"telop":"「あなたが、昨日、妹の裸を見たことで、私たちの中での決まりが、あなたにも適用されたんですよ、強制ではないですが…」","title":"シーン 33","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_古明地さとり.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":7.068185941043084,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"AC44B817-B0CF-400B-9423-FCBE7ECB9B15","voice2StartTimeOffset":0,"duration":7.068185941043084,"characterName":"古明地さとり","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #33","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地さとり","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.033.jpeg"},{"telop":"「あと、あなたの母親のところも、後継者の関係で、あなたを引き戻したいそうよ。だから、四つ巴の戦いなのよ…。」","title":"シーン 34","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":10.813242630385487,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"FEA669C0-E7FC-436E-AECA-6503B96B2805","voice2StartTimeOffset":0,"duration":10.813242630385487,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #34","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.034.jpeg"},{"telop":"「簡単に言えば、私たちとあなたどう言う関係なのかを明白にし、戦いの混乱を避けるための同意が必要なんですよ…。」","title":"シーン 35","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_古明地さとり.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","voiceDuration":6.182789115646258,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"4658C8FD-3010-4896-A7EC-29C092307AF2","voice2StartTimeOffset":0,"duration":6.182789115646258,"characterName":"古明地さとり","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #35","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地さとり","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.035.jpeg"},{"telop":"僕は、さとりの補足説明で、彼女たちが言いたいことを大まかに把握する。「別に構いませんけど…、一つだけいいですか？」","title":"シーン 36","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.25172335600907,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"2BA2DF38-C228-4E8F-966A-1F529AC1A7EC","voice2StartTimeOffset":0,"duration":8.25172335600907,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #36","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.036.jpeg"},{"telop":"「どんな条件なの？」","title":"シーン 37","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_古明地こいし.wav","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceDuration":1.7082766439909296,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"88EF7D30-91FE-4B9E-BAD0-12BD8D3E0806","voice2StartTimeOffset":0,"duration":1.7082766439909296,"characterName":"古明地こいし","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #37","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"古明地こいし","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.037.jpeg"},{"telop":"「向こうに帰るまでは、これまで通りで過ごしませんか？」","title":"シーン 38","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":3.434331065759637,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","id":"662B988E-1A1C-4E6E-853C-CDF6979028AF","voice2StartTimeOffset":0,"duration":3.434331065759637,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #38","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.038.jpeg"},{"telop":"僕がそう言うと、二人は驚く。そして、二人の賛同を得た後、書面にサインを記して、恩納村へと向かうのだった。","title":"シーン 39","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.10281179138322,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","id":"3A29188E-1EA2-4778-BFCC-B1C22CE4DDD4","voice2StartTimeOffset":0,"duration":8.10281179138322,"characterName":"操夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #39","backgroundName":"image68.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","voiceCharacter":"操夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.039.jpeg"},{"telop":"中学生\n彼とエンドレスランをしたときに、こけかけ彼に抱っこしてもらって以降、彼には今まで味わったことのない気持ちを感じている。だが、前回、裸の姿を彼に見られてしまい、彼女は彼に甘えることをやめ、態度が豹変した。ちなみに、彼のクラスメイトの古明地さとりの妹でもある。\n古明地こいし","animationDuration":5,"title":"シーン 40","bgmVolume":0.25090472673559827,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/頬照り説教.png","id":"559B147F-C445-4AC5-AF8B-4D5EEDDB68B9","seVolume":1,"duration":5,"characterName":"古明地さとり","bgmStartTimeOffset":0,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc364900_【東方自作アレンジ】Mad【ハルトマンの妖怪少女】.mp3","animationNote":"5秒","slideTitle":"スライド #40","backgroundName":"image68.jpeg","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/image68.jpeg","bgmName":"BGM: nc364900_【東方自作アレンジ】Mad【ハルトマンの妖怪少女】","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.040.jpeg"},{"telop":"私とお姉様は、昨日、こいしからの長電話を受けた後、夜通し、今後の事を話し合って行った。「それで、どうするの…？」","title":"シーン 41","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":9.720748299319729,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/レミリア（怒る）.png","id":"8E08524A-4DBD-422B-982A-63A006F5A59A","voice2StartTimeOffset":0,"duration":9.720748299319729,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #41","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"フランドール・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.041.jpeg"},{"telop":"「なんで彼は、あんな巨大組織の令嬢の裸を見たのかしら…。\nたとえ、アクシデントでもあんなことを言うなんて…。」","title":"シーン 42","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":6.9254875283446715,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/レミリア（怒る）.png","id":"421AB26A-06AA-4EE3-BA10-B3E43C574937","voice2StartTimeOffset":0,"duration":6.9254875283446715,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #42","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.042.jpeg"},{"telop":"「とにかく、彼が旅行から戻ってきたら、厳しく言いつけて、戦いに勝って、私たちの方に、なんとしてでも引き込むわよ。」","title":"シーン 43","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":8.204081632653061,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/レミリア（怒る）.png","id":"2E5F8BB0-C67B-4280-9835-76E82B480D3A","voice2StartTimeOffset":0,"duration":8.204081632653061,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #43","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.043.jpeg"},{"telop":"「私だって、彼がいなくなるのは嫌だし、お姉様に協力する。」","title":"シーン 44","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":5.200748299319728,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/レミリア（怒る）.png","id":"1ACA4EC5-5D6D-40FC-8593-AAA91E5F2482","voice2StartTimeOffset":0,"duration":5.200748299319728,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #44","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"フランドール・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.044.jpeg"},{"telop":"「いいこと思いついたわ、フラン。何かしらの口実をつけて、学校と彼の母親を裏切る前提で味方につけなさい。」","title":"シーン 45","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":7.6046485260770975,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","id":"7960851A-9619-459E-A5E5-D14F69E439E9","voice2StartTimeOffset":0,"duration":7.6046485260770975,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #45","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.045.jpeg"},{"telop":"「えっ…、そんなことして大丈夫なの？」","title":"シーン 46","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":2.8219954648526078,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","id":"A6517E60-29AA-49A7-A1F8-12EAB5C69192","voice2StartTimeOffset":0,"duration":2.8219954648526078,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #46","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"フランドール・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.046.jpeg"},{"telop":"「いいのよ別に、これは女同士の泥沼試合なのだから。」","title":"シーン 47","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":3.5963265306122447,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","id":"6A9A9315-4C8C-48A5-8607-FBEDA751A13F","voice2StartTimeOffset":0,"duration":3.5963265306122447,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #47","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"レミリア・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.047.jpeg"},{"telop":"「そう…わかった。」\n私はそれから、お姉様の言うとおりに動くのだった。","title":"シーン 48","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":5.909478458049887,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","id":"9E534332-1E79-4AFD-87D9-BC9C401889B6","voice2StartTimeOffset":0,"duration":5.909478458049887,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #48","backgroundName":"nc107556_紅魔的館内.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/nc107556_紅魔的館内.jpg","voiceCharacter":"フランドール・スカーレット","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.048.jpeg"},{"telop":"紅魔建設の破壊作業員\n紅夢が幼児の時に、仕事疲れから担任をした、大人の女性。そして、姉のレミリアと共に紅魔建設を営んでいる。紅魔建設では、解体特化型で「キュッとしてドカーン」の一言で建物を一撃で破壊している。過去に彼から告白され、互いの意思を知った彼女は、彼を…。また、魔理沙が起こした騒ぎの最中に彼にナンパをしている。\nフランドール・スカーレット","animationDuration":5,"title":"シーン 49","bgmVolume":0.25069700886262924,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"seVolume":1,"id":"A6FCAB8E-9117-4C22-9C1A-68E9B4EBE274","duration":5,"characterName":"霧雨魔理沙","bgmStartTimeOffset":0,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc321386_[東方アレンジ]_495年のジャズフェスティバル_U.N.オーエンは彼女なのか？.mp3","animationNote":"5秒","slideTitle":"スライド #49","backgroundName":"夜のお誘い.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/夜のお誘い.png","bgmName":"BGM: nc321386_[東方アレンジ]_495年のジャズフェスティバル_U.N.オーエンは彼女なのか？","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.049.jpeg"},{"telop":"私は、ふとため息を学園長室でついていた。「はぁ…」\n理由は明白で、昨晩にあった、ある電話である。","title":"シーン 50","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":7.505510204081633,"voice2StartTimeOffset":0,"id":"96AFC61E-71D0-4864-A62D-EDDE24CBBFFF","seVolume":1,"duration":7.505510204081633,"characterName":"隠岐奈","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #50","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.050.jpeg"},{"telop":"私が、昨日、残業で職務をこなしていると、一本の電話が入る。\nそれを知らせにきた、萃香はいかにも面倒そうな顔をしていた。","title":"シーン 51","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":9.184263038548753,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（弱る）.png","id":"E3B0B3C7-A6BF-4AC8-8647-6B446FF3DB17","voice2StartTimeOffset":0,"duration":9.184263038548753,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #51","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.051.jpeg"},{"telop":"私は、彼女の言葉を受けると、内線を繋ぎ、相手の声を聞く。\nその声は、中等部の女子生徒、古明地こいしの声だった。","title":"シーン 52","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":9.20968253968254,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（弱る）.png","id":"9D42560C-650F-4435-8DA8-8A5983AE57C6","voice2StartTimeOffset":0,"duration":9.20968253968254,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #52","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.052.jpeg"},{"telop":"私は、電話越しに彼女が起こっていることを感じ、なぜ起こっているのかと聞く。すると例の彼が、彼女の裸を見たと言う。","title":"シーン 53","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.503832199546485,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（弱る）.png","id":"C8A0E436-C90B-4F98-AA3A-75057C8E1FA8","voice2StartTimeOffset":0,"duration":8.503832199546485,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #53","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.053.jpeg"},{"telop":"私と萃香は驚きながらも、相手の話を聞く。すると、彼女はある衝撃的な発言を言ってきた。私は、その内容に困惑する。","title":"シーン 54","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":9.934784580498865,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"1590B0CC-16D7-467B-96ED-D95FC27B3229","voice2StartTimeOffset":0,"duration":9.934784580498865,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #54","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.054.jpeg"},{"telop":"だが、すぐに永琳からの電話も飛んできて、\n私はこいしの電話を保留にし、そちらに切り替える。","title":"シーン 55","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":6.302902494331065,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"20F22F27-738E-4FB7-AD30-E53D6BF4D67C","voice2StartTimeOffset":0,"duration":6.302902494331065,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #55","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.055.jpeg"},{"telop":"永琳が言うには、彼は貴重な研究対象だから、学園から話さずに、学校側の手が届く範囲でいさせたいとの要望だった。","title":"シーン 56","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.660725623582767,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"F30EC850-8D4B-4C77-AE4A-016680073D94","voice2StartTimeOffset":0,"duration":8.660725623582767,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #56","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.056.jpeg"},{"telop":"私は、彼が貴重な人物であることは認識していたが、それほど重要性の高い人物だとは、正直に言って感じてなかった。","title":"シーン 57","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.607596371882087,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"48110E78-9900-48AC-AC57-440D6CE40EAF","voice2StartTimeOffset":0,"duration":8.607596371882087,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #57","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.057.jpeg"},{"telop":"私は、一通り永琳の意見を聞き終えると、こいしの方に再度、切り替える。すると、彼女は、これは戦いだと、言ってきた。","title":"シーン 58","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":9.121020408163265,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"49BDB296-B1A2-4471-80F9-E81C69A62F95","voice2StartTimeOffset":0,"duration":9.121020408163265,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #58","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.058.jpeg"},{"telop":"そして、彼女は控えめだったが、もし彼女たちの要請に応じられないなら、学園の資金提供などの協力は打ち切ると言ってきた。","title":"シーン 59","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.534149659863946,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"1A9C05FA-AA32-43FC-B004-763B3D66F94E","voice2StartTimeOffset":0,"duration":8.534149659863946,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #59","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.059.jpeg"},{"telop":"どうやらすでに、彼女の両親がトップに鎮座する地下底国グループの意見を聞き取り、グループの見解になったそうだった。","title":"シーン 60","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":7.774058956916099,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"FEC04B71-54C5-426B-BA1D-41FE3AC848C3","voice2StartTimeOffset":0,"duration":7.774058956916099,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #60","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.060.jpeg"},{"telop":"地下底国グループは、その名の通り、この社会の土台や裏側を幅広く、汎用的に事業を展開し支える巨大組織である。","title":"シーン 61","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.490408163265306,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"4B9A6526-A5DB-48A1-A148-DEDF8AB291C0","voice2StartTimeOffset":0,"duration":8.490408163265306,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #61","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.061.jpeg"},{"telop":"彼女は、今までその名では行動することはなかった。\n学校生活とグループでの完全な使い分けをしていたのだ。","title":"シーン 62","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":7.454875283446712,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"AAAEF326-D664-4B96-9241-59D1F55B8D34","voice2StartTimeOffset":0,"duration":7.454875283446712,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #62","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.062.jpeg"},{"telop":"そんな彼女の裸を運悪く見てしまった彼を発端に、彼女は今まであえて潜めていたグループを使い始めたことに、私は驚いた。","title":"シーン 63","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.687165532879819,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"42167558-90E5-4095-BA46-B20B07FBFA0D","voice2StartTimeOffset":0,"duration":8.687165532879819,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #63","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.063.jpeg"},{"telop":"そして、彼女は、彼が居候している家が立ち上げている紅魔建設と、彼の母親にも宣戦布告を済ませたと言う。","title":"シーン 64","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":7.917913832199546,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"D5B01FFD-2FF1-4572-9059-1F83D605C337","voice2StartTimeOffset":0,"duration":7.917913832199546,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #64","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.064.jpeg"},{"telop":"彼女は、自分の裸が見られた後、彼の素性を問いただし、彼がいなくなると、隠し持っていたPCで彼の母親を調べたという。","title":"シーン 65","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.996439909297052,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"FB1D04F4-32DD-4C3C-8A9E-07C2D5D0285C","voice2StartTimeOffset":0,"duration":8.996439909297052,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #65","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.065.jpeg"},{"telop":"そして、その結果、彼の母親が務める神社の跡取りとして、彼に期待されているのを知った彼女は、宣戦布告をしたのだ。","title":"シーン 66","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.520204081632652,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"6261D426-C750-4834-8567-E30F8AD40E5E","voice2StartTimeOffset":0,"duration":8.520204081632652,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #66","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.066.jpeg"},{"telop":"そして、最後にはこの4つ巴の戦いは、旅行が終わったら、即時に始まると高圧的に宣言し、その電話は途切れたのだった。","title":"シーン 67","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.817687074829932,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/萃香（驚く）.png","id":"57A9A408-5D1A-4603-9F70-260041332960","voice2StartTimeOffset":0,"duration":8.817687074829932,"characterName":"隠岐奈","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #67","backgroundName":"2026-11-10_17-38.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/2026-11-10_17-38-58.png","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.067.jpeg"},{"telop":"私は、彼女が地下底国グループの令嬢であることは、把握していたつもりだったが、今回の出来事で、それを実感させられた。","title":"シーン 68","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":8.639251700680273,"voice2StartTimeOffset":0,"id":"D27C67B3-4A99-431B-B2D8-8180FF814B9F","seVolume":1,"duration":8.639251700680273,"characterName":"隠岐奈","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #68","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.068.jpeg"},{"telop":"だが、これから始まるであろう、\nその戦いに不安を覚える、私だった。","title":"シーン 69","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_隠岐奈.wav","audioTrack":"track_voice_%E9%9A%A0%E5%B2%90%E5%A5%88","voiceDuration":4.893219954648526,"voice2StartTimeOffset":0,"id":"EB2636A0-D144-4BBB-A627-E5AE19B34B67","seVolume":1,"duration":4.893219954648526,"characterName":"隠岐奈","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #69","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"隠岐奈","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.069.jpeg"},{"telop":"博麗神社の巫女\n博麗神社の巫女であり、紅夢の母親でもある彼女は、学園の卒業生でもある。そして、彼が以前に通っていた男子校での諸問題に、悩んでいた彼女は、思い切って、自らの母校に転校させた。とは、学園卒業後間もない頃に出会ったらしい）\nそして、親友の魔理沙がいる。\n博麗霊夢","animationDuration":5,"title":"シーン 70","bgmVolume":0.2555899187592319,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/気持ちの良い寝顔.png","id":"4C167325-4433-48EE-A35C-D67C3096C302","seVolume":1,"duration":5,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"bgmAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/New\/Application\/Documents\/参考資料\/動画用\/音楽\/BGM\/nc299045_【東方自作アレンジ】ASTROMIKO【少女綺想曲】.mp3","animationNote":"5秒","slideTitle":"スライド #70","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","bgmName":"BGM: nc299045_【東方自作アレンジ】ASTROMIKO【少女綺想曲】","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.070.jpeg"},{"telop":"「はぁ」私は、ため息をつきながら、神社の敷地を箒で掃いていた。ため息が出る理由は、巨大組織の令嬢からの電話だった。","title":"シーン 71","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":10.165736961451247,"voice2StartTimeOffset":0,"id":"8EF4DBFB-36B4-4843-AA8B-1EFBC4E0A6A2","seVolume":1,"duration":10.165736961451247,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #71","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.071.jpeg"},{"telop":"「ほら、ため息なんかついてないで、チャチャっとやったらどうなのよ、霊夢」私はそう、箒を持っている娘の霊夢に言う。","title":"シーン 72","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":5.754444444444444,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（怒る）.png","id":"9887707F-D896-435B-A095-B50A2CFB4009","voice2StartTimeOffset":0,"duration":5.754444444444444,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #72","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.072.jpeg"},{"telop":"「はぁ、そんなことくらい分かってるわよ、言わずとも。」","title":"シーン 73","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":3.8844897959183675,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（怒る）.png","id":"90AED63C-9A22-47D7-B156-E6C13FABEDE9","voice2StartTimeOffset":0,"duration":3.8844897959183675,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #73","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.073.jpeg"},{"telop":"「そうなら、もっとやる気出して、テキパキ履きなさい。それで、例の跡取りになりそうな孫は、どうするのよ、今後？」","title":"シーン 74","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":6.020521541950114,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（怒る）.png","id":"56122F19-7AD5-47AE-AEA7-1477E015FF14","voice2StartTimeOffset":0,"duration":6.020521541950114,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #74","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.074.jpeg"},{"telop":"「それは…」私は、ここで素直に、宣戦布告の事情を伝えるかどうか迷う。だが、伝えた方がいいと判断し、話し始める。","title":"シーン 75","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":10.576984126984128,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（怒る）.png","id":"9B1896CE-92F5-44B0-908B-F6038BFE2CAF","voice2StartTimeOffset":0,"duration":10.576984126984128,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #75","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.075.jpeg"},{"telop":"「それなら、宣戦布告されたわよ、\n地下底国グループのご令嬢に。」","title":"シーン 76","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":5.254489795918367,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（怒る）.png","id":"DC8C7A84-4540-4824-AA73-5D46B3B9D569","voice2StartTimeOffset":0,"duration":5.254489795918367,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #76","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.076.jpeg"},{"telop":"「えっ？宣戦布告ってどう言うこと。だって彼は、あんたの息子だから、彼が何も言わない限り、ここで働くんじゃないの？」","title":"シーン 77","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":6.5863038548752835,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（困る）.png","id":"713CD316-475C-4AD4-98AC-58C4E69EFBEB","voice2StartTimeOffset":0,"duration":6.5863038548752835,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #77","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.077.jpeg"},{"telop":"「例のご令嬢の裸を、彼が見たって言ってたわよ…」\n私は、なんだか気恥ずかしさを感じながら、そう言う。","title":"シーン 78","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":8.236984126984128,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（困る）.png","id":"1A53F65A-295E-46AC-82AA-4A7A8D9194B9","voice2StartTimeOffset":0,"duration":8.236984126984128,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #78","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.078.jpeg"},{"telop":"「えっ？どういうこと、ご令嬢の裸を見たって…」","title":"シーン 79","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":2.7230385487528346,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（困る）.png","id":"236F98B1-DD0F-426D-B8BB-4949DDF3149C","voice2StartTimeOffset":0,"duration":2.7230385487528346,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #79","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.079.jpeg"},{"telop":"「そのご令嬢と同じ部屋で過ごしていたら、ご令嬢が裸で出てきて、彼はその姿をしっかりと捉えて、ビンタを食らったって…。」","title":"シーン 80","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":9.498231292517007,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/靈夢（困る）.png","id":"714A115D-B9B4-41BA-8846-F9932342E822","voice2StartTimeOffset":0,"duration":9.498231292517007,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #80","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.080.jpeg"},{"telop":"「ふーん、それであんたはどう思うのよ、\n自分の息子がご令嬢の裸を見たって言う事実に対して。」","title":"シーン 81","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":4.642267573696145,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/霊異変疑問.png","id":"F2554CD2-6BDC-4E64-87BB-C23B69F316D3","voice2StartTimeOffset":0,"duration":4.642267573696145,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #81","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.081.jpeg"},{"telop":"「どうって…」私はそう言われ、意見を言おうとするが、何を言えばいいかわからない。すると、彼女がある言葉を言う。","title":"シーン 82","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":8.780748299319727,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/霊異変疑問.png","id":"EAECBFED-5D25-4EE4-8BFC-087024EDE110","voice2StartTimeOffset":0,"duration":8.780748299319727,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #82","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.082.jpeg"},{"telop":"「まさかとは思うけど、ヤキモチなんてしてないわよね…」\n私が、そう娘に問いただすと、娘は明らかに動揺する。","title":"シーン 83","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":5.927278911564626,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/霊異変疑問.png","id":"A83F9882-2725-43B5-9EB4-DF949DA0A136","voice2StartTimeOffset":0,"duration":5.927278911564626,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #83","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.083.jpeg"},{"telop":"「これは、図星ね…、まぁ、いいわ。ほら、やる気出して、チャチャっと敷地内の埃を吐き出しなさい。いいわね…」","title":"シーン 84","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_先代の巫女.wav","audioTrack":"track_voice_%E5%85%88%E4%BB%A3%E3%81%AE%E5%B7%AB%E5%A5%B3","voiceDuration":6.0403174603174605,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/霊異変疑問.png","id":"98CA081C-D0C8-49DD-83E5-58FEE3E1B8F1","voice2StartTimeOffset":0,"duration":6.0403174603174605,"characterName":"先代の巫女","bgmStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #84","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"先代の巫女","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f5\/元女子校の日常　第22話_dfab8722f5.084.jpeg"},{"telop":"私は、それから、頭を横に振って、掃き掃除を進めた。","title":"シーン 85","bgmVolume":0.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":4.993242630385487,"voice2StartTimeOffset":0,"id":"26C83F3F-31E9-426E-99DE-3407709D3C60","seVolume":1,"duration":4.993242630385487,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"voiceStartTimeOffset":0,"seStartTimeOffset":0,"slideTitle":"スライド #85","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceCharacter":"博麗霊夢","animationName":"なし","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第22話_dfab8722f