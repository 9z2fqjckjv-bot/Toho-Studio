lideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.031.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_ナレーション.wav","seVolume":1,"animationName":"なし","seStartTimeOffset":0,"slideTitle":"第31スライド","telop":"「何でも屋」サービス\n結婚費用： 結婚式、招待状、婚約指輪の購入などに活用します。\n妊娠費用： 妊娠検査薬、妊婦健診、子作り応援資金、性感染症の予防費用などに活用します。\n出産費用： 出産直前の輸送、入院、検査、分娩などに活用します。\n育児費用： 子どもが小学校に入るまでの子ども関連費用に活用します。\n教育費用： 小学校から高等学校等を卒業するまでの子ども関連費用に活用します。\n大学進学費用： 大学進学、通学、卒業までの費用に活用します。\n特殊なケース： 障害や後発性の障害がある子どもの教育、通院、入院、検査、服薬などの費用に活用します。\nライフイベント支援の対象内容\n「何でも屋」のサービス","voiceStartTimeOffset":0,"id":"1205785E-1B75-4DD0-944F-C657A85D6026","voiceDuration":12.6495,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"bgmVolume":0.7,"audioTrack":"track_voice_char_narration","characterName":"ナレーション","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 31","voiceCharacter":"ナレーション","duration":7.4},{"animationName":"なし","seVolume":1,"telop":"「何でも屋」サービス\n１つ目： より人生を豊かにするための想いや人生設計・ライフプランがあること。\n２つ目： 自分の理想像があること。\n３つ目： 「何でも屋」の「ライフイベント支援」の内容を熟知していること。\n４つ目： 贈与された資金の使い道が、申請時に提出された内容と合致していること。\n５つ目： もし、４つ目の条件が満たせない場合、その正当な理由があること。\n６つ目： 「何でも屋」があなたの身内などにあなたのライフイベントに対して費用を捻出できないかの確認連絡を許可すること\n７つ目： 何度か、結婚、離婚を繰り返している場合、その理由を「何でも屋」に提出すること\n８つ目： あなたの信用情報に傷がないこと（ただし、この条件を満たすために、「何でも屋」が外部機関にあるあなたの情報と照合することを許可すること。）\n９つ目： もし、８つ目の条件を満たせない場合、あなたの身が潔白であることを「何でも屋」に証明すること\n１０つ目： 過去にこのサービスを利用している場合は、その履歴と理由を「何でも屋」に明示すること。\n１１つ目： 次に記載されている貢献を「何でも屋」から求められた場合に、素直に応じれること\n１２つ目： 郵送の場合は身分証明書のコピーと ライフイベント支援の贈与申込書 を「何でも屋」に提出すること\n１３つ目： オンラインで申請する場合は、 「何でも屋」の公式サイト上にあるフォーム から申請すること\n１４つ目： 「何でも屋」のクラウドシステムに登録し、その費用を贈与額から負担すること。\n１５つ目： 今後ここに要件が追加された場合は従い、また「何でも屋」におけるすべての規約とプライバシーポリシーに同意すること。\nライフイベント支援の贈与要件\n「何でも屋」のサービス","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第32スライド","title":"シーン 32","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"0668D591-C674-4EFE-B392-1748763984EA","transitionName":"なし","voiceDuration":18.93325,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.032.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":9.9,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"「何でも屋」サービス\n「何でも屋」への貢献： 資金の贈与を受けた方に「何でも屋」のパートナーとなっていただき、「何でも屋」のサービスをお客様に提供します。ただし、前述の通り、お客様から頂いた基本料金は他のパートナーと同様の方法で天引きされ、何か別の負担や金銭的な要因が発生することはありません。また、「何でも屋ハウス」の物件管理者となり、「何でも屋」のオーナーである私から支持された場所を生活拠点として、活用し、管理することを追加でお願いすることもあります。これは、「何でも屋ハウス」を利用する人々に貢献することができます。\n地域社会への貢献： あなたが出身地に戻り、地域社会での活動をすることで貢献します。\n社会問題への解決に向けた貢献： 社会問題を解決するために貢献してもらいます。また、その際に必要な費用があれば、追加で贈与することもできます。（例えば、子どもを作ることで少子高齢化の問題を解決する場合は、子作りに必要な資金が追加で贈与されます。）\n社会への貢献\n「何でも屋」のサービス","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第33スライド","title":"シーン 33","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"586DF999-32CC-40C9-82D6-7C4EFD7B2D5E","transitionName":"なし","voiceDuration":13.166,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.033.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":8.3,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"「何でも屋」のサービス\n何でも屋基金","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第34スライド","title":"シーン 34","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"43924F9F-1B41-4356-843A-71D3AAF75009","transitionName":"なし","voiceDuration":8.2845,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.034.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":5.300000000000001,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"日常生活・事業維持費\n「何でも屋」サービス\n通信・ITインフラ維持費、拠点整備費、施設維持費、公共料金など、独立した拠点運営に必要な費用に活用します。通信・ITインフラは、大手携帯キャリアなどのサービスを利用し、安定した環境整備を行う予定です。\n目標金額：30万円\nコンプリートボーナス\nオーダーメイドサービスチケット： 参加者の状況に合わせた特別なサービスを提供するチケットです。\nチケットの追加： 30万円ごとの参加につき、チケットを1枚追加で受け取れます。\n注意点： 参加金額や提供条件により、代替特典をご提供する場合があります。\n運転費用","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第35スライド","title":"シーン 35","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"236DA847-A872-40DE-B9AD-6709FF608B10","transitionName":"なし","voiceDuration":11.17025,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.035.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":6.2,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"広告\n「何でも屋」サービス\nGoogle広告、Yahoo!広告、YouTube広告など、事業を知っていただくための宣伝費用として活用します。\n広告は継続的な運用が必要なため、この基金は毎月の費用を想定しています。\n目標金額：50万円\nコンプリートボーナス\n参加金額の単位ごとに、広告代行サービスで利用できる枠を付与します。\n50万円ごと： 約3万円分の利用枠を付与します。\n500万円ごと： 約33万円分の利用枠を付与します。\n5000万円ごと： 約333万円分の利用枠を付与します。\n5億円ごと： 約3333万円分の利用枠を付与します。\n運転費用","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第36スライド","title":"シーン 36","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D2560E2D-B4A1-4327-82FD-F79975F9D85C","transitionName":"なし","voiceDuration":10.67775,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.036.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":5.9,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"スマートフォン\n「何でも屋」サービス\nDIGNO SX5 KC-S306の購入を目的としたスマートフォン基金です。\n目標金額：5万円\nコンプリートボーナス\nベースパッククレジット： 参加金額に対して100%分のベースパッククレジットを付与します。\n追加付与： 5万円ごとの参加で、5万円分のベースパッククレジットを追加で付与します。\nその他の特典： 購入したスマートフォンをお客様のもとへお運びすることも可能です。ただし、移動代金が必要です。\n初期費用","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"DIGNOSX5","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第37スライド","title":"シーン 37","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"3C21D819-0265-4B90-9DB2-207BAABDD00C","transitionName":"なし","voiceDuration":18.9135,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.037.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":9.8,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"電動三輪車\n「何でも屋」サービス\nこの基金はAINOHOT ST3を購入するための費用として集められる基金です。\n目標金額：21万円\nコンプリートボーナス\n距離要件を満たすお客様が「何でも屋」をご利用される際に適用される移動代金の無料券を電子メールにてお送りいたします。21万円につき、1枚の無料金を獲得できます。\n※距離要件：オーナーの自宅から原則として片道200kmの範囲内にお客様のご指定場所がある場合\n初期費用","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第38スライド","title":"シーン 38","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"202AEEEE-7042-47F7-9006-159CBD3C8970","transitionName":"なし","voiceDuration":17.06525,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.038.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voice2StartTimeOffset":0,"seStartTimeOffset":0,"duration":8.700000000000001,"bgmVolume":0.7,"voiceStartTimeOffset":0},{"animationName":"なし","seVolume":1,"telop":"PC\n「何でも屋」サービス\n「何でも屋」のシステム構築とMacStudioShere’sで活用するフルスペックMacStudioの購入に使われます。\n目標金額：600万円\n※上記の金額には、キーボード、ディスプレイ、マウスの3つも含めた金額を掲載しています。\n初期費用","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_ナレーション.wav","voiceCharacter":"ナレーション","characterName":"ナレーション","audioTrack":"track_voice_char_narration","bgmStartTimeOffset":0,"slideTitle":"第39スライド","title":"シーン 39","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F250B8D5-F3B7-4A08-BBB5-A5B67A041FA3","transitionName":"なし","voiceDuration":11.799,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.039.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","