pository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.054.jpeg","duration":7.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_ナレーション.wav","telop":"現金\n「何でも屋」サービス\nお支払方法\n「何でも屋」のスタッフが利用料金のお支払い時に請求書をお見せしますので、請求書の通りに現金でお支払いください。ただし、おつりは出ませんので、金額ぴったりにお支払いください。\nまた、お支払いの際は現金を札束としてまとめ、封筒あるいはスーツケースなどの頑丈なケースに入れてお出しください。お支払いが終わると領収書をお渡しします。大切に保管してください。","voiceCharacter":"ナレーション","transitionName":"なし","id":"302E9644-72F1-4ACB-870C-61C0635102B4","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_char_narration"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":11.9745,"seVolume":1,"voiceStartTimeOffset":0,"slideTitle":"第55スライド","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"title":"シーン 55","seStartTimeOffset":0,"characterName":"交通費実費","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.055.jpeg","duration":6,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_ナレーション.wav","telop":"口座振り込み\n「何でも屋」サービス\nお支払方法\n以下の銀行口座にお振り込みいただく方法です。\n銀行名：住信SBIネット銀行\n支店名：Vポイント支店\n口座番号：普通2633964\n※行きの移動代金はこの方法でお仕事の前日までにお支払いいただきます。","voiceCharacter":"ナレーション","transitionName":"なし","id":"7E6FF4AB-E2CA-4DD7-B6AC-B1B921FFB3EC","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_char_narration"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":11.661,"seVolume":1,"voiceStartTimeOffset":0,"slideTitle":"第56スライド","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"title":"シーン 56","seStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.056.jpeg","duration":7.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_ナレーション.wav","telop":"PayPal\n「何でも屋」サービス\nお支払方法\nPayPalの決済リンクや請求書払いの方法です。\nこの決済には手数料が発生するため、代金が割高になります。","voiceCharacter":"ナレーション","transitionName":"なし","id":"ECC612C3-7721-4F33-9A07-0B961454A0F9","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_char_narration"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":12.41775,"seVolume":1,"voiceStartTimeOffset":0,"slideTitle":"第57スライド","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"title":"シーン 57","seStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.057.jpeg","duration":7.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_ナレーション.wav","telop":"ベースパッククレジット\n「何でも屋」サービス\nお支払方法\n「何でも屋」にお客様の情報を登録していただき、その情報に残高を紐づけて管理するベースパックのうち、「何でも屋」の利用特典や、イベントなどでの追加、「何でも屋基金」による追加、「何でも屋ハウス」の特典などで発生する基本料金専用の支払い方法です。オプション料金には適用できませんのでご了承ください。","voiceCharacter":"ナレーション","transitionName":"なし","id":"3387590E-7F37-4F54-BE7D-9D2AFCCCDC49","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_char_narration"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":13.8795,"seVolume":1,"voiceStartTimeOffset":0,"slideTitle":"第58スライド","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"title":"シーン 58","seStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.058.jpeg","duration":8.3,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_ナレーション.wav","telop":"ベースパック\n「何でも屋」サービス\nお支払方法\n「何でも屋」にお客様の情報を登録していただき、その情報に残高を紐づけて管理するデジポット型前払い式決済手段です。「何でも屋」のありとあらゆる利用料金にご活用いただけます。また、お客様の残高に合わせて、「ベースパッククレジット」が付与されるため、ベースパック以外のお支払い方法に比べるととてもお得なものになっています。詳細はお問い合わせください。","voiceCharacter":"ナレーション","transitionName":"なし","id":"76C31D6B-593E-497E-95E0-6AF640572636","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_char_narration"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":21.577,"seVolume":1,"voiceStartTimeOffset":0,"slideTitle":"第59スライド","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"title":"シーン 59","seStartTimeOffset":0,"characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.059.jpeg","duration":12.8,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_ナレーション.wav","telop":"送金によるお支払い\n「何でも屋」サービス\nお支払方法\nPayPay,d払い,auPayなどのコード式決済による送金を行いお支払いをします。詳細は、お問い合わせください。","voiceCharacter":"ナレーション","transitionName":"なし","id":"7880BE6D-3E17-40D2-BEF9-9A8E5D6872E1","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_char_narration"}]