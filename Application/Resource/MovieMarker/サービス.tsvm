Slide_045_ナレーション.wav","bgmStartTimeOffset":0,"animationName":"なし","bgmVolume":0.7,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.045.jpeg"},{"title":"シーン 46","transitionName":"なし","voiceDuration":11.4645,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第46スライド","id":"D570BB21-D72F-4819-8F8F-EF2C906E8A84","audioTrack":"track_voice_char_narration","characterName":"ナレーション","voiceCharacter":"ナレーション","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":6.300000000000001,"telop":"利用特典\n「何でも屋」サービス\n「何でも屋ハウス」の利用特典としてベースパッククレジットが付与されます。 ベースパッククレジットはメインサービスの基本料金あるいはプレミアム料金としてお使いいただけます。\n「何でも屋ハウス」","voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_ナレーション.wav","bgmStartTimeOffset":0,"animationName":"なし","bgmVolume":0.7,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.046.jpeg"},{"title":"シーン 47","transitionName":"なし","voiceDuration":11.1145,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第47スライド","id":"7DF1EF30-F784-492F-874D-19E0E55CA09E","audioTrack":"track_voice_char_narration","characterName":"ナレーション","voiceCharacter":"ナレーション","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":5.800000000000001,"telop":"獲得方法\n「何でも屋」サービス\n土地価格\n査定業者等の第三者にお客様の物件を査定していただき、お客様の物件がある土地の評価額が土地価格として計上されます。\n建物価格\n査定業者等の第三者に土地価格と同時に査定していただき、お客様の物件そのものが建物価格として計上されます。\nオプション項目\n「何でも屋ハウス」","voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_ナレーション.wav","bgmStartTimeOffset":0,"animationName":"なし","bgmVolume":0.7,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.047.jpeg"},{"title":"シーン 48","transitionName":"なし","voiceDuration":11.1695,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第48スライド","id":"6C39C3A5-BE02-48AB-AD12-0DDC155F7EC2","audioTrack":"track_voice_char_narration","characterName":"ナレーション","voiceCharacter":"ナレーション","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":6.5,"telop":"申込方法\n「何でも屋」サービス\n申込方法は以下のとおりです。\n1. このページの下部にあるフォームから申し込み\n2.詳細情報を求める返信が来るのを待つ\n3.詳細情報を提供したら、実際の物件の見学と査定の日時を決める。\n4.日時を決め、当日になったら物件の査定とオプション項目のチェックを行う。\n5.査定結果とオプション項目チェックの結果が届き、お客様の同意の上、「何でも屋ハウス」としての利用を開始する。\n「何でも屋ハウス」","voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_ナレーション.wav","bgmStartTimeOffset":0,"animationName":"なし","bgmVolume":0.7,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.048.jpeg"},{"title":"利用契約の更新方法","transitionName":"なし","slideTitle":"中扉","id":"43291C40-1DB9-40A4-9D7C-C89258F3163B","voiceCharacter":"","characterName":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"単色背景","duration":3,"telop":"","voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"bgmVolume":0.7,"animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.049.jpeg"},{"title":"シーン 50","transitionName":"なし","voiceDuration":5.887,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第50スライド","id":"E6543571-EA0E-4C56-9C62-74C232156AB1","audioTrack":"track_voice_char_narration","characterName":"ナレーション","voiceCharacter":"ナレーション","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.8000000000000003,"telop":"「何でも屋」サービス\nクラウドサービス","voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_ナレーション.wav","bgmStartTimeOffset":0,"animationName":"なし","bgmVolume":0.7,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.050.jpeg"},{"title":"シーン 51","transitionName":"なし","voiceDuration":25.4665,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第51スライド","id":"57496382-1706-41AA-88DE-C63E4A53F173","audioTrack":"track_voice_char_narration","characterName":"ナレーション","voiceCharacter":"ナレーション","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":14.600000000000001,"telop":"「何でも屋」サービス\n「何でも屋」のスタッフが作成した作品やソフトの提供や、限定記事を活用。\nNanndemoya Content\n「何でも屋」の財務情報を閲覧。\nクイックビュー\n基本料金のみでプレミアムな品質に。\nプレミアチケット\nGoogleMeetで何でも相談。\nWeb相談\nタクシー、新幹線、飛行機を生かした速達移動でサービスをお届け。\nクイックカム\nベースパックが増えていく。新しいマネ活の始まり。\nベースパック＋\nクラウドサービス\n「何でも屋」のサービス\nマネジメント\nありとあらゆる管理の手間や作業を丸ごとお預け。\nお荷物お運びサービス\nあなたの荷物を公共交通機関で届けます。\nNanndemoyaShoppingDelivery\nセットアップ済みのデジタルデバイスをお届けします。\n中古デジタルデバイス買取サービス\n中古のデジタルデバイスを買い取り、ベースパッククレジットを付与します。\n各サービスの料金体制についてはこちら→","voice2StartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_ナレーション.wav","bgmStartTimeOffset":0,"animationName":"なし","bgmVolume":0.7,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/サービス_cfc5f25fdd\/サービス_cfc5f25fdd.051.jpeg"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","voiceDuration":6.362,"seVolume":1,"voiceSta