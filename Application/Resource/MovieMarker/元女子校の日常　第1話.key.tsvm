[{"audioTrack":"track_voice_soumu","telop":"僕は、目が覚めるとリビングに降りてくる。\n東方Project二次創作作品","duration":3.5,"title":"シーン 1","voiceDuration":2.538684807256236,"id":"06E3B45B-2EA3-4D84-AEAD-7B602E3EA381","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.001.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","voiceCharacter":"操夢","slideTitle":"第1スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"すると、僕の母…霊夢が話しかけてくる。\n作成者：zuyasi","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":3.5,"title":"シーン 2","voiceDuration":3.1386848072562357,"id":"0626794B-CDB5-40A1-83A7-A4A9FE6727DD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.002.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","voiceCharacter":"操夢","slideTitle":"第2スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_reimu","telop":"","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":3,"title":"「ちょうど、朝食ができて食べ始めたところだから、あんたも早く、席に着いてちゃちゃっと食べちゃいなさい。」","voiceDuration":7.794489795918367,"id":"A9C55422-0AE6-479A-8A8E-3E1651ED2D42","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.003.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_003_博麗霊夢.wav","voiceCharacter":"博麗霊夢","slideTitle":"中扉","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「分かった…」\n僕はそういうと、目の前の卵かけご飯を食べる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":3.5,"title":"シーン 4","voiceDuration":4.231065759637188,"id":"080B3FC5-8F61-4D4C-BECE-53EF546E315A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.004.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","voiceCharacter":"操夢","slideTitle":"第4スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_reimu","telop":"「そういえば、入学式は、親の付き添いっているの？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":3.5,"title":"シーン 5","voiceDuration":4.0619954648526075,"id":"016D0579-1437-4074-AF90-8DAB0168589F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.005.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","voiceCharacter":"博麗霊夢","slideTitle":"第5スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「いや、大丈夫だから、付き添わなくていいよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":3.5,"title":"シーン 6","voiceDuration":3.108253968253968,"id":"BD32796B-96FB-4DB4-9571-583C26161786","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.006.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","voiceCharacter":"操夢","slideTitle":"第6スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_reimu","telop":"「そう、じゃあ、あんたの分の食器は自分で洗いなさいね。\n私は、もう神社に向かうから。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":4.2,"title":"シーン 7","voiceDuration":7.211995464852608,"id":"BABFB2BB-2140-4CCD-BD97-AC917D3D9086","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.007.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav","voiceCharacter":"博麗霊夢","slideTitle":"第7スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「分かった。」\n僕がそういうと、彼女はそのまま家を出ていった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","duration":3.5,"title":"シーン 8","voiceDuration":4.288684807256236,"id":"2051F578-F139-4DB8-942E-C45D8B0B3DC5","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.008.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_008_操夢.wav","voiceCharacter":"操夢","slideTitle":"第8スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"僕は、それから数分も経たずに、朝食を食べ切ると、そのまま流しに食器を入れ、ささっと洗剤で洗う。","duration":5.1000000000000005,"title":"シーン 9","voiceDuration":7.234331065759637,"id":"151366F9-DA57-4881-9A46-13C757914954","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.009.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_009_操夢.wav","voiceCharacter":"操夢","slideTitle":"第9スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"そして、洗い物が終わると、自分の部屋に戻る。","duration":3.5,"title":"シーン 10","voiceDuration":3.2756462585034014,"id":"43913290-5962-420B-BE37-B6CC865460AD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.010.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","characterName":"操夢","backgroundName":"リビング（日中）.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","voiceCharacter":"操夢","slideTitle":"第10スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"そして、部屋に戻ると、新品の学校の制服を取り出し、ささっと着替える。そして、デスクをチラリと見ると、ある写真が写る。","duration":5.800000000000001,"title":"シーン 11","voiceDuration":8.869115646258503,"id":"941D85A4-23E8-4B44-88DB-382DDD07DBA2","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.011.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","characterName":"操夢","backgroundName":"一人部屋３（日中）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","voiceCharacter":"操夢","slideTitle":"第11スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"その写真には、巫女服の霊夢と、僕の父である妹紅、そして、僕の3人が写っていた。この時の僕はまだ、小学生だった。","duration":5.5,"title":"シーン 12","voiceDuration":9.45281179138322,"id":"33A442C4-21F8-4D44-B1A4-A13423A1CD83","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.012.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","characterName":"操夢","backgroundName":"一人部屋３（日中）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","voiceCharacter":"操夢","slideTitle":"第12スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"今思えば、僕がこの学校を選んだ理由も、中学時代のある経験が原因だ。中学まで男子ばっかで度々トラブルになった。","duration":5.4,"title":"シーン 13","voiceDuration":8.750634920634921,"id":"07012D57-130D-445F-8428-402B3F76E762","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.013.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","characterName":"操夢","backgroundName":"一人部屋３（日中）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","voiceCharacter":"操夢","slideTitle":"第13スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"世の中の男女比率…僕はそんなことを考えながら、ふと時計を見ると、もうすぐ家を出ないといけない時間で、頭を振る。","duration":5.5,"title":"シーン 14","voiceDuration":8.082154195011338,"id":"10848B2B-DB00-4D08-8B54-DE9AB3510CE1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.014.jpeg","transitionName":"カラーでフェード","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","characterName":"操夢","backgroundName":"一人部屋３（日中）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","voiceCharacter":"操夢","slideTitle":"第14スライド","bgmName":"BGM: 少女綺想曲"},{"telop":"元女子校の日常","duration":3,"title":"東方Project二次創作作品　Powerd By zuyasi","id":"6EF4443D-3D00-4D1C-B8E4-3B01677F7A87","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.015.jpeg","transitionName":"なし","animationName":"バウンス","characterName":"","backgroundName":"単色背景","voiceCharacter":"","bgmName":"BGM: 少女綺想曲","slideTitle":"タイトル","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第1話_ef24fa640c\/slide_015_anim.m4v"},{"audioTrack":"track_voice_soumu","telop":"僕は、学校に着くと、腕につけている時計を見る、\n思っていたよりも早く着いたみたいだった。","duration":4.3,"title":"シーン 16","voiceDuration":6.081065759637188,"id":"DF84E76E-067B-4F6D-880F-6440E8800C81","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.016.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voiceCharacter":"操夢","slideTitle":"第16スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"そして中に、入っていく。","duration":3.5,"title":"シーン 17","voiceDuration":1.7843310657596372,"id":"8B301675-EFCC-4C5C-9549-3541D4BEE485","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.017.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","voiceCharacter":"操夢","slideTitle":"第17スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"僕が教室に入ると、すでに教室にいた\n女子たちが一斉にコチラを見る。","duration":3.5,"title":"シーン 18","voiceDuration":4.686507936507937,"id":"B0AC1C7C-5A3C-4531-B7A8-BAE0000CC7F8","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.018.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","voiceCharacter":"操夢","slideTitle":"第18スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「あなたは…今年から来る中途入学の男子ですか？」","duration":3.5,"title":"シーン 19","voiceDuration":2.7411791383219954,"id":"249EE5BE-53C5-45F5-B485-C7A2BD525045","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.019.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第19スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「中途入学…？」","duration":3.5,"title":"シーン 20","voiceDuration":1.5,"id":"107610C5-7294-419D-8176-8264F1DADF06","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.020.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voiceCharacter":"操夢","slideTitle":"第20スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「ええ、この学園では、幼稚部から大学院まであって、希望者は教員になって、定年まで居続けられる学園なんですよ。」","duration":5.5,"title":"シーン 21","voiceDuration":6.435192743764173,"id":"E5A398E4-810D-4B14-A0D9-BB523961F3C3","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.021.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第21スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「へぇ…」","duration":3.5,"title":"シーン 22","voiceDuration":1.5,"id":"9895622D-BD31-4A13-A4AA-1AD536BFFCF0","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.022.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voiceCharacter":"操夢","slideTitle":"第22スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「その顔…もしかして、この学園のことを\n何も知らずに入学したんですか？」","duration":3.5,"title":"シーン 23","voiceDuration":3.964784580498866,"id":"7F6BA7A2-AA8A-4F72-9602-6EB5FE306B65","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.023.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第23スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「両親に、この学校に行けって言われて、\nただそのまま来たっていえばいいですか？」","duration":3.9000000000000004,"title":"シーン 24","voiceDuration":5.112607709750567,"id":"4D46250C-C96A-4499-8213-E5C7113F9114","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.024.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voiceCharacter":"操夢","slideTitle":"第24スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「そうですか…。まぁ、あなた以外はみな小さい頃から見知った同性の学生ばかりですからね…」","duration":4.4,"title":"シーン 25","voiceDuration":4.764580498866213,"id":"C34D93EC-7A90-4383-8B2B-7CD8A418889B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.025.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第25スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「それで、僕の席は…」","duration":3.5,"title":"シーン 26","voiceDuration":1.732154195011338,"id":"E762CF3D-BD09-45ED-AFC0-5DE5CF37742C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.026.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceCharacter":"操夢","slideTitle":"第26スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「確か、窓際の真ん中の席に空席があった気がしますが…」","duration":3.5,"title":"シーン 27","voiceDuration":3.2889795918367346,"id":"05804714-4E30-45C6-BD98-AE40ACBEB256","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.027.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第27スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「そうですか…」\n僕は、そう呟くと言われた席につき、荷物をおろし始めた。","duration":3.5,"title":"シーン 28","voiceDuration":5.2365079365079366,"id":"CFFBBE70-485D-4EFF-B886-6406932AA7DD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.028.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voiceCharacter":"操夢","slideTitle":"第28スライド","bgmName":"BGM: 少女綺想曲"},{"telop":"それからしばらくたち…","duration":3,"title":"シーン 29","id":"854ADE8D-E361-4E46-9C47-7072A6DCC42F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.029.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"ナレーション","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"ナレーション","bgmName":"BGM: 少女綺想曲","slideTitle":"第29スライド"},{"audioTrack":"track_voice_soumu","telop":"それから、数十分ほど経つと、チャイムがなり、教室が静まり返る。そして、数十秒程度の間の後、誰かが教室にはいってくる。","duration":5.800000000000001,"title":"シーン 30","voiceDuration":9.59954648526077,"id":"AF3DB4DF-84AF-484D-BBA4-E53803634558","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.030.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","voiceCharacter":"操夢","slideTitle":"第30スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「おはようございます。」","duration":3.5,"title":"シーン 31","voiceDuration":1.5,"id":"E3EEE231-58E7-4D71-8F25-DB81733F7B7B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.031.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第31スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"その女性がそういうと、周りの女子たちが皆一斉に「おはようございます」と言い、礼をする。","duration":4.3,"title":"シーン 32","voiceDuration":5.773469387755102,"id":"88135577-5606-466E-B9BE-B2B05A61D8D9","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.032.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","voiceCharacter":"操夢","slideTitle":"第32スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「おや…一人…はずれものがいますね…」\n私はそう言い、その男子に目線を合わせる。","duration":3.9000000000000004,"title":"シーン 33","voiceDuration":5.297777777777778,"id":"FEEE472E-29A2-40AD-8852-43ADD17E45D4","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.033.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第33スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「あなたも、今日から、この学園の一員ですから、\n挨拶の練習でもしましょうか…、藤原さん。」","duration":4.6000000000000005,"title":"シーン 34","voiceDuration":6.126848072562359,"id":"C2C4D733-6241-4B4F-A4C0-4464EFCB9E1F","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.034.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第34スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"僕はそう言われ、僕に向けての声かけだったことに気づく。\n「あの…練習って…何をすればいいんですか？」","duration":4.9,"title":"シーン 35","voiceDuration":6.95281179138322,"id":"112195B7-E791-46EA-9F97-D996E82D1196","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.035.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","voiceCharacter":"操夢","slideTitle":"第35スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「そうですね…とりあえず、私の方に来てください。」","duration":3.5,"title":"シーン 36","voiceDuration":3.3775736961451246,"id":"44BBC46F-D2A1-4705-8242-C75AE3B3A5C5","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.036.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第36スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"僕は、彼女にそう言われ、彼女の隣に立つ。\nすると、彼女が再び挨拶し、女子から挨拶と礼が返ってくる。","duration":4.800000000000001,"title":"シーン 37","voiceDuration":8.166938775510204,"id":"B8A010A7-6A0D-4D5F-91E3-7D0E46E937A7","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.037.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","voiceCharacter":"操夢","slideTitle":"第37スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「彼女たちのように、あなたも私の挨拶に対して、\n挨拶とお辞儀で返すことはできますか？」","duration":4.2,"title":"シーン 38","voiceDuration":5.734444444444445,"id":"CD276FD0-010B-410A-9EFB-17C770BDAA56","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.038.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第38スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"僕はそう言われ、どう返すべきかわからず、黙ってしまう…。\nすると、彼女がある女子を呼び、その女子は僕の反対側に立つ。","duration":5.7,"title":"シーン 39","voiceDuration":8.436507936507937,"id":"1A0D4A1E-991A-4408-93C7-DCB6794EFE62","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.039.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","voiceCharacter":"操夢","slideTitle":"第39スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「さとりさん、私が今から、『おはようございます。』と言いますので、彼に返しの挨拶とお辞儀の手本を見せてください。」","duration":5.7,"title":"シーン 40","voiceDuration":7.468979591836734,"id":"7350EB9C-6C1B-43E0-87C3-E34F029C982B","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.040.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第40スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「分かりました、早苗師匠。」\n私はそう返すと、彼女に言われた通りに、彼に手本を見せる。","duration":4.2,"title":"シーン 41","voiceDuration":5.283378684807256,"id":"A026CD60-83EE-469C-997D-9B47D40C16CD","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.041.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第41スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「さて、お手本は見せました、今度はあなたの番ですよ、藤原さん。挨拶とお辞儀、出来ますか？」","duration":4.5,"title":"シーン 42","voiceDuration":6.580453514739229,"id":"8BD8F82A-93CA-4535-AC33-9FBFB2DB0524","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.042.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第42スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"僕は、彼女にそう言われ、見よう見まねで挨拶とお辞儀をする。","duration":3.5,"title":"シーン 43","voiceDuration":3.9973696145124715,"id":"438CD77F-4ADD-4360-B5AF-E956DE62C4A7","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.043.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","voiceCharacter":"操夢","slideTitle":"第43スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「初日しては、上出来ですよ、藤原さん。それじゃあ、あなたのこれまでの人生について、10分間で言いましょう。」","duration":5.4,"title":"シーン 44","voiceDuration":7.4156462585034015,"id":"47494DF1-9085-4C03-A80F-74AA928B3654","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.044.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第44スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"「分かりました…」僕はそう言われ、これまでの人生を振り返る。そのうち、スイッチが入ったように、その内容を語った。","duration":5.6000000000000005,"title":"シーン 45","voiceDuration":8.209342403628117,"id":"BC1E9A10-0970-4060-BA6F-D0AD94E31B89","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.045.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","voiceCharacter":"操夢","slideTitle":"第45スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「今日の朝礼はこれで、終了です。今日から新年度ですので、心改めて、より良い自分を見せられるようにしましょう。」","duration":5.5,"title":"シーン 46","voiceDuration":7.5830385487528345,"id":"6CCAD040-3095-4ADE-BF33-34BC827BFBC2","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.046.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"東風谷早苗","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_東風谷早苗.wav","voiceCharacter":"東風谷早苗","slideTitle":"第46スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telop":"彼女はそういうと、その場を去っていった。すると、彼女にさとりと呼ばれていた、先程の女子が僕の元に駆け寄る。","duration":5.300000000000001,"title":"シーン 47","voiceDuration":7.831065759637188,"id":"3DF0CFBB-207B-4BC9-8C23-7C8C4CBB4892","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.047.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","voiceCharacter":"操夢","slideTitle":"第47スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「汗ダラダラで顔も赤いですけど、大丈夫ですか？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","duration":3.5,"title":"シーン 48","voiceDuration":2.6291836734693876,"id":"082B8F46-6DD4-4066-9AB9-4CB609904175","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第1話_ef24fa640c\/元女子校の日常　第1話_ef24fa640c.048.jpeg","transitionName":"なし","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"古明地さとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_古明地さとり.wav","voiceCharacter":"古明地さとり","slideTitle":"第48スライド","bgmName":"BGM: 少女綺想曲"},{"audioTrack":"track_voice_soumu","telo