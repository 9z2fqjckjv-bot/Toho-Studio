[{"duration":3,"title":"@zuyasi　東方Project二次創作作品","characterName":"","slideTitle":"タイトル","id":"1E39521B-8D9B-49E7-A1D8-6C34D472AAE6","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第12話_432572eca5\/slide_001_anim.m4v","transitionName":"クロスディゾルブ","animationName":"バウンス","backgroundName":"単色背景","voiceCharacter":"","bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.001.jpeg","telop":"幼き日の夢"},{"duration":5.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav","title":"シーン 2","characterName":"博麗霊夢","slideTitle":"第2スライド","id":"468455EC-46DA-4634-BC9C-F474C185410C","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpeg","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":10.424489795918367,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.002.jpeg","telop":"私は、紫が立ち去り、ただ一人、紅魔館の玄関に取り残された。\nそして、しばらく経ち、ここに来た目的を思い出す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd"},{"duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_博麗霊夢.wav","title":"シーン 3","characterName":"博麗霊夢","slideTitle":"第3スライド","id":"1360C844-06F0-4470-9C3D-FB9BFBF1267D","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc213186_紅魔館ロビー.jpeg","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":6.094489795918367,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.003.jpeg","telop":"「彼は…どこかしら…」\n私はそう呟きながら、彼の姿を探し始める。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd"},{"duration":4.3,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_博麗霊夢.wav","title":"シーン 4","characterName":"博麗霊夢","slideTitle":"第4スライド","id":"A81CB26E-7ECE-4FE3-9985-A3A56206F2CE","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":8.265736961451248,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.004.jpeg","telop":"そして、玄関から見て正面の大きな扉を開け、中に入る。\nだが、その空間には誰もいなかった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"duration":4.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","title":"シーン 5","characterName":"博麗霊夢","slideTitle":"第5スライド","id":"CF7944DF-08C2-498E-AB6A-0E8D15FD0ED8","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc196979_食堂(昼).png","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":9.461995464852608,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.005.jpeg","telop":"そして、食堂にやってくる。だが、彼の姿はない。\n私は、その足取りのまま、大図書館の方へと向かう。"},{"duration":3.9000000000000004,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_博麗霊夢.wav","title":"シーン 6","characterName":"博麗霊夢","slideTitle":"第6スライド","id":"6BB9DC91-D5A5-401D-A85F-E1F1B627286E","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":7.569478458049887,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.006.jpeg","telop":"私が大図書館に来ると、そこは暗闇が広がっていた。\nだが私は、そのまま足を進める。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav","title":"シーン 7","characterName":"博麗霊夢","slideTitle":"第7スライド","id":"3A58C64E-3EAD-46A0-A31E-F93AEAE28CFA","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":2.4194784580498867,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.007.jpeg","telop":"すると、誰かと肩がぶつかる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"duration":5.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_十六夜咲夜.wav","title":"シーン 8","characterName":"十六夜咲夜","slideTitle":"第8スライド","id":"50CEFAB5-F852-483A-85F5-0E640C5F1920","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":7.392993197278911,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.008.jpeg","telop":"私は、彼に依頼され、図書館の見回りをしていると、誰かと肩がぶつかり、時を止めて確認すると、そこには彼女がいた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_十六夜咲夜.wav","title":"シーン 9","characterName":"十六夜咲夜","slideTitle":"第9スライド","id":"6C6BDEEE-828B-44E2-BDD7-438C7A501B19","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":5.517981859410431,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.009.jpeg","telop":"私は、彼に言われたことを思い出し、彼女をそっと抱き上げると、そのまま紅魔館の外に向かう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_十六夜咲夜.wav","title":"シーン 10","characterName":"十六夜咲夜","slideTitle":"第10スライド","id":"FA3C0549-44E9-4EB0-AC51-995C44BBD1B3","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc73544_【背景素材】紅魔館.jpg","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":6.897687074829932,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.010.jpeg","telop":"そして、外まで来ると、彼女を門扉の外で降ろす。\n私は、そのまま寂しく微笑むと、図書館に戻っていった。"},{"duration":5.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","title":"シーン 11","characterName":"博麗霊夢","slideTitle":"第11スライド","id":"56E88A04-EBFF-4CB3-ABA0-F15B40CE760C","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc73544_【背景素材】紅魔館.jpg","audioTrack":"track_voice_reimu","voiceCharacter":"博麗霊夢","voiceDuration":10.641995464852608,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.011.jpeg","telop":"私は、ハッと気がつくと、そこは紅魔館の門扉の前だった。\n「なぜ、私を外に出すの…咲夜…」私はそう呟くのだった。"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","title":"シーン 12","characterName":"操夢","slideTitle":"第12スライド","id":"7BC40FFF-A319-4006-B818-16723E10AFA9","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":7.475646258503401,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.012.jpeg","telop":"「誰かが、図書館に入ってきたのですか？」\n僕は、彼女の表情から、思考を推測し、そう尋ねる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_十六夜咲夜.wav","title":"シーン 13","characterName":"十六夜咲夜","slideTitle":"第13スライド","id":"8BB0C849-F7DE-406A-B1EA-258418593AB9","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":1.3318820861678005,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.013.jpeg","telop":"「ええ…、霊夢さんです。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","title":"シーン 14","characterName":"操夢","slideTitle":"第14スライド","id":"21B582B9-D433-4150-80CC-9EA59FCFFE2B","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":4.971292517006803,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.014.jpeg","telop":"「そうですか…」\n僕は、予想通りの答えが返ってきたので、そう呟く。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","title":"シーン 15","characterName":"操夢","slideTitle":"第15スライド","id":"A11AAC23-D0C1-4289-858D-1113E5226E7C","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":3.55172335600907,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.015.jpeg","telop":"「何か、飲み物を持ってきて、休憩にしますか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_十六夜咲夜.wav","title":"シーン 16","characterName":"十六夜咲夜","slideTitle":"第16スライド","id":"731D2C92-82D4-41D3-9A17-8C5DEFCB7005","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":4.406190476190476,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.016.jpeg","telop":"「ええ、お願いします…」\n私は、彼の言葉に対して、手短に返す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":4.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","title":"シーン 17","characterName":"操夢","slideTitle":"第17スライド","id":"FBEFA067-579B-42B5-BF53-E4B362261CE0","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":6.453900226757369,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.017.jpeg","telop":"「わかりました、じゃあ、レミリアさんたちが、皆向こうで、寝ているので、少し待っててください。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","title":"シーン 18","characterName":"操夢","slideTitle":"第18スライド","id":"A5E25114-9DCC-46F0-9556-6FE6CA724AE6","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":3.6517233560090703,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.018.jpeg","telop":"僕はそういうと、咲夜とすれ違い、食堂に向かう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"duration":5.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","title":"シーン 19","characterName":"操夢","slideTitle":"第19スライド","id":"6743FADC-F2EC-4EE1-AFEC-0BD0AD20FF54","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc196979_食堂(昼).png","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":8.658253968253968,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.019.jpeg","telop":"僕は、そういうと、食堂にやってくる。そして、２つのコップを取り出して、紅茶を注ぎ込むと、コップを持ち、戻っていく。"},{"duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","title":"シーン 20","characterName":"操夢","slideTitle":"第20スライド","id":"7145A019-C4D3-44C6-BF7C-2877E5234E6F","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":4.30390022675737,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.020.jpeg","telop":"僕が、図書館に戻ると、テーブルにコップを置き、咲夜を呼ぶ。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":5.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","title":"シーン 21","characterName":"操夢","slideTitle":"第21スライド","id":"BE9B9477-90E5-4C6B-B192-9C24628D653A","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":7.966938775510204,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.021.jpeg","telop":"「それで、ここ最近は彼女たちの様子はどうでしたか？」\n僕は、一瞬、寝ているレミリアたちに目を向けてから、いう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_十六夜咲夜.wav","title":"シーン 22","characterName":"十六夜咲夜","slideTitle":"第22スライド","id":"B6C27D3A-0688-4069-ACFF-0FC85048BC98","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":5.908888888888889,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.022.jpeg","telop":"「ここ最近は、フラン様が、ご乱心になる回数や、その威力が、これまでより凄まじいものでして…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","title":"シーン 23","characterName":"操夢","slideTitle":"第23スライド","id":"FC43277C-A69F-4FC0-B9F6-18E2552595B8","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":5.769115646258504,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.023.jpeg","telop":"「何か、心当たりとかはありますか？」\n僕は、念の為に、彼女に尋ねる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_十六夜咲夜.wav","title":"シーン 24","characterName":"十六夜咲夜","slideTitle":"第24スライド","id":"3496F5E2-ABD2-477E-9961-71BF1695F6A8","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","voiceCharacter":"十六夜咲夜","voiceDuration":1.0986848072562359,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.024.jpeg","telop":"「いえ、特には…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":5.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","title":"シーン 25","characterName":"操夢","slideTitle":"第25スライド","id":"B9DED938-2DBB-4B12-9DCB-ABA0E6CE6DC0","transitionName":"クロスディゾルブ","animationName":"なし","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","voiceCharacter":"操夢","voiceDuration":8.789773242630385,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.025.jpeg","telop":"「そうですか…」僕は、そう言いながら、これからのプランを頭の中に構築していく。そして、その内容を彼女に話すのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"}]