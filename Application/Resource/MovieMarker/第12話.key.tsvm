[{"duration":3,"characterName":"","backgroundName":"単色背景","animationName":"バウンス","id":"0B21D9F7-93C9-4002-8432-E3EE89280F21","telop":"幼き日の夢","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第12話_432572eca5\/slide_001_anim.m4v","voiceCharacter":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.001.jpeg","slideTitle":"タイトル","title":"@zuyasi　東方Project二次創作作品","bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav","duration":5.300000000000001,"characterName":"博麗霊夢","backgroundName":"nc213186_紅魔館ロビー.jpeg","animationName":"なし","id":"42962B3B-38A3-40A3-8221-AABFFB183254","audioTrack":"track_voice_reimu","telop":"私は、紫が立ち去り、ただ一人、紅魔館の玄関に取り残された。\nそして、しばらく経ち、ここに来た目的を思い出す。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.002.jpeg","slideTitle":"第2スライド","title":"シーン 2","voiceDuration":10.424489795918367,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_博麗霊夢.wav","duration":3.5,"characterName":"博麗霊夢","backgroundName":"nc213186_紅魔館ロビー.jpeg","animationName":"なし","id":"48B5C286-E182-477E-9CE2-DCF22C2E04D0","audioTrack":"track_voice_reimu","telop":"「彼は…どこかしら…」\n私はそう呟きながら、彼の姿を探し始める。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.003.jpeg","slideTitle":"第3スライド","title":"シーン 3","voiceDuration":6.094489795918367,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc213186_紅魔館ロビー.pxd"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_博麗霊夢.wav","duration":4.3,"characterName":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","id":"B9DCF476-09C3-41FB-A0C0-B9CD532A2107","audioTrack":"track_voice_reimu","telop":"そして、玄関から見て正面の大きな扉を開け、中に入る。\nだが、その空間には誰もいなかった。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.004.jpeg","slideTitle":"第4スライド","title":"シーン 4","voiceDuration":8.265736961451248,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","duration":4.7,"characterName":"博麗霊夢","backgroundName":"nc196979_食堂(昼).png","animationName":"なし","id":"D8C25DBA-C3F7-4313-B2FE-F541FD75C196","audioTrack":"track_voice_reimu","telop":"そして、食堂にやってくる。だが、彼の姿はない。\n私は、その足取りのまま、大図書館の方へと向かう。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.005.jpeg","slideTitle":"第5スライド","title":"シーン 5","voiceDuration":9.461995464852608,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_博麗霊夢.wav","duration":3.9000000000000004,"characterName":"博麗霊夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"A8956892-3530-4B84-AB43-9A8F32A9FF1B","audioTrack":"track_voice_reimu","telop":"私が大図書館に来ると、そこは暗闇が広がっていた。\nだが私は、そのまま足を進める。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.006.jpeg","slideTitle":"第6スライド","title":"シーン 6","voiceDuration":7.569478458049887,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_博麗霊夢.wav","duration":3.5,"characterName":"博麗霊夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"811DBDCD-532E-420A-A79B-B06B08A075EE","audioTrack":"track_voice_reimu","telop":"すると、誰かと肩がぶつかる。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.007.jpeg","slideTitle":"第7スライド","title":"シーン 7","voiceDuration":2.4194784580498867,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_十六夜咲夜.wav","duration":5.5,"characterName":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"6B53B995-2399-4979-ABF7-97556D795101","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","telop":"私は、彼に依頼され、図書館の見回りをしていると、誰かと肩がぶつかり、時を止めて確認すると、そこには彼女がいた。","voiceCharacter":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.008.jpeg","slideTitle":"第8スライド","title":"シーン 8","voiceDuration":7.392993197278911,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_十六夜咲夜.wav","duration":4.4,"characterName":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"1E2CEE4D-709E-4FBE-96D3-692F49B87BA5","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","telop":"私は、彼に言われたことを思い出し、彼女をそっと抱き上げると、そのまま紅魔館の外に向かう。","voiceCharacter":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.009.jpeg","slideTitle":"第9スライド","title":"シーン 9","voiceDuration":5.517981859410431,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_十六夜咲夜.wav","duration":4.9,"characterName":"十六夜咲夜","backgroundName":"nc73544_【背景素材】紅魔館.jpg","animationName":"なし","id":"87FA88AA-A32B-48B6-9D27-1CC559641F81","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","telop":"そして、外まで来ると、彼女を門扉の外で降ろす。\n私は、そのまま寂しく微笑むと、図書館に戻っていった。","voiceCharacter":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.010.jpeg","slideTitle":"第10スライド","title":"シーン 10","voiceDuration":6.897687074829932,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","duration":5.4,"characterName":"博麗霊夢","backgroundName":"nc73544_【背景素材】紅魔館.jpg","animationName":"なし","id":"2FF1A4AC-368E-4803-B505-28B39414EA38","audioTrack":"track_voice_reimu","telop":"私は、ハッと気がつくと、そこは紅魔館の門扉の前だった。\n「なぜ、私を外に出すの…咲夜…」私はそう呟くのだった。","voiceCharacter":"博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.011.jpeg","slideTitle":"第11スライド","title":"シーン 11","voiceDuration":10.641995464852608,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":4.4,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"9ADEFCDB-C27A-43F6-94D4-E10CDB7CDC8E","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"「誰かが、図書館に入ってきたのですか？」\n僕は、彼女の表情から、思考を推測し、そう尋ねる。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.012.jpeg","slideTitle":"第12スライド","title":"シーン 12","voiceDuration":7.475646258503401,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_十六夜咲夜.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"characterName":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"4BBA6333-302E-4976-A572-10464CE7AA72","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","telop":"「ええ…、霊夢さんです。」","voiceCharacter":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.013.jpeg","slideTitle":"第13スライド","title":"シーン 13","voiceDuration":1.3318820861678005,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"3E4BD409-B4B8-4278-AB7C-9D28870F4B3A","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"「そうですか…」\n僕は、予想通りの答えが返ってきたので、そう呟く。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.014.jpeg","slideTitle":"第14スライド","title":"シーン 14","voiceDuration":4.971292517006803,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"7C11642C-3AAB-4FF7-837A-AF23817C0AA5","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"「何か、飲み物を持ってきて、休憩にしますか？」","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.015.jpeg","slideTitle":"第15スライド","title":"シーン 15","voiceDuration":3.55172335600907,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_十六夜咲夜.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":3.5,"characterName":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"DA849F29-9774-4E3C-9042-5DA4C6DEF47E","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","telop":"「ええ、お願いします…」\n私は、彼の言葉に対して、手短に返す。","voiceCharacter":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.016.jpeg","slideTitle":"第16スライド","title":"シーン 16","voiceDuration":4.406190476190476,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","duration":4.7,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"C75848AA-0EFA-4721-B7CB-07C73B08DCAD","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"「わかりました、じゃあ、レミリアさんたちが、皆向こうで、寝ているので、少し待っててください。」","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.017.jpeg","slideTitle":"第17スライド","title":"シーン 17","voiceDuration":6.453900226757369,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","duration":3.5,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"2983C137-6FDB-4CB1-B54C-351F9BC60B7F","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"僕はそういうと、咲夜とすれ違い、食堂に向かう。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.018.jpeg","slideTitle":"第18スライド","title":"シーン 18","voiceDuration":3.6517233560090703,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","duration":5.7,"characterName":"操夢","backgroundName":"nc196979_食堂(昼).png","animationName":"なし","id":"4BD7F4F6-0803-4AB0-9DC5-EED279E72A28","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"僕は、そういうと、食堂にやってくる。そして、２つのコップを取り出して、紅茶を注ぎ込むと、コップを持ち、戻っていく。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.019.jpeg","slideTitle":"第19スライド","title":"シーン 19","voiceDuration":8.658253968253968,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","duration":3.5,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"6D159390-2940-4A48-9F42-3809E4AA1E23","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"僕が、図書館に戻ると、テーブルにコップを置き、咲夜を呼ぶ。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.020.jpeg","slideTitle":"第20スライド","title":"シーン 20","voiceDuration":4.30390022675737,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":5.4,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"81C656A2-DAE2-4B07-B266-6D2D0DF53591","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"「それで、ここ最近は彼女たちの様子はどうでしたか？」\n僕は、一瞬、寝ているレミリアたちに目を向けてから、いう。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.021.jpeg","slideTitle":"第21スライド","title":"シーン 21","voiceDuration":7.966938775510204,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_十六夜咲夜.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":4.6000000000000005,"characterName":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"8EBB6933-01E8-41B6-8E69-E687CD34B9E8","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","telop":"「ここ最近は、フラン様が、ご乱心になる回数や、その威力が、これまでより凄まじいものでして…」","voiceCharacter":"十六夜咲夜","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.022.jpeg","slideTitle":"第22スライド","title":"シーン 22","voiceDuration":5.908888888888889,"bgmName":"BGM: 東方妖恋談","transitionName":"クロスディゾルブ","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc77066_【背景素材】紅魔館大図書館.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","duration":3.5,"characterName":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.pxd","animationName":"なし","id":"690BB1E2-D339-477D-A6CA-8756A7A44C98","audioTrack":"track_voice_%E6%93%8D%E5%A4%A2","telop":"「何か、心当たりとかはありますか？」\n僕は、念の為に、彼女に尋ねる。","voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第12話_432572eca5\/第12話_432572eca5.023.jpeg","slideTitle":"