d\/(15）\/疑問顔.png","voiceDuration":8.166938775510204,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.033.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「フレラと一緒に、魔法の研究がしたいの。」","title":"シーン 34","slideTitle":"第34スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_フランドール・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/nc77066_【背景素材】紅魔館大図書館.jpg","id":"F4652738-1BB5-4C10-9507-7875B3A1F5BE","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/疑問顔.png","voiceDuration":4.576984126984127,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.034.jpeg","characterName":"フランドール・スカーレット","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「いいですよ。ただし…、夜咲さんを除いた3人には、破壊されたロビーの修繕作業、手伝ってもらいますからね。」","title":"シーン 35","slideTitle":"第35スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"AC34B57D-C4EC-4E0E-B15D-D2F3A4EE9755","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/疑問顔.png","voiceDuration":4.6278231292517,"bgmVolume":0.65,"duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.035.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕がそういうと、レミノアは口をあわあわさせ、フランとフレラは表情こそ笑ってるが、裏側に潜む感情が微かに透けていた。","title":"シーン 36","slideTitle":"第36スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"77B5CBFC-D9D5-4008-9576-E9DB20438179","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/笑う.png","voiceDuration":7.759342403628118,"bgmVolume":0.65,"duration":5.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.036.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「必要な費用の調達は、夜咲さんにお願いしますね…」\n僕がそう付け足すと、その場が気まずい空気に包まれた。","title":"シーン 37","slideTitle":"第37スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"DCD59FA7-265B-45C9-9281-2290F727BFFB","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/笑う.png","voiceDuration":6.756077097505669,"bgmVolume":0.65,"duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.037.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"それから、その場は解散になり、残った僕と彼女は、\n近くにあったソファに座り、無言の時間を過ごす。","title":"シーン 38","slideTitle":"第38スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"9730ECF1-36BA-46F2-8ECD-0E717214BC2C","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やれやれ.png","voiceDuration":3.6778231292517005,"bgmVolume":0.65,"duration":4.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.038.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"そして僕は、彼女にあることを告げる。","title":"シーン 39","slideTitle":"第39スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"7A9D714D-9624-45C4-8F7F-EC1E7A9AD0A9","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やれやれ.png","voiceDuration":8.882154195011339,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.039.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「それって、どういう…」\n私が、そう呟いていると、彼が立ち上がる。","title":"シーン 40","slideTitle":"第40スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_ナレーション.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"111D5435-CA75-4566-BBD2-2C8F713858CD","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":5.740249433106576,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.040.jpeg","characterName":"十六夜咲夜","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「それじゃあ、僕は、行ってきますね。」","title":"シーン 41","slideTitle":"第41スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"B44E70DF-954F-4AA4-8AA6-DE9E67E5904C","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":8.038684807256235,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.041.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「あっ、ちょっと…」\n私は、ふとハッとすると、彼がすでに外に向かって歩いていた。","title":"シーン 42","slideTitle":"第42スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_十六夜咲夜.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"4817606B-218E-4D38-9E41-14E244CC67B0","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/驚く.png","voiceDuration":6.8395918367346935,"bgmVolume":0.65,"duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.042.jpeg","characterName":"十六夜咲夜","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"そして、彼は一度だけ、振り返り、私の方に笑みを見せると、そのまま歩く速度を上げて、彼は屋敷を去っていった。","title":"シーン 43","slideTitle":"第43スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_レミリア・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"99F60AE2-51BE-4F86-8105-5169626384F4","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/驚く.png","voiceDuration":2.369229024943311,"bgmVolume":0.65,"duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.043.jpeg","characterName":"十六夜咲夜","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"あれから、ロビーの修繕が終わった頃には、幻想郷という言葉がフランから出てくることは、一回たりとも出てこなかった。","title":"シーン 44","slideTitle":"第44スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_十六夜咲夜.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"3011B989-7CA0-4637-A9C7-22219114A697","transitionName":"なし","voiceDuration":6.352993197278912,"bgmVolume":0.65,"duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.044.jpeg","characterName":"十六夜咲夜","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"そして、その言葉や、世界観はまるで、そもそもなかったように私たちは、この屋敷で、日々の生活を過ごしていくのだった。","title":"シーン 45","slideTitle":"第45スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_十六夜咲夜.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"62030F80-7C07-4D55-AF79-B61AE531B94C","transitionName":"なし","voiceDuration":5.313197278911565,"bgmVolume":0.65,"duration":5.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.045.jpeg","characterName":"十六夜咲夜","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"十六夜咲夜","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"この話で、東方操夢録から始まった繋がりのあるシリーズはすべて完結しました！もし、幻想入り系の新シリーズやリメイクが欲しい人は、教えてください！\n※概要欄に制作に使用しているソフトのリンクがあります。","title":"シーン 46","slideTitle":"第46スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"2E51BD33-A193-41A6-AF85-6E3E883D453F","transitionName":"なし","voiceDuration":8.221292517006802,"bgmVolume":0.65,"duration":5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.046.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"参考資料\n時間軸の流れ\n幻想入りシリーズ\n操夢録→→惑情録→幼き日の日常\n日常系シリーズ\n→交換夫婦→彷徨う二人\n※（）書きのものは未掲載のものです。\n※交換夫婦の一部設定は、元女子校の日常に引き継がれています。\n※未掲載シリーズが見たい人や、これまでのシリーズのリメイク版が見たい人、その他の要望などはコメントで教えてください。また、やる気があれば、短編系のシリーズの総集編を掲載予定です。今すぐに見たい人は、コメントで教えてください。","title":"シーン 47","slideTitle":"第47スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"9090C861-9BC7-458B-8418-6FD75A83E257","transitionName":"なし","voiceDuration":9.162607709750567,"bgmVolume":0.65,"duration":5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.047.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"","title":"ご視聴ありがとうございました！","slideTitle":"中扉","animationName":"なし","id":"D6ECB2DA-73DC-461C-A62E-FCC10CC15189","bgmVolume":0.65,"transitionName":"なし","duration":20,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.048.jpeg","characterName":"","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"単色背景"}]