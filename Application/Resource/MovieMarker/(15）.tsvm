Slide_020_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"A0722253-3925-4DC9-997D-6A04CE08288C","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":6.227823129251701,"bgmVolume":0.65,"duration":4.4,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.020.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「ええ、分かりました…」","title":"シーン 21","slideTitle":"第21スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"9DE0FA91-A171-4AFE-BE1F-2FCEC318342F","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":6.808253968253968,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.021.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕は、彼女がそういうと、彼女と共に図書館に移動する。","title":"シーン 22","slideTitle":"第22スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"CE1BE44D-4CCB-47DB-B2C9-4A2E5CE3CA37","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":8.434331065759638,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.022.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕が、図書館に移動してくると、この屋敷に住む3人とフランが一同を介した。僕は、一つ咳払いをしてあることを告げる。","title":"シーン 23","slideTitle":"第23スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"329083CF-8CF1-4960-904D-42FA945A59EA","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":7.508253968253968,"bgmVolume":0.65,"duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.023.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「今は、この図書館を管理できる人がいません。\n僕は、今日からこの図書館を管理する人を指名しますね。」","title":"シーン 24","slideTitle":"第24スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"96E37F91-3DF4-444C-BA0C-8A63CE8BFA67","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":6.453900226757369,"bgmVolume":0.65,"duration":4.9,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.024.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「この図書館の管理は…、フランさんにお願いできますか？」","title":"シーン 25","slideTitle":"第25スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"D22B6F9C-906A-4B43-8A15-171C283B5E1A","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り.png","voiceDuration":8.773469387755101,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.025.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「ねぇ…、それってどういうこと…？」","title":"シーン 26","slideTitle":"第26スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_レミリア・スカーレット.wav","animat