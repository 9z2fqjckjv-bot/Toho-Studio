[{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕は、あれから彼女の頭を撫で続けていていた。すると、ふと彼女の泣き声が聞こえなくなり、顔を見る。\n東方Project二次創作作品","title":"シーン 1","slideTitle":"第1スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢_2.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"CAF442FF-BADF-4162-9043-C2AFDB1E9111","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/影のみ.png","voiceDuration":2.8365079365079366,"bgmVolume":0.65,"duration":5.4,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.001.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"bgmStartTimeOffset":0,"voiceDuration":3.962607709750567,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困惑の寝顔.png","duration":5.800000000000001,"voiceStartTimeOffset":0,"seVolume":0.85,"slideTitle":"第2スライド","bgmName":"BGM: 東方妖恋談","characterName":"操夢","animationName":"なし","id":"B3C9015F-1451-40BC-A0D9-80E7A126F1EF","audioTrack":"track_voice_soumu","seStartTimeOffset":0.09999999999999964,"title":"シーン 2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","seName":"SE: スペルカード発動音","voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.002.jpeg","transitionName":"なし","backgroundName":"image12.png","voiceCharacter":"操夢","showTelopOverlay":false,"bgmVolume":0.65,"telop":"すると、影が消えて、彼女は涙がまだ残った状態で、そのまま寝ていた。僕は、そんな彼女をそっと抱えて、ベッドで横にする。\n作成者：zuyasi"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「パチュリーが、パチュリーが！」","title":"そして、僕が離れようとすると、彼女は僕の服をつかむ。僕は、そんな彼女の隣で横になると、眠くなり、そのまま目を瞑った。","slideTitle":"中扉","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"EABB7633-86BD-4EBD-BC05-2D0F1FADB9D6","transitionName":"なし","bgmVolume":0.65,"duration":3,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.003.jpeg","characterName":"レミリア・スカーレット","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"彷徨う二人　最終話","title":"制作ソフト及び協力（敬称略）\nGemini\nTohoStuido（Geminiで開発中…）\nPowered by zuyasi 東方Project二次創作作品","slideTitle":"タイトル","animationName":"なし","id":"5BF74A6E-8BDC-4259-BFE6-6581D7A80113","bgmVolume":0.65,"transitionName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.004.jpeg","characterName":"","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"単色背景"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕は、屋敷が揺れているような感覚で目が覚める。\nすると、ロビーの方から天井が崩壊する音が聞こえる。","title":"シーン 5","slideTitle":"第5スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"49E80B81-D789-46C3-982D-46903FE4B508","transitionName":"なし","voiceDuration":8.189773242630386,"bgmVolume":0.65,"duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.005.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕が、ロビーの方にやってくると、そこには凄惨な光景が広がっていた。そして、シャンデリアの近くに人がいることに気づく。","title":"シーン 6","slideTitle":"第6スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"EA3506B7-26A5-4C08-B174-EAE498F33C65","transitionName":"なし","voiceDuration":6.60172335600907,"bgmVolume":0.65,"duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.006.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"そこには、寝起きの状態のフラン、フレラ、レミノアの3人がいた。「目が覚めましたか、お三方とも？」","title":"シーン 7","slideTitle":"第7スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"539856F3-9E31-4433-8F0F-A3EBAF5F624B","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられ寝起き.png","voiceDuration":6.865850340136054,"bgmVolume":0.65,"duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.007.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「ねぇ、私たちが何してか覚えてる？」私はそう彼に聞く。","title":"シーン 8","slideTitle":"第8スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"602CAB76-027A-4B06-A151-D6840F4632AB","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられフラン寝起き.png","voiceDuration":7.914489795918367,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.008.jpeg","characterName":"フランドール・スカーレット","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕は、フランからのその問いにこう答える。「あなたたちが、ここで激闘を繰り広げて、その爆発音が響いてましたよ…。」","title":"シーン 9","slideTitle":"第9スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"6E7BA6A0-E4B1-4914-8622-9BE535438A40","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられ寝起き.png","voiceDuration":7.373469387755102,"bgmVolume":0.65,"duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.009.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「そう…」私がそう呟いていると、ごろごろと音が鳴る。","title":"シーン 10","slideTitle":"第10スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_フランドール・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"9F9AC2D4-0CC2-429E-A700-6D3475F601DD","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられフラン寝起き.png","voiceDuration":4.119478458049887,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.010.jpeg","characterName":"フランドール・スカーレット","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「フランさん、レミノアさんを抱えて、この場所から離れましょう、僕はフレラさんを抱えて、運び出すので。」","title":"シーン 11","slideTitle":"第11スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"C08D23AF-4C0F-4291-BB83-6606393A617B","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられ寝起き.png","voiceDuration":6.547369614512472,"bgmVolume":0.65,"duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.011.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「うん…わかった…」","title":"シーン 12","slideTitle":"第12スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_フランドール・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"E0A94EDC-B038-4B5D-BDBC-E508904FF96C","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられフラン寝起き.png","voiceDuration":7.101995464852608,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.012.jpeg","characterName":"フランドール・スカーレット","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"僕は、ぼーっとしているフレラを抱えると、レミノアを抱えたフランと共に、さっきまでいた部屋に、退避を始めた。","title":"シーン 13","slideTitle":"第13スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"ECABD5A1-DD4A-4D03-B4DF-D93E30CEAE8A","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/やられ寝起き.png","voiceDuration":2.773469387755102,"bgmVolume":0.65,"duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.013.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"それから…","title":"シーン 14","slideTitle":"第14スライド","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image64.jpeg","id":"CB9F8C4E-9BC9-4B9B-B7CE-1A161ADEBD88","transitionName":"なし","bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.014.jpeg","characterName":"ナレーション","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"backgroundName":"image64.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"それから僕たちが退避をすると、ごろごろとロビーから形をまだ残していた壁や天井が完全に崩壊してしまった。","title":"シーン 15","slideTitle":"第15スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"64949CD7-4120-4DF1-94DD-41B3B077C716","transitionName":"なし","voiceDuration":7.919115646258503,"bgmVolume":0.65,"duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.015.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"そして、雨が降り始め、フランたちは皆、\n雨に当たるのを避けて、図書館へとそのまま移動していった。","title":"シーン 16","slideTitle":"第16スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"5E7578D6-B2D8-4C04-8C75-B76D391A550C","transitionName":"なし","voiceDuration":7.249546485260771,"bgmVolume":0.65,"duration":4.7,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.016.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"そして、外ではごろごろと雷が鳴り始め、僕は、\nとりあえずこの部屋で、彼女の目が覚めるのを待っていた。","title":"シーン 17","slideTitle":"第17スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/image12.png","id":"8D8DA747-2DC7-47C0-BC5B-FD67284B7BD2","transitionName":"なし","voiceDuration":4.697369614512471,"bgmVolume":0.65,"duration":4.9,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.017.jpeg","characterName":"操夢","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"操夢","backgroundName":"image12.png"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"すると、彼女の目が覚める。","title":"シーン 