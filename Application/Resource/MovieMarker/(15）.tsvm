よ！」","title":"シーン 28","slideTitle":"第28スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_フランドール・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"1C555BA4-4B44-45E6-8A5D-82B1ADAA16D3","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/フラン（驚く）.png","voiceDuration":4.415736961451247,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(15）_a51a9cd665.028.jpeg","characterName":"フランドール・スカーレット","voiceStartTimeOffset":0,"showTelopOverlay":false,"seStartTimeOffset":0,"seVolume":1,"voiceCharacter":"フランドール・スカーレット","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpeg"},{"voice2StartTimeOffset":0,"bgmStartTimeOffset":0,"telop":"「私が、この屋敷に居座って、図書館の管理するの？」","title":"シーン 29","slideTitle":"第29スライド","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_フランドール・スカーレット.wav","animationName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(14）\/nc77066_【背景素材】紅魔館大図書館.jpeg","id":"F93C7139-034D-4CFA-8276-756382CFD7BC","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/(15）\/困り顔小口開け.png","voiceDuration":3.246984126984127,"bgmVolume":0.65,"duration":3.5,"bgmName":"BGM: 東方妖恋談","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/(15）_a51a9cd665\/(1