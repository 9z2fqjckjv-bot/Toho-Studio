/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.064.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「それじゃあ、いただっきまーす！」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_フランドール・スカーレット.wav","voiceDuration":2.234489795918367,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","id":"97DDB1F0-CF9B-446A-9C4D-DBF6B1C39580","voiceCharacter":"フランドール・スカーレット","title":"シーン 65","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第65スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.065.jpeg","characterName":"フランドール・スカーレット"},{"audioTrack":"track_voice_soumu","telop":"彼女はそういうと、僕に噛みつき、血を吸い取っていく。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","voiceDuration":3.55172335600907,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"7C8BC7BE-BFC4-4F2A-9D67-86F10BDFE69F","voiceCharacter":"操夢","title":"シーン 66","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第66スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.066.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"私は、彼の血を吸い始めると、今までになかった独特な感覚に襲われていき、何かが変わっていく気がする。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_フランドール・スカーレット.wav","voiceDuration":8.556984126984126,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":4.9,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","id":"99B7E18A-A155-46B1-8912-4B5A74FAB7A6","voiceCharacter":"フランドール・スカーレット","title":"シーン 67","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第67スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.067.jpeg","characterName":"フランドール・スカーレット"},{"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"私は、彼女が豹変していくのがわかると、\nその間の隙をつき、彼女の首に、腕を勢いよくぶつける。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_フランドール・スカーレット.wav","voiceDuration":8.331995464852607,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":4.6000000000000005,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","id":"AD9B0A1F-832C-4AD5-A576-C269B3A70E5E","voiceCharacter":"フランドール・スカーレット","title":"シーン 68","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第68スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.068.jpeg","characterName":"フランドール・スカーレット"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「私の妹が、あなたにご迷惑かけたようで申し訳ありません。」\n私は、そう彼女に返す。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_レミリア・スカーレット.wav","voiceDuration":6.465079365079365,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":4,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","id":"7BBAD625-FB46-4131-ADB7-D2428F146449","voiceCharacter":"レミリア・スカーレット","title":"シーン 69","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第69スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.069.jpeg","characterName":"レミリア・スカーレット"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「いえいえ、迷惑ではありませんよ、彼女が暴走する前に、食い止めることができましたから。それで、あなたたちの名前は…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_レミリア・スカーレット.wav","voiceDuration":7.998412698412698,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":5.800000000000001,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","id":"B41943E2-CE6C-4EAE-BB53-C3608CCD4F97","voiceCharacter":"レミリア・スカーレット","title":"シーン 70","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第70スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.070.jpeg","characterName":"レミリア・スカーレット"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「私の名前は、レミリア・スカーレット、その妹の名前はフランドール・スカーレットと言います。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_レミリア・スカーレット.wav","voiceDuration":5.574897959183674,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":4.6000000000000005,"id":"089B8880-02A2-45AB-9BD0-5798F30C4FD5","voiceCharacter":"レミリア・スカーレット","title":"シーン 71","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第71スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.071.jpeg","characterName":"レミリア・スカーレット"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「ご存知かもしれませんが、彼女は建物を一言で破壊できる才の持ち主で、私たちは紅魔建設を営んでいます。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_レミリア・スカーレット.wav","voiceDuration":7.690068027210884,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":5.1000000000000005,"id":"97507892-8C04-432B-9870-AE8095C08046","voiceCharacter":"レミリア・スカーレット","title":"シーン 72","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第72スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.072.jpeg","characterName":"レミリア・スカーレット"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「ただし…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_レミリア・スカーレット.wav","voiceDuration":1.5,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"34FBAE84-5FEE-4A7C-8D96-A99C7B2A04DB","voiceCharacter":"レミリア・スカーレット","title":"シーン 73","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第73スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.073.jpeg","characterName":"レミリア・スカーレット"},{"voiceCharacter":"ナレーション","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","animationName":"なし","transitionName":"なし","telop":"「お二人さんは吸血鬼で、時折妹さんが暴走するっという感じですか。それで、この学園の卒業生ですか？」","title":"シーン 74","bgmName":"BGM: 少女綺想曲","duration":4.9,"slideTitle":"第74スライド","id":"5C96E487-1AD0-456D-90E7-24995B05D9AD","characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.074.jpeg"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「ええ、よくご存知で。あなたのいうとおり私たちは、吸血鬼で、その詳細は公ではありませんの。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_レミリア・スカーレット.wav","voiceDuration":6.8192290249433105,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":4.6000000000000005,"id":"76A0C94A-8F72-4CF3-8311-A594EA5DB7C4","voiceCharacter":"レミリア・スカーレット","title":"シーン 75","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第75スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.075.jpeg","characterName":"レミリア・スカーレット"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「それで…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_レミリア・スカーレット.wav","voiceDuration":1.5,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"35BCC778-B784-4D9B-9266-42B307C20209","voiceCharacter":"レミリア・スカーレット","title":"シーン 76","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第76スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.076.jpeg","characterName":"レミリア・スカーレット"},{"voiceCharacter":"ナレーション","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","animationName":"なし","transitionName":"なし","telop":"「秘密保持契約で、口外は厳禁って言ったところですか？」","title":"シーン 77","bgmName":"BGM: 少女綺想曲","duration":3.5,"slideTitle":"第77スライド","id":"4506E6FA-D9C8-479D-B241-60230C65D3B4","characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.077.jpeg"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「ええ、今この場で、口頭による契約成立とみなしていただき、今後、この事実が口外控えていただけますか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_レミリア・スカーレット.wav","voiceDuration":7.3546485260770975,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":5.1000000000000005,"id":"FCE0CE0B-4C3A-4178-A3E7-E81AD9AA6307","voiceCharacter":"レミリア・スカーレット","title":"シーン 78","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第78スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.078.jpeg","characterName":"レミリア・スカーレット"},{"voiceCharacter":"ナレーション","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","animationName":"なし","transitionName":"なし","telop":"「承知しました、それで、この学園に来たのは、単純な深夜徘徊ではありませんよね。妹さんが入口を破壊してるだろうし…」","title":"シーン 79","bgmName":"BGM: 少女綺想曲","duration":5.7,"slideTitle":"第79スライド","id":"C6AF8AF5-34A0-4404-80FE-02BAE53E813A","characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.079.jpeg"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「ええ、これから、私は、妹が破壊した入口を修復するための手筈を取る予定です。それで、あなたはどうしますか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_レミリア・スカーレット.wav","voiceDuration":8.10673469387755,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":5.4,"id":"3C01AE2B-E61A-4E65-A31A-C3EB1341FD9F","voiceCharacter":"レミリア・スカーレット","title":"シーン 80","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第80スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.080.jpeg","characterName":"レミリア・スカーレット"},{"voiceCharacter":"ナレーション","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","animationName":"なし","transitionName":"なし","telop":"「そのついでに、食事の用意もできないでしょうか、私、今日、\nいや昨日のお昼から、何も食べてないんです。」","title":"シーン 81","bgmName":"BGM: 少女綺想曲","duration":5.2,"slideTitle":"第81スライド","id":"79352B20-C481-4F50-8C50-8F39FEA43C11","characterName":"ナレーション","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.081.jpeg"},{"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「分かりました、それくらいはお安いご用です。では、私と一緒に、その妹を抱えてきていただけますでしょうか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_レミリア・スカーレット.wav","voiceDuration":7.4858956916099775,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":5.300000000000001,"id":"30EDBAA7-84B6-4986-83AA-9DB89E3966DD","voiceCharacter":"レミリア・スカーレット","title":"シーン 82","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第82スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.082.jpeg","characterName":"レミリア・スカーレット"},{"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「ええ分かりました。」\n私はそういうと、フランを抱え、レミリアについていった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_フランドール・スカーレット.wav","voiceDuration":5.953242630385487,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.9000000000000004,"id":"1BD0A8E0-2C93-4BF1-A5BC-2D7C6B2D3982","voiceCharacter":"フランドール・スカーレット","title":"シーン 83","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第83スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.083.jpeg","characterName":"フランドール・スカーレット"},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～.wav","telop":"","transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":15,"id":"D9BA414E-4B6D-43A5-B411-483C874AA280","voiceCharacter":"","title":"ご視聴ありがとうございました！","backgroundName":"単色背景","slideTitle":"中扉","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.084.jpeg","characterName":"","seName":"SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～"}]