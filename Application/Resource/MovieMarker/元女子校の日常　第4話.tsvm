[{"audioTrack":"track_voice_soumu","telop":"「ん…」僕はふと目が覚めると、\n朝日が登り、窓から日光が差し込んでいた。\n東方Project二次創作作品","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","voiceDuration":5.186507936507937,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"65B8F0F4-DB56-45FC-874C-5B037B116B8D","voiceCharacter":"操夢","title":"シーン 1","backgroundName":"nc256896_病室-昼.png","slideTitle":"第1スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.001.jpeg","characterName":"操夢"},{"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/木のドアをノック1.mp3","audioTrack":"track_voice_soumu","telop":"そして、僕は大きく背伸びしてあくびをすると、誰かが部屋の戸を叩く。「入ってきて大丈夫ですよ。」僕はそう返す。\n作成者：zuyasi","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","voiceDuration":8.0756462585034,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":5.4,"id":"52484A49-4E1A-4E29-88A3-2A5D11C74DA6","voiceCharacter":"操夢","title":"シーン 2","backgroundName":"nc256896_病室-昼.png","slideTitle":"第2スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.002.jpeg","characterName":"操夢","seName":"SE: 木のドアをノック1"},{"voiceCharacter":"因幡てゐ","backgroundName":"nc256896_病室-昼.png","animationName":"なし","transitionName":"なし","telop":"","title":"「今朝は、よく眠れましたか、紅夢さん。？」","bgmName":"BGM: 少女綺想曲","duration":3,"slideTitle":"中扉","id":"C2440AF9-5207-4C9C-B5D0-1880DB315239","characterName":"因幡てゐ","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.003.jpeg"},{"audioTrack":"track_voice_soumu","telop":"「はい。それで、これから検査…ですか？」\n制作ソフト及び協力\nGemini\nTohoStuido","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","voiceDuration":3.190861678004535,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"C76A5CD7-59DC-4BA3-A678-8904C6C6E0E3","voiceCharacter":"操夢","title":"シーン 4","backgroundName":"nc256896_病室-昼.png","slideTitle":"第4スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.004.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_%E3%81%A6%E3%82%90","telop":"「ええ、それでは、検査室に案内しますね。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_てゐ.wav","voiceDuration":2.711655328798186,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"4172D9FE-42C9-4A4C-A686-766980613EDC","voiceCharacter":"てゐ","title":"シーン 5","backgroundName":"nc256896_病室-昼.png","slideTitle":"第5スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.005.jpeg","characterName":"因幡てゐ"},{"audioTrack":"track_voice_soumu","telop":"「わかりました。」\n僕はそういうと、ベッドからおり、検査室に向かっていった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","voiceDuration":5.237596371882086,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.7,"id":"B8336336-6B6B-4381-8126-61FA2FD8CFD0","voiceCharacter":"操夢","title":"シーン 6","backgroundName":"nc256896_病室-昼.png","slideTitle":"第6スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.006.jpeg","characterName":"操夢"},{"telop":"元女子校の日常","transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":15,"id":"ED655036-FFA0-4313-83ED-B6A77E4AAB15","voiceCharacter":"","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/元女子校の日常　第4話_8f5db7d82a\/slide_007_anim.m4v","backgroundName":"単色背景","title":"東方Project二次創作作品　Powerd By zuyasi","slideTitle":"タイトル","animationName":"バウンス","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.007.jpeg","characterName":""},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕は、それから検査を終えると、\nお昼休憩のタイミングで教室に入る。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","transitionName":"なし","voiceDuration":4.758253968253968,"duration":3.5,"bgmName":"BGM: 少女綺想曲","id":"FDF51962-8E3B-4C68-A117-A6D6CFEFCE2C","voiceCharacter":"操夢","title":"シーン 8","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第8スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.008.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「なぜ、お昼時になってあなたが来るのですか…？」\n私は、彼が来たことに驚き、そう聞く。","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_009_古明地さとり.wav","transitionName":"なし","voiceDuration":5.203786848072562,"duration":4.3,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","id":"D42E0AA6-F5CA-4D8A-969F-AFF78B7B0E31","voiceCharacter":"古明地さとり","title":"シーン 9","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第9スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.009.jpeg","characterName":"古明地さとり"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"「昨日、校庭で3000m走ったら、バタって倒れて、さっきまで…」僕がそう言っていると、突如放送が入る。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","transitionName":"なし","voiceDuration":8.016938775510203,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","id":"D5FC8E10-524A-42F1-A75E-78310212C4B3","voiceCharacter":"操夢","title":"シーン 10","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第10スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.010.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E8%90%83%E9%A6%99","telop":"「全校生徒及び児童に次ぐ、本日、５限から７限までは、\nグラウンドで全クラス合同のエンドレスランを行う…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_萃香.wav","transitionName":"なし","voiceDuration":5.841315192743764,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","id":"E596AB9F-DDD5-40AE-9C52-F5B0256F2DAF","voiceCharacter":"萃香","title":"シーン 11","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第11スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.011.jpeg","characterName":"萃香"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「どうやら、あまり話している余裕はなさそうですね…、ささっと昼食とって校庭に出たほうがいいですよ。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_古明地さとり.wav","transitionName":"なし","voiceDuration":5.220589569160998,"duration":5,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","id":"9F704BF9-E2F0-4A54-B425-7E207FD62133","voiceCharacter":"古明地さとり","title":"シーン 12","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第12スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.012.jpeg","characterName":"古明地さとり"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"彼女がそう呟き、数分で放送は終わり、周りが、急ぎ始める。\n僕は、そこで、今日のお弁当がないことを思い出す。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","transitionName":"なし","voiceDuration":8.684331065759638,"duration":5.2,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","id":"F9137214-FA70-4D95-AD2C-CC73745A6F33","voiceCharacter":"操夢","title":"シーン 13","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第13スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.013.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕はそこで、彼女に学食はあるか聞こうとしたが、すでにそこにはいなかった。僕は仕方がなく、教室を出る。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","transitionName":"なし","voiceDuration":7.694126984126984,"duration":5,"bgmName":"BGM: 少女綺想曲","id":"EF7BA836-88BF-4C04-81C5-F7E204355F78","voiceCharacter":"操夢","title":"シーン 14","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第14スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.014.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"そして、校庭に来ると、大勢の女子たちが、グラウンドで動き回っていた。すると、ある女子と体がぶつかる。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","transitionName":"なし","voiceDuration":7.612607709750567,"duration":5,"bgmName":"BGM: 少女綺想曲","id":"C9EE536B-1868-42BD-8594-20FCFC54DFC5","voiceCharacter":"操夢","title":"シーン 15","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第15スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.015.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"「あの、大丈夫ですか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_古明地こいし.wav","transitionName":"なし","voiceDuration":1.5,"duration":3.5,"bgmName":"BGM: 少女綺想曲","id":"26AC0894-6AEC-465D-BC5D-46186ACF2648","voiceCharacter":"古明地こいし","title":"シーン 16","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第16スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.016.jpeg","characterName":"古明地こいし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"「大丈夫ですけど…あなたは…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","transitionName":"なし","voiceDuration":2.066938775510204,"duration":3.5,"bgmName":"BGM: 少女綺想曲","id":"2CFD582B-0635-4052-81F4-A793C7BAF1E4","voiceCharacter":"操夢","title":"シーン 17","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第17スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.017.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"「私は、Kー3組の古明地こいしです。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_古明地こいし.wav","transitionName":"なし","voiceDuration":1.9292743764172335,"duration":3.5,"bgmName":"BGM: 少女綺想曲","id":"1BC17567-955B-4974-9073-194FA166BD94","voiceCharacter":"古明地こいし","title":"シーン 18","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第18スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.018.jpeg","characterName":"古明地こいし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"「えっと僕は…藤原紅夢です…」\n僕がそう言っていると、どこからか声がする。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","transitionName":"なし","voiceDuration":5.360430839002268,"duration":4,"bgmName":"BGM: 少女綺想曲","id":"75CC55EA-BF50-47FA-861F-D2393B86A3B9","voiceCharacter":"操夢","title":"シーン 19","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第19スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.019.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「ほら、そこの二人、ささっと準備体操済ませて、スタートラインに立ちなさい。もうすぐ始まりますから。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_美鈴.wav","transitionName":"なし","voiceDuration":4.838616780045352,"duration":5,"bgmName":"BGM: 少女綺想曲","id":"C58FE84B-CD19-49B8-AB9C-049A37007D8C","voiceCharacter":"美鈴","title":"シーン 20","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第20スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.020.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕とこいしは、彼女にそう言われ、\n準備体操をすると、スタートラインに向かうのだった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","transitionName":"なし","voiceDuration":5.360430839002268,"duration":4.1000000000000005,"bgmName":"BGM: 少女綺想曲","id":"C3230B75-4DBE-4CC7-A010-6270F1CDA934","voiceCharacter":"操夢","title":"シーン 21","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第21スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.021.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"二人がスタートラインに立つと…","transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3,"id":"06550D93-64B5-41CA-B7E5-322BA826FB64","voiceCharacter":"ナレーション","title":"シーン 22","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第22スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.022.jpeg","characterName":"ナレーション"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"それから、僕たちがスタートラインに立ってしばらくすると、さっきの放送で話していた人物から、内容が話された。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","transitionName":"なし","voiceDuration":7.532154195011338,"duration":5.300000000000001,"bgmName":"BGM: 少女綺想曲","id":"965990DC-DC29-474D-A993-9BFF5D5F028F","voiceCharacter":"操夢","title":"シーン 23","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第23スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.023.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"エンドレスランのルールは一言で言えば、その場に倒れるまで走り続ける、または歩き続ける無限長距離走らしい。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","transitionName":"なし","voiceDuration":7.147369614512471,"duration":5.2,"bgmName":"BGM: 少女綺想曲","id":"EB272B41-416F-4621-A816-26E04AB16F5A","voiceCharacter":"操夢","title":"シーン 24","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第24スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.024.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕は、病み上がりの体に負担がかからないか心配だった。\nすると、昨日僕が倒れるまで走らせた彼女が来る。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","transitionName":"なし","voiceDuration":7.624557823129252,"duration":4.9,"bgmName":"BGM: 少女綺想曲","id":"34F71B95-568D-4B01-8C87-CE6E77048F97","voiceCharacter":"操夢","title":"シーン 25","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第25スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.025.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「藤原さんは初めてのエンドレスランで、こいしさんと同等程度の体力ですから、二人のペースを合わせて走りましょうか。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_美鈴.wav","transitionName":"なし","voiceDuration":5.0882086167800455,"duration":5.7,"bgmName":"BGM: 少女綺想曲","id":"F180E637-B1C0-48DC-8E0D-39F1F82A1326","voiceCharacter":"美鈴","title":"シーン 26","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第26スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.026.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「お二人さんのペースは、きっと最後尾になりますから、私がお二人さんの後ろを走る形でサポートしましょう。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_美鈴.wav","transitionName":"なし","voiceDuration":4.789183673469387,"duration":5.2,"bgmName":"BGM: 少女綺想曲","id":"36AAA825-9E9C-4D97-8F94-C425B5E9B727","voiceCharacter":"美鈴","title":"シーン 27","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第27スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.027.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「ですが、だからと言って気を抜いたり、だらけたら体を叩きますから、走る力が尽きても、歩いて前に進んでくださいね。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_美鈴.wav","transitionName":"なし","voiceDuration":5.486439909297052,"duration":5.7,"bgmName":"BGM: 少女綺想曲","id":"EAD0B1B6-B050-4F71-B4BD-30C264A29F96","voiceCharacter":"美鈴","title":"シーン 28","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第28スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.028.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕はふと、彼女にそう言われ、こいしの方を見る。\n彼女は苦笑いを浮かべていた。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","transitionName":"なし","voiceDuration":5.4865079365079366,"duration":3.7,"bgmName":"BGM: 少女綺想曲","id":"B589D6A9-98F0-4CA1-A248-C7ACED680C79","voiceCharacter":"操夢","title":"シーン 29","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第29スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.029.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"だが、僕たちを置き去りにするように、開始の合図である笛が鳴り響くと、ゾロゾロと女子の大群が動き、僕たちも動き始めた。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","transitionName":"なし","voiceDuration":8.512607709750567,"duration":5.800000000000001,"bgmName":"BGM: 少女綺想曲","id":"8AC7707D-3F01-4E7B-B0AF-E15041D64E2C","voiceCharacter":"操夢","title":"シーン 30","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第30スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.030.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"そして、僕たちが走り始めて、数分経つと、ぞろぞろと、前方の大群が校門を抜けて、複数の方向に分散していく。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","transitionName":"なし","voiceDuration":8.725646258503401,"duration":5.2,"bgmName":"BGM: 少女綺想曲","id":"4FF962ED-9967-4443-974B-BECAE14FD3D9","voiceCharacter":"操夢","title":"シーン 31","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第31スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.031.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「校門をでたら、右に曲がって、進んでください。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_美鈴.wav","transitionName":"なし","voiceDuration":2.3236281179138323,"duration":3.5,"bgmName":"BGM: 少女綺想曲","id":"E413730F-8F25-45E5-9599-954F912DFEB5","voiceCharacter":"美鈴","title":"シーン 32","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第32スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.032.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕たちは、それから、1kmくらい走ると、住宅街に入り、その中を進んでいた。だが、こいしと僕は走り続けるのに限界が来る…","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","transitionName":"なし","voiceDuration":10.062607709750568,"duration":5.9,"bgmName":"BGM: 少女綺想曲","id":"DFAB528A-B73B-4C98-B421-830831FDBFCF","voiceCharacter":"操夢","title":"シーン 33","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第33スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.033.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕がふと、隣を見ると、汗ばむ彼女の姿があった。ふと足を見ると、彼女も走り続けるのには限界が来ているようだった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","transitionName":"なし","voiceDuration":8.719115646258503,"duration":5.5,"bgmName":"BGM: 少女綺想曲","id":"11C19EEF-22A5-4B89-ADE4-D61EC796E40D","voiceCharacter":"操夢","title":"シーン 34","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第34スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.034.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「走り続けるのが厳しいなら、歩いても構いませんから、止まってないで前にすすまないと、学校に戻るときには夜中ですよ。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_美鈴.wav","transitionName":"なし","voiceDuration":5.505804988662131,"duration":5.800000000000001,"bgmName":"BGM: 少女綺想曲","id":"41066D77-ED8C-4E09-8830-E01E003E0DFC","voiceCharacter":"美鈴","title":"シーン 35","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第35スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.035.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"私がそういうと、二人は走るのを諦め、歩き始める。\n「また、走れるようになったら走ってもらいますからね。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_美鈴.wav","transitionName":"なし","voiceDuration":5.043786848072562,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","id":"7A660206-D505-4ADF-8AFE-808A3CD0F07F","voiceCharacter":"美鈴","title":"シーン 36","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第36スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.036.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"「わかってますよ…それくらい…」\n僕はそう言いながら、再び、こいしの方を見る。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","transitionName":"なし","voiceDuration":5.390861678004535,"duration":3.8000000000000003,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","id":"8BAB44E1-B382-4296-8FC8-71F18750D45E","voiceCharacter":"操夢","title":"シーン 37","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第37スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.037.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"彼女は、細かく息を吐きながら、歩き続ける。僕は、ふと僕の歩くペースと彼女のペースのずれに気づき、少し遅く歩く。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","transitionName":"なし","voiceDuration":8.832154195011338,"duration":5.5,"bgmName":"BGM: 少女綺想曲","id":"6EEFF432-6F64-4B32-A7A6-D413BF215C13","voiceCharacter":"操夢","title":"シーン 38","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第38スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.038.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕も、彼女と同様に息を細かく吐いていたことに気づき、深く息をすると、早歩き寄りの速度で再び走り始める。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","transitionName":"なし","voiceDuration":8.03,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","id":"17985755-956E-4E6C-BA91-68097E7DDDBF","voiceCharacter":"操夢","title":"シーン 39","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第39スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.039.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"私は、いきなり走り始めた彼に、待ってと言い、そのまま手を出す。すると、次の瞬間、彼と私の手が触れ合う。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_古明地こいし.wav","transitionName":"なし","voiceDuration":5.375396825396826,"duration":5.1000000000000005,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","id":"A84CA0CE-063E-4522-9B6A-7908983318EF","voiceCharacter":"古明地こいし","title":"シーン 40","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第40スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.040.jpeg","characterName":"古明地こいし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕はふと、手に何かが当たり、ふと視線をこいしに移すと、彼女が頰てっていた。「どうしたんですか、こいしさん？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","transitionName":"なし","voiceDuration":7.412607709750567,"duration":5.4,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","id":"220DAA1F-0619-417A-8BF9-605D89807317","voiceCharacter":"操夢","title":"シーン 41","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第41スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.041.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"「いえ、なんでもありません、とりあえず、走りましょう。」\n私は、緊張して、そう口走り、走り始める。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_古明地こいし.wav","transitionName":"なし","voiceDuration":4.936167800453514,"duration":4.800000000000001,"bgmName":"BGM: 少女綺想曲","id":"0E5A476D-949C-474D-A680-156BB4D055B7","voiceCharacter":"古明地こいし","title":"シーン 42","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第42スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.042.jpeg","characterName":"古明地こいし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"「そうですか。」僕はそう返し、呼吸を整えながら、ペースを彼女に合わせてあげていく。するとペースが少し上がっていく。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","transitionName":"なし","voiceDuration":8.316938775510204,"duration":5.7,"bgmName":"BGM: 少女綺想曲","id":"6A5C341E-D215-418C-AFEB-A7192D096E95","voiceCharacter":"操夢","title":"シーン 43","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第43スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.043.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕たちはそれから、さらに1kmほど走ると、息が再び荒くなり、走りから歩きに変わってしまう。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","transitionName":"なし","voiceDuration":7.069115646258504,"duration":4.5,"bgmName":"BGM: 少女綺想曲","id":"9B991BA8-696C-47F5-82CB-A5937DF71617","voiceCharacter":"操夢","title":"シーン 44","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第44スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.044.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"私は、二人のペースがあまりにも遅いので、本当にこのペースで学校に戻れるのだろうかと、不安を感じてしまう。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_美鈴.wav","transitionName":"なし","voiceDuration":5.0272562358276645,"duration":5.2,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","id":"5E352432-7351-41F1-A7A5-E8A7BB784724","voiceCharacter":"美鈴","title":"シーン 45","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第45スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.045.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"私は、息をぜぇぜぇ吐きながら、歩いていると、足元にあるに何かにつまづいてしまう。「あっ！」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_古明地こいし.wav","transitionName":"なし","voiceDuration":4.144739229024943,"duration":4.5,"bgmName":"BGM: 少女綺想曲","id":"F92417C2-C6C4-40DC-A6E8-816FC6C66A48","voiceCharacter":"古明地こいし","title":"シーン 46","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第46スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.046.jpeg","characterName":"古明地こいし"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕は、彼女が地面に倒れ込みかけると、腕をだし、彼女を抱え込む。すると、彼女が驚き、僕も恥ずかしくなり、頬照っていく。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","transitionName":"なし","voiceDuration":9.623469387755103,"duration":5.800000000000001,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","id":"9ECD1E84-ADDA-458D-8A85-5841757A0D1A","voiceCharacter":"操夢","title":"シーン 47","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第47スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.047.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕は、こいしをお姫様抱っこしたまま、後ろにいる彼女に目線を送る。「どうすればいいですか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","transitionName":"なし","voiceDuration":6.275646258503401,"duration":4.5,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（驚く）.png","id":"5E348BF1-5CB4-4424-B5E0-64CFB7C85772","voiceCharacter":"操夢","title":"シーン 48","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第48スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.048.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「もし、あなたが彼女を抱いたまま、前に進めば、特別に、二人とも完走したことにしましょう、それでいいですか？」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_美鈴.wav","transitionName":"なし","voiceDuration":5.305963718820862,"duration":5.4,"bgmName":"BGM: 少女綺想曲","id":"FC93E7E5-2498-4B88-BA52-EF6CE4856594","voiceCharacter":"美鈴","title":"シーン 49","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第49スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.049.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"私がそう、彼に抱き抱えられている彼女に視線を送る。すると、彼女は、目を閉じ、微かに頷いた。「早く進んでください。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_美鈴.wav","transitionName":"なし","voiceDuration":6.21530612244898,"duration":5.7,"bgmName":"BGM: 少女綺想曲","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","id":"ED875CE4-BF8B-488D-92C2-D2D579B371CC","voiceCharacter":"美鈴","title":"シーン 50","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第50スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.050.jpeg","characterName":"美鈴"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕に抱っこされたこいしを見ると、恥ずかしいそうに身を丸くしていた。僕は、前を向き、再び走り始めた。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","transitionName":"なし","voiceDuration":7.48,"duration":4.9,"bgmName":"BGM: 少女綺想曲","id":"638ACAD2-8990-420A-8518-AF314BD91610","voiceCharacter":"操夢","title":"シーン 51","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第51スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.051.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"そして、時間が過ぎていき…","transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3,"id":"51F4F5B3-BE2D-43BC-9565-90AAF05B5DE9","voiceCharacter":"ナレーション","title":"シーン 52","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第52スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.052.jpeg","characterName":"ナレーション"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"僕はふと目が覚めると、そこは学校の保健室だった。僕は、ゆっくりとベッドから降りると、隣に人が寝てることに気づく。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","transitionName":"なし","voiceDuration":8.496303854875283,"duration":5.6000000000000005,"bgmName":"BGM: 少女綺想曲","id":"920645D6-A4F1-43C8-9FE6-79F8886BC325","voiceCharacter":"操夢","title":"シーン 53","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第53スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.053.jpeg","characterName":"操夢"},{"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","telop":"彼女は、恥ずかしいそうな表情の状態で寝ていた。\n僕は、彼女を起こさないようにそっと保健室を出る。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","transitionName":"なし","voiceDuration":7.064761904761904,"duration":4.7,"bgmName":"BGM: 少女綺想曲","id":"C64BE3D2-B059-4B02-9F58-A9AE6784CBFA","voiceCharacter":"操夢","title":"シーン 54","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第54スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.054.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_soumu","telop":"そして、廊下に出ると、ふとお腹が空き、何かご飯はないかを考えながら、歩を進めていく。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","voiceDuration":6.288684807256236,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":4.2,"id":"A904F456-D7B5-4AEF-BF26-E09FF55879E1","voiceCharacter":"操夢","title":"シーン 55","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第55スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.055.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_soumu","telop":"すると、ふと誰かが向こうからやってくる。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","voiceDuration":2.569115646258503,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"id":"C23403C6-C9B6-432F-A5DD-69905EADBAF6","voiceCharacter":"操夢","title":"シーン 56","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第56スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.056.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「こんばんは。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_フランドール・スカーレット.wav","voiceDuration":1.5,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"characterImag