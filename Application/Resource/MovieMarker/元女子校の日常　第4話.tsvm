tory\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.059.jpeg","characterName":"フランドール・スカーレット"},{"audioTrack":"track_voice_soumu","telop":"「知りたいというよりかは…大丈夫なのかな…って。」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","voiceDuration":3.413673469387755,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","id":"9B89A06D-4276-4C98-9E10-848D219067A9","voiceCharacter":"操夢","title":"シーン 60","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第60スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.060.jpeg","characterName":"操夢"},{"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","telop":"「それなら、教えてあげる。実はね…」","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_フランドール・スカーレット.wav","voiceDuration":3.2494784580498868,"transitionName":"なし","bgmName":"BGM: 少女綺想曲","duration":3.5,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","id":"1FC33271-B3DE-4A8C-B29E-62AA05E43BDD","voiceCharacter":"フランドール・スカーレット","title":"シーン 61","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","slideTitle":"第61スライド","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第4話_c6d0148f74\/元女子校の日常　第4話_c6d0148f74.061.jpeg","characterName":"フランドール・スカーレット"},{"audioTrack":"track_voice_soumu","telop":"彼女はそういうと、僕にあることを耳打ちする。\n僕はその事実に衝撃を受けるのだった。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","voiceDuration":5.918027210884354,"transitionNam