iceDuration":3.4843310657596374,"id":"8AC5ED4E-FC7E-4D0B-B139-1BD3A84C5B8D","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、その女性は僕の席に来て、あることを言う。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.047.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第47スライド","duration":4.0843310657596374},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 48","voiceDuration":1.6280498866213151,"id":"8D046F49-572D-4ACB-86F7-853ECD1F0AFB","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「藤原くん、ちょっと来てくれるかい。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.048.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第48スライド","duration":3.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 49","voiceDuration":6.328911564625851,"id":"C042543E-9C06-4E3A-A610-FB6EF7345EE4","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、そう彼女に言われ、ささっと荷物を片すと、\n彼女が着いてきてと言うので、着いていった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.049.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第49スライド","duration":6.92891156462585},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 50","voiceDuration":5.058253968253968,"id":"E4E1C112-AD85-470C-A6BB-A78203B7E1E6","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると彼女は、校庭に出てくる。\n「あの僕は…何をこれからするんですか…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.050.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第50スライド","duration":5.658253968253968},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 51","voiceDuration":3.6434467120181404,"id":"DAFA90E8-9407-4BA1-B306-8A04D18916C0","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「1500m走だよ。\n準備体操を済ませたら、私に声をかけなさい。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.051.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第51スライド","duration":4.24344671201814},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 52","voiceDuration":8.147369614512472,"id":"CC453E23-8FE7-4B02-B3C8-C136F5C85320","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「分かりました…」僕は、とりあえずそう返し、準備体操をする。\nそして、それが終わると、言われた通りに声をかける。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.052.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第52スライド","duration":8.747369614512472},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 53","voiceDuration":2.4332199546485263,"id":"A75FF83B-03C1-40A7-BFFA-E76D9CA73EBB","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それじゃあ、今から時間測るから、走ってみなさい。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.053.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第53スライド","duration":3.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 54","voiceDuration":4.813673469387755,"id":"F25B4B89-9199-44C8-BD8E-19D39D9C5EA0","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「はい…」僕はそう言うと、\n校庭に引かれた線に沿って、走り始める。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.054.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第54スライド","duration":5.413673469387755},{"duration":3,"animationName":"なし","voiceCharacter":"","telop":"","title":"彼が1500m走を完走すると…","id":"63C3C417-6A71-43B3-8490-1EA9DB769AC3","characterName":"","slideTitle":"中扉","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.055.jpeg","transitionName":"なし","backgroundName":"単色背景"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 56","voiceDuration":5.56031746031746,"id":"5D5EDB41-5C46-4B4E-A686-0A338C5FEB45","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「君、そこら辺の女子よりも、足が遅いんじゃないか？」\n私は、手元の腕時計を見ながら言う、あれから10分がたった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.056.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"第56スライド","duration":6.16031746031746},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 57","voiceDuration":5.255147392290249,"id":"34E8E021-5A1E-41D2-9E6A-184F3CAB4EC7","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「これだと、女子相手に情けない男になるぞ、どうだ、もう一走りして、今度は…8分目安にするのはどうだ？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.057.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"第57スライド","duration":5.855147392290249},{"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Applicatio