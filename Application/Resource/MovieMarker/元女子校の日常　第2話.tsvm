761904761904},{"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_024_古明地さとり.wav","voiceCharacter":"古明地さとり","characterName":"古明地さとり","transitionName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","title":"シーン 24","voiceDuration":3.076485260770975,"id":"B3EACE6F-2F1C-40AA-BC62-0664B999E657","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…、でもきっと、学園中で噂になりますよ…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.024.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第24スライド","duration":3.7070975056689344},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_古明地さとり.wav","voiceCharacter":"古明地さとり","characterName":"古明地さとり","transitionName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","title":"シーン 25","voiceDuration":6.512585034013606,"id":"0DC0803D-5228-440F-BC30-D9B260B5029C","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そういえば、次は被服室での授業ですが、一人で大丈夫ですか？あと、数十分もせずに休み時間は終わりますが…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.025.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第25スライド","duration":7.112585034013605},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 26","voiceDuration":5.721292517006803,"id":"28A61D35-31E2-4E62-AA7D-321536232126","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…ちょっと待っててください。」\n僕はそういうと、ささっと自席を片付ける。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.026.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第26スライド","duration":6.321292517006802},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 27","voiceDuration":2.5604308390022674,"id":"B43B9987-F072-46D3-8C3E-94C5929B2E13","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それで、被服室はどこにありますか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.027.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第27スライド","duration":3.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_古明地さとり.wav","voiceCharacter":"古明地さとり","characterName":"古明地さとり","transitionName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","title":"シーン 28","voiceDuration":2.4259863945578233,"id":"2CBCE584-5B65-4982-8757-7FD0FFB89176","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「私が案内しますから、着いてきてください。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.028.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第28スライド","duration":3.5},{"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_029_古明地さとり.wav","voiceCharacter":"古明地さとり","characterName":"古明地さとり","transitionName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","title":"シーン 29","voiceDuration":3.626734693877551,"id":"10182D94-3573-4E9D-9D3B-1BF2884F65D6","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕が彼女と共に被服室にくると、誰かがこちらにくる。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.029.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第29スライド","duration":4.2267346938775505},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_十六夜咲夜.wav","voiceCharacter":"十六夜咲夜","characterName":"十六夜咲夜","transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","animationName":"なし","title":"シーン 30","voiceDuration":3.203378684807256,"id":"5600521F-04D7-4FFE-A37C-F7E0ECA4AF6E","backgroundName":"咲夜（微笑）.png","telop":"「あら、もしかして、このクラスに転入した男子ですか？」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.030.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","slideTitle":"第30スライド","duration":3.803378684807256},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 31","voiceDuration":2.6386848072562357,"id":"22982EDC-4D64-4209-B4D9-383D2742DB8C","backgroundName":"咲夜（微笑）.png","telop":"「ええ、そうですが、なぜそんなことを…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.031.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","slideTitle":"第31スライド","duration":3.5},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_十六夜咲夜.wav","voiceCharacter":"十六夜咲夜","characterName":"十六夜咲夜","transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","animationName":"なし","title":"シーン 32","voiceDuration":6.481882086167801,"id":"A502B844-CDEB-445A-A2F0-2723DA15844D","backgroundName":"咲夜（微笑）.png","telop":"「朝、早苗さんが見たときは、確かに男子だったはずなのに、パチュリーさんの授業に来た時には女子だった…と。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.032.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","slideTitle":"第32スライド","duration":7.0818820861678},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_十六夜咲夜.wav","voiceCharacter":"十六夜咲夜","characterName":"十六夜咲夜","transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","animationName":"なし","title":"シーン 33","voiceDuration":7.121791383219954,"id":"488B8105-015B-4757-8324-DA4617B4BBB8","backgroundName":"咲夜（微笑）.png","telop":"「教員の間で、話題になってますよ。まぁ、元女子校の学園に男子生徒が来ただけでも、話題性は絶えないですが…」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.033.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","slideTitle":"第33スライド","duration":7.721791383219954},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_十六夜咲夜.wav","voiceCharacter":"十六夜咲夜","characterName":"十六夜咲夜","transitionName":"なし","audioTrack":"track_voice_%E5%8D%81%E5%85%AD%E5%A4%9C%E5%92%B2%E5%A4%9C","animationName":"なし","title":"シーン 34","voiceDuration":6.107392290249433,"id":"B6A77BF5-AE19-4643-A767-1D662259BC75","backgroundName":"咲夜（微笑）.png","telop":"「とりあえず、これから家庭の授業をするので、あなたは…窓辺に座っているさとりの隣にでも座ってください。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.034.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","slideTitle":"第34スライド","duration":6.707392290249433},{"voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_035_古明地さとり.wav","voiceCharacter":"古明地さとり","characterName":"古明地さとり","transitionName":"なし","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","animationName":"なし","title":"シーン 35","voiceDuration":6.549183673469388,"id":"1F4BAE36-8A5C-41C1-B918-F15B7A308260","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「今日は、咲夜師匠の２連無休授業ですから、あなたには…酷かもしれませんが、2時間を休憩なしで耐えるしかないですね。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.035.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第35スライド","duration":7.234195011337868},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 36","voiceDuration":3.1984580498866215,"id":"D8222FEF-5DBC-41A8-AC31-029E9D489D57","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼女がそういい、数分程度で授業が始まった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.036.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第36スライド","duration":3.7984580498866216},{"duration":3.5,"animationName":"なし","voiceCharacter":"ナレーション","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"2時間休憩なし授業が終わると…","title":"シーン 37","id":"2EA046CD-2C7B-4C06-9295-BEF07106B7A5","characterName":"ナレーション","slideTitle":"第37スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.037.jpeg","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 38","voiceDuration":9.5756462585034,"id":"82D3E64B-D955-4163-9C57-5A4180FB2D88","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕たちは、それから、2時間の間、休憩なしで、講義を受け続けると、教室に戻り、終礼が始まるまで席に座って待ち続ける。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.038.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第38スライド","duration":10.1756462585034},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 39","voiceDuration":4.408253968253968,"seName":"SE: 教室の戸を開ける","id":"F63C9D0E-A77D-4078-B9E6-362C87D2F4A6","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、教室の扉が開き、朝礼の時に来た女性が入る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slid