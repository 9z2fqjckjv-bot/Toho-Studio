ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.060.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"第60スライド","duration":3.8865079365079365},{"duration":3,"animationName":"なし","voiceCharacter":"","telop":"","title":"彼がもう一走りをすると…","id":"914DA1E8-7461-4101-8CFA-6E41CF86D358","characterName":"","slideTitle":"中扉","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.061.jpeg","transitionName":"なし","backgroundName":"単色背景"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 62","voiceDuration":4.270068027210884,"id":"44C16F63-3EE4-4550-97B8-180FBD204B72","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「さっきよりは良くなったか…」\n私は、手元の腕時計を見る。あれから9分弱が経っていた。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.062.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"第62スライド","duration":4.870068027210884},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_美鈴.wav","voiceCharacter":"美鈴","characterName":"美鈴","transitionName":"なし","audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","animationName":"なし","title":"シーン 63","voiceDuration":5.2411111111111115,"id":"CE55078D-9B0B-496A-ABB1-2C991363CEB4","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「とりあえず、これで今日はおしまいにしよう、今度の体育では、同じトラックで女子と競争になるから、覚悟するのだぞ。」","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.063.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","slideTitle":"第63スライド","duration":5.841111111111111},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 64","voiceDuration":7.504988662131519,"id":"A5C7F907-EBEB-45F0-9B2D-16C3BF3E6B38","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼女はそう言うと、そのまま何かを呟きながら、去っていった。\n僕は、その場でしゃがみ込んで、休みを取る。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.064.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第64スライド","duration":8.10498866213152},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 65","voiceDuration":6.422380952380952,"id":"05E60BA4-8690-49B5-8B4B-C9391A0A527A","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、走ってた時には感じなかった痛みが僕を襲う。\nどうやら、無理強いをしていたようだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.065.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第65スライド","duration":7.022380952380952},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 66","voiceDuration":8.239773242630385,"id":"38F1A68E-6E39-4CDC-ACE0-1AF1BBDE1C7F","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"だが、彼女の言葉は事実を述べているだけなので、何もいえず、ただ一人、校庭で俯きながら、考え込む僕だった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.066.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第66スライド","duration":8.839773242630384},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav","voiceCharacter":"操夢","characterName":"操夢","transitionName":"なし","audioTrack":"track_voice_soumu","animationName":"なし","title":"シーン 67","voiceDuration":5.761519274376417,"seName":"SE: 倒れる","id":"2CAC7953-81C4-4D20-BC2F-B945CCF118EF","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、立ちあがろうとしたその時、\n僕の全身がぐらつき、そのまま倒れ込むのだった。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第2話_aaa2097126\/元女子校の日常　第2話_aaa2097126.067.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第67スライド","duration":6.361519274376417,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/倒れる.mp3"},{"duration":2,"animationName":"なし","voiceCharacter":"ナレーション","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","telop":"続く…","title":"シーン 68","id":"E6117C2C-0C58-418F-B980-C9DE6778BC24","characterName":"