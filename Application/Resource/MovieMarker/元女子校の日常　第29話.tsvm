me":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.019.jpeg","id":"891B6BC5-24E5-4B19-BB05-FD3F48F39B11","characterName":"古明地こいし","telop":"「とりあえず、先生に報告してくるから、待ってて。」","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_古明地こいし.wav","voiceCharacter":"古明地こいし","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.07891156462585,"slideTitle":"第20スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"bgmVolume":0.65,"seStartTimeOffset":0,"transitionName":"なし","seVolume":1,"title":"シーン 20","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.020.jpeg","id":"D2C8088F-37B5-42AA-8AFD-7EBB8EB1125E","characterName":"操夢","telop":"彼女はそういうと、去っていった。僕は、ただ困惑していた。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":4.407732426303855,"slideTitle":"第21スライド","voice2StartTimeOffset":0,"duration":5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/恐怖にやり.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 21","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.021.jpeg","id":"475CFB71-935F-4B62-949B-8BEEEC040DA2","characterName":"博麗霊夢","telop":"?\n主人公の彼に潜む、謎の黒い影。圧倒的な攻撃力と体格、反射神経で好戦的。その姿、彼に似ているが、それをみた本人曰く、魔理沙の面影がどこかあるという。副人格には、霊夢の面影があり、一体彼は、どういう作りになっているのだろうか？\n?","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":3.856077097505669,"slideTitle":"第22スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"bgmVolume":0.65,"seStartTimeOffset":0,"transitionName":"なし","seVolume":1,"title":"シーン 22","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.022.jpeg","id":"165268DB-0134-45B7-BDC1-25D8FB918691","characterName":"操夢","telop":"僕はそれから、永琳に呼ばれを診察を受けていた。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.678934240362812,"slideTitle":"第23スライド","voice2StartTimeOffset":0,"duration":4.4,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 23","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.023.jpeg","id":"A168713C-473A-4E8A-BCDD-12EF2090D1C1","characterName":"八意永琳","telop":"「それで、パチュリー博士があなたに、\n飲ませた液体に関する感想を聞かせてもらおうかしら。」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":2.8430385487528347,"slideTitle":"第24スライド","voice2StartTimeOffset":0,"duration":4,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 24","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.024.jpeg","id":"022D3672-9496-4116-B6FD-BDFF87A5D80B","characterName":"操夢","telop":"「感想って言われても…、\n飲んだ直後に意識が飛んじゃったので、覚えてないです…。」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.20421768707483,"slideTitle":"第25スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 25","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.025.jpeg","id":"B157B8B1-B080-414A-B38C-E370349454E8","characterName":"八意永琳","telop":"「そう…、それでさっきまで見てた夢は分かるかしら？」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":5.643038548752834,"slideTitle":"第26スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 26","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.026.jpeg","id":"F1144424-5D15-478B-B3B0-3896BF22ABC9","characterName":"操夢","telop":"「多分こいしさんがいうに、悪い夢だったんだと思います。」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.660748299319728,"slideTitle":"第27スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 27","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.027.jpeg","id":"C9FC6FF4-4A38-4BA2-A636-F5071B164C06","characterName":"八意永琳","telop":"「それで、あなたの考えは？」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_フランドール・スカーレット.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.6289115646258505,"slideTitle":"第28スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 28","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.028.jpeg","id":"AC7CA3EA-297C-4F71-8071-CC97BFBA05D6","characterName":"操夢","telop":"「いや…夢の内容を覚えているわけではないので…」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.365736961451248,"slideTitle":"第29スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 29","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.029.jpeg","id":"62CB4CBB-CE27-4659-BAE8-5023284AB6C1","characterName":"八意永琳","telop":"「そう…」私は、そう言いながら、彼にあるものを見せる。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_博麗霊夢.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.906077097505669,"slideTitle":"第30スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 30","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.030.jpeg","id":"3100E4FF-AE56-4895-A7B3-6A3E697D6075","characterName":"操夢","telop":"「それは…脳波ですか…？」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":3.009546485260771,"slideTitle":"第31スライド","voice2StartTimeOffset":0,"duration":4.800000000000001,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 31","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.031.jpeg","id":"23FFA139-B4B7-42ED-907E-C1947FE3051D","characterName":"八意永琳","telop":"「ええ。実は、あなたがあの研究室で倒れた後、\nすぐに病室に運ばれて、あなたの脳波をとっていたの。」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_八雲紫.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":5.35281179138322,"slideTitle":"第32スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 32","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.032.jpeg","id":"50EB9E08-DC10-4257-B38D-4A06425F7593","characterName":"操夢","telop":"「そうですか…、それで、何かわかるんですか？」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.360249433106576,"slideTitle":"第33スライド","voice2StartTimeOffset":0,"duration":5.4,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 33","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.033.jpeg","id":"2CE03872-1D72-4E81-8E74-D7843988D519","characterName":"八意永琳","telop":"「そうね…、簡潔にいうなら、あなたの落ち着き度合いを確認するためよ。まぁ、そんなことは気にしなくていいわ。」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav.bak","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.244126984126984,"slideTitle":"第34スライド","voice2StartTimeOffset":0,"duration":5.300000000000001,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 34","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.034.jpeg","id":"37E849D5-8002-4350-BEA4-3E7079AA109D","characterName":"八意永琳","telop":"「とりあえず、今日の診察はここまでにしましょう、学校には早退と伝えてあるから、病室に戻って休んでなさい。」","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_キャラクター.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.823469387755102,"slideTitle":"第35スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 35","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.035.jpeg","id":"3A4B48C9-D728-46DF-9677-F8D434413495","characterName":"操夢","telop":"「分かりました…」僕はそういうと、病室に戻っていった。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.121292517006802,"slideTitle":"第36スライド","voice2StartTimeOffset":0,"duration":5.800000000000001,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 36","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.036.jpeg","id":"E1CAF563-22F6-4422-B272-C21DE1F81B03","characterName":"八意永琳","telop":"私は彼が帰ると、ある彼のデータを眺めていた。実は、さっき見せた脳波のデータはダミーで、本当は違うデータを取っていた。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_サブ.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.963242630385488,"slideTitle":"第37スライド","voice2StartTimeOffset":0,"duration":5.9,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 37","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.037.jpeg","id":"D678F150-B76B-4CA7-A204-2952A732346E","characterName":"八意永琳","telop":"「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_フランドール・スカーレット.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":3.1319727891156464,"slideTitle":"第38スライド","voice2StartTimeOffset":0,"duration":5.7,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 38","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.038.jpeg","id":"247E3AE2-1230-4AD6-A9B6-F29A6F87548A","characterName":"八意永琳","telop":"実は、それは彼の出生に関わる秘密情報でもあり、しかもその情報を以前、彼を担当してた医者からは聞いてないものだった。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_八雲紫.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":2.8913832199546485,"slideTitle":"第39スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 39","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.039.jpeg","id":"CEE14C50-6453-48AE-98D9-8E1FB2BD2CDF","characterName":"八意永琳","telop":"それは、彼の両親と、ある女性の過去を端的に表していた。","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_十六夜咲夜.wav","voiceCharacter":"永琳","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":5.740249433106576,"slideTitle":"第40スライド","voice2StartTimeOffset":0,"duration":5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 40","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.040.jpeg","id":"FF82BE3D-CFA5-4564-BC1D-5BFE12F3E965","characterName":"射命丸文","telop":"主人公の担当医\n主人公の彼の祖母であり、担当医でもある。彼の特殊な体つきを把握しているほか、文に調査もさせた。そして、彼をある状態にして、ある道具を用いて収集したデータから、以前、彼が通っていた病院が密かに隠し、伝えなかった、彼の出生にも関わる秘密情報を知ることになった。\n八意永琳","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_ナレーション.wav","voiceCharacter":"射命丸文","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":5.295283446712018,"slideTitle":"第41スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/こいし（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 41","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.041.jpeg","id":"FE227039-6163-4040-8664-3CD11CBF7558","characterName":"古明地こいし","telop":"「紅夢、退院できるみたいだから、一緒に帰ろ。」","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地こいし.wav","voiceCharacter":"古明地こいし","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":6.536507936507936,"slideTitle":"第42スライド","voice2StartTimeOffset":0,"duration":5.800000000000001,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/こいし（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 42","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.042.jpeg","id":"4EFE5480-19BD-4928-BC49-6E91DE900118","characterName":"操夢","telop":"彼女は、突如病室の扉を開け、僕にそう言ってくる。「そうですか…、分かりました。」僕はそう言い、ゆっくりと体を起こす。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":3.5017233560090704,"slideTitle":"第43スライド","voice2StartTimeOffset":0,"duration":5.2,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/こいし（微笑）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 43","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.043.jpeg","id":"9F8BFAB3-6C3D-427E-9054-337CCE1BC1B6","characterName":"操夢","telop":"僕たちが、校門から出てくると、フランが驚いた様子で、車から降りてきた。「どうしたんですか、フランさん？」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":5.200748299319728,"slideTitle":"第44スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 44","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.044.jpeg","id":"01531A11-0424-4334-A202-FDA01F697C5B","characterName":"フランドール・スカーレット","telop":"「手を見なさい！」","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_フランドール・スカーレット.wav","voiceCharacter":"フランドール・スカーレット","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":4.093038548752834,"slideTitle":"第45スライド","voice2StartTimeOffset":0,"duration":3.6,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/こいし（余裕）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 45","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.045.jpeg","id":"8CD4D4AB-E026-4425-9D06-533A90D27D2D","characterName":"操夢","telop":"「こいしさんが、こうしたい言ったから、\n単純に手を繋いでいるんですけど…」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.056734693877551,"slideTitle":"第46スライド","voice2StartTimeOffset":0,"duration":5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/こいし（余裕）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 46","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.046.jpeg","id":"91246042-DE75-470D-90E3-FD165AC41CE7","characterName":"操夢","telop":"僕は、単純にそう説明する。ふと、隣を見ると、こいしがニヤついていた。だが、ある嫌な目線を僕は感じる。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":7.8441269841269845,"slideTitle":"第47スライド","voice2StartTimeOffset":0,"duration":5.1000000000000005,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/さとり（余裕影）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 47","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.047.jpeg","id":"B6FB7551-1505-4E9D-9BC0-9940F2655834","characterName":"操夢","telop":"すると、僕の視線に気がついたのか、彼女がこちらに駆け寄ってくる。そして、彼女はポッケを探るようにする。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":6.748458049886621,"slideTitle":"第48スライド","voice2StartTimeOffset":0,"duration":5.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/さとり（余裕影）.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 48","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.048.jpeg","id":"A02E2C10-7B91-4CD2-8E2F-ACCD2AE21793","characterName":"操夢","telop":"すると、彼女はナイフを取り出す。僕が、反射的にこいしの前に立つ。すると、僕の体にナイフが突き刺さる。「うっ…」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.035419501133786,"slideTitle":"第49スライド","voice2StartTimeOffset":0,"duration":5.6000000000000005,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影付き恐怖顔.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 49","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.049.jpeg","id":"8B338492-5630-432F-90E8-BC12ABBB1EE0","characterName":"操夢","telop":"僕は、瞬間的に状況を把握し、残っている力を込めて、こいしにいう。「こいしさん、フランさんと車で帰ってください！」","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":8.085419501133787,"slideTitle":"第50スライド","voice2StartTimeOffset":0,"duration":5.6000000000000005,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影付き恐怖顔.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 50","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.050.jpeg","id":"71398D28-6C33-4945-9FB3-D20F13ECF24D","characterName":"操夢","telop":"「ほら、さっさと動かないと、僕たちは、さとりの手の平の上で遊ばれてしまいますよ！」僕はできるだけ大きな声で言う。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"単色背景","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":1.4292743764172335,"slideTitle":"第51スライド","voice2StartTimeOffset":0,"duration":3.5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影あり困り.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 51","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.051.jpeg","id":"68450261-3F96-45E3-854C-C0EA4EA24EC5","characterName":"古明地こいし","telop":"「でも、紅夢が…」","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_古明地こいし.wav","voiceCharacter":"古明地こいし","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"nc256896_病室-昼.png","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":6.468571428571429,"slideTitle":"第52スライド","voice2StartTimeOffset":0,"duration":5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影あり困り.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 52","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子