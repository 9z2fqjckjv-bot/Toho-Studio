/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.35281179138322,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第32スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.032.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 32","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"87A0D463-CAF0-436F-A2DC-20BFA25418CB","telop":"「そうね…、簡潔にいうなら、あなたの落ち着き度合いを確認するためよ。まぁ、そんなことは気にしなくていいわ。」","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.360249433106576,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第33スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.033.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 33","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_永琳.wav.bak","voice2StartTimeOffset":0,"duration":5.4},{"id":"C5CC6ED7-E7A0-49ED-B122-1EBC69D80C15","telop":"「とりあえず、今日の診察はここまでにしましょう、学校には早退と伝えてあるから、病室に戻って休んでなさい。」","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.244126984126984,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第34スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.034.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 34","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_キャラクター.wav","voice2StartTimeOffset":0,"duration":5.300000000000001},{"id":"3B11EF2A-28FC-4FFF-9C62-45C444514A18","telop":"「分かりました…」僕はそういうと、病室に戻っていった。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.823469387755102,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第35スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.035.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 35","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"0B6D440B-E66D-40B7-8554-D92113288E34","telop":"私は彼が帰ると、ある彼のデータを眺めていた。実は、さっき見せた脳波のデータはダミーで、本当は違うデータを取っていた。","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.121292517006802,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第36スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.036.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 36","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_サブ.wav","voice2StartTimeOffset":0,"duration":5.800000000000001},{"id":"ABC9F46B-5E25-4613-8E46-F63F16B86308","telop":"「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.963242630385488,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第37スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.037.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 37","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"duration":5.9},{"id":"3DBC6039-A07A-49D1-91F8-E2F47787FC53","telop":"実は、それは彼の出生に関わる秘密情報でもあり、しかもその情報を以前、彼を担当してた医者からは聞いてないものだった。","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":3.1319727891156464,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第38スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.038.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 38","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_八雲紫.wav","voice2StartTimeOffset":0,"duration":5.7},{"id":"C4E0081E-1270-493D-9ED2-EC87E2E3D9B9","telop":"それは、彼の両親と、ある女性の過去を端的に表していた。","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/永琳（怒り）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":2.8913832199546485,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第39スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.039.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 39","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_十六夜咲夜.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"5C16B557-F8B1-4C2F-A920-8DA005CC01E2","telop":"","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","characterName":"","transitionName":"なし","animationName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"中扉","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.040.jpeg","backgroundName":"単色背景","title":"主人公の担当医","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voice2StartTimeOffset":0,"duration":5},{"id":"8E0A3C4E-503B-417A-948B-ABA300B6D7A7","telop":"「紅夢、退院できるみたいだから、一緒に帰ろ。」","voiceCharacter":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc256897_病室-夕方-電気あり.png","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/こいし（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.295283446712018,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第41スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.041.jpeg","backgroundName":"nc256897_病室-夕方-電気あり.png","title":"シーン 41","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_古明地こいし.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"C9EEE85E-00A4-412B-AEBB-A650C39D1B1C","telop":"彼女は、突如病室の扉を開け、僕にそう言ってくる。「そうですか…、分かりました。」僕はそう言い、ゆっくりと体を起こす。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc256897_病室-夕方-電気あり.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/こいし（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":6.536507936507936,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第42スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.042.jpeg","backgroundName":"nc256897_病室-夕方-電気あり.png","title":"シーン 42","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","voice2StartTimeOffset":0,"duration":5.800000000000001},{"id":"8DACD565-8322-4DF6-81BE-235542EB1D59","telop":"僕たちが、校門から出てくると、フランが驚いた様子で、車から降りてきた。「どうしたんですか、フランさん？」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/こいし（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":3.5017233560090704,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第43スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.043.jpeg","backgroundName":"image79.jpeg","title":"シーン 43","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","voice2StartTimeOffset":0,"duration":5.2},{"id":"46531DCE-24E1-4E69-84B4-854D274BBC78","telop":"「手を見なさい！」","voiceCharacter":"フランドール・スカーレット","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","characterName":"フランドール・スカーレット","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（怒る）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.200748299319728,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第44スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.044.jpeg","backgroundName":"image79.jpeg","title":"シーン 44","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"1699B221-0876-48E1-9CF1-EEE4DF8F9C12","telop":"「こいしさんが、こうしたい言ったから、\n単純に手を繋いでいるんですけど…」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/こいし（余裕）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":4.093038548752834,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第45スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.045.jpeg","backgroundName":"image79.jpeg","title":"シーン 45","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","voice2StartTimeOffset":0,"duration":3.6},{"id":"1C4B8561-8D2F-4C1A-852F-B4B3AE3CEAE1","telop":"僕は、単純にそう説明する。ふと、隣を見ると、こいしがニヤついていた。だが、ある嫌な目線を僕は感じる。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/こいし（余裕）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.056734693877551,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第46スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.046.jpeg","backgroundName":"image79.jpeg","title":"シーン 46","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","voice2StartTimeOffset":0,"duration":5},{"id":"FE466D8E-CFC2-4F55-8FE6-8531FF4015CE","telop":"すると、僕の視線に気がついたのか、彼女がこちらに駆け寄ってくる。そして、彼女はポッケを探るようにする。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/さとり（余裕影）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.8441269841269845,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第47スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.047.jpeg","backgroundName":"image79.jpeg","title":"シーン 47","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","voice2StartTimeOffset":0,"duration":5.1000000000000005},{"id":"09DAF54F-D179-4523-8798-720FBF998D8F","telop":"すると、彼女はナイフを取り出す。僕が、反射的にこいしの前に立つ。すると、僕の体にナイフが突き刺さる。「うっ…」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/さとり（余裕影）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":6.748458049886621,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第48スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.048.jpeg","backgroundName":"image79.jpeg","title":"シーン 48","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","voice2StartTimeOffset":0,"duration":5.5},{"id":"BBB42C57-6FE9-4872-B9FD-DB06D46584CD","telop":"僕は、瞬間的に状況を把握し、残っている力を込めて、こいしにいう。「こいしさん、フランさんと車で帰ってください！」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影付き恐怖顔.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.035419501133786,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第49スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.049.jpeg","backgroundName":"image79.jpeg","title":"シーン 49","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voice2StartTimeOffset":0,"duration":5.6000000000000005},{"id":"7603CA67-1E38-49AB-84A1-0C6F123F1CFA","telop":"「ほら、さっさと動かないと、僕たちは、さとりの手の平の上で遊ばれてしまいますよ！」僕はできるだけ大きな声で言う。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影付き恐怖顔.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.085419501133787,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第50スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.050.jpeg","backgroundName":"image79.jpeg","title":"シーン 50","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","voice2StartTimeOffset":0,"duration":5.6000000000000005},{"id":"E60FBB4E-0956-4A8F-893A-808D6FD90130","telop":"「でも、紅夢が…」","voiceCharacter":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影あり困り.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":1.4292743764172335,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第51スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.051.jpeg","backgroundName":"image79.jpeg","title":"シーン 51","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_古明地こいし.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"D101384B-6117-44A6-9298-66FBC11690D7","telop":"僕は、いてもたってもいられなくなり、傷口を押さえ込む手を離し、血がついた手で二人を順番にビンタする。","voiceCharacter":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影あり困り.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":6.468571428571429,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第52スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.052.jpeg","backgroundName":"image79.jpeg","title":"シーン 52","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_先代の巫女.wav","voice2StartTimeOffset":0,"duration":5},{"id":"7D0E7CD8-15A4-45CD-8988-E6145721FEA6","telop":"「フランさん、僕のことは気にせずに、彼女を連れて、家に戻ってください。」僕は、一瞬正気を取り戻したフランにそう言う。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影あり困り.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":3.8647619047619046,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第53スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.053.jpeg","backgroundName":"image79.jpeg","title":"シーン 53","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","voice2StartTimeOffset":0,"duration":5.800000000000001},{"id":"08884444-07FA-44AF-B383-B2B57F4148F7","telop":"だが、それとともに僕は意識を失ってしまうのだった。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/image79.jpeg","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/影あり困り.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.723469387755102,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第54スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.054.jpeg","backgroundName":"image79.jpeg","title":"シーン 54","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"098C148D-3E59-47F3-B9CA-5CB6951FAFC9","telop":"","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png","characterName":"","transitionName":"なし","animationName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"中扉","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.055.jpeg","backgroundName":"単色背景","title":"主人公の2つ目の人格","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voice2StartTimeOffset":0,"duration":5},{"id":"EF1E01A4-35C8-44F5-932A-5D6A3E4119EB","telop":"僕は、ふと気がつくと、そこはまたもや暗闇に包まれた空間だった。だが、なんとなくさっきのとは違う気がする。","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"characterName":"操夢","transitionName":"なし","animationName":"なし","voiceDuration":5.847369614512472,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第56スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.056.jpeg","backgroundName":"単色背景","title":"シーン 56","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","voice2StartTimeOffset":0,"duration":5.2},{"id":"D68684EE-72AE-4701-A60A-32BA37F2D79C","telop":"すると、暗闇からモザイクが掛かったベッドが見えてくる。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/寝室の窓際のベッド（夜・まっくら・青）.pxd","audioTrack":"track_voice_soumu","characterName":"操夢","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.873469387755102,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第57スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.057.jpeg","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","title":"シーン 57","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"B578BCE0-4E49-4624-A7E3-2F20207FB72C","telop":"そして、頬照りながらニヤつく、母と魔理沙、\nさらに、頬照りながらも困っている父の姿があった。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/寝室の窓際のベッド（夜・まっくら・青）.pxd","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/妹紅（困る）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.222380952380952,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第58スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.058.jpeg","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","title":"シーン 58","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","voice2StartTimeOffset":0,"duration":4.5},{"id":"91232DB8-D06F-43E6-B028-9C4B825F8597","telop":"僕は、状況的に3人ともお酒に酔ってることがわかる。\nすると、3人は言葉にならないことを呟きながら、重なる。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/寝室の窓際のベッド（夜・まっくら・青）.pxd","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/妹紅（困る）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":2.266938775510204,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第59スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.059.jpeg","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","title":"シーン 59","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","voice2StartTimeOffset":0,"duration":5.2},{"id":"30435322-2464-4F93-BC77-0C2F3FC25E9B","telop":"僕はそこで、知らずとも理解してしまうのだった、僕の遺伝子には、両親からのとは別に、魔理沙のものもあるということに。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/寝室の窓際のベッド（夜・まっくら・青）.pxd","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/妹紅（困る）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":4.421292517006803,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第60スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.060.jpeg","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","title":"シーン 60","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","voice2StartTimeOffset":0,"duration":5.7},{"id":"E68F9573-7310-42B1-9E04-B6153A37A409","telop":"僕はふと目が覚めると、そこは病室だった。\nすると、フランが驚いた表情で僕を見ていた。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc256899_病室-夜-電気あり.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":3.975646258503401,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第61スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.061.jpeg","backgroundName":"nc256899_病室-夜-電気あり.png","title":"シーン 61","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/