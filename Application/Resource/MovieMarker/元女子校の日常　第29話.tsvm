昼.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/頬照り目閉じこいし.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.134331065759637,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第18スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.018.jpeg","backgroundName":"nc256896_病室-昼.png","title":"シーン 18","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","voice2StartTimeOffset":0,"duration":4.4},{"id":"33C5BE82-BCBA-48C5-B913-5FFAE164F7D6","telop":"「とりあえず、先生に報告してくるから、待ってて。」","voiceCharacter":"古明地こいし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（困る）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":3.5591156462585034,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第19スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.019.jpeg","backgroundName":"nc256896_病室-昼.png","title":"シーン 19","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_古明地こいし.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"ADE31BC7-9AAA-4EEB-BE2B-47DE576083E2","telop":"彼女はそういうと、去っていった。僕は、ただ困惑していた。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","audioTrack":"track_voice_soumu","characterName":"操夢","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.07891156462585,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第20スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.020.jpeg","backgroundName":"nc256896_病室-昼.png","title":"シーン 20","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"4AC950BF-8867-4805-A0A5-6D865B6C3C22","telop":"","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/恐怖にやり.png","characterName":"","transitionName":"なし","animationName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"中扉","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.021.jpeg","backgroundName":"単色背景","title":"? (主人公の彼に潜む、謎の黒い影。圧倒的…)","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voice2StartTimeOffset":0,"duration":5},{"id":"C1A18691-FD6A-433A-905B-D260A33D2E77","telop":"僕はそれから、永琳に呼ばれを診察を受けていた。","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_soumu","characterName":"操夢","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":3.856077097505669,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第22スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.022.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 22","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"26045156-7DB9-42BA-B5D2-AC3F7291DF43","telop":"「それで、パチュリー博士があなたに、\n飲ませた液体に関する感想を聞かせてもらおうかしら。」","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":8.678934240362812,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第23スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.023.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 23","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_永琳.wav","voice2StartTimeOffset":0,"duration":4.4},{"id":"0F9C309E-B45E-48FE-9129-8059AC4C6631","telop":"「感想って言われても…、\n飲んだ直後に意識が飛んじゃったので、覚えてないです…。」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":2.8430385487528347,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第24スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.024.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 24","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voice2StartTimeOffset":0,"duration":4},{"id":"373778B0-A16A-46A9-ADBC-524FA6A28CCC","telop":"「そう…、それでさっきまで見てた夢は分かるかしら？」","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.20421768707483,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第25スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.025.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 25","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_永琳.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"8178A752-9A2C-47E2-B429-DDD38D3F2893","telop":"「多分こいしさんがいうに、悪い夢だったんだと思います。」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":5.643038548752834,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第26スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.026.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 26","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"897E5874-6476-4CD5-95AB-748241A50651","telop":"「それで、あなたの考えは？」","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.660748299319728,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第27スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.027.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 27","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"0F94F4B9-B6B9-4805-A04E-4C97CB25F5DD","telop":"「いや…夢の内容を覚えているわけではないので…」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.6289115646258505,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第28スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.028.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 28","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"929C2F1A-EE20-48F1-9F0A-CDCF36F598CF","telop":"「そう…」私は、そう言いながら、彼にあるものを見せる。","voiceCharacter":"永琳","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","characterName":"八意永琳","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.365736961451248,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第29スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.029.jpeg","backgroundName":"nc166698_病院の診察室.png","title":"シーン 29","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_博麗霊夢.wav","voice2StartTimeOffset":0,"duration":3.5},{"id":"EBFFF3E2-CD50-4952-9684-07B688F211B6","telop":"「それは…脳波ですか…？」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc166698_病院の診察室.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第17話\/永琳（微笑）.png","voiceStartTimeOffs