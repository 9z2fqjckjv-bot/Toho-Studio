ansitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 54","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.054.jpeg","id":"933D9AE7-C156-453C-8155-330B96229039","characterName":"操夢","telop":"だが、それとともに僕は意識を失ってしまうのだった。","audioTrack":"track_voice_soumu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","voiceCharacter":"操夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"nc256896_病室-昼.png","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":9.359478458049887,"slideTitle":"第55スライド","voice2StartTimeOffset":0,"duration":5,"voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/やられ怒り.png","bgmVolume":0.65,"transitionName":"なし","seStartTimeOffset":0,"seVolume":1,"title":"シーン 55","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_ada4ea99a0\/元女子校の日常　第29話_ada4ea99a0.055.jpeg","id":"34A11F37-C8B9-4E14-A15E-3921B20043C0","characterName":"博麗霊夢","telop":"主人公の2つ目の人格\n主人公の彼がもつ2つ目の人格。彼が以前通っていた男子校での陰湿な行為により、彼が中学生になるとともに現れた。そして、彼が暗闇の空間で目が覚めると、彼に潜む影と戦っていた。本人曰く、そこにはなぜか、霊夢の面影があったと言う。果たして、彼の身に何が起きているのだろうか？\n名無し","audioTrack":"track_voice_reimu","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_博麗霊夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","voiceCharacter":"博麗霊夢","bgmStartTimeOffset":0,"showTelopOverlay":false},{"backgroundName":"nc256896_病室-昼.png","animationName":"なし","bgmName":"BGM: 東方妖恋談","voiceDuration":5.847369614512472,"slideTitle":"第56スライド","voice2StartTimeOffset":0,"duration":5.2,"voiceS