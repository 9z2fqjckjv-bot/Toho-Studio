","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc256899_病室-夜-電気あり.png","audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","characterName":"古明地こいし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":4.183424036281179,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第73スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.073.jpeg","backgroundName":"nc256899_病室-夜-電気あり.png","title":"シーン 73","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_古明地こいし.wav","voice2StartTimeOffset":0,"duration":4.4},{"id":"53E52FF5-0F03-43AF-B375-74418A580BD6","telop":"「それじゃあ、僕はどうなるんですか？」","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/nc256899_病室-夜-電気あり.png","audioTrack":"track_voice_soumu","characterName":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（不満）.png","voiceStartTimeOffset":0,"transitionName":"なし","animationName":"なし","voiceDuration":7.039773242630385,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第74スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.074.jpeg","backgroundName":"nc256899_病室-夜-電気あり.png","title":"シーン 74","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav","voice2StartTimeOffset":0,"duratio