[{"id":"824B7BC2-89A5-426E-BD90-1F9DA7B2093E","telop":"僕は、ふと気がつくと、そこは暗闇が広がる空間だった。\nすると、遠くで誰かが戦っている音が聞こえる。","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"characterName":"操夢","transitionName":"なし","animationName":"なし","voiceDuration":2.8365079365079366,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第1スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.001.jpeg","backgroundName":"単色背景","title":"シーン 1","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢_2.wav","voice2StartTimeOffset":0,"duration":4.800000000000001},{"id":"C10EEAAE-5319-44A2-A443-E6B0323D6301","telop":"その音は、だんだんとこちらに近づいてきくる。\nそして、だんだんと暗闇に慣れて見えたのは、女性の姿だった。","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png","characterName":"操夢","transitionName":"なし","animationName":"なし","voiceDuration":8.65281179138322,"seStartTimeOffset":0.6999999999999993,"bgmStartTimeOffset":0,"slideTitle":"第2スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.002.jpeg","backgroundName":"単色背景","title":"シーン 2","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":0.85,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","voice2StartTimeOffset":0,"seName":"SE: スペルカード発動音","duration":5.1000000000000005},{"id":"7E4F011E-CB3C-427A-81EC-C2793D3BDBD5","telop":"「今すぐ、私の背中に隠れなさい。」","voiceCharacter":"サブ","audioTrack":"track_voice_sub","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png","characterName":"サブ","transitionName":"なし","animationName":"なし","voiceDuration":8.961519274376418,"seStartTimeOffset":1.2999999999999972,"bgmStartTimeOffset":0,"slideTitle":"第3スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.003.jpeg","backgroundName":"単色背景","title":"シーン 3","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":0.8,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_サブ.wav","voice2StartTimeOffset":0,"seName":"SE: 決定・衝撃音","duration":3.5},{"id":"E605F9B1-923C-4C44-A630-CDE665DEB39A","telop":"彼女がそういうと、僕は無意識のうちに、彼女の背中に隠れる。\nなぜだかわからないが、彼女が母である霊夢に見えていた。","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png","characterName":"操夢","transitionName":"なし","animationName":"なし","voiceDuration":7.948027210884354,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"第4スライド","bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第29話_a4a4484fdd\/元女子校の日常　第29話_a4a4484fdd.004.jpeg","backgroundName":"単色背景","title":"シーン 4","bgmName":"BGM: 東方妖恋談","showTelopOverlay":false,"seVolume":1,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","voice2StartTimeOffset":0,"duration":5.6000000000000005},{"id":"6998D2BD-22C0-44B6-8848-D7607A1F2426","telop":"すると、彼女は暗闇から鋭い攻撃を受ける。\nそして、ぐちゃりと何か飛び散る。","voiceCharacter":"操夢","audioTrack":"track_voice_soumu","voiceStartTimeOffset":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第29話\/疲労.png","characterName":"操夢","transitionName":"なし","animationName":"なし","voiceDuration":8.162607709750567,"seStartTimeOffset":0,"bgmStartTimeOffset":0,"slid