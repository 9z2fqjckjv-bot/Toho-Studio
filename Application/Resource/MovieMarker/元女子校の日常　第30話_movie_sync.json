"duration":5.646303854875283,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #32","voiceDuration":5.646303854875283,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 32","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","animationName":"なし"},{"backgroundName":"単色背景","telop":"大学院まで完走した24歳。","id":"B516F906-5884-4850-8C94-1B72864D33FA","duration":5,"bgmName":"BGM: 少女綺想曲","voice2StartTimeOffset":0,"characterName":"操夢","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #33","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 33: 大学院まで完走した24歳。","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"僕は食事を終えて、夜の10時ごろに、酔いが全身に巡り巡って、赤くになったレミリアとフランを連れて帰ってきた。","id":"041EB706-A3A9-438D-916D-D46E49278831","duration":7.572380952380953,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #34","voiceDuration":7.572380952380953,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 34","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"すると、僕はある嫌な予感がする。そこで僕は、食事前にパチュリーからもらっていたある液体を二人に飲ます。","id":"17D10079-360C-4BD9-AAE2-369D9B701830","duration":7.495850340136054,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #35","voiceDuration":7.495850340136054,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 35","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"そして、その予感は見事に的中し、二人は料理が口に逆走しなかったはいいものの、二人の下にはある液体が垂れ流れていた。","id":"428FFE63-E617-4C1C-8981-236C1ED81302","duration":8.547369614512471,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #36","voiceDuration":8.547369614512471,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 36","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","animationName":"なし"},{"backgroundName":"nc228271_居酒屋の個室.jpg","telop":"「これ、あなたが開発した、アルコール排出促進剤。\n二人が酔い潰れそうだったら、その前に飲ませて。」","id":"EEDBB125-C983-4F11-8AC1-5D5689AA751B","duration":6.11922902494331,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","voiceCharacter":"パチュリー・ノーレッジ","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #37","voiceDuration":6.11922902494331,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 37","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_パチュリー・ノーレッジ.wav","animationName":"なし"},{"backgroundName":"nc228271_居酒屋の個室.jpg","telop":"「ただし、ゲロを吐くことはないけど、その代わりにアルコールがそのまま混じったアレがスカートから出てくるから。」","id":"38A0D105-57DD-449F-B324-716B7F59B8F6","duration":5.534557823129251,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","voiceCharacter":"パチュリー・ノーレッジ","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #38","voiceDuration":5.534557823129251,"audioTrack":"track_voice_%E3%83%91%E3%83%81%E3%83%A5%E3%83%AA%E3%83%BC%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%AC%E3%83%83%E3%82%B8","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 38","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_パチュリー・ノーレッジ.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"僕は、自分たちがアレを出していることに気がつかない二人をじっと見る…。ちなみにその薬の別名は、赤ちゃん薬だった。","id":"39F7B42E-3E10-4969-8666-EEFFFFC91D8F","duration":8.040430839002267,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #39","voiceDuration":8.040430839002267,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 39","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「ねぇ、二人を素っ裸にして、何する気なの？」","id":"3147600A-0F6C-4BE4-BFF0-67838B86A964","duration":4.28562358276644,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceCharacter":"古明地こいし","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #40","voiceDuration":4.28562358276644,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 40","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_古明地こいし.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「こいし…、ちょっと手伝って、酔いが回って、アレを漏らしちゃったお二人さんを、浴室に連行するから。」","id":"592AD1FE-F8E9-4CCC-935D-EFDA7D47C42C","duration":6.675646258503401,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #41","voiceDuration":6.675646258503401,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 41","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「はぁ？何言ってるの、あんた。言っておくけど、私は二人の下のお世話なんてしないから、あんた一人でしてね。」","id":"BF6D2036-6E9E-4E52-842B-DD21A2CABD9D","duration":10.031473922902494,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceCharacter":"古明地こいし","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #42","voiceDuration":10.031473922902494,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 42","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_古明地こいし.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「もしかして、こいし…、やけ酒してた？」\n僕は、彼女が普段呼びない呼び方で、僕を呼んだのでそう聞く。","id":"5B205D1B-1D00-4110-824F-EBEE60D94EE5","duration":7.373469387755102,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #43","voiceDuration":7.373469387755102,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 43","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「くっ…、一人で寂しくて、お酒で濁してたのよ、私…」","id":"C2601153-4BFD-44DE-910E-AEE3D5AB387F","duration":5.28562358276644,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceCharacter":"古明地こいし","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #44","voiceDuration":5.28562358276644,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 44","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_古明地こいし.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「ふっ…」僕は、彼女の言動に思わず、そう笑い出してしまう。\n「あれ…酔ってないつもりだけど、酒が回ってきたのかな…」","id":"97D76FCD-3EB2-491B-954D-C1AB1C2B415E","duration":8.516938775510203,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #45","voiceDuration":8.516938775510203,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 45","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「まぁ、いいや。とにかく、アレを漏らしたお二人さんの介護、手伝って、それが済んだら、思う存分頭を撫でてあげるから。」","id":"474D8761-8559-4CBC-98BD-39A08AD09D70","duration":8.461519274376418,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #46","voiceDuration":8.461519274376418,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 46","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「うっ…、分かったわよ、この私が手伝ってあげる。」","id":"91EE203C-BBBD-43F5-BD59-D0C018539895","duration":4.346394557823129,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceCharacter":"古明地こいし","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #47","voiceDuration":4.346394557823129,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 47","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_古明地こいし.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「ふっ」僕は、彼女の言動で何かが外れてしまったのか、そこから彼女が怒鳴り込むまで、大笑いしてしまうのだった。","id":"9B193464-3080-4611-B0D2-D8092E33B552","duration":7.772380952380952,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #48","voiceDuration":7.772380952380952,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 48","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","animationName":"なし"},{"backgroundName":"単色背景","telop":"大学に通う21歳。","id":"4C7140C7-B4CE-4777-ADB8-27351015191E","duration":5,"bgmName":"BGM: 少女綺想曲","voice2StartTimeOffset":0,"characterName":"操夢","transitionName":"なし","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #49","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 49: 大学に通う21歳。","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「んっ…」僕はふと目が覚めると、そこは家の玄関ホールだった。そして、ある感触がし、ふとそれを見る。","id":"CE4FB3E1-9136-4612-A163-0841E3251B51","duration":7.348458049886621,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #50","voiceDuration":7.348458049886621,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 50","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"すると、こいしが僕に抱きつく形で眠っていた。そして、ふと昨晩の記憶を思い出そうとしていると、誰かの視線を感じる。","id":"BAFF3FF0-59F6-477E-90E1-D22585AEEF9A","duration":8.510430839002268,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #51","voiceDuration":8.510430839002268,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 51","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"すると、そこには頬が赤らみ、驚いているフランがいた。\n「あっ、しまった…」僕は、ふとそう呟く。","id":"C719356F-7697-45D7-BEAE-6FD907626CF4","duration":7.074557823129251,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #52","voiceDuration":7.074557823129251,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 52","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"そして、彼女は僕に駆け寄ってくると、僕にビンタをした。","id":"F0DC5FDC-5000-41EF-A47A-1BCF1772FEE2","duration":3.856077097505669,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #53","voiceDuration":3.856077097505669,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 53","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"すると、こいしが目覚める。","id":"7058DD32-C225-44F6-ABF0-A792794A5884","duration":1.7169387755102041,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #54","voiceDuration":1.7169387755102041,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 54","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「えへへ、私、お兄ちゃんと抱き合って寝れた…。」","id":"BB262C45-409A-4D23-9D58-9A25DB728A79","duration":3.9237414965986392,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceCharacter":"古明地こいし","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #55","voiceDuration":3.9237414965986392,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 55","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_古明地こいし.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「紅夢、これはどう言うことなの？私という存在がいながら、こいしとこんなとこで抱き合って寝るなんて。一体…」","id":"B599B8CF-DEC0-4454-AF29-F7B2955C1A40","duration":8.859478458049887,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #56","voiceDuration":8.859478458049887,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 56","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_フランドール・スカーレット.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「でも僕は…」僕はそう言いかけ、ハッとする。なぜなら、高校生の時なら、真っ先にそうなった言い訳を言っていたからだ。","id":"CD06937B-97A3-4D19-A8F5-EBCEF6A0AFA3","duration":8.416938775510204,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #57","voiceDuration":8.416938775510204,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 57","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「私は、お兄ちゃんと一緒に過ごしていれば、安心できるし、いっぱい甘えて、頼れるから、それでいいと思うよ。」","id":"9E169A5E-802D-41AB-8839-893036EA6223","duration":9.473469387755102,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","voiceCharacter":"古明地こいし","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #58","voiceDuration":9.473469387755102,"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 58","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_古明地こいし.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"僕は、こいしの言葉にどこか安心感を覚える。別にこいしが好きなんじゃない、ただその安心という言葉の響きがいいのだ…。","id":"52C732E2-5BC4-49D1-97A6-77914FDE12E6","duration":8.101723356009071,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #59","voiceDuration":8.101723356009071,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 59","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"僕は、自分自身のフランやこいしに対する気持ちや考え方がわからなくなり、困っていると、レミリアの声がする。","id":"478FE30A-961A-4AAA-97A9-F2AF405FD906","duration":7.401723356009071,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #60","voiceDuration":7.401723356009071,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 60","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「ねぇ、あなたとこいしは互いの存在に依存する共依存じゃないかしら…、もしあなたが彼女の発言に安心してたらだけど…」","id":"487FBF0A-B7BD-4A8D-AD76-16CC9F87D117","duration":7.415079365079365,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","voiceCharacter":"レミリア・スカーレット","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #61","voiceDuration":7.415079365079365,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 61","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_レミリア・スカーレット.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"僕は、レミリアの発言に、なぜか納得してしまった。そして、こうつぶやく。「確かに、レミリアさんの意見が正しいです…」","id":"296A8EEF-0DCC-43A6-A66C-BB7CC15C8D11","duration":8.757165532879819,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #62","voiceDuration":8.757165532879819,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 62","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"それから、四人の間には、これまでに感じたことのない冷たく気まずい空気が漂い出す。そして、沈黙の時間が流れる。","id":"1DB882FA-D420-4BDF-8B35-05C34B16CDAE","duration":8.473469387755102,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #63","voiceDuration":8.473469387755102,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 63","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「それで、これからどうするの？あなたの意見を聞かせてもらえないかしら…。じゃないと来月からの予定が狂うのよ。」","id":"FC9E9E3E-517A-44FB-8492-1C8387EA406A","duration":7.054648526077098,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","voiceCharacter":"レミリア・スカーレット","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #64","voiceDuration":7.054648526077098,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 64","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_レミリア・スカーレット.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"「僕は…、この関係が壊れるのは嫌で、フランさんと離婚したくない…、でも、これは僕の単なるわがままですよ…。」","id":"F819E115-5657-4C46-AEE1-BD562640E193","duration":7.316938775510204,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0,"slideTitle":"スライド #65","voiceDuration":7.316938775510204,"audioTrack":"track_voice_soumu","bgmVolume":0.65,"seVolume":1,"voiceStartTimeOffset":0,"title":"シーン 65","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","animationName":"なし"},{"backgroundName":"nc213186_紅魔館ロビー.jpg","telop":"僕は、それからしばらくの間、冷えた笑いに溢れかえる。\nだが、フランが僕の頬を強く叩き、僕はハッと我に帰る。","id":"831ABEEF-6F9B-4A18-9CBB-742B8E89525A","duration":8.238684807256236,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 少女綺想曲","seStartTimeOffset":0,"bgmStartTimeOffset":0