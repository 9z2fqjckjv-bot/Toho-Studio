track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","transitionName":"なし","backgroundName":"4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","bgmVolume":0.7,"id":"131006F8-5462-476C-BA38-C17CCC2CBF98","voiceStartTimeOffset":0,"duration":7.38,"showTelopOverlay":false,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","telop":"僕は、とりあえず人形に埋もれているであろうアリスを見つけるべきだと結論づけ、人形を一つずつ丁寧にどかしていく。"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/苦しそうな寝顔.png","voiceDuration":8.026303854875284,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","title":"シーン 9","animationName":"なし","bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a.009.jpeg","slideTitle":"第9スライド","seVolume":1,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","transitionName":"なし","backgroundName":"4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","bgmVolume":0.7,"id":"C80E6A0A-90E1-4311-8C2D-3E3C6C9ED036","voiceStartTimeOffset":0,"duration":8.026303854875284,"showTelopOverlay":false,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","telop":"そして、どかしてもどかしても、無限に続きそうな人形の山からとても長い時間をかけて、ようやくアリスの姿が見える。"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/苦しそうな寝顔.png","voiceDuration":7.55390022675737,"voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","title":"シーン 10","animationName":"なし","bgmStartTimeOffset":0,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a.010.jpeg","slideTitle":"第10スライド","seVolume":1,"audioTrack":"track_voice_soumu","seStartTimeOffset":0,"characterName":"操夢","transitionName":"なし","backgroundName":"4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","bgmVolume":0.7,"id":"BD32E87B-5207-41FD-A3DB-A4214F2B973F","voiceStartTimeOffset":0,"duration":7.55390022675737,"showTelopOverlay":false,"voice2StartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","telop":"僕は、彼女の姿を見ると、肩を揺さぶって起こそうとする。\n「アリスさん、起きてください！何があったんですか？」"},{"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg","id":"01729254-CA9E-4CC4-B6F9-F9FE2BB9E8D3","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a.011.jpeg","slideTitle":"第11スライド","duration":7.866938775510204,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","bgmVolume":0.7,"title":"シーン 11","showTelopOverlay":false,"transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/苦しそうな寝顔.png","voiceDuration":7.866938775510204,"telop":"すると彼女がわずかに反応し、ごくわずかに声を出す。\n僕は、彼女の背後に手を回し、そんな彼女を抱き上げる。","bgmStartTimeOffset":0,"characterName":"操夢","backgroundName":"4EA70752-958F-5F9A-8615-32AEC94A0BBA.jpg"},{"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/アパートの玄関ホール（照明ON）.jpg","id":"BD7C1FF7-B583-46C4-8BA3-A391244686FB","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a.012.jpeg","slideTitle":"第12スライド","duration":8.662607709750567,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","bgmVolume":0.7,"title":"シーン 12","showTelopOverlay":false,"transitionName":"なし","voice2StartTimeOffset":0,"seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/影あり寝起き顔.png","voiceDuration":8.662607709750567,"telop":"そして、一度廊下に出ると、彼女を床に下ろし、今度は肩を叩きながら揺らす。すると彼女が目覚める。「大丈夫ですか？」","bgmStartTimeOffset":0,"characterName":"操夢","backgroundName":"アパートの玄関ホール（照明ON）.jpg"},{"seVolume":1,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/社会人の日常  第2話 〜彼が研究室で作業をしていると上海が来て...〜\/アパートの玄関ホール（照明ON）.jpg","id":"D5345D35-D3E0-425E-9AF9-0708CC369881","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a\/社会人の日常__第2話_〜彼が研究室で作業をしていると上海が来て___〜_e1300b801a.013.jpeg","slideTitle":"第13スライド","duration":2.8607482993197277,"voiceStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_アリス・マーガトロイド.wav","bgmVolume":0.7,"title":"シーン 13","showTelopOverlay":false,"transitionName":"なし","voice2StartTimeOf