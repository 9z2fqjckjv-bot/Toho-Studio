[{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第1スライド","voiceDuration":3.8723809523809525,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.001.jpeg","animationName":"なし","duration":3.5,"title":"シーン 1","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"D52151CF-515E-4DF4-9563-3C2E96C32DE7","telop":"東方Project二次創作作品\n「んっ…」僕はふと目が覚めると、そこは、地底園の一室だった。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第2スライド","voiceDuration":4.03063492063492,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.002.jpeg","animationName":"なし","duration":5.6000000000000005,"title":"シーン 2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","characterName":"操夢","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"E1A37F1E-A9B5-4224-AF0D-F8027D321979","telop":"そして、ふと横を見る。すると、そこにはすやすや眠るフランの寝顔があった。僕は、彼女を起こさないように起き上がる。\n作成者：zuyasi"},{"backgroundName":"単色背景","slideTitle":"中扉","voiceDuration":2.5222902494331065,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.003.jpeg","animationName":"なし","duration":3,"title":"「んっ…」私は、そう呟きながら、目が覚める。","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_てゐ.wav","characterName":"フランドール・スカーレット","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","transitionName":"なし","id":"1A408B62-067E-4552-BC25-EAC140DC6346","telop":""},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第4スライド","voiceDuration":3.941995464852608,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.004.jpeg","animationName":"なし","duration":3.5,"title":"シーン 4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"3AB25AD5-E0DE-4040-B3A0-DACA2599A781","telop":"「あれ、私はなんでこんなところに…」\nそう呟きながら、ふと隣を見る。\n作成ソフト\nKeynote\nTohoStudio"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第5スライド","voiceDuration":3.6682312925170066,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.005.jpeg","animationName":"なし","duration":5.1000000000000005,"title":"シーン 5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav","characterName":"フランドール・スカーレット","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"D09C46AF-B321-446F-A458-A448F06C8F84","telop":"そして私は、彼の姿を見て、ふと全てを思い出す。\n「ごめん…」私はそう呟くと、ベッドから降り、部屋を出た。"},{"backgroundName":"単色背景","slideTitle":"タイトル","voiceDuration":8.240861678004535,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.006.jpeg","animationName":"なし","duration":3,"title":"東方Project二次創作作品　powerd by zuyasi","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_鈴仙・優曇華院・イナバ.wav","characterName":"","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","transitionName":"なし","id":"7705A4C1-B95B-41E7-A1F5-51F9D6C45436","telop":"彷徨う二人　第10話"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","slideTitle":"第7スライド","voiceDuration":6.5619954648526075,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.007.jpeg","animationName":"なし","duration":4.5,"title":"シーン 7","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_霧雨魔理沙.wav","characterName":"操夢","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","transitionName":"なし","id":"190D7EC2-36F4-40AB-B02A-9315902623CA","telop":"僕は、それから、いなくなったフランの後に続けて、\n部屋を出る。すると、地底園の園長が現れる。"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","slideTitle":"第8スライド","voiceDuration":3.3973696145124714,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.008.jpeg","animationName":"なし","duration":4,"title":"シーン 8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_鈴仙・優曇華院・イナバ.wav","characterName":"古明地さとり","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","transitionName":"なし","id":"3BD1381B-893D-44B5-B83A-DFB000636361","telop":"「あら、目が覚めましたか、さっき、\n連れの女性が、出口の方に走って行きましたよ。」"},{"backgroundName":"nc73545_【背景素材】地霊殿.jpg","slideTitle":"第9スライド","voiceDuration":5.203786848072562,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.009.jpeg","animationName":"なし","duration":4,"title":"シーン 9","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_古明地さとり.wav","characterName":"操夢","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/nc73545_【背景素材】地霊殿.pxd","transitionName":"なし","id":"FC2EC5C1-4C98-4534-B7C3-2391B7400226","telop":"「そうですか、分かりました。」\n僕はそういうと、地底園の出口の方に向かうのだった。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第10スライド","voiceDuration":7.623469387755102,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.010.jpeg","animationName":"なし","duration":5.2,"title":"シーン 10","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_ナレーション.wav","characterName":"フランドール・スカーレット","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"3580A68D-9F31-4C2B-AB6A-1526A4F525FF","telop":"「はぁ、はぁ…」私は、彼にあんなことをしたことをした恥ずかしさのあまり、駅の方に逃げ出してきてしまった。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第11スライド","voiceDuration":2.2419954648526077,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.011.jpeg","animationName":"なし","duration":5.300000000000001,"title":"シーン 11","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","characterName":"フランドール・スカーレット","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"55A0B5BE-4289-4B48-92E0-D71E1C217819","telop":"「私は、いったいなんであんなことを…」私が覚えているのは、彼の血を吸っていたところまでだ。それから私は…。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第12スライド","voiceDuration":4.9419501133786845,"audioTrack":"track_voice_10","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.012.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","duration":4.2,"title":"シーン 12","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","characterName":"フランドール・スカーレット","voiceCharacter":"10","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"30EC0510-9B97-4C1D-9644-53D552756A09","telop":"「フランさん、どうしたんですか、急に走り出して…」\n僕は、驚いている彼女にそう尋ねる。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第13スライド","voiceDuration":3.520748299319728,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.013.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","duration":6.1000000000000005,"title":"シーン 13","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_霧雨魔理沙.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"8E7586A5-8A0C-4BA2-B1C2-CC87B641DF97","telop":"「まもなく、中央新幹線、当駅始発、わくに101号、ユジノサハリンスク行きが参ります。ホームの壁際によってお待ちください。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第14スライド","voiceDuration":6.915850340136054,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.014.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":4.7,"title":"シーン 14","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"F2323FB4-EF4D-4817-8F87-2600EDB1A3FF","telop":"「とりあえず、この列車に乗って北上しましょう。」\n僕は彼女にそう言い、やってきた列車に乗り込む。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第15スライド","voiceDuration":8.521292517006803,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.015.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":4.1000000000000005,"title":"シーン 15","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"8898A7E5-7BA9-4CEA-94E0-B24F35029F8F","telop":"僕たちは、それから列車に乗り込み、座る。\nそして、10分ほど経つと、列車が動き出す。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第16スライド","voiceDuration":9.054489795918368,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.016.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.1000000000000005,"title":"シーン 16","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"399BBF20-F931-4F5E-A638-13B43A7CDE65","telop":"「この列車は、中央新幹線、わくに101号、ユジノサハリンスク行きです。次は、石垣、石垣に泊まります。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第17スライド","voiceDuration":1.306984126984127,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.017.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":4.9,"title":"シーン 17","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"45F70906-CFA6-417A-ABF3-55FEAB0933E4","telop":"「停車駅は、石垣、宮古、那覇、奄美、西之表、鹿児島です。鹿児島以北の停車駅は後ほどご案内します。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第18スライド","voiceDuration":2.0094784580498866,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.018.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":3.5,"title":"シーン 18","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"E469CCD2-98DC-4C2C-8456-0F58AE751D6F","telop":"「これから、どうするの？勢いで乗り込んじゃったけど…。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第19スライド","voiceDuration":5.3965986394557826,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.019.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":4.9,"title":"シーン 19","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_十六夜咲夜.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"78456843-DDE4-4ED0-A2F8-619BCBF19D5B","telop":"「とりあえず、那覇にしましょう。さすがに、ハイペースな長時間乗車の繰り返しは、体に応えますから…」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第20スライド","voiceDuration":0.9119954648526077,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.020.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":3.5,"title":"シーン 20","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"8B7339D3-4FED-42B7-818E-15B1AE0DB1F1","telop":"「そう…」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第21スライド","voiceDuration":7.865850340136054,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.021.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.5,"title":"シーン 21","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"C5CB121F-3C48-4F46-91B8-AE89557B5BFB","telop":"僕は、そこでふと彼女と出会った時から常に携帯しているバックから、パソコンを取り出し、車内Wi-Fiにつなげる。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第22スライド","voiceDuration":8.389478458049886,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.022.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.4,"title":"シーン 22","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"728610EA-678A-4842-A0D1-CDA4F0196DAD","telop":"すると、あるメールが届いていた。「フランさん、さっき那覇で降りると言いましたが、次は名古屋にしましょうか…」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第23スライド","voiceDuration":2.7244897959183674,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.023.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":3.5,"title":"シーン 23","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"89555713-1FB2-4CBE-87DA-7413086AE831","telop":"「なんで？」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第24スライド","voiceDuration":8.610430839002268,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.024.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.300000000000001,"title":"シーン 24","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"14748050-ADDF-4121-9778-877D1DDC985C","telop":"「名古屋で一回、緩行新幹線に乗り換えて、飯田で降りますよ。\nフレラさんがいる屋敷から、メールが届いたので。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第25スライド","voiceDuration":8.534331065759638,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.025.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.800000000000001,"title":"シーン 25","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"CDDF762F-2969-4D47-B8F0-DE5EE37BBE3D","telop":"「どうやら、フランさんに、フレラさんが、もっと聞きたいことがあるみたいですよ。幻想郷の話を聞かせて欲しいとかって…」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第26スライド","voiceDuration":7.254489795918367,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.026.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":3.5,"title":"シーン 26","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"E8B03C7B-F46B-4427-A8AD-396B267B4E89","telop":"「別にいいけど…」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第27スライド","voiceDuration":7.490861678004535,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.027.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.300000000000001,"title":"シーン 27","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"3B3419FD-DF78-45C3-86F8-7680B8BC8F4C","telop":"「とりあえず、名古屋に着くまでは、ゆっくり休んでますか…」\n僕がそう言っていると、車掌のアナウンスが入る。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第28スライド","voiceDuration":1.9589342403628118,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.028.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.800000000000001,"title":"シーン 28","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_八雲紫.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"FCD1AE00-6DA9-4116-A07E-E4D981BE4572","telop":"「お客様に各駅の走行目安をお知らせします。次の石垣には、35分弱、宮古には、55分弱、那覇には1時間35分弱です。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第29スライド","voiceDuration":2.039478458049887,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.029.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":6.2,"title":"シーン 29","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"29FADF1F-E4A5-4390-90D8-A1CFDDBC2FDF","telop":"「奄美には、2時間20分弱、西之表には、3時間10分弱、鹿児島には、3時間35分弱です。それ以後は後ほど、お知らせします。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第30スライド","voiceDuration":4.589478458049887,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.030.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.7,"title":"シーン 30","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"8C0F0461-FE3B-43D1-A292-0E344343F62F","telop":"「なお、鹿児島までの区間の乗車には手荷物検査は不要ですが、本州に入る場合は、必要になります。ご承知おきください。」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第31スライド","voiceDuration":4.672380952380952,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.031.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":4.800000000000001,"title":"シーン 31","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"F7A61601-7B14-4824-8CE8-0422CA3FD6B3","telop":"「名古屋までは、平常時なら、台北から、\n5時間40分くらいですから、それまで、耐えられますか？」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第32スライド","voiceDuration":2.7819954648526077,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.032.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":3.5,"title":"シーン 32","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_フランドール・スカーレット.wav","characterName":"フランドール・スカーレット","voiceCharacter":"フランドール・スカーレット","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"DEE29B54-3767-46CB-A679-67FFB23E0FF4","telop":"「そんなこと言われても…想像つかないや…」"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第33スライド","voiceDuration":2.282154195011338,"audioTrack":"track_voice_soumu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.033.jpeg","animationName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/フラン（困る）.png","duration":5.5,"title":"シーン 33","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","characterName":"操夢","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","id":"E8DB7500-9E0E-43E6-8628-89BC876D0CDD","telop":"「そうですか…」僕は、そう返すと、なぜフレラが、フランの話をもう一度聞きたがるのかな…とそんなこと考え始めた。"},{"voiceCharacter":"","backgroundName":"単色背景","transitionName":"なし","title":"ご視聴ありがとうございました","slideTitle":"中扉","animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/_10__e848632443\/_10__e848632443.034.jpeg","duration":20,"id":"4EB1FBF1-5A98-4FB5-BD3D-47F1ADBE4DE5","telop":"","bgmName":"BGM: 東方妖恋談","characterName":""}]