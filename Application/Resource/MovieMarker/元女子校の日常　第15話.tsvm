uyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_博麗霊夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":2.1294784580498867,"audioTrack":"track_voice_reimu","seVolume":1,"title":"シーン 64","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/霊夢（余裕）.png","slideTitle":"スライド #64","duration":2.7294784580498868,"telop":"「魔理沙、準備はいいわね。」","id":"3E02CCE7-9B21-40F6-B7F1-DEFC2E0B0840","characterName":"博麗霊夢","transitionName":"なし","voiceCharacter":"博麗霊夢","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.065.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_霧雨魔理沙.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":2.4544897959183674,"audioTrack":"track_voice_marisa","seVolume":1,"title":"シーン 65","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/霊夢（余裕）.png","slideTitle":"スライド #65","duration":3.0544897959183674,"telop":"「ああ、もちろんだぜ、霊夢。」","id":"166A3BB8-91F6-43C4-9EA1-F1125FF610A4","characterName":"霧雨魔理沙","transitionName":"なし","voiceCharacter":"霧雨魔理沙","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.066.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_藤原妹紅.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.04748299319728,"audioTrack":"track_voice_%E8%97%A4%E5%8E%9F%E5%A6%B9%E7%B4%85","seVolume":1,"title":"シーン 66","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/霊夢（余裕）.png","slideTitle":"スライド #66","duration":8.64748299319728,"telop":"二人は、何かの確認をすると、いきなり私の服を掴んでくる。\nそして、まんまと服を脱がされると、二人も服を脱ぐ。","id":"5B018C14-395F-4E8B-A073-A6431531A5CE","characterName":"藤原妹紅","transitionName":"なし","voiceCharacter":"藤原妹紅","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.067.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_藤原妹紅.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.407913832199547,"audioTrack":"track_voice_%E8%97%A4%E5%8E%9F%E5%A6%B9%E7%B4%85","seVolume":1,"title":"シーン 67","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #67","duration":9.007913832199547,"telop":"そして、霊夢が私のベッドで、上を向いたまま横になると、魔理沙が私の手を引っ張り、霊夢、魔理沙、私の順で重なる。","id":"B1993EA0-8440-4F4D-A731-84F4709A9965","characterName":"藤原妹紅","transitionName":"なし","voiceCharacter":"藤原妹紅","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg"},{"seName":"SE: ちゃんちゃん♪1","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.068.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_藤原妹紅.wav","voice2StartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ちゃんちゃん♪1.mp3","voiceStartTimeOffset":0,"voiceDuration":3.527687074829932,"audioTrack":"track_voice_%E8%97%A4%E5%8E%9F%E5%A6%B9%E7%B4%85","seVolume":1,"title":"シーン 68","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #68","duration":4.1276870748299315,"telop":"そして、私は、魔理沙にアレを根こそぎ取られるのだった。","id":"AB8DA8CE-7630-4FA6-8C65-A137AE3993C8","characterName":"藤原妹紅","transitionName":"なし","voiceC