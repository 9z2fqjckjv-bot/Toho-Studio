[{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.001.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.25172335600907,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 1","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #1","duration":8.85172335600907,"telop":"僕は、フランに連れられて、とある山間のキャンプ場に来ていた。そして、僕は、彼女にキャンプ用品を持ってきたかを聞く。\n東方Project二次創作作品","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1A646BD6-B8E6-42A4-BFE8-C5ACC90A6746","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.002.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.641995464852608,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 2","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #2","duration":9.241995464852607,"telop":"「もちろん、持ってきたよ。」私はそう言い、車からテントなどのキャンプ用品を取り出し、テントの設営をする。\n作成者：zuyasi","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"36BD903C-54B5-4206-8C43-00FD96C17CD7","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.003.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.493038548752834,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 3: それから、数分から数十分の間、彼女は黙々と、テントの設営やキャンプの準備を進めていく。「何か手伝いますか？」","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #3","duration":9.093038548752833,"telop":"それから、数分から数十分の間、彼女は黙々と、テントの設営やキャンプの準備を進めていく。「何か手伝いますか？」","id":"6F491B9B-5962-423E-BEEB-8C24C0897D76","characterName":"操夢","transitionName":"なし","voiceCharacter":"操夢","backgroundName":"単色背景"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.004.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":5.033242630385487,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 4","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #4","duration":5.633242630385487,"telop":"「いや、手伝わなくていいよ。そこらへんで座って、待ってて。」\n制作ソフト及び協力\nGemini\nTohoStuido","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1D988D72-242F-4E78-8A61-06F0A7CCA92F","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.005.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.260430839002268,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 5","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #5","duration":8.860430839002268,"telop":"僕は、彼女がそう返すと、彼女の作業の邪魔にならない位置で、座って、その作業が終わるまで、周囲を見渡すのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"4183A2E3-FB8C-4379-883F-7552BA521E47","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"bgmStartTimeOffset":0,"animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.006.jpeg","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"title":"シーン 6: 東方Project二次創作作品　Powerd By zuyasi","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #6","duration":2.5,"telop":"元女子校の日常","id":"FB522FD0-84A0-4B6C-89E3-246F3D7345B5","characterName":"操夢","transitionName":"なし","backgroundName":"単色背景"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.007.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.060430839002268,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 7","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #7","duration":7.6604308390022675,"telop":"テントの設営が終わり、夕日が静まると、フランはあらかじめ準備されていた食材とフライパンを焚き火の上に置く。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"7F1D7970-A3FE-4790-BE39-4F9BC56591B5","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.008.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.914489795918367,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 8","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","slideTitle":"スライド #8","duration":8.514489795918367,"telop":"「今晩は、ステーキ丼だよ、紅夢。」\n私はそう言いながら、飯盒を乗せて、お肉を一緒に焼く。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"74128DA9-2571-4297-9BC9-4A3E74775C03","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.009.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":6.43,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 9","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","slideTitle":"スライド #9","duration":7.029999999999999,"telop":"僕は、彼女がそういうと、焚き火の上に置かれた食材を眺める。そして、ふと空を見上げる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"A8EFF462-9CC9-423E-B2E2-92067BB67A3F","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.010.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.769115646258504,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 10","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #10","duration":8.369115646258503,"telop":"そこには、満点の星空が広がっていた。僕は、\nその星空を無言で、眺めていると、フランが声をかける。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"3928CF47-9C7E-4E86-8EA7-B5056636B220","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.011.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.1244897959183673,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 11","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #11","duration":3.7244897959183674,"telop":"「どう、満点の星空を見た感想は？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B611DF5B-13BD-431D-8B3A-14F75E3F3BC2","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.012.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.7539002267573696,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 12","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #12","duration":4.35390022675737,"telop":"「車を数時間走らせて、やってきた価値がありますよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"68872399-6748-4286-8E7F-7287CCCAA1A0","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.013.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_フランドール・スカーレット.wav","voice2StartTimeO