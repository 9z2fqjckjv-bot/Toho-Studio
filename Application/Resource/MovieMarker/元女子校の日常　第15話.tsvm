D\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.031.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.0144897959183674,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 31","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #31","duration":3.6144897959183675,"telop":"「顔が青ざめてるけど…大丈夫なの？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"8672A1F6-241E-4BBC-94D7-231BEBCF0B2D","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.032.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.399546485260771,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 32","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #32","duration":3.999546485260771,"telop":"「すこしだけ、席を外しても、大丈夫ですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"57F4AB27-F7D7-4844-960C-2E862D200857","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.033.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":10.730748299319728,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 33","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #33","duration":11.330748299319728,"telop":"「もし、何かあるんだったら、私にいってね。」私は、不安が残りながら、彼にそう言うと、彼は、森林の中に入っていった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"4207C4E1-B8C5-4153-9D91-27BEBFEFD6F4","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"bgmStartTimeOffset":0,"animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.034.jpeg","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"title":"シーン 34: その頃、某所では…","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #34","duration":3,"telop":"その頃、某所では…","id":"18425732-B3B5-4B88-A319-1BF39AE06847","characterName":"操夢","transitionName":"なし","backgroundName":"単色背景"},{"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.035.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":4.115079365079365,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 35","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（驚く）.png","slideTitle":"スライド #35","duration":4.715079365079364,"telop":"私は、一人自室で、くつろいでいると、二人の様子が見える。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"0BF86F99-62EB-400A-AC52-52541AF51E09","transitionName":"なし","characterName":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.036.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":6.360907029478458,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 36","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","slideTitle":"スライド #36","duration":6.960907029478458,"telop":"「一体何があったの…、フラン…、紅夢…」\n私は、不安な気持ちになりながら、そう一人つぶやく。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"6F204D04-98CE-4778-8C8A-D3D66D807BAE","transitionName":"なし","characterName":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.037.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.583832199546485,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 37","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #37","duration":8.183832199546485,"telop":"すると、今度ははっきりと、二人の様子が見える。「これは、緊急事態ね…」私はそう言いながら、電話をかける。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D1A0A235-855E-4A82-B760-AF527A858943","transitionName":"なし","characterName":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.038.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"title":"シーン 38","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #38","duration":4,"telop":"フランに視点が写り…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F9CB0877-80C6-482A-8E7C-719CB7943FC5","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.039.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":10.089478458049886,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 39","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #39","duration":10.689478458049885,"telop":"私は、それから、数十分の間、待っていたが、一向に彼が戻ってくる気配を感じず、探しにいくべきか、迷っていた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"2C7B8027-277B-498C-A335-EF1A43155F4C","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","seName":"SE: nc321386_[東方アレンジ]_495年のジャズフェスティバル_U.N.オーエンは彼女なのか？","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.040.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc321386_[東方アレンジ]_495年のジャズフェスティバル_U.N.オーエンは彼女なのか？.mp3","voiceStartTimeOffset":0,"voiceDuration":8.430748299319728,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":0.389404296875,"title":"シーン 40","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #40","duration":9.030748299319727,"telop":"すると、ふと持ってきたバックから音が出ているように感じ、\n中を開けると、それは私のポケベルの着信音だった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"08F6D6D6-2503-4808-8159-375610C7C699","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.041.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":6.314489795918368,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 41","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #41","duration":6.914489795918367,"telop":"私は、通話ボタンを押すと、耳にかざす。\n「お姉様…、どうしよう…、彼が…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D2F64DF7-F4E1-43F3-A7D7-1293F812F8B2","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.042.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.58798185941043,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 42","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #42","duration":9.18798185941043,"telop":"「フラン、よく聞いて、ちょうだい。今すぐに、彼を探して。だけど、日付が変わる前に見つけ出せなかったら、報告して。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"303AE636-F93F-4312-B6C1-F7680B91948F","transitionName":"なし","characterName":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.043.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":4.978231292517007,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 43","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #43","duration":5.578231292517007,"telop":"「分かった…」私は通話を切ると、彼の姿を探し始めた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"F080D0CE-52FE-4897-BDEC-B1842CFC35B3","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.044.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":9.20281179138322,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 44","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #44","duration":9.80281179138322,"telop":"「はぁ、はぁ。」僕は、荒い息をしながら、森の中を彷徨った。\nすると、先ほど蘇った過去が頭の中で勝手に流れる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"8D80F0B0-070A-490A-A048-9A031EBCF4F4","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.045.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":2.909342403628118,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 45","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #45","duration":3.5093424036281182,"telop":"僕の意識は、あと少しで吹き飛びそうだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"96B0BE94-37CA-4C6A-8173-B18345787A6A","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.046.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.869478458049887,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 46","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #46","duration":9.469478458049887,"telop":"「紅夢、どこにいるの？聞こえたら返事して…」私は、暗い夜の森でそう呼びかけながら、彼の姿を探す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"EE07BD10-10FF-4C74-B71F-88E6D7F53F61","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.047.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.866984126984127,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 47","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #47","duration":9.466984126984126,"telop":"「紅夢？どこにいるの？」私は、だんだんと早足になるのを自覚しながら、彼の姿を必死に探し出す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"AB078C6F-6C28-44AF-A690-96C4BF2DAE98","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.048.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.991950113378685,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 48","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #48","duration":9.591950113378685,"telop":"僕は、その攻撃に抵抗しながら、意識が切れないようにする。\nだが、僕ができる唯一の対抗策は、ひたすら逃げるだけだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"3B00B057-BA9B-4E7A-8267-3F4BF726B55B","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.049.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":6.509342403628118,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 49","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #49","duration":7.109342403628117,"telop":"だが、それも長くは続かず、僕は何か躓くと、\nこけてしまい、そのまま意識が落ちていった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"20A2E820-6770-4E38-AD63-383C644DDD18","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.050.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":10.809478458049886,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 50","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #50","duration":11.409478458049886,"telop":"私は、彼の姿を探しながら、ポケベルの時間を確認する。時刻は、午後9時だった。彼が席を外してから数時間だった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"FC5FB843-6962-4B99-8AB3-64AA00B29EBC","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.051.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":10.181995464852609,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 51","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #51","duration":10.781995464852608,"telop":"「紅夢、どこにいるの…」私は、気がつけば、木々の合間を縫うように走りながら、彼を探していた。だが、まだ見つからない。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"AD7C02B3-34B1-4EC6-BB88-966F104794A3","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.052.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":10.608231292517006,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 52","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #52","duration":11.208231292517006,"telop":"そして、ふとポケベルの時間を確認する。あと数十分で日付が変わるところだった。だが、私は時間を気にせず、彼を探す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B052F578-9A86-413D-965A-AB79113E1670","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.053.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.436507936507937,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 53","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideTitle":"スライド #53","duration":8.036507936507936,"telop":"「んっ…」僕は、ふと目が覚めて、周りを見る、するとそこには、こっちを見ながら、不気味に笑う彼女がいた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"8A60F411-4220-4C98-8CD1-7205054F40FF","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.054.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":1.166938775510204,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 54","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideTitle":"スライド #54","duration":2.5,"telop":"「フラン…さん…？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"73FE64D7-C162-4EFC-B09C-0E544CB11321","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.055.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":1.0844897959183672,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 55","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideTitle":"スライド #55","duration":2.5,"telop":"「見ーつけた。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"0B8DF684-37F0-4B45-A66F-7D1CC58F0CAF","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.056.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":9.173469387755102,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 56","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideTitle":"スライド #56","duration":9.773469387755101,"telop":"僕は、彼女の気配から、直感的に、次の行動を予測する。\nそして、彼女とは反対方向に、回転し、立ち上がる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"2039D34B-7ABB-45A5-A174-6CE2D1A7855C","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.057.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.651723356009071,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 57","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（狂気）.png","slideTitle":"スライド #57","duration":8.251723356009071,"telop":"そして、彼女がこちらに襲いかかるタイミングで、背後に回り、\n腕に力を込めると、それを彼女の首筋に当てる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"1D08DC2A-9309-4796-9CAF-E7F061072AFB","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.058.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.577823129251701,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 58","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #58","duration":4.177823129251701,"telop":"すると、彼女は何かを言いながら、その場に倒れ込む。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D8F6BDAD-D6AF-4EDB-B1FF-F36582EBCAD0","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.059.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.95281179138322,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 59","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #59","duration":8.55281179138322,"telop":"そして、僕は、今何をしたのかを理解すると共に、再び頭痛に晒されて、彼女に被さるように倒れ込むのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"CC3A6338-69AC-4196-995B-FC917E5D8D32","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.060.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.487981859410431,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 60","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #60","duration":8.087981859410432,"telop":"私は、フランに電話をしたあと、ずっとそわそわしていた。そして、ふと時計を見ると、時刻は真夜中を指していた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"4F404D6A-CD0D-4710-A2BA-E4D4E1C95C0B","transitionName":"なし","characterName":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"レミリア・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.061.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_レミリア・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.454081632653061,"audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 61","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #61","duration":9.05408163265306,"telop":"「フラン、今から、私がそっちに向かうから、待ってなさい。」\n私は、そう言い、家を離れ、その場所に飛んで向かうのだった。","backgroundImagePath":"\