h":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.1744897959183676,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 15","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #15","duration":3.7744897959183676,"telop":"「そう…、ほら、そろそろご飯ができるよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"02B60343-4E58-4F57-9E63-A01A87CC8F56","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.016.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.338684807256236,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 16","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","slideTitle":"スライド #16","duration":8.938684807256235,"telop":"僕は、彼女にそう言われ、視線を戻すと、彼女は、どこからか紙皿を取り出し、焼き上がった肉を乗せて、僕に渡す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"EEA08893-F707-47AC-B368-E5919C35E496","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.017.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":10.661995464852607,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 17","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #17","duration":11.261995464852607,"telop":"「ほら、出来たよ。」私はそう言い、紙皿に乗せたステーキを彼に渡すと、飯盒を取り、川の水に少しだけつけて、彼に渡す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"8A65A163-15CE-4891-9D6F-1C6F34FF02B5","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.018.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.976984126984127,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 18","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","slideTitle":"スライド #18","duration":8.576984126984128,"telop":"「じゃあ、出来たのご飯、食べよ。」\n私は彼にそう言うと、私たちは、出来た料理を食べ進めた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"ED1546A7-E652-43CD-A6BC-BED38170A97E","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.019.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"seVolume":1,"title":"シーン 19","seStartTimeOffset":0,"bgmVolume":0.7,"slideTitle":"スライド #19","duration":3.5,"telop":"二人は夕飯を終えると…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"B11B2359-4C79-4814-8501-55BECB37CAEB","transitionName":"なし","characterName":"ナレーション","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.020.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":8.436507936507937,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 20","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","slideTitle":"スライド #20","duration":9.036507936507936,"telop":"僕と彼女は、夕飯を済ますと、飯盒だけ、水で軽く洗い、焚き火のそばに隣同士で座り、静寂の時間を過ごす。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"A307E5C3-8D5E-45B9-8E63-D724A94E3FED","transitionName":"なし","characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/k