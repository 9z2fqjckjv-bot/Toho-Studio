ckgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"フランドール・スカーレット","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.023.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_フランドール・スカーレット.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":3.4032426303854875,"audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","seVolume":1,"title":"シーン 23","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #23","duration":4.003242630385487,"telop":"「へぇ…、それじゃあ、外出することはあった？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D6D37046-CA5C-496A-A696-B07F885BFEB2","transitionName":"なし","characterName":"フランドール・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第15話_39db79552f\/元女子校の日常　第15話_39db79552f.024.jpeg","animationName":"なし","bgmStartTimeOffset":0,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voice2StartTimeOffset":0,"voiceStartTimeOffset":0,"voiceDuration":7.760430839002267,"audioTrack":"track_voice_soumu","seVolume":1,"title":"シーン 24","seStartTimeOffset":0,"bgmVolume":0.7,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","slideTitle":"スライド #24","duration":8.360430839002268,"telop":"「外出することも、滅多になかったです…、小さかった頃は学校の目の隙をついて、母と出かけることはありましたが…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\