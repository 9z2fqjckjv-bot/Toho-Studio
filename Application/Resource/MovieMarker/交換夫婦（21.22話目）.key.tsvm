[{"title":"東方Project二次創作 powerd by zuyasi※ニコニコ版とは内容が異なります。","characterName":"","slideTitle":"タイトル","duration":3,"animationName":"フェードイン","backgroundName":"単色背景","telop":"交換夫婦","transitionName":"クロスディゾルブ","id":"7A4C2D74-04BA-4635-AB6C-225BB54D7E7B"},{"title":"シーン 2","characterName":"霧雨魔理沙","slideTitle":"第2スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「んっ…」\n私は、ふと目が覚めると、ベッドから降りる。","transitionName":"クロスディゾルブ","id":"AC1DC971-AA89-486C-B20D-A8B859F25FED"},{"title":"シーン 3","characterName":"霧雨魔理沙","slideTitle":"第3スライド","duration":5.6000000000000005,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"そして、リビングに来ると、食卓の上に、置き手紙を見つける。\n私は、その手紙を読むと、顔が青ざめていき、霊夢を探す。","transitionName":"クロスディゾルブ","id":"A536AC3D-103E-4CDC-B7E2-B817A318CE28"},{"title":"シーン 4","characterName":"霧雨魔理沙","slideTitle":"第4スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「霊夢！」\n私は、そう彼女の名前を呼びながら、彼女の体を揺らす。","transitionName":"クロスディゾルブ","id":"CA1B3EC1-0B1B-4D55-9C15-82154E8C8C31"},{"title":"シーン 5","characterName":"博麗霊夢","slideTitle":"第5スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"私は、誰かに体をゆすられ目覚めると、くしゃみが出る。\n「どうしたのよ、魔理沙？」","transitionName":"クロスディゾルブ","id":"36905A1E-EAB5-4865-97E9-48DF4049C50C"},{"title":"シーン 6","characterName":"霧雨魔理沙","slideTitle":"第6スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「操夢が…いない…」","transitionName":"クロスディゾルブ","id":"0F07C8BD-B18A-4639-AD9B-E8A6B21BD514"},{"title":"シーン 7","characterName":"博麗霊夢","slideTitle":"第7スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「えっ？」\n私は、魔理沙の言葉で、だんだんと頭が冴えてくる。","transitionName":"クロスディゾルブ","id":"BD139A75-B209-4A94-8C84-23BCA3B64978"},{"title":"シーン 8","characterName":"博麗霊夢","slideTitle":"第8スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「ねぇ、もう一回言ってちょうだい、魔理沙。」","transitionName":"クロスディゾルブ","id":"F08BE252-1319-4264-A1B2-3AA7A0B7F651"},{"title":"シーン 9","characterName":"霧雨魔理沙","slideTitle":"第9スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「操夢が消えたんだよ…さとりとこいしがそれに気づいて、情報収集に出かけているって置き手紙が…」","transitionName":"クロスディゾルブ","id":"C4C059F9-6248-4EB3-BE75-8CD7BD25BB13"},{"title":"シーン 10","characterName":"博麗霊夢","slideTitle":"第10スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「それ、本当なの？」","transitionName":"クロスディゾルブ","id":"7397BD24-81CB-4AF2-A140-C7CAB70B685B"},{"title":"シーン 11","characterName":"霧雨魔理沙","slideTitle":"第11スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「ああ、とりあえず、今すぐ支度して、操夢を探さないと…」","transitionName":"クロスディゾルブ","id":"194A5F61-B6BB-493B-B621-A3D8D8304278"},{"title":"シーン 12","characterName":"博麗霊夢","slideTitle":"第12スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「操夢のポケベルは？」","transitionName":"クロスディゾルブ","id":"FB5FC1D8-D084-4164-B0BD-1EC4D0686397"},{"title":"シーン 13","characterName":"霧雨魔理沙","slideTitle":"第13スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「操夢のポケベルは、置き手紙と一緒にあった。」","transitionName":"クロスディゾルブ","id":"7D794FC7-4907-4926-97FB-61328BF6ED8D"},{"title":"シーン 14","characterName":"博麗霊夢","slideTitle":"第14スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「分かったわ…空から彼を一緒に探しましょ。」","transitionName":"クロスディゾルブ","id":"B147C630-6ADB-405B-B3BD-ECF42D6249C5"},{"title":"シーン 15","characterName":"霧雨魔理沙","slideTitle":"第15スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「いや、霊夢は地上から探してくれ、私が空から探す。」","transitionName":"クロスディゾルブ","id":"7E815FE8-FBE8-4B3A-A7D9-7538CEC58939"},{"title":"シーン 16","characterName":"博麗霊夢","slideTitle":"第16スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・月明り・赤）.jpg","telop":"「じゃあ、私も支度済ませたら、彼を探し始めるわ…」\n私はそう言って、彼を探すための準備を始めた。","transitionName":"クロスディゾルブ","id":"F947F900-FD9D-42EF-95F3-3A18A5D9CA8F"},{"title":"その頃、さとりとこいしは…","characterName":"古明地さとり","slideTitle":"中扉","duration":3,"animationName":"フェードイン","backgroundName":"単色背景","telop":"","transitionName":"クロスディゾルブ","id":"EC80858F-A4D2-4F17-B4F4-C3E2946E4B57"},{"title":"シーン 18","characterName":"古明地さとり","slideTitle":"第18スライド","duration":4,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私とこいしは、置き手紙を家に残すと、警察署に来ていた。\n「それで、何か情報は…？」","transitionName":"クロスディゾルブ","id":"884C5E58-641B-441F-9968-E4446CC18B35"},{"title":"シーン 19","characterName":"ナレーション","slideTitle":"第19スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「今現在だと、情報はないです。ただ、あることを除けば…」","transitionName":"クロスディゾルブ","id":"FD82D267-FABD-458B-A1CA-FC1D58F08523"},{"title":"シーン 20","characterName":"古明地さとり","slideTitle":"第20スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「あることって、なんですか？」","transitionName":"クロスディゾルブ","id":"BC346CB8-56ED-48CC-AB03-3C4AF284463E"},{"title":"シーン 21","characterName":"ナレーション","slideTitle":"第21スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「今日の夕方ごろに警察のシステムトラブルが起きたんです。」","transitionName":"クロスディゾルブ","id":"817EB118-B30F-431F-A1D5-E26EBCA81426"},{"title":"シーン 22","characterName":"古明地さとり","slideTitle":"第22スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それで具体的には？」","transitionName":"クロスディゾルブ","id":"D4AE9E13-C2CD-43C3-A97F-1BD59028B44E"},{"title":"シーン 23","characterName":"ナレーション","slideTitle":"第23スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「いや、それは内部情報なので…」","transitionName":"クロスディゾルブ","id":"06D75397-439E-4011-A3B1-F3CFEA4C9A68"},{"title":"シーン 24","characterName":"古明地さとり","slideTitle":"第24スライド","duration":4.3,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「分かりました…失礼しました…」\n私は、ひっそりとその警官の心を覗くと、その場をさった。","transitionName":"クロスディゾルブ","id":"1A69FEA4-0C4E-44BF-936C-C7852FB3A127"},{"title":"シーン 25","characterName":"古明地さとり","slideTitle":"第25スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「それで、こいしは何か情報を見つけたの？」","transitionName":"クロスディゾルブ","id":"8BAB2DBC-2443-49E4-B4AD-A21038088851"},{"title":"シーン 26","characterName":"古明地こいし","slideTitle":"第26スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「少しだけなら…」","transitionName":"クロスディゾルブ","id":"7934355C-9DD6-4A84-BFD9-6EE8514112A6"},{"title":"シーン 27","characterName":"古明地さとり","slideTitle":"第27スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「どんな情報なの？」\n私がそう問いかけると、彼女は私に耳打ちする。","transitionName":"クロスディゾルブ","id":"1E2B6938-9CA7-4ACA-A07E-43568C79B733"},{"title":"シーン 28","characterName":"古明地さとり","slideTitle":"第28スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「それ、私が覗き見た思考と一緒ね…」","transitionName":"クロスディゾルブ","id":"E369C2AD-9FB7-4F59-BFEE-8A0C071C1C6C"},{"title":"シーン 29","characterName":"古明地こいし","slideTitle":"第29スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「それで、これからどうする？宿に戻る？」","transitionName":"クロスディゾルブ","id":"77AB5690-EC64-4D33-94D8-13667F1903A7"},{"title":"シーン 30","characterName":"古明地さとり","slideTitle":"第30スライド","duration":5.6000000000000005,"animationName":"フェードイン","backgroundName":"nc256639_警察署（夜）.jpg","telop":"「ええ、とりあえず、宿に戻って、霊夢たちと話し合いましょ。」\n私がそういうと、私とこいしは宿までの道を歩き出した。","transitionName":"クロスディゾルブ","id":"89889FF6-E893-4EBE-9399-42273D81BB10"},{"title":"シーン 31","characterName":"ナレーション","slideTitle":"第31スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼女たちが宿に戻ると…","transitionName":"クロスディゾルブ","id":"4DBFCF70-2104-4D72-9160-99CC319D5EE4"},{"title":"シーン 32","characterName":"古明地さとり","slideTitle":"第32スライド","duration":4.3,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"私とこいしが宿に戻ると、霊夢と魔理沙が食卓に座っていた。\n「二人は、彼を見つけたの？」","transitionName":"クロスディゾルブ","id":"405E6E47-F964-4D3F-98ED-EA68A707177B"},{"title":"シーン 33","characterName":"博麗霊夢","slideTitle":"第33スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"「いや、彼の姿は見つけられなかったわ。」\n私は、くしゃみを出しながら、そういう。","transitionName":"クロスディゾルブ","id":"8A473C6D-D437-4B05-B6BE-F677C5DEFB66"},{"title":"シーン 34","characterName":"古明地さとり","slideTitle":"第34スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"私はそこで、ふと思い出す。\n「今は確か…2月よね…。」","transitionName":"クロスディゾルブ","id":"C72692FA-9D50-4A69-B5A1-F932C9F3D1FE"},{"title":"シーン 35","characterName":"霧雨魔理沙","slideTitle":"第35スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"私が、そう呟くと、二人は、驚きの表情を浮かべる。","transitionName":"クロスディゾルブ","id":"7A046445-D440-4702-9386-A3EE08B0361E"},{"title":"シーン 36","characterName":"霧雨魔理沙","slideTitle":"第36スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"「なんだか、季節感がバグってるわ…」","transitionName":"クロスディゾルブ","id":"EE409E5D-F053-481A-852D-BD1FF19C0479"},{"title":"シーン 37","characterName":"霧雨魔理沙","slideTitle":"第37スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"「そうなのだぜ…」","transitionName":"クロスディゾルブ","id":"80B89FF9-E835-4FD6-9FF1-6FD042C0DC48"},{"title":"シーン 38","characterName":"古明地こいし","slideTitle":"第38スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"「ねぇ、とりあえず操夢を探すのは明日にして、今日はもう寝ない…、みんな風邪気味みたいだし…」","transitionName":"クロスディゾルブ","id":"46A74461-6EC6-47F8-B987-B89BAADA9EC1"},{"title":"シーン 39","characterName":"古明地こいし","slideTitle":"第39スライド","duration":5.4,"animationName":"フェードイン","backgroundName":"nc268706_リビング２（夜・照明ON）.jpg","telop":"こいしが放った言葉は事実で、私とこいしも体調が崩れていたので、私たちはこいしの意見に賛同し、寝室に向かった。","transitionName":"クロスディゾルブ","id":"69AF4B2E-AD07-44F5-9D00-B4FF7E6B619E"},{"title":"その頃、文たちは…","characterName":"射命丸文","slideTitle":"中扉","duration":3,"animationName":"フェードイン","backgroundName":"単色背景","telop":"","transitionName":"クロスディゾルブ","id":"585289A7-DAA9-4C47-A39C-646F5E03DBE4"},{"title":"シーン 41","characterName":"射命丸文","slideTitle":"第41スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私たちは、彼を攫った後、私があらかじめ用意しておいた事業用ジェット機で家に戻り、その後にとある施設に来ていた。","transitionName":"クロスディゾルブ","id":"DDB21C25-BA5C-49F4-819E-DA255554E111"},{"title":"シーン 42","characterName":"射命丸文","slideTitle":"第42スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"この施設は、首相官邸の地下にある\n施設とそっくりな構造をしていた。","transitionName":"クロスディゾルブ","id":"37E2DCF2-1450-4D49-8087-D7B773658F48"},{"title":"シーン 43","characterName":"赤面","slideTitle":"第43スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「どうかしら、この施設を見て、\nにとりが使っている施設と比べて…」","transitionName":"クロスディゾルブ","id":"A5F5A9E8-EB62-48A9-B2C9-7393B4DE4218"},{"title":"シーン 44","characterName":"赤面","slideTitle":"第44スライド","duration":5.7,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「にとりが使っている施設とそっくりです。それで、あなたは、姉によって島送りの刑にされたことを、今も恨んでますか？」","transitionName":"クロスディゾルブ","id":"6FE0B651-CD92-4544-BB2B-F0C94E4B6447"},{"title":"シーン 45","characterName":"赤面","slideTitle":"第45スライド","duration":5.9,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ええ、もちろん。まぁ、それが原動力となって、彼の祖先をベースにした人工知能細胞や、プログラムが生まれてるのですよ。」","transitionName":"クロスディゾルブ","id":"1B849622-19B6-4236-BECB-FC3299DF1152"},{"title":"シーン 46","characterName":"赤面","slideTitle":"第46スライド","duration":4.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それで、急に彼を攫いたいと言い出して、ここまできましたけど、何をするつもりなのですか？」","transitionName":"クロスディゾルブ","id":"7825CD4B-2DB4-426C-8B1A-D644CAC43582"},{"title":"シーン 47","characterName":"赤面","slideTitle":"第47スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それは…彼の最新の状態を解析するんですよ。」\n私はそういうと、あるスイッチを押す。","transitionName":"クロスディゾルブ","id":"2068E78B-6D5B-4A95-BC4E-8D11CE7E2DA9"},{"title":"シーン 48","characterName":"赤面","slideTitle":"第48スライド","duration":4.4,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼女が何かのスイッチを入れると、円球が動き出し、プロジェクターであるものが映し出される。","transitionName":"クロスディゾルブ","id":"1504EC47-AA50-41C7-AA9C-16E245082148"},{"title":"シーン 49","characterName":"赤面","slideTitle":"第49スライド","duration":5.800000000000001,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「これが、あなたが望んでいたスクープ記事ですよ。それで、あとの条件は、彼をあなたの家にお持ち帰りするんでしたっけ？」","transitionName":"クロスディゾルブ","id":"02E7F3F6-F1D4-4250-A95D-6D89900C963D"},{"title":"シーン 50","characterName":"赤面","slideTitle":"第50スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ええ、この記事のデータが入ったメモリーは？」","transitionName":"クロスディゾルブ","id":"9263B67C-B7BC-4D0B-9106-9893A7BC0C68"},{"title":"シーン 51","characterName":"赤面","slideTitle":"第51スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私は彼女に尋ねられたメモリーを取り出し、彼女に渡す。\n「これが、メモリーです。それで何か聞きたいことは？」","transitionName":"クロスディゾルブ","id":"4048909E-5586-4DF1-BCBA-DB7F3ED3B34B"},{"title":"シーン 52","characterName":"赤面","slideTitle":"第52スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「聞きたいことですか…、今は特にないですよ。このスクープ記事を載せて、彼をお持ち帰りできれば、満足ですから…」","transitionName":"クロスディゾルブ","id":"D9A9D7AA-FA96-4C84-B8AB-A59F07B7FEA2"},{"title":"シーン 53","characterName":"赤面","slideTitle":"第53スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…、では、しばらくの間、\n部屋の外で待っていてもらっても大丈夫ですか？」","transitionName":"クロスディゾルブ","id":"94AB0BBC-4F4B-4E67-B3F1-886CD6242D55"},{"title":"シーン 54","characterName":"赤面","slideTitle":"第54スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「分かりました。では、終わったら言ってください。」\n私はそういうと、その部屋から出た。","transitionName":"クロスディゾルブ","id":"F063279C-3037-475A-B310-98814EB211D4"},{"title":"シーン 55","characterName":"赤面","slideTitle":"第55スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「さてと、早速彼の”検査”を始めましょうか…」\n私はそういうと、彼にあるものを取り付けて、検査を始めた。","transitionName":"クロスディゾルブ","id":"BC3D0018-6618-4F49-AE84-A33DEC0B45FB"},{"title":"シーン 56","characterName":"ナレーション","slideTitle":"第56スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"操夢が目覚めると…","transitionName":"クロスディゾルブ","id":"4CDD897F-8932-47A1-AB3E-3B675D8C513E"},{"title":"シーン 57","characterName":"操夢","slideTitle":"第57スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「んっ、あれ…、ここは…」\n僕は、瞼を擦りながら、ふと体を起こす。","transitionName":"クロスディゾルブ","id":"C551B887-FEB0-4B40-B3EA-B14296743953"},{"title":"シーン 58","characterName":"射命丸文","slideTitle":"第58スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「おや、目が覚めたんですね、操夢さん。」","transitionName":"クロスディゾルブ","id":"392BBBC2-7C1F-4171-9377-7941E4DC5DEE"},{"title":"シーン 59","characterName":"射命丸文","slideTitle":"第59スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"僕は、彼女の言葉で、頭が急に冴えた感覚がして、ふと彼女を見つめる。すると、彼女の情報が目に透けて見える。","transitionName":"クロスディゾルブ","id":"CC892ADB-E26F-4215-B2C9-D250CABC409A"},{"title":"シーン 60","characterName":"射命丸文","slideTitle":"第60スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「ここは、文さんの家ですか…？」","transitionName":"クロスディゾルブ","id":"667104A7-90DE-4FBD-B10C-DAD4A3CF344C"},{"title":"シーン 61","characterName":"射命丸文","slideTitle":"第61スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「よく分かりましたね…」\n私は、彼が瞬時に自分の状況を把握しているのだと感じる。","transitionName":"クロスディゾルブ","id":"E45C09A4-0AD8-42CC-84F0-CC4365A56F5E"},{"title":"シーン 62","characterName":"射命丸文","slideTitle":"第62スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「それで、これからどうします、ご飯にします？お風呂にします？それとも…わ・た・し？」","transitionName":"クロスディゾルブ","id":"8BA6572C-931A-43ED-9201-18BC8521ED7D"},{"title":"シーン 63","characterName":"射命丸文","slideTitle":"第63スライド","duration":5.6000000000000005,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「えっと…」僕はそう呟きながら、3つの選択肢から何が起きるかを予測し、分析する。「文さんは、何がしたいですか？」","transitionName":"クロスディゾルブ","id":"5E304F62-DBE6-44DD-A0EC-0D4DABB14BA9"},{"title":"シーン 64","characterName":"射命丸文","slideTitle":"第64スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「私ですか…、すこし着替えてきても大丈夫ですか？」","transitionName":"クロスディゾルブ","id":"EDE5B8AF-4EBE-40ED-BC7A-538275D61219"},{"title":"シーン 65","characterName":"射命丸文","slideTitle":"第65スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"彼女がそう聞くと、僕は彼女の次の行動を予測してから答える。\n「いいですよ…、それで、何か飲み物はありませんか？」","transitionName":"クロスディゾルブ","id":"08A2A6AF-9A89-475F-9CBA-C892362CCE13"},{"title":"シーン 66","characterName":"射命丸文","slideTitle":"第66スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"昭和レトロな茶の間（照明ON）.jpg","telop":"「もちろん、ありますよ。少し待っててくださいね…」\n私は、そう言うと、部屋を離れた。","transitionName":"クロスディゾルブ","id":"8D2F2BC8-B585-4D2F-BCB8-3D2914F543BD"},{"title":"シーン 67","characterName":"ナレーション","slideTitle":"第67スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"数分後…","transitionName":"クロスディゾルブ","id":"4084DF75-C573-4F14-875E-9B9BF8EF2542"},{"title":"シーン 68","characterName":"射命丸文","slideTitle":"第68スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「お待たせしました。」\n私はそう言いながら、瓶をちゃぶ台に置く。","transitionName":"クロスディゾルブ","id":"BC95BDD6-8E8E-41C0-BE3B-A4257F236F4F"},{"title":"シーン 69","characterName":"射命丸文","slideTitle":"第69スライド","duration":3.8000000000000003,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「さて、一緒にこのワインでも飲みながら、\n朝日が昇るまで、語り合いましょ…？」","transitionName":"クロスディゾルブ","id":"B240DA0A-D89E-48D6-BE48-FFEEF4FAA7B3"},{"title":"シーン 70","characterName":"射命丸文","slideTitle":"第70スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ええ、もちろん。」\n僕は、頭がフル回転の状態で、彼女と会話を始めた。","transitionName":"クロスディゾルブ","id":"229475DB-150F-4C74-A099-982F957F58A9"},{"title":"シーン 71","characterName":"ナレーション","slideTitle":"第71スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"日付が変わってしばらく経つと…","transitionName":"クロスディゾルブ","id":"0A7BE40E-CC64-4897-B2DC-50EF0B99FA3A"},{"title":"シーン 72","characterName":"射命丸文","slideTitle":"第72スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼女と話し始めると、会話が弾み、気がつけば日付が変わり、そこからまた数時間程度がたっていた。","transitionName":"クロスディゾルブ","id":"1D016D20-DE1B-4655-B3EC-0EAF9E7349E5"},{"title":"シーン 73","characterName":"射命丸文","slideTitle":"第73スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「どうです、私との二人だけの時間は、楽しいですか？」","transitionName":"クロスディゾルブ","id":"7C924D2B-FB99-4031-AF36-7A4E0CDAE75B"},{"title":"シーン 74","characterName":"射命丸文","slideTitle":"第74スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「とても楽しいですよ。」\n僕は、そう笑みを見せながらいう。","transitionName":"クロスディゾルブ","id":"4A70A6FE-5AD0-44D8-AFCA-2C520881B020"},{"title":"シーン 75","characterName":"射命丸文","slideTitle":"第75スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…」\n私はそう言いながら、ゆっくりと彼に手を伸ばす。","transitionName":"クロスディゾルブ","id":"0CC13BB8-AFFA-414A-9858-6A92D755FE69"},{"title":"シーン 76","characterName":"操夢","slideTitle":"第76スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、彼女がキスの構えをとると、素早く応じる。","transitionName":"クロスディゾルブ","id":"95B50048-289E-44C6-8F22-6948752D0943"},{"title":"シーン 77","characterName":"射命丸文","slideTitle":"第77スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ん…」\n私は、彼を抱き寄せるような形で彼の背中に手を伸ばす。","transitionName":"クロスディゾルブ","id":"66414739-4664-4689-9D6E-831226E2F0CD"},{"title":"シーン 78","characterName":"射命丸文","slideTitle":"第78スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「どうです…このままイっちゃいますか？」\n私は、そう口ずさむ。","transitionName":"クロスディゾルブ","id":"ABF30DB9-1C88-46C1-BFB5-FCCE3881E1E1"},{"title":"シーン 79","characterName":"射命丸文","slideTitle":"第79スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、無言で彼女を押し倒す。\nそして、彼女の背中に手を回すと、ゆっくりと動かす。","transitionName":"クロスディゾルブ","id":"A40AD7E2-8CBC-4CE8-8B4D-A3D5D9100A7C"},{"title":"シーン 80","characterName":"射命丸文","slideTitle":"第80スライド","duration":15,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、彼女のあの部分に、僕の棒を差し込む。\nそのまま、彼女の敏感な部分を探り当てるように動く。","transitionName":"クロスディゾルブ","id":"13DED1A8-BA1D-4E5D-B882-FB7B3DF8302E"},{"title":"シーン 81","characterName":"射命丸文","slideTitle":"第81スライド","duration":15,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、敏感なところを突くように動く。","transitionName":"クロスディゾルブ","id":"3F2FAD70-C263-43D4-8946-D98D18FD3835"},{"title":"シーン 82","characterName":"射命丸文","slideTitle":"第82スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、彼女が驚きの声をあげる。","transitionName":"クロスディゾルブ","id":"1F9A6D2A-ED45-4389-A460-6D19F12ABB33"},{"title":"シーン 83","characterName":"射命丸文","slideTitle":"第83スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「やるじゃないですか…操夢さん…、でも、まだまだですよ…」","transitionName":"クロスディゾルブ","id":"B4E7A2D0-CB45-4CD8-856D-D01DF3C3A9E8"},{"title":"シーン 84","characterName":"射命丸文","slideTitle":"第84スライド","duration":3.7,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか…、じゃあ、続けますね…」\n僕はそう言いながら、再び動き始める。","transitionName":"クロスディゾルブ","id":"87373BBF-FA87-43EF-BF20-930509122270"},{"title":"シーン 85","characterName":"射命丸文","slideTitle":"第85スライド","duration":15,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、彼女のあの部分に、僕の棒を再び差し込み、\nそのまま、彼女の敏感な部分をピンポイントで当てながら動く。","transitionName":"クロスディゾルブ","id":"EEF008BF-8865-4EDB-96AB-DFCE6EEDCFC2"},{"title":"シーン 86","characterName":"射命丸文","slideTitle":"第86スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私は、彼にピンポイントで攻められ、感嘆の言葉を放つ。\n「すごいですね…、どうやって、そのテクを…？」","transitionName":"クロスディゾルブ","id":"B55DAC3D-D7C1-42C3-B317-AE7D69329434"},{"title":"シーン 87","characterName":"射命丸文","slideTitle":"第87スライド","duration":10,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「それは…秘密です。それと、速度、あげますね…」\n僕はそう呟きながら、先ほどより早く、彼女を動かす。","transitionName":"クロスディゾルブ","id":"5F70CA01-1BD0-48DB-8DA4-3BE9A1E074FF"},{"title":"シーン 88","characterName":"射命丸文","slideTitle":"第88スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"私は、彼に少し早くピンポイントを攻められると、\nあの部分の反応が強くなる。「…まだまだですよ…」","transitionName":"クロスディゾルブ","id":"33EFBC8B-934F-4175-9C12-3C0B6B6E42AF"},{"title":"シーン 89","characterName":"射命丸文","slideTitle":"第89スライド","duration":10,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「そうですか、じゃあもう一段階早くしますね…」\n僕はそう呟きながら、先ほどより早く、彼女を動かす。","transitionName":"クロスディゾルブ","id":"FBAA2528-FC75-46C0-84C2-BE0E60FBD3A1"},{"title":"シーン 90","characterName":"射命丸文","slideTitle":"第90スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「…あなたとの…〇〇〇〇の感触…体にみっちりと…刻みましたよ…とても…気持ちよかったです…」","transitionName":"クロスディゾルブ","id":"3053BCC0-7EE4-412C-A221-CFB6B206E6ED"},{"title":"シーン 91","characterName":"操夢","slideTitle":"第91スライド","duration":4.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、そう言う彼女にそっと口付けをする。すると、彼女は何も言わなくなり、眠りについていた。","transitionName":"クロスディゾルブ","id":"738EF6A2-2783-4D7A-8A7F-00774B508047"},{"title":"シーン 92","characterName":"操夢","slideTitle":"第92スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、彼女を腕でゆっくりと抱え上げると、\n寝室がないかを探す。そして、彼女を置くとそのまま家を出た。","transitionName":"クロスディゾルブ","id":"CDA4FE1E-7BEA-4865-9033-1A339FCF9AAA"},{"title":"その頃、紅魔館では…","characterName":"","slideTitle":"中扉","duration":3,"animationName":"フェードイン","backgroundName":"単色背景","telop":"","transitionName":"クロスディゾルブ","id":"8317517B-3071-440E-B6C2-A1EFCB9F2B33"},{"title":"シーン 94","characterName":"十六夜咲夜","slideTitle":"第94スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「お嬢様、悲しいお知らせがあるのですが…」","transitionName":"クロスディゾルブ","id":"DB56440F-C86E-4E5F-86C1-060BA7962867"},{"title":"シーン 95","characterName":"レミリア・スカーレット","slideTitle":"第95スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「どうしたの、咲夜？」","transitionName":"クロスディゾルブ","id":"6C6C1F7D-506D-4B9F-A4AD-A3E7D5311036"},{"title":"シーン 96","characterName":"十六夜咲夜","slideTitle":"第96スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「今、旅行中の彼女たちから緊急連絡がありまして…」","transitionName":"クロスディゾルブ","id":"7AAD658B-D0E9-47F2-849B-2CDB2F75EB1C"},{"title":"シーン 97","characterName":"レミリア・スカーレット","slideTitle":"第97スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「何があったの？」","transitionName":"クロスディゾルブ","id":"9BF8EF4C-F05D-41BC-9F8F-56501E6FE209"},{"title":"シーン 98","characterName":"十六夜咲夜","slideTitle":"第98スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「彼女たちが海水浴からの帰り、睡眠をとったあと、目が覚めると、宿から彼の姿が消えたようで…」","transitionName":"クロスディゾルブ","id":"00833B97-1A8F-4AC3-ADF8-A1B076650E16"},{"title":"シーン 99","characterName":"レミリア・スカーレット","slideTitle":"第99スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「それで、操夢はどこにいるの？」","transitionName":"クロスディゾルブ","id":"F9FAD5EA-92A0-473C-BFCE-F4898BC39127"},{"title":"シーン 100","characterName":"十六夜咲夜","slideTitle":"第100スライド","duration":5.1000000000000005,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「彼の居場所は、分からない状況です、ただ、これが…」\n私は、そう言って、先ほど届いたFaxを見せる。","transitionName":"クロスディゾルブ","id":"C244ABCD-8C2A-4475-A232-586A092236CE"},{"title":"シーン 101","characterName":"レミリア・スカーレット","slideTitle":"第101スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"私が、それを見ると、そこには「文々。新聞記者、射命丸文が操夢さんをお持ち帰りしました。」と書かれていた。","transitionName":"クロスディゾルブ","id":"A7E97048-4319-4EAD-BC8F-CCD8F63E56B6"},{"title":"シーン 102","characterName":"レミリア・スカーレット","slideTitle":"第102スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「咲夜、文の自宅はわかるわよね。」","transitionName":"クロスディゾルブ","id":"FE5A87D2-6540-4433-AA55-09AF1ACC84A4"},{"title":"シーン 103","characterName":"十六夜咲夜","slideTitle":"第103スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「それは、フランお嬢様なら探し出せるかと…」","transitionName":"クロスディゾルブ","id":"40E8FC0D-763A-469E-89A3-07B1CB3F1511"},{"title":"シーン 104","characterName":"レミリア・スカーレット","slideTitle":"第104スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「そう、じゃあ、フランに文の自宅を\n割り出して伝えるように、言いなさい。いいわね。」","transitionName":"クロスディゾルブ","id":"0B687717-B44B-40FD-804B-FC9BF3C9AF95"},{"title":"シーン 105","characterName":"十六夜咲夜","slideTitle":"第105スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc107556_紅魔的館内.jpg","telop":"「承知しました。」\n私はそういうと、フランお嬢様がいる半地下室に向かう。","transitionName":"クロスディゾルブ","id":"9168DCCF-3D9A-4D79-9CF3-7EA873B1DB16"},{"title":"シーン 106","characterName":"フランドール・スカーレット","slideTitle":"第106スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","telop":"「あれ、どうしたの、咲夜、そんな顔して。」","transitionName":"クロスディゾルブ","id":"3227AA90-C8B9-4C1E-B0A5-C9EBCDA394D4"},{"title":"シーン 107","characterName":"十六夜咲夜","slideTitle":"第107スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","telop":"「お嬢様が、このFaxをみて、彼女の住所を割り出せと…。」","transitionName":"クロスディゾルブ","id":"2054CBE6-F60A-451E-86FE-CDE20620A214"},{"title":"シーン 108","characterName":"フランドール・スカーレット","slideTitle":"第108スライド","duration":4.5,"animationName":"フェードイン","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","telop":"「そう、じゃあ、今から割り出すね…。」\n私はそう言い、PCでささっと文の自宅を割り出す。","transitionName":"クロスディゾルブ","id":"3CB0A064-AA0E-4B06-AD67-BAC988D35E86"},{"title":"シーン 109","characterName":"フランドール・スカーレット","slideTitle":"第109スライド","duration":5.9,"animationName":"フェードイン","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","telop":"「この住所、お姉様に伝えて、あと、もし駆け込みに行くなら、私も一緒に、この泥棒記者から奪い返すよって、言っておいて。」","transitionName":"クロスディゾルブ","id":"2C3E29BB-03CC-465E-8A0C-CE71F56A2282"},{"title":"シーン 110","characterName":"十六夜咲夜","slideTitle":"第110スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc240799_パソコン部屋（夜・照明ON）.jpg","telop":"「承知しました。」\nそれから、お嬢様たちは、支度を済ませて、外に出た。","transitionName":"クロスディゾルブ","id":"96526E63-997A-44B7-9310-13BDEB3459A3"},{"title":"シーン 111","characterName":"ナレーション","slideTitle":"第111スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"翌朝…","transitionName":"クロスディゾルブ","id":"86B9C0B4-23EB-4F80-BCC3-6CF8BA7E70CD"},{"title":"シーン 112","characterName":"操夢","slideTitle":"第112スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「んっ…」\n僕は、ふと誰かの視線を感じ、目が覚める。","transitionName":"クロスディゾルブ","id":"BF87BB78-0548-4FCB-A325-84CA781FA5E1"},{"title":"シーン 113","characterName":"操夢","slideTitle":"第113スライド","duration":4.4,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"そして、ふと上半身を起こして、そちらを向くと、\nレミリアとフランが怖い笑みを浮かべていた。","transitionName":"クロスディゾルブ","id":"AC490D05-11C6-40BB-B781-4B3F4C19383E"},{"title":"シーン 114","characterName":"レミリア・スカーレット","slideTitle":"第114スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「あら、目が覚めたの。」私はそういうと、\n素早くベッドに乗り、彼の耳のそばに勢いよく、手をつく。","transitionName":"クロスディゾルブ","id":"FC253E1C-E143-4FB8-A489-05B43125045B"},{"title":"シーン 115","characterName":"レミリア・スカーレット","slideTitle":"第115スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「あなた、あの泥棒記者と夜中まで仲良くしてたみたいね。\nその理由を聞かせてくれるかしら…？」","transitionName":"クロスディゾルブ","id":"A71E3FB2-F198-4E4D-9CA6-CFAEFB79B3D6"},{"title":"シーン 116","characterName":"操夢","slideTitle":"第116スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"僕は、彼女を眺めると同時に、思考を巡らせて、この場を鎮める方法を考える。だが、恐怖の笑みで何も思いつかない…。","transitionName":"クロスディゾルブ","id":"2266CCE1-057E-42FA-9558-4C695EDB94F5"},{"title":"シーン 117","characterName":"操夢","slideTitle":"第117スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"仕方なく、僕は覚悟の上で昨晩のことを話す。","transitionName":"クロスディゾルブ","id":"778CF521-DC22-43ED-B28A-6B28E4A4CC2C"},{"title":"シーン 118","characterName":"レミリア・スカーレット","slideTitle":"第118スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「そう、ならお仕置きね。フラン、準備はいいかしら？」","transitionName":"クロスディゾルブ","id":"6FB74C76-B1F8-4F72-A047-6D225A9B5DDE"},{"title":"シーン 119","characterName":"フランドール・スカーレット","slideTitle":"第119スライド","duration":4,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「準備は万端だよ、お姉様。」\n私はそう言いながら、ベッドに入り、彼の上にまたがる。","transitionName":"クロスディゾルブ","id":"C25B1AA4-EB1A-400F-9886-1E5D00646B8C"},{"title":"シーン 120","characterName":"レミリア・スカーレット","slideTitle":"第120スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「なら、始めるわよ、フラン。」","transitionName":"クロスディゾルブ","id":"A60BAEF0-471B-46E6-9B04-7CD7E7AFF29B"},{"title":"シーン 121","characterName":"フランドール・スカーレット","slideTitle":"第121スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「じゃあ、始めるね、お仕置きを…」","transitionName":"クロスディゾルブ","id":"9CE248F9-FF52-4EB0-9548-6D751EC697E4"},{"title":"シーン 122","characterName":"操夢","slideTitle":"第122スライド","duration":12.35,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"彼女たちはそう言うと、フランが僕の洋服を勝手に脱がし、\nそのままレミリアは下着姿になり、僕の棒を加える。","transitionName":"クロスディゾルブ","id":"C81F153D-7BEB-4D45-80ED-BF0487962CD8"},{"title":"シーン 123","characterName":"操夢","slideTitle":"第123スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"だが僕は、彼女が何度も当ててくる器の弱点を把握し、\nそこに焦点を当てて突つく。","transitionName":"クロスディゾルブ","id":"464F3119-2712-4636-9190-7FA7ED189181"},{"title":"シーン 124","characterName":"レミリア・スカーレット","slideTitle":"第124スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「ひゃん。」\n私は、彼に敏感なところを突かれ、思わず声が漏れる。","transitionName":"クロスディゾルブ","id":"659153D9-4312-4E6C-B2A0-3C88CF5EC49E"},{"title":"シーン 125","characterName":"レミリア・スカーレット","slideTitle":"第125スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「あんた…、なんでこんなすぐに\n私の敏感なところを突けるのかしら？」","transitionName":"クロスディゾルブ","id":"38870FD3-8B86-447D-9990-55ECDEB80785"},{"title":"シーン 126","characterName":"操夢","slideTitle":"第126スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「それは、あなたの体が指し示してますよ。」\n僕は彼女の指摘にそう返す。","transitionName":"クロスディゾルブ","id":"B82AA0B6-F527-4CED-9898-8F07EC565B73"},{"title":"シーン 127","characterName":"レミリア・スカーレット","slideTitle":"第127スライド","duration":3.6,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「えっ？」私はそう呟きながら、下を見る。\n私はそれを見ると、驚いてしまう。","transitionName":"クロスディゾルブ","id":"B50A7BEE-2110-48E5-B033-B20F252F0290"},{"title":"シーン 128","characterName":"レミリア・スカーレット","slideTitle":"第128スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「まぁ、いいわ。とりあえず、続けるわよ。」\n私はそう言って、先ほどよりも早く動く。","transitionName":"クロスディゾルブ","id":"F03A806B-4815-4C04-B9ED-372894D915CA"},{"title":"シーン 129","characterName":"レミリア・スカーレット","slideTitle":"第129スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"だが、私の器は、さらに反応を示す。\nだが、同時になんとなく、心地よい感触がする。","transitionName":"クロスディゾルブ","id":"C03D87C6-6403-44DD-B0AD-8C23605B2D83"},{"title":"シーン 130","characterName":"フランドール・スカーレット","slideTitle":"第130スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「お姉様、私にも彼を確かめさせて…」\n私は、そう呟く。","transitionName":"クロスディゾルブ","id":"B09D3748-C0A8-420D-9A85-667BD0B95400"},{"title":"シーン 131","characterName":"レミリア・スカーレット","slideTitle":"第131スライド","duration":4.3,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「分かったわ…、それじゃ、彼を攻め落としなさい…。」\n私はそう言うと、ベッドから降りた。","transitionName":"クロスディゾルブ","id":"53FFD247-373C-451D-A15C-F14EED5391DF"},{"title":"シーン 132","characterName":"フランドール・スカーレット","slideTitle":"第132スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「じゃあ、始めるね。」\n私はそう言うと彼の棒を器で咥えて、動き出す。","transitionName":"クロスディゾルブ","id":"79809468-EABA-4D94-8447-AF335756E67D"},{"title":"シーン 133","characterName":"フランドール・スカーレット","slideTitle":"第133スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"僕は、そう言って動き出したフランの器の中で、自分の棒を静かに小さく動かし、敏感なところを探る。","transitionName":"クロスディゾルブ","id":"191584FB-658D-4B99-811F-E0D2B5D129F5"},{"title":"シーン 134","characterName":"フランドール・スカーレット","slideTitle":"第134スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"そして、彼女の器のある部分を突くようにする。","transitionName":"クロスディゾルブ","id":"15858447-011E-4C7D-9AF2-D1CC8536CE8C"},{"title":"シーン 135","characterName":"フランドール・スカーレット","slideTitle":"第135スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"すると、彼女の器が反応を示す。\nそして、フランの驚きの声が漏れる。","transitionName":"クロスディゾルブ","id":"068223CE-5A75-4352-A247-C68601D846C2"},{"title":"シーン 136","characterName":"フランドール・スカーレット","slideTitle":"第136スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「まだ、まだ、終わらせないよ。」\n私はそう言い、動く速さをあげる。","transitionName":"クロスディゾルブ","id":"7036686C-BE6D-4CE2-BB90-81322EAEF297"},{"title":"シーン 137","characterName":"フランドール・スカーレット","slideTitle":"第137スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"そして、僕は彼女の速度が上がると、\nよりピンポイントで素早く突つつく。","transitionName":"クロスディゾルブ","id":"15D02A8D-7060-4A18-B549-6E5BC8AA3E06"},{"title":"シーン 138","characterName":"フランドール・スカーレット","slideTitle":"第138スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"すると、彼女の器が先ほどより強い反応を示す。\nそして、フランの驚きの声が漏れる。","transitionName":"クロスディゾルブ","id":"F1A6F494-E791-440F-A31D-30E55887A1D5"},{"title":"シーン 139","characterName":"フランドール・スカーレット","slideTitle":"第139スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「まだ、まだ…」\n私はそう言いながら、動く。","transitionName":"クロスディゾルブ","id":"A354C51C-75B3-4A7D-8485-0F654BD8570C"},{"title":"シーン 140","characterName":"フランドール・スカーレット","slideTitle":"第140スライド","duration":10,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"彼女はそう言うが、動きの速度が下がり、\n僕は先ほどよりも丁寧に素早く突つく。","transitionName":"クロスディゾルブ","id":"2E8F5998-C18D-494D-9612-F0D48F379CB7"},{"title":"シーン 141","characterName":"フランドール・スカーレット","slideTitle":"第141スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"「うぅ…」私は、彼に器を突かれ、勢いよく反応が出ると、うめき声がを漏らしながら、ベッドから降りる。","transitionName":"クロスディゾルブ","id":"BF4D2BEE-EF72-4BBB-B740-F02DEA46F919"},{"title":"シーン 142","characterName":"操夢","slideTitle":"第142スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"二人がいつの間にか、眠ってしまっていることに僕は気づく。\nそして、そのままそっと、ベッドから降りる。","transitionName":"クロスディゾルブ","id":"F6F64F14-2CBA-4235-8827-39B5BFCFA16F"},{"title":"シーン 143","characterName":"操夢","slideTitle":"第143スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"そして、これからすべきことを考え、PCの電源を押す。\nだが、うまく起動しないので、親機がある部屋に向かう。","transitionName":"クロスディゾルブ","id":"31D47302-7934-48E9-A314-E863D0E00604"},{"title":"シーン 144","characterName":"操夢","slideTitle":"第144スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、親機のある部屋に入ると、先ほど借りてきたレミリアのポケベルを床に置き、早速電源を押す。\n※察しのいい人にはPCが見えます。","transitionName":"クロスディゾルブ","id":"B1EDEED4-04E5-4C68-B562-083066F42243"},{"title":"シーン 145","characterName":"操夢","slideTitle":"第145スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、ポケベルのアイコンにカーソルを合わせてクリックする。\nFiles\nポケベル\nポケベル\nFiles\n編集\n表示\n移動\nウィンドウ\nヘルプ","transitionName":"クロスディゾルブ","id":"1D823930-A88D-41A1-9638-362FCBF32407"},{"title":"シーン 146","characterName":"通常","slideTitle":"第146スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルはさまざまな人々の\n「誰かと繋がりたい」という\n思いが沢山こもった製品として\n平成初期から中期にかけて\n流行した通話機能を有する機器\nであり、国会においてスマート\nフォンマナーの問題が挙げられ\n国民のスマートフォン利用を\n原則中止すると、我ら河童\nが生み出したこのポケベルが\n巨大な需要を生み出して…\npocketbell.kappa\/home\/top\n政府公認の安心国産ポケベル\nホーム\nポケベルって何？\n出来ること\n河童の技術力\nポケベル史\n政府公認とは？\nポケベルの魅力\n電話の歴史\nポケベルの性能\nポケベルの価格\n必要なもの\n固定電話は必須？\n通信機能について\nすると、前に１度だけみたWebページが開く。\nそして僕は、操作にカーソルを合わせる。\n操作\nWeb","transitionName":"クロスディゾルブ","id":"6803EE8F-414D-48F0-B4D2-2D6AC0290E3E"},{"title":"シーン 147","characterName":"通常","slideTitle":"第147スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルはさまざまな人々の\n「誰かと繋がりたい」という\n思いが沢山こもった製品として\n平成初期から中期にかけて\n流行した通話機能を有する機器\nであり、国会においてスマート\nフォンマナーの問題が挙げられ\n国民のスマートフォン利用を\n原則中止すると、我ら河童\nが生み出したこのポケベルが\n巨大な需要を生み出して…\npocketbell.kappa\/home\/top\n政府公認の安心国産ポケベル\nホーム\nポケベルって何？\n出来ること\n河童の技術力\nポケベル史\n政府公認とは？\nポケベルの魅力\n電話の歴史\nポケベルの性能\nポケベルの価格\n必要なもの\n固定電話は必須？\n通信機能について\n次に発信にカーソルを合わせて選択する。\n操作\nWeb\n発信\n受信確認\nリロード\nキー設定\nキャリア\n速度測定\n通話記録\n情報共有\nその他…","transitionName":"クロスディゾルブ","id":"2F7E4F8D-F60D-4B33-9D1D-A07D50C88E2C"},{"title":"シーン 148","characterName":"通常","slideTitle":"第148スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルはさまざまな人々の\n「誰かと繋がりたい」という\n思いが沢山こもった製品として\n平成初期から中期にかけて\n流行した通話機能を有する機器\nであり、国会においてスマート\nフォンマナーの問題が挙げられ\n国民のスマートフォン利用を\n原則中止すると、我ら河童\nが生み出したこのポケベルが\n巨大な需要を生み出して…\npocketbell.kappa\/home\/top\n政府公認の安心国産ポケベル\nホーム\nポケベルって何？\n出来ること\n河童の技術力\nポケベル史\n政府公認とは？\nポケベルの魅力\n電話の歴史\nポケベルの性能\nポケベルの価格\n必要なもの\n固定電話は必須？\n通信機能について\n次に霊夢にカーソルを合わせる。\n操作\nWeb\n発信\n受信確認\nリロード\nキー設定\nキャリア\n速度測定\n通話記録\n情報共有\nその他…\nフラン\n咲夜\nパチュリー\n霊夢\n魔理沙\nさとり\nこいし\n操夢\n連絡先…","transitionName":"クロスディゾルブ","id":"9E15D38E-D5EC-46BD-A8B7-6C56C74D5E7B"},{"title":"シーン 149","characterName":"操夢","slideTitle":"第149スライド","duration":10,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nPocketBell\/control\/dispatch\/霊夢\n博麗霊夢に発信中…\nすると、「博麗霊夢に発信中…」と表示される。\n操作\nWeb\nキャンセル","transitionName":"クロスディゾルブ","id":"42F48136-6F3E-483C-B373-7078D75767BE"},{"title":"シーン 150","characterName":"博麗霊夢","slideTitle":"第150スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"nc268704_リビング２（日中）.jpg","telop":"私は、ふとポケベルの振動を感じ、ポッケから出すと、レミリアからの着信だった。そして、オレンジ色のボタンを押す。","transitionName":"クロスディゾルブ","id":"41CE4A8D-19D9-4EDC-9B51-0DFC37EBFD89"},{"title":"シーン 151","characterName":"操夢","slideTitle":"第151スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nPocketBell\/control\/dispatch\/霊夢\n博麗霊夢に通話中…\n「もしもし、霊夢さん、聞こえますか？」\n操作\nWeb\n通話を終了","transitionName":"クロスディゾルブ","id":"643628C4-081A-440C-A12A-8D90DF33E7CC"},{"title":"シーン 152","characterName":"博麗霊夢","slideTitle":"第152スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"nc268704_リビング２（日中）.jpg","telop":"「この声は、操夢？なんで、操夢がレミリアのポケベルを持ってるの？今どこにいるの？」","transitionName":"クロスディゾルブ","id":"C0EB8116-ABC9-4D86-8462-DBD2B0DC25E8"},{"title":"シーン 153","characterName":"操夢","slideTitle":"第153スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nPocketBell\/control\/dispatch\/霊夢\n博麗霊夢に通話中…\n僕は、そう聞く霊夢に対して、すこし記憶が戻り、島唄居酒屋のところから、今朝までの経緯を話す。\n操作\nWeb\n通話を終了","transitionName":"クロスディゾルブ","id":"AD94D4B7-F8E9-4F33-B587-D482AC550D30"},{"title":"シーン 154","characterName":"博麗霊夢","slideTitle":"第154スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc268704_リビング２（日中）.jpg","telop":"「え？そういうことは、私たちの家にいるの？」","transitionName":"クロスディゾルブ","id":"CF7453F2-ECEA-411F-BD46-2D71E99628A7"},{"title":"シーン 155","characterName":"操夢","slideTitle":"第155スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nPocketBell\/control\/dispatch\/霊夢\n博麗霊夢に通話中…\n「そうです。それで、さっきまでレミリアとフランさんに…」\n操作\nWeb\n通話を終了","transitionName":"クロスディゾルブ","id":"8472DC5D-5332-4FF4-A3FF-425CE11BC8D6"},{"title":"シーン 156","characterName":"博麗霊夢","slideTitle":"第156スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"nc268704_リビング２（日中）.jpg","telop":"私は、彼のその発言に衝撃を受ける…\n「操夢、私たちが帰ったらみっちり、お仕置きね…」","transitionName":"クロスディゾルブ","id":"4DB610ED-7E5D-4002-88E5-A68ED90E5530"},{"title":"シーン 157","characterName":"操夢","slideTitle":"第157スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nPocketBell\/control\/dispatch\/霊夢\n博麗霊夢に通話中…\n「えっと…はい…それで、いつごろこっちに戻りますか？」\n操作\nWeb\n通話を終了","transitionName":"クロスディゾルブ","id":"60B192D8-1DAA-4D8D-92FD-2AC1C5CB9D7E"},{"title":"シーン 158","characterName":"博麗霊夢","slideTitle":"第158スライド","duration":5.800000000000001,"animationName":"フェードイン","backgroundName":"nc268704_リビング２（日中）.jpg","telop":"「とりあえず、魔理沙たちを呼んで、今すぐそっちに行けるようにするから、待ってなさい。レミリアにポケベルも返すのよ。」","transitionName":"クロスディゾルブ","id":"73302D2F-9EC6-42CB-BFD3-5477D47CC7B3"},{"title":"シーン 159","characterName":"操夢","slideTitle":"第159スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nPocketBell\/control\/dispatch\/霊夢\n博麗霊夢に通話中…\n「分かりました。」\n僕はそういうと、通話を終了のボタンを選択した。\n操作\nWeb\n通話を終了","transitionName":"クロスディゾルブ","id":"CD253A57-DA0D-4733-87D7-7F1D7059D2F3"},{"title":"シーン 160","characterName":"操夢","slideTitle":"第160スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕はふと気がつくと、レミリアとフランの二人が部屋に入ってきた。だが、なんとなく二人の様子に違和感を覚える。\n※察しのいい人にはPCが見えます。","transitionName":"クロスディゾルブ","id":"B295919C-18E8-4A13-9FB0-49084E840DB9"},{"title":"シーン 161","characterName":"レミリア・スカーレット","slideTitle":"第161スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「ねぇ、操夢…、もう一回私を…いい気持ちにして…」\n※察しのいい人にはPCが見えます。","transitionName":"クロスディゾルブ","id":"B63E9CC3-5DD3-48FE-8C28-8D83640D9B34"},{"title":"シーン 162","characterName":"フランドール・スカーレット","slideTitle":"第162スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"「私も…お願い…操夢…」\n※察しのいい人にはPCが見えます。","transitionName":"クロスディゾルブ","id":"CC90E9A6-0AB9-48E1-8B94-6796C7C07673"},{"title":"シーン 163","characterName":"操夢","slideTitle":"第163スライド","duration":5.1000000000000005,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、二人の表情から何が起きたのかを分析すると、ある予測と傾向が浮かび上がる。それは、警告でもあった。\n※察しのいい人にはPCが見えます。","transitionName":"クロスディゾルブ","id":"B3EC3899-2C3C-4AC7-9FAD-275446143027"},{"title":"シーン 164","characterName":"操夢","slideTitle":"第164スライド","duration":4.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"だが、僕は、何も言わずに、レミリアを抱き抱えると、自室のベッドに運び、フランも運び込んだ。\n※察しのいい人にはPCが見えます。","transitionName":"クロスディゾルブ","id":"E6ACCAA0-CFD8-49AF-866D-BC4247856B98"},{"title":"シーン 165","characterName":"操夢","slideTitle":"第165スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"「じゃあ、始めますね。」\n僕はそういうと、レミリアを持ち上げる。","transitionName":"クロスディゾルブ","id":"AB21F7C7-88FA-4137-B480-302DAC4946B0"},{"title":"シーン 166","characterName":"操夢","slideTitle":"第166スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"そして、ゆっくりと、ジリジリと彼女を攻め込む。\n「今の気分はどうですか？」","transitionName":"クロスディゾルブ","id":"7D8936DC-4E58-4677-881E-BD138170C494"},{"title":"シーン 167","characterName":"操夢","slideTitle":"第167スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"僕がそう言っていると、彼女から声が漏れる。","transitionName":"クロスディゾルブ","id":"7A259E9D-A24E-4E38-81F5-4368A619CBD5"},{"title":"シーン 168","characterName":"レミリア・スカーレット","slideTitle":"第168スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"「気持ちいい…」","transitionName":"クロスディゾルブ","id":"FB00933B-376D-419C-89D9-9466424004C5"},{"title":"シーン 169","characterName":"操夢","slideTitle":"第169スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"「そうですか、それで何よりです。」\n僕はそう言いながら、同じ速度で彼女を動かす。","transitionName":"クロスディゾルブ","id":"57C01EBF-A654-4D53-94B5-93817B3D37C2"},{"title":"シーン 170","characterName":"操夢","slideTitle":"第170スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"すると、再び彼女から声が漏れる。\n「どうします、続けますか？」","transitionName":"クロスディゾルブ","id":"D64944E1-8CFB-4140-A4E7-28F262DBF8E5"},{"title":"シーン 171","characterName":"レミリア・スカーレット","slideTitle":"第171スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"「もっと…続けて…」","transitionName":"クロスディゾルブ","id":"81E296EF-C605-4B78-B4A5-1E6D0E09F96F"},{"title":"シーン 172","characterName":"操夢","slideTitle":"第172スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"僕は、彼女の言葉に従って、同じ速度で彼女を動かす。\n彼女の表情を読み取ると、眠いことがわかる。","transitionName":"クロスディゾルブ","id":"2C988AE6-E093-4025-B784-BB1DD9468602"},{"title":"シーン 173","characterName":"操夢","slideTitle":"第173スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"僕は、そのまま彼女を動かしていると、再び声が出そうになり、僕は最後に口づけをする。","transitionName":"クロスディゾルブ","id":"7D3245FF-2796-4BA4-9D73-9F16B7ED3CD3"},{"title":"シーン 174","characterName":"操夢","slideTitle":"第174スライド","duration":3.8000000000000003,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"すると彼女は、そのまま寝落ちした。\n僕は、そっと彼女を抱え上げ、一度床に移す。","transitionName":"クロスディゾルブ","id":"04A35769-EAA7-4B04-8910-93FEA586E60C"},{"title":"シーン 175","characterName":"フランドール・スカーレット","slideTitle":"第175スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"そして、今度はフランの体を持って、上下に動かしながら、\nレミリアと同じ速度でゆっくりとじんわり攻め込む。","transitionName":"クロスディゾルブ","id":"0227C990-3CD3-4ADF-902D-F8C9C518539A"},{"title":"シーン 176","characterName":"フランドール・スカーレット","slideTitle":"第176スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"すると、フランが「あっ」という声と共にアレが出る。\n僕は、特に構わず、そのまま続行する。","transitionName":"クロスディゾルブ","id":"805DF148-EB7C-4D41-AEF6-7053B167057C"},{"title":"シーン 177","characterName":"フランドール・スカーレット","slideTitle":"第177スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"そして、じんわり攻め込む。\nそして、しばらく経つと再び彼女は「あっ」と漏らす。","transitionName":"クロスディゾルブ","id":"B9EC7D64-DD8F-47D9-90A4-513932E73CBC"},{"title":"シーン 178","characterName":"フランドール・スカーレット","slideTitle":"第178スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"「とても…気持ちいいし…心地いい…」\n私はふと、そう漏らす。","transitionName":"クロスディゾルブ","id":"8E2E2315-A918-47AC-86A4-DD368244885E"},{"title":"シーン 179","characterName":"フランドール・スカーレット","slideTitle":"第179スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"「そうですか。では、続けますね。」\n僕はそう返し、彼女を動かし続ける。","transitionName":"クロスディゾルブ","id":"36434DE3-4097-47AD-957D-0B3FA42CA179"},{"title":"シーン 180","characterName":"フランドール・スカーレット","slideTitle":"第180スライド","duration":25,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"そして、三度目の声が彼女から出そうになると、\n僕は、そっとキスをする。","transitionName":"クロスディゾルブ","id":"FA9B0944-9FDE-4F84-8D76-DC4D1D456E45"},{"title":"シーン 181","characterName":"操夢","slideTitle":"第181スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・青）.jpg","telop":"そして、彼女はそのまま眠りに落ちた。","transitionName":"クロスディゾルブ","id":"91A21EEE-8309-4B3F-8E6F-5FB9C8EC5FA8"},{"title":"シーン 182","characterName":"十六夜咲夜","slideTitle":"第182スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"咲夜（驚く）.png","telop":"僕はそれから、共同スペースに降りてくる。\nすると、そこには、パチュリーと咲夜がいた。","transitionName":"クロスディゾルブ","id":"54535D26-5663-4B70-8C49-8CF4078989FD"},{"title":"シーン 183","characterName":"十六夜咲夜","slideTitle":"第183スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"咲夜（困る）.png","telop":"「あなた…思ったより元気じゃない…心配して損したわ…」","transitionName":"クロスディゾルブ","id":"5EB956A0-F50C-4263-8394-1BB4E31437BF"},{"title":"シーン 184","characterName":"十六夜咲夜","slideTitle":"第184スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"咲夜（困る）.png","telop":"「それで、先についたお嬢様たちは、どこにいるのですか？」","transitionName":"クロスディゾルブ","id":"CD07C5B8-FCB5-493A-910C-9CD829ACF5F6"},{"title":"シーン 185","characterName":"十六夜咲夜","slideTitle":"第185スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"咲夜（困る）.png","telop":"僕は、そこで、先ほどまでの流れを説明する。","transitionName":"クロスディゾルブ","id":"DFF7AC0E-1216-4684-9706-CBA86C01D729"},{"title":"シーン 186","characterName":"十六夜咲夜","slideTitle":"第186スライド","duration":4.800000000000001,"animationName":"フェードイン","backgroundName":"咲夜（驚く）.png","telop":"「あなた、それは、もはや単なる〇〇〇〇の領域超えて、あの二人のあなたに懐かせているんじゃない…」","transitionName":"クロスディゾルブ","id":"31549258-D4B1-460B-A165-A0FF157CC590"},{"title":"シーン 187","characterName":"十六夜咲夜","slideTitle":"第187スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"咲夜（驚く）.png","telop":"「もはや、懐かせるのではなくて、彼とじゃないと〇〇〇〇でいい気持ちにならなくなってるんじゃ…」","transitionName":"クロスディゾルブ","id":"FD29D50E-ECF8-4FA1-A29E-D687ED2A5989"},{"title":"シーン 188","characterName":"パチュリー・ノーレッジ","slideTitle":"第188スライド","duration":4.800000000000001,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"「ねぇ…私と〇〇〇〇してくれないかしら…、あの二人が感じたあなたのテクニックを私も感じたいわ…」","transitionName":"クロスディゾルブ","id":"BC894C27-B89B-49CF-8D1C-C60A32D56CE0"},{"title":"シーン 189","characterName":"十六夜咲夜","slideTitle":"第189スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"「私も…あなたのテクニックを自分で実感したい…です…」","transitionName":"クロスディゾルブ","id":"5199883A-D0E4-4BA0-91CD-314161C5C454"},{"title":"シーン 190","characterName":"操夢","slideTitle":"第190スライド","duration":5,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"「それなら、どこでしますか？今、僕の部屋はフランさんとレミリアさんが寝ているので、入れないですが…」","transitionName":"クロスディゾルブ","id":"5B1ECF5A-E8D5-41B3-8753-173E8B85F2FD"},{"title":"シーン 191","characterName":"十六夜咲夜","slideTitle":"第191スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"「それなら、私の部屋にしましょう…」\n私は、そう彼に提案する。","transitionName":"クロスディゾルブ","id":"2B6863DC-24B0-44C7-9008-0CD79F7D8E7B"},{"title":"シーン 192","characterName":"操夢","slideTitle":"第192スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"「分かりました…」\n僕はそれから、二人と共に咲夜の部屋に向かった。","transitionName":"クロスディゾルブ","id":"66D28DA3-5306-4A9C-8623-030D9E863173"},{"title":"シーン 193","characterName":"操夢","slideTitle":"第193スライド","duration":5.4,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"僕はそれから、咲夜の部屋にくると、先にパチュリーをベッドに運ぶ。そして、彼女の希望を予測して、彼女を動かす。","transitionName":"クロスディゾルブ","id":"6F711805-4395-40DD-B8F7-F6447C89A978"},{"title":"シーン 194","characterName":"操夢","slideTitle":"第194スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"「どうですか、今の気分は？」\n僕は、彼女を動かしながら彼女に聞く。","transitionName":"クロスディゾルブ","id":"4C0E0B8F-F4B5-40BB-9BCE-8160B9B35EDF"},{"title":"シーン 195","characterName":"パチュリー・ノーレッジ","slideTitle":"第195スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"「…すごい…私の好みを把握してるの？」","transitionName":"クロスディゾルブ","id":"4878FD59-20B4-4027-8010-1A602C71AE9C"},{"title":"シーン 196","characterName":"操夢","slideTitle":"第196スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"「いや、僕が頭で予測したんですよ。」\n僕はそう返す。すると、彼女が反応する。","transitionName":"クロスディゾルブ","id":"040B376E-78E3-4126-BA13-9050FE709B0F"},{"title":"シーン 197","characterName":"パチュリー・ノーレッジ","slideTitle":"第197スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"「あ…気持ちいい…」","transitionName":"クロスディゾルブ","id":"C4AC943E-2279-4DE6-90D0-39869CBC1694"},{"title":"シーン 198","characterName":"操夢","slideTitle":"第198スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"僕は、一瞬ニコッと微笑み、そのまま彼女を動かす。\n今度は、少しだけ早くする。","transitionName":"クロスディゾルブ","id":"AD695366-E467-48EA-A7AA-2731DAB8EE6B"},{"title":"シーン 199","characterName":"操夢","slideTitle":"第199スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"すると、すぐに彼女の反応が返ってくる。","transitionName":"クロスディゾルブ","id":"1A61DD7C-AF54-46FF-AD23-AF46EF734A52"},{"title":"シーン 200","characterName":"パチュリー・ノーレッジ","slideTitle":"第200スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"「もっと…」\n私は、ぼそっとそう呟く。","transitionName":"クロスディゾルブ","id":"4845F979-85C0-4937-A42E-5692E5A9E99F"},{"title":"シーン 201","characterName":"操夢","slideTitle":"第201スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"僕は、もう一回、ニコッと微笑み、彼女を動かす。\nそして、最初の時よりも遅い速度にする。","transitionName":"クロスディゾルブ","id":"75C5BCC6-4F7B-49AB-9D45-A226EFE22A69"},{"title":"シーン 202","characterName":"操夢","slideTitle":"第202スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"そして、彼女の反応が返ってくると、\n僕は、そっと彼女の口を封じる。","transitionName":"クロスディゾルブ","id":"A0A84B1E-C1E2-4099-BAD0-E4E38318C997"},{"title":"シーン 203","characterName":"操夢","slideTitle":"第203スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（日中・赤）.jpg","telop":"そして、寝落ちした彼女をそのままそっとベッドから床に移す。","transitionName":"クロスディゾルブ","id":"ECE5CC82-4998-4A49-BE64-C1996F9AEB54"},{"title":"シーン 204","characterName":"十六夜咲夜","slideTitle":"第204スライド","duration":20,"animationName":"フェードイン","backgroundName":"咲夜（困る）.png","telop":"そのままの流れでベッドに乗った\n咲夜の体を持ち、上下に動かす。","transitionName":"クロスディゾルブ","id":"8DE314F7-C7F3-48B0-AD51-C03FD9FEF585"},{"title":"シーン 205","characterName":"十六夜咲夜","slideTitle":"第205スライド","duration":20,"animationName":"フェードイン","backgroundName":"咲夜（驚く）.png","telop":"「あっ」彼の攻めに思っていたよりも、\nすぐに私のあそこが反応し、驚きの声をあげる。","transitionName":"クロスディゾルブ","id":"27E83802-1364-4FF2-84F0-E68923CA9266"},{"title":"シーン 206","characterName":"十六夜咲夜","slideTitle":"第206スライド","duration":20,"animationName":"フェードイン","backgroundName":"咲夜（困る）.png","telop":"僕は、少し、速度を緩めて、彼女を動かす。","transitionName":"クロスディゾルブ","id":"36E7DB7B-3FA1-4963-A409-4FBD66A59632"},{"title":"シーン 207","characterName":"十六夜咲夜","slideTitle":"第207スライド","duration":20,"animationName":"フェードイン","backgroundName":"咲夜（困る）.png","telop":"すると、彼女は小さな声を発し、\n僕はそれを皮切りに、もう一段階、速度を緩める。","transitionName":"クロスディゾルブ","id":"37A79688-73F8-45F0-B338-1CB301B7C564"},{"title":"シーン 208","characterName":"十六夜咲夜","slideTitle":"第208スライド","duration":20,"animationName":"フェードイン","backgroundName":"咲夜（弱る）.png","telop":"そして、先ほどよりも強い反応が彼女から出ると、\n僕は、そのままそっとキスをする。","transitionName":"クロスディゾルブ","id":"ECD0A7EB-5A91-4EFC-AFE6-702920A37B50"},{"title":"シーン 209","characterName":"操夢","slideTitle":"第209スライド","duration":4.800000000000001,"animationName":"フェードイン","backgroundName":"nc301377_一人部屋２（日中）.jpg","telop":"そして、二人とも眠りに落ちると、そっとパチュリーをベッドに乗せて、そのまま共同スペースに降りる。","transitionName":"クロスディゾルブ","id":"AD56A862-10F0-4B7F-9245-DED073E30950"},{"title":"シーン 210","characterName":"操夢","slideTitle":"第210スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"すると、眠気が僕を襲い、そのまま僕はソファで眠りに落ちた。","transitionName":"クロスディゾルブ","id":"58DDB4FF-6B2F-475D-8C5E-CAE28B4F40FE"},{"title":"シーン 211","characterName":"ナレーション","slideTitle":"第211スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"彼が目を覚ますと…","transitionName":"クロスディゾルブ","id":"CDE68754-FC2A-40C2-9605-B651285E1FE2"},{"title":"シーン 212","characterName":"操夢","slideTitle":"第212スライド","duration":3.8000000000000003,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"僕は、ふと目が覚めると、そこには霊夢と\n魔理沙がうずうずした状態で立っていた。","transitionName":"クロスディゾルブ","id":"92FF57E1-8E98-48B4-B1BA-8B314E90BD61"},{"title":"シーン 213","characterName":"博麗霊夢","slideTitle":"第213スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「あんた…どうやってあの四人を溺れさせたのよ…」","transitionName":"クロスディゾルブ","id":"74A62AA7-877E-4AEE-AAE8-9D847F694C5F"},{"title":"シーン 214","characterName":"霧雨魔理沙","slideTitle":"第214スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「私も気になるのだぜ…フランの様子もいつもと違ってたし…」","transitionName":"クロスディゾルブ","id":"AC960DB3-022D-426F-BC7E-DD650E0A2E36"},{"title":"シーン 215","characterName":"操夢","slideTitle":"第215スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"僕は、彼女たちの思考を予測し、何が言いたいのかを考える。\n「霊夢さんたちも…体感したいのですか…？」","transitionName":"クロスディゾルブ","id":"DBF42530-6C65-44CB-863C-7872C16DC352"},{"title":"シーン 216","characterName":"博麗霊夢","slideTitle":"第216スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「そうに…決まってるじゃない。こっちは、\nあんたのことで、あそこが渦巻いてるのよ…」","transitionName":"クロスディゾルブ","id":"937DE8A7-EA8D-4C32-9660-75F97A643355"},{"title":"シーン 217","characterName":"霧雨魔理沙","slideTitle":"第217スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「私もだぜ…」","transitionName":"クロスディゾルブ","id":"3B38BC16-C28F-40A8-80C0-0A2393E99D33"},{"title":"シーン 218","characterName":"操夢","slideTitle":"第218スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「レミリアさんたちは…？」","transitionName":"クロスディゾルブ","id":"A2D14099-4E0D-47D9-A510-670EC5034247"},{"title":"シーン 219","characterName":"博麗霊夢","slideTitle":"第219スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「彼女たちなら、あんたのことを私たちに告げてから、\n紅魔館に戻っていったわ…。」","transitionName":"クロスディゾルブ","id":"D464807F-0803-48AE-B152-10E99F5B505D"},{"title":"シーン 220","characterName":"霧雨魔理沙","slideTitle":"第220スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「そろそろ、アレが垂れそうだぜ…、\n早くお前のベッドに行かないか…？」","transitionName":"クロスディゾルブ","id":"AB53F757-1898-403E-9B8B-03B292CF3A66"},{"title":"シーン 221","characterName":"操夢","slideTitle":"第221スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夕方）.jpeg","telop":"「そうですか…。」\n僕はそう呟くと、ソファからおり、自分の部屋に向かう。","transitionName":"クロスディゾルブ","id":"8F219360-D238-429D-9467-1C0578469239"},{"title":"シーン 222","characterName":"霧雨魔理沙","slideTitle":"第222スライド","duration":3.4,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","telop":"そして、二人の体を交互に動かし、攻め込んでいく。","transitionName":"クロスディゾルブ","id":"8F7A9178-5F39-41B2-B876-F9CD49FFEFCF"},{"title":"シーン 223","characterName":"霧雨魔理沙","slideTitle":"第223スライド","duration":3.4,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","telop":"すると、二人のあの部分から、アレが出てくる。\nそして、あることを閃き、それを実践に移す。","transitionName":"クロスディゾルブ","id":"E0B9210F-0744-41F0-97F2-E49F6A4AD66C"},{"title":"シーン 224","characterName":"霧雨魔理沙","slideTitle":"第224スライド","duration":3.4,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","telop":"そして、それを実践すると、予想通り、\n彼女たちのあの箇所からアレがシュパシュパ出る。","transitionName":"クロスディゾルブ","id":"2EBF16E5-1B47-47F5-B1AF-13A5C128FC67"},{"title":"シーン 225","characterName":"霧雨魔理沙","slideTitle":"第225スライド","duration":3.4,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","telop":"僕は、もう一度同じように繰り返すと、\n二人にそっとキスをする。","transitionName":"クロスディゾルブ","id":"764F8803-50C5-4310-B88D-D45069B2BF17"},{"title":"シーン 226","characterName":"操夢","slideTitle":"第226スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","telop":"すると、彼女たちはそのまま眠りについた。\nそして、そのまま僕は共同スペースに向かった。","transitionName":"クロスディゾルブ","id":"82840D1C-2A72-4151-A6A1-C92FB20C3079"},{"title":"シーン 227","characterName":"十六夜咲夜","slideTitle":"第227スライド","duration":4.5,"animationName":"フェードイン","backgroundName":"咲夜（微笑）.png","telop":"「操夢さん、今ちょうど夕飯ができて、並べたところですよ。」\n私は、上から降りてきた彼にいう。","transitionName":"クロスディゾルブ","id":"A914B084-2CB4-4824-80F0-99C12A343403"},{"title":"シーン 228","characterName":"十六夜咲夜","slideTitle":"第228スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"咲夜（微笑）.png","telop":"「あっ、ありがとうございます…」\n僕はそう返す。","transitionName":"クロスディゾルブ","id":"83CF15B6-B17D-4D70-B275-ACAB1A73D557"},{"title":"シーン 229","characterName":"十六夜咲夜","slideTitle":"第229スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"咲夜（笑い）.png","telop":"「いえ、お礼なんていいですよ。それより食べてください。」\n私は、彼との〇〇〇〇したい欲を抑えていう。","transitionName":"クロスディゾルブ","id":"4D2E596C-9CD7-4126-9E80-16B241C4F02C"},{"title":"シーン 230","characterName":"十六夜咲夜","slideTitle":"第230スライド","duration":4.4,"animationName":"フェードイン","backgroundName":"咲夜（余裕）.png","telop":"僕は、「いただきます」といってから、ご飯を食べ始める。\nすると、彼女は僕と対角の席に座る。","transitionName":"クロスディゾルブ","id":"4ABE3BE2-9D31-41EA-82CE-81CEDAC1DBEB"},{"title":"シーン 231","characterName":"十六夜咲夜","slideTitle":"第231スライド","duration":4.3,"animationName":"フェードイン","backgroundName":"咲夜（余裕）.png","telop":"「咲夜さん、なんでニヤついているんですか…」\n僕は彼女の思考を予測しながら、話しかける。","transitionName":"クロスディゾルブ","id":"BED124E5-0FFD-4B32-98B6-88AE7EFF7714"},{"title":"シーン 232","characterName":"十六夜咲夜","slideTitle":"第232スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"咲夜（弱る）.png","telop":"「いつの間に…ちょっと、席を外しますね…。」\n私はそう言い、椅子から立ち上がる。","transitionName":"クロスディゾルブ","id":"5E562D12-1AA8-41AE-B78C-C773F37772D6"},{"title":"シーン 233","characterName":"十六夜咲夜","slideTitle":"第233スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"咲夜（弱る）.png","telop":"「後片付けなら僕がしておくので、咲夜さんは共同キッチンに戻らなくても大丈夫ですよ。」僕はそう彼女に告げる。","transitionName":"クロスディゾルブ","id":"CCBF544D-81A7-477F-B9A5-75734E7EEAA7"},{"title":"シーン 234","characterName":"十六夜咲夜","slideTitle":"第234スライド","duration":3.7,"animationName":"フェードイン","backgroundName":"咲夜（余裕）.png","telop":"「そうですか…」\n彼のその言葉に、ふと彼とさっきした〇〇〇〇が目に浮かぶ…。","transitionName":"クロスディゾルブ","id":"86FEAA1C-A387-4D97-BFF0-F1455A96A5C8"},{"title":"シーン 235","characterName":"十六夜咲夜","slideTitle":"第235スライド","duration":3.9000000000000004,"animationName":"フェードイン","backgroundName":"咲夜（余裕）.png","telop":"「咲夜さん…さっきから様子が変ですよ…」\n僕は、彼女に視線を当てながらそういう。","transitionName":"クロスディゾルブ","id":"0A222EF7-5061-48D9-B8F2-F30BEC2832E3"},{"title":"シーン 236","characterName":"十六夜咲夜","slideTitle":"第236スライド","duration":5.6000000000000005,"animationName":"フェードイン","backgroundName":"咲夜（驚く）.png","telop":"「はっ…」私は彼の指摘にふと驚きの声を上げる。そして、このままここにいるのは良くない考え、ささっと部屋に戻った。","transitionName":"クロスディゾルブ","id":"D724F941-66FE-43AA-96D6-8BCF23D7FB9F"},{"title":"シーン 237","characterName":"操夢","slideTitle":"第237スライド","duration":4.1000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕は、一人共同スペースで黙々とご飯を食べ進め、\n完食すると、食器の後片付けを済ます。","transitionName":"クロスディゾルブ","id":"F6802E4D-17C2-4A92-8483-099395312E70"},{"title":"シーン 238","characterName":"操夢","slideTitle":"第238スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"すると、さとりとこいしが帰ってくる。\n「お帰りなさい。」","transitionName":"クロスディゾルブ","id":"1290C6B4-2347-45B6-AE4D-69CE9C67B171"},{"title":"シーン 239","characterName":"古明地さとり","slideTitle":"第239スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「よかったです、操夢が無事で…」\n私はそういう。","transitionName":"クロスディゾルブ","id":"52253146-B806-4CD1-AC27-44057397FED3"},{"title":"シーン 240","characterName":"古明地こいし","slideTitle":"第240スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私も、安心した…」","transitionName":"クロスディゾルブ","id":"FB9F1930-1853-41C1-8421-2A5052FD966D"},{"title":"シーン 241","characterName":"操夢","slideTitle":"第241スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうですか、先に、お風呂とご飯のどっちにしますか？」\n僕は、そう聞く。","transitionName":"クロスディゾルブ","id":"35A24B1D-5158-46B3-B03E-74DFDECCF9B0"},{"title":"シーン 242","characterName":"古明地さとり","slideTitle":"第242スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私は、先にお風呂に入ってきますね…」","transitionName":"クロスディゾルブ","id":"DE87E666-843F-4C5C-A6AF-1430DC556876"},{"title":"シーン 243","characterName":"古明地こいし","slideTitle":"第243スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私も、そうしようかな…」","transitionName":"クロスディゾルブ","id":"A94920C5-A06B-4FE2-B174-2FC88DCAC341"},{"title":"シーン 244","characterName":"操夢","slideTitle":"第244スライド","duration":4.4,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「僕は、その間に歯磨きでもしようかな…」\n僕はそういうと、僕たちはそれぞれの部屋に向かう。","transitionName":"クロスディゾルブ","id":"632B1125-838F-4F78-83D5-FE39BF018504"},{"title":"シーン 245","characterName":"古明地さとり","slideTitle":"第245スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"さとりたちが夕飯を食べると…","transitionName":"クロスディゾルブ","id":"61913D60-044C-4C95-B19E-13578D72F060"},{"title":"シーン 246","characterName":"古明地こいし","slideTitle":"第246スライド","duration":5.7,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕は、二人の夕飯を作り、二人が夕飯を食べながら、会話を交わすうちに、話の流れで、さっきまでの経緯を語っていた。","transitionName":"クロスディゾルブ","id":"E86179AB-B3B9-4988-8B3E-F713E94FD31D"},{"title":"シーン 247","characterName":"古明地こいし","slideTitle":"第247スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「霊夢たちだけずるいですよ、あなたのテクニックで溺れられるなんて…、私たちにもそれを体感させてください。」","transitionName":"クロスディゾルブ","id":"FB6AB838-50CB-4D14-A3F5-122583DE5C84"},{"title":"シーン 248","characterName":"古明地こいし","slideTitle":"第248スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私にも、させて…」","transitionName":"クロスディゾルブ","id":"C26DD1A0-7BBA-4CE5-AE83-D6382D079EE4"},{"title":"シーン 249","characterName":"古明地こいし","slideTitle":"第249スライド","duration":5.9,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうですか…いいですよ。それで、誰の部屋でやりますか？僕の部屋は、今霊夢さんと魔理沙さんが寝てるから使えませんが…」","transitionName":"クロスディゾルブ","id":"DE4CD5C2-189C-43A2-BC22-664962D3D15D"},{"title":"シーン 250","characterName":"古明地こいし","slideTitle":"第250スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「それなら、私の部屋にしましょ。」","transitionName":"クロスディゾルブ","id":"E44A9265-691B-470B-ACC4-2EB8DFBEB37D"},{"title":"シーン 251","characterName":"古明地こいし","slideTitle":"第251スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「分かりました…」\n僕は、そういうと、3人でさとりの部屋に向かった。","transitionName":"クロスディゾルブ","id":"530F808F-50C7-447B-ACD6-E117FB7BE3D6"},{"title":"シーン 252","characterName":"古明地こいし","slideTitle":"第252スライド","duration":4.800000000000001,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"僕たちは、さとりの部屋にくると、彼女たちは僕の服を脱ぎとり、彼女たちを服を脱ぐと、僕を押し倒す。","transitionName":"クロスディゾルブ","id":"D5DDD504-542F-4C9A-87A9-2F12A57095F0"},{"title":"シーン 253","characterName":"古明地こいし","slideTitle":"第253スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"「じゃあ、始めるからね。」\n私はそう言い、彼を攻め始める。","transitionName":"クロスディゾルブ","id":"C7EA41D7-E411-4519-8CA5-7922860A64A9"},{"title":"シーン 254","characterName":"古明地こいし","slideTitle":"第254スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"僕は、彼女の敏感なところを探り、見つけると、そこをつく。","transitionName":"クロスディゾルブ","id":"6432ECC5-970B-40FE-8CA4-1B2ED9FA0F7C"},{"title":"シーン 255","characterName":"古明地こいし","slideTitle":"第255スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"私は、彼が私の急所を急に突き、\n驚くと同時に、アレが出てくる。","transitionName":"クロスディゾルブ","id":"90244190-06CE-4752-8DC9-B01222DAC608"},{"title":"シーン 256","characterName":"古明地こいし","slideTitle":"第256スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"「まだ続けるよ。」\n私は、何かに火がついたように彼を攻め続ける。","transitionName":"クロスディゾルブ","id":"EB7E311F-52F7-4740-820A-81E76B0A5AE7"},{"title":"シーン 257","characterName":"古明地こいし","slideTitle":"第257スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"だが、同じ結果を辿るだけになってしまい、\n思わず、「うぅー。」と嘆いてしまう。","transitionName":"クロスディゾルブ","id":"A7222FE7-713D-44CC-A0A2-B3C21CF07779"},{"title":"シーン 258","characterName":"古明地さとり","slideTitle":"第258スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"私は、困っているこいしに交代することを提案し、彼女がそれを飲むと、彼にまたがり、動き始める。","transitionName":"クロスディゾルブ","id":"F42BD09E-9FD7-440C-82B7-F11523F678E2"},{"title":"シーン 259","characterName":"古明地さとり","slideTitle":"第259スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"僕は、彼女の要所を探り寄せ、\n見つけると、そこに僕の棒を当てこむ。","transitionName":"クロスディゾルブ","id":"E356BFFB-0CB1-4D89-9E91-F78729530C0F"},{"title":"シーン 260","characterName":"古明地さとり","slideTitle":"第260スライド","duration":15,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"私は、彼に敏感なところをいきなり、突かれ、驚く。","transitionName":"クロスディゾルブ","id":"EF759A02-4E5E-4E58-B482-C6A1362208D9"},{"title":"シーン 261","characterName":"古明地さとり","slideTitle":"第261スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"「まだまだですよ…」\n私は、彼のテクニックに火がつき、素早く攻め込む。","transitionName":"クロスディゾルブ","id":"84EED3F7-6013-4BEE-B4BC-31B7BE74E5E8"},{"title":"シーン 262","characterName":"古明地さとり","slideTitle":"第262スライド","duration":10,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"僕は、彼女の速度が変化したのを見て、その隙を狙って、\nピンポイントでズバッと棒を当てこむ。","transitionName":"クロスディゾルブ","id":"0FF26238-7D11-4C7D-9FDE-683B563EA935"},{"title":"シーン 263","characterName":"古明地さとり","slideTitle":"第263スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"「あっ…」\n私は、こいしとともに彼の棒との戦いに敗れ、落胆する。","transitionName":"クロスディゾルブ","id":"0D010C97-5348-46DF-95A8-808C5AD881FC"},{"title":"シーン 264","characterName":"古明地さとり","slideTitle":"第264スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"寝室の窓際のベッド（夜・ランプ・赤）.jpg","telop":"僕は、そっと彼女の口にキスをすると、ベッドの端に彼女の体を寄せ、ベッドから降りてこいしを見る。","transitionName":"クロスディゾルブ","id":"F351CE75-BED3-4F77-AF75-774A5F699E29"},{"title":"シーン 265","characterName":"操夢","slideTitle":"第265スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"するとこいしは、何か物欲しそうな、諦めているような表情をしていた。僕は、そのまま彼女に近づきそっとキスをする。","transitionName":"クロスディゾルブ","id":"B82371CE-3657-4F44-A398-20AB38AAFCB1"},{"title":"シーン 266","characterName":"古明地こいし","slideTitle":"第266スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"「つい、この間の〇〇〇〇から、数日くらいしか経ってないの一気に上達したんだね…」私は、ぼさっとそう告げる。","transitionName":"クロスディゾルブ","id":"0C687C50-C794-434C-8096-17C9C0F7C886"},{"title":"シーン 267","characterName":"操夢","slideTitle":"第267スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"僕は彼女の言葉に笑みを返すと、彼女に尋ねる。\n「こいしさんも寝ますか？」","transitionName":"クロスディゾルブ","id":"26ECCC9E-0FE2-499F-85D0-39E407B716E7"},{"title":"シーン 268","characterName":"古明地こいし","slideTitle":"第268スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"「なんだか疲れちゃったし、私もお姉ちゃんの隣で寝ることにする。」私はそういうと、ベッドに乗る。","transitionName":"クロスディゾルブ","id":"BE525F53-0BAE-463F-8223-A1C4268B10B4"},{"title":"シーン 269","characterName":"操夢","slideTitle":"第269スライド","duration":4.9,"animationName":"フェードイン","backgroundName":"nc301379_一人部屋２（夜・照明ON）.jpg","telop":"僕が、もう一度そのベッドを見ると、さとりとこいしの寝顔があった。そして、僕は共同スペースに向かう。","transitionName":"クロスディゾルブ","id":"48CCB964-288E-402F-BBD0-126DB8330222"},{"title":"シーン 270","characterName":"霧雨魔理沙","slideTitle":"第270スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕が共同スペースに降りてくると、霊夢たちがいた。\n「二人とも、目が覚めたんですね…」","transitionName":"クロスディゾルブ","id":"F9719418-147E-4C3B-9899-39E9DB4E2635"},{"title":"シーン 271","characterName":"霧雨魔理沙","slideTitle":"第271スライド","duration":5.1000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「あんたのお風呂借りて、スッキリしてきたわ。」\n私は、彼ともう一度〇〇〇〇したい気持ちを抑えながらいう。","transitionName":"クロスディゾルブ","id":"20C28765-2184-4089-8E70-B7A8D5C3DEB9"},{"title":"シーン 272","characterName":"霧雨魔理沙","slideTitle":"第272スライド","duration":3.8000000000000003,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「それで、操夢は何してたんだ？」\n私は、彼に犯されたい気持ちを堪えながらいう。","transitionName":"クロスディゾルブ","id":"7BF3BE41-95DB-4AB9-A122-8D0F200C0912"},{"title":"シーン 273","characterName":"霧雨魔理沙","slideTitle":"第273スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうですか…、それで、夕飯は食べましたか？」","transitionName":"クロスディゾルブ","id":"258B135C-148D-4C70-8099-F123AFFF72D3"},{"title":"シーン 274","characterName":"博麗霊夢","slideTitle":"第274スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「いや、まだ食べてないわ…」","transitionName":"クロスディゾルブ","id":"E41DB074-E73A-4F4D-9157-8875C67B2A84"},{"title":"シーン 275","characterName":"霧雨魔理沙","slideTitle":"第275スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「私もまだ食べないぜ…」","transitionName":"クロスディゾルブ","id":"0FB4B225-EB84-446F-BB1D-C96647A12ACF"},{"title":"シーン 276","characterName":"操夢","slideTitle":"第276スライド","duration":4.6000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうですか…じゃあ、僕が作りますね。」\n僕はそういうと、共同キッチンに入り、冷蔵庫を開ける。","transitionName":"クロスディゾルブ","id":"C3C9E665-2899-40CE-A0F4-EC37154F41C6"},{"title":"シーン 277","characterName":"操夢","slideTitle":"第277スライド","duration":5.800000000000001,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そして、二人の視線を感じながら、思考を働かせて夕飯を作る。\nそして、数十分程度で完成すると、パックご飯とともに出す。","transitionName":"クロスディゾルブ","id":"4578CC4F-3DC9-4578-8688-B035987C5D5A"},{"title":"シーン 278","characterName":"操夢","slideTitle":"第278スライド","duration":4.7,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「できましたよ…。二人ともどうしたんですか？」\n僕は、二人の思考の分析と予測をしながらいう。","transitionName":"クロスディゾルブ","id":"9412EB78-9944-4CAD-9B8F-02B7F7A25758"},{"title":"シーン 279","characterName":"霧雨魔理沙","slideTitle":"第279スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「いや、何でもないわ。それじゃ、いただきます。」","transitionName":"クロスディゾルブ","id":"909A8C82-BCB3-48B3-89F9-DCDECE907CEB"},{"title":"シーン 280","characterName":"霧雨魔理沙","slideTitle":"第280スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「いただきますなのだぜ…」","transitionName":"クロスディゾルブ","id":"BB4B1E66-BEAC-417A-8E25-EFAEBD8E065F"},{"title":"シーン 281","characterName":"霧雨魔理沙","slideTitle":"第281スライド","duration":5.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕は、食事をする二人を見ながら、今日を振り返る。レミリアたちにお仕置きを受けてから、彼女たちの様子が変化した。","transitionName":"クロスディゾルブ","id":"C1E65978-F8AA-4E61-8928-1526A5611332"},{"title":"シーン 282","characterName":"霧雨魔理沙","slideTitle":"第282スライド","duration":5.6000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"僕は、なぜこのような変化が起きたのかを解析する。僕の行動は、次々とこの家に住む女性たちと〇〇〇〇するだけだった。","transitionName":"クロスディゾルブ","id":"91D096D6-F74D-44CA-87A5-7546679BBECA"},{"title":"シーン 283","characterName":"霧雨魔理沙","slideTitle":"第283スライド","duration":5.1000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"ただ、一つ異なる点はといえば、コストとタイムを抑え、自滅するのを防ぎながら、節約〇〇〇〇したくらいだ。","transitionName":"クロスディゾルブ","id":"1973016E-F95B-46D5-A122-2DBF3544E499"},{"title":"シーン 284","characterName":"霧雨魔理沙","slideTitle":"第284スライド","duration":5.4,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"だけども、その過程のどこかに彼女たちが変化する要因があったのだと考える。そして、その要因は僕の行動にある…。","transitionName":"クロスディゾルブ","id":"C5463EC1-1B6B-43BC-8441-1EA4507C4F53"},{"title":"シーン 285","characterName":"霧雨魔理沙","slideTitle":"第285スライド","duration":5.7,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"だが、僕は頭をフル回転して解析しても、特に明確な答えは見つからなかった。ふと二人を見ると、食器が空なのに気づく。","transitionName":"クロスディゾルブ","id":"187D88D8-627C-42AB-B244-4F3B17AEAA6F"},{"title":"シーン 286","characterName":"霧雨魔理沙","slideTitle":"第286スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「ご飯、食べ終わったんですね。」僕はそういうと、二人が空にした食器を共同キッチンに運び、後片付けをする。","transitionName":"クロスディゾルブ","id":"1CEAC65D-F1A8-4D82-A450-8ACDAC262FA7"},{"title":"シーン 287","characterName":"霧雨魔理沙","slideTitle":"第287スライド","duration":5.300000000000001,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そして、後片付けが終わると、ふと向こうにポケベルを忘れていったことを思い出し、霊夢たちにその在処を尋ねる。","transitionName":"クロスディゾルブ","id":"952CD511-5C9F-491D-863C-D7A8D76B83A9"},{"title":"シーン 288","characterName":"霧雨魔理沙","slideTitle":"第288スライド","duration":4.2,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「あんたのポケベルのことすっかり忘れていたわ。」\n私は、そう言い、彼のポケベルを探す。","transitionName":"クロスディゾルブ","id":"FE1F13B2-C4B9-415B-A564-B59A64CA5909"},{"title":"シーン 289","characterName":"霧雨魔理沙","slideTitle":"第289スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"そして、スーツケースから彼のポケベルを取り出すと彼に渡す。\n「ポケベルを無くさないように気をつけてよね…」","transitionName":"クロスディゾルブ","id":"8C55A737-9344-4566-8B90-DA0561978EE3"},{"title":"シーン 290","characterName":"霧雨魔理沙","slideTitle":"第290スライド","duration":5.6000000000000005,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「そうですね…、しっかりと自分で管理して無くさないようにします。」僕はそう言いながら、ポケベルをポッケに入れる。","transitionName":"クロスディゾルブ","id":"E85C5265-97D1-496C-BD76-5AA6E2B03003"},{"title":"シーン 291","characterName":"霧雨魔理沙","slideTitle":"第291スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「それで、霊夢さんたちは、これからどうしますか？」\n僕はそう尋ねる。","transitionName":"クロスディゾルブ","id":"149161B9-B5A9-49A8-927F-C6DD994C10D3"},{"title":"シーン 292","characterName":"霧雨魔理沙","slideTitle":"第292スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「少しばかし、夜の風でも浴びてこようかしら…」\n私は彼にそう返す。","transitionName":"クロスディゾルブ","id":"3357E675-DC84-43C3-A358-4E2F1C2C9943"},{"title":"シーン 293","characterName":"霧雨魔理沙","slideTitle":"第293スライド","duration":4.800000000000001,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「それなら、風邪をひかないように気をつけてくださいね。\nこっちは向こうの気温とは異なりますから。」","transitionName":"クロスディゾルブ","id":"67ED3141-6C6B-429D-A9FB-9C861815FCF4"},{"title":"シーン 294","characterName":"霧雨魔理沙","slideTitle":"第294スライド","duration":3.8000000000000003,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「わかったわ。ほら、魔理沙も一緒にいきましょ。」\n私はそう言い、魔理沙を誘う。","transitionName":"クロスディゾルブ","id":"9CE3004C-49FD-4049-A27F-BCF4320390D5"},{"title":"シーン 295","characterName":"霧雨魔理沙","slideTitle":"第295スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","telop":"「わかったのだぜ。」\n私はそう返すと、霊夢と一緒に外に出た。","transitionName":"クロスディゾルブ","id":"CD753CBC-1389-4F0B-B92A-E3C32FA373E2"},{"title":"シーン 296","characterName":"操夢","slideTitle":"第296スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"一人部屋３（夜・照明ON）.jpg","telop":"僕はそれから、自分の部屋に戻り、入浴を済ますと、ベッドから異臭を感じ、さっと掛け布団を外すと浴室に運ぶ。","transitionName":"クロスディゾルブ","id":"EB4417D5-9E7B-4A3B-B870-238784CA43F6"},{"title":"シーン 297","characterName":"操夢","slideTitle":"第297スライド","duration":5.2,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、入浴が終わる際に抜いた浴槽の栓を再びつけて、蛇口をひねて水を出し、洗剤と掛け布団を浴槽に入れる。","transitionName":"クロスディゾルブ","id":"6627D1A2-1629-444F-AD0D-45C2A0CD8967"},{"title":"シーン 298","characterName":"操夢","slideTitle":"第298スライド","duration":6.1000000000000005,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そのまま、枕とマットレスも入れ込むと、僕は、頭の中で時間を計算してから、乾燥と自動栓抜きのタイマーをセットし、部屋に戻る。","transitionName":"クロスディゾルブ","id":"91AD9B20-44C0-4F5F-AD25-5F54C1551592"},{"title":"シーン 299","characterName":"操夢","slideTitle":"第299スライド","duration":3.8000000000000003,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、霊夢から渡された自分のポケベルと、\n自分の子機につなぎ、画面をのぞく。","transitionName":"クロスディゾルブ","id":"CF56995D-EC76-4B73-AF16-329D1B0EB5A2"},{"title":"シーン 300","characterName":"操夢","slideTitle":"第300スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"電源復旧モード\nこのPCは、何らかの原因により、電源が破損しています。\nお使いの接続機器で電源を修復する場合はエンターを押します。\n僕は、画面の指示に従い、エンターキー押す。","transitionName":"クロスディゾルブ","id":"C0EBCF33-C926-4A8B-A3F8-FA1A4AE7BC93"},{"title":"シーン 301","characterName":"操夢","slideTitle":"第301スライド","duration":30,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"自動電源修復を実行中…\n自動電源修復処理中は、接続機器を外さないでください。\n処理中に外すと二度と電源がつかなくなる可能性があります。\nすると、画面が切り替わりくるくる回る円が表示される。","transitionName":"クロスディゾルブ","id":"ABE2A0F0-A8BC-4ED8-9165-308259336EAC"},{"title":"シーン 302","characterName":"操夢","slideTitle":"第302スライド","duration":10,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"メンテナンスモードで起動中…\n自動電源修復に成功しました。メンテナンスモードを起動しています…\n電源は落とさないでください。\nすると、再度画面が切り替わり、くるくる回る円が表示される。","transitionName":"クロスディゾルブ","id":"750A3656-C012-4675-8A97-9200DC6B023C"},{"title":"シーン 303","characterName":"操夢","slideTitle":"第303スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、灰色の画面に白いポップアップが出てくる。\nメンテナンスモード\n自動修復を実行中…\n破損データがないか確認中です…","transitionName":"クロスディゾルブ","id":"B186419D-9245-4D79-B680-BFC1FB970346"},{"title":"シーン 304","characterName":"操夢","slideTitle":"第304スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、「電源処理の異常を確認中です…」と表示される。\nメンテナンスモード\n自動修復を実行中…\n電源処理の異常を確認中です…","transitionName":"クロスディゾルブ","id":"961EDA92-CB0A-47C8-AFD2-322F37F43E34"},{"title":"シーン 305","characterName":"操夢","slideTitle":"第305スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、「電源処理の異常を修復中です…」と表示される。\nメンテナンスモード\n自動修復を実行中…\n電源処理の異常を修復中です…","transitionName":"クロスディゾルブ","id":"F8CBC8D3-8354-4A5B-B4B1-71D05B26E26A"},{"title":"シーン 306","characterName":"操夢","slideTitle":"第306スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、Bキーを押す。\nメンテナンスモード\n自動修復を実行中…\n電源処理の修復は成功しました。\n以下の選択肢から\n選んでキーを押してください。\n他にも破損しているプログラムがないか確認する\nポケベルアプリをメンテナンスモードで開く\n再起動をする。","transitionName":"クロスディゾルブ","id":"937296E8-E76B-45BC-BCC3-92770430105C"},{"title":"シーン 307","characterName":"操夢","slideTitle":"第307スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、次にAキーを押す。\nポケベルアプリ\nポケベルアプリ\n次のアクションを以下から選び、\n該当するキーを押します。\nインターネットに接続し、自動修復を続行する\nローカル環境での\n手動修復を続行する\n何もせずにアプリを閉じる","transitionName":"クロスディゾルブ","id":"CCEE9DC1-1BA5-4DEA-8042-C5A091C93ED9"},{"title":"シーン 308","characterName":"操夢","slideTitle":"第308スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、あの音がポケベルから流れ出す。\nポケベルアプリ\nポケベルアプリ\nインターネットに接続中です…","transitionName":"クロスディゾルブ","id":"0057229B-4033-4C94-A3F2-C755236C202A"},{"title":"シーン 309","characterName":"操夢","slideTitle":"第309スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"僕は、選択肢が出てくると、Aキーを押す。\nポケベルアプリ\nポケベルアプリ\n親機が見つかりました。\n次のアクションを以下から選び、\n該当するキーを押します。\n親機のプログラムを複製し、この子機に入れる\nインターネット上から修復処理を実行する\nローカル環境での\n修復を実行する","transitionName":"クロスディゾルブ","id":"3026A983-816F-4574-92BD-C85DAAAD9F60"},{"title":"シーン 310","characterName":"操夢","slideTitle":"第310スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、親機からのプログラム複製と流し込みが始まる。\nポケベルアプリ\nポケベルアプリ\n親機からプログラムを複製し、このコンピューターに流し込んでます…","transitionName":"クロスディゾルブ","id":"A7D5FA42-BA8A-485E-A497-BD653F0433E3"},{"title":"シーン 311","characterName":"操夢","slideTitle":"第311スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"そして、プログラムの照らし合わせが始まる。\nポケベルアプリ\nポケベルアプリ\nインストールが完了しました。このコンピューター上のプログラムと親機のプログラムを照合しています…","transitionName":"クロスディゾルブ","id":"9A1CE760-68B9-4DC0-B01A-C07E3FE53D8C"},{"title":"シーン 312","characterName":"操夢","slideTitle":"第312スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"最後に再起動処理が始まる。\nポケベルアプリ\nポケベルアプリ\n修復が完了しました…。\nこのコンピューターを再起動中です。","transitionName":"クロスディゾルブ","id":"1348A74E-749F-4A80-AE5C-52AEE2A9B25A"},{"title":"シーン 313","characterName":"操夢","slideTitle":"第313スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"すると、起動音が鳴り、くるくる回る円とリンゴマークが出る。","transitionName":"クロスディゾルブ","id":"07039801-BE47-43C7-BDBB-217990096E6D"},{"title":"シーン 314","characterName":"操夢","slideTitle":"第314スライド","duration":4.4,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"再起動が終わると、デスクトップが出てきた。\nそして、僕はそこからネットサーフィンを始めた。\nFiles\nポケベル\nポケベル\nFiles\n編集\n表示\n移動\nウィンドウ\nヘルプ","transitionName":"クロスディゾルブ","id":"13A9C177-4FDF-49F6-B67E-A7D39E7E827E"},{"title":"シーン 315","characterName":"ナレーション","slideTitle":"第315スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"次回予告","transitionName":"クロスディゾルブ","id":"D2D86446-22D2-433F-9A7B-5AD37F4F902D"},{"title":"シーン 316","characterName":"操夢","slideTitle":"第316スライド","duration":5.800000000000001,"animationName":"フェードイン","backgroundName":"一人部屋３（夜・照明ON）.jpg","telop":"僕は、ネットサーフィンを区切りよく終えるとちょうど、浴槽に入れていた布団などが乾ききり、ベッドに乗せて、眠りにつく。","transitionName":"クロスディゾルブ","id":"0967DF48-2719-4FB9-9CEB-AAC950564D55"},{"title":"シーン 317","characterName":"操夢","slideTitle":"第317スライド","duration":3.5,"animationName":"フェードイン","backgroundName":"一人部屋３（日中）.jpg","telop":"そして、目が覚めると、\nベッドから起き上がり共同スペースに向かう。","transitionName":"クロスディゾルブ","id":"CE99F322-A988-48F2-A28A-497D02BFF76B"},{"title":"シーン 318","characterName":"操夢","slideTitle":"第318スライド","duration":4.4,"animationName":"フェードイン","backgroundName":"リビング（日中）.jpeg","telop":"僕が、共同スペースに来ると、ちょうど朝ごはんが食卓に並べられていて、それを食べ始めると…","transitionName":"クロスディゾルブ","id":"7A451DF4-794C-45FA-89AB-688BC8AB8D76"},{"title":"シーン 319","characterName":"ナレーション","slideTitle":"第319スライド","duration":9.4,"animationName":"フェードイン","backgroundName":"nc73538_【背景素材】博麗神社.jpg","telop":"ご視聴ありがとうございました\n出典\n立ち絵：はるか様\n音声：ゆっくりボイスメーカー\n背景：みんちりえ・ニコニコモンズ様\nBGM：ニコニコモンズ様\n効果音：効果音ラボ様\n製作者：zuyasi","transitionName":"クロスディゾルブ","id":"3280D3FB-8689-4284-B5A5-1D09F9E59AA9"}]