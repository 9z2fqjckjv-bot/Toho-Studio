[{"title":"シーン 1: @zuyasi　東方Project二次創作作品","id":"EFD52D6B-60FA-4D7B-AD5A-57346591D41B","duration":15,"transitionName":"なし","slideTitle":"スライド #1","characterName":"博麗霊夢","telop":"幼き日の夢","backgroundName":"単色背景","animationName":"バウンス","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.001.jpeg","videoPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_animations\/第13話_3b89f50e33\/slide_001_anim.m4v"},{"title":"シーン 2","telop":"僕は、それからやることだけやると、紅魔館から離れ、\nある場所に向けて歩き始めた。","id":"8943CECB-4954-47D8-9B91-64F6A4774E37","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.002.jpeg","voiceDuration":5.719115646258503,"duration":6.319115646258503,"slideTitle":"スライド #2","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc73544_【背景素材】紅魔館.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 3","telop":"それから、数十分ほど歩き続け、ある林道を歩いていると、ふと誰かがこちらにやってくる。","id":"FECE210D-905F-4214-87D0-B6414824410D","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.003.jpeg","voiceDuration":6.097369614512472,"duration":6.697369614512471,"slideTitle":"スライド #3","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 4","telop":"「よう、操夢。これからどこかに行くのか？」","id":"7809EADA-7F3F-4EFE-A906-BC77147033C5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.004.jpeg","voiceDuration":3.5819954648526076,"duration":4.181995464852608,"slideTitle":"スライド #4","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_marisa","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"霧雨魔理沙","animationName":"なし"},{"title":"シーン 5","telop":"「ええ、そうです。それで、魔理沙さんは？」\n僕はそう尋ねるが、嫌な気配を感じ、彼女を抱き上げ、身を隠す。","id":"E5D7A805-BCFF-439F-8807-C003B59D7A82","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/衣擦れ2.mp3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.005.jpeg","voiceDuration":8.312607709750568,"duration":8.912607709750567,"slideTitle":"スライド #5","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","animationName":"なし","seName":"SE: 衣擦れ2"},{"title":"シーン 6","telop":"僕は、何か言おうとしている彼女に、\n声を出さないようにと伝える。","id":"AE6076E3-197E-4D06-9BA9-6E1FE1F9D7B5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.006.jpeg","voiceDuration":4.30390022675737,"duration":4.9039002267573695,"slideTitle":"スライド #6","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 7","telop":"そして、目線をその気配に戻す…。\nそこには、紫がいた。","id":"EC26F490-84C5-40E7-B991-4011E5F87B23","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.007.jpeg","voiceDuration":4.310430839002268,"duration":4.9104308390022675,"slideTitle":"スライド #7","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 8","telop":"「隠れたって無駄よ、出てきなさい。」","id":"8CCEC14C-E92A-469A-85FD-EC7D11D3D765","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_八雲紫.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.008.jpeg","voiceDuration":2.2072789115646256,"duration":3.5,"slideTitle":"スライド #8","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","characterName":"八雲紫","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"八雲紫","animationName":"なし"},{"title":"シーン 9","telop":"僕は、まだ驚いている魔理沙に、耳打ちする。","id":"ECEF5DB7-84B5-431A-A49C-F632D24199EC","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.009.jpeg","voiceDuration":3.1256462585034015,"duration":3.7256462585034016,"slideTitle":"スライド #9","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 10","telop":"私は、彼に、紫の目の前にマスタースパークを打って欲しいと頼まれ、少し考え込んだ後引き受ける。","id":"AF3582B7-2275-41A5-822D-C027653A45A5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.010.jpeg","voiceDuration":8.036984126984127,"duration":4.6000000000000005,"slideTitle":"第10スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"霧雨魔理沙","animationName":"なし"},{"title":"シーン 11","telop":"そして、紫の目の前を横切るように、スパークを打つと、ほんの一筋の光と闇が現れた隙に、彼と共に箒に跨り、飛び出した。","id":"1721BDFE-BB18-46B1-89FA-6F27E50AD5CF","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_011_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.011.jpeg","voiceDuration":10.819478458049886,"duration":11.564489795918368,"slideTitle":"スライド #11","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_marisa","characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"霧雨魔理沙","animationName":"なし"},{"title":"シーン 12","telop":"二人が向かった先は…","id":"254B7FF2-9B92-4FC5-94FD-AF67CBF3F864","animationNote":"表示時間：3秒","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.012.jpeg","duration":3,"slideTitle":"スライド #12","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","characterName":"ナレーション","transitionName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationName":"なし","animationDuration":3},{"title":"シーン 13","telop":"僕たちは、それから、守谷神社にやってくると、\n霊夢がこちらに駆け寄ってくる。","id":"82FB7C48-B1D2-4B81-8AE4-6599E6A03487","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.013.jpeg","voiceDuration":5.266938775510204,"duration":5.866938775510204,"slideTitle":"スライド #13","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 14","telop":"「あんた、いつの間に私のとこに来たの？」","id":"B033FB20-FA2F-40A6-B21D-64CD026C0403","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.014.jpeg","voiceDuration":3.194489795918367,"duration":3.794489795918367,"slideTitle":"スライド #14","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","characterName":"博麗霊夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"博麗霊夢","animationName":"なし"},{"title":"シーン 15","telop":"「ついさっきですよ、それで、霊夢さんは、一時避難ですか？」","id":"B7A29C30-DF37-47E0-BE31-95FFDD02D580","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.015.jpeg","voiceDuration":4.1952154195011335,"duration":4.795215419501133,"slideTitle":"スライド #15","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 16","telop":"「ええ、そうよ。魔法使いに神社を丸ごと燃やされたからね。\nねぇ、魔理沙、そこにいるのでしょう？」","id":"7615F0C7-A236-4B8F-9A5E-6B176041276C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.016.jpeg","voiceDuration":8.056984126984126,"duration":8.656984126984126,"slideTitle":"スライド #16","audioTrack":"track_voice_reimu","characterName":"博麗霊夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"博麗霊夢","animationName":"なし"},{"title":"シーン 17","telop":"「まぁ、魔理沙には、あの小屋で全て言ったからいいわ。」","id":"49B0524F-D107-4AAB-9D1E-F6A2D46EED2C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.017.jpeg","voiceDuration":3.941995464852608,"duration":4.541995464852608,"slideTitle":"スライド #17","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","characterName":"博麗霊夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"博麗霊夢","animationName":"なし"},{"title":"シーン 18","telop":"私は、そこでふと思い出す。そして、守谷神社に入っていく。","id":"37C9B60A-AA52-41CC-816B-6FF38FE048F5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.018.jpeg","voiceDuration":5.309478458049886,"duration":5.909478458049886,"slideTitle":"スライド #18","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","characterName":"博麗霊夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"博麗霊夢","animationName":"なし"},{"title":"シーン 19","telop":"僕は、追っ手が来る前に、彼女の後について神社に入っていく。","id":"D4D364FF-6C22-4E76-8785-B84B77D122C4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.019.jpeg","voiceDuration":4.247369614512472,"duration":4.847369614512472,"slideTitle":"スライド #19","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc73543_【背景素材】守矢神社.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 20","telop":"そして僕は、こないだ来た時にも入った和室で休む。","id":"6896AE6F-F496-44FB-9B67-FBACD5B72A24","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.020.jpeg","voiceDuration":3.5430385487528344,"duration":4.143038548752834,"slideTitle":"スライド #20","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 21","telop":"すると、誰かが襖を開けて入ってくる。","id":"917096EE-AA81-4AE1-B0B7-DF4B94C46BFF","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ふすまを開ける1.mp3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.021.jpeg","voiceDuration":2.6865079365079363,"duration":3.5,"slideTitle":"スライド #21","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし","seName":"SE: ふすまを開ける1"},{"title":"シーン 22","telop":"「これ、何でかわからないけど、神社の燃え後に放置されてたのよ。」私はそういうと、その荷物を渡す。","id":"2FB9A4C6-7397-46FF-A321-1DE9063257D7","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.022.jpeg","voiceDuration":8.389478458049886,"duration":8.989478458049886,"slideTitle":"スライド #22","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 23","telop":"僕は、その箱を開けて中身を取り出す。そして、それを取り出すと、中身を確認する。中身は空で、箱には弾が入っていた。","id":"6F8951CE-EA5E-4C3A-80BE-548497005CDF","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_023_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.023.jpeg","voiceDuration":9.262607709750567,"duration":5.6000000000000005,"slideTitle":"第23スライド","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 24","telop":"「これ、何なの？」","id":"25B133CE-84B8-4D7F-9487-C07F0E7E6909","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.024.jpeg","voiceDuration":1.5,"duration":3.5,"slideTitle":"スライド #24","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 25","telop":"「これは、弾を詰め込んで、引き金を引くことで、\nその弾を相手に当てるのが目的の道具ですよ。」","id":"5767703F-A7E1-4171-BAC0-28731BC17CD5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.025.jpeg","voiceDuration":6.397369614512471,"duration":6.997369614512471,"slideTitle":"スライド #25","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし"},{"title":"シーン 26","telop":"「へぇ、まぁ、とりあえず、中身の管理は任せたわ。」\n私はそういうと、その場を離れた。","id":"1B5EF5B9-9E06-42B3-AFCE-B74D5A9EECD0","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/第13話_d1addf853c\/第13話_d1addf853c.026.jpeg","voiceDuration":6.466938775510204,"duration":7.066938775510204,"slideTitle":"スライド #26","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第1話\/nc467347_和室【フリー素材あそび】.jpg","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","characterName":"操夢","transitionName":"なし","backgroundName":"nc467347_和室【フリー素材あそび】.jpg","voiceCharacter":"操夢","animationName":"なし"}]