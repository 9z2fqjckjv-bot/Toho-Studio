Hub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 163","seStartTimeOffset":0,"telop":"「今すぐ、美鈴が迎えにくるわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第164スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_164_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"E47E3FD6-243C-4E21-964E-5EAF38D52B80","audioTrack":"track_voice_reimu","voiceDuration":7.8119954648526075,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 164","seStartTimeOffset":0,"telop":"「ありがとうございます、お嬢様。」\n私はそう言うと、先ほどの通話に切り替える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第165スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_165_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"57315F4C-A519-4A48-B7B5-8D3168E7D45D","audioTrack":"track_voice_reimu","voiceDuration":4.996984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 165","seStartTimeOffset":0,"telop":"「大丈夫でしたでしょうか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第166スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_166_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"9CA7D896-DD04-462D-88A3-47C7E6566CE1","audioTrack":"track_voice_reimu","voiceDuration":5.781995464852607,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 166","seStartTimeOffset":0,"telop":"「今、使えの者に車を出させたので、おそらく小一時間ほどで病院に着きます。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第167スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_167_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"E6927491-3606-4C10-A2FF-62C62F151E1C","audioTrack":"track_voice_reimu","voiceDuration":3.274489795918367,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 167","seStartTimeOffset":0,"telop":"「わかりました、ではこちらにお越しくださいましたら、受付に操夢さんに用があってきたとお申し付けください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第168スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_168_レミリア・スカーレット.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"FB5E4E13-D310-466F-B737-7B63F505D59D","audioTrack":"track_voice_reimu","voiceDuration":1.2444897959183674,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 168","seStartTimeOffset":0,"telop":"「承知しました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第169スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_169_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"50501E0C-7388-4ACB-9D4F-A8901712630A","audioTrack":"track_voice_reimu","voiceDuration":6.696984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 169","seStartTimeOffset":0,"telop":"「では、失礼します。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第170スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_170_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"CC23E5F5-EC52-406A-B8E0-31B7775C1EF5","audioTrack":"track_voice_reimu","voiceDuration":5.326984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 170","seStartTimeOffset":0,"telop":"私は、相手が通話を切ると、受話器を元に戻す。\nすると、上から誰かの足音がする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第171スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_171_レミリア・スカーレット.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"33948D06-2009-4202-97FA-FA59E9E38CE4","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 171","voiceDuration":2.1842403628117912,"seStartTimeOffset":0,"telop":"「咲夜、すぐに急行するわよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第172スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_172_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"CAB71735-6592-4253-B102-18D02ACE7A54","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 172","voiceDuration":8.960748299319729,"seStartTimeOffset":0,"telop":"「わかりました、お嬢様。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第173スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_173_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"2CF60BD2-7F44-4600-A7F2-3C23C6FF4D2D","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 173","voiceDuration":7.156984126984127,"seStartTimeOffset":0,"telop":"そして私たちは、二人のいる病院に急行するのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第174スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_174_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3152289A-DD90-47EB-9A0F-6AA8651646B7","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 174","voiceDuration":7.169478458049887,"seStartTimeOffset":0,"telop":"彼の病室では","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第175スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_175_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"CFA97E57-2ABA-44DF-80EC-AFFD34EA1218","audioTrack":"track_voice_reimu","voiceDuration":8.095736961451248,"title":"シーン 175","seStartTimeOffset":0,"telop":"「操夢…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第176スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_176_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"6C706788-9A0A-48AB-92C6-3DC0B77C4C56","audioTrack":"track_voice_reimu","voiceDuration":7.761995464852608,"title":"シーン 176","seStartTimeOffset":0,"telop":"「どうした…フラン…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第177スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_177_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"8270FDF2-AFF2-4EF0-BFAB-839BBEFC4B84","audioTrack":"track_voice_reimu","voiceDuration":6.396984126984127,"title":"シーン 177","seStartTimeOffset":0,"telop":"「私…操夢の血…飲みすぎちゃった…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第178スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_178_フランドール・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"9CC636E5-2E63-4D4C-B545-F756AB8CAC22","audioTrack":"track_voice_soumu","voiceDuration":5.044489795918367,"title":"シーン 178","seStartTimeOffset":0,"telop":"「僕は…大丈夫だよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第179スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_179_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"BC405570-F9C6-4B50-8731-1A1A848F9BD1","audioTrack":"track_voice_soumu","voiceDuration":6.689478458049886,"title":"シーン 179","seStartTimeOffset":0,"telop":"「無理しないでいいよ…操夢…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第180スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_180_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"947A348C-BD92-4604-A7D1-C9FE81AC2DE4","audioTrack":"track_voice_soumu","voiceDuration":5.759478458049887,"title":"シーン 180","seStartTimeOffset":0,"telop":"「僕は…フランたちが…元気なら…それだけで…いいよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第181スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_181_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"730A01DC-0AF5-445C-B7BD-07BEC30CF7C8","audioTrack":"track_voice_soumu","voiceDuration":2.901995464852608,"title":"シーン 181","seStartTimeOffset":0,"telop":"「そんなこと…言わないでよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第182スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_182_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"7E7F07A0-E24C-449C-AB70-CFC199998C4C","audioTrack":"track_voice_soumu","voiceDuration":6.924489795918367,"title":"シーン 182","seStartTimeOffset":0,"telop":"「そうか…でも…僕なんて…フランたちに…比べれば…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第183スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_183_パチュリー・ノーレッジ.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"547A0C9B-C654-4F48-B19D-7C0F55F9EA3E","audioTrack":"track_voice_soumu","voiceDuration":3.6189795918367347,"title":"シーン 183","seStartTimeOffset":0,"telop":"「そんなことを…言っちゃダメ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第184スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_184_十六夜咲夜.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"1A85B99C-C750-4357-953B-EF3AF65F5E64","audioTrack":"track_voice_soumu","voiceDuration":4.270861678004535,"title":"シーン 184","seStartTimeOffset":0,"telop":"「そうか…ごめん…フラン…」\n僕はそう言うと、瞼が重くなる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第185スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_185_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"05F48C14-115A-4D51-B830-B9D57F498539","audioTrack":"track_voice_soumu","voiceDuration":3.896984126984127,"title":"シーン 185","seStartTimeOffset":0,"telop":"「おやすみ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第186スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_186_パチュリー・ノーレッジ.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"D80A45E7-E1F0-485F-AFC2-940A40FEF9CD","audioTrack":"track_voice_reimu","voiceDuration":5.967369614512472,"title":"シーン 186","seStartTimeOffset":0,"telop":"私は、そう言う彼にはっとし、咄嗟に口付けをする。\n「そんなこと、言わないで…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第187スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_187_十六夜咲夜.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"9B85564F-8C01-48C3-8944-A59847967BD5","audioTrack":"track_voice_soumu","voiceDuration":6.106734693877551,"title":"シーン 187","seStartTimeOffset":0,"telop":"僕は、彼女からの突然の口付けに、沈みかけた意識が戻ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第188スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_188_パチュリー・ノーレッジ.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"534416C6-4432-4A6C-82AC-1E31B7E6F93B","audioTrack":"track_voice_reimu","voiceDuration":6.10061224489796,"title":"シーン 188","seStartTimeOffset":0,"telop":"「ほら…意識を戻して…、また眠りたくなったら行って…、私が寝かせないから…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第189スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_189_十六夜咲夜.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"45BB4C7A-DC63-4817-8207-9D7F775FAC98","audioTrack":"track_voice_reimu","voiceDuration":4.2588662131519275,"title":"シーン 189","seStartTimeOffset":0,"telop":"「分かったよ…ありがとう…フラン。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第190スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_190_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"BC7635F9-F253-4393-8A57-53F5F6DFA7B4","audioTrack":"track_voice_reimu","voiceDuration":7.794489795918367,"title":"シーン 190","seStartTimeOffset":0,"telop":"「そういえば…フランとの3日間…霊夢たちに比べると…色濃いね…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第191スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_191_十六夜咲夜.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"1FDFE872-B157-4137-A52F-718AD4CDAA22","audioTrack":"track_voice_reimu","voiceDuration":5.248480725623582,"title":"シーン 191","seStartTimeOffset":0,"telop":"「何で…そんなことを…当たり前でしょ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第192スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_192_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"8138700B-D4E3-433F-A59E-BA7ECFF1D605","audioTrack":"track_voice_soumu","voiceDuration":5.660748299319728,"title":"シーン 192","seStartTimeOffset":0,"telop":"「うん…そうだね…」\n僕はそう言うと、再び瞼が重くなってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第193スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_193_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"2A6098D7-7DA2-40BC-8ADF-F97AAD4BFA38","audioTrack":"track_voice_reimu","voiceDuration":9.794489795918368,"title":"シーン 193","seStartTimeOffset":0,"telop":"私は、再び眠りかける彼に、先ほどよりも強めの口付けをする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第194スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_194_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"98157F38-D6FD-4E4E-8758-10B0DD3BDCDC","audioTrack":"track_voice_soumu","voiceDuration":5.896984126984127,"title":"シーン 194","seStartTimeOffset":0,"telop":"僕は再び、沈みかけた意識が戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第195スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_195_パチュリー・ノーレッジ.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"F5A45643-1886-432B-B62B-2268C2DA9351","audioTrack":"track_voice_soumu","voiceDuration":2.7633560090702947,"title":"シーン 195","seStartTimeOffset":0,"telop":"すると、突如として病室のドアが開く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第196スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_196_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"3A686FF6-5971-4278-B251-096EE78C595A","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","title":"シーン 196","voiceDuration":7.439478458049886,"seStartTimeOffset":0,"telop":"「操夢！」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第197スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_197_パチュリー・ノーレッジ.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"E23056BE-1B1E-4C34-9DF8-56F07015D288","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","title":"シーン 197","voiceDuration":1.1808616780045351,"seStartTimeOffset":0,"telop":"そこには、涙と驚きの表情をした、お姉様とパチュリーがいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第198スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_198_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E0FDBECD-502A-47FC-94CA-05B30929EC88","audioTrack":"track_voice_soumu","voiceDuration":7.174489795918367,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 198","seStartTimeOffset":0,"telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第199スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_199_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256899_病室-夜-電気あり.png","id":"960040C9-2797-4AE1-9459-555B857BC013","audioTrack":"track_voice_reimu","voiceDuration":3.294489795918367,"title":"シーン 199","seStartTimeOffset":0,"telop":"私たちが彼の病室に入ると、そこには壁に寄りかかり、眠るフランとレミリアとパチュリーがいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第200スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_200_パチュリー・ノーレッジ.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc256899_病室-夜-電気あり.png","id":"1546D107-C11A-43B9-A8FC-B2D3C7A481B6","audioTrack":"track_voice_reimu","voiceDuration":2.8088662131519273,"title":"シーン 200","seStartTimeOffset":0,"telop":"私たちは、ここにくる際に上からの指示?が届き、それに従うことになり、私が彼の相手になる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第201スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"01195370-12E1-4860-AC87-AF8062235D6B","seStartTimeOffset":0,"title":"シーン 201","telop":"なぜか、看護師などは何もせず、私は代わりに彼の食事を彼に食べさせる。そんな中彼の顔が頬照って行き…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"単色背景","id":"50E6B5D4-5398-4B98-9D0F-134089EF09C3","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"C81ABD69-DC11-4068-BCD8-5FBE75BE506F","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第204スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"A4AC4F70-A938-4DC1-AD8A-C3ED35482EFB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 204","telop":"「はぁ、なんか疲れたわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第205スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"CB574415-1DD1-43E6-A89B-9591F94AF04E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 205","telop":"「お姉様、私少し眠ってもいい？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第206スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"29D752D0-1864-449C-BD6C-3B7C7CE2254B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 206","telop":"「ええ、いいわよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第207スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"2A308B52-208B-43A6-9A9F-D919AC949E30","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 207","telop":"私がそう言うとフランは、壁によるかかる形で座り眠り始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第208スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"C260112D-CA73-4F10-828B-7DE96110F2F4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 208","telop":"私も少し、休むわ…。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第209スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"83B71B9F-72CD-42C6-8C2A-8ED7C972B230","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 209","telop":"「分かったわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第210スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"BFAF7F72-2D0E-4315-BE9B-580C14362AB2","seStartTimeOffset":0,"title":"シーン 210","telop":"私がそう言うとパチュリーも壁に寄りかかるように座り、休み出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第211スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"ECFF3940-A9F4-4A4F-A2EC-67ADC7C674C9","seStartTimeOffset":0,"title":"シーン 211","telop":"「ねぇ、あんた。いったい何があったのよ？」\n私はベッドで横になる操夢に声をかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第212スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"FF82ABDF-1AF4-4EA6-8271-1FBA25E751DA","seStartTimeOffset":0,"title":"シーン 212","telop":"「僕とフランは、僕の部屋に戻った後、西湖公園に行きたいとフランが言って、僕はそこであることを思いついたんです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第213スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"ACB41D40-449D-4B87-9B90-960DD3E65CAB","seStartTimeOffset":0,"title":"シーン 213","telop":"「あること？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第214スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"1FD2C07C-3C39-4175-9E08-F316A776CF3D","seStartTimeOffset":0,"title":"シーン 214","telop":"「多分、レミリアさんも既に知ってると思うんですが、僕は生まれつき運動神経が悪くて…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第215スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"B99E4F78-BBC4-4EEF-A686-58B4F5C35042","seStartTimeOffset":0,"title":"シーン 215","telop":"「たしか、周りの同年代に比べると、成長速度も遅かったって言っていたわよね…、それで何を思いついたの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第216スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"BC27FD99-99FA-4AA4-879E-4A8E3E38D706","seStartTimeOffset":0,"title":"シーン 216","telop":"「僕は、もしある状態でフランと競争したら、運動神経が劣っている僕でも勝てるかなっと思って、それを試したんです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第217スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4E62FF32-B0CE-4EE7-B5BE-A9563501E9F2","seStartTimeOffset":0,"title":"シーン 217","telop":"「それで、何を試したの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第218スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"E41AFB51-1F4B-4ECB-9333-E756DB0E665F","seStartTimeOffset":0,"title":"シーン 218","telop":"「彼女にワイン入りの水筒を持たせて、競争したんです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第219スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"01F1A48E-40C2-4E7A-967F-90065FBBC7CA","seStartTimeOffset":0,"title":"シーン 219","telop":"「えっ、それで、その結果はどうなったの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第220スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"2D97585C-80F0-49EA-AD50-7CFDFD108960","seStartTimeOffset":0,"title":"シーン 220","telop":"「僕が１周した時には既に、フランが道路の端に座り込んでました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第221スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"C4697514-CA3E-4741-A028-04ADA3D3A8B2","seStartTimeOffset":0,"title":"シーン 221","telop":"「はぁ、じゃあ、なんでこんな騒ぎになったのよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第222スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"1725170E-07C0-43D1-BD0B-350E611F4F8B","seStartTimeOffset":0,"title":"シーン 222","telop":"「彼女は、すぐに眠り始めたので、僕がおんぶする形で歩き出しました。ですが、その途中に彼女が無意識に僕に噛みついて…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第223スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4995AF28-929A-408C-875B-B73CA21C38EC","seStartTimeOffset":0,"title":"シーン 223","telop":"「それで、そのまま意識を失ったの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第224スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"695F72B7-6DD7-4D5D-86C7-8D4AD50F88CC","seStartTimeOffset":0,"title":"シーン 224","telop":"「僕は、彼女が噛みついた後、こけてしまって、その時の衝撃と血が抜けた状態が重なって気絶して、気づいたら、ここに…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第225スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F6A2178B-272A-4615-9625-B8BC1C1016E9","seStartTimeOffset":0,"title":"シーン 225","telop":"「はぁ、あんたね…、まぁ、これはどっちもどっちね…。なんだか、疲れちゃったわ、私も寝かせてもらうわね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第226スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"051F3FD5-EC7F-4719-9FAD-55591A7668A0","seStartTimeOffset":0,"title":"シーン 226","telop":"すると、彼女も眠りにつき、病室には静けさが残る。\nそんな中、病室のドアが開く音がする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第227スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F0614F00-3CD2-4F5A-AD3C-D6D0EA378945","seStartTimeOffset":0,"title":"シーン 227","telop":"「あんた…何があったのよ…」\n私は病室に入ると、彼に問いかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第228スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"65588FB0-9CAE-464B-8E20-BF1D614838D5","seStartTimeOffset":0,"title":"シーン 228","telop":"僕は、先ほどレミリアにした話をもう一度する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第229スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F1FFA28C-0A1D-45FA-91F9-591C80560A1D","seStartTimeOffset":0,"title":"シーン 229","telop":"「あんたね…、たしかにレミリアの意見はあってるけどね…、あんたには、もっとよく考えて行動するってできないの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第230スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"940CE5FA-4D64-4B99-8E50-B9C61E4B15C9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 230","telop":"私は、そう言うと、はっとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第231スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"ABF78FE8-5B99-4DAA-8BA7-6DBFF1D1C47B","seStartTimeOffset":0,"title":"シーン 231","telop":"「ちょっと言いすぎたわ。あんたは、そう言うの難しいのよね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第232スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"8165808A-A528-46F1-BE9F-FEB7F416A911","seStartTimeOffset":0,"title":"シーン 232","telop":"彼と私がそんな会話をしていると、病室の壁に貼り付けている受話器から着信音がする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第233スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"A119421A-37C1-470E-9494-03500B13923F","seStartTimeOffset":0,"title":"シーン 233","telop":"「ちょっと待ってなさい。」\n私は彼にそう言ってから受話器を取る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第234スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"D0B8B932-915F-416D-A3DF-E272553359AA","seStartTimeOffset":0,"title":"シーン 234","telop":"「もしもし、操夢の面会者の霊夢ですけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第235スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F141FC0B-64BE-42A6-874B-0711507F773E","seStartTimeOffset":0,"title":"シーン 235","telop":"「霊夢さんですね、あのナースステーションまでお越しいただけるでしょうか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第236スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F35D4CFB-51BB-47D4-867D-B1F1CA014EA0","seStartTimeOffset":0,"title":"シーン 236","telop":"「はい？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第237スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"DDAFFB12-5FB7-4CB6-BD25-311709BF0ABC","seStartTimeOffset":0,"title":"シーン 237","telop":"「夕食を持って行って欲しいのですが…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第238スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"981611A6-8F21-4C9D-8070-AE905FFFC6BF","seStartTimeOffset":0,"title":"シーン 238","telop":"「なぜ私が…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第239スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F1EE75DA-DAF8-4B54-ADEF-FF925E65F6A6","seStartTimeOffset":0,"title":"シーン 239","telop":"「院長直々の指示で、私たちはそちらに操夢さんがいる限り、入れないので、代わりに運んで欲しいんです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第240スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"393D8A93-8382-4683-AD81-1F461E96B29A","seStartTimeOffset":0,"title":"シーン 240","telop":"「そうですか、承知しました…」\n私はそう言うと、受話器を元に戻す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第241スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"EE1A741D-C8ED-4AF8-9D3C-839810C8B193","seStartTimeOffset":0,"title":"シーン 241","telop":"「操夢、今から夕食持ってくるから、あんたはそこで大人しくしてなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第242スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F6E6AD28-6FF6-4742-A2B8-00C96ED6F4BE","seStartTimeOffset":0,"title":"シーン 242","telop":"「分かった…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第243スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"5DB33AA6-C48D-4FFF-BB38-32686A0BD1FE","seStartTimeOffset":0,"title":"シーン 243","telop":"僕がそう言うと、彼女は病室から出て行った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第244スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"E72B66BD-3F3F-427F-A5A0-64B1A83D94B7","seStartTimeOffset":0,"title":"シーン 244","telop":"「それにしても、なんでだろう…？」\n僕には、そんな疑問が浮かび上がる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第245スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"33E0361C-8B28-43C2-A22C-35B9C627AE37","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","seStartTimeOffset":0,"title":"シーン 245","telop":"すると、窓をノックする音が聞こえる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第246スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"2AD63C2B-7F67-4F0C-9CBB-FC8F6E2F5802","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 246","telop":"僕は窓の鍵が開けっぱなしになっていることに気がつき、開いてるよと伝えると、魔理沙が入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第247スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4CACF343-8F78-41B5-ADDC-D1B7A82A8D9D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 247","telop":"「よっ、操夢、元気か？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第248スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"981DDC9A-A584-4F90-A891-DA316A36878B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 248","telop":"「…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第249スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"930A9829-2AA0-4965-A0B8-A725FDE7F38D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 249","telop":"「少し、気分が上がりすぎたか…、それでどうだ寝心地は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第250スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"92FC7F93-72C5-4CB8-88E1-EF5AB4D77DBB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 250","telop":"「寝心地は…普通です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第251スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"AB6499E9-47CD-4C90-A7B9-D6A77F002F5C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 251","telop":"「そうか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第252スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"CBE36BDD-4896-45BB-9FC1-D09B4BAD2B56","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 252","telop":"「んっ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第253スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"AFCB919A-F0B5-4DB2-8BD6-8338EA3D04FC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 253","telop":"「ここは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第254スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4DC1E3E4-B943-4433-B877-DB7C7E7D5D2D","seStartTimeOffset":0,"title":"シーン 254","telop":"すると、病室のドアが開く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第255スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"0290A078-25BB-4AB1-83AA-59970F59857A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 255","telop":"「あら、あんたたち起きたの。それと、魔理沙は仕事帰りかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第256スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"976107B1-5CCB-4447-ADE0-9652B482857C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 256","telop":"「それより、ほら、これ夕食よ、あんた。」\n私はそう言って、彼のベッドをまたぐ机に置く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第257スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"7EF4DC78-DD69-4415-91C8-DBF99E50B350","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 257","telop":"「ありがとう…霊夢さん。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第258スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"BDC045F9-33EA-4FAF-B07A-FB9AB694A4EC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 258","telop":"「どういたしまして。それより、魔理沙たちはこれからどうするのよ、私は院長というより上の指示でここに泊まるけど。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第259スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"B23ABDEF-5035-484E-AC8D-51D33A9D9E17","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 259","telop":"「私は、操夢の状態も見れたし、帰るぜ。それで、レミリアたちは？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第260スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4C397E47-5FE7-4F01-AB70-F09FFA997091","seStartTimeOffset":0,"title":"シーン 260","telop":"「私たちは、電車で帰るわ、それで、フランとパチュリーも一緒に帰るでしょ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第261スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"C98F04A3-5755-4A0B-8F57-837184032757","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 261","telop":"「私もレミリアと一緒に帰るわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第262スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"52FD003D-571B-416E-963F-913624CBD010","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","seStartTimeOffset":0,"title":"シーン 262","telop":"「私も、久々に外走って疲れたし、お姉様と一緒に帰る。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第263スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"0D20FC70-746E-49C2-BA99-C40FA9AD35B0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 263","telop":"「そう、じゃあ、咲夜たちに今日私は、帰れないって言っておいて。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第264スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"AA143F37-7213-48AC-998D-7E4218518D15","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 264","telop":"「じゃあ、とりあえず、今日はこれで退散だな。じゃあ、また明日見舞いに来るからな、操夢。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第265スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"799E7844-22D1-4360-9C3D-879CAB74162C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 265","telop":"すると、魔理沙は、窓から外に出て帰り、レミリアたちは病室のドアを開けて出て行った。そして、霊夢と僕だけが残った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第266スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"81BC3AB5-D771-4507-B109-44B2A0D92FCF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 266","telop":"僕は、ふと起きあがろうとすると、霊夢がそれを止める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第267スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"14F4FBDC-B451-463B-9665-0099407D337A","seStartTimeOffset":0,"title":"シーン 267","telop":"「まだ起き上がらないで、あんたは、まだ貧血状態なんだから。今日は…私がこれ食べさせるから…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第268スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"57C37755-26EB-42B9-89DE-1B2C883DE077","seStartTimeOffset":0,"title":"シーン 268","telop":"「あっ、分かった…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第269スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"8ADC7296-2408-439B-A5D9-ADE4ECA046B6","seStartTimeOffset":0,"title":"シーン 269","telop":"「ほら、食べなさい。」\n私はそう言いながら、白米をスプーンに乗せて運ぶ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第270スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"47F7F93E-E0D5-4E44-97F9-8923812448BC","seStartTimeOffset":0,"title":"シーン 270","telop":"僕は、彼女に勧められるがままに口を開けて、ご飯を食べる。「今日のご飯、おいしい…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第271スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"87B59A33-8D53-4255-8352-7435B8DA858D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 271","telop":"私は、彼のその言葉に思わず、ドキッとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第272スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"3395C651-D7FC-4D07-B61F-746F43A3455A","seStartTimeOffset":0,"title":"シーン 272","telop":"「はぁ、あんたったら、今何してるか自覚がないのかしら…」\n私は、そんな独り言をぼさっと呟く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第273スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"CD61E2AB-1315-4A92-89F4-CC9983B2FF9A","seStartTimeOffset":0,"title":"シーン 273","telop":"「えっ、今、何か言った？」\n僕は、何かを呟いた彼女に聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第274スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"B2EABA5B-ADC7-4FF8-8E5F-E2C6372C186A","seStartTimeOffset":0,"title":"シーン 274","telop":"「ほら、これも食べなさい。」\nそう言って、今度はレバニラ炒めを箸で取り、運ぶ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第275スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"0F1592C0-357C-4600-96B0-9B28622E3347","seStartTimeOffset":0,"title":"シーン 275","telop":"僕は、レバニラ炒めを食べる。\nそして、お盆にある紙パックの飲み物を取ろうとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第276スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"C4636095-A2DC-4E8C-AC4C-60742AFCEFC8","seStartTimeOffset":0,"title":"シーン 276","telop":"「喉が渇いたの？」\n私はそういいながら、彼の手をどけて、紙パックを持つ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第277スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"03E1FCB7-4E3D-4269-B942-1226EDC52685","seStartTimeOffset":0,"title":"シーン 277","telop":"私は、念のため、成分表記を確認する。そして、単なるコーヒー牛乳であることがわかると、ストローを刺して彼に手渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第278スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"FCCE6092-FA83-4F91-8DDF-8602377997F9","seStartTimeOffset":0,"title":"シーン 278","telop":"「あっ、ありがとう。」\n僕はそうぼさっと言い、コーヒー牛乳を飲む。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第279スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"BE206CA0-11BB-4C61-956C-7171F1E5D6D6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 279","telop":"「うん…、なんか変な味がする…」\n僕がそういうと、彼女は驚きの表情を見せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第280スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4EE276FC-0786-4310-AB9C-43A8B31E7156","seStartTimeOffset":0,"title":"シーン 280","telop":"「ちょっと貸しなさい…。」\n私は、彼に紙パックを渡してもらい、飲んでみる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第281スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"2E6AF129-2D41-4954-AE87-37E673B03C32","seStartTimeOffset":0,"title":"シーン 281","telop":"「単なる、ジュースよ。多分…」\n私は、何かしらの違和感を感じながらも、彼に返す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第282スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"0138A2DD-5924-4FD7-B6C9-D25E58B12791","seStartTimeOffset":0,"title":"シーン 282","telop":"僕は、渡されたコーヒー牛乳を再び飲む。\n「さっきのは、気のせいだったのかな…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第283スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"A79B22C4-2432-4AAF-9219-1170886F8C29","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 283","telop":"私はそこで、彼と間接キスをしたことに気がつく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第284スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"5FCE3738-AFAC-4C3C-AB9C-94F86B90C20E","seStartTimeOffset":0,"title":"シーン 284","telop":"「ほら、ご飯がまだ残ってるわよ。」\n私はあえて、何も言わずに、味噌汁の器をとり、運ぶ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第285スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"06659F4F-1647-43BA-86C2-A9BDF366B54B","seStartTimeOffset":0,"title":"シーン 285","telop":"僕は、操夢に渡された味噌汁を飲む。\nすると、ほんの少しだけ、ふわふわした気持ちになる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第286スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"7264509C-1470-4D48-B56A-1A768051CE48","seStartTimeOffset":0,"title":"シーン 286","telop":"私は、操夢から味噌汁の器を受け取り、お盆に乗せる。\nすると、彼の頬がほんのわずかに赤くなっていることに気づく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第287スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"2EFF3619-4D42-4BE9-AB39-F3DE96FB538B","seStartTimeOffset":0,"title":"シーン 287","telop":"「あんた、風邪なんか引いてないわよね…」\n私は念のため、彼のおでこに手を当てる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第288スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"F580D138-D254-4B71-B1DA-EB1C0A9BFE7A","seStartTimeOffset":0,"title":"シーン 288","telop":"だが、それだけでは判断できず、自らのおでこにも手を当てる。\n「熱じゃないのか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第289スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"91888750-3B6E-41F0-B646-9DBD37FEDA99","seStartTimeOffset":0,"title":"シーン 289","telop":"「とりあえず、ご飯を食べなさい。」\n私はそう言い、白米をスプーンで取り、運ぶ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第290スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"A26CDEF6-BF19-4BB4-AE6A-2FF47EA087B0","seStartTimeOffset":0,"title":"シーン 290","telop":"僕は、それから白米、ニラレバ、コーヒー牛乳、味噌汁の順番でゆっくりと食べ進める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第291スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"734E0F48-94B3-4E53-8DE8-6CEE6E57AEA4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 291","telop":"数十分後","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第292スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"0551F245-5948-4BF2-A8BE-E821CAFBAB07","seStartTimeOffset":0,"title":"シーン 292","telop":"僕が気がついた時には、すでに夕食を完食していた。\nそして、全身が何かに反応している感覚がする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第293スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"33B2AECE-23CA-48F4-9854-D7786B2523A0","seStartTimeOffset":0,"title":"シーン 293","telop":"私は、気がつけば、彼に夕食を食べさせる恥ずかしさなどの感情はとっくに消え去っていて、今は欲に駆り出されていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第294スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"9AED46B9-539A-4746-8FE7-B72552E19D69","seStartTimeOffset":0,"title":"シーン 294","telop":"「ねぇ、あんた。私とキスでもする？」\n私が気がつけばその言葉を彼に投げかけていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第295スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"9A344F1E-59D3-4E16-970D-E5B581B36147","seStartTimeOffset":0,"title":"シーン 295","telop":"僕は、彼女の言葉に口よりも身体が先に動き、気がつけば、上半身を起こし、そっと口付けをしていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第296スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"0F204028-7F94-4BCF-A4F0-9F5D764D245C","seStartTimeOffset":0,"title":"シーン 296","telop":"「んっ…」\n私は、自然と手が伸び、彼を抱き寄せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第297スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"2FB53CA2-7F75-46CD-85DF-E7D620F83A6B","seStartTimeOffset":0,"title":"シーン 297","telop":"僕は、彼女の行動に無意識に反応し、彼女に抱きつく。\nそして、深く、長い口付けをする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第298スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"FFB9286F-0D34-4ED5-B1EA-94F703256237","seStartTimeOffset":0,"title":"シーン 298","telop":"「満足した？私からの最高のデザートは。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第299スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"35D89D54-B091-4E8A-BA57-47BF0ACBDCDA","seStartTimeOffset":0,"title":"シーン 299","telop":"「最後まで美味しく食べきれたよ、ごちそうさま。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第300スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"78D1B615-4BAE-46AC-B3AF-E63EE671484C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","seStartTimeOffset":0,"title":"シーン 300","telop":"「そう、私も楽しかったわ。ありがとう、操夢。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第301スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"BD8E6D17-0938-441D-8D63-4B28204EFC20","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","seStartTimeOffset":0,"title":"シーン 301","telop":"僕は彼女の笑みに、驚き、一瞬、フランの笑顔が頭に浮かんだ気がするのは気のせいだということにした。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第302スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E732EAA0-9719-427D-9653-C3B62436FEB4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 302","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第303スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"0F1C57E5-AA4A-41E5-9001-161AC786FF61","seStartTimeOffset":0,"title":"シーン 303","telop":"私は、目が覚めると、彼のベッドの近くの地面に寝そべっていた。そして、記憶の一部が欠けていることに気がつく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第304スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"185C6EBF-6B38-442C-ADCE-8B4F772FD799","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 304","telop":"そんな中、魔理沙が窓からやってきて、「神社に行かなくていいのか？」と聞いてくる。そこで私は思い出し、彼女の箒に乗る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第305スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"D854C29D-F6B5-4CF8-B7E0-2E925735D3FF","seStartTimeOffset":0,"title":"シーン 305","telop":"僕は、目が覚めると、昨日より断然元気になっている、自分自身に驚く。そして朝ごはんを食べたくなり、院内売店へ行くと…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"555F20B7-692A-4383-9077-3DBC3568109E","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"954C09D4-D330-499C-86C0-CC98D5600BB1","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第308スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"71A7C051-E285-424C-A27E-0CF81510D864","seStartTimeOffset":0,"title":"シーン 308","telop":"僕は、ふと目が覚めると、そこは病室だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第309スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"3B8CF5B4-C17E-44A5-96ED-290E6016C0AF","seStartTimeOffset":0,"title":"シーン 309","telop":"ふと、隣を見ると霊夢が、寝ていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第310スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"B400BE73-A380-493A-AA48-EB639ADD35F7","seStartTimeOffset":0,"title":"シーン 310","telop":"「あれ、なんで僕は霊夢さんと同じベットに…？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第311スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"CBBA5119-CCF4-4934-A2ED-5AF16C872DAE","seStartTimeOffset":0,"title":"シーン 311","telop":"すると、霊夢があくびをする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第312スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"884A70B0-C6B7-4058-A378-47270256FE96","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 312","telop":"私は、ふと目の前に彼の顔を捉えると、思わず、ベッドから飛び降りる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第313スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"3F8C8563-344E-4BAA-8280-0872F6B76115","seStartTimeOffset":0,"title":"シーン 313","telop":"「僕は…確か、夕食を霊夢さんに食べさせてもらって…、それを食べ切った頃からの記憶が…思い出せない…です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第314スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"CDC03B1F-DF56-46D0-8DFE-3233E73141E0","seStartTimeOffset":0,"title":"シーン 314","telop":"「あんたね…、それが一晩同じベッドで寝た異性に向けていう言葉なの…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第315スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"267B3A92-B86B-412A-9D8D-35D1A9F012F0","seStartTimeOffset":0,"title":"シーン 315","telop":"私はそう言いながら、昨晩の記憶を思い出そうとするが、彼と同じで夕食を彼が完食してからの記憶が欠けている。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第316スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"AC77A94B-BBB2-4154-B1D2-9B5C886429B4","seStartTimeOffset":0,"title":"シーン 316","telop":"「はぁ、まあ良いわ。それより…あんたの体調は回復したの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第317スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"67F2CF1E-2A69-42B6-A7ED-7F719CDA3096","seStartTimeOffset":0,"title":"シーン 317","telop":"「はい…、昨日よりだいぶ良くなりました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第318スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"AE39280F-579A-4C36-A033-7590733E0DF2","seStartTimeOffset":0,"title":"シーン 318","telop":"すると、窓をノックする音が聞こえ、僕は窓を開ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第319スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"C497D3BA-9811-437E-9062-E08C485F2D8B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 319","telop":"「よっ、操夢。元気なのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第320スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"76C2165D-9C92-402B-894A-156179D5E815","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 320","telop":"「えぇ、一晩寝たら体調が良くなりました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第321スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"89B19A77-F698-4EB2-BA9D-CFBDAFBF6010","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 321","telop":"「そうか、それより、霊夢は神社に行かなくて大丈夫なのか？今、7時半だぞ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第322スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"DAD451AD-8C87-452A-B300-BF5B3864E7C7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 322","telop":"私は、魔理沙にそう言われて、思い出す。\n「早く行かないと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第323スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"0359A0B5-2DD4-42F0-A268-57458831599A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"title":"シーン 323","telop":"「それなら、箒に乗ってくか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第324スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"EBDD363E-1DA4-4764-879D-4C135ABDB1C4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 324","telop":"「ええ、お願いするわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第325スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"A3774CE5-F4AE-4E81-96A1-41E431243DF9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 325","telop":"「それじゃ、急いでくぞ、操夢、またな。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第326スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"54FE06D7-23FA-4E45-99C0-35D097B5EF98","seStartTimeOffset":0,"title":"シーン 326","telop":"僕は、彼女に相槌を返すと、二人は窓を開けて空へと飛び立っていった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第327スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"9AD6D1DB-8C0C-4544-9920-6B0BF4B472BE","seStartTimeOffset":0,"title":"シーン 327","telop":"僕は、そして、ベッドから降りると、お腹が鳴り、朝食を買いに、院内売店へと向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第328スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"9D7D1CCB-E935-4D56-9C61-739A52606695","seStartTimeOffset":0,"title":"シーン 328","telop":"僕は、院内売店の中に入ると、誰かに声をかけられる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第329スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"2C5C5FA3-8745-44BD-9D9C-FB0A236A93EE","seStartTimeOffset":0,"title":"シーン 329","telop":"「あの、何を買うつもりなのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第330スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"6D72454E-BB51-4267-A286-C40EC6C18852","seStartTimeOffset":0,"title":"シーン 330","telop":"「朝食です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第331スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"2C9A99D1-ED95-46CA-82EC-61A3C4682F52","seStartTimeOffset":0,"title":"シーン 331","telop":"「朝食なら既にありますよ、私についてきてください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第332スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"3157E7FB-9842-4882-9E2F-D55347BAA8F0","seStartTimeOffset":0,"title":"シーン 332","telop":"「分かりました…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第333スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"DBF69FD0-C6E7-4EC6-AC37-6AE04520255A","seStartTimeOffset":0,"title":"シーン 333","telop":"「これ、今日の朝食です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第334スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"BD2B13E1-DDE6-4E81-A70A-C38F97350133","seStartTimeOffset":0,"title":"シーン 334","telop":"「ありがとうございます。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第335スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"FC5A9DC1-072C-4FA7-ABE5-03DC04C1BED0","seStartTimeOffset":0,"title":"シーン 335","telop":"「後でワゴンをあなたの病室のドア付近に置いておくので、食べ終えた食器と今後の食事はそこから受け取ってください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第336スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"Ync416361_シンプル背景_ビルや病院の売店_(コンビニ)1920x1080.png","id":"FD3FF861-4EA3-4DB1-BA02-5AE87189193F","seStartTimeOffset":0,"title":"シーン 336","telop":"「分かりました。」\n僕は、そういい、軽くお辞儀をしてから病室に戻った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第337スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"7206E492-B95A-42BB-93DF-7E0D5E6F9ADC","seStartTimeOffset":0,"title":"シーン 337","telop":"僕は、渡された朝食を食べる。内容は、卵と白米と醤油と、ミネラルウォーターだった。僕は10分ほどで平らげる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第338スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BC8F9AC1-05AC-4FFC-8F9E-B3008C92DFB3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 338","telop":"僕が、病室のドアを開けると、確かにワゴンがあり、そこに食器を置くと、歯ブラシとコップが目に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第339スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EC518147-0F43-4EEB-B955-9F8A19FC3FE7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 339","telop":"その横にメモがあり、「近くの洗面所で歯をしっかりと磨いてください。」と書いてあった。よく見ると歯磨き粉もある。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第340スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"116C127E-C012-4B8B-817C-3C166C075E2D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 340","telop":"僕は、あたりを見まわし、洗面所を見つけると、歯ブラシと歯磨き粉を空のコップに入れて、そこに向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第341スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"696283BF-0C44-4356-8BB6-CB21F344A541","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 341","telop":"僕が、洗面所から戻ると、既にワゴンはなく、手にコップを持ったまま、病室に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第342スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"A930268D-97EB-465D-830D-51DB60EF13B6","seStartTimeOffset":0,"title":"シーン 342","telop":"僕は病室に入ると、適当なところにコップを置き、ベッドを見る。すると、その下に何かがあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第343スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"4CFA12B7-7DDF-4D2C-84DE-82EC6A430839","seStartTimeOffset":0,"title":"シーン 343","telop":"「これは…加湿器？」僕は手に持ったその機械に疑問を抱く。そして、裏を見ると、日中時間帯使用厳禁の文字もあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第344スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"36D4E1E3-6827-4D13-ADB8-E84513A844B7","seStartTimeOffset":0,"title":"シーン 344","telop":"よく見ると、パネルがついていて、日の入で動き出し、日の出で止まるようにセットしてあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第345スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"67F7483C-9ADF-4D2F-9A3F-C05F064F8763","seStartTimeOffset":0,"title":"シーン 345","telop":"「まぁ、いっか。」\n僕はそう呟くと、加湿器を元に戻す。すると受話器がなる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第346スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"343E1F40-8117-4974-A9F4-509D38864243","seStartTimeOffset":0,"title":"シーン 346","telop":"「もしもし。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第347スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"64A02A28-14B0-40A0-B377-60CD210EC72C","seStartTimeOffset":0,"title":"シーン 347","telop":"「操夢さんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第348スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"C9766A4C-EDD8-4DA0-BD6A-870796EBE1C6","seStartTimeOffset":0,"title":"シーン 348","telop":"「はい、そうですけど…？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第349スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"277A6729-46C9-49B8-AACA-ECD81C6B6293","seStartTimeOffset":0,"title":"シーン 349","telop":"「今、病室の廊下にあなたの担当医師が待機していますので、廊下に出ていただけませんか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第350スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"DADEB604-73CD-439B-B06B-E1F86EAB509E","seStartTimeOffset":0,"title":"シーン 350","telop":"「はい、分かりました。」\n僕はそういうと、受話器を戻し、病室のドアを開ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第351スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D00C7AF0-ACFE-4904-B883-8EAEA29040E9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 351","telop":"僕が廊下に出ると、そこには見知らぬ女性が立っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第352スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7F553EC2-3A79-416C-9309-D1E2B93EED78","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 352","telop":"「こんにちは、幻武操夢さん。私は、八意永琳と申します。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第353スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"25D55461-09DE-4709-A89F-10CA859B0DB7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 353","telop":"「こんにちは。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第354スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"071ABF5E-DD64-4B38-A7F8-1112AAEE8E48","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 354","telop":"「これから診察室に行きますけど、何か言いたいことはありますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第355スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AC833AF0-C5E9-40E9-959D-B1F41B37746F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 355","telop":"「いえ、特に。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第356スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3BF247E9-F48F-4A63-ACF0-CF3C9CEA2590","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 356","telop":"「分かりました。では向かいましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第357スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"38BD5154-BCC3-4C31-96E4-871ECD07F485","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 357","telop":"僕は、彼女と共に診察室に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第358スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E29B0A66-382A-41F6-B3F1-50D87C5EF2C4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 358","telop":"僕たちが診察室に入ると、彼女が話し出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第359スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6DFE2B93-F44E-408C-A73D-6DA3ABADD8A8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 359","telop":"「昨日と比べて、体調は良くなりましたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第360スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D070BAA7-8DA6-4657-A716-E057784ADBB6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 360","telop":"「はい、だいぶ良くなりました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第361スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D19EF38E-BE80-4FFA-8F1D-3A108B090744","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 361","telop":"「そうですか、今朝の朝食は食べれましたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第362スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0BBB23B4-D3D1-4336-A3B0-C1CE62985376","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 362","telop":"「食べられました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第363スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4932E004-5E2F-4A62-A085-6161D878334F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 363","telop":"「そうですか、それは良かったですね。」\n私はそう言いながら、PCのある画面を見せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第364スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"288D8BC4-BBF9-4E3E-B247-0424A4B2B01C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 364","telop":"「これは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第365スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DD85A411-D8B4-4326-80A0-F39863773D27","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 365","telop":"「あなたが住んでる市から届いた、あなたの情報です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第366スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A08C6758-8AC9-47CF-BA17-25644F7FB931","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 366","telop":"僕は、そこにある内容をじっと見る。そこには、僕の生まれてから今までのほぼ全ての記録が載っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第367スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"786E2EFB-E953-41DC-897C-07AA9C223979","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 367","telop":"「ところで、あなたは、なぜ包括的婚約の利用をしているのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第368スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6CD8A5B4-5679-4C09-A1D4-F1B60AB42B43","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 368","telop":"「僕は、そこにあるように、訳ありで、就活に苦しんで、とても良い社会人生活とはいえなかったからです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第369スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6B6803C1-106D-4402-9027-1D936377652A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 369","telop":"「そうですか、それで、大学進学をしなかった理由は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第370スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D9E5ABE5-69BB-465D-A18E-5C30CD3ACE7D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 370","telop":"「借金して人生苦しむのは嫌だったからです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第371スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D869BE74-5AB2-48B5-A9F9-E175115A06E4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 371","telop":"「確かに、あなたのいうとおりですね。それで親御さんはこの制度に登録する際に何かおっしゃってましたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第372スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E2FEFE55-7C58-4B54-B640-83F180A026A5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 372","telop":"「そうですね…、僕が役所で申し込んだことを言った記憶はありますが、正直両親の反応は覚えてないです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第373スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4A573785-264B-4393-811D-32AD045B961B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 373","telop":"「そうですね。確かに、この記録の通りなら、あなたと親御さんの関係は最悪ですもんね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第374スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AD01AF9D-1BBE-4D21-BE99-1CCBF462B18D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 374","telop":"「そうです。だけど、僕はこの暮らしを始めて、以前とは異なる居心地の良い空間で満足しています。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第375スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3E2815D8-F595-4305-9128-84E56B48A7F4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 375","telop":"「そうですか…」\n私は、彼の発言とデータを参照しながら、ある画像を見せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第376スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"54A3BCED-DA10-4B51-B60B-E18207A14852","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 376","telop":"「突然ですか、この方はご存知ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第377スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"80F199F8-E6C4-4D45-A77E-8FA2B428F3CD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 377","telop":"「八雲総理大臣ですか、知ってますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第378スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"08EF5654-7BDF-488D-9DA4-259EFC21E509","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 378","telop":"「そうですか、実は…」\n私はそう言いながら、声のボリュームを下げて話す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第379スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A22D6A4C-378C-4B01-8072-EA50038B92EC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 379","telop":"「それは、本当ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第380スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DC945956-EC54-4579-8259-F3D0DF507579","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 380","telop":"「ええ、もちろん。私が彼女とは旧知の仲でしてね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第381スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EE29B06E-2CA8-4FB2-8F4C-870DC792019D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 381","telop":"「旧知の仲？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第382スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B7FA5150-F1A0-4C41-978A-2B582ABACB72","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 382","telop":"「ええ、少し余談にはなりますが、かつて彼女はこことは異なる場所のトップリーダーでしてね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第383スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C59E74A3-7751-4B5E-AD11-525D906C0612","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 383","telop":"「おっと、話が脱線してしまうところでした。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第384スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0208483C-71C5-46C2-8B71-A50AB0B3A196","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 384","telop":"「ところで、あなたは、これからどうする予定ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第385スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"21D750FE-8F1E-4F23-B621-6440A25B5C81","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 385","telop":"「僕は、病室で日向ぼっこでもしてようかな…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第386スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"27DA4876-E155-474A-AC78-8E213FBAB28E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 386","telop":"すると、固定電話から着信音がなる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第387スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E3FBE3D9-2BCF-49C0-B137-9B5587BB8931","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 387","telop":"「はい、こちら八意永琳です。どうしましたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第388スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1DCCF7DB-851D-4DC3-9B4E-901431436C3A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 388","telop":"すると、彼女は笑みを浮かべる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第389スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"51B17D07-BCF1-4A1C-9686-E5B053720E3F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 389","telop":"「はい、分かりました。では、その場で待つように言ってください…はい、失礼します。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第390スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"036F338A-BC4F-4D1D-9BDF-409C8BD2B0FD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 390","telop":"「どうやら、病院の入り口にあなたの友達のこいしさんがきているようですよ。どうします、外に出たいですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第391スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E48819F6-6627-4271-B888-F241AE7AF4E9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 391","telop":"僕は、ふとその場でしばらく黙考し、彼女にいう。\n「外に出たいです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第392スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"710AC5AD-7F36-4EA7-AE98-ACBA7F54D4E8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 392","telop":"「分かりました、では外出許可を出すので、日が沈むまでには病院に戻ってくださいね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第393スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"836263F1-01E7-4DD8-A532-12716C21438A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 393","telop":"「分かりました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第394スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EE2350B0-EC67-4737-9930-409761639C29","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 394","telop":"「では、一緒に病室に戻って、身支度を整えましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第395スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"314740BA-A526-4D11-8D14-29D34CD1AD4A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 395","telop":"「はい、今日はありがとうございました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第396スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"40A242F8-E9DB-41A1-B815-C8831B7A92A5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 396","telop":"「ええ、どういたしまして。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第397スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"566F6BB2-D97F-4514-B713-2F4D7B59AE7A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 397","telop":"そして、僕たちは病室に戻った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第398スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"456BFBB8-84AF-4BDE-805D-5C8640040B5B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 398","telop":"私は、病院の受付で彼がくるのを待っていると、彼の姿を捉える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第399スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5BA0A03D-EAEF-4EFC-ABB6-80EEDC9D174A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 399","telop":"「待ってたよ、操夢。それで、体調は大丈夫？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第400スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1E0AF87E-5FF8-4FF3-B360-E60048F77A55","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 400","telop":"「うん、大丈夫。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第401スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C65741DA-E55C-4E36-B0D7-D9B8EA84A651","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 401","telop":"「じゃあ、いこっか。」\n私はそういうと、病院の外に出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第402スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D8C30715-23D9-4E5C-BBD1-1A0CF067D5D8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 402","telop":"僕たちが病院の外を出るとレンタカーナンバーの車が１台止まっていた。その車にこいしと共に乗る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第403スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"205ECBC0-73B5-4F79-98FE-76B4A01C0321","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 403","telop":"私は、普通に車に乗ってきた彼に驚く。\n「今日、退院したのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第404スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7B888F4C-11C3-4B1F-B066-32D14A74AB31","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 404","telop":"「いや、永琳さんに外出の許可をもらいました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第405スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B8D56D83-6D65-4E1D-818D-615DD9384633","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 405","telop":"「そうですか、それじゃあ、早速出発しましょう。」\n私はそういうと、車を発進させる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第406スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"116C39DA-F397-4D5E-93B4-AC2622C9093D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 406","telop":"「ところで、これから、どこに行くの？」\n僕は、こいしに尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第407スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"16D1E53E-DB18-4EF3-8AA8-BC97953CAB7B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 407","telop":"「それは、向こうに着くまでのお楽しみ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第408スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E54CFC85-2999-4858-9C16-4660522C3B2A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 408","telop":"「そうか…。」僕は、そういうと、車窓を眺める。\nさとりさんが運転する車は路地を抜けるように走る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第409スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"95972DE0-CD66-4031-9329-CD68A01D6239","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 409","telop":"それからしばらくたち…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第410スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8C7E28BC-70B3-4990-99C1-C402428F6F16","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 410","telop":"僕たちが、車に揺られて、たどり着いたのは戸田と川口の境目あたりにある小規模ショッピングモールだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第411スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D614E481-84B5-40B4-905E-FF4AC38BD607","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 411","telop":"そして、僕は古明地姉妹と共に、モール内をぶらぶらとするのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第412スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DAAE1456-2411-436F-AEEA-2EBF33E800A2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 412","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第413スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9E42A9AF-8130-4F30-B27E-13BA392DD5B5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 413","telop":"僕は、さとりとこいしがゲームセンターに行こうと言う。\n僕は、二人の提案にのり、一緒に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第414スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7A1AC9CC-917A-4317-BF59-83BFEDF69C9F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 414","telop":"僕たちは、ゲームセンターに入ると、二人がやりたいと言った、ゲームで一緒に遊ぶ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第415スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C3038463-0F9D-4029-AA91-B1CBCF292DEC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 415","telop":"気がつけば、ゲームセンターで数時間を潰していて、昼食を取ることになり、フードコートへと向かうと…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"CA1DDF04-62AA-4FC7-B9C4-D3BDDBBA2B13","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"D25218C1-7108-497F-BBDE-027D9F63948A","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第418スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F9C5C6DF-6E07-495A-88B8-1E7A8769E619","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 418","telop":"僕とさとりとこいしの3人は、川口と戸田の境目にあるショッピングモールに来ていた。僕は目の前にいるこいしに聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第419スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AC2ACC89-3487-4BBC-ADD3-0D8F6BA1189D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 419","telop":"「これから、何をするのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第420スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1E8B85E6-0068-434E-9B9A-EA52E2CF91C1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 420","telop":"「ゲームセンターによるの。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第421スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"19F320F7-8546-46CD-91EF-24A29F6471BD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 421","telop":"「それじゃ、一緒に行こう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第422スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7B58E801-997E-4DB3-9379-F6AFAECC280A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 422","telop":"僕とさとりは、先に進むこいしの後を追いながら歩く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第423スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"26D233BF-2A00-45A0-9229-7138F568D98C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 423","telop":"僕たちがゲームセンターの中に入ると、二人は、エアホッケー台にそばに立ち、パドルを僕に渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第424スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"バウンス","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E1AAAD8B-93EF-4D71-AF4B-A150FC174F7B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 424","telop":"「はい、これパドル。このゲームで私とさとりにあなたが勝ったら…、欲しいものを一つ買ってあげる。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第425スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6DE15572-90D3-499B-8E66-AF946D661275","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 425","telop":"「分かった。じゃあ、始める？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第426スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3E51EEC5-A741-45D5-925A-2C5213373CF9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 426","telop":"「うん、じゃあ、始めよう。」\n私はそういうと、財布を取り出し、小銭を機械に入れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第427スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"55D41442-536B-4AAD-8E0D-5159BDC674DD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 427","telop":"僕は、こいしが打ってきた球を返し、さとりが打ち返し、僕が打ち返し、こいしが打ち返しという順で打ち合いをする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第428スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7382E761-A2F2-43F8-8B05-A230491CEBEB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 428","telop":"しばらくすると、こいしが球を打ち損じ、奥のゴールにインする。彼女は、それを取り出すと、再び打ち始める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第429スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DEA6B84A-4ED9-4D8D-829D-4D3275875C90","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 429","telop":"そんなこんなで、数分くらい経つと機械から音が鳴り、ゲームが終了する。結果は…僕の負けだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第430スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"331B3F8B-00BE-4A05-B13F-D813E8EEF5F5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 430","telop":"「次は何するの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第431スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F085F9CC-025B-4759-94DD-065D2C1C581A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 431","telop":"「じゃあ、そこにあるレーシングゲームをしよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第432スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5D106EDB-59D6-454A-9808-E04558AAAF03","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 432","telop":"「うん、分かった。」\n僕たちはそれから、ゲームセンターの中で数時間を過ごした。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第433スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A5C00B1A-94FD-4136-AB2E-273BAEC2B547","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 433","telop":"「そろそろ、お昼の時間にしますか？」\n私は、彼に尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第434スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8247FA7D-51DD-4A59-AF5F-1895505121E6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 434","telop":"「ええ、そうしましょう。」\n僕がそう返すと、僕たちはゲームセンターの外に出た。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第435スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D9D0EF8D-280D-44B9-8650-5A915139E880","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 435","telop":"僕たちがゲームセンターを出ると、フードコートに来ていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第436スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A93557B4-52EF-4FB9-9D0E-EF88A304124E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 436","telop":"僕は、フードコートを見まわし、どのお店で購入するかを考える。すると、ラーメンの店の隣に誰かが立っているのがわかる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第437スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B6B7A7A1-5D93-4891-9860-A6A0D0B4D63A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 437","telop":"僕は、その人が気になり声をかける。\n「こんにちは。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第438スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"222E1F92-9B95-4B1F-9B2F-711E3AD78EFE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 438","telop":"「こんにちは、いなり寿司はいかがですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第439スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3D9D440F-5EC3-4BEB-ABB6-9B530DED25B5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 439","telop":"「いなり寿司ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第440スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9C622F0A-E442-4EAA-A457-9F9E9A013210","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 440","telop":"「ええ、3個セット120円です。いくつかいます？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第441スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"71DDF197-21D0-4C0C-9EF6-AA32CD312DB0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 441","telop":"僕は、先ほどさとりに渡された小銭入れを確認する。そこには、500,100,50,10,5,1円玉がそれぞれ20個ほど入っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第442スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8EBC0049-D820-4FDD-9F2B-6FAD3B41B10A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 442","telop":"「5セット分とレジ袋をください。」\n僕はそう言いながら、500円玉100円玉を1枚ずつ渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第443スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C0DF61B1-C9B2-4A83-9E0C-CB1016B39799","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 443","telop":"「こちらいなり寿司5セット15個分です。お買い上げありがとうございます。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第444スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"183068F5-AA6C-4469-BDEA-28C219B07E30","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 444","telop":"私は、彼が席に戻るのを見送ると、小銭をそのまま小さなビニール袋に入れて、固定電話で例の人物にかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第445スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"673B290E-E0E0-444B-AD35-47685D58CE8C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 445","telop":"「もしもし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第446スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6996084E-7511-4B4A-BF58-654B49197612","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 446","telop":"「藍、例の食品を彼に売ったの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第447スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"79832176-75A3-4CA3-858C-D48C9B346027","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 447","telop":"「ええ、もちろん。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第448スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"93EBFA86-E817-4A08-B48D-F06215E7D120","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 448","telop":"「彼から渡された小銭は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第449スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0A7ABEAA-5C1C-4964-8F1D-0C3E1CD29E66","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 449","telop":"「私の指紋がつかないようにビニール袋に入れてあります。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第450スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1D2FCF1F-F550-4740-A731-BC81AE10AB74","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 450","telop":"「そう、それじゃ、店を畳んで今すぐ、私に成果物を見せてちょうだい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第451スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6FCA62F7-42D5-44FF-869D-074C75F19130","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 451","telop":"「承知しました。」\n私はそういうと、電話を切り、閉店準備を始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第452スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D84EEEB2-9427-46B3-8CE9-2CC5EE26A242","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 452","telop":"僕が、席に戻るとこいしは、ハンバーガーをさとりはタコスを食べていた。「これ、どうぞ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第453スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4AE8F5A9-E586-4990-886F-4A58A3F0A1D9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 453","telop":"僕はそういうと、5セットあるうちの1セットを二人に渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第454スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"53996386-61D1-44F1-923D-0DAF60A35FB9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 454","telop":"「ありがとう、操夢。」\n私は渡されたいなり寿司のパックを見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第455スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1A1E1D42-016B-4DE0-956D-9F510EF5415B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 455","telop":"「ねぇ、お姉ちゃん、これどっちが2個食べるか、じゃんけんしよう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第456スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3A0BAFCF-11DC-46E8-A1D1-8DAAF7748F53","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 456","telop":"「じゃあ、そうしましょう。」\n私とこいしはそう言い、じゃんけんをする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第457スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DB42B30B-9E5E-4D2E-B009-D90E3E21C976","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 457","telop":"「よし、私の勝ちね。じゃあ、いただきます。」\n私はそう言いながら、いなり寿司を口に入れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第458スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D2244125-3057-4C34-9079-50F2B5CAF676","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 458","telop":"私はいなり寿司を食べると、味に違和感を感じ、二人を見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第459スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7A3F2BF9-F8D9-4733-9923-DB7C2ECFDCFD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 459","telop":"僕は、いなり寿司を食べると違和感を感じ、二人も困った表情を浮かべる中、まだ未開封のセットをどうしようか考えた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第460スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DC0D33BE-2550-4DA0-BD56-217DFD31723A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 460","telop":"僕はふと、先ほどの人が立っていたところを見るが、すでにいなくなっていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第461スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DF2FAD26-3AFA-4CF1-99F0-89D83C85E5DB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 461","telop":"「気分転換にモールの中を歩きませんか？」\n僕は、そう二人に提案する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第462スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7D701C44-1B8A-401C-81F4-F9B30DFE426C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 462","telop":"「ええ、そうしましょう。」\n私はそういうと、こいしに声をかけてから席を立つのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第463スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B48A8FE1-5678-496C-8133-47BD8A1135CE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 463","telop":"僕たちは、ショッピングモールの中を歩きながら、周りのお店をチラチラ見る。するとそこに、独特な感じのお店を見つける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第464スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"77587A78-16E9-46A7-AEE9-4F1DEE821A39","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 464","telop":"私たちは、突如としててくてく先に進み出した、彼に驚きながら、小走りでついていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第465スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"AACA810A-D2D3-428B-94D6-24B9187727A5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 465","telop":"私たちは、少しため息をつきながら、ソファに腰掛ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第466スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"1467995E-7E6A-443E-AE14-4E681C578454","seStartTimeOffset":0,"title":"シーン 466","telop":"「いらっしゃいませ〜、河童の技術屋に何のご用ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第467スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"BF2D46A1-93DF-4447-8775-79500A3B3DED","seStartTimeOffset":0,"title":"シーン 467","telop":"「なんか気になったので…、なんとなく入りました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第468スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"BCD47665-3E07-4F64-B658-265B2CE6DD16","seStartTimeOffset":0,"title":"シーン 468","telop":"「そうですか…、では、最近出た製品をご紹介しましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第469スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"9ED177DC-1E8E-40E9-BA31-7388018BEC23","seStartTimeOffset":0,"title":"シーン 469","telop":"すると、彼女は背負っているバッグから何か取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第470スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"D47EF461-0E38-4831-87B6-ACDF878D0F67","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 470","telop":"「これは、なんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第471スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"04F3ECB9-23B4-4A7F-88BA-DB5BBAAB9615","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 471","telop":"「これは、数十年前に製品化されて、当時の人々の連絡手段の一つになった、ポケベルというものを改造したものです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第472スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"EE129F04-B8CD-40A6-B766-32C769DCC1B9","seStartTimeOffset":0,"title":"シーン 472","telop":"「ポケベルですか…」\n僕はどこかでそんな言葉を聞いた気がするが、思い出せない。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第473スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"36B35410-71B9-42B1-ACF4-97937C4FA7F5","seStartTimeOffset":0,"title":"シーン 473","telop":"「とりあえず、触ってみますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第474スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"D0BB3E03-FD6F-4C02-A359-C93F60885B14","seStartTimeOffset":0,"title":"シーン 474","telop":"「じゃあ、触ってみようかな…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第475スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"F2BE8445-2082-4707-BC51-C64B32AD0544","seStartTimeOffset":0,"title":"シーン 475","telop":"「では、これ持って少し待っててください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第476スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"C606AF9B-4289-4266-9D6B-047C3E17138E","seStartTimeOffset":0,"title":"シーン 476","telop":"「分かりました…」\n僕がそういうと、彼女は奥の方へと向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第477スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"ECE50EE6-72CE-42A0-B5D6-D25693F4254C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 477","telop":"すると、機械から聞いたことのない音楽が聞こえる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第478スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"997C31A4-B939-4065-AD6C-8FE256341150","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 478","telop":"僕は、なんとなく、オレンジ色のボタンを押す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第479スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"BDD7EDD5-38C9-4E49-BC60-3C37D8AAF660","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 479","telop":"「もしもし、私の声が聞こえますか？もし聞こえたら、黄色いボタンを押してみてください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第480スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"40B600AA-AF33-49AD-80A3-6B6EBD9D20ED","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 480","telop":"僕は、電話口の彼女のいう通りに、黄色いボタンを押す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第481スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"27A3F2E7-31EA-4D92-AB96-FB292292B61B","seStartTimeOffset":0,"title":"シーン 481","telop":"すると、「通話が終了しました。」という文字が表示された後に、元の文字が表示される。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第482スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"2497FF9A-390C-4024-A5D4-004841E9575C","seStartTimeOffset":0,"title":"シーン 482","telop":"「どうですか、これ、便利でしょ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第483スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"A589CE27-3A73-497A-8EC4-83F929B59221","seStartTimeOffset":0,"title":"シーン 483","telop":"「確かに、便利ですね…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第484スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"F499F7EB-DF9B-4A16-8CE6-BE0CEC604CB7","seStartTimeOffset":0,"title":"シーン 484","telop":"「どうしますか、他の機能もご紹介できますけど、今すぐ購入しますか、もし今すぐご購入してくれたら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第485スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"DE81598F-3984-4BFC-8C4E-A9EEA2FA0DA2","seStartTimeOffset":0,"title":"シーン 485","telop":"彼女がそういうと、再び奥に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第486スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"103C1538-EA11-442F-9204-7F63B3C54A9C","seStartTimeOffset":0,"title":"シーン 486","telop":"「このケースとポッキーを一緒にプレゼントしますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第487スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"5C1C5A33-B8C4-43B6-BD5A-89EB40FDD29F","seStartTimeOffset":0,"title":"シーン 487","telop":"僕は、ふと小銭入れの中身を確認する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第488スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"77AA9FBC-DEEF-4090-A216-F60AC3058371","seStartTimeOffset":0,"title":"シーン 488","telop":"「もし、今、手持ち無沙汰でしたら、請求書をあなたのお家にお届けしますので、今すぐお金を出さなくても、大丈夫ですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第489スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"0BEBF791-2331-48D1-8BE8-5DDB25870A5F","seStartTimeOffset":0,"title":"シーン 489","telop":"「いくら必要ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第490スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"30A63851-E440-4CCD-A1CC-00E3E1291930","seStartTimeOffset":0,"title":"シーン 490","telop":"「必要なのはポケベルの端末代金で、電話料金はキャンペーンでタダですから、一括支払いの場合だと3万円ですね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第491スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"86F8B741-FE59-4055-BF0B-F3898A9C7FBC","seStartTimeOffset":0,"title":"シーン 491","telop":"「キャンペーンはいつまでやってるんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第492スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"58FC8DC7-AD54-412D-8704-9B7145B8941D","seStartTimeOffset":0,"title":"シーン 492","telop":"「ちょっとお待ちくださいね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第493スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"4CD7B5D2-3702-4CBB-98C2-92D9A08F0C37","seStartTimeOffset":0,"title":"シーン 493","telop":"すると、彼女は再び奥の方に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第494スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"37BDAA04-56C5-4D15-B9CA-24D5C85D2037","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 494","telop":"私はバッグヤードに戻ると、ある人物に電話をかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第495スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BDE4276C-CCA7-4AA8-AF10-501F4A81946D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 495","telop":"「どうしたの、にとり？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第496スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FE99E35D-936A-48C4-B49C-9548B2B2A21A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 496","telop":"「今、新規のお客さんが入ってきて、例のキャンペーンの実施期間について聞いてきたから、最新の情報を教えてほしくて。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第497スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4E57B66C-8220-4C69-863E-E6BB97079FAB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 497","telop":"「そう、ちょっと待ってて。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第498スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EB4D6871-391C-4535-94A9-E86C737787B5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 498","telop":"すると、数分の間、保留音がなる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第499スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"42317C76-4B0E-4B23-A7A0-8EA1CA085684","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 499","telop":"「もしもし、にとり、聞こえますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第500スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0CC8FFC2-32E6-4394-AF8C-F547F8F0BFE6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 500","telop":"「ええ、聞こえますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第501スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"61EAC131-D393-459B-8EEC-E9E37556799A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 501","telop":"「にとりが言う新規顧客ってどんな人なの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第502スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6B04C69B-48F5-483E-8CE7-9699A015E8BC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 502","telop":"「ちょっと待ってください。」\n私はそう言うと、デスクにあるPCを開き、店内モニターを見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第503スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"ADB2ECEF-4A01-4F84-9F11-5FFF5D6C2A8D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 503","telop":"「さとりとこいしと男性が一人で、男性が私と会話した人。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第504スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"14862D15-524D-4978-A90E-9866FEBA2FC8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 504","telop":"「そう、じゃあ、紫様に確かめてみますね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第505スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"40C5B865-7B60-4C32-966D-341721376C4F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 505","telop":"すると、再び数分程度、保留音がなる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第506スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5067FC29-B7B3-418A-BB3B-96B978A7BA72","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 506","telop":"「にとり、聞こえる？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第507スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7230BEAD-3DB6-40D8-9125-FDA10DE0AA75","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 507","telop":"「ええ、聞こえますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第508スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DC3B6C3E-235B-41CF-A569-CFDF54643634","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 508","telop":"「今、あなたが言ってた新規顧客は、私がターゲットにしている人物が含まれているから…無期限だと言っておいて。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第509スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"707A4038-112E-4B72-97C4-2667B4842E6E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 509","telop":"「ええ、承知しました。ではまた何かあったら連絡しますね。」\n私はそう言い相手が言葉を返すと電話を切り、彼の所へと戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第510スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"0056CBDF-369B-43A1-94A9-C90C4D286863","seStartTimeOffset":0,"title":"シーン 510","telop":"「お待たせしました。キャンペーンの期間は、特にこれっといった終了時期はなく、無期限です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第511スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"283EA967-B122-48D3-8B34-67647340AC89","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","seStartTimeOffset":0,"title":"シーン 511","telop":"「それは、本当ですか？」\n私は、彼女に問いかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第512スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"F141D1AF-0AE0-49AC-883E-E72EB4780F58","seStartTimeOffset":0,"title":"シーン 512","telop":"「ええ、それで、どうしますか、とりあえず、持って帰るだけ持って帰りますか…？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第513スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"C45D0897-5557-4EA5-BA91-1BEA5621485C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","seStartTimeOffset":0,"title":"シーン 513","telop":"「ちょっと待っててもらえますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第514スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"2AED2B1A-1203-46B9-BE00-76F34BAE8A81","seStartTimeOffset":0,"title":"シーン 514","telop":"「もし、購入するか決められないのであれば、数週間であれば試用期間を設けることもできますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第515スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"037811EC-5C4D-4334-8708-02DF96D00FDA","seStartTimeOffset":0,"title":"シーン 515","telop":"「もし、今すぐ、これをお持ち帰りする場合は、もう一つおまけで、こちらをお渡ししますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第516スライド","transitionName":"なし","characterName":"にとり","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"にとり","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"D3B90A64-F170-4676-B542-90EB7D450B65","seStartTimeOffset":0,"title":"シーン 516","telop":"私はそう言うと、さっとバッグヤードに戻り、手提げ袋を抱えて、持ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第517スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"F924C69B-BC78-4F54-A726-5CB9B921080A","seStartTimeOffset":0,"title":"シーン 517","telop":"「この袋はなんですか？」\n僕はそう彼女に尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第518スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"8BEB67FE-98DA-423B-93B3-6D3FECBD3F15","seStartTimeOffset":0,"title":"シーン 518","telop":"「さっき見せた、ポッキーを数箱と、日用品などをいれたお土産袋です。きっと、家に持ってけば、役立ちますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第519スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"53D88977-EE1D-447B-8DE4-191E24891C2C","seStartTimeOffset":0,"title":"シーン 519","telop":"「へぇ…」\n僕は頭をフル回転させて、どうするべきかを考える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第520スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"E57C80D8-A238-43C9-BB94-38F946F43F60","seStartTimeOffset":0,"title":"シーン 520","telop":"僕は、ちらりとさとりたちを見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第521スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"F99EA2A4-FB37-48D0-987F-BF0BB795A1F4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 521","telop":"彼女たちはなぜか汗ばんだ笑みを浮かべていた。\nすると、背後から恐怖を感じ元に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第522スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"DDD0D379-5B13-4DF6-9410-1CA799EBF523","seStartTimeOffset":0,"title":"シーン 522","telop":"僕が元の体制に戻ると、彼女はさっきと何も変わらない笑みを浮かべていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第523スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"D1163CE6-2393-43E0-995B-F037F9CEDBA8","seStartTimeOffset":0,"title":"シーン 523","telop":"「これってまとめて家に送れますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第524スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"2492B0DA-3981-4182-AF49-0466BBF4BC42","seStartTimeOffset":0,"title":"シーン 524","telop":"「ええ、大丈夫ですよ。少々お待ちください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第525スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E529EE7B-6699-42AB-82A5-83FA6CC6776E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 525","telop":"私はバッグヤードに戻ると、ビニール手袋をはめ、指紋防止ビニールフィルムを被せてあるボールペーンと書類を取り出し、持っていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第526スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"1F67C54F-0690-4E51-B219-D3AA9C4866A4","seStartTimeOffset":0,"title":"シーン 526","telop":"私は、フィルムを取ったペンを渡して言う。「お待たせしました、こちらのボールペンでここにあなたの名前を書いてもらえますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第527スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"FCDABE06-0593-43D0-84F7-F80BD6737C66","seStartTimeOffset":0,"title":"シーン 527","telop":"「分かりました。」\n僕は、言われたとおりに、名前を書く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第528スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"F09ACD7A-B11E-4446-805E-672C1C18765C","seStartTimeOffset":0,"title":"シーン 528","telop":"「ありがとうございます。では、あなたのご自宅にこちらを届けますので、届いたら、ぜひ使ってみてください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第529スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"B270A0CA-FE5A-40B8-A5AE-008D476AB668","seStartTimeOffset":0,"title":"シーン 529","telop":"「ありがとうございましたー。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第530スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"561F4E56-6F32-4C25-93AB-6CC528DA913F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 530","telop":"僕たちは、そのお店を出ると、自然と3人の足取りが駐車場に向かっていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第531スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D5FDBC5-40EF-4C2A-B6BA-59A2B2DFB97E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 531","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第532スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"9B471A53-7219-41B8-8FD0-C51262DB83C6","seStartTimeOffset":0,"title":"シーン 532","telop":"僕は、病院に戻ると余った時間で各検査を受ける。そして、僕はそのまま夕食とシャワーを浴びて寝静まる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第533スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AD9FEAB5-6C60-4418-9A87-11C085A3807F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 533","telop":"翌朝になると、昨日の検査結果を永琳さんから聞き、特に問題なく無事に退院する。そして、電車で家に帰る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第534スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（弱る）.png","id":"AC5F5C90-F50F-4A20-8446-FCE22D2FB474","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 534","telop":"僕が家に帰ると、咲夜がリビングで休んでいた。僕は、共同冷蔵庫にいなり寿司を入れると、咲夜が話しかけてきて…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"ACF24E95-E4E5-4A71-8812-308107B69D04","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"01380437-AD19-4838-A958-2BD795F121A0","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第537スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"D32144E9-6D0E-42B9-A463-CF44F5C10105","seStartTimeOffset":0,"title":"シーン 537","telop":"僕は、ショッピングモールから帰ると、病室のベッドでゆったりとしていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第538スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"74D2CD1D-1395-4E90-BD00-2F465E4DF5B4","seStartTimeOffset":0,"title":"シーン 538","telop":"すると、ドアを誰かがノックする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第539スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"597890F1-2CE4-4610-A678-B5830A2FD29F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 539","telop":"「外出から戻られたのですね。どうでしたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第540スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"2EE80E4C-A764-4B19-9E29-C507ACA9C9AF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 540","telop":"「ショッピングモールに行ってきました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第541スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"BBD3BF09-4967-47D8-8128-5B4CFFA89BC0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 541","telop":"「へぇ、何をしていたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第542スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"14AEE1A3-C5E4-4BC5-B238-FAF513CC3FE5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 542","telop":"「ゲームセンターとショッピングです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第543スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"F7CFDC80-2032-4B3D-BE8C-4EC525C25C8E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 543","telop":"「そうですか、それじゃあ、検査に入りましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第544スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"05B2B21E-786C-45BE-995A-6D391ABDAAE7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 544","telop":"「検査？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第545スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"349EA184-AAED-4A43-A13A-5D37DC73A2D0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 545","telop":"「ええ、今、廊下に検査の担当者を待機させてますから、その人に従って検査を受けてください。翌朝に結果が出ますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第546スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"F7F2D50C-D2D5-47AA-973C-72896739EC8E","seStartTimeOffset":0,"title":"シーン 546","telop":"「…分かりました。」僕がそう言うと、彼女は一言言ってから、病室から出ていった。僕も、ベッドからおり、病室を出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第547スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4231C84B-122B-44F1-B531-C23A7176F7D3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 547","telop":"僕が、病室から出ると、そこには紅白色の女性がいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第548スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4EA1570A-58BF-4B74-8956-7097898F0A0B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 548","telop":"「君が幻武操夢かい？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第549スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"30182EF4-F354-4BD5-9282-35A17923E846","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 549","telop":"「はい…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第550スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"640CEDE4-F7E6-428B-A046-FE844F50EF56","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 550","telop":"「私の名前は、藤原妹紅。今から、夕方まで君の検査を担当するから、よろしくな。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第551スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4C0080E2-4787-4233-8FB0-647CFA69E283","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 551","telop":"「分かりました…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第552スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"706A7152-475A-4EE0-B71C-844AE4911E5D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 552","telop":"「じゃあ、検査室に向かうぞ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第553スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D93700F-9EDA-4808-9FAB-5A3ECECDBB56","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 553","telop":"彼女はそう言うと、先に歩き出したので、僕も彼女について行く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第554スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BE2DB24F-9ACE-41F6-9F3C-C5A86E3EFE4D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 554","telop":"僕と彼女が検査室に来ると、彼女はベッドで寝るように言われる。僕は、彼女の指示に従う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第555スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0178BB7D-3835-4445-8071-458323DA36CC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 555","telop":"「じゃあ、検査を始める前にコレを飲んでくれ。」\n私はそう言うと、白い液体を渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第556スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"08F643E9-6DEE-4772-88CD-8038C3EC677B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 556","telop":"「これは、何ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第557スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0E7860A8-C7F3-4561-9625-CD514F265606","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 557","telop":"「乳酸菌飲料さ。君がこれをよく飲むと、永琳がいっててね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第558スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"26D9A528-6753-4057-BF14-7523BEE458CC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 558","telop":"「分かりました。」僕は、彼女から渡された飲み物を飲む。\nすると、何となく眠くなってきてそのまま目を瞑る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第559スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FC7893BD-9BAF-4AE7-86A0-2BF51DDE7EBA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 559","telop":"私は、彼が寝静まったのを確認すると、「はぁ…」と一息をつく。\n私には、わざわざ彼を眠らせる意味が計りかねた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第560スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1A98C2C7-2852-4E05-9C90-1F9A07D5AF74","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 560","telop":"「まぁ、いいや。」私はそう言い、作業に取り掛かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第561スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D710388-EA0D-45B3-8EB4-7592348AD830","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 561","telop":"それからしばらくたち…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第562スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"FD4DD616-D5B3-4A80-ACFC-08A54A1F4888","seStartTimeOffset":0,"title":"シーン 562","telop":"僕は、ふと目が覚めると、そこは自分の病室だった。僕が机を見ると、そこには夕食を乗せたお盆が置いてあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第563スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"8924276B-ED63-425F-B976-CCC6A3678806","seStartTimeOffset":0,"title":"シーン 563","telop":"僕は、それをゆっくりと食べる。そして、数十分くらいで食べ切ると、ベッドから降りようとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第564スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"D2F1BA42-9378-4107-A248-92FAD6D39F99","seStartTimeOffset":0,"title":"シーン 564","telop":"すると、足がふらつき、咄嗟に窓に両手を付き、支える。\nふと窓の外を見ると、一瞬誰かが見える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第565スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"C8195690-0819-4770-B852-9E60A854A281","seStartTimeOffset":0,"title":"シーン 565","telop":"僕は、なんとなく、窓の鍵を開けると、先ほど見かけた人物が入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第566スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"CA1D93C1-408C-4A30-8FCD-0204D4F7F3A4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 566","telop":"私は、空を飛んでいると、ふと視界の端で、彼がぐらつくのを発見し、病室の中に入る。「おい、大丈夫か、操夢？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第567スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"889F7696-56FA-42FC-90C0-74D50A0C85DD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 567","telop":"「ちょっと足元がぐらついちゃって…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第568スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"D65034F4-4956-4216-8916-196C692D6FB7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 568","telop":"「何があったんだ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第569スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"D92561AE-9FFD-46A4-88F5-7B61A6CC6BB4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 569","telop":"「えっと…、病院に戻ってきたら、検査があるって、検査室に連れてかれて…、気づけば、このベッドで眠ってました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第570スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"E939FCA2-9B43-49BF-8206-5966AEF82A34","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 570","telop":"私は、「はぁ」とため息をつきながら、彼に言う。\n「これからどうするんだ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第571スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"D6042D79-6F7B-427A-87EF-5BFCC0E14649","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 571","telop":"「歯磨きをしようと思って…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第572スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"EDE552EA-5C1A-4343-9DE4-F261DDF71DC9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 572","telop":"「はぁ、じゃあ、洗面所まで私の肩を借りてけ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第573スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"B2D96ACB-52DD-4DEE-8390-208925596B5B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 573","telop":"「あっ、ありがとう…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第574スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"C81ABEF8-5147-4E5F-976E-F156DEC88273","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 574","telop":"私は、彼の言葉にドキっとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第575スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"91DAFEA0-461E-490A-9704-736B9967A940","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 575","telop":"「ほら、私の肩掴んで立って。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第576スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"E5BA476F-AD5E-4755-A516-25746AF9DC09","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 576","telop":"私がそう言うと、彼は私の肩をゆっくりと掴み、立ち上がる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第577スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"590EA338-34F0-407D-B5F4-90198760615D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 577","telop":"「じゃあ、洗面所まで案内してくれ。」\n私がそう言うと、彼は歯ブラシを入れたコップを手に取り歩く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第578スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"4B8EC298-CB8F-439B-8A9B-3CFA6BDF79DD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 578","telop":"僕と彼女が僕の歯磨きを終えて病室に戻ると、彼女は「またな。」といって、窓から出ていった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第579スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256899_病室-夜-電気あり.png","id":"E82A77B0-E2BB-46FC-BFAD-046A08F382C6","seStartTimeOffset":0,"title":"シーン 579","telop":"僕は、彼女を見送ると、ベッドの中でぼんやりとする。\nなぜか、寝る気が起きず、そのまま時間が過ぎていった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第580スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3F82B634-C8D0-460F-9F0A-7402753647AA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 580","telop":"それから夜が明けて…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第581スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"DFD3B08E-D5C5-4CC5-873F-E1DEBC63A83C","seStartTimeOffset":0,"title":"シーン 581","telop":"僕は、ふと気がつくと、夜が明けていた。\nそして、壁掛け電話から着信音が鳴っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第582スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"D27C3A01-91B6-462E-88DC-A160CC6C50A7","seStartTimeOffset":0,"title":"シーン 582","telop":"僕は、ベッドから降りると、そのまま歩き、受話器を取る。\n「もしもし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第583スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"3D7777C0-D43A-4814-8CCC-4A1E2F44A17C","seStartTimeOffset":0,"title":"シーン 583","telop":"「もしもし、操夢さん、今、昨日の検査結果が出たので、診察室まで来れますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第584スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"B784EFB7-6E66-40CB-AF33-58E87224BE17","seStartTimeOffset":0,"title":"シーン 584","telop":"「分かりました。じゃあ、今すぐ向かいます。」\n僕はそう言い、受話器を戻すと、病室のドアを開ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第585スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4978D98A-6E7A-41A3-871A-872B2531F23B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 585","telop":"僕が、診察室に入ると、そこには笑みを浮かべる彼女がいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第586スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6B69A8EB-5E56-4BD1-BD32-01C9973BB486","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 586","telop":"「おはようございます、操夢さん。体調はどうですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第587スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"513D640A-F514-4B6C-A7B3-04A1579545FD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 587","telop":"「一晩寝たら、元に戻りました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第588スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"25E54280-00EF-427A-AC6C-A8E4B242D56E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 588","telop":"「そうですか、それで何よりです。それでの昨日の検査結果は…」私はそう言いながら、彼に検査データを見せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第589スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"61D161F1-BA88-4CB8-A827-0961E8AC2456","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 589","telop":"「特に異常や問題点は見当たらなかったので、今すぐ退院できますよ。それで、帰りはどうしますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第590スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9B768067-92B2-4874-904C-4ABA2A3F27D2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 590","telop":"「電車で帰ります。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第591スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BD3CC4F1-7AFB-4145-B818-C2F82F3F6B18","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 591","telop":"「分かりました。では、お気をつけてお帰りください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第592スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9A0D96B7-0D7A-4C11-994C-CB6F42DBA803","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 592","telop":"「はい、ありがとうございました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第593スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"28E558C7-92BC-4F43-9CCE-9034911369F3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 593","telop":"「どういたしまして。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第594スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"44390144-33BC-40A8-AA21-4123BDFB2A93","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 594","telop":"僕はそう言うと、一度病室に戻るのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第595スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"22D83914-F4AE-4D1B-8F63-564FF7FA3FFC","seStartTimeOffset":0,"title":"シーン 595","telop":"僕は、病室に戻ると、身の回りの荷物を整えて確認する。\n「これで、よしっと。」僕はそう言い、病室から出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第596スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6C8CA8FA-4FBA-41B7-ABC0-6E25A86F9CFF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 596","telop":"僕は病院を出ると、最寄駅に向かって歩き出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第597スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DFCAAE07-8E14-4DDE-B4D1-D4C46A4AC799","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 597","telop":"場所が変わって…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第598スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"ACA240CF-F8EC-4C3A-A762-634A99EC4ECA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 598","telop":"「大河課長、例の件なのですが、彼の状態を検査したところ、何の異常もなかったと報告が入りました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第599スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B59C4F32-C5AD-48AE-9EB2-984FEC4D14D2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 599","telop":"「彼と一緒に暮らす彼女たちは、どうなんだ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第600スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6BB725A8-3B19-45D5-A928-C4D48557B886","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 600","telop":"「それなのですが、八雲総理の所属するゆかりん党の者たちが、我々の調査を阻んでまして、どうしましょうか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第601スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CED99199-34AB-4787-A697-ABC96204EBC3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 601","telop":"「そうか…、何かいい手はないのか…、このままだとさいたま中央だけ悪目立ちしてると指摘される…、原因さえ分かれば…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第602スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"96FF7648-8165-4DF0-B3A9-00FA10180814","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 602","telop":"「その原因なのですが、小耳に挟んだ噂なのですが…。例の共同生活で唯一の男である彼は、遺伝率が高い持病があるとかないとか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第603スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0A7C939C-F081-4224-8EC5-C093373572DC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 603","telop":"「その詳細はわかるのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第604スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"16C741B6-B620-4E46-935C-AD1CB77F8DF5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 604","telop":"「いいえ、彼の情報はゆかりん党が所有しておりまして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第605スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F0ECB230-2B1E-4FA7-816A-2C5A7CCA84E2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 605","telop":"「それは奇妙だな、確か彼女は、男を庇うような理由はないはずだが…、とにかく、ゆかりん党を何とかする方法はあるのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第606スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BE6404E2-B126-4324-A244-4065819DE880","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 606","telop":"「それは、今、検討中です…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第607スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B0BF23FC-DD72-4E01-83D5-182CCF5729A6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 607","telop":"「そうか、ではゆかりん党への対抗策を考えろ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第608スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1D9CFEEB-AAA5-4A72-8718-EBDBC38A2E9B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 608","telop":"「はい、承知しました…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第609スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B208A9AF-2210-45A3-8C3B-0538678897A4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 609","telop":"その頃、操夢たちは…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第610スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（弱る）.png","id":"C8B93E66-E8A4-4A6D-8C1B-5C827B3FFEE4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 610","telop":"僕は、家に帰ると、咲夜が、困った顔をしていた。\n「どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第611スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"DF53C7F9-B95F-4568-BCE0-76D0936FA947","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 611","telop":"私は、いきなり彼が話しかけてきて驚く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第612スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"4F289E11-07BE-47ED-87C7-1C0E85588900","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 612","telop":"「はぁ、帰ってきたなら一言を言ってくださいよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第613スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（弱る）.png","id":"C287FFE3-1554-4EEF-8E5A-7979E528B53A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 613","telop":"僕は、どうしようか迷っていると、今朝起きてから何も食べてないことを思い出し、辺りを見回す。そして忘れ物に気づく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第614スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（弱る）.png","id":"7962090A-ADC2-4B3F-9D0C-9FFA38B94701","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 614","telop":"僕は、「まぁ、いっか。」と呟いた後、彼女に朝ごはんがあるか聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第615スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"D08529B7-15FD-42E8-AF50-E891071C0DCA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 615","telop":"「朝ごはんなら…」私はそう呟きながら、冷蔵庫を開ける。だが、中身は空っぽで、今朝は皆菓子パンだったことを思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第616スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"75FABEDB-41B8-4797-BA08-1A6E77156B35","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 616","telop":"「今、冷蔵庫に何もないので、朝食が欲しいなら、自分で買ってきてください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第617スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（弱る）.png","id":"C2668BC2-D92F-4056-95D4-7256960E9786","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 617","telop":"僕は彼女にそう言われて、自分の部屋の冷蔵庫を思い出し、階段を上がって行く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第618スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3A378008-9D44-4471-8E60-4EA0144E2A05","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 618","telop":"僕は、自分の部屋のドアを開けて、中に入ると、冷蔵庫を見る。\nそして、卵を手に取り、冷凍庫から冷凍ご飯を出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第619スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"39FBD5C8-044B-4518-A9BA-79E7897599B1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 619","telop":"僕は、卵をキッチンに置き、冷凍ご飯をレンジにかけるとキッチンの収納から醤油とついでにふりかけ、そして、箸を取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第620スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3E81A5C6-3D61-4246-97C2-26C045EFDC30","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 620","telop":"僕は、解凍が終わった白米をさっきの収納から出した容器に入れ、その中に卵とふりかけを入れて、醤油をかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第621スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0356B278-B0FC-4ADE-A90E-9BAF02891B78","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 621","telop":"僕は、卵かけご飯ができると、箸と容器を部屋に持ってく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第622スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"F7F2BFAE-B55D-4234-B51A-23E70EC932D1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 622","telop":"「いただきます。」\n僕はそう言うと、ふりかけ入り卵かけご飯を食べ出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第623スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"068BCACB-5224-4E78-B477-D021183951B1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 623","telop":"私は、彼がいなくなると、再び考え事をする。\n「何で、昨晩の記憶が欠けているのでしょう…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第624スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"F7BA53DE-1223-419F-AE93-2094623DD9B3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 624","telop":"私が今朝目覚めたのは朝9時で、目覚めた場所はリビングだった。\n周りにはお嬢様たちもすやすや寝ていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第625スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"EE4DE7AF-5147-4BA4-BCFF-1B7C25153388","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 625","telop":"そんな中、お嬢様たちも起きると、皆昨晩の記憶がかけているようで、何したのか思い出せなかった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第626スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"34AC221C-7A56-41EF-9CCB-163D8EB582E1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 626","telop":"たしか、昨日魔理沙が、帰宅して風呂に入っている間に宅配便が届いて…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第627スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"CBACAB9F-653A-4806-943A-99537B854892","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 627","telop":"私はそこでハッとする。\n「昨日届いた荷物ってどこにおいたっけ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第628スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"5C737DEB-F867-46EB-9C0F-BEEDC906EBFB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 628","telop":"私はそう言いながら、キッチンの収納を確認すると、そのうちの一つに段ボール箱があった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第629スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"ABC9A3DA-300C-4340-BA2B-AD5A498F8E4B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 629","telop":"だが、すでに中身は空で私は、また少し記憶を思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第630スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"F2EDB7B2-01EF-4ABC-874F-517853505577","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 630","telop":"確か、あの箱は差出人不明で怪しいと感じたけど、フランお嬢様が勝手に開けてしまって、加湿器が入っていて…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第631スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"5FBDEDE6-72F8-4C26-B55A-F55E36FC480F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 631","telop":"私はそこで全てを思い出した…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第632スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1F536F19-0C30-4867-A450-04F08F0AD110","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 632","telop":"時が遡り、昨晩の彼女たちは…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第633スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"3BA9754C-CE01-4D50-A651-8BE48954F81C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（微笑）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 633","telop":"「ただいまなのだぜ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第634スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（笑い）.png","id":"CFDE646E-7B6B-4940-93C9-23058D85A952","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/咲夜（笑い）.png","title":"シーン 634","telop":"「おかえり、魔理沙。とりあえず、風呂入ってきなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第635スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"50A45A23-F308-454D-9A46-795461167ECC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 635","telop":"「おう、じゃあ早速入ってくるぜ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第636スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"5D56F4B3-20B2-4E0E-BAE1-A56DB8E9FDDB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 636","telop":"「あれ、こんな時間に誰でしょう？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第637スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc245464_マンション（夜）.jpg","id":"07649E0A-2A5D-419F-A238-EC3C993AF71F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"title":"シーン 637","telop":"「あれ、人がいない…けどダンボールが置かれている…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第638スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"983B0A10-52ED-4F09-8BB8-4F3B551CF9A1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 638","telop":"「どうしよう…、見たら差出人不明だし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第639スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"2D720429-B5E2-4B5E-A792-074BBD304E31","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 639","telop":"「どうしたの、咲夜？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第640スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"6A4F4B4A-5CD2-4F26-9970-9ECBF3EB673E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 640","telop":"「差出人不明の荷物が届きまして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第641スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"87B1192D-9AFD-40C8-9631-BDAC3A8689C8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 641","telop":"「匿名で荷物なんて送れるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第642スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"965B0C12-FA5E-4F2F-A241-178107BB643F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 642","telop":"「さあ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第643スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"34A47911-6689-4CAD-BC17-D4D9D3804556","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 643","telop":"「フランお嬢様、勝手に荷物を…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第644スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"EC585CB3-3E8C-4418-8FDA-A4A70B9788C9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 644","telop":"「大丈夫だよ、咲夜、中身は加湿器だし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第645スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"F026829B-D332-40BF-9DFD-2E5B6BEFACDB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 645","telop":"「フラン、顔が頬照ってるわよ…、風邪引いたんじゃないの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第646スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（笑い）.png","id":"5BF5FDF3-CCD1-47C9-AA4A-9C344604A838","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/咲夜（笑い）.png","title":"シーン 646","telop":"「咲夜も、顔、頬照ってるわよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第647スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"1E988C69-56F3-4265-ACF3-3499B5390999","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 647","telop":"「どうしたのだぜ、みんな…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第648スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"24E66483-BD27-4E3C-850A-4C68CD393061","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 648","telop":"「これって…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第649スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"7063D5A0-45B1-4350-9AEC-0B05901473F2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 649","telop":"「誰なのだぜ、こんな加湿器を送ってきたやつ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第650スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"F0DE7956-2F89-4B2D-A2DE-3D522AB85D77","seStartTimeOffset":0,"title":"シーン 650","telop":"「どうしたのよ、あんたたち…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第651スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"AACB0BA7-2BB5-4208-9182-8A1E21B8E194","seStartTimeOffset":0,"title":"シーン 651","telop":"「これって…、一体誰が送ってきたのよ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第652スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"8F8AE945-DE93-4CEB-B8B3-9455DC6C150F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 652","telop":"「どうしたの、みんな、今夜は操夢がいないし、ここでガールズトークでもするの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第653スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"98CF0FDA-EDE0-4EB6-8E28-EB77A029BC3E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 653","telop":"「ほら、さっき彼の部屋にこっそり忍び込んで、ワインを持ってきたからみんなで、飲まない？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第654スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"7E9B9BC5-2332-41AA-9EB4-A4D7E1DCBA1E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 654","telop":"「せっかくなんだし、みんなでこいしの言う通りに、ワイン飲みながらガールズトークでもしよう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第655スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"3FC73FB5-02A7-46F2-A42A-CA1DBCCCEB24","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 655","telop":"「それなら、お姉ちゃんたちも呼んでくるね！」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第656スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc254863_マンションの外廊下（夜）.jpg","id":"22515205-73D9-412E-A38E-A65F7A48FD29","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 656","telop":"「どうしたのこいし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第657スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc254863_マンションの外廊下（夜）.jpg","id":"EC686878-E26F-4265-AA52-EC40E4D9ED2C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 657","telop":"「何でそんなことを…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第658スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc254863_マンションの外廊下（夜）.jpg","id":"2FDA67EC-7C7F-4380-B2AB-8BF239694B9B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（怒る）.png","seStartTimeOffset":0,"title":"シーン 658","telop":"「こいし、いったい何があったのか、現場で説明しなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第659スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2E604A9E-94E1-43AD-8244-969D09FC1893","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 659","telop":"それから時が進み真夜中に…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第660スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"DB6F7CEE-75FC-40DC-AF3F-301D88951E07","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 660","telop":"「ヒック…もう〇〇発電なんて出来ませんよ…ヒック…お嬢様…ヒック…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第661スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"1B59B5A6-E507-4A00-BCF9-4DBF00E3E929","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 661","telop":"「ヒック…咲夜…ヒック…だらしないわよ…ヒック…〇〇発電が出来ないなんて…ヒック…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第662スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"818B311E-B318-4363-9117-1C3C838A3EF2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 662","telop":"「ヒック…私も…ヒック…〇〇発電なんて…ヒック…出来ないよ…ヒック…お姉様…ヒック…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第663スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"B4946A7D-4B47-46D6-97DB-FBE8810D0ACE","seStartTimeOffset":0,"title":"シーン 663","telop":"「ヒック…ねぇ…ヒック…魔理沙…ヒック…どうだったのよ…ヒック…久々の〇〇発電は…ヒック…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第664スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"177FA385-9CF7-4C43-B03F-346CD5A4235F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/魔理沙（余裕）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 664","telop":"「ヒック…とても…ヒック…楽しかったぜ…ヒック…霊夢…ヒック」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第665スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"E5C31D7B-897E-4FBC-B571-7748C86D5842","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/こいし（余裕）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 665","telop":"「ヒック…どうだった…ヒック…女子だけの…ヒック…〇〇発電…ヒック…飲み会は…ヒック…お姉ちゃん…ヒック」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第666スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"F8D2F00E-5373-43B2-B084-148626AEDF77","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 666","telop":"「ヒック…とても…ヒック…楽しかった…ヒック…こいし…ヒック」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第667スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"409DEF3E-C825-4A69-937F-862CA0DF7B8D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 667","telop":"「途中で寝落ちして正解だったわ。まさかこんな状況になるとはね…、誰も予想できないわよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第668スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"90A46B61-D6F5-4D78-BE7C-A5012B969AE8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 668","telop":"私は、その記憶を思い出すとともに、恥ずかしさが込み上げてくる。「昨日は、みんな、羽目を外し過ぎたのかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第669スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"6579FFAD-E459-4B79-9829-08968AEB0294","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 669","telop":"私はそこで、今日の1日は彼と過ごす日だったことを思い出す。\n「早く行かないと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第670スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DD6B8441-22ED-4A28-9966-8637D0DAED58","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 670","telop":"一方その頃操夢は…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第671スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"2FCD305D-22DE-4512-B64A-1E5C3F9E930D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 671","telop":"僕は、朝食を食べ、お皿を洗い、歯を磨くと、自分の部屋でぼうっと日向ぼっこをしていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第672スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"F14224A5-A993-451C-90F2-44D752AA14B2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 672","telop":"「そういえば、僕が入院している時に、僕のワインを空っぽにしちゃったのは誰なんだろう…？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第673スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"E49C571F-5601-44BF-8415-E768ECEB452A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 673","telop":"僕は、そんな疑問をふとつぶやくとインターホンがなる。\n僕は、玄関に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第674スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（困る）.png","id":"C920A8F3-B6EB-4B3C-B0B2-55EE0350D160","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 674","telop":"僕は玄関を開けると、そこには困惑した表情を浮かべる咲夜がいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第675スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B5F8DB94-F61B-43FC-B229-334999D004A4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 675","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第676スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"556B8C48-E36A-483C-8331-FE9E0CD06241","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 676","telop":"僕は、咲夜を部屋に招き入れると、彼女に何か、困り事でもあるのかと聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第677スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"99485C15-694A-48F6-903B-1070E6671BC7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 677","telop":"私は、昨晩皆で〇〇発電飲み会を真夜中まで実施していたなどとは到底いえずにだまっていると、彼が買い物に行こうと言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第678スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（弱る）.png","id":"F732C152-EF96-4275-AF92-2FC6CC857504","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 678","telop":"僕は、彼女を買い物に誘い、４駅隣から徒歩15分程度の中規模ショッピングモールに来た。そして、モールをぶらつき…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"58F14712-3CA3-4877-91EF-007CDF2AE930","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"E8A1379C-D947-4AF3-BA4C-22BCBEB6F756","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第681スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（困る）.png","id":"4EA7F7F4-84B7-4E67-8109-B8FF86A25F44","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 681","telop":"「おはようございます、咲夜さん。今日はどうしますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第682スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（困る）.png","id":"1F93C668-DC72-4329-B951-E429DF2DC877","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 682","telop":"「えっと…その…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第683スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（困る）.png","id":"7B6F4A2D-355C-48A4-BFE0-FEFF87C24658","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 683","telop":"僕は、困った顔の咲夜に「部屋で話そう」と言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第684スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"848826AF-C5CF-47A1-B73D-9D4C518B5648","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 684","telop":"すると彼女は、先に部屋に入る。\n僕は、冷蔵庫から麦茶を出し、コップに注いで持って行く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第685スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"5AB622F2-642B-4CFB-A165-F3A22527C0E3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 685","telop":"「どうしたんですか、咲夜さん、さっきからそんな顔して？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第686スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"02B93A0C-246B-4FE2-9C5D-F20AE109AE76","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 686","telop":"「それはこっちの事情なので気にしないでください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第687スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"260761AC-DBEC-42F3-96AA-B4CB8AAF9A77","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 687","telop":"「そうですか…」\nするとしばらくの間、互いに無言の時間を過ごす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第688スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"7F2B495A-A39B-4ABF-8FEC-523C7A8562A1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 688","telop":"「そうだ、咲夜さん、買い物に行きませんか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第689スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"45893DB4-179A-4AFD-A1D6-228EE480DF6D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 689","telop":"「買い物ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第690スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"C7CB00FF-9D5D-4A83-9BA4-22711ED4948C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 690","telop":"「ええ、どうですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第691スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"5001CBAF-F515-4FA8-99D8-ACA363D39B57","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 691","telop":"「そうですね、買い物で気分転換でもしましょうか。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第692スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"F274D3C8-1323-4D5F-8346-6ECDCD6D3B3E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 692","telop":"「咲夜さんは、部屋に戻らなくて大丈夫ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第693スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"97AC3285-9F08-43B9-8323-59A065ED9CCA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 693","telop":"「そうですね、私の部屋、確認してきます。」\n私はそう言うと、彼の部屋を離れた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第694スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"DBC2690D-2000-482B-93DA-379A19A09777","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 694","telop":"僕は、咲夜がいなくなると、買い物の準備を始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第695スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"03C065D4-A262-496E-9ECC-DC37D4E74F7A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 695","telop":"僕たちは、それぞれ準備を済ませると、家の最寄駅から４駅隣の中規模ショッピングモールに来ていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第696スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（微笑）.png","id":"7677A77D-C925-4332-BA92-188A6DC83AD6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 696","telop":"「咲夜さんは、何か買いたいものでもありますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第697スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"4E821542-6E81-4E7A-9DDD-3D37E0A3AED7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 697","telop":"私は、そこで共同冷蔵庫が空だったことを思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第698スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（微笑）.png","id":"578E2059-5FA5-4D71-9DD6-F4A719CD88B2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 698","telop":"「私は、食材を買いますが、操夢さんは何をするんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第699スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（微笑）.png","id":"B7BA03EF-EC2E-4E51-A209-CFF3CE96FB84","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 699","telop":"「僕も、自分の部屋の冷蔵庫にあったワインが消えてたので、新しいワインを買います。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第700スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"3206512F-E25D-4441-85FC-C8EED0FA16A4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 700","telop":"私は、そこでハッとあることを思い出す。\n「財布、あるっけ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第701スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（驚く）.png","id":"4E644FE6-B518-47F1-99CC-C835276BFAFB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 701","telop":"「お金なら…」僕はそう言いながら、背負っているリュックサックを探る。そして財布を手にとり中身を見る。「小銭だけだ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第702スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"2281A45A-55B7-4921-AC3B-84E53E9AC691","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 702","telop":"私は、財布を家に置き忘れたことに気づき、どうするか考える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第703スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"6AA8C9BA-EAAF-4DEF-85E5-722E57C13F43","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 703","telop":"「どうしますか…、家に戻りますか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第704スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（困る）.png","id":"1F55273C-6D3C-40D2-8CB7-E8FE4A0491AF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 704","telop":"僕たちは、その場でどうしようか考えていると、誰かが僕の肩を叩く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第705スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"725CC04A-61A8-488B-98DC-41C2EFE1D126","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 705","telop":"「あなたたち、今困ってるんでしょ。はい、これ。」\n私はそう言うと、キャッシュカードを渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第706スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F5CEC8E2-A69C-49EA-94A3-695DB355055F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 706","telop":"「しっかりしなさいよ、あなたたち。私が金なしであなたたちが外出たことに気づいたから、追ってこれたんだから。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第707スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"66A90105-5991-429A-A5A4-A135F741619A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 707","telop":"「あっ、ありがとうございます。」\n僕はそう言うと、受け取ったカードを財布にしまう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第708スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B9FB5FAE-02C0-46C4-BD17-55E317021AEC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 708","telop":"「私は、もう帰るからね…。」\n私はそう言い残すと、その場から離れた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第709スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"0689375C-B5F8-4C31-B0BB-C3D5C69A9580","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 709","telop":"「とりあえず、ATM探しましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第710スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"8935EFA7-B7AE-45ED-A31C-93D3FC79E40A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 710","telop":"「そうですね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第711スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"5EAF797E-0187-4EF3-8D33-D6AB836E7DF0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 711","telop":"私たちは、ATMコーナーに来ると、彼からカードをもらい、機械にキャッシュカードを入れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第712スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"EE1D97BF-3B93-415E-9D8A-61DF238B24DA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 712","telop":"私は、表示された残高を見て驚く、そこにはエラーポップアップと共に0円と表示されていた。「何で…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第713スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"32E49190-A1A3-4C63-8739-FD5FE435E5E9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 713","telop":"私たちはこの制度に登録した際に、共同名義の口座を作り、その口座の残高が特定の条件を満たすと残高を自動追加しますと役所の人に言われた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第714スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"023EF9FF-ACCC-44D8-889C-DDFD8E6D7C0C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 714","telop":"だから、残高が底をつくなどあり得ないのだ…。\n私は疑問に思いながら、エラーポップアップを再度見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第715スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"5A68D244-4D5A-4164-86AA-8FC80AAE9F7A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 715","telop":"そこには、エラーコードとその内容が載っており、詳細はWebサイトで確認するように案内があった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第716スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"C7912629-DCE9-46DC-9896-AE50D6D2DFF9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 716","telop":"「どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第717スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"41B04F50-C21F-4EB4-899C-7A7DB9DFA3F0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 717","telop":"「このエラーをメモすることはできる？」私がそう言うと、彼は「分かりました」と言い、リュックサックからメモとペンを取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第718スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"9E3AC234-5BA0-4B99-B71C-583B9D49CCB6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 718","telop":"「出来ましたよ、それで、どうするんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第719スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"B3DA99CB-9822-498C-9A9B-E7B7731F5D0D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 719","telop":"「とりあえず、今すぐに家に帰ってお嬢様たちに報告しましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第720スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"30964BDE-D2B7-42E1-BE4D-88D2F06F6576","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 720","telop":"「分かりました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第721スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5F2FA241-0009-48E6-915A-4D9401F7A447","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 721","telop":"一方その頃　パチュリーたちは","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第722スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"0F00965D-39DF-483E-AD23-55D3DFA002BC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 722","telop":"私は、静かな共同スペースで読書をしていると、インターホンがなる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第723スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D7DA394-73E0-4D4C-984B-B047F51E1F81","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 723","telop":"私が外に出ると、そこには10個の段ボール箱があり、あたりには誰もいなかった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第724スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D7DA26E4-C09A-4F21-9A71-88CEF663BAEA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 724","telop":"「一体誰なのよ…、何も言わずに荷物だけ置いて立ち去る人は…」\n私は、ため息をつきながら置いてある10箱を魔法で運ぶ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第725スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"D0ABED64-3417-45BA-8AB2-AD66342E5285","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 725","telop":"「パチェ、その荷物どうしたの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第726スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"4387F9A0-BD3C-41F9-97C9-A6FC822695A4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 726","telop":"「誰かが、これ置いて、インターホンだけ押して去っていったのよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第727スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"89989C82-6B3D-46FB-83A8-49992526054A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 727","telop":"「そう、それにしても困るわね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第728スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"A9775FD4-A5AF-46F2-989B-CAC6B25FDDDF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 728","telop":"私たちがそんな会話をしていると、上から誰かが降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第729スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"6805E8E4-98D4-428E-B171-1F3304B9A068","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 729","telop":"「どうしたんですか…って、また荷物が届いたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第730スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"808BA7BC-A941-4BD5-985C-7BC10C53E460","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 730","telop":"「ええ、その通りよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第731スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"4157F304-C003-4362-9868-ED07748FA222","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 731","telop":"私はふと段ボールにラベルが貼ってあることに気づく。\nそのラベルを見ると差出人に「河童の技術屋」と記載されていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第732スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"51423FC1-B3FB-4816-8F37-B285C80B1EA5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 732","telop":"私はそこで、昨日のことを思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第733スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"73674F3B-7E6E-4FB9-B0F0-F1588CFE8AC1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 733","telop":"「どうしたのよ、さとり？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第734スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"0CC5E09E-36F9-4DA4-ADE7-C132587FAD92","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 734","telop":"「これ、あの河童から、彼に押し売りされて、挙げ句の果てには、私たちに睨みつけてまで、売りつけた改造ポケベルですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第735スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"3D01E5E6-77ED-4784-8145-36FF13D908E6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 735","telop":"「えっ、何があったのよ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第736スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"B6B394C3-52F2-4E3E-BA4B-9DB5AC47A58A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 736","telop":"私は、そこで昨日の河童とのやりとりを話す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第737スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"7368CF2F-BDD5-433C-9E84-11F6D55E3DB3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 737","telop":"「それは、あの河童が悪いわ。一体、いつから押し売り営業マンに変貌したのかしら、にとりは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第738スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"47F4CF17-C684-449F-B850-9B45C70D92A6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 738","telop":"私たちがそんな会話をしていると、誰かが共同スペースに入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第739スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"55F762A9-AF4C-49E0-9CBD-3D88FE689650","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 739","telop":"「ただいま！」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第740スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"EF499B20-BBE6-4F3C-8CDF-48BC6F250F57","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 740","telop":"「あんたたち、帰ってきたら、手洗いとうがいをしてきなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第741スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"5B8A656F-A201-4891-A06E-A2DEBD3E5884","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 741","telop":"「分かった！」\n私はそう返すと、こいしと一緒に共同洗面所に向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第742スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"5CC0D602-D7FD-42CF-A687-C7155FBEFAD5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 742","telop":"私は、この荷物をどうすべきか考えていると、再び誰かが共同スペースに入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第743スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"E15A4F62-5627-4374-A609-6CDEB92AF101","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 743","telop":"「あの、お嬢様…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第744スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"BD75D027-BB59-44AA-9076-E310F11C3D2A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 744","telop":"「どうしたのよ、咲夜？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第745スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"90C9EC4A-9A42-42CC-BACA-EF12CE1B0201","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 745","telop":"「先ほど、彼と出かけて買い物しようとしたのですが…」\n私はそう言い、今までのことを説明する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第746スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"47818199-753E-4B9E-8FDE-39458547BBED","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 746","telop":"「なぜ、共同口座の残高が底をつくのよ？」\n私たちが会話をしていると、フランたちが戻ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第747スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"AB8A5814-727E-4A04-AFC6-845016F63343","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 747","telop":"「あれ、どうしたの咲夜？そんな顔して。」\n私はそう彼女に聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第748スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"C629D3A1-CD34-4BF7-8658-76CC54E2882E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 748","telop":"「この荷物、どうするか、話し合ってたんです。」\n僕はそう返す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第749スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"CFC88882-2387-4C98-BE67-397D1EB3CF52","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 749","telop":"「じゃあ、これ開けてもいい？」\n私はそう彼に聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第750スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"CD2C4559-23F8-48BB-96C2-0F85428B3D05","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 750","telop":"僕は、少しの間考え、今後のために「開けていいよ。」と彼女に返した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第751スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"55D7C0E7-0985-4CB2-A5E2-0B3A54198A80","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 751","telop":"その頃、某所では","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第752スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D90833D7-CE57-4802-A9C3-00822D2716A3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 752","telop":"「大河課長、例のさいたま中央なのですが…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第753スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6C19F267-FD75-49FC-B508-859565A1953E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 753","telop":"「何か進展でもあったか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第754スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"30754CF3-7A19-44F7-A3F0-141126F32E6B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 754","telop":"「課長がおっしゃっていた共同口座の差し押さえは無事に成功しましたが…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第755スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"78665A0C-A25A-40CA-8027-A769B72B020E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 755","telop":"「ほう、それで？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第756スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AC239D9E-4258-4675-B437-E61FAFD8C4D2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 756","telop":"「差し押さえはしましたが、同時にゆかりん党からの反撃も喰らい、今その口座はデットロック状態です。」\n※デットロック…データベースなどのシステムにおいて、特定の項目に\n2者から同時アクセスし、そして双方が編集をしようとした結果、\n双方にロックがかかり、一切の編集や変更をシステムが受け付けないことを指す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第757スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DCD50C41-7482-47E6-BE2E-46DF452384EF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 757","telop":"「それで、デットロックを解決する方法はあるのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第758スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4728032C-60DA-411D-920C-D66D9AC69299","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 758","telop":"「あるにはあるのですが、恐らくゆかりん党も、我々巨漢党も手は出せず、唯一口座に紐づくシステムにアクセス権限を持つ者なら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第759スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"875F92E1-1268-446B-AA42-0F123D3968DB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 759","telop":"「そのアクセス権限は、誰が有しているのだ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第760スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8E88FD8A-7BA9-4296-95D5-1047C5EC2606","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 760","telop":"「それは、この国の根幹をなす八雲総理直属のAIボールです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第761スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"587C3D2B-FE6C-4AA4-AC74-6AA98BB45DA0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 761","telop":"「AIボール？もしかして、首相官邸の地下深くに眠る例の全球か？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第762スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"08369C9C-867D-4D5A-A097-F281989216C3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 762","telop":"「ええ、この国のシステム面は全てその全球に紐づいているので、そこを叩けるものがいたら…デッドロックは消えるでしょう…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第763スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9D69316A-1363-4EAE-8C48-6525860667CA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 763","telop":"「それで、その全球を叩けるのは誰だ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第764スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BC5EF56B-808E-41A0-943B-60A3D0ED2224","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 764","telop":"「それは…、不正確なのですが、あの全球と八雲総理をはじめとするゆかりん党が急に出た時に、全球と密接に関わる男女がいたと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第765スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"72061364-0903-4BC4-B21D-C957871E5B27","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 765","telop":"「それで？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第766スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4C9FBED0-F159-4A0C-84A7-6293EF38275A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 766","telop":"「その男女のうち、女性の方はゆかりん党と同時期に現れましたが、男性の方は…かつてこの国から消えたことがあるとかないとか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第767スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"33D2B684-1F6A-41BF-A885-8EB8B54D81AE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 767","telop":"「それは確かなのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第768スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5BB60139-C45A-4979-8BA2-86810E1B8EBC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 768","telop":"「これは噂ですから、それが事実かどうかは疑わしいですし、この事実を証明することもできないので断定はできません。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第769スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FF227F4D-F3FC-4D4D-AB2F-5394A56392EE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 769","telop":"「そうか…、それなら違う方法でさいたま中央が悪目立ちしないように対策を取れ…、早急にな…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第770スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"506D8664-CEE4-406F-8A81-517A94EB054F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 770","telop":"「承知しました…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第771スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FC01E577-C7A7-4830-813C-C0784F860FB0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 771","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第772スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"63C64C07-EF6A-4037-9867-9D2F0EF6A6E8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 772","telop":"僕たちは、例の段ボール箱を開けると、河童の技術屋で購入した改造ポケベルが何故か9台に加えPCが10台入っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第773スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"8F0F6BD4-5F0C-4E0C-ADF1-E464F3C212F3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 773","telop":"だが、ある段ボールの奥底にメッセージがあり、ポケベルとPCを人数分、ポッキーを10箱、日用品を数ヶ月分詰め込んだと書いてあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第774スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"E5CB5DDE-FD43-4C33-86C4-D0519219FE51","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 774","telop":"僕たちはその量に驚きながらも、フランとこいしがポッキーを早速食べたいと言い出して、ポッキーを僕も食べると…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"70A0A134-344C-4019-BE5B-07F91432375C","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"48BB6941-D78B-4A6B-95A1-22292243D9DC","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第777スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"F2AAF839-B03F-4397-B540-74B5346289F1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 777","telop":"フランが河童の技術屋から届いた段ボール箱を1箱開封すると、そこには改造ポケベルとポッキーそして手紙があった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第778スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"1025560D-FE19-4330-B0AA-DD4A8BB528A8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 778","telop":"僕は、その手紙をフランに渡してもらい、読み上げる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第779スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"239ACE22-2F28-4203-8621-6D2222039F13","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 779","telop":"「拝啓、この度は当店の改造ポケベルの購入をご検討いただきありがとうございます、幻武操夢様。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第780スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"3FF57395-1C11-4670-A7E2-57FDA39C6213","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 780","telop":"先日に店舗で依頼された、商品および日用品等を配送させていただきました。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第781スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"9AEA97C6-BE9D-48F6-AE09-F6249E856DE5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 781","telop":"また、店舗で私が説明したポッキーを10箱分および改造ポケベルをご使用になられる際に必要なPCをお届けしました。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第782スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"E7E28291-B3C0-4587-9DF5-5F97F32B40DE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 782","telop":"そして日用品等につきまして、数ヶ月分の量をお届けしました。日常生活にお役立て頂ければ、幸いです。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第783スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"2FC5C40E-842C-4FA0-A186-7E5B9D05782B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 783","telop":"さて話は変わりますが、私が店舗に置いてお客様にお話しした試用期間は配送完了後から半月とさせていただきます。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第784スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"9025F7FC-6C6C-485B-9746-632FBF960342","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 784","telop":"もし、お気に召さなかった場合、半月以内にお届けしたポケベルおよびPCを当店までお送りください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第785スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"1AA33019-3FC6-406D-B150-DA16DF6EAA81","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 785","telop":"なお、その際の送料は着払いで承ります。また、日用品類およびポッキーにつきましては、お受け取り願います。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第786スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"024670DA-1B58-4FC7-84FE-1C0D219E156C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 786","telop":"また、ポッキーは食料品であり、賞味期限が設けられているため、事前に箱の記載を確かめることをおすすめします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第787スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"24B5F5AA-7538-4CEB-A320-2FAD8949AE74","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 787","telop":"もし、何かご不明な点や質問等がございましたら、お送りしたPCを起動し、ブラウザに登録済みのURLからお知らせください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第788スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"C88303E3-1C1F-49F9-99F9-E4B3C5CDA6EB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 788","telop":"また、改造ポケベルのご利用にあたってはセットアップが必要となります。こちらもPC内にガイドがありますのでご確認ください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第789スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"0426C03F-D970-48C7-860B-B3F9CB43A6BF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 789","telop":"また、政府からの通達により、お客様にお送りしたPCは当店を介した政府貸出品の扱いとなります。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第790スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"9143EF01-5F37-47C5-ADCE-84B6A8491081","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 790","telop":"政府貸出品の詳細については、PC内の説明書をご確認いただくか、当店までお越しいただければ、書面でご説明します。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第791スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"5D12127B-E721-4C6B-B318-886BD07180FD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 791","telop":"また、問い合わせをする際には、問い合わせ内容の製品のMacアドレスと製造番号が必要です。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第792スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"CB3DC658-46BA-47F3-872E-34C386370C4E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 792","telop":"こちらはPC内の送付製品説明書及び確認書に全ての番号が記載されているため、手元にお控えください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第793スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"D6D42AFE-A96A-40C0-BE6D-6A1EE3034009","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 793","telop":"また、お客様の情報を当店で調査したところ、政府が公表しているデジタルデバイス特定供給世帯に登録されていました。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第794スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"EA6BEA82-02DA-4D08-843B-CFA97FB47317","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 794","telop":"これは同一世帯にお住まいの方全員が対象で、PCを無償貸付すると言う制度です。詳細はPC内の制度認定書をご確認ください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第795スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"EBE1F40D-0D14-4039-B7AA-11605AB514B5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 795","telop":"さて、最後にPCに関わるご説明をします。これは、大変重要な説明のため、手元にメモをお取りになられてください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第796スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"7E32991A-E2AD-4BF2-9372-F3D6B97AD99D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 796","telop":"まずはじめに、当店がお届けしたPCには大型のものが1つ、小型のものが9つあります。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第797スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"479C8C39-4798-4099-AC50-DCCA4A4AFF1D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 797","telop":"このどちらも、米国に本拠地を置く著名なリンゴマークのメーカのデスクトップ型PCとなります。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第798スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"3F7D28FC-FA40-4921-A5F5-2FC63F69F5CE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 798","telop":"当店は、このメーカーが我が国に構える法人と契約を交わし、修理などにおける公式サポートに登録されています。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第799スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"0347009A-4775-45F7-BD2D-114119039CFC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 799","telop":"また、全てのPCの所有権は政府が所有しており、政府が当店を介する形で貸付提供を行なっております。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第800スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"6119BDEF-6410-46AB-A07C-5864C5369926","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 800","telop":"なお、政府貸付のPCではありますが、個人情報やプライバシーなどの基準は政府ではなく、メーカーが設けております。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第801スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"BD2409D8-A719-4ADB-910E-6FF8F38E6E60","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 801","telop":"またPCをお届けした時点で、メーカーが公表する利用規約等にお客様は同意なされたものとみなされます。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第802スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"EF1B7412-15BB-4527-993C-22B20C1CCED9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 802","telop":"メーカーの利用規約及びプライバシーポリシーは、PCを起動し、ブラウザに登録済みのURLからご確認いただけます。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第803スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"1947E131-B947-429D-A05A-94A604DCC3CB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 803","telop":"メーカーの利用規約及びプライバシーポリシーに関する質問やお問い合わせは当店でお受けいたします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第804スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"D208AB50-B88D-48AE-A99B-7C7891446B1C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 804","telop":"また、お届けした小型PCの設置場所は、直射日光が当たらず、高温多湿を避けた環境でお願いします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第805スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"66C3005A-BFC3-4CFE-8783-48DA2CD5A7F3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 805","telop":"また、当店では、PCの最適配置サービスを承っております。もし、PC配置にお困りの場合はぜひとも当店にお越しください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第806スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"35904F47-E17C-46BA-BDC3-F04375CBEBC9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 806","telop":"PCの最適配置サービスは、政府の施策により、無償で承ります。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第807スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"8E0AD0DC-22BE-4B92-875E-CBC1C5BC7DD5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 807","telop":"またその際に、基本的なPCの使い方を当店スタッフがご説明することも可能なため、ぜひその際はお知らせください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第808スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"968E8F1C-817A-4D11-8CC7-40CDE2136476","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 808","telop":"なお、PCの付属品としてディスプレイが12台、キーボードが10台、魔法マウスが10台をお届けしました。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第809スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"8A62BBAE-4CA9-42CC-922D-1935CDCE0227","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 809","telop":"こちらは、PCを起動していただき、短距離無線通信を設定していただくことでご活用いただけます。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第810スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"967ACD31-6584-4AF2-8628-82EEC4129B76","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 810","telop":"また、PCのうち、大型のものは親機となり、世帯単位での活用になります。小型のものは子機であり、個人活用となります。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第811スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"7B19AC7C-F04A-453A-A288-33A4A2149C71","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 811","telop":"PCの親機は、この手紙に記載の文書類があらかじめ格納されています。また、当店独自のガイドなども格納されています。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第812スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"C81E6FC2-8FB3-4A95-B6CD-DDF64684199B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 812","telop":"そして、ポケベルに関するガイドや説明資料等も親機に格納されているため、ぜひご確認ください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第813スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"AFBE71AA-0E0E-4494-92F2-B425D3DE8A5F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 813","telop":"また、PCはデモが設定されているため、ご使用になられる際には、画面の案内に従い、初回設定をお願いします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第814スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"A42AE764-E24C-4A01-9155-10A7C8D7071E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 814","telop":"また、PCのバッテリーは満タン状態でお届けしているため、バッテリーを完全に消耗してからの充電をお願いします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第815スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"EA3C9C65-3913-40A2-A8A9-03EF8CCC1CD9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 815","telop":"また、PCからの光は人の眠りを妨げる性質がございます。そのため、就寝30分前には電源をお切りになることを推奨します。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第816スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"6E7DDFD8-6812-468B-98E1-484451FCD6E4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 816","telop":"また、もしお子様がPCをご利用になられる場合、政府の指示によりフィルタリングの設定が必要です。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第817スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"B4F5689A-1F55-428B-B727-DCF6B47F9C9B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 817","telop":"こちらの詳細は、親機内に説明書を格納しておりますのでご確認ください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第818スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"8DBA70FB-FE4F-45DA-857A-7C330C1951C2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 818","telop":"また、PCとポケベルはとても精密な機械です。そのため水分を含むものからは遠ざけ、機械にかからないようにご配慮ください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第819スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"ED5F10BF-9CAB-4ED0-A394-729E3AB10C3B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 819","telop":"また、浴室内での機械のご利用は絶対におやめください。\n故障の原因となります。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第820スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"A5F0B9C9-27DA-44BD-83E6-CD2C83D025A0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 820","telop":"また、これらの機械からは電波が出ております。そのため、ペースメーカーの方のご利用はお控えください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第821スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"B57802BF-6663-4EDC-A850-FFFF481191E9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 821","telop":"また、これらの機械の公共交通機関でのご利用は周りの方への十分な配慮とルールの厳守をお願いします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第822スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"mnc284076_レトロな雰囲気のリビングダイニング【フリー素材あそび】.jpg","id":"B13C5EA2-7B33-4180-ACE5-B38EF35DC028","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"title":"シーン 822","telop":"説明は以上です。私たちはポケベルとPCを活用したスマートなデジタルライフを全力で応援いたします、河城にとり、敬具」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第823スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"6D2931EF-42E1-486F-AE57-293E7C0E1D2E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 823","telop":"僕が、手紙を読み終えると、レミリアが質問してくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第824スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"A19D59B3-D7D7-4C80-8AF3-F70623913A7A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 824","telop":"「なんで私たちが特定供給世帯の対象になるのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第825スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"29ABF6BE-A291-49F7-87E3-0B17398496F0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 825","telop":"「その制度はどんなものなのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第826スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"EC4C53DD-F993-4F2E-B642-A16307BFB3EA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 826","telop":"「たしか、スマートフォンの利用と販売そして製造が法律で全面禁止されてから、施行された制度で内容は…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第827スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"A8836D78-9285-48BC-A8EB-4423BDDB9B33","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 827","telop":"「全国民からスマートフォンを没収した代わりに、低所得や非課税の世帯に政府がPCを貸し出しする制度…のはず…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第828スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"BBB55CDD-CCF6-40FA-A892-8A6CBFF2C96E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 828","telop":"「私の実家の収入だと制度は対象外のはず…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第829スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"0D94AACF-F334-4ADD-8D75-F85C169461B9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 829","telop":"「私が考える原因として、お嬢様は実家暮らしの時に貰っていた毎月50万円の小遣いがなくなったからじゃないですか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第830スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"37731438-7123-4AD1-BB9B-AD3DA66BC7B7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 830","telop":"「でも今は、その実家からこの生活の費用を捻出しているじゃない。だから、その制度の対象からは外れるはず…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第831スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"1D1190E9-9764-434C-B291-408D7CD21F40","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 831","telop":"「霊夢と魔理沙の収入はいくらでしたっけ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第832スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"385F3B82-FCA1-41E0-86CC-4DA14F3039FE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 832","telop":"「たしか、霊夢は正月のボーナス除けば、月に10万円ゲットできればいい方で、魔理沙は…月に数十万だったはず…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第833スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"EB1EA538-9294-4024-9215-3AAD066965A7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 833","telop":"「一つ疑問が浮かんだんですけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第834スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"958455BB-C220-4414-BFF1-97DD390F7699","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 834","telop":"「どうしたの、操夢？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第835スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"49682B84-839F-41F7-ACB4-63E6152AB934","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 835","telop":"「包括的婚約の制度は地方自治体主体で、PCが政府主体ならどちらも行政が主体だから、それが要因な気がするんですけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第836スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"82FD68FC-E3F8-4675-B6EC-56EC043B9685","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 836","telop":"「つまりは、行政での取り決めが要因と言いたいの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第837スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"C7520131-E4CD-4A24-9A3A-78E417C89928","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 837","telop":"「はい、多分何かしらの特例が、僕たちに適用されている可能性はないですか？たとえば、この世帯の収入は0円計上とか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第838スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"791D35E8-416F-4205-BDA6-11AF39BB68EF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 838","telop":"「それだと、私の実家の資金や、霊夢と魔理沙の収入の実質的な隠蔽を行政がしてるってこと？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第839スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"9899B253-0BBF-417D-A233-9821373BECD2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 839","telop":"「でも、それは虚偽の収入計上だから、犯罪じゃないの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第840スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"4B76CFA9-ED10-4C3A-8817-D187F177DCC7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 840","telop":"「もしそれが、本当ならあの河童に問題を報告しないといけないんじゃない？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第841スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"82B52985-AED5-4DD8-B0DE-EFA5CB4D5514","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 841","telop":"僕たちがそんな会話をしていると、誰かが上から降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第842スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"E674B008-70F8-4A30-92D2-0BE543B6CBA7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 842","telop":"「操夢、一緒にポッキー食べよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第843スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"EB4B1E9B-6FD3-4471-BD38-994A37519021","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 843","telop":"「私も、操夢と一緒にポッキー食べたい！」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第844スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"2E867D2A-976D-42EB-987E-2B99CD6FE061","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 844","telop":"「はぁ、まぁ、その問題は後から考えるとして、ポッキーでも食べながら、お茶飲んで休みましょう…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第845スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"69D347A6-0318-46F9-825A-AAEFA8204987","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 845","telop":"私はそこで、共同冷蔵庫が空だったことを思いだす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第846スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"0EFE010E-DA36-4260-BC23-E00BDA52EF8B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 846","telop":"「私の部屋に予備の紅茶あるか探してくるわ…」\n私はそういうと、自分の部屋に向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第847スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"CBAA1017-76EE-410D-A3A8-2E3BCC2E68A6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 847","telop":"僕は、レミリアが上に行くと、フランたちにもう少し待つように言い、僕はソファに腰掛け休む。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第848スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"31A7B942-A9F9-49E1-88B7-367273E1F412","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 848","telop":"そして、数分間、ボケーと座っていると、レミリアが降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第849スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"68CD82E6-8979-4162-89BA-4907199DFF66","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 849","telop":"「ほら、フラン、席につきなさい、今、紅茶出してあげるから。」\n私はそう言い、共同キッチンの収納から人数分のコップを取る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第850スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"FC2D1C15-3E8D-436B-BD3A-EEED2E433154","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 850","telop":"そして、全てのコップに紅茶を注ぎ、操夢とフランとこいしが座るローテーブルとそれ以外の３人が座るテーブルにコップを置く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第851スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"D4FC831E-E001-46EC-8CF5-6E8CFAF3548D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 851","telop":"私は、ゆっくりと空いている椅子に座ると、すでにテーブル上にポッキーの箱が置いてあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第852スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"FC4E91A4-A83F-46F1-BA9D-396D95795271","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 852","telop":"私は、その場の全員に視線を回してから、「いただきます。」と呟く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第853スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"82030CE0-B9F2-461D-98E2-069901A3EA0E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 853","telop":"私が、紅茶を一口飲んでからポッキーを入れると、意外にも味が馴染んでいて、思わず笑みが漏れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第854スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"6E358FFC-FA57-43C4-869C-A64432DD26EE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 854","telop":"「意外に紅茶とポッキーって合うのね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第855スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"321E2CDC-E16F-4BA6-A265-DC1C4F986052","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 855","telop":"「確かに、そうね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第856スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"05062C7D-4C6D-4AED-B22F-CD4106342591","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 856","telop":"僕たちがポッキーを食べ勧めていると隣に座るフランが僕の方を見ながらいう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第857スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"73702484-60C2-4546-B6F9-4DF16E7784F2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 857","telop":"「ねぇ、操夢、ポッキーゲームしようよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第858スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"1D3E2670-6080-4ECF-826D-F982254D97E8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 858","telop":"「ポッキーゲーム？」\n僕がそう返すと、咲夜が椅子から立ち上がり僕の方を見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第859スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"2CF9D41F-B685-452F-81C0-924B88BA47DD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 859","telop":"「フランお嬢様…、今日は誰の日か覚えているでしょうか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第860スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"B9EE9471-3D5E-4041-9550-405A8A2F2811","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 860","telop":"「覚えてるよ、咲夜。それが何かしたの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第861スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"898160E7-9D7F-41CE-B65A-DCB751BF1274","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 861","telop":"僕は、なんとなく嫌な予感がし、二人を手で制止する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第862スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"B84A368F-CC28-4D4E-B3D9-E6735C198A7B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 862","telop":"「ねぇ、操夢さん。今日の相手は私ですよね…？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第863スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"7AC4721F-000C-48C4-BB4E-B4A31D305790","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 863","telop":"「操夢…、咲夜と私のどっちとポッキーゲームしたい？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第864スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"CEDEB37C-0DDD-4972-9F25-F971D52F009E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 864","telop":"「フラン、ちょっとこっちに来なさい。\n咲夜、彼をフラン以上に満足させなさいよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第865スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"BB89A1CF-EDCC-497B-AF8B-3D67F43301FB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 865","telop":"私はそういうと、フランの手を強引に掴み、上に連行する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第866スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"D0AB77DA-A860-4CBB-ABA9-08C211572650","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 866","telop":"「どうします、操夢さん、ポッキーの未開封箱を持ってって部屋でしますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第867スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"FF40CF41-1C86-4C85-B425-375003A776D0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 867","telop":"僕は、しばらく考えた後、彼女に「そうしよう。」といい、未開封のポッキーの箱を持って、自分の部屋に向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第868スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"FB438341-37D1-4A02-8691-498AD4884AEE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 868","telop":"僕たちは部屋に入ると、彼女からポッキーゲームについて簡単に説明してもらい、早速1本目を口に入れ始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第869スライド","transitionName":"なし","characterName":"操夢","animationName":"移動","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"60991397-9052-409B-80E5-70F2E1F175A8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 869","telop":"僕たちは、少しづつ食べ進めていくと、だんだんと咲夜との距離が狭まっていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第870スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"C4E8EEE3-27D3-4C0A-84F2-44E387F5ED46","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 870","telop":"そして、僕たちはポッキーを食べ切り、キスをする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第871スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"5D0A0AA9-CB40-4A6F-A178-90E0C35B8D52","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 871","telop":"私たちは、元の位置に戻ると再びポッキーを食べ始める。\nだが、恥ずかしい気持ちは一切浮かばず、何度も口をつける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第872スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"697D3021-45E6-4293-A2A1-47D40F0ACA06","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（余裕）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 872","telop":"「これから、どうしますか？」私は気が付けば、ポッキーの箱が空になり、彼に向かって、そう声をかけていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第873スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"52E2433F-D083-492E-8102-3EBD5D570833","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 873","telop":"告知：ニコニコ動画でこの動画を投稿後、第7.5話を公開予定です。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第874スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"838EEB09-410A-4203-963B-DDCD5B6D2156","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 874","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第875スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"F2826510-F9B6-43D7-8289-F24C8DAAEC50","seStartTimeOffset":0,"title":"シーン 875","telop":"僕はふと目が覚めると、ベッドで寝ていた。そして横に振り向くと、そこには咲夜が寝汗でびしょびしょになっていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第876スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"9DE51A69-3BF2-40E3-8207-86431C7E2BC1","seStartTimeOffset":0,"title":"シーン 876","telop":"僕は、これはただ事では済まされないと感じ、彼女の額に手を当てる。すると、案の定、熱気を帯びていた…。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第877スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"ABBFC9E3-4DF9-4944-AD7C-7983B99EB323","seStartTimeOffset":0,"title":"シーン 877","telop":"僕は、彼女の涙と汗を拭うために、浴室からバスタオルを取り出すと、彼女の服に手をかけてゆっくりと優しく、拭き始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"4C8E329B-4EA1-44D5-B3D8-6127AC4BF4E9","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"8697049F-B69A-4F72-B9ED-D1077E8D90E2","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第880スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"75A1BE8A-1318-40FE-8DB5-739E3D2515B9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 880","telop":"私は、ある日をきっかけにバーで働き始めた。\nそれは突然のことだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第881スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"76EC90BF-07E5-40EB-9811-3566012C0D05","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 881","telop":"その日、いつものようにお嬢様に紅茶を出しに向かうと、お嬢様がぐったりとした様子で床に倒れていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第882スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E159C724-0C61-4377-B3EA-8E5ECEF30EEB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 882","telop":"私は、お嬢様の様子を一目にして、異常事態が起きたことを悟り、お嬢様に声をかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第883スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CD2F998B-B519-497C-8192-68CFA22274FA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 883","telop":"だが、お嬢様は私が声をかけても、反応せず、体を揺さぶっても反応がなく、心臓に手を当てる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第884スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"27EBBB50-E4B7-4FCC-9ED1-B6B179364FE2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 884","telop":"心臓に手を当てると、しっかりと鼓動していて、異常はなく、致命傷ではないのかと考えるが、念のために、体温計で熱を測る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第885スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C7EF0CC2-BC09-4477-83C3-DB6C3E6D3768","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 885","telop":"熱を測っても、お嬢様は平熱で、ただいつもと違うのはぐったりとした様子、ただそれだけだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第886スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F410630B-E876-43C2-B1FF-C1A122C83776","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 886","telop":"私は、次にどうすべきなのかを考え、ふとフランお嬢様の元へと向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第887スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4228AF2F-C214-43BD-8AAA-6428B9A7C510","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 887","telop":"すると、フランお嬢様もぐったりとしたご様子で、私は不安に包まれながら、声をかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第888スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4070EBFE-A9C9-426E-BDB4-09EE2CCE4F71","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 888","telop":"すると、フランお嬢様が寝言を言う。\n私はそこで、彼女の体を揺する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第889スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DA1E4BB0-F0AC-48FF-AADF-2301258E85A1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 889","telop":"そして、私がフランお嬢様を揺らすと、彼女は目が覚め、ゆっくりと起き上がる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第890スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CA8A273C-2F87-4439-9E57-AA5CFEE2662E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 890","telop":"すると、彼女は、驚きの表情を浮かべ、部屋から勢いよく飛び出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第891スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"283ABD27-60E5-443D-84BA-04AFEF749FE6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 891","telop":"私がフランお嬢様の後を追い、お嬢様の部屋に入ると、彼女は陰りを見せながら、フランお嬢様と会話をしていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第892スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D95BD9E-FAAD-456E-9530-EA9F7544E67E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 892","telop":"そして私は、お嬢様たちから私がある血液を食事として提供し、それを飲んだ結果、姉妹で争いが起き、気絶したと告げる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第893スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"51C997D0-6D3A-424A-855D-2B996866F112","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 893","telop":"私は、それを聞くと、その時間帯は買い物に行ってましたと告げる。だが、お嬢様が言うには、確かに私から受け取ったと言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第894スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"31CD268E-B6DC-4364-8B52-FA2BE6CB2946","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 894","telop":"すると、フランお嬢様が、私の姿を見たけど、容姿を見た時に違和感をちょっぴりと感じたと言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第895スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"37E31FA9-D6EB-49CD-8E21-B6380E948C84","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 895","telop":"私がお嬢様に真意を尋ねると、確かにほんのわずかに容姿が異なっていたかもと呟く。すると、美鈴がかけてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第896スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F6000637-00AF-4683-8144-19A628BE1E8C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 896","telop":"すると美鈴は、衝撃の一言を告げる。私は、その内容を信じきれず、何もできずにただ茫然としていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第897スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"19214EAE-24E4-4479-8099-2AA556E2A975","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 897","telop":"そして、私は気がつけば、バーで働き出して、多くの男性と酒と体の付き合いをする羽目になり、そのお金を…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第898スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","id":"16CFBE90-D338-495A-AD9B-862B2BF5C7EE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/寝室の窓際のベッド（夕方・青）.jpg","title":"シーン 898","telop":"僕は、ふと目が覚めると、隣を向く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第899スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","id":"FCEB3870-58D1-41A1-98A8-CDF3793DADAA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/寝室の窓際のベッド（夕方・青）.jpg","title":"シーン 899","telop":"そこには、涙を流し、汗ばむ彼女の姿があった。\n僕は、尋常じゃないと感じ、おでこに手を当てる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第900スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","id":"CEDDE03F-4800-4042-B6DD-B327DAB0C06C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/寝室の窓際のベッド（夕方・青）.jpg","title":"シーン 900","telop":"すると、案の定、彼女は発熱をしており、全身が寝汗でびちょびちょの状態だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第901スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"3A909333-B984-4C3F-95E3-BEEEBC0C45D5","seStartTimeOffset":0,"title":"シーン 901","telop":"僕は、彼女を起こさないようにそっとベッドから降りると、どうするべきか考える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第902スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"13BBE17E-03C4-4F96-9B46-317A88B004CD","seStartTimeOffset":0,"title":"シーン 902","telop":"そして、あることを思い出し、廊下に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第903スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E2DA083C-76BF-4D47-9BF5-B52716451711","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 903","telop":"僕は廊下に入ると、箪笥からバスタオルを取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第904スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","id":"F7474DB5-4CFF-441B-ABC6-D62DD0948F94","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/寝室の窓際のベッド（夕方・青）.jpg","title":"シーン 904","telop":"そして、ベッドに戻ると、咲夜の汗と涙を優しく拭き始める。\nだが、それだけでは、次々に出てくる涙と汗は取れない。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第905スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"寝室の窓際のベッド（夕方・青）.jpg","id":"F2851991-F23D-4B41-B4A9-531ECFF26288","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/寝室の窓際のベッド（夕方・青）.jpg","title":"シーン 905","telop":"僕は、そこで、彼女を起こさぬようにそっと抱き抱えると、\n浴室に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第906スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D0EE4F31-208D-4FBE-B1EF-4D8B9A99132B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 906","telop":"僕は、彼女の服を全て脱がすと、自分の服を着たまま、そっと空っぽの浴槽に入れて、ぬるま湯で洗い流す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第907スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"83387435-CC6A-4C55-9551-B7113ABAC07A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 907","telop":"一通り、流し終えると、僕は、自分の服が水でびちゃびちゃになるのを覚悟でそのまま彼女を抱き抱える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第908スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"5D22A319-197F-4969-9BAD-358CD056C7DB","seStartTimeOffset":0,"title":"シーン 908","telop":"そして、びちゃびちゃになった彼女をそのままベッドに乗せて、布団を上からかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第909スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"28F21B3B-5F77-454C-85EB-69AD7A2BBCFC","seStartTimeOffset":0,"title":"シーン 909","telop":"僕は、一通りの手順を終えると、再び浴室に向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第910スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"A429C7A7-EC60-4F04-B8CB-6D526AC0C71E","seStartTimeOffset":0,"title":"シーン 910","telop":"「んっ…」\n私はふと目が覚めると、強い違和感を感じる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第911スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"6F33DE52-E22A-4D9A-AA05-9BCA043D3C62","seStartTimeOffset":0,"title":"シーン 911","telop":"ふと、布団を上に上げ、自分自身を見ると、素っ裸だった。\nそのまま布団を再び羽織る。「何が起きたんですか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第912スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"28B3D8E4-3FC3-42D0-9210-BB27DC264FB0","seStartTimeOffset":0,"title":"シーン 912","telop":"私は、そして、布団が湿っていることに気づき、どうするべきか考えると先ほど見た夢のことを思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第913スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"F6736E61-3521-4B02-B1EB-C19BC570CDC0","seStartTimeOffset":0,"title":"シーン 913","telop":"私は、先ほど見た夢が、過去の封印したはずの記憶であり、\nなぜ今思い出したのかが分からなかった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第914スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"1DC8DF90-BB8E-484B-83D4-6AA647F85338","seStartTimeOffset":0,"title":"シーン 914","telop":"そして、現に昼頃までは先ほどの夢見た過去の記憶は、封印され、頭の奥底に眠っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第915スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"9C277FB1-7217-4484-87AE-8A2357589709","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 915","telop":"「あっ、咲夜さん、目が覚めたんですね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第916スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"37D51546-7A28-422F-9B6A-B1DA75AFC06C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 916","telop":"「あの、私の服はどこでしょう？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第917スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"6A720F65-E30B-4801-9F7E-87DA07001C55","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 917","telop":"僕は、そこでハッとし、彼女の服を探す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第918スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B01D75FF-DFB3-4272-A974-49F619027960","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 918","telop":"僕は、廊下に再び入ると、彼女のビチョビチョの服を洗濯機にかけたことを思い出す。そして、洗濯機に表示された時間を見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第919スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"D28AA307-E458-4D8A-AB8F-21EF754C485F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 919","telop":"「今、咲夜さんの服は洗濯中です。数十分で洗いは終わりますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第920スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"9F17201A-1D4A-4325-9585-6C4B4A4ED981","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 920","telop":"「えっ？」\n私は、彼の発言に思わず、そう呟く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第921スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"0EE8227A-D41C-48B7-9237-FC08E3FF69AA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 921","telop":"「あの、私はそれまでどうすればいいのですか？」\n私は、そう彼に尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第922スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"F66AE755-EB4A-4EE1-AA06-653B4826D652","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 922","telop":"「今から、暖房をつけるので、布団にくるまって待っててください。」\n僕がそういうと、インターホンが鳴る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第923スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc254861_マンションの外廊下（夕方）.jpg","id":"873A05A9-2EAB-462F-A7A6-2C3A22728D39","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 923","telop":"僕が外に出ると、そこには魔理沙がいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第924スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc254861_マンションの外廊下（夕方）.jpg","id":"6A30C32F-0A7F-49E7-9988-04EB2058BBCF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 924","telop":"「よう、操夢、さっき、レミリアたちと夜ご飯食べに出かけようって言ってたんだが、お前もくるか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第925スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc254861_マンションの外廊下（夕方）.jpg","id":"D2CAC80A-00E1-4D98-813E-DE9A9B074BC4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 925","telop":"「いいですよ、咲夜さんはお休み中なので。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第926スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc254861_マンションの外廊下（夕方）.jpg","id":"9E5A3D59-AFB7-4827-B260-D9D141EB192C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 926","telop":"「お休み中って、もしかして、咲夜とシたのか？」\n私は、顔が頬照りながらそう聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第927スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc254861_マンションの外廊下（夕方）.jpg","id":"1A531A98-5A3A-494D-AE5E-4A546666C35C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 927","telop":"「えっ？なんのことですか？」\n僕はそう問い返す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第928スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc254861_マンションの外廊下（夕方）.jpg","id":"70F715B4-7373-4D8D-A0D3-2902BED7B9E5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（困る）.png","seStartTimeOffset":0,"title":"シーン 928","telop":"「はぁ、まぁ、いっか。とりあえず、準備できたら下に来てくれ。」\n私はそう彼に告げると、下に降りていった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第929スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夕方）.jpg","id":"8CAADDE2-EA28-4DDD-90C4-A10E764F9FD6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 929","telop":"僕は、先ほどの魔理沙との会話を咲夜に話す。\nそして、そのまま外の廊下に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第930スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D709030E-DC4D-41EC-8AAA-696A46CA2D94","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 930","telop":"僕は、廊下に入ると、さっと準備を済ませる。\nそして、洗濯機を一度確かめてから、玄関を開けた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第931スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"91EBBB6E-AF81-4BCD-9D06-2A599ABD08A3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","seStartTimeOffset":0,"title":"シーン 931","telop":"僕が一人で降りてくると、皆が驚いた表情をする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第932スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"78C0E94E-392B-4928-B88A-B25BFB74357D","seStartTimeOffset":0,"title":"シーン 932","telop":"「なんであんたは、咲夜を一人にして降りてこれるのよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第933スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"E00DBCB1-82A7-47A9-9878-4392BF84EBF6","seStartTimeOffset":0,"title":"シーン 933","telop":"「それは、魔理沙さんが…」\n僕はそう言いながら、魔理沙の方を見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第934スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","id":"8A7DBF76-00B3-4654-91FF-981BB972E558","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 934","telop":"「お前がまさか、下に降りてくるなんて思わなかったのだぜ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第935スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","id":"4C6B579D-DFBE-4EB0-BE4B-C7C458B9C4B3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 935","telop":"「えっと…」\n僕は、魔理沙のその発言に困ってしまう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第936スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"552F4E37-748F-4C64-8FBD-9D23C8A60A29","seStartTimeOffset":0,"title":"シーン 936","telop":"「まぁ、いいわ。お腹がすいたから出かけましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第937スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（夕方）.jpeg","id":"56CE99EF-F71A-49AE-ABAD-B764EA8CF6ED","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 937","telop":"「流石にそこまでいったら、仕方がないですね…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第938スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc245463_マンション（夕方）.jpg","id":"DB0FB4E1-BFEC-4881-998D-B80822DB1938","seStartTimeOffset":0,"title":"シーン 938","telop":"僕たちはそれから、レミリアが事前にお願いして、彼女の実家から出した車に乗って、ご飯を食べに皆で出かけるのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第939スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8E3113B3-30FA-4DCC-9E2A-569E7594DA7F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 939","telop":"その頃、咲夜は…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第940スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"F174267C-45D8-40F4-937B-8E49E22A1782","seStartTimeOffset":0,"title":"シーン 940","telop":"私は、ふと外から車の音がして、窓を覗くと、そこには、紅魔館の車にお嬢様たちが乗り込み、発進していくところだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第941スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"53816F0B-8390-41C5-906B-0CCE00E9F5AD","seStartTimeOffset":0,"title":"シーン 941","telop":"そこで、私はただ一人、置いてきぼりにされたことに気づく。\nだが、おでこに手を当てると、熱があることに気がつく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第942スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夕方）.jpg","id":"AD6AF050-40F9-4C1D-9DF9-CE98FA19DBF5","seStartTimeOffset":0,"title":"シーン 942","telop":"私は、仕方がなく、そのままベッドにくるまっていると、だんだんと眠たくなっていき、瞼を閉じる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第943スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夜・照明ON）.jpg","id":"F766D687-1E5B-4318-96BA-E28A0527526C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","title":"シーン 943","telop":"私がハッと瞼を開くと、羽織っている布団がジメジメしていることに気がつき、中を覗く。すると、案の定、〇〇が飛び出てた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第944スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夜・照明ON）.jpg","id":"6D4420C6-B2EC-4828-94E7-5D05C7DE3BBD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","title":"シーン 944","telop":"私は、それを見ると、とてつもない恥ずかしさに襲われ、その衝動でベッドから飛び出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第945スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夜・照明ON）.jpg","id":"51334FFC-7F28-4855-A37A-4E9984CF2AB1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","title":"シーン 945","telop":"私は、生身なのを確認すると、そのまま廊下へと向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第946スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DC518059-9C65-4B1F-B957-EC8DE6C24379","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 946","telop":"私は、廊下の電気をつけると、洗濯機の蓋を開ける。\nすると、そこには乾き切った私の服があり、早速着る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第947スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（弱る）.png","id":"BB23B7C1-AE60-4005-A948-485C292B1C6E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 947","telop":"私は、「ふぅ」とため息をつくと、お腹がすいてきて、共同スペースへと向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第948スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"CB5A3C75-9A63-4745-89DB-22925751D726","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 948","telop":"私が下に降りてくると、ソファーで彼が寝ていることに気がつき、驚く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第949スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"A783D8D7-4CDD-47EE-AAAA-35FD5D93A7D9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 949","telop":"私は、彼をどうするべきか、考える。\n「このままだと、確実に風邪を引くだろうし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第950スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"AAAA5099-0000-467B-A05A-A4B87E8D61EC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 950","telop":"すると、彼が寝言を言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第951スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"D587C259-F154-4D3B-AFE8-BF9077FE8F4B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 951","telop":"私はその寝言に驚く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第952スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"8136674A-D8CA-4312-92FD-6A6F0CF7DAE6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 952","telop":"「どうしようかしら…、彼のベッドは、あの有様だし、私の部屋に運び入れるのも何か違うし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第953スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（驚く）.png","id":"17016229-1C3E-4A6D-A444-630B876BFE61","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 953","telop":"すると、彼がふと目を擦り、起き上がる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第954スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（驚く）.png","id":"5D99236D-0949-4697-8B0C-444EF320D8DD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 954","telop":"「んっ？どうしたんですか、咲夜さん…、こんな時間に…」\nすると僕は、全身が軋む感覚がする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第955スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（驚く）.png","id":"67648B2F-9B71-4116-B1EF-306C633B79D9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 955","telop":"「いててぇ…」僕はそう言いながら、ゆっくりとソファから降り、自分の部屋に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第956スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"37E556FC-2003-471D-97F6-55448E1A27BA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 956","telop":"「操夢さん、今、あなたのベッドはびしょびしょで私の〇〇までついてるんですが、そのベッドで寝るんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第957スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（驚く）.png","id":"137490B9-A92A-4357-BDC8-FF48E096BB39","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 957","telop":"「それなら…僕も裸になって寝て…〇〇をつければいいじゃないですか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第958スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"10E7D882-B91C-44B8-8510-5B9C7219E10A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 958","telop":"私は、彼がそう言いながら、ふらふらと歩き出すのに不安を感じ、そっと肩をかすと、仕方がなく、彼の部屋に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第959スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夜・照明OFF）.jpg","id":"F9C428D3-C4EE-4FEB-9C24-ED54D5B33E43","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"title":"シーン 959","telop":"私は、彼とともに、再び彼の部屋に入ると、今にもふっと倒れそうな彼をそっとベッドに乗せ、掛け布団をかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第960スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（夜・照明OFF）.jpg","id":"10B1316C-7ED9-4DB0-A573-ED090E25D858","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","seStartTimeOffset":0,"title":"シーン 960","telop":"「なんだか、暑い…」僕はそう呟きながら、\n布団をどかし、服を脱ぎ捨てて掛け布団を羽織る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第961スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夜・照明OFF）.jpg","id":"76D09A18-045B-49F4-A71B-AA4DE1B4224B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","seStartTimeOffset":0,"title":"シーン 961","telop":"私は、彼が異性の前であたかも当然かのように全裸になって、布団を羽織ることに驚く。そして、同時に暖房を消す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第962スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（夜・照明OFF）.jpg","id":"03C2BFEC-BAAC-4A4F-8564-3633A92F7556","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"title":"シーン 962","telop":"「風邪ひいても、知りませんからね…」\n私はそう言いながら、そのまま自分の部屋に戻った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第963スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"82D4639D-4506-4B54-8297-C51886C5DBDF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 963","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第964スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"0E014CC6-0748-48DC-957A-60D0537081C6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 964","telop":"僕は、ふと目が覚めると、朝を迎えていた。そして、違和感を感じ、全身を見ると素っ裸で驚き、布団を蹴っぽりだす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第965スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"CD325DF9-353E-4B35-89A3-03703F99E6AC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 965","telop":"僕は、昨晩のことを服を着てから必死に思い出す。そして、昨日の咲夜とのやりとりを思い出す。だが、何かが欠けていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第966スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"66AEE9AF-60CF-4F56-B583-4355ABB186D9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 966","telop":"僕は、頭を振り、ぐーんと背伸びをすると、あくびをしながら、ベッドから降りて、シャワーを浴びに浴室に向かうのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"B221D563-6676-4DF0-9B11-CAB6F7C4F6F0","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"A1FC5B14-514D-44F1-A15D-1B9963854F3A","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第969スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D0D48B4-411F-4026-A0A8-D40D638C18B2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 969","telop":"僕は、ふと目が覚めると、朝日が窓から差し込んでいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第970スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8B782667-C756-409C-9A89-CE318AD4247C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 970","telop":"僕は、何となく布団に違和感を感じ、中を見ると、なぜか裸で眠っていた…、そしてくしゃみが出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第971スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"561017C2-BBA4-4A13-A77F-CED2C0A32FC2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 971","telop":"僕は、服を着るため、ベッドを蹴っぽると、背伸びをして、あくびをする。そして、昨晩のことを考える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第972スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A7A239F6-85BB-4F80-819C-9D9847E39E02","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 972","telop":"僕は、昨晩のことを考えるが、くしゃみと頭痛でまともではないと感じ、ベッドから降りる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第973スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"688E9631-0B43-4908-AEB1-BE3A8891DBBD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 973","telop":"僕は、ベッドから降りると、脱ぎ捨てられていた服を手に取り、その足取りでそのまま廊下に出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第974スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"57756379-DF9E-44DB-9C79-F6E9017B97AB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 974","telop":"僕は、廊下に出ると、浴室に入り、未洗濯の衣類を持つと、まとめて洗濯機に入れて、スイッチを入れて、浴室に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第975スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"11C76412-9EA4-4AAB-8229-D91E46D33F1D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 975","telop":"僕は、浴室から出ると、箪笥から新たな服を取り出し、それを着て、次にすることを部屋で考えた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第976スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"1DD638A2-FF7E-4E55-9C3E-D047F6838AF7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 976","telop":"僕はふと、ベッドから掛け布団を取り出す。すると、何かで濡れたのか、湿っているとこを発見し、浴室に持って行く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第977スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A35DEAA9-48CD-48BF-B90A-2758E6ED4243","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 977","telop":"僕は、浴室に入ると、布団を浴槽に入れ、浴槽に水を入れ始める。そして、浴室を一通り見渡してから、部屋に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第978スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"4F632138-3EBD-4348-A661-8AC81C3A878B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 978","telop":"僕は、浴室から戻ると、再び思考を捗らせようとする。だが、くしゃみと頭痛が邪魔して、困り果てる…「どうしよう…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第979スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"7B3DCC2C-E45F-4FAE-A4CC-6942551D1CC2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 979","telop":"僕は、ふとおでこに手を当てると、いつもより暖かく感じ、部屋の収納から体温計を取り出し測ると、案の定、熱が出てた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第980スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"1C76C9BF-7B46-417C-AB70-18A6CC4B3CA1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 980","telop":"僕は、体温計を元の場所に戻し、廊下に出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第981スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8149E5CE-E00A-440B-9BCD-0E5481115465","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 981","telop":"僕は、廊下に入ると、冷蔵庫を開ける。中には、冷凍ご飯と卵が数個入っていた。僕は、それで卵かけご飯を作り、部屋に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第982スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"B7A6227A-3C59-4784-BEA1-DBF91B6FD6D1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 982","telop":"僕は、卵かけご飯を食べ、食べ終えた皿を洗い終えて、部屋でぼんやりとしていると、だんだんと意識がぼやけ、眠りに落ちた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第983スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"5744711C-B32C-474D-BF90-768DF403FDA9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 983","telop":"私は、目が覚め、ふとお嬢様たちの部屋を順に巡ると、皆、寝込んでいるようだった。そこで、私は彼のインターホンを鳴らす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第984スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"52F52FAD-AD17-4060-B6CB-F1136BC04390","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 984","telop":"だが、応答はなく、ドアノブを捻ると、なぜか、施錠されておらず、開きっぱなしだった。「入りますよ、操夢さん。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第985スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"5A73BB97-9A17-4AC3-A873-B0ED30F4B2F5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 985","telop":"私は、彼の部屋に入ると、彼が、床で倒れている状態だった。\n私は、彼の身体を揺らし、反応を確かめる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第986スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"7A648541-FCBD-441F-A47C-EF48C85ED974","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 986","telop":"「ん…」\n僕は、誰かに身体をゆすられ、瞼をこすりながら、起きる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第987スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"B0018C4A-6D09-4D87-B029-7A306B65D265","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 987","telop":"「操夢さん…こんなとこで寝たら、体調崩しますよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第988スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"C7C56C0B-1C42-4E17-968A-ABA91CE096F2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 988","telop":"「体調…」\n僕は、そこでハッとし、上半身を起こす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第989スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"1AE843F6-6F15-4E58-8E94-BDCF007B6513","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 989","telop":"「咲夜さん…どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第990スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"893EA69F-A261-4232-B927-86C02F179F4A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 990","telop":"「操夢さんこそ、どうしたんですか？」\n私は、そう言いがら、ふと彼の額に手を当てる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第991スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"47D5DA20-BF35-4EA0-991B-08049A0614DC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 991","telop":"「操夢さん、風邪引いたんですか？」\n私は、彼の額が熱いことに驚き、そう問いかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第992スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"F533908E-A897-4F12-8ABC-A0955FD4899A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 992","telop":"「はい…、あと頭痛がして…」僕は、そう言いながら、ふとハッとし、立ち上がると浴室に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第993スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"43EC114D-A2C8-4ADA-BE26-AB0AF6FF625C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 993","telop":"僕が浴室に入ると、案の定、水が出しっぱで、浴槽に結構溜まっていた。僕は、蛇口を素早く閉める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第994スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"84F45BBE-4185-4A6B-9AA8-3417CB3D2B95","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 994","telop":"そして浴槽に手を入れると、案の定そこにはお湯が溜まっていて、僕が、水ではなく、お湯を入れてしまったことに気づく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第995スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0D88E9ED-356D-4A68-A0BE-5528DC937901","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 995","telop":"僕は、浴槽の栓を抜き、浴室乾燥をオンにすると、部屋に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第996スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"DBA48736-A5FD-4E61-B746-AC113662A832","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 996","telop":"「どうしたんですか、急に慌てて廊下に出て…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第997スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"E980E50E-B89B-46E1-B29B-5B37F47E9292","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 997","telop":"「浴槽に水を入れて、布団を洗おうと思っていたら、お湯が入っていました…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第998スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"7538FF23-6166-40ED-A958-04AF30A43410","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 998","telop":"「えっ？」私は、彼の発言に思わずそう返す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第999スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"CC10C1A1-EDF8-43A4-830B-63C8AF5EDA97","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 999","telop":"「操夢さん、布団は普通、洗濯機で洗うんですよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1000スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"3DC3474B-9CBE-46B9-9495-1BDF51857B11","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1000","telop":"「洗濯機には、昨日着てた服で満杯なんです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1001スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"78CBFD1E-A790-4D4E-8B5E-21451DAE1D31","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1001","telop":"「そうですか…」\n私は、そう言いながら、次の言葉を考え、あることを尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1002スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"1E5AC1FF-47D9-480D-9286-357A9B0A6847","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1002","telop":"「そういえば、操夢さんとお嬢様たちは昨晩はどこで外食したんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1003スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"739D4219-4A5B-47E0-A62D-1830C167B1F4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1003","telop":"「たしか、魔理沙さんが、『お化けが多額の現金くれたんだぜ』って皆に話すと、霊夢さんが、『じゃあ、外食しよう』って…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1004スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"75FB2D49-C755-4F8A-A335-D7A7290C9B30","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1004","telop":"「その経緯はわかりました…、それでどこで食べたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1005スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"60B1E0B7-2485-4EC5-851F-7E45846477D7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1005","telop":"「えっと…」\n僕はそう言うと、昨日のことを思い出しながら話す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1006スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"3EE56072-F252-4A41-8321-194B6969160B","seStartTimeOffset":0,"title":"シーン 1006","telop":"「それで、どこでご飯を食べるんですか？」\n僕たちは、２つの車に分かれて、隣にいる魔理沙に聞く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1007スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"5EBB2658-F32E-4FDB-9158-92B075DC17E6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 1007","telop":"「それなら、お化けを乗せる前の行きの道中に良さげな店を見つけたのだぜ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1008スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"40BE9315-6506-4F5F-A780-8963E52869C0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 1008","telop":"「それは、どこのお店ですか？」\n僕はそう彼女に聞き返す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1009スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"F19E8AEC-6BD0-46F4-9E49-5CF340B3E88E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 1009","telop":"「それは、ついてからのお楽しみだぜ。」\n私は、そう言いながら、運転をしているこいしに道順を教える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1010スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"367A8B73-FD32-44E5-A1B4-A352D634C6A1","seStartTimeOffset":0,"title":"シーン 1010","telop":"「ねぇ、魔理沙、首都高に乗るって本当なの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1011スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"5C22E18D-958F-4E85-80A6-0A69EBBA1407","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 1011","telop":"「そうだぜ…」\n私はそこでハッとし、荷物を探る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1012スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"CC245BFE-8EE9-4214-80EE-208FED704541","seStartTimeOffset":0,"title":"シーン 1012","telop":"「魔理沙、ETCカードなら既に差し込んでるよ。」\n私はそう言いながら、車載器を指差す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1013スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"C6714EC6-2112-4089-9FEA-7DC996A38584","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"title":"シーン 1013","telop":"「ありがとうなのだぜ、フラン。」\n私は、ほっと一息をつくと、車が首都高に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1014スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"F022930F-C04C-4D78-A16F-6FC1FE1D2719","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1014","telop":"「それで、どこで降りればいいの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1015スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"3C6A2CA7-0D92-4515-B133-836268B79A52","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1015","telop":"「えっと、たしか…人形の街をこえて…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1016スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"83CF9F78-5DDC-4975-B0AB-98289431C263","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1016","telop":"「もしかして、東北道沿いですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1017スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"7C78FCB2-4B3D-4E32-A027-891386195023","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1017","telop":"「それで…映画館がある自称日本最大級…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1018スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"CEFB31D6-6809-414E-B03B-FD76B338A6C1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1018","telop":"「久喜駅ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1019スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"561ABC64-EAA0-4A9D-A5D8-0BC3891A00A4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 1019","telop":"「そうだ、久喜だぜ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1020スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"6C233EF8-A556-4C97-B7D7-A590BF03D0D0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"title":"シーン 1020","telop":"「それだったら、このまま首都高で北上して、圏央道からの方がアクセスいいですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1021スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"13F521AF-F668-446E-BFB8-27594833D5AA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1021","telop":"「そう、じゃあ、トンネルは入らないね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1022スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"7390A51E-ACEE-43FF-8F50-C866E1A2D1AC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1022","telop":"「ねぇ、何で操夢が、そんなこと知ってるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1023スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"E3B06484-AEE9-448D-BFB1-1163B4626B88","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1023","telop":"「それは、魔理沙さんが言ってたショッピングモールの近くで1日だけ働いたことがあるからです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1024スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"C79F415C-A256-458D-A5BE-ADFEDA446357","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1024","telop":"「1日だけ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1025スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"608CD48B-44E2-42E2-887A-3224DD9AD464","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1025","telop":"「そうです、僕は、高校卒業の時期にようやく受かったアルバイトを10日間程度してたんですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1026スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"3C41C776-C7D4-4780-B533-952BD45E8BAE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1026","telop":"「それで、給料は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1027スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"37979836-C346-491E-AAAB-BE8D1B877E7B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1027","telop":"「1日働けば、1万円という週払いの仕事です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1028スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"A3EB56B5-D69F-4056-81F1-B06BE53CFE93","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1028","telop":"「へぇ、それで、どんな仕事なの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1029スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"387BADA0-D8ED-4469-A1F9-5F609BB716F4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1029","telop":"「雑用と清掃ですよっといっても、他者と比較すると劣ってますが…、それでもやりがいのある仕事でした…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1030スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"0874BA2C-C572-452B-88B1-EC84BC40A024","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1030","telop":"「へぇ…、それで何でやめたの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1031スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"9749B375-8F19-423D-853F-08C726468A8D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1031","telop":"「両親がそんな仕事は続けるなって言い出して、就職先に困り果ててた僕を強制的に工場で働かせたからです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1032スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"BC55C2D5-32A1-4D12-839C-F3C1880F31F3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1032","telop":"「へぇ、そう…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1033スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"A367F0EC-DD62-47DD-A17F-0C9A8ADFBE90","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1033","telop":"「それで、魔理沙さんは、そのお化けはいくらでしたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1034スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"14AB4DF9-C8A7-42E8-A928-58DF13F25880","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1034","telop":"「確か、北海道の稚内から沖縄の西表島までで…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1035スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"2649DD2C-CBB8-4B0A-B543-1EEE821B3CE5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"title":"シーン 1035","telop":"「それ、本当なの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1036スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"CF364110-1EB6-4AB5-9C07-2632FD616AF3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1036","telop":"「そうだぜ…それで距離は…覚えてないが、お客さんの希望で飛行機にくっついて移動して、10時間くらいだったから…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1037スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"8E3C87D1-24F4-4F00-877C-96113E6B450D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1037","telop":"「それって、正気なんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1038スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"9E72DD0D-09D3-415A-BE12-B04EE6A0B0F8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1038","telop":"「そうだぜ…それで代金は…たしか、栄一の束を100セット分スーツケースで受け取ったぜ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1039スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"6B4B0254-2409-4003-8FAA-7FF6A9ECC1E2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1039","telop":"「そのお金は、どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1040スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"9B8BBEE4-472C-4913-A662-82B410080ADA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1040","telop":"「お化けさんは西表で別れたから、偶然あった西表と羽田の直行便の片道分と、バスで3万円くらい使ったっけ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1041スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"A030EFFF-9876-4400-8260-4669EE71962D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1041","telop":"「それで、そのお金は、霊夢に知らせたら、共同口座は使うなって言ったから、レミリアと帰り道に電話して、彼女の口座に…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1042スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"4FBF96CD-BA5A-4137-BADB-E91925CAA7A6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1042","telop":"「それで…、今の手持ち分は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1043スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"F6CA3747-BB55-4EA1-9C71-10E91CD561EE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1043","telop":"「たしか、栄一１０枚だったはず…」\n私はそう言いながら、財布を確かめる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1044スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"E351D4A1-91C5-482F-8244-406F4C0D0665","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"title":"シーン 1044","telop":"「10万円…だぜ。」\n私がそういうと、皆が静まり返る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1045スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"B9134A84-D79D-47BE-984C-877DB1FA4E86","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1045","telop":"私は、彼の話を聞き呆れ果てる。\n「はぁ、それで結局、どこで食べたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1046スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"83460AA2-9E12-4C69-B3BE-E0B100E52201","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1046","telop":"「魔理沙さんが狙っていたお店は、休業日で、結果的にそのショッピングモールのフードコードで1人1万円で食べました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1047スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"030A0D33-8572-4160-B2FB-7AD03EA50086","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1047","telop":"「それで、余った手持ちのお金は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1048スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"83B15122-353B-42F1-B2B8-4F1FF53EE2D1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1048","telop":"僕は、彼女の問いにどう答えるかを考える…。\nだが、フードコートの後から思い出せない…。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1049スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"525FC08B-15A5-4E2F-9B06-B2C40E27B465","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1049","telop":"だが、あることを思い出す。\n「そういえば、パチュリーさんは起きてますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1050スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"D9A375F5-7696-4C8B-8B9B-53B53A871FD2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1050","telop":"「パチュリー様ですか…、たしか一人共同スペースで読書していたはずですが…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1051スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"一人部屋３（日中）.jpg","id":"E41A158C-C924-406A-8DD7-589675F8890B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1051","telop":"私はそこでハッとし、共同スペースへと向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1052スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"C7C0060C-6455-4E92-828A-E09CE85EA683","seStartTimeOffset":0,"title":"シーン 1052","telop":"「あら、どうしたの、咲夜？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1053スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"B8376F89-8BD3-4C5A-8718-C60A44F5A84C","seStartTimeOffset":0,"title":"シーン 1053","telop":"「今、彼から昨晩の話を聞きまして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1054スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"48F7AECD-C88A-4EDA-9B2D-BED21C12E0B5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1054","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1055スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"E4BD2E18-92C5-4768-89F9-C8298024E1BB","seStartTimeOffset":0,"title":"シーン 1055","telop":"私は、パチュリー様から道中でのお嬢様たちの車内での様子と会話を聞く。すると、衝撃を受ける事実が告げられる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1056スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"0E03B321-20CD-46D9-9FCA-1B9A77061470","seStartTimeOffset":0,"title":"シーン 1056","telop":"そして、お嬢様たちがフードコートを出た後、実は新幹線が通る県内随一の駅での、とある行動により彼女と彼が犠牲になって…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1057スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2A8B7D59-1FFB-4FE1-A793-A770FFF864A2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1057","telop":"私は、パチュリーから知らされたそれにとてつもない怒りが湧き起こり、その感情のままにお嬢様たちの部屋にノックすると…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"単色背景","id":"0424FB99-FC44-4052-94C6-A88B7B9F23F7","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1059スライド","transitionName":"なし","characterName":"レミリア・スカーレット","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"42239DD5-067B-4F17-8E48-CE8E78934406","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1059","telop":"東方Project二次創作 powerd by zuyasi\n交換夫婦\n8人の女性と1人の男〜200スライドでお届けするレミリアたちの車内会話と過去の事件と二次会と逆鱗に触れた咲夜、そして渦巻く男とにとりのお話〜\n※9話と10話の動画は回想中心でお届けします。\n告知もあるよ！","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1060スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"0BE7C8CD-2342-43D4-AA46-D95D1BE94B2D","seStartTimeOffset":0,"title":"シーン 1060","telop":"「それで、何か聞きたいことでもあるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1061スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"CCDDC8C6-00FD-4334-9BC9-938F3FB98D9E","seStartTimeOffset":0,"title":"シーン 1061","telop":"「彼から、彼が乗った車での会話と夕食をフードコートで食べたところまでは聞けたのですが、その先を覚えてない様子で…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1062スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"CF724F71-CA8B-4D03-B531-29B0DCE65E05","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1062","telop":"私は、咲夜が何を聞きたいのかを察し、ため息をつく。\n「じゃあ、これから話すから、しっかりと頭に入れなさいね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1063スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"7C9A943A-8B49-4929-8440-01425F313B62","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 1063","telop":"「ただいまー。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1064スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"A60785C4-B437-4C3A-89BC-7E4A690FDDFE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1064","telop":"「あら、お帰りなさい、霊夢、さっき魔理沙が帰ってきて、『今日は大金稼いだからみんなで外食だぜ』って言ってたわよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1065スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"3D4AFCC2-65AB-4D22-A355-F4F8266AA128","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（笑い）.png","seStartTimeOffset":0,"title":"シーン 1065","telop":"「じゃあ私も、早く部屋に行って、支度を済ませましょ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1066スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"BC2F9ABB-4584-4B41-A02E-F5A774E67D0B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1066","telop":"霊夢がそう言って、上に上がっていき、足音がなくなると、今度は誰かが、降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1067スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"8CE02CC4-C899-41FE-B1E3-04BB7893E049","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1067","telop":"「おはよう、パチェ。」\n私は、瞼を擦りながら、共同スペースに降りてきて言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1068スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"4086BB26-5363-461D-892F-6DBCA7862DAD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1068","telop":"私はレミリアに、今は夕方だと告げていると、誰かが、共同スペースに入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1069スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"B58855B7-67BE-4BC1-BEB6-12C8AC3F1A32","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1069","telop":"「ただいまー。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1070スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"06DD6E2F-5519-4E3B-8184-D90F72D70BD8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1070","telop":"「あら、お帰りなさい。さっき、魔理沙が今日の夕飯は、外食だぞって言ってたから、あなたたちも支度してきなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1071スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"32DB9EBA-AB32-40FC-AFEB-AD2EF2DCA939","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1071","telop":"「はーい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1072スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"6E4D4DD7-593C-486C-849A-D4D9BEEBF2F5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1072","telop":"二人が上に上がっていってしばらくすると、誰かが降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1073スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"CAFDD5D8-4CFD-441A-84B6-74BC5E76F5AB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1073","telop":"「どうしたんですか…」私は、目覚めたばかりの頭でそう言うと、ふとパチュリーの心の中を覗く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1074スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"6E13BC36-F524-4E0A-90AB-4879997E427F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1074","telop":"「今晩は、外食なのですね、なら支度を済ませないと…」\n私はそう言いながら、上に戻っていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1075スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"6C5D1007-2E30-4E70-9643-3ECE5E965F87","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1075","telop":"ふと気がつくと、レミリアもいなくなっており、私は、ソファに腰掛け、ゆっくりと背伸びをしながら待つ。「はぁ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1076スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"4B4EEC6A-F09E-493D-A9CD-A18A23216E6C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1076","telop":"私は、あくびを出しながら、待っていると、魔理沙が降りてくる。「どうしたのよ、魔理沙？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1077スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"92C4BF0D-F495-4FE4-B348-044822D36BC0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1077","telop":"すると、魔理沙の口から発せられたのは、咲夜が彼の部屋のベッドで寝ていると言うことだった。「それで、彼には何て？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1078スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"0D51F91F-1A81-438D-BC30-819A2561F788","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（困る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1078","telop":"「準備を済ませたら、下に降りてきてって言ったのね…、まさか、彼が咲夜を置き去りにして、降りてくるとは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1079スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"368C3DF6-6156-4C79-8662-A88A0759749D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1079","telop":"「どうしたんですか…そんな顔して…」\n私はそう言うと、頬を赤らめる。「まさか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1080スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"A72F51F2-F4F2-459A-A1BF-FF047F2F0D75","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","seStartTimeOffset":0,"title":"シーン 1080","telop":"「あら、どうしたのよ、3人とも？」\n私は魔理沙たちにそう問いかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1081スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"BE1D6160-8A11-4C8E-B930-CCA48B507EB3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 1081","telop":"私は、魔理沙から告げられた言葉に頬照り、驚く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1082スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"E906F988-C8D7-4683-AC36-62C305D82EAD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1082","telop":"「あら、どうしたのよ。皆揃って、そんな顔して。」\n私は、そうパチュリーたちに問いかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1083スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"FDDD2927-AF73-4D63-BAE8-F52D21195F63","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1083","telop":"「えっ、それ大丈夫なの？まさか彼が咲夜を置き去りにして降りてくるなんて、思えないけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1084スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（夕方）.jpeg","id":"433BDC97-7B07-4E9F-BDBE-61CCCEB136E1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1084","telop":"「とりあえず、さっき車を2台美鈴に頼んでおいたから、どうやって別れるか決めましょ。それと、フランたちには秘密ね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1085スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"C1621EAB-3D5F-4C69-8678-183F9017C8D4","seStartTimeOffset":0,"title":"シーン 1085","telop":"「レミリアの言うとおり、フランとこいしには内緒にしておいた方がいいわね…、それでどうやって二手に別れるのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1086スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"リビング（夕方）.jpeg","id":"D6146153-C3FB-40CE-B0DB-E42BA3CAD147","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1086","telop":"「フランとこいしは、私たちとは別の車がいいから、人数的に、私たちが１つ目、フランたちが２つ目になるわね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1087スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"リビング（夕方）.jpeg","id":"E07EB205-87C5-45CE-9C2E-21B4F163CC86","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1087","telop":"「それで、私はどっちに乗ればいいのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1088スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"リビング（夕方）.jpeg","id":"CBA6C1B5-D3E3-4D34-A950-77804EF2BF67","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1088","telop":"「もし、お酒を飲むことも視野に入れるなら、1人分は余らせておきたいから、フランたちの車に乗ってちょうだい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1089スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"リビング（夕方）.jpeg","id":"55199944-316F-4644-8F17-F15E2E862936","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1089","telop":"「分かったのだぜ。」\n私がそう言っていると、上から誰かが降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1090スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"リビング（夕方）.jpeg","id":"B09B0556-9A90-4D1A-AFAC-6AA7DC7C2EC6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夕方）.jpg","title":"シーン 1090","telop":"「おまたせー。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1091スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"咲夜（怒る）.png","id":"77599ECE-E353-4D5B-BC6F-C93FDA93F714","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1091","telop":"「あら、あんたたち、降りてきたの。これで、全員…」\n私がそう言ってくると、さらに誰かが降りてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1092スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"79F92939-EC57-4779-B431-C367063A83B6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1092","telop":"「それじゃあ、フランお嬢様とこいしさんは、私が彼の部屋のベッドで寝ていたことは知らないのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1093スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"D7C1D545-BBB2-44AD-BB9A-C102B756B9A9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1093","telop":"「ええ、そうよ。きっとあの二人にあなたのことを言ったら、面倒ごとになるだろうし…」私はそう言いながら、話を続ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1094スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"577F4BE0-CE2B-46B5-A9DA-3006CF8F900F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1094","telop":"「それで、魔理沙たちはどこにいく気なのかしら？」\n霊夢と共に後ろの席に乗った私は、ふとそう言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1095スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"522FD6B9-5835-4725-B896-F238E2AF2B28","seStartTimeOffset":0,"title":"シーン 1095","telop":"「さあ、どこでしょう。まぁ、私が、前を走るこいしの車についているので、そのうちに分かりますよ…多分。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1096スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"56831D96-F590-40FF-9B24-3CE9E526C341","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"title":"シーン 1096","telop":"「そうね…、それにしても、魔理沙はどうやってお化けを獲得したのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1097スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"DD4F25FF-81E4-4BF5-9D6D-6EBC71452303","seStartTimeOffset":0,"title":"シーン 1097","telop":"「さあ、でも魔理沙は、普段は、市内とか、県内でしか、飛ばないはずだから、よっぽどのことがあったのかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1098スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"41354E28-1C0D-4D30-96E3-39544461ECB9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1098","telop":"「私もそれは、気になるけど、それよりもたった10時間で10億円は流石におかしい気がするけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1099スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"FBA33048-C3E8-472E-8533-DE7E6E3F7BC2","seStartTimeOffset":0,"title":"シーン 1099","telop":"「確かにそうなのよね…、何も問題なければいいのだけれど。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1100スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"B96FADD7-CE6E-482E-A1B9-154FE8AEB3F1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 1100","telop":"「そうよね…そんな大金だと使い道…」\n私はそこまで言いかけるとハッとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1101スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"3F018EDA-5215-4A5B-92AF-EEFD85E3645D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（驚く）.png","seStartTimeOffset":0,"title":"シーン 1101","telop":"「そうよ、この大金があれば、紅魔館の負債もチャラじゃない。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1102スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"E2E58F15-57F1-4AD7-A8F1-BDF079CE1E29","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1102","telop":"「たしかにそうね…、なんか惜しい気がするけど、私が拉致されたときにできた借金を一気に０にできるチャンスね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1103スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"9CD1FBD8-66AD-4217-9224-EDD0ECE4BD83","seStartTimeOffset":0,"title":"シーン 1103","telop":"「あのときは、相手に私たちの情報が流されてるのか、私たちが吸血鬼だと知った上で拉致されて焦ったわ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1104スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"5AF886F9-281B-4A63-8601-34CB695288E9","seStartTimeOffset":0,"title":"シーン 1104","telop":"「今思えば、その頃までは、特に働かなくても、紫からの小遣いで事足りたものね…、この制度の登録理由もそれだし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1105スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"C44FDFB9-7F82-41A9-B8CE-3A11E662D1DE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1105","telop":"「でも、それだと、にとりから送られてきたPCを購入しないといけないのかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1106スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"B7D0715B-6B48-4D24-83B4-F0A422FD651B","seStartTimeOffset":0,"title":"シーン 1106","telop":"「確かにそうね…、て言っても私たちにはPCなんて、わからないから、収納に入れて、一切使ってないけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1107スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"D5424F36-B756-4761-928F-2E27A8CFDEC1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1107","telop":"「それで、私を拉致した相手は、いったいどこから私たちの情報を入手したのかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1108スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"1982189F-6AED-41BA-96B0-71275771DBE8","seStartTimeOffset":0,"title":"シーン 1108","telop":"「確かに、あのときは、誰かがパチュリーを解放してくれたから、助かったけど、借金だけは消えなかったものね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1109スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"652CCC7B-D328-4E97-B73E-D82C356C27B8","seStartTimeOffset":0,"title":"シーン 1109","telop":"「そうよね…、私も、そのことを新聞で知ったときには驚いたわ…。にしても、何で現代人は私たちを否定するのかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1110スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"3BFC1664-18DC-4B36-877A-71D43A50938F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1110","telop":"「確かに、そこは謎だわ…、霊夢たちならまだしも、なぜ幻想郷由来の人たちを強く否定するのか…、謎よね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1111スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"152604A9-C254-4750-8FE1-F207271A3C0F","seStartTimeOffset":0,"title":"シーン 1111","telop":"「本当に困りものだわ、単純な動機で嫌われて、攻撃対象にされてしまうのだから…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1112スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"C7AC4CB0-AECC-4438-8E59-D247782A4CBC","seStartTimeOffset":0,"title":"シーン 1112","telop":"「そうよね、パチュリーの一件をはじめとした、そういう風潮を誰かが、裏で操っているのかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1113スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"84EEB140-9FA2-4B70-AF7C-4ED6AD2A4F3C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1113","telop":"「考えたくはないけど、紫たちと対する政党が、そう言う動きをしているのかしらね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1114スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"69FB3DC4-1FE5-4E5A-8B07-EE7EFAD2C60F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1114","telop":"「そう言えば、幻想郷って何でしたっけ…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1115スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"6AE6418D-DF57-4422-8D3B-DE86C143C64C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1115","telop":"「もしかして忘れたの、そんな…」\n私はそこまで言いかけて、私も幻想郷を思い出せず、驚く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1116スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"D4BAC4C4-A230-4561-953C-6160045D5F2E","seStartTimeOffset":0,"title":"シーン 1116","telop":"私は、幻想郷を思い出そうとするが、思い出せず、思わずため息が漏れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1117スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"2C186651-A0D9-4BE3-A11A-B85E1B8BB3A4","seStartTimeOffset":0,"title":"シーン 1117","telop":"私は、幻想郷という言葉から連想をしようとするが、どうしてもできず、困ってしまう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1118スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284291_自動車の車内（夕方）.jpg","id":"AACB6AC5-51A9-443E-97AA-90F5C81B936D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1118","telop":"「みんな、忘れてますね…、なぜですかね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1119スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"5CAD5042-DF35-4287-9005-3639277EDC65","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1119","telop":"私はそこまで聞いて、幻想郷という言葉が頭から抜け落ちていたことに気づく。そして、昨日見た夢を思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1120スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"A4BE63F8-6F8F-44D9-A174-A6717EBE6EEE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1120","telop":"「もしかして、私が拉致された時のこと思い出したの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1121スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"60890EA3-0604-49F1-B77A-C68DA1863B5C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1121","telop":"「ええ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1122スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"1D2FF98C-B7CF-4335-9CE6-FF17E14BB472","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1122","telop":"「なら、そのことを先に話した方がいいわね。」\n私はそう言うと、再び話し始める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1123スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","id":"E7270CCF-5C41-45D1-AC41-528CB19AF7BC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 1123","telop":"それは、ある日のことだった。\n私は、その日はいつも通りに大図書館で魔法の研究をしてた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1124スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","id":"03FC3675-C750-49C3-8093-6A341201BE45","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 1124","telop":"すると、レミリアの居室から戦闘音が聞こえてくる。気になって、小悪魔に、見てくるようにいうと、姉妹喧嘩だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1125スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","id":"03091E8D-9EFA-4401-B8BC-D95E9C8AA803","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 1125","telop":"私は、そんな中でも手元の本を読んでいると、突如激痛に襲われ、ふと後ろを向くと、そこには見知らぬ男の姿があった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1126スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","id":"8D0E2F60-EFDB-4874-96DE-91A0E5A0B6B7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/nc77066_【背景素材】紅魔館大図書館.jpg","title":"シーン 1126","telop":"私は、その男のあまりに強烈なパンチで気を失った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1127スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"鉄扉（なにもない部屋）【フリー素材あそび】.jpg","id":"E55C3B30-B190-42F9-9AD1-5E2606AB7C8D","seStartTimeOffset":0,"title":"シーン 1127","telop":"私は、ふと気がつくと、そこは、冷えきったコンテナのような部屋だった。入り口は硬い鉄の扉で閉じられていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1128スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"鉄扉（なにもない部屋）【フリー素材あそび】.jpg","id":"606A5954-5B7F-4536-AEA0-990877AD6474","seStartTimeOffset":0,"title":"シーン 1128","telop":"そして、そのまま幾許の時間がただ流れ、私はお腹が鳴る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1129スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"鉄扉（なにもない部屋）【フリー素材あそび】.jpg","id":"B7FC99F8-E962-469E-BC6C-92841E03C696","seStartTimeOffset":0,"title":"シーン 1129","telop":"すると、扉が突如開き、現れた男に私は、連れてかれそうになり、私が抵抗すると、首筋に痛みが走り、そのまま気を失う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1130スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D5E7C4C3-494A-47A1-8656-4A2CC527B089","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1130","telop":"私が再び目が覚めると、そこは、円球と制御機械のようなものが置かれた部屋だった。そこで、私は男に言われてただ待つ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1131スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3FE2A370-01DF-4E27-98B1-578221278670","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1131","telop":"私は、ふと手元を見ると、手錠がかけられ、制御機械のようなものと繋がれていた。仕方なく、そのままただ待ち続ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1132スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"4F5B688A-1D08-4FB6-95AC-8427EC535D56","seStartTimeOffset":0,"title":"シーン 1132","telop":"すると、その部屋に突然、彼女が現れて、慌てた様子で、それを操作する。すると、カチッとという音ともに、手錠が外れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1133スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"59623F72-AF70-4A58-A032-2127EB1DA84E","seStartTimeOffset":0,"title":"シーン 1133","telop":"私は、彼女に話しかけようとすると、彼女は私を静止して、あるものを取り出し、私に被せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1134スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BFCECE96-1D8D-46F8-AA4E-AA9EAD1DDE7B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1134","telop":"すると、私の視界が暗転し、再び何かが、身体に装着されて、誰かに背負われる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1135スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A134C419-FBFC-4266-9B45-6F71B2A64F33","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1135","telop":"私は、ふと気がつくと、彼女の姿はなく、知らない場所にただポツンと私だけが立っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1136スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"8C54A9DF-FBA9-4D3F-9B21-680EC4D5FB72","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1136","telop":"「それで、その後は結局どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1137スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"A8F13ADD-6ABD-42FC-94D1-4AA3BD4614FA","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1137","telop":"「私は、周りに誰もいないかを確かめて、空間転移魔法で、大図書館にワープしたの。すると、みんな涙を流していた。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1138スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"FF17DE01-F795-4E43-83FE-B2BD020A74F1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1138","telop":"「どう、気掛かりは解決できたかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1139スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"941B0349-9BAC-4484-9811-900EDF3557B1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1139","telop":"「借金はどうなったんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1140スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"107B7EFA-6DE1-4ED2-ADAE-ABD51B7D8C29","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1140","telop":"「奴らは、多額の現金を振り込まないと、レミリアたちが吸血鬼であることを周りに知らしめると脅迫していた。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1141スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"4DDE6494-B7EF-443C-BBAD-39357A960BFC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1141","telop":"「だけども、その金額はいくら、お金持ちであっても到底支払えるとは思えない金額だった。そこで、借金して支払ったの。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1142スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"F0B4387B-F845-4728-A616-278EE06CFA0D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1142","telop":"「そして、奴らは金のことだけを考えていて、たとえ金が入っても、私は彼女がこなければ、捕まったままだった。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1143スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"5CDAE1A8-C043-48D8-A9C1-AB89ADBDB6D2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1143","telop":"「そして、私は帰れたけど借金は残り、レミリアが紫に相談すると、ゆかりん党の政治資金で私たちの生活は保証する。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1144スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"B23B2438-1236-42AE-9C8D-1F73EA0F84ED","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1144","telop":"「だから、このことは公にはせずに、霊夢と魔理沙に紫が内密に頼み込んで、今が成り立っているっていうわけ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1145スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"FD4832B6-8494-467F-9A2B-73A2D2545D3D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1145","telop":"「それで、１０億円だけで借金は返済できるんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1146スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"28AFB30C-30D0-4B91-A191-FB14EE86B330","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1146","telop":"「借金の一部は、霊夢と魔理沙の給料から天引きで支払われて、そこに１０億注ぎ込むと、数億円は余る見込み。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1147スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"4807D71C-52A3-4978-A982-A0506923A748","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1147","telop":"「どうする、続きの話も聞く？さっきの話と比べたら、だいぶ軽いけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1148スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"3EAC6ABB-0E8B-4FA6-9581-11E635E208D5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1148","telop":"「私が元々聞きたかったことですから、聞かせてください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1149スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"2802C125-2C25-4FF8-BA76-09E33CFC6656","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1149","telop":"「そう、じゃあ、話し始めるわね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1150スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B37B299D-62DD-4EFB-BA5C-4B9263952680","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1150","telop":"私たちは、ショッピングモールに来ると、魔理沙が持ってた10万円を1人ずつ手渡し、夕食を買って食べた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1151スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B7611E87-A95C-46F5-9D35-79EB560ED748","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1151","telop":"私は、ふと操夢を見ると、彼は頬照っていた。そこで、ふと熱を確かめると、熱はなく、彼が飲んでいたものに目を向ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1152スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C00DEA01-D75E-479F-9F74-9328197773F3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1152","telop":"私が、その飲み物の蓋を開け、口につけて飲むと、中には炭酸と乳酸菌飲料をサワーにしたものが入っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1153スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FD88FA36-3EE0-4665-9519-948046A55837","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1153","telop":"私が、蓋を戻し、彼に尋ねると、彼は「ソフトドリンクを頼んだ」と言い、どこで購入したかを聞き出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1154スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"86B7A6BF-A037-4188-A7E8-52CCFE49BECD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1154","telop":"私は、彼が夕食を購入した店に向かうと、案の定、店員が慌てており、彼の注文を聞くと、確かにソフトドリンクがあった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1155スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F820240E-8646-4404-852E-29427AEE3828","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1155","telop":"だが、中の店員が通常とは異なる機械で誤って、飲み物を出してしまったと素直に謝罪していた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1156スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BF55B94B-539C-4340-9012-6D39AB0D50AD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1156","telop":"なぜそのようなことが起きたかと、聞くとその店員は、スキマバイトで、マニュアルを見ずに提供したという。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1157スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A8AC8FDA-9856-4F68-8FDD-017B685C442C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1157","telop":"私は、それに呆れ果て、仕方がなく、彼の席に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1158スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CCA67434-89CA-4CA8-9D04-A41D7A620BA6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1158","telop":"ふと、彼の飲み物を見ると、すでに空だった。私は、記憶魔法で彼の記憶を書き換えると同時にアルコールの処理速度を早めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1159スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B1A85E27-1CC9-45A3-8479-FE1297CCD13C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1159","telop":"そして、私は、自分の注文した料理の完成を知らせるブザー音に気がつき、急いで、お店に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1160スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AF70688C-DCB7-4C23-9158-57017A48AF39","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1160","telop":"私がひと段落すると、すでにレミリアたちも夕食を食べ切っていて、そのまま車に直行する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1161スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"ADFE2884-09FD-458C-96F7-BA0103D13054","seStartTimeOffset":0,"title":"シーン 1161","telop":"私は、彼からアルコールが抜けているのを確かめると、車の助手席に乗り込む。すると、さとりが先導して、車が動き出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1162スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"9B667E42-34A4-45B7-B992-82303219C148","seStartTimeOffset":0,"title":"シーン 1162","telop":"「ねぇ、みんなで寄り道しない？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1163スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"2A312EFB-3774-4A78-986C-F5C94D69DA90","seStartTimeOffset":0,"title":"シーン 1163","telop":"「寄り道？どこに寄るの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1164スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"4B22782E-05C2-413F-AAFD-A6C0E646BBEF","seStartTimeOffset":0,"title":"シーン 1164","telop":"「大宮よ。大宮の繁華街をぶらつくなんてどう？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1165スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"4E40F2BB-3233-4283-AE61-2F1A17CB1365","seStartTimeOffset":0,"title":"シーン 1165","telop":"「まさか、お酒が飲みたいからじゃないわよね…？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1166スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"0CB7162D-C210-42EF-B56F-817A7F45725F","seStartTimeOffset":0,"title":"シーン 1166","telop":"「まさか、違うわよ。ただ、夜の街を眺めたいだけよ…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1167スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"6109F6BA-ADD9-469E-8CC0-0F33EAB2CA16","seStartTimeOffset":0,"title":"シーン 1167","telop":"「ただ夜の街を眺めたいなら、窓から外見ればいいじゃない。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1168スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"90709AC6-1951-48D8-A225-C7F956933CDE","seStartTimeOffset":0,"title":"シーン 1168","telop":"「えっと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1169スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"15708797-F175-427C-8D19-1CA84E71D7AC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1169","telop":"「パチュリーさん、レミリアさんは、外に出る前にお酒の話をしてましたよ。だからいいじゃないですか…。」私も飲みたいし…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1170スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc284292_自動車の車内（夜）.jpg","id":"CF9A2074-5124-421F-900B-9B3F57BF6907","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1170","telop":"「確かに、それなら良いわね…」\nまぁ、納得することはできないけど…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1171スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B25C22D3-C909-42FC-BBFE-AC545BFB227B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1171","telop":"私は、お店の個室席に彼と向かい合うように座り、レミリアたちは６人でまとまって座った。私はふとメニューを見る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1172スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"41C361AE-A099-4110-A363-E3EB13318DEB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1172","telop":"私は、彼が一緒にワインを頼もうと言ったので、白ワインを頼む。レミリアたちは赤ワインと瓶ビールを頼んでいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1173スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3DF3DC33-CA20-468B-AB5A-3537728DC838","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1173","telop":"そして、白ワインとグラスが２つくると、一緒に来た水を２つのグラスに注ぎ、その上にワインを注ぎ、混ぜ込む。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1174スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5239F49F-AC76-4AD1-979C-C04DF06407E0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1174","telop":"そして、レミリアたちは無視する形で2人だけで先にグラスに入れたワインを飲み始める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1175スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"184A9352-6287-4AE8-B64E-E9999F410446","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1175","telop":"それから、小1時間くらい立つと互いにアルコールが回り、私は家に帰った方がいいと判断し、彼に声をかけともに席を立つ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1176スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc247232_都会の街中（夜）.jpg","id":"326A1327-FDBA-49CB-8093-A01E025BCA3E","seStartTimeOffset":0,"title":"シーン 1176","telop":"私たちは、それから、レミリアに一応、一言告げてから、店を出て、駅に歩いて向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1177スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc247232_都会の街中（夜）.jpg","id":"F9FBD631-BC00-4C4F-B37C-87EA7B11BB98","seStartTimeOffset":0,"title":"シーン 1177","telop":"私は、ふと隣の彼が、少しふらっとしてるのを見ると、さっと手を取り、ゆっくりと歩き続ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1178スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc263189_繁華街の駅前（夜）.jpg","id":"DA8DDEE8-AC8A-405C-BEA9-94D8E825801E","seStartTimeOffset":0,"title":"シーン 1178","telop":"私たちは、駅に来ると、そのまま埼玉本線にのって帰宅する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1179スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"625AF685-34EA-4529-B5B5-F9CCED997A17","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 1179","telop":"そして、家に着くと、電気をつけて、カーテンを閉め、彼をソファで座らせる。すると、彼は、そのまま横になって寝始める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1180スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpeg","id":"8D8A6EC9-9281-4BDA-9BED-37AEFFB1D215","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（夜・照明ON・カーテン閉）.jpg","title":"シーン 1180","telop":"私は、ふとテーブルに座り、彼の寝顔を眺めていると、ふと自分もうとうとしてることに気づき、ゆっくりと自室に戻った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1181スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"9A049C1B-6BE2-41A5-800A-DB3A55D98B6D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1181","telop":"「これが、昨晩起きた出来事の流れ。それで、これからどうするの？多分レミリアたちは二日酔いで寝込んでいるけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1182スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"リビング（日中）.jpeg","id":"B1629E93-9C87-4903-8A03-545D9F37E3D3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1182","telop":"「そうですか、よーく分かりました。では、お嬢様たちを叩き起こしに行ってきますね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1183スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"39128E0E-BB32-4E0E-A066-7C8F0542FE44","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1183","telop":"「ちょっと待って。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1184スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"リビング（日中）.jpeg","id":"F460267B-6A39-4329-8690-9618DBA95605","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1184","telop":"「なんでしょうか、パチュリー様？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1185スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":9.600000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"7C512E61-44FE-4D45-8783-DD85223D1F17","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/パチュリー（困る）.png","seStartTimeOffset":0,"title":"シーン 1185","telop":"「昨晩の帰り道に、ふと誰かにつけられている気がしたの。もしかしたら、そいつらは、過去に私を拉致った奴らかもしれない。だから、レミリアたちには、全責任を押し付けて怒ることはしないでちょうだい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1186スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"リビング（日中）.jpeg","id":"A6A27314-D244-4076-BA42-D9712918C9EF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1186","telop":"「承知しました、パチュリー様。」\n私はそう言うと、上に上がっていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1187スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"16496B6F-B920-4BFF-8EDD-0F7B20352113","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1187","telop":"私は、お嬢様の部屋の前につき、扉を強くノックする。だが、反応はなく、ドアノブを握ると、ドアが開く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1188スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"26BEEF87-A06F-4C8B-BC2E-12ECF9D4E7B6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1188","telop":"そして私は、お嬢様に近づき、強くビンタする。\n「朝ですよ、お嬢様、起きてください！」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1189スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"87884B1E-131E-46AB-A3EA-30EBC5546288","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1189","telop":"「ぷは！何があったのよ。」\n私は、誰かにビンタされてそう言いながら、目覚める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1190スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"4D08CF1D-6618-417A-B9F0-25E8DE0A7A26","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1190","telop":"私は、ふと周りを見渡すと、咲夜がいた。\n「どうしたの、咲夜。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1191スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"9948F3B5-C9E5-4FEA-B208-BDC01F60E6CF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1191","telop":"「『どうしたの？』じゃ、ありませんよ、お嬢様。昨晩、操夢さんとパチュリー様を先に返して、ワイン飲んでましたよね？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1192スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"6100CD0E-A432-4E55-A9E4-1097E444E20B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1192","telop":"「しかも、私を家に置き去りにして、外に出かけましたよね、お嬢様？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1193スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"69B8411B-72BC-4D7A-BA33-EBD299EEF204","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1193","telop":"「えっと、それは…、魔理沙が…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1194スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"30075D0C-B763-48F8-920B-04F21633AA8D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1194","telop":"「パチュリー様から聞きましたよ。昨晩のお嬢様のご様子。大宮の繁華街で、パチュリー様が反論しても飲んでましたよね？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1195スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"351CE751-2633-4D7E-9CD2-883F48AF7279","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1195","telop":"「えっと、だから…、それは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1196スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"3A9FF412-E149-487C-8FF8-F59BA1113076","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1196","telop":"「まぁ、いいですよ、それは。ただし、魔理沙さんの１０億円については全額私が没収しますからね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1197スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"2538CB73-A75B-4EDB-BEBD-782810FAC3F8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1197","telop":"「咲夜…、１０億円の件なんだけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1198スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"97FCE250-8B2F-485B-9A22-76BD053B9853","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1198","telop":"「知ってますよ。お嬢様の借金返済に充てるのでしょう、それなら私が行いますから安心してください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1199スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"B87A9ECB-EDAD-4432-9D46-53422939BB4B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1199","telop":"「あと、お嬢様のキャッシュカードも没収しますね。これで、しばらくの間は、しっかりと反省してください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1200スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc301377_一人部屋２（日中）.jpg","id":"E0152A9C-9614-476E-87FF-8B7C59A8CE08","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/nc301377_一人部屋２（日中）.jpg","title":"シーン 1200","telop":"「咲夜、それはよしてよ…」だが、私の言葉虚しく、彼女はキャッシュカードを奪い取ると部屋から出ていった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1201スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D94C5684-5358-4B3C-859B-5AF025BC3D0B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1201","telop":"私は、それからその他の寝込み人の部屋に突撃しては、金品を奪い取るのだった。ただし、操夢とパチュリーの部屋を除き…。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1202スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4B1C4521-AFBE-4685-832A-654363557194","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1202","telop":"一方その頃某所では…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1203スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D356342A-2980-415D-A20F-E2E66FA1135A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1203","telop":"「大河課長、例の件なのですが…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1204スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"878AD206-3E23-47CE-9A3F-D7E879916F73","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1204","telop":"「何か、進展でもあったのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1205スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"25E7CE41-C008-4467-8A0F-BB430BC7417D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1205","telop":"「彼らの行動を追尾し、新人のミスと題して、彼を酔わせることはできたのですが、拉致することはできませんでした。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1206スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F0D8EBD8-160A-4DEC-AC4B-D7C37F90E2C8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1206","telop":"「なぜ、拉致できなかったのだ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1207スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"73D0FD4C-97B8-476E-BC16-E00A70ECBD2B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1207","telop":"「例の共同生活のメンバーに魔女がおりまして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1208スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4EEBDCA4-2F2E-4C89-BA08-9CE6D93182FE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1208","telop":"「魔女か、女なら、容易く拉致できるだろう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1209スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"45BA36D5-5274-48E9-8F0C-9272F75CAA33","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1209","telop":"「ですが、その場を、ゆかりん党からの工作員が監視していまして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1210スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5578123E-05CF-4BA7-A15E-CBC1A3AB6B7A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1210","telop":"「その工作員は誰だ？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1211スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9FE2ABFA-16BE-4653-B233-51D772F11CF7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1211","telop":"「過去に我々が手を下した魔女誘拐の際に、こちら側を裏切り、ゆかりん党に協力した裏切り者でして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1212スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DFEE8FA3-4572-423F-8408-3FEE30FB01AA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1212","telop":"「あの河童か？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1213スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E12C233A-844F-41B7-89A5-4EC802342C59","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1213","telop":"「はい、そうです。それで、その魔女も以前、我々が手を下して、拉致った魔女と同一人物かと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1214スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"917B1623-8DD3-42D6-84F7-10C39BC99857","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1214","telop":"「それで、単に失敗したのではないだろうな？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1215スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"24BBEE48-2C37-4779-B0A4-B04B188C9531","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1215","telop":"「我々が、フードコートの店員を介してうまい具合に大宮の例の居酒屋へ誘導しましたが…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1216スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8D80B31D-D9B5-486F-9399-F87C02C9FB11","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1216","telop":"「それで、その先はどうなった？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1217スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9CF6B225-820E-45DE-8031-9FB012CE732B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1217","telop":"「例の居酒屋では、計画通りに、彼が途中離脱しました。ですが、その際に、例の魔女も同伴で、誘拐はできませんでした。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1218スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A80194A6-D1A8-4D8D-90B7-75F902F472DC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1218","telop":"「なぜ、誘拐ができなかった？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1219スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F7758C1B-6C2D-4670-822A-0A64323EFD80","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1219","telop":"「それが、例の河童が例の居酒屋の前で、彼ら出てくるのを待機しておりまして、その目線があり…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1220スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"62E72010-65D0-4331-B046-37ACB024CE42","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1220","telop":"「なぜ、何度もゆかりん党の壁が、立ちはだかるのだ？もういい、違法行為に手を染めてでも、彼を捕えなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1221スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"93488146-EA92-4081-9831-666308F09B7C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1221","telop":"「でも、それだと味方に犠牲者が出ますが？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1222スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"69330854-55BD-4A54-909A-DE236AB0DBD4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1222","telop":"「その件なら、俺から上に助言して、隠蔽工作を実施するから、安心しなさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1223スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"42D67F96-2E1C-4205-9B26-E810042A6425","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1223","telop":"「はい、承知しました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1224スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DAA97BD8-5546-4AEF-A2B8-9817DE197452","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1224","telop":"一方その頃にとりは…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1225スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C42BA6F0-5AA6-4AE5-A2B8-5A56628117D1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1225","telop":"「はぁ…」私は、ふとバックヤードでため息をついた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1226スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"87B31E8E-64BD-4F43-AF30-D6C9520183CE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1226","telop":"私は、幻想郷からこっちの世界に来た時に、紫に言われて、このお店を全国展開していき、表の顔は順調に広がっていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1227スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F3C3D04A-11EB-4A36-94A7-26B536392A82","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1227","telop":"だが、私には裏の顔もあり、昨日のことを思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1228スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F2FEC904-E82F-49FC-BD7E-95D2D3BCD842","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1228","telop":"昨日、デスクワークでPCと睨めっこしていると、ふと電話が鳴り、出てみると、紫からだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1229スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EB801630-D5CF-4199-AB41-17822BFD5B86","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1229","telop":"「はい、何でしょう？」\n私は、そう彼女に要件を尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1230スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"805F68CB-1EC2-43AC-BE5A-61BB8626F5DF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1230","telop":"「にとり、例の彼について、あるお願いをしたいの。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1231スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"76580677-DE59-48F7-8D7F-036C1CBB9399","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1231","telop":"「例の彼…、あっ、操夢さんのことですか。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1232スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"08BFBA5D-9DA2-4647-8270-3F1D323A892E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1232","telop":"「そう、それで、今、文が巨漢党の人間からのリーク情報を藍に流してきたの。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1233スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9151F9D4-EC36-4700-9604-40846F4DBB2C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1233","telop":"「文からですか…、それでどんな情報なんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1234スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FCC640A6-2281-4B86-A2BF-CBF2D4276233","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1234","telop":"「この先は、機密情報だから、もし聞きたいなら、私のお願いを受け入れる必要があるけど、どうする？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1235スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"261C7E35-2F35-45B7-B942-ED333E610D78","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1235","telop":"「報酬はいくらですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1236スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"325EF71C-F6A3-4B72-87F8-844AD88AC4E2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1236","telop":"「巨漢党に動きがさとられないようにお金ではなくて、きゅうりをそうね…1年分でどうかしら。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1237スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EBA8D155-FC7B-4EAA-9D85-E5CDDE556613","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1237","telop":"私が、どう返事をするかを考えていると、他者からの割り込み通話が入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1238スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DB99612E-E7D5-47B8-A434-C229DE21BA2E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1238","telop":"「もしもし？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1239スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3AC8FD3C-E6B2-4303-8C94-1B4DB62D1132","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1239","telop":"「こんにちは、にとりさん。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1240スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A09F3758-77FA-4E9D-A58D-214E0D96FD28","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1240","telop":"「巨漢党の人間ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1241スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"81FA3212-5499-4BE1-9B16-5365053D5419","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1241","telop":"「おや、お察しがいいようで…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1242スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4A8847C8-C05E-4DEF-A525-595D20DBC3D4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1242","telop":"「それで、どんな要件なんです？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1243スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A607B10C-74DE-4C44-B6D5-7584BEA46DBD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1243","telop":"「実は、今、私の部下がマスメディアに機密情報を流してしまったみたいで…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1244スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"75068720-84EB-44D1-B35B-D241216E75D9","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1244","telop":"「それで、その情報は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1245スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0B9B2AB6-CB5A-4CF7-946B-570A1CCC0D21","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1245","telop":"「この先は、機密情報ですから、今ここで契約すれば、情報をお伝えできますけど、どうします？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1246スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"904EE620-334E-4DCB-BE16-298E6F0C6103","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1246","telop":"「報酬は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1247スライド","transitionName":"なし","characterName":"霧雨魔理沙","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"霧雨魔理沙","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"48CE1097-DE4B-4908-9A88-08BC52922F58","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1247","telop":"「報酬はですね…1億円でどうでしょう？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1248スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8A418AB8-F396-4101-8981-6AAEC6F971A5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1248","telop":"私は、その男が発した金額と紫が言っていたきゅうりを天秤にかける…、「とりあえず、二重スパイがいいか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1249スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A6649DC0-CC36-47A4-B1D4-284BDA3E7C2F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1249","telop":"「それで、機密情報とは？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1250スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"12790199-048B-4285-BAD7-DB1EB742F620","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1250","telop":"「契約成立ですね、それで機密情報なのですが、ーーー。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1251スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A8E4A200-9D67-44E7-A56C-66EDB4DC4863","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1251","telop":"「分かりました、今日の夕方から某ショッピングモールのフードコートですね。承知しました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1252スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"ACAD331C-9CAB-4F36-A1F8-81C088CC225C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1252","telop":"「いつも、お世話になります。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1253スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D20D839B-CDF9-4D5E-8ADF-5043E5AE4616","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1253","telop":"その男はそう言うと、通話が切れ、紫に繋がれる。\n「もしもし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1254スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"31B39D35-1D74-4B55-A3BA-1098A39DCE8C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1254","telop":"「それで、今回も引き受けてくれるかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1255スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"99D602D8-E354-4E0A-BCC6-FDE9781F8E89","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1255","telop":"「もちろんですよ、何しろきゅうりがありますから。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1256スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AF81358D-2E08-4FD3-B66E-EF6D43DA11E5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1256","telop":"「わかったわ、それじゃあ、例の彼の住所と行動予測データを、今から、FAXで送るから、そっち見てちょうだい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1257スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"067C8124-E680-4DEA-9246-BB3F822C07EB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1257","telop":"「分かりました。いつもご贔屓にありがとうございます。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1258スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"26AB9735-730B-4E62-AA16-921E857B4E9C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1258","telop":"「そんなことないわ、困った時はお互い様でしょ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1259スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A0196145-199B-4513-BCCA-0A3910913954","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1259","telop":"「そうですね、では失礼します。」\n私はそう言うと、受話器を戻し、FAXに向かった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1260スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"903BCDF7-2F9B-4BE6-9C92-B15720698309","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1260","telop":"そして、私は紫から送られたFAXのデータを確かめると、スケジュールを決め、そのデータを元に行動し、実際に彼を見た。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1261スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6B372F6C-D317-425D-AD1E-5F64EAB47EE2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1261","telop":"すると、案の定、例の男は別ルートで部下を派遣しており、そいつは常に私をつきまとった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1262スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"799DEB41-B2FA-4E8F-9EA4-842167FD54E0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1262","telop":"私は、こっちの世界に来た時の”魔女”拉致事件にも関わっており、その時と同じように漁夫の利を得ようと、両者の依頼を受けた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1263スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8F6D5F06-564F-4EFB-A4D7-141788FC5B2B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1263","telop":"だが、もし二重スパイということが双方に知られたら、自分の人生は終了する。ある意味、人生を賭けたギャンブルだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1264スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"91FA308F-37C5-4009-A34C-9E79A0078F69","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1264","telop":"だが、そんなギャンブルにワクワクする私がいて、それを制止することはできず、そのまま行動に移す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1265スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F5E2A628-E564-42D1-A104-16D7A0800CD3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1265","telop":"「このお店に、無事明日が平和にやってきますように…」\nそう独り言を呟くと、これからに備えた準備を始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1266スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"23150B3A-7602-41C0-A487-25106741EA09","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1266","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1267スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"7B8DC370-5A08-4814-957C-FC8FF0C94023","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1267","telop":"僕は、ふと気がつくと、そこは自室の布団だった。ふとおでこに手を当てると、まだ少し暖かい状態だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1268スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"052227B1-0CC4-4CEE-889B-3D1717C43ED8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1268","telop":"僕は、ふと体を起こし、ベッドから降りると、体温計を取り出して、測る。すると、若干熱が下がっていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1269スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F4150ACF-945B-4B39-BA91-6B1B96D4EDD7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1269","telop":"そんな中、インターホンがなり、外に出てみると、そこにはレミリアがいて、「今日は私の日だから」と恥ずかしそうに言い…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1270スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"341D3C85-E1B1-44F1-9706-0E9FDCC6B0E5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1270","telop":"告知①：新シリーズの予告編？\n実際にこのシリーズが制作されるかは、シリーズの掛け持ちや他の作業との\n兼ね合いにより、決まるため、必ずしもできるわけではありません。\n（チャンネル登録しておくと、通知が来るので、いち早く情報を獲得できます。）","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1271スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"C6A4303D-793F-450A-A481-0142E82B3423","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1271","telop":"私は、今現在、間欠泉地下センターの地下深くに建設された、幻想郷大深度トンネルで博麗車を起動し、モニターを開いた。\n幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：N\n速度：0\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1272スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"507F4DC0-21FA-444E-A3CD-0D26000F39DE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1272","telop":"「この列車は、間欠泉地下センター発〇〇〇〇帝国行きです。途中、マッハ並の速度で、博麗大結界を通過します。」\n幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：N\n速度：0\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1273スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"A07991E1-D965-47AA-916F-56ADBAD7ABA7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1273","telop":"「この列車は全車指定席です。また、好評につき、６０隻全てが満席となっており、１号車から６号車までございます。」\n幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：N\n速度：0\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1274スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"3F4C8832-EB64-4EFB-8509-14D39A76CA79","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1274","telop":"「道中で、大きな揺れが予測されるため、お立ちのお客様は手すりまたはつり革に体を固定してください。間もなく発車です。」\n幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：N\n速度：0\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1275スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"FF4692A3-8A1C-4630-988D-E3305AD9BB94","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1275","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：N\n速度：0\n高度：-80m\nバッテリー：100％\n私はそういうと、発車ベルがなり、それがなり終わると、列車のドアを閉めて、ギアを倒す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1276スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"4E07AC5D-BD7F-4BC7-A30E-B37E84D74B8C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1276","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：P1\n速度：1\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1277スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"750937FB-94E2-44AD-A841-671F0159C37B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1277","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：P2\n速度：3\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1278スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"CC5F3C8E-EF64-4FC8-BDD6-AF6C23D339B4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1278","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：P3\n速度：6\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1279スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"0B8CC5EA-3C32-47F4-B86A-2266D8A5BF0E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1279","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：P4\n速度：10\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1280スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"99C73777-EC7E-4898-A770-819803C0892D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1280","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：P5\n速度：15\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1281スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"E785F3C2-8C89-4423-9E20-0075DE8F9AF3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1281","telop":"幻想郷大深度トンネル\n→〇〇〇〇帝国\n速度メーター\nギア：P5\n速度：20\n高度：-80m\nバッテリー：100％","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1282スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0003B7B5-F845-4E03-AB21-95671A99B2BC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1282","telop":"それから数十分後…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1283スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4137EAD6-9DA3-47CD-ABA5-F60A44644959","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1283","telop":"列車が、博麗大結界を無事に超え、外の世界へとマッハのスピードで突入すると、北関東の車社会の上空を駆けるのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1284スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"バウンス","duration":6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F7704C0A-378D-4860-A7BF-3BD957011C08","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1284","telop":"Powered by zuyasi※ゆかりん党は架空の政党であり、実在する政党ではありません。本作品はフィクションです。\nゆかりん党日記\n八雲紫が党首を務めるゆかりん党が〇〇〇〇帝国から、日本全土を掌握し、巨大な帝国を近未来の日本で築き上げるまでの物語","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1285スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"992487CB-83DE-44E3-8F5D-2A1830F512E4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1285","telop":"告知②：幻想航空鉄道シュミレーター\nここからは音声なしでお届けします。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1286スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":9.8,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E1C49AE8-CE02-487F-AF12-78693F54DCCB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1286","telop":"今後、シリーズ制作と同時進行で\nScratchを活用した幻想航空鉄道シュミレーターを作成します。このシュミレーターは後述するGitHubリポジトリにて、Webベースの二次創作ゲーム共に公開予定です。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1287スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BBC6BC40-61CB-4A20-B404-A87C88491B37","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1287","telop":"告知③東方虐恋録について","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1288スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":15.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"38B08BAF-A8E7-4A4D-BFE5-A60A3A4EB88A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1288","telop":"シリーズの存在感が日に日に薄くなっている気がするこのシリーズは、投稿頻度は交換夫婦に比べると劣りますが、不定期で追加していく予定です。このシリーズをいち早く見たいという人は、チャンネル登録をお勧めします。また、今現在もZラジオ局のネタを募集中です。詳細は後述するzuyasiのWebサイト上で確認できます。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1289スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A2D95BF5-32F9-4D26-A386-558EEBFE1C13","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1289","telop":"告知④PictureRPGについて","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1290スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B7C8DA37-5018-4AD1-AE08-7E0E8EDC6937","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1290","telop":"今現在、QR先にて東方Project二次創作ゲームを公開しています。まだまだ開発中ではありますが、定期的に見てくれると嬉しいです。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1291スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"480DC03F-0D78-42C1-8788-386B8DBE7DC5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1291","telop":"告知⑤Webサイト及び動画投稿先","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1292スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FFD259E8-11B5-4EA4-8F3A-F20699950B07","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1292","telop":"以下のいずれかQRコードを読み込むと下部にあるページに飛びます。\nzuyasiのWebサイト\nYouTube\nニコニコ動画\nニコニコ動画でしか見れない動画もあります。もし興味があれば、見てみてください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1293スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D2A3EA7F-3A44-4570-899A-8C6807296A76","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1293","telop":"告知⑥：プロモーション","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1294スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"バウンス","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"425FB396-7ECD-440A-AB76-9A0624E3CA62","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1294","telop":"以下はPRコンテンツです。\nQRコードを読み込んで表示されたサイトの”詳細動画を見る”をクリックすると動画が見れます。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"単色背景","id":"856D4252-19AF-4434-A9DA-5F6C2097E247","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"176A4692-EB6C-4EAB-9C5E-45212077D416","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1297スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"39F980FE-7CDC-4997-9E6A-D024088F9747","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1297","telop":"「んっ」\n僕は、ふと目が覚めると、ゆっくりと上半身を起こす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1298スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"E2A52C2A-5D57-4D2F-9133-ED7345118696","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1298","telop":"僕は、ベッドから降りると、自分の額に手を当てる。そして、ふと部屋の収納から体温計を取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1299スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"13E15424-A64E-46AD-B268-4F9AA50709C1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1299","telop":"体温を測ると、朝と比べて若干下がっていた。そして、僕は体温計を元に戻し、その足取りで浴室に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1300スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"FB17F000-4FCD-44E9-B736-B281F6C3E192","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1300","telop":"僕は、浴室から乾いた布団を手に取り、部屋に戻ると、そのままベッドに被せるようにのせる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1301スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"086A3211-BE69-4324-A5AA-BA9102719F17","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1301","telop":"僕は、まだ若干熱を帯び、頭痛が残る体で、ゆっくりと床に座る。そのまま、ボーッとしていると、インターホンが鳴る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1302スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F3542F95-D196-4B6F-9A3B-A4E909802FA4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1302","telop":"僕は、廊下に入り、「はーい」と言いながら、玄関を開ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1303スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0B8DFAF9-B3CA-486A-AAEB-B4E11752D05B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1303","telop":"僕が、玄関を開けて外を見ると、そこには、顔が頬照ったレミリアが立っていた。「どうしたんですか、レミリアさん？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1304スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3405BCCF-704B-4417-B59A-E9B43F05C83F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1304","telop":"「今日は…私の日だから…一緒に…出かけましょ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1305スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F5DAA84E-C458-4450-B1DD-322824191367","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1305","telop":"「外出するのはいいですけど、レミリアさんは大丈夫ですか、顔が頬照ってますけど。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1306スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BF5D265D-FC60-4D78-A79D-10731AB7C083","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1306","telop":"「さっき私の部屋に…咲夜が来て…デビットカードを渡しながら…『今日は操夢様と楽しんできてください』って言ってたのよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1307スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"37723CBA-F9BA-4B3F-85D1-A059D0B4B7BC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1307","telop":"「そうですか、それならどこに行きますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1308スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"ABFBBF0A-8E84-4243-AD81-720B14DD8496","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1308","telop":"彼が尋ねると私は、咲夜から受け取った映画のチケットを渡す。\n「新都心にある映画館の鑑賞チケットよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1309スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4EE43209-4A75-4E5E-A69F-D4BD2D636E0F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1309","telop":"僕は、彼女から渡されたチケットを見ると、そこには最近、公開された人工知能が支配する世界を主題にした映画が記載されていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1310スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D2B94F83-472F-4F64-90C9-36C77DC029BC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1310","telop":"「どうかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1311スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"975ABF24-0BED-4245-8F2A-1A2CA75DA44A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1311","telop":"「新都心なら、体調の不安は不要だし、いいと思いますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1312スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"92BAF30A-DF15-4398-9101-CF6F6DAE876E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1312","telop":"「なら、準備を済ませて、出かけましょ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1313スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AEE65F77-D7FC-472E-A62F-846FA90922C1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1313","telop":"「そうですね、じゃあ10分後に共同玄関でどうですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1314スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A3C4E4BE-0D71-42E3-9A8E-2D1964CF04FB","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1314","telop":"「じゃあ、10分後ね。」\n私はそういうと、自分の部屋に戻っていった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1315スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9122DBF4-0015-4E22-BD79-0E756AF8BE86","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1315","telop":"それから10分後","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1316スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"851CB4FC-AA72-4F82-8AAD-213A08335C1C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1316","telop":"私は、共同玄関に彼が来ると、あることを尋ねる。\n「寒いから、手繋いでくれない？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1317スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9C2C833A-DD77-4C21-A864-4970EA0E8961","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1317","telop":"「いいですよ。」僕はそう返すと、彼女の手を握る。\n「レミリアさんの手、十分に暖かいですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1318スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"315A4092-0F84-4771-B80D-433FE5A8F00B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1318","telop":"「えっ？」\n私は、彼の発言に思わず驚く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1319スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"410CCBE9-578C-404D-8420-050E0F74DA54","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1319","telop":"「とりあえず、駅まで歩きましょ。」\n私は、彼の言葉には返さず、そう言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1320スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"485E4A11-91C5-45F5-9855-364D2CC1B016","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1320","telop":"僕は、彼女がそう言うと、駅まで手を繋いで歩く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1321スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AE610A78-EF87-465D-92C7-0FF15B9B1FCA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1321","telop":"僕たちがホームに上がると、接近放送が鳴り始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1322スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3C09B6E7-7EB0-4699-A010-9931EF3E5A40","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1322","telop":"それから、目的地に移動して…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1323スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C3762C29-3889-4496-A5AD-244C19368EAC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1323","telop":"僕たちが新都心に着くと、再び手を繋ぎ、映画館の方へと歩き出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1324スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AE6A5BA7-3959-42EA-A59A-8409F1251B58","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1324","telop":"そして、映画館に入ると、ちょうど上映開始時刻で、席に座ると同時に映画が始まった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1325スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"17B23FF7-3715-4D9C-87AC-552FA32D0A07","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1325","telop":"二人は映画を見終わると…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1326スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AAFFE28B-11C6-4A82-8126-701A18FCE474","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1326","telop":"僕たちは映画を見終わると、映画館から出る。\nすると彼女が話し始める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1327スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3B327B4D-C259-4E7F-9F44-E053ECCD404D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1327","telop":"「なんだか、気分がスッキリしたわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1328スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E1F4AE7F-535F-47C2-BB0B-1EA277D01B6C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1328","telop":"「二人で寝落ちしたからじゃないですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1329スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"771C4E56-C257-4AD7-812D-EBBDFD647C83","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1329","telop":"「ねぇ、咲夜たちには、映画鑑賞中に互いに寝落ちして、目が覚めたら互いの肩に互いの頭を乗せてたなんて言わないで頂戴。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1330スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D619110E-2143-4BC3-ABAE-C85BABD883B0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1330","telop":"「何でですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1331スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1FD87440-735C-4436-9EA5-A5E9118A144F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1331","telop":"「えっと…、恥ずかしいからよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1332スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E069271A-DD35-4F02-9B9C-53CD28FA3A63","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1332","telop":"「そうですか…。それで、お昼を少し過ぎちゃいましたけど、\nこれから、どうしますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1333スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"894357AA-E603-4AF9-BF8E-FB55A5F9897A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1333","telop":"「えっと…、外は寒いし、モールに入ってから考えましょ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1334スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B0359427-B293-438B-8867-51645FFB6B82","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1334","telop":"「わかりました。」\nそう言うと、僕と彼女はショッピングモールに入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1335スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FFEF6CDE-D9AF-4798-B1FC-7D7FC1BF23F6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1335","telop":"僕たちが、ショッピングモールに入ると、僕は、彼女にフードコートとレストランのどっちがいいか、尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1336スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C3079BA1-6BC9-4C90-B290-E72FE9BE57C3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1336","telop":"「私は、どっちでも良いわよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1337スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A5B4DA7F-5334-44AE-ABE0-CC23D8643D42","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1337","telop":"「それじゃあ、フードコートにしましょう。」\n僕はそう言うと、3階に上がり、フードコートに入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1338スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"750AACC9-61B1-4EBE-959F-7E5EA6630FD7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1338","telop":"僕たちがフードコートに入ると、\n僕は、昼食を先に頼んでから、席に着く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1339スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"14FBA4E0-B8A6-4260-B6EC-1E7C13760DCC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1339","telop":"それから、しばらくの間、無言の時間が流れ、数分経つと、僕のブザーがなり、席を離れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1340スライド","transitionName":"なし","characterName":"レミリア・スカーレット","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"レミリア・スカーレット","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CCEACE6E-CDD7-4F5E-8A2C-19B9743F1334","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1340","telop":"すると、なぜか、レミリアは、水が入った紙コップだけをテーブルに置き、飲んでいた。「お腹空いてないんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1341スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DF500D43-D9DB-4BB2-9C59-6BBB1642E013","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1341","telop":"すると、彼女は驚き、紙コップに入った水をこぼしてしまう。\n僕は、それをバッグから取り出したハンドタオルで拭き取る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1342スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6343426F-10A4-457F-9396-3E4F59DACE89","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1342","telop":"すると、彼女は、目を閉じ、\nそっと僕のそばによると、あることを耳打ちする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1343スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"58328271-0BB6-4A25-B2C0-49F8527A4352","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1343","telop":"僕は、その内容に、彼女が何も注文しなかったことに納得し、そして、早々と昼食を済ませて、食器を返却すると、歩き出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1344スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CF6B4D17-469F-4D36-A2C2-33204B8ACA3F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1344","telop":"僕たちが、フードコートを離れると、僕は、人気がない場所を探し始める。そこで、僕たちは、ある場所に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1345スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D1DD766E-B155-46A8-B8B2-7688E2B89846","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1345","telop":"そこは、地上に広がる新都心駅の線路下を通るトンネルだった。\n「ここなら、車以外はほとんど通らないので大丈夫ですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1346スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"31B25A2E-1AEA-47F9-9B2E-FC96F4EE0838","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1346","telop":"「あっ…、ありがとう…、じゃあ、頂くわね。」\n私はそう言うと、ゆっくりと彼の首に噛み付く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1347スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"1E821F19-D134-41EE-9A0C-460D2679E2D8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1347","telop":"僕は、彼女に血が吸われていくと、だんだんと全身がくらくらしていく。そして、僕は気を失う直前に二人の女性を目で捉えた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1348スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9E43684D-E5C4-493B-88A8-380DB79BCB75","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1348","telop":"それからしばらくたち…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1349スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A46E9ED0-5F1B-48E7-B9C1-D111961E3725","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1349","telop":"僕は、ふと目が覚めると、そこは知らない部屋だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1350スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"75E9A188-2DCD-4A26-B20A-739180C90278","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 1350","telop":"「あんた、目が覚めたの？」\n私は、ふと彼にそう言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1351スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"937EE500-63FC-4A98-8441-104A8A9AA038","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 1351","telop":"「霊夢さん…こんなとこで、どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1352スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"B7FE1C70-75AD-4337-AF0D-546FC83D8570","seStartTimeOffset":0,"title":"シーン 1352","telop":"「はぁ、本当に困らせものだわ…」\n私はそう愚痴をこぼす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1353スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"66C5EBE3-0BB1-4E5C-B17D-FDC1245B4499","seStartTimeOffset":0,"title":"シーン 1353","telop":"「何があったんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1354スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"478771DB-2259-4B47-B87C-96785FDEF2AA","seStartTimeOffset":0,"title":"シーン 1354","telop":"「とりあえず、今から事情話すから、しっかりと聞きなさいよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1355スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1DD3C098-E868-47EF-81FC-9E033F92EFBC","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1355","telop":"時は数時間前に遡り…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1356スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"2905362D-BB42-4DAE-807A-C1392BC7B803","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1356","telop":"「おや、お二人さん、こんなところでどうしたんですか？見た感じ、彼は血がついた状態で気絶してますけど…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1357スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"F5B34EFD-0869-4255-80CC-2370568A0685","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1357","telop":"「彼の血をお昼ごはんとして頂いたら、彼が倒れちゃったのよ…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1358スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"9C9FDF81-E07F-4BE2-AD66-B2F71C8A6C6B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1358","telop":"「では、なぜ吸血鬼のあなたがこんなところに…、彼とデートでもしてたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1359スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"65CBDF6F-C22F-49A9-8D07-9B3BBE212F74","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1359","telop":"「そんな…これは、デート…」\n私はそこまで言いかけて、自分が彼と何してたかを把握する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1360スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"E847CD17-004F-499F-B8D1-C0A516C57DE3","seStartTimeOffset":0,"title":"シーン 1360","telop":"「そうよ、彼と映画館デートよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1361スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"5029F828-AC66-4269-A933-9F56A00637AB","seStartTimeOffset":0,"title":"シーン 1361","telop":"「それにしては、吸血しすぎではないですかね、何か理由でもあるんですか？普段少食なあなたなら、これは起こりにくいし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1362スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"FEC96522-4AD6-4285-AE05-1A903A8AD0F3","seStartTimeOffset":0,"title":"シーン 1362","telop":"「彼は、もともと貧血気質だったから、ただそれに拍車をかけちゃっただけよ、私は飲み過ぎてなんかないわ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1363スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"C7B032AD-AC56-4323-A84F-62D6D4C178F0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1363","telop":"「おや、今この場で、彼の血を飲んだことは事実なんですか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1364スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"047D8AC5-1F88-4903-B530-A7CA9728A269","seStartTimeOffset":0,"title":"シーン 1364","telop":"「うっ、そうよ。お腹が空いて、彼の血を飲んだのよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1365スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"7449962B-EE83-46C1-8950-FA375806BC17","seStartTimeOffset":0,"title":"シーン 1365","telop":"「ふーん、それで、彼の服に血が付いてますけど、これからどうする予定なのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1366スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"DE779DE4-61D6-4692-A46E-DEF589C2D2BB","seStartTimeOffset":0,"title":"シーン 1366","telop":"「それは…何とかして…列車で帰るわよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1367スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"211CC8CF-8B89-4EA8-A51E-0F4E7F9BEF92","seStartTimeOffset":0,"title":"シーン 1367","telop":"「何とかするね…あの紅魔館の主と言うべきお方がそんな発言をね…大スクープですね。今から、警察に通報でもしますか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1368スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"6894A734-DD4D-42A8-8359-AAA2495DB19E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1368","telop":"「それは…絶対よして…警察沙汰だけは避けないと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1369スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"E6C0902B-1149-4FFA-AED0-9C4864246417","seStartTimeOffset":0,"title":"シーン 1369","telop":"「ふ〜ん、公道で彼の血を吸っているのに、その事実は警察に知られたくないのですか…、それは矛盾ですよ、吸血鬼さん。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1370スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"DDCCA6FF-FC62-477B-A927-3A14192DE9D5","seStartTimeOffset":0,"title":"シーン 1370","telop":"「くっ…、じゃあ文は…、どうすべきだと言うのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1371スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"65CD1D0C-8CB6-4062-93B7-E98DE886B711","seStartTimeOffset":0,"title":"シーン 1371","telop":"「今、すぐそばに、私の車がありますから、徒歩で帰るよりかは、安心ですよ。ただ乗りさせるわけでは、ありませんがね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1372スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"20EA8826-689F-4B9E-8969-CE7E92DD1336","seStartTimeOffset":0,"title":"シーン 1372","telop":"「分かったわ、じゃあ、彼を乗せるの手伝ってちょうだい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1373スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"046FF251-EDAF-4DAE-933C-6BCEB082897F","seStartTimeOffset":0,"title":"シーン 1373","telop":"「承知しましたよ…カリチュマお嬢様…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1374スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"381556D5-CDCF-46DC-B5D2-324B1F222C50","seStartTimeOffset":0,"title":"シーン 1374","telop":"「嫌みな女よね…文は…、他者の弱みに漬け込んで…」\n私は、ここに来るまでの経緯を彼に伝えると、そう呟く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1375スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"31AC7E78-9511-496B-B7B1-6A660B6F2B2A","seStartTimeOffset":0,"title":"シーン 1375","telop":"「何で、警察沙汰になったりスクープになったりするのは嫌なんですか？」僕は、彼女にそう返す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1376スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"134302F8-89A2-435F-9335-1CD38B9C1C8A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 1376","telop":"私は、彼の発言に思わず驚いてしまう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1377スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"C5B8CF55-664F-4990-8DB4-332079C63C41","seStartTimeOffset":0,"title":"シーン 1377","telop":"「あんたね…、まぁ、これを話し出すとキリがないから、今は言わないけど、ちょっとは世間に耳を傾けたらどうかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1378スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"A73C1522-A619-4442-BDE5-77A7F4F9A096","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","seStartTimeOffset":0,"title":"シーン 1378","telop":"私は、自分の発言に思わず、ハッとする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1379スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"6EABC9A8-B7B4-422D-BE0B-E0C66968FF4F","seStartTimeOffset":0,"title":"シーン 1379","telop":"「あんたには、難しいのかしら、そういうことは…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1380スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"7F66F4E1-8B74-4239-A0A9-12F623F5E08C","seStartTimeOffset":0,"title":"シーン 1380","telop":"「とりあえず、用は済んだし、一緒に帰るわよ。」\n私がそう言っていると、誰かが部屋に入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1381スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"1D3B9B6E-A287-45B4-946E-FADA5DF928FD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1381","telop":"「あら、霊夢さん、こんばんは。それと、そこのあなたは…幻武操夢さんですね…、初めまして、私は射命丸文と申します。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1382スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"DC0E40DD-FBC2-45F9-9C02-AB9DDF9B290F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1382","telop":"「こんばんは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1383スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"10D407BF-6783-4E5C-8428-CCE86B1110D6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1383","telop":"「霊夢さんから、例の一件はお聞きになりましたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1384スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"1A8086B5-6FD9-4806-A087-448DF34F074D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1384","telop":"「えっと…、はい…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1385スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"9888D5A9-B5FB-4E65-895F-386DCD326065","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1385","telop":"「そうですか…、そういえば…、今晩は…、何か予定でもありますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1386スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"150FC4C9-1150-401C-A5B3-6FD789A9C376","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1386","telop":"「えっと…」僕はそう言いながら、霊夢を見る。\n彼女は、怖い笑みを浮かべていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1387スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"943C941E-A25F-4149-A612-AF08CCAEC376","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1387","telop":"「おや、霊夢さん。そんな表情をすると、彼が怖がりますよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1388スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"1E0588A9-4CA0-470A-833F-87C87EC73B2B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1388","telop":"「文こそ、何言ってるか理解してるの？彼は、私たちのテリトリーに住んでいるのよ。それが分かってるのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1389スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"066719D8-4077-467A-B3AD-B2AA61303EAE","seStartTimeOffset":0,"title":"シーン 1389","telop":"「だから、何だって言うんですか…。彼はみんなの物でしょ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1390スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"038DCA51-584A-4099-BB4A-9C8764F0899A","seStartTimeOffset":0,"title":"シーン 1390","telop":"僕は、文がいう、「みんなの物」とはどう言う意味か、わからず、場の空気に困惑していると、再び誰かが、入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1391スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"EFD0A031-C7EA-4889-B14D-2452C633E48C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1391","telop":"私が、その部屋に入ると、今にも弾幕戦が始まりかねない、その凍りついた空気に、さっと彼を手元に寄せ、連れていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1392スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc256896_病室-昼.png","id":"D7251262-8B29-4231-802C-BF1BADAE1778","seStartTimeOffset":0,"title":"シーン 1392","telop":"「ほら、とんずらするから、箒に乗れ。急がないと、霊夢と文がきちまうぞ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1393スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"7C487ACF-60C6-475A-8EA6-692435558FC7","seStartTimeOffset":0,"title":"シーン 1393","telop":"「分かりました…。」\n僕はそう言うと、彼女の箒にまたがる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1394スライド","transitionName":"なし","characterName":"古明地こいし","animationName":"バウンス","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地こいし","backgroundName":"nc256896_病室-昼.png","id":"C1F465A5-CC3D-45AB-8C05-8C36F0D8F157","seStartTimeOffset":0,"title":"シーン 1394","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1395スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256896_病室-昼.png","id":"D4FEE737-D85D-4C0C-AEE4-B5DBF1AF268A","seStartTimeOffset":0,"title":"シーン 1395","telop":"すると、彼女は急上昇し、夜の空へと飛び出す。僕は、反射的に彼女に全力で鷲掴みして、落ちないようにする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1396スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc256897_病室-夕方-電気あり.png","id":"4797B8B4-F235-4B95-B715-57F2FD505A9A","seStartTimeOffset":0,"title":"シーン 1396","telop":"すると、強い風が吹き、僕は、その風に耐えきれず、思わず手が彼女から離れ、箒から真っ逆様に落下する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1397スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc212905_【背景】ビルの屋上.pxd","id":"F54A6410-0FC7-422E-876F-AA539F42350B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","seStartTimeOffset":0,"title":"シーン 1397","telop":"「これは、運がいいことに、あなたが私の手元に落ちてきました。それで、次は、どうしますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1398スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc212905_【背景】ビルの屋上.pxd","id":"004E05B0-CC3E-4DA4-BB33-E173FFA037F9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","seStartTimeOffset":0,"title":"シーン 1398","telop":"「次はって…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1399スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc212905_【背景】ビルの屋上.pxd","id":"8EA260D6-1D4D-4B00-93B6-ED9F4E524FCD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1399","telop":"「おっと、私たちには時間の猶予がないようですね。では、私があなたを背負いますので、私にしっかりと掴まってください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1400スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc212905_【背景】ビルの屋上.pxd","id":"98ECD89F-6FB3-415C-900F-8A30CFE9B8B7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1400","telop":"僕が、その場で困惑していると、下から誰かが駆け上がる音がし、仕方なく彼女の言う通りにする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1401スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc212905_【背景】ビルの屋上.pxd","id":"FE336BAB-06A5-4344-B38B-B3BDF9E96DDC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（笑い）.png","seStartTimeOffset":0,"title":"シーン 1401","telop":"「よし、それじゃあ、私たちのお家に飛んできましょう。」\n私はそう言うと、彼をおんぶした状態で空へと飛び出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1402スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0607B5F1-71D7-493D-9790-D25D3FDFD2EA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1402","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1403スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"933D7130-52EF-405D-BDB1-5E16E0306DA0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1403","telop":"僕は、文と一緒に、ある界隈でグンマー帝国などと呼ばれる群馬県の山間にある彼女の家に来ていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1404スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FA530370-C4F6-4535-A910-303376AF2D33","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1404","telop":"そして、彼女はここにくると、彼女が先に風呂に入り、僕も、彼女に案内されて浴室に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1405スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2DFD0C5C-EA87-42CF-BA8D-21BB8094D873","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1405","telop":"僕が、浴室に入り、全身を洗い終えて、湯船に浸かると、換気扇からある匂いが入ってきて、僕はうとうとしていき…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"1AE3717D-068A-42E0-8E9F-365A87B60D57","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"1DFF3346-FC05-42B7-861C-8A7AF718CEE6","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1408スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E9EE9843-9743-4E7F-A53F-F57B7DE6330B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1408","telop":"「んっ…あれ…ここは…？」\n僕は、ふと目が覚めると、そこは知らない場所だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1409スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"7E969BFF-E19A-4875-A1B5-0D688E427ED9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","seStartTimeOffset":0,"title":"シーン 1409","telop":"「おや、目が覚めましたか？」\n私は、辺りをキョロキョロ見回す彼に尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1410スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"97F44417-D564-4EFF-B423-3691FB521D4B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","seStartTimeOffset":0,"title":"シーン 1410","telop":"「あの…、ここは…どこですか…」\n僕は、確か文と名乗っていた彼女に尋ねる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1411スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"8797CDA8-4CA0-4C06-A423-AE534AF2627B","seStartTimeOffset":0,"title":"シーン 1411","telop":"「ここは、私の家です。それで、あなたはどうしますか？\nご飯ですか、お風呂ですか、それともわたし？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1412スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"8F6E6AF4-83F3-449C-846E-1F636EADB9D2","seStartTimeOffset":0,"title":"シーン 1412","telop":"「『わたし』って、どういう意味ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1413スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"24B2C127-4FDD-44F9-B35A-CD057C64DFB1","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（驚く）.png","seStartTimeOffset":0,"title":"シーン 1413","telop":"「知らないのですか、有名なセリフですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1414スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"21E21740-470D-4D11-83F0-94D33B680F51","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（驚く）.png","seStartTimeOffset":0,"title":"シーン 1414","telop":"「へぇ…、とりあえず、お風呂に入りたいです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1415スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"9243B093-DC4B-446F-B1BF-8A49AA3B69F9","seStartTimeOffset":0,"title":"シーン 1415","telop":"「わかりました、では、とりあえず、浴室に案内しますね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1416スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"8E17F8F5-A157-4688-88EA-39DF2171EF92","seStartTimeOffset":0,"title":"シーン 1416","telop":"「この扉の向こうが、浴室ですから、湯船も溜まっているので、じっくりと入ってきてくださいね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1417スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FD5B4500-F1B1-4B7C-9306-12EE71B8A731","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1417","telop":"彼女は、そう言い残すと、部屋から離れていった。\n僕は、洋服を脱いで、適当に置くと、浴室に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1418スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FF9A68DA-ECD8-4E0C-88D9-D1D698DA4BCD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1418","telop":"僕は、浴室に入ると、そこには湯気が沸いた浴槽があり、僕は、ふと手を入れて、温度を確かめてから、シャワーを浴びる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1419スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F4ED1156-D4D1-4F84-BA75-20C58541A4AF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1419","telop":"僕が、シャワーを浴びると、浴槽にゆっくりと入る。\nすると、換気扇からある匂いが漂い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1420スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D8E75DA6-B9C4-4506-9EDF-3FAF648B4B99","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1420","telop":"すると、僕は湯船でうとうとする。\nやがて、その匂いに包まれる感覚がすると、目を閉じた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1421スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"94BDCD90-6349-4589-816B-57C1B8396D3D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1421","telop":"私が、ハッと目を覚ますと、そこは浴室だった。\nふと脳が動き、ここが鴉天狗の家であることがわかる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1422スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9B9330D5-1F52-47B5-A943-223BFAA08FC5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1422","telop":"私は、そっと浴槽から出ると、タオルで全身を拭き、浴室から出ていく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1423スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E3572176-AAF0-4F53-84A5-BCDBA1712B5B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1423","telop":"私が浴室を出ると、彼の脱ぎ捨てた服があった。ふと洗濯機の上を見ると、そこには彼の服とそっくりな服がありそれを着る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1424スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"660646DE-603C-4D33-BDE0-4513819148B6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1424","telop":"私は、ふと鏡で自分自身のスタイルを確認すると、目を閉じる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1425スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6F48ED29-FA30-4972-950F-DDAA447FE958","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1425","telop":"「よし、これで通信は終了と。」\n私はそういうと、ふとゆっくりと目を閉じ、彼の姿に戻った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1426スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A2D044EE-2D4C-4032-B2E7-8AB79C79A36A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1426","telop":"僕は、ふと気がつくと、さっきの部屋に戻っていた。\nすると、誰かが入ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1427スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"34AD0C11-A353-44E5-9177-C58EADCC3DFE","seStartTimeOffset":0,"title":"シーン 1427","telop":"「今日の晩御飯がちょうど出来上がりましたよ。」\n私はそう言いながら、テーブルに料理を並べる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1428スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"D4D313F4-21F5-4478-9591-2525FD159CD1","seStartTimeOffset":0,"title":"シーン 1428","telop":"彼女は食卓に、晩御飯を並べ終えると、一緒に食べ始める。\n僕たちは、それから数十分でご飯を食べ終える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1429スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"20FE99AC-9758-4D69-B183-A22F46D63BDC","seStartTimeOffset":0,"title":"シーン 1429","telop":"「では、食器を洗ってくるので、しばらく待っててください。」\n私はそういうと、空の食器を台所へと運び出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1430スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"98032485-9F99-437A-9398-AB73ED765B25","seStartTimeOffset":0,"title":"シーン 1430","telop":"私は、食器洗いを終えると、寝室で着替えて、彼の元へ向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1431スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"69B06EE2-10AD-4075-BC93-D469E46E72D0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（微笑）.png","seStartTimeOffset":0,"title":"シーン 1431","telop":"「それでは、早速あなたについて、聞きましょうか…。」\n私はそう言い、彼への取材と題した質問責めをした。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1432スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"58E6BC14-F9DA-4877-A9CF-A42EA70613CD","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1432","telop":"質問責めが始まってから数十分後…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1433スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"A909E45A-7553-44E9-A5B5-5BC8AA36B8FD","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1433","telop":"私が、次々と彼に質問を投げかけていると、玄関の方から音が聞こえ、私は、玄関に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1434スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"F9D9CC3C-2FAF-4099-828B-86DE1D276A1A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1434","telop":"私は、玄関を開けると、荷物が置かれていた。\n私は、それを玄関に置き、中からある瓶を取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1435スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"FF584C0B-0A50-4B01-9271-2169B4ECF780","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1435","telop":"「お待たせしました…」\n私が、再び戻り、彼を見ると、うとうとしている彼がいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1436スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"620B0572-73B2-4558-BDBB-783237D8F06A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1436","telop":"「おっと、まだ寝る時間じゃないですよ、操夢さん。\nこれ飲んでみたらどうですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1437スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"6843902E-E535-49B5-912E-9DC801E1B6FC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1437","telop":"彼女がそう言いながら、見せたのは有名な炭酸飲料だった。\n「僕は、炭酸飲めないんですけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1438スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"C60DE447-AC69-41EE-ADAA-7FB9FA0368DF","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1438","telop":"「これは、単なる炭酸飲料ではありませんよ。ある特殊な成分で成り立っているので、きっと操夢さんでも飲めますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1439スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"132FC52D-5F97-4423-90D5-F75D3FD6B7B3","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1439","telop":"「そうですか…」僕は、そう言いながら、ふと好奇心が湧き、その瓶を開けて、喉が渇いていたのか、それを一気に飲み干す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1440スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":6,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"8DB175C7-1692-4856-8265-40ED37188ADE","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（余裕）.png","seStartTimeOffset":0,"title":"シーン 1440","telop":"彼は、その瓶を一気に飲み干すと、全身がピクピクし出す。私が、声をかけても反応はなく、そっと抱き抱えて、ある場所に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1441スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"153CB370-5AE0-4518-A9A2-C9ABC13410C1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1441","telop":"私は、彼を抱き抱えた後、空を飛び、首相官邸の地下深くに眠る発電所のある一室に来ていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1442スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B2EAEAF5-380A-48D3-808F-D4097D31813C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1442","telop":"私は、まるで眠っているような彼に、特殊な器具を当てはめ、目の前に見える円型機械の制御盤に接続する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1443スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E4DBA5D9-3B0F-43FA-911B-B65BA544AAFC","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1443","telop":"すると、部屋の扉が開き、にとりが入ってきた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1444スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1F8441CB-250F-4B62-A98F-C15C48D33A96","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1444","telop":"「それじゃ、始めようか。」私はそういうと、慣れた手つきで制御盤を触り、プログラムを起動させる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1445スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8D3C6155-A789-4B7A-AA54-6A6CFB533B90","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1445","telop":"「プログラムを読み込み中です。機器の相互干渉を防ぐため、接続している機器の電源は入れないでください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1446スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"929DDC6B-89A8-4AF0-AAB5-58594DA8FCF1","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1446","telop":"「続いて、接続している機器の情報を読み込みます。データの破損につながるため、絶対に接続を切らないでください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1447スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"85A44F69-9ECB-4B67-93F3-C5A991951F0A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1447","telop":"「最後に、プログラムのチェックを実行します。機器または機械の故障の原因になるため、電源は落とさないでください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1448スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"25409C04-C917-4E64-AC7B-D1296030439D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1448","telop":"「システムに接続中…時間がかかることがあります…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1449スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"ED1EA779-4FE5-46A9-A2E3-4B7210730749","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1449","telop":"その円型機械がそう告げると、コンピューターの高速処理が始まり、インターネットに繋げ、プログラムを実行に移す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1450スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6942B361-79FF-426A-A5C5-63FB5CBA5042","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1450","telop":"「システムが無事に起動しました、次に実行するプログラムを送信してください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1451スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6CFE27DA-8CA5-4AF2-804A-A47440AD469C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1451","telop":"私は、再び慣れた手つきで、機械に命令を送信する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1452スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7214A07C-ACA5-4217-8153-50663F4FE6CE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1452","telop":"「プログラムを読み込んでいます…読み込みが終了しました、続いて接続機器の状況を確認します…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1453スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2ABD3D5C-4595-4154-B4CF-61E0C3074BA4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1453","telop":"「接続機器の状態が悪いです…この状態で続行には、リスクが伴います。接続を切るか、続行するか教えてください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1454スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A4614A88-57FD-496E-8A54-024BF55B5ED2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1454","telop":"私は、一度彼女の方に行き、状態を確かめる…。すると、LANケーブルが接続されておらず、私はサッと接続させる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1455スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F5FDFF99-D8C2-42BC-9D2F-0DB5B1FD6C1F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1455","telop":"「再検証中です…、接続機器を正しく読み込みました。ネットワークに再接続します…プログラムを実行中です…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1456スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"57EDBA3B-1AB8-4788-9E72-B26B49F61DC0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1456","telop":"「接続機器の内部情報を読み込みました。データベースとの照合を確認します…照合が完了しました。状態を確認します…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1457スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D9A09325-DA48-49D3-82DE-528BCA8EC31B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1457","telop":"「警告、お使いの接続機器は、外部から不正干渉を受けている可能性があります。詳細を確認する場合、申し出てください。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1458スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1486EF3F-1337-4AAB-B508-A97FBADCF7D3","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1458","telop":"私は、紫から聞いていた話が、事実であることがわかり、驚く。だが、すぐにその詳細を確認するように送信する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1459スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"58E6BE4C-58FB-4865-8482-3873E7D38372","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1459","telop":"「警告の詳細を確認中です…この接続機器は、製作者とは異なる者が、干渉行為をしている可能性があります。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1460スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F2C600F5-D3C1-4A42-B39A-593BEC7A0C41","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1460","telop":"「製作者の詳細を読み込もうとしましたが、私には権限がなく、読み込みが失敗に終わりました、不正干渉を確認中です…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1461スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CCDD70C5-7D2F-4B31-AC9B-6B0EFDA01ED8","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1461","telop":"「不正干渉先のデータベースにアクセスします…干渉内容を調査しています…情報を精査しています…完了しました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1462スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"917401E5-64F1-4AD6-A1E5-BE282E6DCCB8","seStartTimeOffset":0,"title":"シーン 1462","telop":"私は、にとりが操作するその操作盤に表示された情報に驚く…。\n「噂では…流れてましたが…本当に実行するとは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1463スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（怒る）.png","id":"2AB9FE9A-B055-4BC9-B0A2-AA62BB9F6E45","seStartTimeOffset":0,"title":"シーン 1463","telop":"「一体、奴らはどうやって彼に、女性の人格とコンピューターが埋め込まれていると知ったんだ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1464スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"2527CE50-9791-4EB8-8BDF-0FB156D9295D","seStartTimeOffset":0,"title":"シーン 1464","telop":"「私も、紫からお達しで、彼を霊夢たちから奪い去りましたが…、まさか紫が言っていた言葉が現実になるとは…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1465スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"978AE32F-AB61-4D31-B6CC-3AD96DAE5EBD","seStartTimeOffset":0,"title":"シーン 1465","telop":"「にしても、現代の医学と科学技術はどこまで、発展してるんだ…、ヒトにコンピューターを埋め込む技術を生み出して…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1466スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"213B23D8-4AE9-49A3-8E02-0DA58D4F398B","seStartTimeOffset":0,"title":"シーン 1466","telop":"「これは、ゆかりん党の鎖国政策が、功を制しているのでしょうか、これが海外に知られたら、すごいことになりますよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1467スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"9B27141B-3861-47ED-9C94-480167AFA238","seStartTimeOffset":0,"title":"シーン 1467","telop":"「なんだか、過去に類を見ない規模のスクープが出来上がりそうで、ワクワクしますね…、この情報をどうしますかね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1468スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"A6901FB9-128A-44E5-A0B7-EB0C0E07E68B","seStartTimeOffset":0,"title":"シーン 1468","telop":"「私たちも河童の技術力を武器に、どうしたら彼のような存在が出来上がるのか、熱心に研究しないと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1469スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"A20CDC2F-8FB6-471A-974F-7092AE846447","seStartTimeOffset":0,"title":"シーン 1469","telop":"「とりあえず、誰にも気づかれないように、ささっとこの場から撤退して、互いの拠点で彼を探索するとしますかね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1470スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"9A1A14E7-8EE9-48F0-BBFB-D995669952DC","seStartTimeOffset":0,"title":"シーン 1470","telop":"「そうだな、とりあえず、紫には、干渉先を潰しましたと伝えて、肝心の彼の事実は、ひた隠しにするのが得策か…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1471スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"00C265FA-8542-46F8-8C26-6269F9223047","seStartTimeOffset":0,"title":"シーン 1471","telop":"「それなら、その言葉を実現するために、私がこの情報を巨漢党の特大スクープネタにしますかね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1472スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"88F49D07-0560-4F19-9ACA-B7112885F0A0","seStartTimeOffset":0,"title":"シーン 1472","telop":"「それなら、私たちも、その騒動の裏でヒソヒソと彼の研究を進められる…、こりゃあ、名案だ…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1473スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"DDE4DFFE-4294-4083-A38E-9716E2B5C610","seStartTimeOffset":0,"title":"シーン 1473","telop":"「とりあえず、彼の身柄は夜が明ける前までに、そっと霊夢たちのところに戻しますか…、要件は済んだんだし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1474スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"咲夜（怒る）.png","id":"88F1E7DA-6C04-4478-823C-85B3D06EE604","seStartTimeOffset":0,"title":"シーン 1474","telop":"「そうだな、じゃあ私も、即刻拠点に戻って、彼の存在にまつわる研究を進めるとするよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1475スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"85ED4AEE-D433-414F-BB9F-CAB184BB9781","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1475","telop":"その時、某所では…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1476スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D9CB3233-CCF3-4458-ADA0-17E5BB877760","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1476","telop":"「大河課長、例の彼なのですが、課長の指示に従って、彼の情報にアクセスした結果が判明しました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1477スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BC910255-24B1-492D-85DB-559D0A1FBEF4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1477","telop":"「そうか、それで私が聞いた噂は正しかったのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1478スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AB942AE8-BC8B-4E66-B262-AA9D270A9A54","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1478","telop":"「ええ、彼には、コンピューターが内蔵されていて、それにアクセスして位置情報が取得できました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1479スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AE000DF1-60ED-42C9-B3E1-3C794BC0486C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1479","telop":"「それで、場所は？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1480スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4FF7319C-0703-4B41-B5AE-01A9F749019F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1480","telop":"「ゆかりん党が最初に、政治の実権を獲得した、群馬県の山間ににある、和風建築の住宅です。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1481スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BBC7B20E-BF0A-4CA7-8F42-E244AB0E947F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1481","telop":"「そうか、それで他に情報は獲得できたのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1482スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"E9C6D7EB-DDC5-441E-867A-6BC0B14C26D2","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1482","telop":"「ええ、彼のコンピューターから抜き出した情報がこちらです。」私は、そう言い、資料を見せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1483スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"171B1B01-06A7-4973-AA40-15CB4FB2800E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1483","telop":"私が、その資料を見ると、彼にコンピュータを埋め込んだ製造者を確認する。だが、それを見た途端、驚愕する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1484スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B7F61FDB-E582-4915-ABAC-44300A47B454","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1484","telop":"「どうしましたか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1485スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F15A2500-E22B-4701-BD17-A9BB8D805F09","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1485","telop":"「お前も見てみろこれ、製造者の欄がAIになっているぞ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1486スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"09CF34B8-A527-4441-A9CA-6C73A0B5FD66","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1486","telop":"「一体どういうことです、AIが彼にコンピュータを埋め込んだとでもいうのですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1487スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":4.3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DE32DD74-F269-406B-8401-8407242041A7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1487","telop":"「だが、なぜ機械が人間にコンピューターを埋め込めるのだ？\nしかも医師ではない、AIが？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1488スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"39527EA4-94A4-46AC-A705-51B9E5334C02","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1488","telop":"「さあ、わかりません。ですが、何か裏がありそうですね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1489スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"EA283145-FF47-49A7-98D7-783E2DA96F79","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1489","telop":"「とりあえず、この情報は極秘扱いにして、絶対に外部、特にゆかりん党に漏らすな。隠蔽工作を上に命じておくから。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1490スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0C72829C-C4FA-4973-82B4-79F75E558585","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1490","telop":"「承知しました、大河課長。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1491スライド","transitionName":"なし","characterName":"八雲紫","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"八雲紫","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9FB045F0-AA43-4AA4-8CC3-2FEDEBE58595","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1491","telop":"彼に視点が戻り…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1492スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FD785D05-92D2-4B77-927D-D4BE529BB7B5","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1492","telop":"僕は、ふと目が覚めると、そこは朝日が差し込む、自分の部屋のベッドだった。そして、ベッドを降りる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1493スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6C8919BF-9BFB-41C4-ADB7-04C07F81620C","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1493","telop":"僕は、ベッドから降りると、廊下にある冷蔵庫からいつものように冷凍ご飯と醤油、お皿と箸を取り出し、卵かけご飯を作る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1494スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"99A31554-5548-461A-831D-F0CCB0ABAE8F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1494","telop":"「もう、食べ物がない…、買い出ししないと…」\n僕は、そう言いながら、部屋に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1495スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"FDB3998B-27EE-488E-AFE2-D75DCA56C07E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1495","telop":"僕は、部屋に戻ると、10分程度で朝食を食べ切り、後片付けを済ませると、ふと思い出した足取りで共同スペースに向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1496スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"492EB4ED-94A7-4A66-946D-745E34D3ED9A","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1496","telop":"すると、レミリアが、僕を見つけるなり、話しかけてくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1497スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"CC2AF272-1DF8-46E3-89F3-96D8293002BB","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1497","telop":"「あんた、この新聞見てみなさい。」\n私はそう言い、早朝に届いた特別号の新聞を見せる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1498スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":7.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"3EDCE230-D56B-4CD3-9D95-35C46DAE7307","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1498","telop":"僕は、レミリアに渡された新聞を見ると、そこには「巨漢党が不正アクセス禁止法違反で、検挙、国政政党がゆかりん党のみに！」と見出しが記載されていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1499スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"8596A5BD-50ED-41F4-89C9-FD84D273E594","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1499","telop":"僕は、そこでこないだ届いたPCを思い出し、咲夜にどこに収納したか聞くと、それを取り出し、モニターに繋げて起動する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1500スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2A17BDF9-FEBE-4A6D-9344-B5B091492A03","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1500","telop":"僕は起動すると、右上の吹き出しをクリックする。\nデモンストレーション\nこれは、デモンストレーションソフトです。\n実際のPCでコンピュータの凄さを知りましょう。\nデモを閉じる\n今すぐ試す\n初期化したい場合はこちら\nNews\n巨漢党が消滅か…\n文々。新聞が報じた不正アクセスにより、検挙され、解党以外の選択肢はなし…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1501スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"咲夜（怒る）.png","id":"C4C6EE4C-0DF8-4F33-BF1E-C98F3A24EFD7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"title":"シーン 1501","telop":"僕は起動すると、右上の吹き出しをクリックする。\nこれは、デモンストレーションソフトです。\n実際のPCでコンピュータの凄さを知りましょう。\nデモを閉じる\n今すぐ試す\n初期化したい場合はこちら\nNews\n巨漢党が消滅か…\n文々。新聞が報じた不正アクセスにより、検挙され、解党以外の選択肢はなし…\n巨漢党が消滅か…\n早朝、私は、衝撃的な事実を知った。\nそれは、巨漢党がある国民の、位置情報や\nその他の情報を不正に入手していることだ。\nその事実は、私とある技術屋が紫総理の指示\nによる共同調査で発覚し、紫はこの事実を受け、\n警察に巨漢党を検挙するよう通達し、\n警察は総理の指示に従って、巨漢党を検挙した。\n今のところ巨漢党からの発表は何一つなく、\n私が電話で問い合わせたところ、回答は\n得られずじまいとなった。また、これにより\nInternetBrowser\nbunbunmaru.news\/syameimaru-aya\/巨漢党が消滅か\nこの記事の作成者\nであり記者の私\n射命丸文\nゆかりん党の\n党首で総理大臣の\n八雲紫\nすると、ブラウザが開き、画面には昨晩僕を、連れ攫った彼女と八雲総理の画像が両脇に表示されたニュースが映った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1502スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"1CB6CBD9-80F1-4353-8F4D-04B0F16ABB9C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1502","telop":"「それにしても、紫はこれからどうするつもりなのかしら？」\n私は、ふとそう呟く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1503スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（困る）.png","id":"77B80948-62A0-4DF8-87B6-D452A4946B75","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 1503","telop":"「たしか、今この国の中心にある政党は巨漢党とゆかりん党のみなので、もし巨漢党が潰れれば、ゆかりん党のみになるはず…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1504スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"EB9716E7-2311-4DFE-A8C9-9836AA8ABE39","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1504","telop":"「もし、ゆかりん党のみが国会の議席を有することになれば、それは実質的な国政選挙の廃止につながりますね…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1505スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"CCB2AF8A-DBFA-4976-8F58-F90970987AF0","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1505","telop":"「実質的な国政選挙の廃止？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1506スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"DC7EE1D7-C007-47D5-91FB-2FF456EC6A69","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1506","telop":"「簡単に言えば、ずっと紫がこの国のトップに立ち続けることになるのよ、フラン。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1507スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"AD8CA9E6-C71F-4B2A-9703-37873162A5D6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1507","telop":"「それだと、何か問題でもあるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1508スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"C3A1E34E-04E2-4935-BD59-145B8AB7EAE7","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1508","telop":"「う〜んとねぇ…」\n私はそう言いながら、思考を働かせると思い出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1509スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"A44E7730-B6F8-42F6-9701-177560FB0F8D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1509","telop":"「よく考えれば、紫は私たちの仲間みたいなものだし、なんの問題もないわね…、心配する必要はないわ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1510スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"44464969-4562-40FE-BAEB-F2DFA1152C95","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1510","telop":"「そうなんだ、ならよかった。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1511スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"8576ABBC-F2DA-43B7-AF0B-3DAF140AB9A4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1511","telop":"「それで、操夢はこれから何か予定でもあるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1512スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"6CAB183A-D0FE-4505-A76F-20355359EB0A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1512","telop":"「僕は、この段ボール箱にあるパソコンを各部屋への設置作業でもしようかな…、新聞だけだと情報が少なすぎるし…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1513スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"E212ECD4-240A-4A5D-8D08-F11AD7A7D12A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1513","telop":"「確かに、それもそうね。じゃあ、私たちも、それ手伝って、みんなでパソコンにでも触れようかしら…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1514スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"CAB564E7-F4BA-4EA5-B12D-C90359BDB201","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1514","telop":"「私も触ってみたい！」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1515スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"咲夜（微笑）.png","id":"417B2638-CCBE-42B7-99B7-4DDEE4CE4E66","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 1515","telop":"「私も、お嬢様と同じくパソコンに触れてみようと思います。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1516スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"D5A7EA26-AE6B-4AE0-9167-276214DCAD73","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1516","telop":"「それで、さとりさんはどうしますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1517スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"BDE5DDBA-2784-46E7-9EF0-3C901C8602B9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1517","telop":"「私も、パソコンを触ってみようと思います。あと、こいしも起こして、声をかけておきますね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1518スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"DE799A5D-66EF-4D33-824B-04D2764D8315","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1518","telop":"「私も、たまには読書じゃなくて、パソコンを触ろうかしら。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1519スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"博麗霊夢","backgroundName":"リビング（日中）.jpeg","id":"05AE205A-7B72-4B87-A5AC-A69820DDDF4D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1519","telop":"「じゃあ、霊夢と魔理沙は仕事だし、私たちは各自パソコンに触れる時間にでもしましょうか。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1520スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"7E12D1C1-86CA-4C85-B24C-EC5F8697B25E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1520","telop":"それから、僕たちは、パソコンの設置作業を済ませて、パソコンに触れて時間を過ごすのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1521スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A766AD94-B21D-4C89-9DB7-038C1D9C0DD6","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1521","telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1522スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"450CA1BA-D5F9-41F1-A00F-7BBF319B976D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1522","telop":"僕たちはパソコンの設置を済ませると、自分の部屋に行き、早速パソコンを起動して、初期化と初回設定をする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1523スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"9451A9F4-A6E3-4D5B-B2FB-E1BCBFCDF95A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1523","telop":"そして、パソコンの初回設定が終わると、ポケベルを起動して、パソコンに繋げて、ポケベルの初回設定を実施する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1524スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"一人部屋３（日中）.jpg","id":"1D6102E8-4DED-4B30-BC17-2C2422364895","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 1524","telop":"そして、ポケベルの設定が終わり、ふとラジオを聴くと、八雲総理の緊急記者会見の音声が流れ始め…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"D733E72B-1637-4449-9508-C56AB84A736D","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"24B31493-C35E-47F5-A9AE-D44B63590AD7","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1527スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"CE83DD49-3ED9-4C05-B45B-02C06086B691","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1527","telop":"僕は、先ほど一度起動したパソコンの電源を一度落とし、段ボールから皆にパソコンを配っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1528スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"F8AD81B2-6DF2-4489-96DD-015886D5774B","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1528","telop":"そして、霊夢と魔理沙と自分用の子機3台を除き、周辺機器やポケベルも配り終えると、僕は先ほど電源を切ったパソコンの設置場所を考える。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1529スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"C52117A5-728F-4D4E-B85D-513B0A4F7920","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1529","telop":"そこで、ふと5階にある、複数の空き部屋の存在を思い出し、台車に載ったPCを押して、通路に出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1530スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7243DC1B-DCEB-486C-831E-11363F311664","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1530","telop":"僕はエレベーターまでやってくると、ドアを開けて中に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1531スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"08B80D57-5402-4B85-9D8C-807BD38FED45","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1531","telop":"僕は、中に入ると、５階のボタンを押す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1532スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"84490150-DC1F-408F-9D1A-13B311CA9F59","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1532","telop":"僕が、エレベーターを降りると、廊下を見回る。\nこの階は、2階から4階と同じく3室だが、全て空室だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1533スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"4AFB16F6-D2D6-4536-96CF-C896A7D111D4","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1533","telop":"僕は、その中で真ん中の部屋のドアノブを握ると、部屋に入る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1534スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"83BF3BCF-A81F-4879-A20C-00CB4BB730DE","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1534","telop":"なぜか、このマンションは5階のフロアだけ、全室が和室だったことを中に入って僕は思い出し、そのまま部屋に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1535スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D3D2B2E4-C728-4CD9-817E-8A492CFE9187","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1535","telop":"僕は何もない、空き部屋に入ると、エアコン直下に下から持ってきたPCをおく。\n※察しのいい人にはPCなどが見えます","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1536スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"693F333D-9385-4BE6-857D-AC515E3C2DFA","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1536","telop":"だが、そこで、テーブルすらない状態で、モニターとマウス、キーボードをどう配置すべきか考え、とりあえず床に置く。\n※察しのいい人にはPCなどが見えます","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1537スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"14C046E0-2D0E-4F4F-95F0-6BDFDA84A53E","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1537","telop":"僕はそして、パソコンに電源を入れて、モニターを見る。\nすると、リンゴのマークが表示され、円が回転する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1538スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.1000000000000005,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"8505C04E-B751-4EC8-A914-231A8B922B3A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1538","telop":"そして、デモンストレーションが開かれると、僕は下線付きの文字をカーソルで選択する。\nデモンストレーション\nこれは、デモンストレーションソフトです。\n実際のPCでコンピュータの凄さを知りましょう。\nデモを閉じる\n今すぐ試す\n初期化したい場合はこちら","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1539スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1B55B6E4-B066-4F8F-B1C9-3D33405367AF","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1539","telop":"僕は画面の情報に基づき、エンターキーを押す。\n初期化\n初期化を実施する場合、エンターキーを押してください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1540スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B5432EB4-307C-4B27-A6E2-CB629C5A9FC0","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1540","telop":"すると、再び先ほどの画面が表示される。僕は、画面が切り替わるまでひたすらに待つ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1541スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"27A906CA-1D8B-4A0B-93B5-60FC7E262B0A","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1541","telop":"僕は、そこから画面の案内に従って初回設定を済ませる。\n初回設定\nようこそ","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1542スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"58425379-161B-43DA-815E-EEFD4153C75B","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1542","telop":"僕が、無事にPCの初回設定を終えると、そこには先ほども表示された背景にポケベルとファイルのアイコンだけの画面が出る。\nFiles\nポケベル初回設定\nポケベル\nFiles","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1543スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8B880375-04A4-4865-95A3-7C6904EB4C62","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1543","telop":"僕は、カーソルを動かし、ポケベルと書かれたアイコンをクリックする。\nFiles\nポケベル初回設定\nポケベル\nFiles","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1544スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F7A2FB9C-0F5F-457C-9EDB-984E957EDFC4","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1544","telop":"僕はその画面を見て、ポケベルを今持ってないことに気がつく。\nそこで、モニターから離れ、下から１つを持ってくる。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n開始するにはポケベルを接続してください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1545スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F02D66CE-1C2D-406A-BC68-03D19DEAA37D","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1545","telop":"そして僕は、部屋を出て、共同スペースに向かう。\n※察しのいい人にはPCなどが見えます","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1546スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"リビング（日中）.jpeg","id":"70E4EE4A-5DE2-48D2-849D-53BF3D6C566F","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 1546","telop":"僕は、共同スペースに降りてくると、開かれたポケベルの段ボール箱から残り三つのうち、一つを取り出し、部屋に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1547スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":5.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3F1CDD20-CA72-4B29-A8D4-C65AD8E42D1D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1547","telop":"僕が、部屋に入りモニターを見るとすでに画面が切り替わり、くるくる回る円が表示されていた。僕は、しばしそれを眺める。\nポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルを読み込み中です…\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1548スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1AB66307-DD72-4D8B-BD6D-C969BB0C755C","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1548","telop":"僕は、再び画面が切り替わると、「自動で初回設定」を選択する。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n読み込みました。次にする動作を選択してください。\n自動で初回設定\n手動で初回設定\n既に設定済みの場合はこちら\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1549スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"A9BD9F2A-E152-4CD0-BC5A-363AF79E89D2","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1549","telop":"すると、再び読み込み中と表示される。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n読み込み中です…\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1550スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C873AED3-381E-437B-A826-6F261ED1878E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1550","telop":"すると、再び読み込み中と表示される。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n固定電話を探索中…\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1551スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3B93DB5E-A244-4190-B817-27A630093277","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1551","telop":"僕が、エラーが表示されると「手動で接続」を選択する。\nポケベル\nポケベル初回設定\nポケベル\nFiles\nエラー：固定電話がありません。ポケベルの電話機能をご利用いただくには、固定電話のルーターに接続し、電話番号を取得する必要があります。詳細はヘルプをご参照ください。\nリロード\n手動で接続\nヘルプを見る\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1552スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"199BBC2A-F955-4972-A0B8-45AE9761F76F","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1552","telop":"そして、「ダイヤルアップ」を選択する。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n接続方法を選択してください。\nダイヤルアップ\nルーターを検索\n電話機能を使用しない場合は…\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1553スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"F88C7BA1-8737-4D5B-B7BE-21684D700B9D","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1553","telop":"僕は、電話番号を打ち込み、接続を選択する。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n接続方法：電話番号を打ち込み、接続を押します。\nすると自動でチェックされ、正常に接続すると進みます。\n接続\n電話番号を入力する\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1554スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":3.7,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3BAC7961-6BAC-4975-99F1-42828583A39E","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1554","telop":"すると、聞いたことのない音がポケベルから流れ、くるくる回る円が表示される。\nポケベル\nポケベル初回設定\nポケベル\nFiles\n発信中です…\n音源：https:\/\/otologic.jp\/free\/se\/pc03.html\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1555スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"07B50E28-98E1-4836-BEE2-FC7712383AE5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 1555","telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\n接続できました。固定電話とポケベルを連結中です…\nすると、聞いたことのない音がポケベルから流れ、くるくる回る円が表示される。\n操作\nWeb","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第1556スライド","transitionName":"なし","characterName":"操夢","animationName":"回転","duration":3.5,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"18037554-813C-4CC7-9A26-58BEFFBDC9D9","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/魔理沙（驚く）.png","seStartTimeOffset":0,"backgro