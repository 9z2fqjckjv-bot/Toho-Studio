[{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"65F61E31-298E-4DDA-AB8A-9D55D88D1923","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第2スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_操夢.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"3791D40D-5637-4A8B-9763-FABE7F193DA5","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":7.809342403628118,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 2","seStartTimeOffset":0,"telop":"僕の名前は、幻武操夢。成人式を終えて間もないの20歳。\nそんな僕は、毎日０円で生活し、日々を送っている。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第3スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_てゐ.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"1065AE6E-542A-4D86-89D0-5E37902B8DE9","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":2.5222902494331065,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 3","seStartTimeOffset":0,"telop":"毎日0円生活とは何だって？それは、お金が一切不要で衣食住が整い、なおかつ同じアパートに住む女性と順番に過ごせる生活だ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第4スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_古明地さとり.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"22289A95-DF33-4761-BD32-DB00EFD93B58","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":2.2521995464852607,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 4","seStartTimeOffset":0,"telop":"それは、ハーレムではないのかだって？いいや、このアパートに住む際に包括的婚約という特殊制度に登録されているから少し違う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第5スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_古明地こいし.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"28142CAA-10FB-4BEB-89EC-23FB7A917D53","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":1.473469387755102,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 5","seStartTimeOffset":0,"telop":"具体的に言えば、9人の女性と僕が暮らすこのアパートで、決まった順番で女性がこの部屋に来て、僕と1日を過ごすと言う暮らしだ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第6スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_アリス・マーガトロイド.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"B7D334B5-FA72-4B9F-8E21-E0B1C032D75B","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":1.7403628117913832,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 6","seStartTimeOffset":0,"telop":"そして、この生活で生まれた子どもたちの親権はアパートに住む皆で共同所有するという決まりがある。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第7スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_霧雨魔理沙.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"023095C4-BD23-4765-BD1B-377972B2A295","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":6.5619954648526075,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 7","seStartTimeOffset":0,"telop":"何でそんな制度ができたかって？それは、少子高齢化という難題を既存の制度の改訂だけでは解決できない問題を解決するためさ。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第8スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_鈴仙・優曇華院・イナバ.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"EBBEE11B-7CA8-4143-92AF-321F144BD407","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":3.3973696145124714,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 8","seStartTimeOffset":0,"telop":"そんな中で、新しく生まれたこの制度は9人の女性と1人の男性が同じアパートで一人暮らしを送り、子どもを産み育てる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第9スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.6,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_古明地さとり.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"E6270E8E-03B9-4882-811A-C45BF9BADFD0","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":5.203786848072562,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 9","seStartTimeOffset":0,"telop":"僕はそんなふうに一人語りしていると、インターホンが鳴り、玄関へと向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第10スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_ナレーション.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6D165DB7-910D-417E-B312-CE9B1809B319","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":7.623469387755102,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 10","seStartTimeOffset":0,"telop":"そして、玄関の扉を開ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第11スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_博麗霊夢.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DD2473BD-899C-42D5-8C9E-7312D825F8A7","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","voiceDuration":3.6044897959183673,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 11","seStartTimeOffset":0,"telop":"「今日は、よろしく…、操夢…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第12スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","voiceCharacter":"総集編","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"04B26306-08B3-4D93-812E-688A643CD63A","audioTrack":"track_voice_%E7%B7%8F%E9%9B%86%E7%B7%A8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 12","voiceDuration":1.4049886621315193,"seStartTimeOffset":0,"telop":"「今日は、どうする？フラン？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第13スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"0BD5AE26-7BB1-421B-9730-2120C9E6AA70","audioTrack":"track_voice_soumu","voiceDuration":1.4049886621315193,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 13","seStartTimeOffset":0,"telop":"「えっと…、ひとまず何か飲みたい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第14スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B671CB57-155B-4F8B-9316-D748167E7C9A","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 14","voiceDuration":7.824557823129251,"seStartTimeOffset":0,"telop":"「アルコールとソフトドリンクどっちがいい？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第15スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_015_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2CC30103-90DF-418C-9FBE-031543532C1A","audioTrack":"track_voice_soumu","voiceDuration":7.824557823129251,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 15","seStartTimeOffset":0,"telop":"「ワインが…飲みたい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第16スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C834F7E5-AE72-42DD-83BC-DC97CEECDDD0","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 16","voiceDuration":6.4104308390022675,"seStartTimeOffset":0,"telop":"彼女がそういうと、僕は冷蔵庫を開け、アエオンのアルコール度数10%、720mlのPB白ワインを取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第17スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B3525952-F919-49FA-8DA2-F7D386D3C8F5","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 17","voiceDuration":7.250634920634921,"seStartTimeOffset":0,"telop":"「これで、いいの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第18スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1420241A-4E2A-4B80-8EAB-C1D98DC89F8B","audioTrack":"track_voice_soumu","voiceDuration":5.247369614512472,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 18","seStartTimeOffset":0,"telop":"「うん、それで、いいよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第19スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B3C9A2C9-DF7E-4ACF-840B-31FF363B4431","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 19","voiceDuration":4.6539002267573695,"seStartTimeOffset":0,"telop":"「ワインを飲む前に、お風呂は入る？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第20スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"529590C5-C67F-4834-A12E-2511403594A0","audioTrack":"track_voice_soumu","voiceDuration":4.658253968253968,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 20","seStartTimeOffset":0,"telop":"「う…うん…。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第21スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.3,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C16E275C-551B-447A-A322-1180D6C15A5B","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 21","voiceDuration":9.788684807256235,"seStartTimeOffset":0,"telop":"「わかった。じゃあ、奥で待っているね。」\n僕はそういうと、冷蔵庫から氷を取り出し、戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第22スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"A02BB3D6-74C8-46F0-A88E-2186FBA7AC55","audioTrack":"track_voice_soumu","voiceDuration":9.788684807256235,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 22","seStartTimeOffset":0,"telop":"「ふぅ…」僕は、氷で割ったワインを一口飲み、一息をつく。\n僕は、ふとこの生活の始まりを思い出していた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第23スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DF732237-059F-4680-9C33-56A38BCC4C4E","audioTrack":"track_voice_soumu","voiceDuration":7.656077097505669,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 23","seStartTimeOffset":0,"telop":"僕が成人式にスーツで出向くと、皆が想像するような儀式みたいなのが行われた後、この制度が大々的に発表された。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第24スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2D84840E-7FCC-44FA-BEEC-982972B8385B","audioTrack":"track_voice_soumu","voiceDuration":7.656077097505669,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 24","seStartTimeOffset":0,"telop":"どうやら、この制度は日本の全国の市町村で実施されるということで、式から帰ると、テレビで臨時特番が報道されていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第25スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"61ECEB94-D889-4B84-9BE1-807CF2842C00","audioTrack":"track_voice_soumu","voiceDuration":8.063673469387755,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 25","seStartTimeOffset":0,"telop":"僕は、借金をしたくないという理由で大学にはいかず、高卒で働き出したのだが、この制度なら働かずとも生活を送れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第26スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C080B4D5-37EA-49FA-8829-5393372724C7","audioTrack":"track_voice_soumu","voiceDuration":1.2647619047619048,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 26","seStartTimeOffset":0,"telop":"僕は、そのメッセージが頭に残り、成人式の翌日に区役所へと向かい制度の申し込みをした。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第27スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"49049C5D-7BE6-4DC5-B7C7-12ADE4363202","audioTrack":"track_voice_soumu","voiceDuration":6.977823129251701,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 27","seStartTimeOffset":0,"telop":"そして、その制度に申し込んで、すぐにこのアパートにやってきて、9人の女性と共同生活を始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第28スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"9023B17A-0E45-4D70-AE95-D19F86875DB4","audioTrack":"track_voice_soumu","voiceDuration":6.9354195011337865,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 28","seStartTimeOffset":0,"telop":"そんな中で、フランと過ごした回数は、たしか3回目で、9日に一度のペースで同じ人と過ごす。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第29スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"A941D977-FFE2-4479-89D9-32621541BD11","audioTrack":"track_voice_soumu","voiceDuration":8.10281179138322,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 29","seStartTimeOffset":0,"telop":"今日から逆算すれば、成人式から1ヶ月くらい経っていることになる。そう僕が感慨に耽っているとフランが出てくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第30スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"AD0F7ABA-118B-4B38-9264-D18DD9630BAC","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 30","voiceDuration":8.10281179138322,"seStartTimeOffset":0,"telop":"「珍しいね、操夢が考え事してるなんて。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第31スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"4538930A-3350-49FF-9B1A-A8D4E955C1F6","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 31","voiceDuration":8.266938775510203,"seStartTimeOffset":0,"telop":"僕は、その彼女の発言になぜかムッとするが、首を振り、空のグラスにワインを注ぐ。「それじゃあ、乾杯。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第32スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"3419DD11-FCE2-4016-821F-159AE9ACB33C","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 32","voiceDuration":4.5778231292517,"seStartTimeOffset":0,"telop":"「乾杯。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第33スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"C3099721-97AE-4104-AFEB-25587E899AFB","audioTrack":"track_voice_soumu","voiceDuration":4.5778231292517,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 33","seStartTimeOffset":0,"telop":"そういうと、僕と彼女はグビグビとワインを飲む。\nそして、頬が照りながら「ふぅ」と一息つく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第34スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"8401DCE7-608C-457B-8EC5-B545486A0128","audioTrack":"track_voice_soumu","voiceDuration":6.906077097505669,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 34","seStartTimeOffset":0,"telop":"すると、急に彼女がもじもじする。\n「どうしたの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第35スライド","transitionName":"なし","characterName":"操夢","animationName":"移動","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"CD65EE46-459C-4BB6-8727-33AD99C42C47","audioTrack":"track_voice_soumu","voiceDuration":6.906077097505669,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 35","seStartTimeOffset":0,"telop":"すると、フランはいきなり僕の方に寄ってくる。\n僕は、彼女の動きに合わせて自らも寄ると、そっと唇をつける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第36スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"95F97826-BD1F-4624-A3DB-046F0047D629","audioTrack":"track_voice_soumu","voiceDuration":2.8973696145124714,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 36","seStartTimeOffset":0,"telop":"「んっ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第37スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"2256F9C1-76E0-48CB-B0B1-0E6CEF187296","audioTrack":"track_voice_soumu","voiceDuration":2.8973696145124714,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 37","seStartTimeOffset":0,"telop":"僕たちは、そのまま静かに互いの舌を互いの口に入れるように奥深く唇を交わらせる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第38スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"D467A2B4-2F65-42B2-9942-24616B5EF508","audioTrack":"track_voice_soumu","voiceDuration":6.462607709750567,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 38","seStartTimeOffset":0,"telop":"「んっ…もっと…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第39スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"8236ECEF-EAAB-4C49-BEBE-AA56CFB86CB9","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 39","voiceDuration":6.462607709750567,"seStartTimeOffset":0,"telop":"さらに、フランはゆっくりと僕の背後に手を回し、抱きつく形を取る。僕も同じようにフランを抱え上げると、ベットに彼女を押し倒す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第40スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"38294D5B-08DC-4204-A718-DB25D1F98851","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 40","voiceDuration":7.143038548752834,"seStartTimeOffset":0,"telop":"そして、ベッドに二人で乗っかると、彼女はゆっくりと僕の服に手をかけて、僕も彼女の服に手をかけて、互いの体を味わうのだった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第41スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"10197694-DA9B-4515-9841-23C61ED4BCC8","audioTrack":"track_voice_soumu","voiceDuration":8.634331065759637,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 41","seStartTimeOffset":0,"telop":"一方その頃某所では…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第42スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":6.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C908417D-2E8D-45E2-B7F9-B774BC26473E","audioTrack":"track_voice_soumu","voiceDuration":8.765850340136055,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 42","seStartTimeOffset":0,"telop":"「大河課長、先日ご指摘された、さいたま中央の例の共同生活なのですが、今現在、そこで生活する女からは一切の報告がありません。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第43スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"8E7B1BE4-954A-4AB7-BE06-89286EF47FAE","audioTrack":"track_voice_soumu","voiceDuration":7.056077097505669,"title":"シーン 43","seStartTimeOffset":0,"telop":"「そうか、まだ子どもができないのか？その共同生活を送る者たちは決まりは守っているんだよな？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第44スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"CDB91426-4A66-48E8-B984-0F55C4C899E8","audioTrack":"track_voice_soumu","voiceDuration":7.056077097505669,"title":"シーン 44","seStartTimeOffset":0,"telop":"「ええ、毎日1人の女が男と共に過ごし、少子化問題の解決に貢献するという決まりは守っているようですが、結果がついて…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第45スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"0BDB9386-DA4C-4100-A503-2C293409E036","audioTrack":"track_voice_soumu","voiceDuration":7.686507936507937,"title":"シーン 45","seStartTimeOffset":0,"telop":"「そうか…、では、追加の決まりを定める必要性があるのかもしれないな…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第46スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"8A778A91-1A7E-44F4-B400-C8594C39FEA7","audioTrack":"track_voice_soumu","voiceDuration":5.756077097505669,"title":"シーン 46","seStartTimeOffset":0,"telop":"「例の発奮剤のことですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第47スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"EDF69FC6-38E8-4935-92DF-6AE42EEE38E8","audioTrack":"track_voice_soumu","voiceDuration":5.756077097505669,"title":"シーン 47","seStartTimeOffset":0,"telop":"「そうだ、今は、定期的に送っているワインにそれが含まれているがその割合を増やす必要があるかもしれぬ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第48スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"E0853911-36EF-4C22-A34A-488C4400F922","audioTrack":"track_voice_soumu","voiceDuration":5.266938775510204,"title":"シーン 48","seStartTimeOffset":0,"telop":"「ところで、男の方は順調なのか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第49スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"18F5F82C-03DD-45CD-8C31-F75D881FED25","audioTrack":"track_voice_soumu","voiceDuration":9.588684807256236,"title":"シーン 49","seStartTimeOffset":0,"telop":"「ええ、男の方は日々、我々が送りつける食材によった精進をしているとのことです。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第50スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"91322A15-F900-4CA3-B60B-C479615A9D20","audioTrack":"track_voice_soumu","voiceDuration":9.077823129251701,"title":"シーン 50","seStartTimeOffset":0,"telop":"「そうか、それなら良いだろう。では、引き続きその問題となっている共同生活の実態調査を頼む。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第51スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"57136F18-49BF-4756-BA04-8B2C6067E181","audioTrack":"track_voice_soumu","voiceDuration":8.665850340136055,"title":"シーン 51","seStartTimeOffset":0,"telop":"「承知しました。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第52スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"A9457488-AE16-4A2B-837F-05425D92F1EE","audioTrack":"track_voice_reimu","voiceDuration":3.2444897959183674,"title":"シーン 52","seStartTimeOffset":0,"telop":"私がそう言うと、課長は窓の方に視線を戻した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第53スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"89E804F3-A973-4B19-AF2E-84F57B563DC0","audioTrack":"track_voice_reimu","voiceDuration":2.8744897959183673,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 53","seStartTimeOffset":0,"telop":"数時間後…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第54スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"261B7416-9501-433C-A862-872A6EF5034A","audioTrack":"track_voice_soumu","voiceDuration":2.612607709750567,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 54","seStartTimeOffset":0,"telop":"「ん…」\n僕はふと目が覚めると、隣でフランがすやすや眠っていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第55スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"8CF76B41-B381-44FC-87FF-1C09DF760B7D","audioTrack":"track_voice_soumu","voiceDuration":9.237596371882086,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 55","seStartTimeOffset":0,"telop":"僕は、彼女を起こさないようにそっとベッドから降りて、部屋の床に散らばった自分の服を着る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第56スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"16F29E88-0C6E-4D2A-8057-CDC26CCEF141","audioTrack":"track_voice_soumu","voiceDuration":6.363673469387755,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 56","seStartTimeOffset":0,"telop":"僕は、彼女を起こさないようにそっとベッドから降りる。\n僕は、服を着ると、フランを起こさないようにそっと玄関に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第57スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BC3ADDFE-4FE9-4FE0-8AF6-986484490B04","audioTrack":"track_voice_soumu","voiceDuration":6.363673469387755,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 57","seStartTimeOffset":0,"telop":"そして、昼食を取るために冷蔵庫を開けようとするが、フランを起こすのは嫌なので、そのままそっと玄関のドアを開ける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第58スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"06E98832-7DAD-49F5-9CD6-08C444C281F8","audioTrack":"track_voice_soumu","voiceDuration":8.095215419501134,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 58","seStartTimeOffset":0,"telop":"僕は、外に出るとなんとなく、屋上に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第59スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"359FFA3B-1117-44A5-A4D4-7DCE20460026","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 59","voiceDuration":2.9930385487528346,"seStartTimeOffset":0,"telop":"僕が屋上に来ると、そこには咲夜がいた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第60スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"0BF81473-FBF5-450E-9357-722FF29262AB","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 60","voiceDuration":7.006077097505669,"seStartTimeOffset":0,"telop":"「どうしたんですか？こんな真っ昼間に屋上に来て。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第61スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"D023CE0C-61EC-4AF9-A3BE-79C422A07BBE","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/咲夜（微笑）.png","title":"シーン 61","voiceDuration":7.239773242630386,"seStartTimeOffset":0,"telop":"「今、僕のベッドでフランがすやすや眠っているので…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第62スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"45E780DF-BBCD-4995-9D32-15A92576C862","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 62","voiceDuration":8.919115646258504,"seStartTimeOffset":0,"telop":"僕がそう言うと、彼女の顔が頬照り、驚きの表情を浮かべる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第63スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"9360C480-82D7-463B-A816-9A5E525A5C3E","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 63","voiceDuration":3.499546485260771,"seStartTimeOffset":0,"telop":"すると、彼女は咳払いを一度してから言葉を発する。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第64スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"096BBF07-ED28-4F20-AAA5-F391F496159D","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 64","voiceDuration":7.082154195011338,"seStartTimeOffset":0,"telop":"「そう言うことは、言わないほうがいいですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第65スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"52B6C47A-C8B6-4913-9C51-0DF08A1FD9A0","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 65","voiceDuration":7.227823129251701,"seStartTimeOffset":0,"telop":"「何で言っちゃダメなんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第66スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"60BB607B-07BD-4213-8079-A9E2711CA7D9","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 66","voiceDuration":9.241995464852607,"seStartTimeOffset":0,"telop":"「言っちゃダメということはありません。ですが…。」\n私はそう言いながらため息をつく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第67スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"1BBBBB5F-1A9F-4C38-A8DC-B09ED6C159DB","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 67","voiceDuration":8.286984126984127,"seStartTimeOffset":0,"telop":"「あなたにはそう言うことは難しいのでしょうが、それはフランさんへの思いやりと配慮に欠けてますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第68スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"A969A003-E091-43C8-A56D-D90D7B62FDAD","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 68","voiceDuration":9.684489795918367,"seStartTimeOffset":0,"telop":"「思いやりと配慮ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第69スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_069_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"CC7BD3C2-8EC3-4BF9-B017-BC2E796EFECE","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 69","voiceDuration":3.2394784580498865,"seStartTimeOffset":0,"telop":"「えぇ、普通の男性だったら、ある女性と寝ましたなんて、他の女性には言いませんし、その女性ががっくりしますから…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第70スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_070_十六夜咲夜.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"380E1DA3-0506-483E-8AE3-54F3FCFA9551","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 70","voiceDuration":3.063877551020408,"seStartTimeOffset":0,"telop":"「何でがっくりするんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第71スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_071_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"5E420747-643A-4640-A1B7-07287DABE6F4","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 71","voiceDuration":2.5419954648526075,"seStartTimeOffset":0,"telop":"すると、彼女は驚いた表情をする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第72スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_072_ナレーション.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"B8A603DC-D296-4D66-AE3D-248AF75567D3","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 72","voiceDuration":8.823922902494331,"seStartTimeOffset":0,"telop":"「はぁ」と私はため息をつく、彼は純粋無垢で、こう言った肝心なところに無関心で、欠けている点がある。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第73スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_073_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"91E71A7B-72A1-4D0E-BC6E-225675F84D75","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 73","voiceDuration":4.149546485260771,"seStartTimeOffset":0,"telop":"「まぁ、それはもう良いとして、そろそろ昼食の時間なので、一緒に共通スペースに向かいましょう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第74スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_074_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc212905_【背景】ビルの屋上.jpg","id":"32E080F8-AAB0-42FF-97F5-9AB2233C2B68","audioTrack":"track_voice_soumu","voiceDuration":6.943038548752835,"title":"シーン 74","seStartTimeOffset":0,"telop":"彼女は、そう言うと、下の方に向かったので、僕はその後に続く形で降りる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第75スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_075_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"8F157FA6-0D8E-4554-8BE7-BF4F9DE4A249","audioTrack":"track_voice_soumu","voiceDuration":7.53,"title":"シーン 75","seStartTimeOffset":0,"telop":"僕が１階の共通スペースに入ると、すでにそこには、同じアパートに住むフラン以外の全員が集まっていた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第76スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":13.600000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_076_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"F62587B2-2139-4E5C-A773-44BDF16CE163","audioTrack":"track_voice_soumu","voiceDuration":9.347369614512472,"title":"シーン 76","seStartTimeOffset":0,"telop":"簡単な人物紹介をすれば、隣町の神社の巫女である霊夢、空飛ぶ箒タクシーを運営している魔理沙、ホラーをよく見るさとりと友達で遊び相手のこいし、お金持ちの女性であるレミリア、レミリアのお世話係である咲夜、そしてレミリアが所有しているお金持ち図書館を運営しているパチュリーである。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第77スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_077_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"3C0E058E-D424-4405-B14D-8E86F6B3B8FB","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 77","voiceDuration":9.347369614512472,"seStartTimeOffset":0,"telop":"「ねぇ、操夢。フランはどこにいるのかしら？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第78スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_078_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"64DFDC73-6C0A-41D4-80F8-967A3D325F29","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 78","voiceDuration":6.835419501133787,"seStartTimeOffset":0,"telop":"「フランなら、僕の部屋のベッドですやすや眠ってますよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第79スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_079_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（弱る）.png","id":"D554F67D-7613-44E1-BDCF-8B24980AB913","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 79","voiceDuration":8.890861678004535,"seStartTimeOffset":0,"telop":"僕がそう言うと、咲夜以外の全員が驚きの表情を浮かべる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第80スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_080_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"8CAB151B-FED7-4EAA-8537-8AFEAE4C22F6","audioTrack":"track_voice_soumu","voiceDuration":4.174557823129252,"title":"シーン 80","seStartTimeOffset":0,"telop":"「あんたね…、何で他の女性の前でそんな発言をするのよ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第81スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_081_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"5AEF7CDC-08EE-47DA-B7B1-832C31B74B78","audioTrack":"track_voice_soumu","voiceDuration":4.174557823129252,"title":"シーン 81","seStartTimeOffset":0,"telop":"「えっ、ダメだった？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第82スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_082_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"07B75A3A-0A3C-47FC-8817-BC1F242F746A","audioTrack":"track_voice_soumu","voiceDuration":8.539342403628117,"title":"シーン 82","seStartTimeOffset":0,"telop":"「ダメだったらしないとか、そう言う問題じゃないのよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第83スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_083_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"D8AF9727-4326-4220-B05A-04260318DAE9","audioTrack":"track_voice_reimu","voiceDuration":8.756984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 83","seStartTimeOffset":0,"telop":"「何でフランとだけ、そんなに事早くすすむのだぜ？私たちは、まだキスすらもしてないのだぜ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第84スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_084_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"EE6AF1ED-6861-4EE0-8E92-A2F0A05F335F","audioTrack":"track_voice_reimu","voiceDuration":9.694489795918367,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 84","seStartTimeOffset":0,"telop":"「あなた、この共同生活の目的わかってるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第85スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_085_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"7DCA53AC-24D7-4F5F-84A8-0950CE682BE3","audioTrack":"track_voice_reimu","voiceDuration":8.569478458049886,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 85","seStartTimeOffset":0,"telop":"「えっ、役所の人は『ただ仲良く一緒に住んでね』って…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第86スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_086_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"F035B1DD-9942-47FD-A86A-0769F6CE6DC5","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（怒る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 86","voiceDuration":10.046984126984126,"seStartTimeOffset":0,"telop":"「私たちに言われたことと違うじゃないですか…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第87スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_087_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"3C300ADD-EED7-4DBB-A225-1033EFF9DEDD","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 87","voiceDuration":10.403242630385488,"seStartTimeOffset":0,"telop":"「あんたに言われた言葉は本当にその通りなの、もしかしたら仲良くって言葉が隠語に当たるんじゃないの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第88スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"717EEC3A-515F-4A83-9504-F1EDAA972F3C","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 88","voiceDuration":7.804489795918367,"seStartTimeOffset":0,"telop":"「隠語って何の言葉ですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第89スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"56F9AFE1-85E4-4DF1-8D6D-2C16D1997AF2","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 89","voiceDuration":8.965736961451247,"seStartTimeOffset":0,"telop":"「あんた、隠語を知らないの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第90スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"6BB6EEEA-C8BC-424F-9B34-0819508AE4B1","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 90","voiceDuration":9.343242630385488,"seStartTimeOffset":0,"telop":"私は、目の前の男の純粋無垢な性格にため息を吐き出した。\n「もういいわ…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第91スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"5A2EC062-3842-4F04-AB88-360CD03B634C","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/こいし（不満）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 91","voiceDuration":9.796984126984126,"seStartTimeOffset":0,"telop":"私は、目の前の男の発言をずっと聞いていると驚きや怒り、そして呆れすらも通り越して、大きなため息が出る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第92スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（弱る）.png","id":"FBE7C926-4FB1-4CBF-BF53-09E94BB37199","audioTrack":"track_voice_reimu","voiceDuration":10.066984126984128,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（弱る）.png","title":"シーン 92","seStartTimeOffset":0,"telop":"「とりあえず、昼食にしましょう。」\n私は、そう言い、キッチンに戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第93スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"3FFBBA66-440A-46D7-93E8-B17551608A7F","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","title":"シーン 93","voiceDuration":9.059478458049886,"seStartTimeOffset":0,"telop":"「ところで、あんたはフランと何したか分かってるの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第94スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.9000000000000004,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"8FDFFE34-66B3-43C6-BB9F-AC6DF55BF1CA","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","title":"シーン 94","voiceDuration":9.473242630385487,"seStartTimeOffset":0,"telop":"「いや、その前にいつものワインをフランと一緒に飲んでるから、覚えてないです…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第95スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"1DACF4DC-41B8-426B-9288-7D27F997C671","audioTrack":"track_voice_reimu","voiceDuration":9.473242630385487,"title":"シーン 95","seStartTimeOffset":0,"telop":"「はぁ…、まあいいわ。とりあえず、フランを起こして来なさい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第96スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_096_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"708BBACE-7F4C-409E-89C3-F3D1DE330C7A","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/疑問顔.png","title":"シーン 96","voiceDuration":8.908253968253968,"seStartTimeOffset":0,"telop":"「分かりました。」\n僕はそう言うと、自分の部屋に向かう。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第97スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_097_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"7B30BC32-AB87-473A-B186-B5E861C80F1A","audioTrack":"track_voice_soumu","voiceDuration":5.123401360544218,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 97","seStartTimeOffset":0,"telop":"僕は、彼女を起こさないようにそっとベッドから降りる。\n僕が部屋に入ると、フランは寝起きの状態だった。\n「フラン、お昼の時間だから、一緒に下に行こう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第98スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"D302F77B-993B-4024-ABB5-AA8F047F0259","audioTrack":"track_voice_soumu","voiceDuration":8.007165532879819,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 98","seStartTimeOffset":0,"telop":"僕は、彼女を起こさないようにそっとベッドから降りる。\n「う…うん…、分かった…」\n私は、そう言いながら、彼の手を取り、一緒に歩き出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第99スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_099_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（驚く）.png","id":"3DE09D8B-9A96-48E7-BD96-40E2D51767C1","audioTrack":"track_voice_soumu","voiceDuration":6.766938775510204,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（驚く）.png","title":"シーン 99","seStartTimeOffset":0,"telop":"僕が、共通スペースに入ると、咲夜が驚きの表情で立っていた。\n「どうしたんですか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第100スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_100_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"678D5D53-034C-4D0D-BE4B-5CC6EC69EB62","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 100","voiceDuration":1.696984126984127,"seStartTimeOffset":0,"telop":"私は、無意識に彼と手を繋いで歩いていたことを認識し、反射的に手を離すと、そそくさと席につく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第101スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_101_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（怒る）.png","id":"4B981BF0-819D-411A-99A4-860AC333FFED","audioTrack":"track_voice_soumu","voiceDuration":7.993038548752835,"title":"シーン 101","seStartTimeOffset":0,"telop":"僕は、女性全員からムスッとした視線を感じながらも、「いただきます。」と言って、配膳された昼食を食べ始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第102スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.300000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_102_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2A4C0B36-076A-40AC-B4A5-C0EDD3B6DDED","audioTrack":"track_voice_soumu","voiceDuration":8.016938775510203,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 102","seStartTimeOffset":0,"telop":"概要欄に、このお話がよくわかるテスト？みたいなのものにアクセスするためのリンクを掲載中。是非見てください。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第103スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_103_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"9E6BCE2C-848D-4432-920B-D709982C3636","audioTrack":"track_voice_soumu","voiceDuration":5.2017233560090705,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 103","seStartTimeOffset":0,"telop":"次回予告","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第104スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_104_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"C8E8F4AF-C545-43FA-AAA3-35D6EC766763","audioTrack":"track_voice_soumu","voiceDuration":0.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 104","seStartTimeOffset":0,"telop":"僕とフランは昼食を食べ終えると僕の部屋に戻り、午後に何するかを考えた結果、電車とバスで湖がある公園に出かける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第105スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_105_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1C935254-7723-452F-97BB-626DE3C73BA8","audioTrack":"track_voice_reimu","voiceDuration":10.068231292517007,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 105","seStartTimeOffset":0,"telop":"私は、操夢と一緒に川沿いにある湖に沿った公園にくると、一緒にお散歩する。そんな中操夢が一緒に競走しようと言う。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第106スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_106_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5603D4FF-40DA-473D-AC1D-FEC3B16BD82D","audioTrack":"track_voice_soumu","voiceDuration":8.645215419501135,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 106","seStartTimeOffset":0,"telop":"僕は、足が遅いのを分かっていながら、なぜかフランに競走しようと言ってしまい、１周５kmの道路を１周することになって…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"中扉","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"操夢","backgroundName":"単色背景","id":"8386424A-B232-40B7-997F-D899F0EA9331","seStartTimeOffset":0,"title":"ご視聴ありがとうございました","telop":"","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"タイトル","transitionName":"なし","characterName":"","animationName":"なし","duration":3,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"","backgroundName":"単色背景","id":"4E3BF92B-356E-4645-9866-B8CB041D34AD","seStartTimeOffset":0,"title":"東方Project二次創作 powerd by zuyasi","telop":"交換夫婦","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第109スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_109_博麗霊夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"A80CD292-B84E-4886-BAC0-3C413A7BFCF9","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 109","voiceDuration":8.745238095238095,"seStartTimeOffset":0,"telop":"僕たちが部屋に戻ると、フランに尋ねる。\n「フランは、何かしたいことはある？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第110スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_110_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"5E1273C9-30FC-44F7-954E-1FFE805F0DD0","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 110","voiceDuration":8.745238095238095,"seStartTimeOffset":0,"telop":"「私は、あそこの湖がある公園に行きたい。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第111スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_111_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"1ED68269-E131-4CA0-A7D8-44C7F68E9D96","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 111","voiceDuration":2.6713151927437644,"seStartTimeOffset":0,"telop":"「西湖公園か…」\n僕はそう言いながら、あることを思いつく。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第112スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_112_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"D485742D-418F-4BC4-94F7-649C90EEC41F","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 112","voiceDuration":4.706984126984127,"seStartTimeOffset":0,"telop":"「じゃあ、一緒に公園で競争しよう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第113スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_113_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"8549260C-8398-4189-8BE0-EB8987976D6C","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 113","voiceDuration":6.586984126984127,"seStartTimeOffset":0,"telop":"「珍しいね、操夢が競争しようと言うなんて。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第114スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_114_博麗霊夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"D007AC9F-A596-493A-A9FB-977CA31CA08A","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 114","voiceDuration":9.547732426303854,"seStartTimeOffset":0,"telop":"「久々にランニングしたい気分だから。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第115スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_115_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"B72BF11E-D054-4C5F-A3C5-2F59E70CD290","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 115","voiceDuration":7.556734693877551,"seStartTimeOffset":0,"telop":"「じゃあ、そうしよう。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第116スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_116_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"6E5B7799-AE75-432C-8BB4-1C956910AA5B","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 116","voiceDuration":9.994489795918367,"seStartTimeOffset":0,"telop":"「そうだ、日焼け止めとか取らないと。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第117スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_117_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"3375A665-6651-4FAF-935E-E9130F9C39F5","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 117","voiceDuration":3.9094784580498865,"seStartTimeOffset":0,"telop":"「あと、飲み物はこっちで用意するね。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第118スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_118_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"一人部屋３（日中）.jpg","id":"CF58D756-95B8-405A-95E4-DCE375ACD6D5","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","title":"シーン 118","voiceDuration":11.059478458049886,"seStartTimeOffset":0,"telop":"「うん、分かった！」\n私はそう言い、自分の部屋に戻る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第119スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_119_博麗霊夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"72FDE20A-D533-4646-A36F-EBA7050E41CA","audioTrack":"track_voice_soumu","voiceDuration":9.123242630385487,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 119","seStartTimeOffset":0,"telop":"僕は彼女がいなくなると、キッチン下の収納から二つの水筒を取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第120スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_120_博麗霊夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"772BD92D-1FE3-49E4-BEEF-1C0E16534F8D","audioTrack":"track_voice_soumu","voiceDuration":9.903242630385488,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 120","seStartTimeOffset":0,"telop":"そして蓋をはずし、片方には水を入れ、もう一方には氷の塊を入れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第121スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_121_博麗霊夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"FD05FC20-D547-47C4-9C7F-9EE09B37EB9D","audioTrack":"track_voice_soumu","voiceDuration":9.803242630385487,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 121","seStartTimeOffset":0,"telop":"次に、キッチンに水筒を置くと、さっと部屋から飲みかけのワインを持ってくる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第122スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_122_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"5E7BBD77-728C-463B-9526-EB11F442BB55","audioTrack":"track_voice_soumu","voiceDuration":8.561995464852608,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 122","seStartTimeOffset":0,"telop":"僕の飲みかけワインをごくりと飲むと、フランの飲み掛けを、氷の塊がある水筒に入れる。そして、冷蔵庫からワインを手に取る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第123スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_123_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"BD1AE540-9D21-4609-B3DF-384D5F38F363","audioTrack":"track_voice_reimu","voiceDuration":6.7194784580498865,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 123","seStartTimeOffset":0,"telop":"私は、そのワインの蓋を開けると、瓶の全体の10分の3くらいの量を水筒に入れて、ワインと水筒の蓋を閉める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第124スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.8000000000000003,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_124_レミリア・スカーレット.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"D58E19AE-884B-4278-B7C8-786B85E1BEEC","audioTrack":"track_voice_reimu","voiceDuration":6.975736961451247,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 124","seStartTimeOffset":0,"telop":"そしてワインが入った水筒をやや強く振ると、靴棚からリュックサックを取り出す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第125スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_125_レミリア・スカーレット.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"910935B7-4154-4010-9809-8040EC0578CF","audioTrack":"track_voice_reimu","voiceDuration":6.085124716553288,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 125","seStartTimeOffset":0,"telop":"そして、右サイドポケットに水入り水筒を、左サイドにワイン入り水筒を入れると、タンスからタオルを取り出して入れる。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第126スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_126_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"2FCF9A4E-7525-4C50-AF21-B8029D56D22B","audioTrack":"track_voice_soumu","voiceDuration":6.1544897959183675,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 126","seStartTimeOffset":0,"telop":"僕は、部屋に戻って財布などをリュックサックに入れ、部屋全体の電気を消すと、そのまま玄関のドアを開く。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第127スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_127_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"DCFB1F9D-03C0-4CC9-BF85-23661B8950A0","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（微笑）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 127","voiceDuration":8.866371882086169,"seStartTimeOffset":0,"telop":"僕は部屋の電子鍵をかけると、フランに「じゃあ、行こうか。」と言って目的地に向かって歩き出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第128スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_128_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C457B62D-6BBB-4647-8EA6-82ECE23EBDDB","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 128","voiceDuration":9.259229024943311,"seStartTimeOffset":0,"telop":"僕たちは、西湖公園に着くと、湖の周りの道路に来る。\nそして、フランにワインが入った水筒を渡す。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第129スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_129_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"034CA0AA-BD27-46D3-8CF0-A78C97F02B71","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第5話\/フラン（笑い）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 129","voiceDuration":10.000748299319728,"seStartTimeOffset":0,"telop":"そして、水が入った水筒を手に持ち、二人で一緒に飲む。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第130スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_130_フランドール・スカーレット.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"578B821F-D7F8-4010-AFC0-6137CF80F05B","audioTrack":"track_voice_reimu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（余裕）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 130","voiceDuration":5.464489795918367,"seStartTimeOffset":0,"telop":"「じゃあ、位置について、用意、始め」\n私はそう言うと、渡された水筒を手に持ち、走り始める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第131スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_131_レミリア・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"626E310B-4E4B-475F-8A76-30F13DA1E109","audioTrack":"track_voice_soumu","voiceDuration":8.350748299319728,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 131","seStartTimeOffset":0,"telop":"僕たちは走り始めると、フランの方が先走って行った。\n僕はゆっくりとリュックサックを背負ったまま走る。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第132スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_132_フランドール・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"3E15E177-C3CF-47B8-A683-C65FE6E51C52","audioTrack":"track_voice_soumu","voiceDuration":5.814489795918368,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 132","seStartTimeOffset":0,"telop":"操夢が湖の周りを１周すると…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第133スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_133_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"810F4AB6-CEE8-41B1-9AC2-523D11C0AB4F","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（弱る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 133","voiceDuration":8.299478458049887,"seStartTimeOffset":0,"telop":"僕が、１周走り終え、スタートの位置に戻ると、そこには顔が頬照り道路の端で座り込む、フランの姿があった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第134スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_134_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6EDF8AC4-EB69-4B67-8078-477BFB0F9CE9","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 134","voiceDuration":3.4944897959183674,"seStartTimeOffset":0,"telop":"「ねぇ、操夢。この水筒に何を入れたの？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第135スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_135_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C4EE50E2-B65C-4489-8D9B-0EB4A0452E53","audioTrack":"track_voice_soumu","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 135","voiceDuration":6.184489795918368,"seStartTimeOffset":0,"telop":"「きっと、素の状態で走れば、僕はフランに大敗しちゃうからハンデとして、ワイン入りの水筒を作った。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第136スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_136_フランドール・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"7D5772F2-C8BD-49B2-AD7A-B673027B4979","audioTrack":"track_voice_soumu","voiceDuration":5.634489795918367,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 136","seStartTimeOffset":0,"telop":"「くぅ、やっぱり…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第137スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_137_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"C992FBBA-6BD9-4DDC-AFB8-D26D3EBAC612","audioTrack":"track_voice_soumu","voiceDuration":5.606984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 137","seStartTimeOffset":0,"telop":"すると、フランはスッと静かになり、そのまま寝息を立て始めた。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第138スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_138_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"868C3AD3-58F5-4C8C-952B-A440106821F6","audioTrack":"track_voice_soumu","voiceDuration":7.314489795918368,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 138","seStartTimeOffset":0,"telop":"僕は、背負っているリュックサックを前に持ってくると、彼女を起こさないようにそっと僕のおんぶする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第139スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.7,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_139_フランドール・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"65403CD2-2034-44DB-9A60-893D7B0A958F","audioTrack":"track_voice_soumu","voiceDuration":3.7719954648526075,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 139","seStartTimeOffset":0,"telop":"僕は、おんぶしたフランの寝息を感じながら、ゆっくりと家に向けて歩き出した。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第140スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_140_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"812BF432-97B5-420A-9EF3-6092A622AEFF","audioTrack":"track_voice_soumu","voiceDuration":6.4294784580498865,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 140","seStartTimeOffset":0,"telop":"僕は、ゆっくりと歩きながら、ふと呟く。\n「これは、フランにとったら１周走ったご褒美かな…」と。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第141スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":5.2,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_141_フランドール・スカーレット.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"1B0ECA15-4E16-4829-A6D5-4BB120D88187","audioTrack":"track_voice_soumu","voiceDuration":8.609478458049887,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 141","seStartTimeOffset":0,"telop":"正直に言って、ワインを飲みながら走るとどうなるかは、未知数だったが、フランはどうやらお酒が回ったらしい。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第142スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.9000000000000004,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_142_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"127C13DB-BB16-48D7-BAC4-96B3F24BD3AF","audioTrack":"track_voice_soumu","voiceDuration":8.015736961451248,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 142","seStartTimeOffset":0,"telop":"そして、なぜか周りからの視線が僕に向かっているように感じた。「なんでだろう…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第143スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_143_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"6EF247B6-134D-48EF-91C0-FC733658E0F5","audioTrack":"track_voice_soumu","voiceDuration":8.856984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 143","seStartTimeOffset":0,"telop":"当然ながら、その理由を教えてくれる人などはおらず、僕も「まぁ、いいか。」と言い、少し足を早める。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第144スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.4,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_144_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"CBF89DFD-BA46-4D62-A658-EC762ABF4297","audioTrack":"track_voice_soumu","voiceDuration":7.659478458049887,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 144","seStartTimeOffset":0,"telop":"すると、突然誰かに噛みつかれるような感覚がする。\nそして同時に、何かが出ていく感覚がする。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第145スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":4.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_145_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"B3086DA9-3292-4C2B-B8A6-0DC6BCA06E89","audioTrack":"track_voice_soumu","voiceDuration":3.9694784580498865,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 145","seStartTimeOffset":0,"telop":"僕は、そのまま段々とふらふらして、何かに転けたのか、バサッと倒れて、そのまま意識を失った。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第146スライド","transitionName":"なし","characterName":"操夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_146_操夢.wav","voiceCharacter":"操夢","bgmName":"BGM: 東方妖恋談","backgroundName":"nc73538_【背景素材】博麗神社.jpg","id":"AD221EC9-A88E-41A8-9311-36BCAD4532B6","audioTrack":"track_voice_soumu","voiceDuration":6.786984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","title":"シーン 146","seStartTimeOffset":0,"telop":"一方その頃、咲夜たちは…","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第147スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":5.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_147_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（困る）.png","id":"310867A4-36C2-4521-8F0E-5222534FBEF1","audioTrack":"track_voice_reimu","voiceDuration":3.0419954648526075,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 147","seStartTimeOffset":0,"telop":"私は、洗った食器を片付けた後清掃していると、固定電話から着信音がなる。パネルを見ると、相手は知らない番号だった。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第148スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_148_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（困る）.png","id":"34DD5F7F-1FEF-48A0-B241-D55DC656DF7B","audioTrack":"track_voice_reimu","voiceDuration":2.076984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 148","seStartTimeOffset":0,"telop":"「もしもし。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第149スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_149_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（困る）.png","id":"8D4EC4BA-36C5-4839-803D-06A77A5BAD6C","audioTrack":"track_voice_reimu","voiceDuration":4.129478458049887,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 149","seStartTimeOffset":0,"telop":"「そちらは、幻武操夢さんの、家電でよろしいでしょうか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第150スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_150_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（困る）.png","id":"12525680-DC88-457F-9FD6-15FAD854413A","audioTrack":"track_voice_reimu","voiceDuration":9.445736961451248,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 150","seStartTimeOffset":0,"telop":"「はい、そうですけど…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第151スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_151_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"咲夜（困る）.png","id":"B1B6D1D0-6000-4FCE-B172-934CA60A080B","audioTrack":"track_voice_reimu","voiceDuration":3.0094784580498866,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/咲夜（困る）.png","title":"シーン 151","seStartTimeOffset":0,"telop":"「つい先ほど、幻武操夢さんと連れの女性が救急車で運び込まれまして…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第152スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_152_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"20414413-0499-4DCB-A076-66A6E8E26AB2","audioTrack":"track_voice_reimu","voiceDuration":7.081995464852608,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 152","seStartTimeOffset":0,"telop":"「それは、一体…」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第153スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":4.6000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_153_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"81C271D5-A9B4-4466-8C52-188B27A3C589","audioTrack":"track_voice_reimu","voiceDuration":8.004489795918367,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 153","seStartTimeOffset":0,"telop":"「彼らの搬送先が戸田川病院でして、今すぐに、こちらに来ていただくことはできますでしょうか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第154スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_154_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"4AE856FF-27CC-4FC4-81EA-5923DA1225F9","audioTrack":"track_voice_reimu","voiceDuration":3.806984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 154","seStartTimeOffset":0,"telop":"「少々お待ちいただけますか？」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第155スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_155_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"CE33E818-651C-4828-9954-06B68F53F8F3","audioTrack":"track_voice_reimu","voiceDuration":4.2719954648526075,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 155","seStartTimeOffset":0,"telop":"「大丈夫ですよ。」","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第156スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_156_博麗霊夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"873BAFF5-5895-4BA6-B64D-024622BE918C","audioTrack":"track_voice_reimu","voiceDuration":7.686984126984127,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","title":"シーン 156","seStartTimeOffset":0,"telop":"私は相手がそう言うと、電話を保留にして、お嬢様の部屋にかける。","voiceStartTimeOffset":0,"seVolume":1},{"slideTitle":"第157スライド","transitionName":"なし","characterName":"博麗霊夢","animationName":"なし","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_157_操夢.wav","voiceCharacter":"博麗霊夢","bgmName":"BGM: 東方妖恋談","backgroundName":"リビング（日中）.jpeg","id":"9190E5ED-8E4F-4D1E-98A0-8D2642C119A4","audio