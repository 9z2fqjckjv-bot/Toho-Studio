ation":1.7844897959183674,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 31","telop":"「恥ずかしい話ですが、それでも聞きたいですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第31スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.031.jpeg","transitionName":"なし","duration":3.83,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"AC03CC74-DF76-4232-9D8E-6FBACF8D19E7","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":3.23,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 32","telop":"「聞かせて。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第32スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.032.jpeg","transitionName":"なし","duration":2.5,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"9046EDBF-AD09-4B1A-A038-FBA0C43E62BA","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":0.9444897959183673,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 33","telop":"僕は、彼女にそう言われ、今朝の出来事と、昨晩の夢の内容を彼女に１から話していく。すると、彼女の頬が、頬照っていく。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第33スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.033.jpeg","transitionName":"なし","duration":10.082154195011338,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"766C37E0-6377-40BD-9E0A-E8D7DBB5F98A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":9.482154195011338,"animationName":"バウンス"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 34","telop":"「それ、外では内緒だからね、分かった？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第34スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.034.jpeg","transitionName":"なし","duration":4.033242630385487,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"42F2F1D7-E167-45E2-A45D-770368A0F719","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":3.4332426303854877,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 35","telop":"「ええ、分かりました…。」僕は、なぜ彼女がそういうのか、分からなかったが、とりあえず、そう答えた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第35スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.035.jpeg","transitionName":"なし","duration":7.760430839002267,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"6364073F-41A4-41C5-8313-7863718934CF","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.1604308390022675,"animationName":"なし"},{"voiceStartTimeOffset":0,"seName":"SE: ドアチャイム2","voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 36","telop":"僕たちがそんな会話をしていると、インターホンが鳴る。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":0.85,"slideTitle":"第36スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.036.jpeg","transitionName":"なし","duration":3.821292517006803,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/フラン（怒る）.png","voice2StartTimeOffset":0,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/ドアチャイム2.mp3","characterName":"操夢","id":"FCE30889-4206-4A08-8CCB-A8A6764FEBA0","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","seStartTimeOffset":0,"audioTrack":"track_voice_soumu","voiceDuration":3.2212925170068027,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 37","telop":"僕が、玄関に出ると、そこには知らない女性が立っていた。\n「あの、あなたは、誰ですか？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第37スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.037.jpeg","transitionName":"なし","duration":6.9104308390022675,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"FBB587A1-5291-4A47-85F8-881D0ACF2F32","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":6.310430839002268,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","bgmVolume":0.7,"title":"シーン 38","telop":"私は、彼にそう聞かれると、自分の名刺を彼に渡す。\n「私は、紅魔建設の代表、レミリア・スカーレットです。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第38スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.038.jpeg","transitionName":"なし","duration":8.348412698412698,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"レミリア・スカーレット","id":"E76F2A1C-C27D-494E-813F-122B5729A45E","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":7.748412698412698,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 39","telop":"僕は、その名刺を受け取ると、僕の名前を彼女に伝える。\nすると、彼女はどうやら、その名前を見知っているようだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第39スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.039.jpeg","transitionName":"なし","duration":8.818027210884354,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"6591E5B9-6CC7-40F5-8A7E-F142E44C4A9D","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.218027210884355,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","bgmVolume":0.7,"title":"シーン 40","telop":"「それで、突然なのだけど、\n家に上がらせてもらってもいいかしら、藤原紅夢くん？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第40スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.040.jpeg","transitionName":"なし","duration":5.904648526077097,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"レミリア・スカーレット","id":"3EA1692A-B84B-40F7-8293-3A9C357C08ED","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":5.304648526077098,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 41","telop":"「ええ、いいですよ。」\n僕はそういうと、彼女を家にあげ、リビングに戻る。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第41スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.041.jpeg","transitionName":"なし","duration":5.747369614512471,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"4F125792-0FE4-43FB-ABA6-10D4DA14B4AF","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":5.147369614512471,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 42","telop":"僕が家に戻ると、フランが驚いた様子でこちらを見る。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第42スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.042.jpeg","transitionName":"なし","duration":4.13,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/フラン（驚く）.png","voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"DA84DC59-68D1-4C34-BFA3-363BF73278E9","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":3.53,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 43","telop":"「どうしたの、お姉様…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第43スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.043.jpeg","transitionName":"なし","duration":2.619478458049887,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"DCBFEC54-A0F5-4D91-8605-C5B3C7C304EE","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":2.019478458049887,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","bgmVolume":0.7,"title":"シーン 44","telop":"「彼の母親と契約して、彼を引き取りに来たのよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第44スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.044.jpeg","transitionName":"なし","duration":4.050498866213152,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"レミリア・スカーレット","id":"63CBE967-DBDB-4A08-8708-9DA3CECE4526","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":3.450498866213152,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 45","telop":"「え…、それって…これからあの屋敷で彼と住むってこと？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第45スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.045.jpeg","transitionName":"なし","duration":4.773242630385488,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"26BF91AF-8D4B-4A10-B06D-1FBAAF454602","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":4.173242630385488,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","bgmVolume":0.7,"title":"シーン 46","telop":"「ええそのとおり。それで、紅夢くんは、\n荷物と部屋の整理にどれくらいの時間がかかるかしら？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第46スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.046.jpeg","transitionName":"なし","duration":6.592154195011338,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"レミリア・スカーレット","id":"C57A6EAA-371F-4CAD-81EA-B02F2F6E881C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":5.992154195011338,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 47","telop":"「えっと…」僕は、レミリアの発言に戸惑ってしまう。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第47スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.047.jpeg","transitionName":"なし","duration":4.20498866213152,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"64F55616-7503-43B7-9BE2-84B52A8BD328","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":3.6049886621315195,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","bgmVolume":0.7,"title":"シーン 48","telop":"「もし、時間がかかるなら、私もお手伝いするわ。それで、どうかしら？できれば、今日の夕方には屋敷宛に発送したいけど…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第48スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.048.jpeg","transitionName":"なし","duration":9.473401360544218,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"レミリア・スカーレット","id":"CB7BAB34-8633-4537-9F83-DC13325022F6","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_048_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":8.873401360544218,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"レミリア・スカーレット","bgmVolume":0.7,"title":"シーン 49","telop":"「じゃあ、それでお願いします…」\nそれから、僕と彼女たちは引っ越しの作業を進めるのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第49スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.049.jpeg","transitionName":"なし","duration":6.674557823129251,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"レミリア・スカーレット","id":"5235E02E-DA9A-4558-B819-930148175838","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_049_レミリア・スカーレット.wav","audioTrack":"track_voice_%E3%83%AC%E3%83%9F%E3%83%AA%E3%82%A2%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":6.074557823129251,"animationName":"なし"},{"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"一方、魔理沙は…","telop":"","backgroundName":"単色背景","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"中扉","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.050.jpeg","transitionName":"なし","duration":3,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"1736CC02-3758-4104-8B6C-631DE6CCDE82","voiceStartTimeOffset":0,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"シーン 51","telop":"私は、ふと目が覚めると、そこは病院だった。\nすると、誰かが入ってくる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第51スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.051.jpeg","transitionName":"なし","duration":7.025736961451247,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"390F88A2-0695-429B-9DA3-4F97A91B4B07","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_霧雨魔理沙.wav","audioTrack":"track_voice_marisa","voiceDuration":6.425736961451247,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 52","telop":"「あんた、大丈夫だったの？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第52スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.052.jpeg","transitionName":"なし","duration":2.8544897959183673,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"341AA24D-B366-4DEA-9385-9665414322B6","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":2.254489795918367,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"シーン 53","telop":"「ああ、今はもう平気さ…。それより、先生はどう言ってた？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第53スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.053.jpeg","transitionName":"なし","duration":5.416984126984127,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"C3DF5182-9A17-43CC-AD0E-0E16FE18F11A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_霧雨魔理沙.wav","audioTrack":"track_voice_marisa","voiceDuration":4.816984126984127,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 54","telop":"「一度、消えかけていた人格が急に出て、\n暴れたんだから、制限付きでの生活を再開させるって…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第54スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.054.jpeg","transitionName":"なし","duration":8.463242630385487,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"D7BF1ADC-BACF-4104-B1D0-9B25B0C83063","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_054_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":7.863242630385487,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"シーン 55","telop":"「そうか…、それより…彼はどうだ？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第55スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.055.jpeg","transitionName":"なし","duration":3.3544897959183673,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"7E7B27A6-4680-437E-95F8-86DC76F7E05F","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_霧雨魔理沙.wav","audioTrack":"track_voice_marisa","voiceDuration":2.754489795918367,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 56","telop":"「彼って、紅夢のこと？それなら、いつもと変わらないわよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第56スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.056.jpeg","transitionName":"なし","duration":5.518231292517006,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"BB2A9D0B-1B92-44E6-8E09-99227213FF26","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":4.918231292517007,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"シーン 57","telop":"「そうか…、それなら安心だな…。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第57スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.057.jpeg","transitionName":"なし","duration":3.0119954648526077,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"EF6BFD16-E80D-47B3-B5A3-0E5CEC15F61E","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_霧雨魔理沙.wav","audioTrack":"track_voice_marisa","voiceDuration":2.4119954648526076,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 58","telop":"「あんた、何言ってんのよ。\nそれより、自分自身を心配した方がいいわよ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第58スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.058.jpeg","transitionName":"なし","duration":6.569478458049886,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"A22486B8-31BB-4851-93A6-5190A35C9509","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":5.9694784580498865,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"シーン 59","telop":"「そうか…。彼に一言だけ、伝言してくれないか…？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第59スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.059.jpeg","transitionName":"なし","duration":4.994489795918367,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"E612D5C6-E5D7-4E69-9576-EC7A2F1E0E57","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_霧雨魔理沙.wav","audioTrack":"track_voice_marisa","voiceDuration":4.394489795918368,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 60","telop":"「何なの、伝言って？」私はそう言って、耳を立てて聞く。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第60スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.060.jpeg","transitionName":"なし","duration":5.809478458049886,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"7376E5AA-D185-405B-B5BB-186DFC67B209","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":5.209478458049887,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","bgmVolume":0.7,"title":"シーン 61","telop":"「気を悪くしたのなら、すまない。これが、私が考えられる最善策と彼のための言葉なんだ。だから、彼にそう伝えてくれ。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第61スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.061.jpeg","transitionName":"なし","duration":11.114489795918367,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"霧雨魔理沙","id":"759EBC58-8EC8-4916-9EA2-5309928FEAD0","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_霧雨魔理沙.wav","audioTrack":"track_voice_marisa","voiceDuration":10.514489795918367,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 62","telop":"「そう、それじゃあ、またお見舞いに来るわ。」\n私はそう言うと、勤務地に向かっていった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第62スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.062.jpeg","transitionName":"なし","duration":7.433242630385487,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"A43EF50A-6D13-4873-B613-2C272A5FFFA9","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":6.833242630385487,"animationName":"なし"},{"seName":"SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～","voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 63: 操夢","telop":"操夢「新しいシーンの台本セリフを入力してください」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":0.2608349609375001,"slideTitle":"第63スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_25f809e228\/元女子校の日常　第10話_25f809e228.063.jpeg","transitionName":"なし","