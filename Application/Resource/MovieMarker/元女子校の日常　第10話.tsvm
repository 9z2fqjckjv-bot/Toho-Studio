9478458049887,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"B6AC7624-C3C7-4235-BBD0-4543C260FE19","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":5.159478458049887,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 4","telop":"僕は、彼女にそう言われ、息を吐きながら、脱力する。\nすると、彼女が僕の背中に手を回し、唇をそっとくっつける。\n制作ソフト及び協力\nGemini\nTohoStuido","backgroundName":"一人部屋３（夜・照明OFF）.pxd","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第4スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.004.jpeg","transitionName":"なし","duration":9.414761904761905,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"7F70DB16-7F70-4397-B8BB-DDC0E561891A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.814761904761905,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 5","telop":"すると、彼女が僕の手を握り、そっと彼女の胸に当てる。","backgroundName":"一人部屋３（夜・照明OFF）.pxd","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第5スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.005.jpeg","transitionName":"なし","duration":4.608253968253968,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"3A5689E8-9B7B-41BA-B2C6-593D04D0B1C0","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":4.008253968253968,"animationName":"なし"},{"voiceStartTimeOffset":0,"seName":"SE: 自主規制ピー音","voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 6","telop":"「ほら、どう先生のーは？大きい？小さい？」","backgroundName":"一人部屋３（夜・照明OFF）.pxd","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第6スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.006.jpeg","transitionName":"なし","duration":5.119478458049886,"seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/効果音\/自主規制ピー音.mp3","voice2StartTimeOffset":0,"seStartTimeOffset":0.24,"characterName":"フランドール・スカーレット","id":"3B62699F-A550-4165-B1BE-84E64C874F52","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_006_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":4.519478458049886,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 7","telop":"「…僕は、どっちでも大丈夫ですよ…」僕は、どこかふわふわしたような、だが確かに感じるその感触を味わう。","backgroundName":"一人部屋３（夜・照明OFF）.pxd","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第7スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.007.jpeg","transitionName":"なし","duration":8.069115646258503,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"B48A2569-4AD4-417B-A46B-260D96976030","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.469115646258503,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 8","telop":"私は、彼に自らの胸を触らせた後、そっと彼の頭を胸に埋める。\n「ほら、もっと力を抜いて…、リラーックス、リラーックス。」","backgroundName":"一人部屋３（夜・照明OFF）.pxd","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第8スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.008.jpeg","transitionName":"なし","duration":10.984489795918368,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"207E35E3-CF04-49C1-8D51-8E72A281E437","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":10.384489795918368,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 9","telop":"彼女はそう言いながら、僕の服をそっと掴む。僕は、それに気づかずに、ふわふわしながら感じる感触に身を任せるのだった。","backgroundName":"一人部屋３（夜・照明OFF）.pxd","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第9スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.009.jpeg","transitionName":"なし","duration":9.20063492063492,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"8873DC2E-2CEE-4E65-A8D7-ADC3930533EC","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":8.60063492063492,"animationName":"なし"},{"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"一方、霊夢は…","telop":"","backgroundName":"単色背景","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"中扉","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.010.jpeg","transitionName":"なし","duration":3,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"81C74AD7-43C6-47A5-9A54-C8742035D7EE","voiceStartTimeOffset":0,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"妹紅","bgmVolume":0.7,"title":"シーン 11","telop":"「だからよ…」私は、そう妻である彼女に、\n仕事終わりの飲み会での愚痴をお酒片手に話す。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第11スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.011.jpeg","transitionName":"なし","duration":6.778730158730158,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"藤原妹紅","id":"33D67C1E-3836-48BE-9AC1-E65BAB023B8C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_妹紅.wav","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","voiceDuration":6.178730158730159,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 12","telop":"「どうしたの、あなた、急に黙り込んで？」\n私が、そう彼に問いかけると、急に抱きついてくる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第12スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.012.jpeg","transitionName":"なし","duration":8.521995464852608,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"3A55CBB4-E6B2-4222-B55D-14BC77521825","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":7.921995464852608,"animationName":"なし"},{"voiceStartTimeOffset":0,"seName":"SE: 自主規制ピー音","voiceCharacter":"妹紅","bgmVolume":0.7,"title":"シーン 13","telop":"「だから、今晩は朝までーだぞ、霊夢。」\n私は、そういうと、彼女に襲い掛かるのだった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOff