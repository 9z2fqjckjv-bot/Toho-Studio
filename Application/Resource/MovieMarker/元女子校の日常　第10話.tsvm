784E44A78268","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":6.740861678004535,"animationName":"なし"},{"voice2Duration":2.0619954648526075,"id":"1504D331-8737-4107-8D32-55940F2A3046","voice2AudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_博麗霊夢.wav","title":"シーン 18","voiceDuration":1.7930385487528344,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":2.6619954648526076,"audioTrack":"track_voice_soumu","seVolume":1,"animationName":"なし","telop":"「ぎゃーーーーーーーーーーーーーーーーー！」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seStartTimeOffset":0,"transitionName":"なし","characterName":"操夢&博麗霊夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.018.jpeg","voice2Character":"博麗霊夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","slideTitle":"第18スライド","bgmVolume":0.7,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"voiceCharacter":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 19","telop":"「んっ…」私は、誰かの叫び声が聞こえて、目が覚める。「一体、何があったの？」私は、そう呟きながら、ベッドから降りる。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","backgroundName":"一人部屋３（日中）.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第19スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.019.jpeg","transitionName":"なし","duration":11.699478458049887,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"BBB83E4D-60A5-4369-9790-A8AB230B4E63","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_フランドール・スカーレット.wav","audioTrack":"track_voice_%E3%83%95%E3%83%A9%E3%83%B3%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88","voiceDuration":11.099478458049887,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 20","telop":"「あっ、あんた、一体どんな夢見てたら、母親の…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第20スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.020.jpeg","transitionName":"なし","duration":4.924489795918367,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"9781CFE1-083E-4013-9C28-9B76F9DA9E4A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":4.3244897959183675,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 21","telop":"「なんとなく感じてた、あの感触は…」\n僕は、そこで、気付いてはいけないような事実に気づく。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第21スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.021.jpeg","transitionName":"なし","duration":7.036507936507936,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"5538392F-66CC-43C1-9DDB-CCB20FF4CB8F","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":6.436507936507937,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 22","telop":"「とりあえず、今はいいわ。それより鏡見てきなさい。」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第22スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.022.jpeg","transitionName":"なし","duration":4.896984126984127,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"331F0D54-BF43-48C8-8FB1-1AAFCF957B73","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":4.296984126984127,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 23","telop":"私は、息子を部屋から追い出すと、「はぁ」とため息をつく。\n「今日のことが、彼にバレなければいいのだけど…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第23スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.023.jpeg","transitionName":"なし","duration":8.566984126984128,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"03BEC544-309B-4CBF-9088-9E97BB0DEB48","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedAudio\/Slide_023_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":7.966984126984127,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"博麗霊夢","bgmVolume":0.7,"title":"シーン 24","telop":"私はそう一人、ぼさっと呟くと、リビングに降りていった。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第24スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.024.jpeg","transitionName":"なし","duration":5.130748299319728,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"博麗霊夢","id":"8910015E-9A8E-4813-B583-8DE9EFFF2040","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_博麗霊夢.wav","audioTrack":"track_voice_reimu","voiceDuration":4.530748299319728,"animationName":"なし"},{"voiceCharacter":"ナレーション","bgmVolume":0.7,"title":"シーン 25","telop":"それから…","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第25スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.025.jpeg","transitionName":"なし","duration":3,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"ナレーション","id":"81401755-D905-41F4-BDDC-34C0E9FBD669","voiceStartTimeOffset":0,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 26","telop":"それから、僕は鏡の前で、身だしなみの手入れを済ませると、リビングにはフランが困った表情を浮かべながら立っていた。","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第26スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.026.jpeg","transitionName":"なし","duration":8.199546485260772,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"C9E68439-2318-435B-A61C-BFAC6A8A8146","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":7.599546485260771,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"操夢","bgmVolume":0.7,"title":"シーン 27","telop":"「どうしたんですか、フランさん？」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第27スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.027.jpeg","transitionName":"なし","duration":2.6191156462585035,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"操夢","id":"F42DB734-9D91-4A0D-8C17-F2D6AD52CFDC","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_操夢.wav","audioTrack":"track_voice_soumu","voiceDuration":2.0191156462585034,"animationName":"なし"},{"voiceStartTimeOffset":0,"voiceCharacter":"フランドール・スカーレット","bgmVolume":0.7,"title":"シーン 28","telop":"「さっき君の母親が、慌てた様子で家を飛び出していって…」","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","bgmStartTimeOffset":0,"seVolume":1,"slideTitle":"第28スライド","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第10話_46d37d5a38\/元女子校の日常　第10話_46d37d5a38.028.jpeg","transitionName":"なし","duration":5.055736961451247,"voice2StartTimeOffset":0,"seStartTimeOffset":0,"characterName":"フランドール・スカーレット","id":"EB0B6140-3200-4360-B441-872A11B55FF3","voiceAudioPath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Application\/Resource\/GeneratedA