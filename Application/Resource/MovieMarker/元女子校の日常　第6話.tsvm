[{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第1スライド","duration":5.2,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 1","voiceDuration":7.221292517006803,"id":"239ADDFB-38D7-4183-A4B3-2EB733591E62","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.001.jpeg","telop":"僕はそれから、どれだけの時間待っただろうか…、そんな頃になると、アリスと名乗っていた彼女が、戻ってきた。\n東方Project二次創作作品","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第2スライド","duration":4.7,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 2","voiceDuration":5.476235827664399,"id":"BAEC1A24-276C-4891-867A-0C474F0A7E0D","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.002.jpeg","telop":"「ごめんなさいね…、こんな時間まで、拘束しちゃって…」\n私が時計を見ると、夜の8時を指していた。\n作成者：zuyasi","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"中扉","duration":3,"characterName":"操夢","transitionName":"なし","backgroundName":"単色背景","title":"「いえ…、僕が、あの小瓶を持ってたのが、\n原因ですから、謝らなくても大丈夫ですよ。」","voiceDuration":5.973469387755102,"id":"80FE7E79-72D7-47C3-9F2F-0CFC1B2E8FFA","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.003.jpeg","telop":"","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第4スライド","duration":5.7,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 4","voiceDuration":7.364421768707483,"id":"2DEC068B-2994-4CDA-81F4-2C649A411389","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.004.jpeg","telop":"「そう…。とりあえず、博士が研究中に、寝落ちしたから、帰ってもいいわよ。あとは、私が、彼女を説得させておくから…」\n制作ソフト及び協力\nGemini\nTohoStuido","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第5スライド","duration":3.5,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 5","voiceDuration":2.7096145124716555,"id":"95B57482-F352-40AF-A31D-A7FC0D9164D4","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.005.jpeg","telop":"「あと帰る前に、君の名前を聞かせてくれるかしら？」","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第6スライド","duration":3.5,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 6","voiceDuration":2.5452154195011336,"id":"12C25895-EC4E-45E9-BED2-714AA87B801A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.006.jpeg","telop":"「僕の名前は…藤原紅夢です。」","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第7スライド","duration":3.5,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 7","voiceDuration":2.6268253968253967,"id":"8FEB5D3A-387E-49AE-9750-E248F5704F7B","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.007.jpeg","telop":"「もしかして、君の父親って、妹紅先輩？」","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第8スライド","duration":3.5,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 8","voiceDuration":3.6430385487528345,"id":"B02D5B18-9885-44E6-9866-8F566B16DE98","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.008.jpeg","telop":"「そうですけど…父も、この学校出身なんですか？」","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第9スライド","duration":5.7,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 9","voiceDuration":7.116145124716553,"id":"5C468B9D-67F0-41B3-B13F-0D05FC09E0C7","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_009_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.009.jpeg","telop":"「いや、私たちが以前に、著名大学院同士での交流会の時に、ある男子校の裏側の有名人だったの…、いつの間に子どもを…」","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第10スライド","duration":3.5,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 10","voiceDuration":2.0278231292517006,"id":"C0EFFBE2-FC1D-4B61-9198-27392361515C","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.010.jpeg","telop":"「あの、何が言いたいんですか？」","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第11スライド","duration":5.6000000000000005,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 11","voiceDuration":6.82546485260771,"id":"8FB95B93-F7B8-416B-983F-4B0ACB800FAD","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.011.jpeg","telop":"「いや、こんな話はもういいわ、それより、君はこれから、一人で教室まで戻れるかしら？戻れないなら、案内するけど…」","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第12スライド","duration":4.7,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 12","voiceDuration":7.512607709750567,"id":"E255B374-436D-4681-8412-B394F1C239BD","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.012.jpeg","telop":"「いや、一人で大丈夫です。では、失礼します。」\n僕は、そう言い立ちあがろうとすると、眩暈がする。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E3%82%A2%E3%83%AA%E3%82%B9%E3%83%BB%E3%83%9E%E3%83%BC%E3%82%AC%E3%83%88%E3%83%AD%E3%82%A4%E3%83%89","slideTitle":"第13スライド","duration":4,"characterName":"アリス・マーガトロイド","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 13","voiceDuration":5.186439909297052,"id":"653B5172-E157-4B93-B932-D90E70815F66","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_013_アリス・マーガトロイド.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.013.jpeg","telop":"私は、彼が倒れかけるのを見て、そっと腕を出し支える。\n「君、本当に一人で大丈夫？」","voiceCharacter":"アリス・マーガトロイド"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第14スライド","duration":6.1000000000000005,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 14","voiceDuration":9.250634920634921,"id":"6E529C97-9D17-46A1-9372-D440C919F246","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_014_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.014.jpeg","telop":"「きっと、長い時間座っていたからだと思いますから、心配はいらないですよ。それでは、失礼します。」僕はそう言い、部屋を出た。","voiceCharacter":"操夢"},{"id":"ED003D2C-CFC2-4A9A-8C68-BE7D5EB550B6","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.015.jpeg","bgmName":"BGM: 少女綺想曲","characterName":"","telop":"元女子校の日常","duration":3,"title":"東方Project二次創作作品　Powerd By zuyasi","voiceCharacter":"","animationName":"なし","slideTitle":"タイトル","backgroundName":"単色背景"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第16スライド","duration":5,"characterName":"操夢","transitionName":"なし","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","title":"シーン 16","voiceDuration":7.890861678004535,"id":"1B664D1D-93F3-4D06-9B9D-B7B75C7628B6","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.016.jpeg","telop":"僕はそれから、夜の学校を歩いていく。だが、空腹と疲労が、溜まりに溜まったこの体が、悲鳴をあげている。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第17スライド","duration":4.9,"characterName":"操夢","transitionName":"なし","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","title":"シーン 17","voiceDuration":7.499546485260771,"id":"074C27FB-A8AE-437E-8E6B-10A2D9BD133F","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.017.jpeg","telop":"そして、やがてその疲労は、頭にやってくる。\n「うぅ…」僕は、気絶しないように、意識を保ちながら歩く。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第18スライド","duration":4.3,"characterName":"操夢","transitionName":"なし","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","title":"シーン 18","voiceDuration":6.9484580498866215,"id":"2879EC77-3DF5-45B4-8EBC-E663240C78B3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.018.jpeg","telop":"そして、僕は、ある人影を見る。\nだが、僕はとうとう、その場で気を失い、倒れ込むのだった。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","slideTitle":"第19スライド","duration":4.6000000000000005,"characterName":"東風谷早苗","transitionName":"なし","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","title":"シーン 19","voiceDuration":7.8960090702947845,"id":"663723CB-61CD-4E18-9A94-4D534321D872","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_東風谷早苗.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.019.jpeg","telop":"私は、突如倒れ込んだ、彼に近づき、声をかける。\nだが、反応が返らず、彼を抱え、職員室に向かう。","voiceCharacter":"東風谷早苗"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/文（驚く）.png","animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","slideTitle":"第20スライド","duration":3.5,"characterName":"東風谷早苗","transitionName":"なし","backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","title":"シーン 20","voiceDuration":4.194807256235828,"id":"9F43F110-8016-4CDF-AE6F-63EA1BD0603A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_東風谷早苗.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.020.jpeg","telop":"私が職員室に入ると、彼女が私の方を見ると、驚く。","voiceCharacter":"東風谷早苗"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"第21スライド","duration":3.5,"characterName":"射命丸文","transitionName":"なし","backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","title":"シーン 21","voiceDuration":2.895578231292517,"id":"C3252B39-4006-4B6D-99B7-C2BFE9D356A3","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.021.jpeg","telop":"「どうしたんですか、早苗さん、その彼は？」","voiceCharacter":"射命丸文"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","slideTitle":"第22スライド","duration":4.7,"characterName":"東風谷早苗","transitionName":"なし","backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","title":"シーン 22","voiceDuration":6.7851700680272105,"id":"76A34EC1-78C1-4CBF-A6E4-73CD9E9C5B90","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_東風谷早苗.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.022.jpeg","telop":"「ふとさっき、私が廊下を歩いていたら、彼が倒れたんですよ。それで、彼、叩いたら起きますかね…」","voiceCharacter":"東風谷早苗"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"第23スライド","duration":3.8000000000000003,"characterName":"射命丸文","transitionName":"なし","backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","title":"シーン 23","voiceDuration":4.899591836734694,"id":"C9A71C35-57DD-45CF-AE1E-2B940A41B32E","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.023.jpeg","telop":"「いや、叩くのはよしたほうがいいですよ、\n私が彼を自宅まで送り届けましょう。」","voiceCharacter":"射命丸文"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","slideTitle":"第24スライド","duration":4.9,"characterName":"東風谷早苗","transitionName":"なし","backgroundName":"nc253890_学校の職員室（夜・照明ON）.jpg","title":"シーン 24","voiceDuration":6.689795918367347,"id":"507E061D-C264-43CB-9BD0-5D9E279BCF74","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_東風谷早苗.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.024.jpeg","telop":"「そうですか…、それではよろしくお願いします。」\n私は、そういうと、彼の身柄を彼女に預けるのだった。","voiceCharacter":"東風谷早苗"},{"id":"876B379B-6B5D-4FBB-9F94-3A6CB78E66B7","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.025.jpeg","bgmName":"BGM: 少女綺想曲","characterName":"射命丸文","telop":"","duration":3,"title":"文が彼を抱え、彼の家に着くと…","voiceCharacter":"射命丸文","animationName":"なし","slideTitle":"中扉","backgroundName":"単色背景"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"第26スライド","duration":4.800000000000001,"characterName":"射命丸文","transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","title":"シーン 26","voiceDuration":6.517596371882086,"id":"5F3682B4-DCE2-4732-8EB6-9C9C93FF369E","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.026.jpeg","telop":"私は、彼の家に着くと、インターホンを押す。\n「武蔵学園の射命丸文です、誰かいらっしゃいませんか？」","voiceCharacter":"射命丸文"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"第27スライド","duration":4.6000000000000005,"characterName":"射命丸文","transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","title":"シーン 27","voiceDuration":6.517596371882086,"id":"FA7DCE1D-11D3-46A6-97FA-E6C4A322F688","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.027.jpeg","telop":"すると、彼女の母で、学園の卒業生が出てきた。\n「あなたが連絡されていた彼を確保してきました。」","voiceCharacter":"射命丸文"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_reimu","slideTitle":"第28スライド","duration":3.5,"characterName":"博麗霊夢","transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","title":"シーン 28","voiceDuration":3.366984126984127,"id":"824CA466-781D-4FD4-BCFB-2B6928B251A2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.028.jpeg","telop":"「ありがとうございます。」私はそう返す。","voiceCharacter":"博麗霊夢"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（微笑）.png","animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"第29スライド","duration":4.7,"characterName":"射命丸文","transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","title":"シーン 29","voiceDuration":6.174580498866213,"id":"2CE70B41-F88C-4EE8-A2BC-E06AA0CAD9BA","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_029_射命丸文.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.029.jpeg","telop":"「それじゃあ、後は、よろしくお願いします。」\n私はそういうと、彼をそっと下ろし、その場をさった。","voiceCharacter":"射命丸文"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_reimu","slideTitle":"第30スライド","duration":4.800000000000001,"characterName":"博麗霊夢","transitionName":"なし","backgroundName":"nc235081_家（夜・灯りあり）.jpg","title":"シーン 30","voiceDuration":8.520748299319727,"id":"7A443FF1-C43B-4B14-9E7A-DBF8906E58DB","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.030.jpeg","telop":"「はぁ、全く困ったものだわ…」私は、ゆっくりと彼を抱えると、そのまま彼の部屋に、向かうのだった。","voiceCharacter":"博麗霊夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","slideTitle":"第31スライド","duration":3,"characterName":"ナレーション","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 31","id":"0D7F81CD-75C6-41E1-B72C-D7750C83AD54","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.031.jpeg","telop":"彼の目が覚めると…","voiceCharacter":"ナレーション"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第32スライド","duration":4.9,"characterName":"操夢","transitionName":"なし","backgroundName":"一人部屋３（夜・照明OFF）.jpg","title":"シーン 32","voiceDuration":7.146303854875283,"id":"893F7406-27D7-4927-B0DB-DB27642F1008","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.032.jpeg","telop":"僕は、ふと目が覚めると、そこは自分の部屋だった。\nそして、ゆっくりとベッドから降りて、電気をつける。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第33スライド","duration":5.1000000000000005,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","backgroundName":"一人部屋３（夜・照明ON）.jpg","title":"シーン 33","voiceDuration":7.582154195011338,"id":"84BB2D10-8A8B-4215-8EF3-F1E4FFB1EEDF","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.033.jpeg","telop":"そして、時計を見ると、深夜帯だということに気がつく。\nそして、同時に机の上にメモ書きがあることに気づく。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第34スライド","duration":5.4,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","backgroundName":"一人部屋３（夜・照明ON）.jpg","title":"シーン 34","voiceDuration":7.466938775510204,"id":"831F4658-54D2-4DEF-809E-B95698459F07","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.034.jpeg","telop":"そのメモ書きは、僕の知らない筆記跡でこう書かれていた。\n「これ以上無茶をすると、その頭が台無しになるぞ」と…。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第35スライド","duration":5.4,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","backgroundName":"一人部屋３（夜・照明ON）.jpg","title":"シーン 35","voiceDuration":8.012607709750567,"id":"4D061BB6-CB2A-48B4-82AC-CC4E0A7B6EA1","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.035.jpeg","telop":"「ふっ…」僕は、それを見て思わずそう吹いてしまう。確かに、この人の言うとおり、僕の取り柄は勉学だけだからだ。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第36スライド","duration":5.7,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","backgroundName":"一人部屋３（夜・照明ON）.jpg","title":"シーン 36","voiceDuration":8.60498866213152,"id":"4B487414-AC88-463A-8C4E-A99DA7D48F65","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.036.jpeg","telop":"そして、そのメモ書きを残した人物にも、心当たりがないわけではなかった、だが、ごく僅かに感じるそれを、僕は思い返す。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第37スライド","duration":5.2,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（夜・照明ON）.jpg","backgroundName":"一人部屋３（夜・照明ON）.jpg","title":"シーン 37","voiceDuration":7.689773242630386,"id":"FC75BF2C-E942-4F84-AF8D-7FEEBE47DF05","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.037.jpeg","telop":"そして、ふとその横にある家族写真が目に映る…。\nそして、「ふぅ」と一息吐くと、電気を消し、ベッドに戻った。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","slideTitle":"第38スライド","duration":3,"characterName":"ナレーション","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 38","id":"91440A4B-F2EC-4E6B-B819-44D9CA12AD0A","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.038.jpeg","telop":"そのころ、とある場所では…","voiceCharacter":"ナレーション"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第39スライド","duration":4.800000000000001,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc238758_一人部屋（夜・月明り）.jpg","title":"シーン 39","voiceDuration":8.496984126984128,"id":"8BC48B77-FCE5-4C75-BF83-BBE9D2A1D773","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.039.jpeg","telop":"私は、自分の部屋で窓に視線を当てながら、片手に缶ビールを持ち、ぼそぼそと、一人小言を呟いていた。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第40スライド","duration":4.4,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc238758_一人部屋（夜・月明り）.jpg","title":"シーン 40","voiceDuration":8.176984126984127,"id":"8A8A0531-1908-4813-B6CF-819F4EF2C787","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.040.jpeg","telop":"「なぁ、お前は、どう思う、今の私を見て…」\n私は、誰もいない部屋で、そう誰かに語りかける。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第41スライド","duration":4.3,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc238758_一人部屋（夜・月明り）.jpg","title":"シーン 41","voiceDuration":8.350748299319728,"id":"71B15D13-F9C2-4287-9178-CE0140B192D2","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.041.jpeg","telop":"だが、返事はない。それでも私は、言葉を続ける。\n「今の私が、お前に知られたら、きっと…」","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第42スライド","duration":4.9,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc238758_一人部屋（夜・月明り）.jpg","title":"シーン 42","voiceDuration":8.515736961451248,"id":"F6B6B581-7FB6-45EF-9FFB-E783C258BE1D","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.042.jpeg","telop":"「きっと…」私は、そう言うと、ふと後ろから声が聞こえる。\n誰もいないはずの空間からは、声が聞こえる。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第43スライド","duration":5.2,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc238758_一人部屋（夜・月明り）.jpg","title":"シーン 43","voiceDuration":9.579478458049886,"id":"C8C666D3-B080-4DC9-B2C4-DEB911701170","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.043.jpeg","telop":"だが、私は、頭を振り、缶ビールを飲み切ると、そのままベッドに入る。だが、だんだんと、その声は大きくなる。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第44スライド","duration":3.5,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc238758_一人部屋（夜・月明り）.jpg","title":"シーン 44","voiceDuration":4.809478458049886,"id":"AEDB5521-EBCC-45A5-89BC-1330AC3EDD25","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.044.jpeg","telop":"私は、ふと気がつけば、その声に体が勝手に動いていた。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","slideTitle":"第45スライド","duration":3,"characterName":"ナレーション","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 45","id":"CC2BFEB4-E53D-4F94-98AA-8B5F32789B26","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.045.jpeg","telop":"それから…","voiceCharacter":"ナレーション"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第46スライド","duration":3.8000000000000003,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 46","voiceDuration":6.868231292517007,"id":"043F7D5F-8355-4FDD-A7FD-44F63921111D","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.046.jpeg","telop":"「あれ、私は…いったい何を…」\n私は、ふと気がつくと、そこはある交差点だった。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","slideTitle":"第47スライド","duration":5.2,"characterName":"藤原妹紅","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 47","voiceDuration":7.612063492063492,"id":"FE93E822-79E5-4BF9-BD5F-13028286FE98","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.047.jpeg","telop":"「お前、今俺が止めなければ、車に轢かれるところだったぞ。\nこんな時間帯に、女一人でふらふら何してたんだ？」","voiceCharacter":"妹紅"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第48スライド","duration":3.5,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 48","voiceDuration":3.5494784580498866,"id":"135959B7-5368-4694-8B20-B7B363DCF1D8","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.048.jpeg","telop":"「えっ…」私はそう言われるが、思い出せない。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","slideTitle":"第49スライド","duration":5,"characterName":"藤原妹紅","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 49","voiceDuration":7.3933333333333335,"id":"10CE3CD8-29C2-41EE-946E-C16680F696F5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_049_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.049.jpeg","telop":"「まぁ、車が走ってなかったことが幸いか。それより、お前さんは、どうしたんだ、何かに血迷ってるのか？」","voiceCharacter":"妹紅"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第50スライド","duration":3.9000000000000004,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 50","voiceDuration":6.328231292517007,"id":"FD3F6B44-472C-4F31-B298-1C4902BEFED5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_050_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.050.jpeg","telop":"「えっと…、私はただ…」\nそう言いかけて気がつく。「あなたは、霊夢の旦那さん…」","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","slideTitle":"第51スライド","duration":3.5,"characterName":"藤原妹紅","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 51","voiceDuration":3.0141496598639455,"id":"228EADC1-A7B6-44F1-AC2D-DEADE63F167B","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_051_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.051.jpeg","telop":"「そうか…、そしたら、久々の顔合わせだな…」","voiceCharacter":"妹紅"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_%E5%A6%B9%E7%B4%85","slideTitle":"第52スライド","duration":4.800000000000001,"characterName":"藤原妹紅","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 52","voiceDuration":7.0672789115646255,"id":"AAF809F0-8B44-4331-995B-48999A0D337D","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_052_妹紅.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.052.jpeg","telop":"「まぁ、とにかく、次からは、信号をよく見て渡るんだな。」\n私は、そう言うと、その場をさっていった。","voiceCharacter":"妹紅"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_marisa","slideTitle":"第53スライド","duration":3.9000000000000004,"characterName":"霧雨魔理沙","transitionName":"なし","backgroundName":"nc257257_街中の交差点（夜）.jpg","title":"シーン 53","voiceDuration":7.0082312925170065,"id":"316929B7-6842-4DE6-80D8-C9B926FB97BD","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_053_霧雨魔理沙.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.053.jpeg","telop":"私は、彼が立ち去ると、「あの声は、いったい誰の声だったんだろう…」っと、そう呟きながら、家に帰るのだった。","voiceCharacter":"霧雨魔理沙"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","slideTitle":"第54スライド","duration":3,"characterName":"ナレーション","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 54","id":"161F674A-02A1-44B6-B87A-FD65ED978E14","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.054.jpeg","telop":"翌朝…","voiceCharacter":"ナレーション"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第55スライド","duration":5.4,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/一人部屋３（日中）.jpg","backgroundName":"一人部屋３（日中）.jpg","title":"シーン 55","voiceDuration":7.675646258503401,"id":"1881ABB1-F7E9-44C8-934D-522CE2EB561A","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.055.jpeg","telop":"僕は、目が覚め、カーテンを開けると、朝日が部屋に差し込んでいた。そして、あくびをしながら、リビングに向かう。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第56スライド","duration":3.5,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","title":"シーン 56","voiceDuration":2.7039002267573697,"id":"9D58A230-C699-4E42-9D88-20CAF8791B84","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.056.jpeg","telop":"「どうしたの、母さん、そんな顔して。」","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_reimu","slideTitle":"第57スライド","duration":5.5,"characterName":"博麗霊夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","title":"シーン 57","voiceDuration":8.843242630385488,"id":"CCFB199A-2883-415C-B6B7-61C5D89C2B52","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_057_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.057.jpeg","telop":"「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」","voiceCharacter":"博麗霊夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第58スライド","duration":5.300000000000001,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","title":"シーン 58","voiceDuration":8.095215419501134,"id":"D7BB51CB-C42D-4527-BEE9-8EBD7C53B3B5","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_058_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.058.jpeg","telop":"「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_reimu","slideTitle":"第59スライド","duration":3.5,"characterName":"博麗霊夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","title":"シーン 59","voiceDuration":2.234489795918367,"id":"6A3CBDBC-B3BB-41F1-8782-9A9348AC5BDE","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_059_博麗霊夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.059.jpeg","telop":"「それじゃあ、行ってくるわ…」","voiceCharacter":"博麗霊夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第60スライド","duration":5,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","title":"シーン 60","voiceDuration":7.006077097505669,"id":"F2FA8C4F-AD8A-46B1-ACCD-D8E6F71AE546","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_060_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.060.jpeg","telop":"僕は、それから朝食を食べ終えると、母が残していた洗い物などもまとめて済ませ、ふと冷蔵庫を開けてみる。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第61スライド","duration":4.6000000000000005,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/リビング（日中）.jpg","backgroundName":"リビング（日中）.jpeg","title":"シーン 61","voiceDuration":7.239773242630386,"id":"D8A58123-2D81-4909-8C9C-69D18C554738","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_061_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.061.jpeg","telop":"冷蔵庫の中は、スカスカだった。「買い物しないと…」\n僕は、そうぼさっと呟きながら、自室に戻る。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第62スライド","duration":5.9,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）叡智シーンのみ\/一人部屋３（日中）.jpg","backgroundName":"一人部屋３（日中）.pxd","title":"シーン 62","voiceDuration":8.919115646258504,"id":"1C5E78A9-5529-48E2-9E39-6BF478AEEE7B","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_062_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.062.jpeg","telop":"そして、自室に戻ってくると、少し目に見えぬ埃が溜まっていたので、軽くを掃除機をかける。そして、ふと両親の部屋に向かう。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第63スライド","duration":5.300000000000001,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 63","voiceDuration":7.758253968253968,"id":"5D757797-FCCC-4F3E-A174-9739F4256998","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_063_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.063.jpeg","telop":"そして、ふと窓から見える背景を見て思い出す、ここは台地の上で、向こう側は低地なため、景色が随分といいのだ。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第64スライド","duration":5.6000000000000005,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 64","voiceDuration":8.747369614512472,"id":"169C1E3D-2557-4DBD-9E29-485FC49A4ACA","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_064_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.064.jpeg","telop":"そして、部屋を見渡す。母は準備をきちんと済ませてから、リビングで朝食を食べていた。僕は、机からメモ帳を出す。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","audioTrack":"track_voice_soumu","slideTitle":"第65スライド","duration":5.5,"characterName":"操夢","transitionName":"なし","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","title":"シーン 65","voiceDuration":8.49845804988662,"id":"50BADA33-58F1-4F1D-89CD-D9C22AF38847","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.065.jpeg","telop":"そして、そこに冷蔵庫がスカスカなのを記して、机に残すと、僕は、自室で身なりを整えてから、学校に向かうのだった。","voiceCharacter":"操夢"},{"animationName":"なし","bgmName":"BGM: 少女綺想曲","slideTitle":"中扉","duration":20,"characterName":"","transitionName":"なし","backgroundName":"単色背景","title":"ご視聴ありがとうございました！","id":"DA5661D2-26BD-4CCB-8B1F-F260AC436A63","seAudioPath":"\/Volumes\/ZSSD\/動画用\/音楽\/BGM\/nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/元女子校の日常　第6話_b1e3363766\/元女子校の日常　第6話_b1e3363766.066.jpeg","telop":"","seName":"SE: nc122879_【東方アレンジ】砕月～いぶきすいかのものがたり～","voiceCharacter":""}]