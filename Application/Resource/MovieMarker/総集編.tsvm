meOffset":0,"characterName":"サブ","bgmStartTimeOffset":0,"title":"シーン 65","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_065_妹紅.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.065.jpeg","id":"972690CC-294D-46D7-B540-22FF66D204D2","slideTitle":"第65スライド"},{"audioTrack":"track_voice_sub","telop":"そして私は、多目的トイレに来るとその場に倒れ込んだ。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"サブ","voiceDuration":5.495396825396825,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"サブ","bgmStartTimeOffset":0,"title":"シーン 66","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第14話\/ColabGPU_1791193839_80109.png","backgroundName":"ColabGPU_1791193839_80109.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_066_古明地さとり.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.066.jpeg","id":"DB7D6ACE-3956-4C7F-9AD5-67B7E7B9204F","slideTitle":"第66スライド"},{"audioTrack":"track_voice_soumu","telop":"「ん…、ここは…トイレ…」僕はそう呟き、ハッと思い出す。\n「確か、10分の自己紹介で人生を話したら、気絶して…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":7.330634920634921,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 67","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第14話\/ColabGPU_1791193839_80109.png","backgroundName":"ColabGPU_1791193839_80109.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_067_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.067.jpeg","id":"875ECCE5-72FA-4C05-A7AD-4EB4A0573213","slideTitle":"第67スライド"},{"audioTrack":"track_voice_soumu","telop":"「とりあえず…教室に戻るか…」\n僕はそう一人呟くと、念入りに手を洗ってから、トイレを出た。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":7.548458049886621,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 68","animationName":"なし","duration":4.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第14話\/ColabGPU_1791193839_80109.png","backgroundName":"ColabGPU_1791193839_80109.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_068_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.068.jpeg","id":"D6C10A6A-818D-41D7-A285-67F24B1D1230","slideTitle":"第68スライド"},{"voiceDuration":4.098231292517007,"bgmName":"BGM: 東方妖恋談","voiceCharacter":"古明地さとり","telop":"僕が教室に戻ってくると、\nさとりと呼ばれていた少女が僕に、駆け寄ってくる。","bgmStartTimeOffset":0,"voice2Durati