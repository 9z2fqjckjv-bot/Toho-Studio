es\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1241.jpeg","id":"9E3BEAC2-6AD0-43D1-8E18-1521F3F184B2","slideTitle":"第1241スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","telop":"「ええ、班長の名前はアリス・マーガトロイドですが…？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 1242","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1242.jpeg","id":"40E081A2-696E-48F6-95AC-F903AFE58E53","slideTitle":"第1242スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","telop":"「なら、パチュリーに言いつけて、確認させて、あなたがその内容を聞いて、私に報告しなさい、期限は今日の午後3時までだ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"隠岐奈","bgmStartTimeOffset":0,"title":"シーン 1243","animationName":"なし","duration":5.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath"