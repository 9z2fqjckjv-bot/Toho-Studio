erImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（驚く）.png","telop":"僕が家に戻ると、フランが驚いた様子でこちらを見る。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 698","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.698.jpeg","id":"377575DB-5590-4D8D-B7CE-2BE57C0A18BD","slideTitle":"第698スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「どうしたの、お姉様…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 699","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.699.jpeg","id":"3D7AD8B5-805A-4813-8935-B722449EF4F3","slideTitle":"第699スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","telop":"「彼の母親と契約して、彼を引き取りに来たのよ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 700","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.700.jpeg","id":"2F5792A0-13D9-4CFA-8FCD-860F071B7E0F","slideTitle":"第700スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「え…、それって…これからあの屋敷で彼と住むってこと？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 701","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.701.jpeg","id":"72B8FFDA-07F8-4BDD-8332-25E112090840","slideTitle":"第701スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（微笑）.png","telop":"「ええそのとおり。それで、紅夢くんは、\n荷物と部屋の整理にどれくらいの時間がかかるかしら？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 702","animationName":"なし","duration":4.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.702.jpeg","id":"54088BD5-987F-4EB8-B8CE-30368F0DF2A7","slideTitle":"第702スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","telop":"「えっと…」僕は、レミリアの発言に戸惑ってしまう。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 703","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.703.jpeg","id":"7321C8E4-63BD-4333-B0D3-D4B98A2BCC4A","slideTitle":"第703スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","telop":"「もし、時間がかかるなら、私もお手伝いするわ。それで、どうかしら？できれば、今日の夕方には屋敷宛に発送したいけど…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 704","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.704.jpeg","id":"025714EE-79AD-4AE4-8980-87E37DC7B2CE","slideTitle":"第704スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/レミリア（笑い）.png","telop":"「じゃあ、それでお願いします…」\nそれから、僕と彼女たちは引っ越しの作業を進めるのだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 705","animationName":"なし","duration":4.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.705.jpeg","id":"530D7B17-8C8F-45C2-B37C-D860BCCA5823","slideTitle":"第705スライド"},{"telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"一方、魔理沙は…","animationName":"なし","duration":2.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.706.jpeg","id":"72372E9D-07DC-4B00-85AB-BBFE0758D7BC","slideTitle":"中扉"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"私は、ふと目が覚めると、そこは病院だった。\nすると、誰かが入ってくる。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"霧雨魔理沙","bgmStartTimeOffset":0,"title":"シーン 707","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/T