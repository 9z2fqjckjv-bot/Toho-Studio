/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.640.jpeg","id":"6BCF625B-4914-4C4E-8053-0F952E065BBB","slideTitle":"第640スライド"},{"telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"二人が家に着くと…","animationName":"なし","duration":2.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.641.jpeg","id":"D4DF5293-B4A0-4345-875C-03841D8EFB4F","slideTitle":"中扉"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 642","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.642.jpeg","id":"11D110DC-68B9-478C-91EF-6C896B805304","slideTitle":"第642スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/後ろ手すやすや頬照り寝顔.pxd","telop":"そして、そっと息子の部屋の扉を開けて、中を覗く。すると、彼女が言っていた女性が、スヤスヤとベッドで寝ていた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 643","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.643.jpeg","id":"983123DB-DCDE-4D1E-B3E0-27ABABB2A351","slideTitle":"第643スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"そして、私と彼の部屋に入ると、紅夢がベッドの片方で寝ていた。私は、それを確認すると、リビングで待つ彼女の元に戻る。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 644","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.644.jpeg","id":"A73495FD-1C6E-4E71-85CC-3E362DB6672C","slideTitle":"第644スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","telop":"「それで、各部屋の様子はどうでしたか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 645","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.645.jpeg","id":"4B1631D6-410B-4D80-B143-E367CEC49E0D","slideTitle":"第645スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","telop":"「あなたに指摘された通りです。それで…本当に私の息子の許嫁に妹さんをもらって大丈夫でしょうか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 646","animationName":"なし","duration":4.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.646.jpeg","id":"19C867C4-D987-4B37-8116-7FB74A6F8167","slideTitle":"第646スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","telop":"「ええ、妹がきっとそれを望みますから…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 647","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.647.jpeg","id":"91F3E3A2-E41E-4B64-85D3-09E14237E11C","slideTitle":"第647スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","telop":"「建設会社の方は、後継者はいるのですか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 648","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.648.jpeg","id":"0F7667DB-DB12-43A4-8B39-B060F2E60D0A","slideTitle":"第648スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","telop":"「後継者は今は、いませんが…、それが何か？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 649","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.649.jpeg","id":"60B2DEEA-FBBC-46A8-91F6-61A0EA122012","slideTitle":"第649スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/後ろ手困り顔.png","telop":"私は、息子の事情を話すべきか迷う、だが、ここで話しておかないと後々大変になるのは目に見えていた。「実は…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 650","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.650.jpeg","id":"A49CDAC3-5669-4917-9BEF-92B6E9371CC1","slideTitle":"第650スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/後ろ手驚く.png","telop":"私は、彼女の話にとても驚く。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 651","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.651.jpeg","id":"FE02D105-C69D-4134-ADC4-A9049CE8A4B7","slideTitle":"第651スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/レミリア（弱る）.png","telop":"「そうですか…」私は、このままでは養子を迎え入れるか、企業合併以外の選択肢しか残されない事実に考え込む。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 652","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.652.jpeg","id":"D0994556-0288-46A1-8A2A-8F26834339CB","slideTitle":"第652スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","telop":"「承知しました…。それでもう一つお願いがあるのですか…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 653","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.653.jpeg","id":"219B064E-772E-467C-989C-173EA903C313","slideTitle":"第653スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/霊夢（驚く）.png","telop":"私はその内容に驚く。そして考えこむ。それから数分程度の間の後、告げる。「それでは、息子の今後については頼みます。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 654","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.654.jpeg","id":"81E35760-DBA8-4C6A-896B-E6B6DA4E0DA5","slideTitle":"第654スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","telop":"「私からの二つの願いに答えていただき、ありがとうございます。このご恩は、近いうちに必ずお返しします。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 655","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.655.jpeg","id":"093E0BED-2628-4D71-8E05-FD9D573909B9","slideTitle":"第655スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"彼女はそういうと、家を去っていった。私は、「はぁ…」吐息を吐くと、そのまま入浴を済ませて、寝室に向かう。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 656","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.656.jpeg","id":"038E0133-4A9E-4AC2-B250-9EC989BCE335","slideTitle":"第656スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"そして、部屋にそっと入って気づく。「今日は久々の添い寝ね…」私はそう呟きながら、彼の横に入り、寝付くのだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 657","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.657.jpeg","id":"FDEC647E-D085-488F-A490-D3C6E244726F","slideTitle":"第657スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「ねぇ、私と一緒に、大人の体験、してみない？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 658","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.658.jpeg","id":"89AD1EB0-4766-457E-A158-EBCC50EDF3BD","slideTitle":"第658スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「大人の体験？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 659","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.659.jpeg","id":"60F15C10-6B51-4635-9A03-365E67A0E06E","slideTitle":"第659スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「うん、そう、私が導いてあげる、だから私に身を委ねて。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 660","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.660.jpeg","id":"DC36A3DD-A30E-41DE-BF8F-AF55ACCE8E8D","slideTitle":"第660スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"僕は、彼女にそう言われ、息を吐きながら、脱力する。\nすると、彼女が僕の背中に手を回し、唇をそっとくっつける。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 661","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.661.jpeg","id":"E7780DFD-D172-481D-9E07-87B36D48DC52","slideTitle":"第661スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"すると、彼女が僕の手を握り、そっと彼女の胸に当てる。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 662","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.662.jpeg","id":"311B8C44-1834-40AE-A16E-0332683A0D99","slideTitle":"第662スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「ほら、どう先生のーは？大きい？小さい？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 663","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.663.jpeg","id":"A02646F6-1117-4E2A-A34C-DD515CB0BFE3","slideTitle":"第663スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「…僕は、どっちでも大丈夫ですよ…」僕は、どこかふわふわしたような、だが確かに感じるその感触を味わう。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 664","animationName":"なし","duration":5.100000000000000