-4C95-B969-A761AC363B13","slideTitle":"第1130スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「紅夢、大丈夫、暗い表情をして…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1131","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1131.jpeg","id":"59667380-6037-4FAA-A859-7B90C1B8313B","slideTitle":"第1131スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","telop":"「少しばかし、悪い夢を見ていただけですよ…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1132","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1132.jpeg","id":"74CE0FD8-E1C8-4E9D-89B4-65F429152BDE","slideTitle":"第1132スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「そう…、ほら、これ…」私はそう言うと、差し入れを渡す。\n「病院の許可はとってあるから、ちゃんと食べてね…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1133","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1133.jpeg","id":"85F3CD34-C81B-4F13-AED4-09A78A348D61","slideTitle":"第1133スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","telop":"「ありがとうございます…」僕はそう言われ、渡されたお弁当の堤を開けて、中身を取り出す。それは手作りのお弁当だった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1134","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1134.jpeg","id":"AD700750-2993-4FE7-9780-2C176737DC29","slideTitle":"第1134スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「これ、私が頑張って作ったから、しっかり食べ切ってね…」\n私は、そう言うと、一度、病室から離れていった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1135","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1135.jpeg","id":"AF32AF63-EBDC-4562-9498-84286909E17B","slideTitle":"第1135スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"僕は、彼女が病室を出ると、早速そのお弁当を開ける。\nそして、そのお弁当をよく味わって食べていった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1136","animationName":"なし","duration":4.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1136.jpeg","id":"3388ED9D-219C-4A99-B750-82DF41938036","slideTitle":"第1136スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"それから、お弁当を数十分かけて、食べ終えると、僕は、そのまま窓の外に視線を向ける。そして、昨日のことを考える。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1137","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1137.jpeg","id":"41EC8C8B-E66B-4809-ADEC-966E7C6CCF21","slideTitle":"第1137スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"すると、だんだんと瞼が落ちそうになる。\nだが、ある光景が僕の脳裏を横切る。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1138","animationName":"なし","duration":3.6,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256899_病室-夜-電気あり.png","backgroundName":"nc256899_病室-夜-電気あり.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1138.jpeg","id":"C0CEF70F-1213-4BA2-876A-938BAB04B284","slideTitle":"第1138スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/フラン（狂気）.pxd","telop":"","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"シーン 1139","animationName":"なし","duration":2.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc244641_家の玄関ホール（日中）.jpg","backgroundName":"nc244641_家の玄関ホール（日中）.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1139.jpeg","id":"8317CAFD-18B3-46BE-ACB1-E92E5FBB0F76","slideTitle":"中扉"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「紅夢、大丈夫？顔が青ざめてるよ…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1140","animationName":"なし","d