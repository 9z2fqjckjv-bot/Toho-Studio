[{"id":"26D40B14-80EB-4399-A6B6-C80B7200571D","title":"元女子校の日常　全話一気見総集編","duration":1.5,"slideTitle":"タイトル","backgroundName":"単色背景","characterName":"","telop":"東方Project二次創作作品　Powerd by zuyasi","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.001.jpeg","animationDuration":1.5},{"id":"6462B50F-7DFB-46F0-B359-40BD7E0DD6EE","title":"シーン 2","duration":3.5,"slideTitle":"第2スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"僕は、目が覚めるとリビングに降りてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.002.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg"},{"id":"25878A12-52AA-4247-8D35-8E0FB572D68D","title":"シーン 3","duration":3.5,"slideTitle":"第3スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"すると、僕の母…霊夢が話しかけてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.003.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"9E34F207-030C-4C07-A84E-7E0E377D09B1","title":"シーン 4","duration":5.2,"slideTitle":"第4スライド","backgroundName":"リビング（日中）.jpg","characterName":"博麗霊夢","telop":"「ちょうど、朝食ができて食べ始めたところだから、あんたも早く、席に着いてちゃちゃっと食べちゃいなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.004.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"9F6AFF5B-CEE7-48F2-B3A3-506FDA2177FD","title":"シーン 5","duration":3.5,"slideTitle":"第5スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"「分かった…」\n僕はそういうと、目の前の卵かけご飯を食べる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.005.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"E3E64BD3-5CF0-4714-8FAF-13BA704479A3","title":"シーン 6","duration":3.5,"slideTitle":"第6スライド","backgroundName":"リビング（日中）.jpg","characterName":"博麗霊夢","telop":"「そういえば、入学式は、親の付き添いっているの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.006.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"A0CFD9BF-7745-4163-8515-FFC1CFF5BE38","title":"シーン 7","duration":3.5,"slideTitle":"第7スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"「いや、大丈夫だから、付き添わなくていいよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.007.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"0C457A5B-B3B3-4C6A-B3CF-ED49C27D81FB","title":"シーン 8","duration":4.2,"slideTitle":"第8スライド","backgroundName":"リビング（日中）.jpg","characterName":"博麗霊夢","telop":"「そう、じゃあ、あんたの分の食器は自分で洗いなさいね。\n私は、もう神社に向かうから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.008.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"E3E3EF9A-8EA8-448D-8AEF-84A8C88D4CBC","title":"シーン 9","duration":3.5,"slideTitle":"第9スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"「分かった。」\n僕がそういうと、彼女はそのまま家を出ていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.009.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"2DB9BC34-E8D9-468F-8533-3BF55713EA10","title":"シーン 10","duration":4.7,"slideTitle":"第10スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"僕は、それから数分も経たずに、朝食を食べ切ると、そのまあ流しに食器を入れ、ささっと洗剤で洗う。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.010.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg"},{"id":"04049E7F-EB5D-4789-9480-B03C085CA3AA","title":"シーン 11","duration":3.5,"slideTitle":"第11スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"そして、洗い物が終わると、自分の部屋に戻る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.011.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg"},{"id":"B6DE5D8F-36E9-467E-AF40-2A5C6307EAFE","title":"シーン 12","duration":5.800000000000001,"slideTitle":"第12スライド","backgroundName":"一人部屋３（日中）.jpg","characterName":"操夢","telop":"そして、部屋に戻ると、新品の学校の制服を取り出し、ささっと着替える。そして、デスクをチラリと見ると、ある写真が写る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.012.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/一人部屋３（日中）.jpg"},{"id":"912069BA-5DE5-4860-85AC-0F978825703B","title":"シーン 13","duration":5.5,"slideTitle":"第13スライド","backgroundName":"一人部屋３（日中）.jpg","characterName":"操夢","telop":"その写真には、巫女服の霊夢と、僕の父である妹紅、そして、僕の3人が写っていた。この時の僕はまだ、小学生だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.013.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/一人部屋３（日中）.jpg"},{"id":"3BE9CFDF-D089-4027-9CD0-B0CA1DD7FA43","title":"シーン 14","duration":5.4,"slideTitle":"第14スライド","backgroundName":"一人部屋３（日中）.jpg","characterName":"操夢","telop":"今思えば、僕がこの学校を選んだ理由も、中学時代のある経験が原因だ。中学まで男子ばっかで度々トラブルになった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.014.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/一人部屋３（日中）.jpg"},{"id":"7BFD10D0-488D-4E88-841F-BE70C1BFB32D","title":"シーン 15","duration":5.5,"slideTitle":"第15スライド","backgroundName":"一人部屋３（日中）.jpg","characterName":"操夢","telop":"世の中の男女比率…僕はそんなことを考えながら、ふと時計を見ると、もうすぐ家を出ないといけない時間で、頭を振る。","animationName":"なし","transitionName":"カラーでフェード","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.015.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/一人部屋３（日中）.jpg"},{"id":"83EABB70-5A7F-425A-B596-5F8D900CA5FF","title":"シーン 16","duration":4.3,"slideTitle":"第16スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、学校に着くと、腕につけている時計を見る、\n思っていたよりも早く着いたみたいだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.016.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"72D39A91-5F31-4FA7-A00A-9F2DC95B8AF0","title":"シーン 17","duration":3.5,"slideTitle":"第17スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして中に、入っていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.017.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"614E6B30-E055-4934-AFFE-B377587ECD1B","title":"シーン 18","duration":3.5,"slideTitle":"第18スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕が教室に入ると、すでに教室にいた\n女子たちが一斉にコチラを見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.018.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png"},{"id":"2004ABE8-C305-4D68-B47F-76FDBA171BE6","title":"シーン 19","duration":3.5,"slideTitle":"第19スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「あなたは…今年から来る中途入学の男子ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.019.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（微笑）.png"},{"id":"1FCFAF20-2363-480D-883C-372A879287D0","title":"シーン 20","duration":3.5,"slideTitle":"第20スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「中途入学…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.020.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（微笑）.png"},{"id":"D2E7F3E3-F966-46C8-B820-EFEBA418C7E8","title":"シーン 21","duration":5.5,"slideTitle":"第21スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「ええ、この学園では、幼稚部から大学院まであって、希望者は教員になって、定年まで居続けられる学園なんですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.021.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（微笑）.png"},{"id":"2F8CF17E-12CF-43F5-8505-BED460D06CDA","title":"シーン 22","duration":3.5,"slideTitle":"第22スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「へぇ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.022.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（微笑）.png"},{"id":"D2B72A04-0982-4A53-8B0B-27127EF2A3DF","title":"シーン 23","duration":3.5,"slideTitle":"第23スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「その顔…もしかして、この学園のことを\n何も知らずに入学したんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.023.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"BB585103-B552-4748-A3DB-55A9DF8A4023","title":"シーン 24","duration":3.9000000000000004,"slideTitle":"第24スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「両親に、この学校に行けって言われて、\nただそのまま来たっていえばいいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.024.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"FC567858-CDCD-41A1-864F-8963D9EA668E","title":"シーン 25","duration":4.4,"slideTitle":"第25スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「そうですか…。まぁ、あなた以外はみな小さい頃から見知った同姓の学生ばかりですからね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.025.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"4E8FEC9D-9A45-4F03-9333-FAB798238D62","title":"シーン 26","duration":3.5,"slideTitle":"第26スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「それで、僕の席は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.026.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"BD742BC0-EE65-4BA6-BD74-93978F32BF43","title":"シーン 27","duration":3.5,"slideTitle":"第27スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「確か、窓際の真ん中の席に空席があった気がしますが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.027.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"30488CA8-01B5-4EE8-ADCD-0E0598272658","title":"シーン 28","duration":3.5,"slideTitle":"第28スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「そうですか…」\n僕は、そう呟くと言われた席につき、荷物をおろし始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.028.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"FBADCAED-5D27-4DC6-AF2C-42231F0325C5","title":"それからしばらくたち…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.029.jpeg","animationDuration":1.5},{"id":"C7CF08F5-78CB-4056-99A8-B12E06AFFA48","title":"シーン 30","duration":5.800000000000001,"slideTitle":"第30スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"それから、数十分ほど経つと、チャイムがなり、教室が静まり返る。そして、数十秒程度の間の後、誰かが教室にはいってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.030.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png"},{"id":"E8B33CEE-9E40-42CE-8994-705EF1644C63","title":"シーン 31","duration":3.5,"slideTitle":"第31スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「おはようございます。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.031.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"3F27DA74-5A55-4764-A42E-42F37B9E2DD6","title":"シーン 32","duration":4.3,"slideTitle":"第32スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"その女性がそういうと、周りの女子たちが皆一斉に「おはようございます」と言い、礼をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.032.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"D14DC3DC-020D-4885-8014-C7B2A91E67DD","title":"シーン 33","duration":3.9000000000000004,"slideTitle":"第33スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「おや…一人…はずれものがいますね…」\n私はそう言い、その男子に目線を合わせる。","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.033.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"9B5530EC-02F8-4F96-8C57-CFF07A60D8E7","title":"シーン 34","duration":4.6000000000000005,"slideTitle":"第34スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「あなたも、今日から、この学園の一員ですから、\n挨拶の練習でもしましょうか…、藤原さん。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.034.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"5A114810-BBC6-4717-85B1-BBE92D899EB9","title":"シーン 35","duration":4.9,"slideTitle":"第35スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕はそう言われ、僕に向けての声かけだったことに気づく。\n「あの…練習って…何をすればいいんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.035.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"BDE6F66B-6094-40E1-AE60-253206D7BC70","title":"シーン 36","duration":3.5,"slideTitle":"第36スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「そうですね…とりあえず、私の方に来てください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.036.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"AD1EF886-99E0-4BAA-BF39-791747339719","title":"シーン 37","duration":4.800000000000001,"slideTitle":"第37スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕は、彼女にそう言われ、彼女の隣に立つ。\nすると、彼女が再び挨拶し、女子から挨拶と礼が返ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.037.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"430666D5-3AFB-4ADC-9AD6-B3BCA459F9BA","title":"シーン 38","duration":4.2,"slideTitle":"第38スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「彼女たちのように、あなたも私の挨拶に対して、\n挨拶とお辞儀で返すことはできますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.038.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"B873C9F6-0ADF-41AD-A5A2-D1F5A1A6D2AD","title":"シーン 39","duration":5.7,"slideTitle":"第39スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕はそう言われ、どう返すべきかわからず、黙ってしまう…。\nすると、彼女がある女子を呼び、その女子は僕の反対側に立つ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.039.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"B98D1015-0C1A-4CCC-AB2E-20512772062D","title":"シーン 40","duration":5.7,"slideTitle":"第40スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「さとりさん、私が今から、『おはようございます。』と言いますので、彼に返しの挨拶とお辞儀の手本を見せてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.040.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"92274145-FDDB-4F74-B97A-0AFE0A5910DD","title":"シーン 41","duration":4.2,"slideTitle":"第41スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「分かりました、早苗師匠。」\n私はそう返すと、彼女に言われた通りに、彼に手本を見せる。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.041.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（微笑）.png"},{"id":"ACDC9269-8C81-4291-87C0-476100792F83","title":"シーン 42","duration":4.5,"slideTitle":"第42スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「さて、お手本は見せました、今度はあなたの番ですよ、藤原さん。挨拶とお辞儀、出来ますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.042.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"44025829-97AB-44A7-A315-67AC69C4E134","title":"シーン 43","duration":3.5,"slideTitle":"第43スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕は、彼女にそう言われ、見よう見まねで挨拶とお辞儀をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.043.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"208FDCC2-B108-421C-B114-399C4DC932F2","title":"シーン 44","duration":5.4,"slideTitle":"第44スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「初日しては、上出来ですよ、藤原さん。それじゃあ、あなたのこれまでの人生について、10分間で言いましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.044.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（笑い）.png"},{"id":"FC9AE02B-EB13-4C8A-9F3E-05E83F0A0EAE","title":"シーン 45","duration":5.6000000000000005,"slideTitle":"第45スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「分かりました…」僕はそう言われ、これまでの人生を振り返る。そのうち、スイッチが入ったように、その内容を語った。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.045.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（笑い）.png"},{"id":"D89AE72E-BD34-4A84-B5F4-986B998A97E4","title":"シーン 46","duration":5.5,"slideTitle":"第46スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「今日の朝礼はこれで、終了です。今日から新年度ですので、心改めて、より良い自分を見せられるようにしましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.046.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"D5E5DC64-E761-40AE-8B1E-751C868D02FF","title":"シーン 47","duration":5.300000000000001,"slideTitle":"第47スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"彼女はそういうと、その場を去っていった。すると、彼女にさとりと呼ばれていた、先程の女子が僕の元に駆け寄る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.047.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png"},{"id":"3401E373-637C-4DF5-AAD4-6307FEC0262E","title":"シーン 48","duration":3.5,"slideTitle":"第48スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「汗ダラダラで顔も赤いですけど、大丈夫ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.048.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"FC6E7E6A-E75A-4ADF-A9DD-0E5E1B380060","title":"シーン 49","duration":5.6000000000000005,"slideTitle":"第49スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕は彼女にそう言われ、何かを言おうとするが、声が出なかった。「あはは…」そう言いながら、僕の視界は闇に染まった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.049.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"F54F2E51-7D12-40FB-9939-436C41504657","title":"シーン 50","duration":3.5,"slideTitle":"第50スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"サブ","telop":"私はふと目が覚めると、そこは学校の保健室だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.050.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png"},{"id":"03C1CECA-C62F-4BDD-A2BD-B87D1BF95110","title":"シーン 51","duration":3.5,"slideTitle":"第51スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"サブ","telop":"すると、私のそばにいたのか、\n彼女が困惑した表情でここを見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.051.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"31315AA2-A046-4553-80D2-C0D3CA497F78","title":"シーン 52","duration":3.5,"slideTitle":"第52スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"鈴仙・優曇華院・イナバ","telop":"「あの…確かこのベッドには男子がいたはずなのですが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"鈴仙・優曇華院・イナバ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.052.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"BEDE94E1-06BB-4B93-B806-2263EE1F8B7C","title":"シーン 53","duration":5.5,"slideTitle":"第53スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"サブ","telop":"「そういえば…この学校に来て、私が出るのは初めてか…。\nあなたが言っている彼は、確かにこのベッドにいましたよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.053.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"64B6048C-76DE-45F4-A553-7283566B754B","title":"シーン 54","duration":3.5,"slideTitle":"第54スライド","backgroundName":"リビング（日中）.jpg","characterName":"鈴仙・優曇華院・イナバ","telop":"「えっと…それはどういう意味でしょう？」","animationName":"なし","transitionName":"なし","voiceCharacter":"鈴仙・優曇華院・イナバ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.054.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"49DA242F-1171-4615-BA04-472B591CD818","title":"シーン 55","duration":5.2,"slideTitle":"第55スライド","backgroundName":"リビング（日中）.jpg","characterName":"サブ","telop":"「まぁ、もう一度寝たら、彼の姿に戻りはしますが、それよりも、授業の方が優先ですから、教室に戻りますね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.055.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"F3B87804-F90F-4AF6-8302-C3A6699D3B4E","title":"シーン 56","duration":3.5,"slideTitle":"第56スライド","backgroundName":"リビング（日中）.jpg","characterName":"鈴仙・優曇華院・イナバ","telop":"「とりあえず、あなたの教室に案内しますね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"鈴仙・優曇華院・イナバ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.056.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"95F3F713-C613-457E-BCF1-83BAB30F7D79","title":"シーン 57","duration":3.5,"slideTitle":"第57スライド","backgroundName":"リビング（日中）.jpg","characterName":"サブ","telop":"私はそう言われ、彼女と共に保健室を離れた。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.057.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/鈴仙（困る）.png"},{"id":"47C4D1E8-CBC8-4039-85F1-C27EB20741EE","title":"シーン 58","duration":5.1000000000000005,"slideTitle":"第58スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"私が、彼女の案内で教室に戻ると、クラスメイトの視線が突き刺さるように飛んでくる。「まぁ…当たり前か…」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.058.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"B4C89E80-54B0-42D9-A987-AB280987ED34","title":"シーン 59","duration":5.1000000000000005,"slideTitle":"第59スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「あなた…見かけない顔ね…新入生かしら…」私は科学の講義中に突如として入ってきた彼女にそう問いかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.059.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パチュリー真顔小口開け.png"},{"id":"9EF4645E-FAF9-4DDB-AC8F-638825A871DA","title":"シーン 60","duration":4.9,"slideTitle":"第60スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「まぁ、そんなことどうでもいいわ。とりあえず、あなたもささっと席に着いて、私の講義を聞きなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.060.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パチュリー真顔小口開け.png"},{"id":"302F6E91-8BCE-4B63-8718-CBC98DE82B51","title":"シーン 61","duration":3.5,"slideTitle":"第61スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"「わかりました。」\n私はそう返すと、窓際の真ん中にある空席に座る。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.061.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パチュリー真顔小口開け.png"},{"id":"EBD78736-39BD-4136-B087-4200314D71C7","title":"シーン 62","duration":3.5,"slideTitle":"第62スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「それじゃあ、続けるわね。」\n私はそう言って、科学の講義を再開した。","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.062.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パチュリー真顔小口開け.png"},{"id":"FBD07864-318D-4262-99E2-015458E432C2","title":"それから時間が経ち…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.063.jpeg","animationDuration":1.5},{"id":"45737D8B-E5F6-4B8A-B6F3-D8AF9A5FEAE2","title":"シーン 64","duration":5.1000000000000005,"slideTitle":"第64スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"それから数十分程度でその講義は終了した。そして、周りを見ながら、彼が持ってきた弁当を取り出し、食べる。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.064.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"260F8473-5EFA-4220-AE22-105173CFF962","title":"シーン 65","duration":5.1000000000000005,"slideTitle":"第65スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"だが、弁当を食べ切ると同時に、全身に衝撃が走り、そのまま教室を抜け出し、ある場所…多目的トイレを探す。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.065.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"74B8CAA6-3713-4C6B-B161-E79A7FBB171D","title":"シーン 66","duration":3.5,"slideTitle":"第66スライド","backgroundName":"ColabGPU_1791193839_80109.png","characterName":"サブ","telop":"そして私は、多目的トイレに来るとその場に倒れ込んだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.066.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791193839_80109.png"},{"id":"82A2C235-162A-4877-BF07-3F7950AA3442","title":"シーン 67","duration":5.5,"slideTitle":"第67スライド","backgroundName":"ColabGPU_1791193839_80109.png","characterName":"操夢","telop":"「ん…、ここは…トイレ…」僕はそう呟き、ハッと思い出す。\n「確か、10分の自己紹介で人生を話したら、気絶して…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.067.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791193839_80109.png"},{"id":"111BF626-B464-4EF4-A7C4-932BF8B59FD2","title":"シーン 68","duration":4.4,"slideTitle":"第68スライド","backgroundName":"ColabGPU_1791193839_80109.png","characterName":"操夢","telop":"「とりあえず…教室に戻るか…」\n僕はそう一人呟くと、念入りに手を洗ってから、トイレを出た。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.068.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791193839_80109.png"},{"id":"451B8833-D33A-487B-8D6C-6E78193C0B51","title":"シーン 69","duration":3.7,"slideTitle":"第69スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が教室に戻ってくると、\nさとりと呼ばれていた少女が僕に、駆け寄ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.069.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"F4FC0962-15A9-47C3-A0C6-322C240BEA7A","title":"シーン 70","duration":3.5,"slideTitle":"第70スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「あれ…どこから来たんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.070.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"7D00F50C-8BBC-4779-B051-D7A3D31BB909","title":"シーン 71","duration":4.2,"slideTitle":"第71スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「えっと…」僕はそこで困惑してしまう…。\n「今はちょっと、自分の席で休みたいので….」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.071.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"298C8720-138D-4A8C-B581-BD35C423738A","title":"シーン 72","duration":3.5,"slideTitle":"第72スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「そうですか…、でもきっと、学園中で噂になりますよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.072.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"B76E7707-2A37-44F9-AD67-31CA522FDCF8","title":"シーン 73","duration":5.7,"slideTitle":"第73スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「そういえば、次は被服室での授業ですが、一人で大丈夫ですか？あと、数十分もせずに休み時間は終わりますが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.073.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"413AA720-800C-408C-AA84-A6B9CFCFC138","title":"シーン 74","duration":4.1000000000000005,"slideTitle":"第74スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「そうですか…ちょっと待っててください。」\n僕はそういうと、ささっと自席を片付ける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.074.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"89FA2157-9E51-4AC0-A720-67617CF0A172","title":"シーン 75","duration":3.5,"slideTitle":"第75スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"「それで、被服室はどこにありますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.075.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"DCABCC6B-9010-44F5-977F-793B064509FC","title":"シーン 76","duration":3.5,"slideTitle":"第76スライド","backgroundName":"2026-10-04_16-42.png","characterName":"古明地さとり","telop":"「私が案内しますから、着いてきてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.076.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"950C903A-3D5F-4A22-9416-04573AF73AFB","title":"シーン 77","duration":3.5,"slideTitle":"第77スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"古明地さとり","telop":"僕が彼女と共に被服室にくると、誰かがこちらにくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.077.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png"},{"id":"0E92BF5B-214F-4250-B4C7-1EFD339BA2DA","title":"シーン 78","duration":3.5,"slideTitle":"第78スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「あら、もしかして、このクラスに転入した男子ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.078.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"00465C61-5B93-4B87-8F3D-3006E183D2B1","title":"シーン 79","duration":3.5,"slideTitle":"第79スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「ええ、そうですが、なぜそんなことを…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.079.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"4A16969A-F74E-4AD1-987E-D739AD5C830F","title":"シーン 80","duration":5.300000000000001,"slideTitle":"第80スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「朝、早苗さんが見たときは、確かに男子だったはずなのに、パチュリーさんの授業に来た時には女子だった…と。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.080.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"7F3B3CA6-33E4-4856-895F-E28BA3E9D204","title":"シーン 81","duration":5.300000000000001,"slideTitle":"第81スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「教員の間で、話題になってますよ。まぁ、元女子校の学園に男子生徒が来ただけでも、話題性は絶えないですが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.081.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"93C24954-0B27-457A-8E8A-BBA88D06D463","title":"シーン 82","duration":5.2,"slideTitle":"第82スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「とりあえず、これから家庭の授業をするので、あなたは…窓辺に座っているさとりの隣にでも座ってください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.082.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"49966960-75D6-4DA8-BD53-AE680293148E","title":"シーン 83","duration":5.800000000000001,"slideTitle":"第83スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"古明地さとり","telop":"「今日は、咲夜師匠の２連無休授業ですから、あなたには…酷かもしれませんが、2時間を休憩なしで耐えるしかないですね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.083.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"DA87CA87-4D6B-4008-878D-2D1F4800D83C","title":"シーン 84","duration":3.5,"slideTitle":"第84スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"彼女がそういい、数分程度で授業が始まった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.084.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"6BEB3F78-96F3-4C6E-90B2-D492F483409B","title":"2時間休憩なし授業が終わると…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.085.jpeg","animationDuration":1.5},{"id":"9266A54A-F3EB-4C01-9F7A-998BB926CEFE","title":"シーン 86","duration":5.7,"slideTitle":"第86スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕たちは、それから、2時間の間、休憩なしで、講義を受け続けると、教室に戻り、終礼が始まるまで席に座って待ち続ける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.086.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"EC57EB7E-759B-4684-9059-2EB10936D895","title":"シーン 87","duration":3.5,"slideTitle":"第87スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、教室の扉が開き、朝礼の時に来た女性が入る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.087.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"6E61D912-8724-444C-ADCB-8BFC94CE713B","title":"シーン 88","duration":3.5,"slideTitle":"第88スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「皆さん、お疲れ様です。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.088.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"A00B6B5E-C4AA-40C0-B27F-AA34D10E8016","title":"シーン 89","duration":5.300000000000001,"slideTitle":"第89スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"彼女がそういうと、クラスメイトの女子たちは「お疲れ様です。」と一斉に返し、僕が急いで立ち、一緒に礼をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.089.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"4BF142E0-5A0A-4D98-BD29-CDA0334915AD","title":"シーン 90","duration":3.5,"slideTitle":"第90スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「何か、伝えたいことがある生徒はいますか。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.090.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"946CEE5D-F772-4C5B-89CE-C01E6FE6FC33","title":"シーン 91","duration":3.5,"slideTitle":"第91スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"彼女がそういうと、シーンと教室が静まり返る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.091.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"8298A2FB-143D-41BD-8712-710C0D690ABD","title":"シーン 92","duration":3.5,"slideTitle":"第92スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「それでは、終礼はこれで終了です。お疲れ様でした。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.092.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"BC1E5DD2-A691-403F-8936-EC85B31B0E93","title":"シーン 93","duration":4.5,"slideTitle":"第93スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"僕は、周りの女子たちと共に立ち上がると、「お疲れ様でした。」と一斉に返し、お礼を済ませた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.093.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"C4F9B986-C129-4FDE-BC0F-FB7C8FF40710","title":"シーン 94","duration":4.2,"slideTitle":"第94スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女が教室からいなくなると、空気が少し和む。\nだが、そんなところにある女性が教室に入る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.094.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"C9166FC1-C05D-4779-8391-B4D63C34A575","title":"シーン 95","duration":3.5,"slideTitle":"第95スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、その女性は僕の席に来て、あることを言う。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.095.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"E90A86AB-918B-464D-B5E1-4D2C3D42A8F8","title":"シーン 96","duration":3.5,"slideTitle":"第96スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"「藤原くん、ちょっと来てくれるかい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.096.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"D167CAC4-A33A-46AC-9823-A8E4477755FA","title":"シーン 97","duration":4.4,"slideTitle":"第97スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、そう彼女に言われ、ささっと荷物を片すと、\n彼女が着いてきてと言うので、着いていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.097.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"F9D8B257-4748-41C1-8326-243F09F9AF20","title":"シーン 98","duration":3.5,"slideTitle":"第98スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"すると彼女は、校庭に出てくる。\n「あの僕は…何をこれからするんですか…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.098.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"6BBB611E-25D1-4731-A523-6E183CB50B03","title":"シーン 99","duration":3.5,"slideTitle":"第99スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「1500m走だよ。\n準備体操を済ませたら、私に声をかけなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.099.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"707F6DB0-2A33-4D6B-9C6B-CB08E211F0F9","title":"シーン 100","duration":5.5,"slideTitle":"第100スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「分かりました…」僕は、とりあえずそう返し、準備体操をする。\nそして、それが終わると、言われた通りに声をかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.100.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"D1AA09C3-4D15-4BED-B1A0-C97546ED6D54","title":"シーン 101","duration":3.5,"slideTitle":"第101スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「それじゃあ、今から時間測るから、走ってみなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.101.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"D7C84CB4-C5B2-4453-A0A3-2873BBB5A8BC","title":"シーン 102","duration":3.5,"slideTitle":"第102スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「はい…」僕はそう言うと、\n校庭に引かれた線に沿って、走り始める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.102.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"73A5D430-5396-4A84-9FFF-183617A43B02","title":"彼が1500m走を完走すると…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.103.jpeg","animationDuration":1.5},{"id":"D22ACB5E-8C7E-402B-B377-67E97BC6646E","title":"シーン 104","duration":5.5,"slideTitle":"第104スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「君、そこら辺の女子よりも、足が遅いんじゃないか？」\n私は、手元の腕時計を見ながら言う、あれから10分がたった。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.104.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"BEAE55B8-AC74-4373-AC3C-E5B94F38EE28","title":"シーン 105","duration":5.1000000000000005,"slideTitle":"第105スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「これだと、女子相手に情けない男になるぞ、どうだ、もう一走りして、今度は…8分目安にするのはどうだ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.105.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"70724283-E635-429E-B4A6-06E2ED3EDEEF","title":"シーン 106","duration":5.7,"slideTitle":"第106スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「じゃあ、もう一走りしますか…」僕は、彼女の理屈が通っているように感じ、何らかのプライドが刺激されたか、そう呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.106.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"52E9E4EC-5AEB-4DAC-9285-1CE9B659D199","title":"シーン 107","duration":3.5,"slideTitle":"第107スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「そうだ、その意気込みで、8分切れるように走ってみなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.107.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"99D042C4-24AB-491C-9884-EDC23052B0F7","title":"シーン 108","duration":3.5,"slideTitle":"第108スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は彼女にそう言われると、再び走り始める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.108.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"A769C196-B9F8-4D07-BA8C-E847B86ADC3C","title":"彼がもう一走りをすると…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.109.jpeg","animationDuration":1.5},{"id":"71B1A122-8282-41DA-AA56-D19075107BE0","title":"シーン 110","duration":4.2,"slideTitle":"第110スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「さっきよりは良くなったか…」\n私は、手元の腕時計を見る。あれから9分弱が経っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.110.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"66E9D12B-9141-4B87-8109-AAB0371876FF","title":"シーン 111","duration":5.7,"slideTitle":"第111スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「とりあえず、これで今日はおしまいにしよう、今度の体育では、同じトラックで女子と競争になるから、覚悟するのだぞ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.111.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"8283C218-F4EB-4C17-988B-6BC3EE714959","title":"シーン 112","duration":5.0,"slideTitle":"第112スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"彼女はそう言うと、そのまま何かを呟きながら、去っていった。\n僕は、その場でしゃがみ込んで、休みを取る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.112.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"56513285-B644-4D36-882E-DC0635344940","title":"シーン 113","duration":4.5,"slideTitle":"第113スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"すると、走ってた時には感じなかった痛みが僕を襲う。\nどうやら、無理強いをしていたようだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.113.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"F8358692-13DE-46C9-B83E-B7E8FAA27DC7","title":"シーン 114","duration":5.2,"slideTitle":"第114スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"だが、彼女の言葉は事実を述べているだけなので、何もいえず、ただ一人、校庭で俯きながら、考え込む僕だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.114.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"B71D32AF-A9B8-4A82-AF7E-2D96F4D7B1CA","title":"シーン 115","duration":4.0,"slideTitle":"第115スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"そして、立ちあがろうとしたその時、\n僕の全身がぐらつき、そのまま倒れ込むのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.115.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"27D9ED6F-6B51-44B1-B5BD-B2B619203441","title":"シーン 116","duration":3.5,"slideTitle":"第116スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"「んっ…ここは…」僕はふと目が覚めると、そう呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.116.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png"},{"id":"AE1EB5FC-C7DA-4338-BFA4-642ECDD2F988","title":"シーン 117","duration":3.5,"slideTitle":"第117スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"霧雨魔理沙","telop":"「おや、目が覚めたかい…、紅夢君…」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.117.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"2AA74FDF-239C-42BF-AEDE-85863303B0AA","title":"シーン 118","duration":3.5,"slideTitle":"第118スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"「あなたは…魔理沙さんですか…母の友達の…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.118.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"4FB16C80-F904-42DA-91C2-C5B83C8B7A58","title":"シーン 119","duration":3.5,"slideTitle":"第119スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"霧雨魔理沙","telop":"「ああ…そうだ…。それより…」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.119.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"AAF079E0-CFED-4D57-BE6F-DC89E5BE3736","title":"シーン 120","duration":3.5,"slideTitle":"第120スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"「何か、言いたいことでもあるのですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.120.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"B900F9BC-D927-40AF-B66E-4D9EC1CEE9D3","title":"シーン 121","duration":3.5,"slideTitle":"第121スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"霧雨魔理沙","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.121.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"A147231A-007B-4983-BAC2-CC4229773405","title":"シーン 122","duration":3.7,"slideTitle":"第122スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.122.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"E9C568F9-23CB-4C4E-B39B-332074A05C90","title":"シーン 123","duration":4.5,"slideTitle":"第123スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"霧雨魔理沙","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.123.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/箒あり困った笑み.png"},{"id":"976FF05E-E546-4D7F-8721-69AF5CF34538","title":"シーン 124","duration":3.7,"slideTitle":"第124スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.124.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png"},{"id":"94C4DBA8-1CAD-4AD8-B34A-316ED063F738","title":"シーン 125","duration":3.5,"slideTitle":"第125スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.125.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"D912931E-0F97-498E-9A96-1CDCD3E585B2","title":"シーン 126","duration":4.4,"slideTitle":"第126スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"博麗霊夢","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.126.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"0F5E5C76-6085-424E-9B33-D33C5404788C","title":"シーン 127","duration":4.2,"slideTitle":"第127スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.127.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"0CEDB767-C5CB-4FA3-907B-9F3723022458","title":"シーン 128","duration":3.5,"slideTitle":"第128スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"博麗霊夢","telop":"「それに…最近…魔理沙の様子が変なのよね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.128.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"F8F83A9A-61A3-4EDB-849E-A671EB203FCB","title":"シーン 129","duration":4.7,"slideTitle":"第129スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.129.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"8B508DCD-6443-4A59-99B3-ED61BCD23000","title":"シーン 130","duration":5.800000000000001,"slideTitle":"第130スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"博麗霊夢","telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.130.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"E18EB7EC-A95F-493C-823E-D03836CF3979","title":"シーン 131","duration":4.3,"slideTitle":"第131スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.131.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png"},{"id":"DCDD8570-D8F5-4E01-8156-DB7408A138B3","title":"シーン 132","duration":3.5,"slideTitle":"第132スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.132.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png"},{"id":"87A7992C-8F70-43B7-90FC-26B98AA4D02D","title":"附属病院のある診察室では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.133.jpeg","animationDuration":1.5},{"id":"ECE8BA31-62C6-4266-B1C0-72DE46695AD6","title":"シーン 134","duration":3.7,"slideTitle":"第134スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.134.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"28845B8B-3AF1-4794-B02D-31B2479BB0F7","title":"シーン 135","duration":5.800000000000001,"slideTitle":"第135スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.135.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"F814F84D-DF2B-485C-8E7C-14DD3C82598C","title":"シーン 136","duration":4.5,"slideTitle":"第136スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.136.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"A328477A-E83E-47AD-BF62-6632597C2424","title":"シーン 137","duration":6.0,"slideTitle":"第137スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.137.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"54790C82-A4F9-4FA0-B719-852B21261BDD","title":"シーン 138","duration":5.300000000000001,"slideTitle":"第138スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.138.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"E206EC8A-8BE4-4E2E-B47D-9CBF568DD8DD","title":"シーン 139","duration":4.3,"slideTitle":"第139スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.139.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"33CC720C-3694-4329-B716-BDCAF63D19C5","title":"シーン 140","duration":4.9,"slideTitle":"第140スライド","backgroundName":"単色背景","characterName":"射命丸文","telop":"「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.140.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"72DF6455-E8D2-4ED9-8C7C-17016DB7AB02","title":"シーン 141","duration":5.800000000000001,"slideTitle":"第141スライド","backgroundName":"単色背景","characterName":"射命丸文","telop":"「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.141.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"F280AB1E-4010-47BE-BA4F-03569C17B8BE","title":"シーン 142","duration":5.7,"slideTitle":"第142スライド","backgroundName":"単色背景","characterName":"射命丸文","telop":"「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.142.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"22F27A01-7890-4642-995C-67B6F37D667F","title":"シーン 143","duration":3.5,"slideTitle":"第143スライド","backgroundName":"単色背景","characterName":"射命丸文","telop":"「それと、息子さんの言ってたことは全て事実だそうですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.143.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"20068FA6-FFD4-4A29-B30F-2CD97B974942","title":"シーン 144","duration":4.800000000000001,"slideTitle":"第144スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"「ありがとう、文。それじゃあ…」私はそう言いながら、棚から札束入りの封筒を取り出し、彼女に渡す。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.144.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"0D847575-05FF-4834-A09F-6BB7BA15D302","title":"シーン 145","duration":3.5,"slideTitle":"第145スライド","backgroundName":"単色背景","characterName":"射命丸文","telop":"「代金、確かにいただきました。それでは、またのご利用を。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.145.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（余裕）.png"},{"id":"62B32715-CB53-415A-AF48-A6E5254BE113","title":"シーン 146","duration":4.7,"slideTitle":"第146スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"彼女はそういうと、診察室から出ていった。\n「もうすこし、早く気づいてあげればよかったのかしら…」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.146.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"76691760-96C6-479B-99F2-8F642317E4EE","title":"シーン 147","duration":5.0,"slideTitle":"第147スライド","backgroundName":"単色背景","characterName":"八意永琳","telop":"私はそう言いながら、息子が、しんどそうな、顔で私に、彼の診察を依頼してきた日のことを思い出していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.147.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"EE8D98A2-F733-430D-AAC3-86B7CED51A58","title":"彼に視点が戻り…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.148.jpeg","animationDuration":1.5},{"id":"8BF23A66-A2B2-4D13-9A3F-ABEFFAFE685D","title":"シーン 149","duration":5.9,"slideTitle":"第149スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"僕の心が声にもならず、自分自身で気づくこともできず、疲弊貯金が始まったのは、今考ると、最初の内部進学をしてからだった…","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.149.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"CE4C2153-0EE9-42F8-B0C3-33EF6DED4F88","title":"シーン 150","duration":5.300000000000001,"slideTitle":"第150スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"だんだんと、周りと自分との差が開き始め、友達もできなかった僕は、その空間で目立ち、教室の隅に染まっていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.150.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"81FA2145-28C3-45A6-B179-65DEE3EE79C0","title":"シーン 151","duration":5.5,"slideTitle":"第151スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"だが、小学生の頃は、勉強を常にしてれば、なんとなく開いた差が埋まるのか、勉強にどんどんと専念するようになった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.151.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"80877F1F-EF6D-47A1-A310-2EF9DB3CDCF8","title":"シーン 152","duration":5.6000000000000005,"slideTitle":"第152スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"一般的に、勉強を嫌う人もいるが、なんだかんだで大人たちは勉強を否定することはない。なぜなら、将来に関わるからだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.152.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"84CAD219-237F-49C8-A629-17C99DD39AA9","title":"シーン 153","duration":5.300000000000001,"slideTitle":"第153スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"だが、僕の場合は、その学校の空気を避けるための口実に、勉強をしていた。だが、それでも勉強の成果は出ていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.153.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"2695A5DB-121F-43C2-A137-9F603F8D3E37","title":"シーン 154","duration":5.0,"slideTitle":"第154スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"そして、時が進むにつれて、なんらかの負担が僕にのしかかり、根幹的な僕の何かが崩れるような感覚を感じた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.154.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"C542BAC3-125B-4129-A692-FE06885C4FF7","title":"シーン 155","duration":3.8000000000000003,"slideTitle":"第155スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"そのまま僕は、2回目の内部進学を済ませ、\nいざ中学生になると、状況は一変する。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.155.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"E46DCB9B-DCBD-438E-951D-9F875230C20A","title":"シーン 156","duration":5.6000000000000005,"slideTitle":"第156スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"そして”それ”は、僕に強い衝撃をもたらし、小学生の頃は時折、少し感じる程度だった、その変化が急速に進んでいった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.156.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"ECA5F9C1-94B7-44B1-A4A4-D222ED9AB02E","title":"シーン 157","duration":5.2,"slideTitle":"第157スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.157.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"27C7849E-9997-49EE-A2F6-C8D05F268EA4","title":"シーン 158","duration":3.5,"slideTitle":"第158スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"そう、それは…","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.158.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"916221C9-DC59-4B81-B88E-CC1A4CB74899","title":"シーン 159","duration":3.5,"slideTitle":"第159スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"博麗霊夢","telop":"「よかったわ、目が覚めたようで。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.159.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/涙目笑い.png"},{"id":"9C41E553-EE18-46E5-9EFD-189A44A82CAA","title":"シーン 160","duration":3.5,"slideTitle":"第160スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"博麗霊夢","telop":"「母さん…」\n僕は、そう彼女に返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.160.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/涙目笑い.png"},{"id":"5EBDE180-E3F3-4590-B6CA-C8EA8EE33964","title":"シーン 161","duration":4.4,"slideTitle":"第161スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"博麗霊夢","telop":"「あんたが、呻いてるから、私が何度も声かけたのよ…、\n私に心配かけさせないでちょうだい…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.161.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/涙目笑い.png"},{"id":"94911A43-7B5F-4556-8D2F-6F8537C66919","title":"シーン 162","duration":3.5,"slideTitle":"第162スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"「ご…ごめんなさい…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.162.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/涙目笑い.png"},{"id":"2DA427D8-506D-4276-ABC3-1F1351A6F5ED","title":"シーン 163","duration":4.2,"slideTitle":"第163スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"博麗霊夢","telop":"「いいわよ、謝らなくて、とりあえず、\n今晩はゆっくりと寝て、疲労回復に努めなさいね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartT