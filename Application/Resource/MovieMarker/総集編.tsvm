che/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（驚く）.png"},{"id":"32A7AE2F-2C9C-41C1-9E29-0C6255DF7922","title":"シーン 169","duration":3.5,"slideTitle":"第169スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"「そんなことどうだっていいわ、それより、夕飯は食べたの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.169.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（驚く）.png"},{"id":"6117156C-5430-4231-8D8B-A79963F32628","title":"シーン 170","duration":3.5,"slideTitle":"第170スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"「夕飯ならもう食べたぞ、湯船は冷めちまってるが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.170.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"CB576CD5-2135-47C1-BE9A-C340647331FB","title":"シーン 171","duration":4.5,"slideTitle":"第171スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"「そう、じゃあとりあえず、お風呂入ってくるわ…」\n私はそういうと、そのまま風呂に向かった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.171.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"15EFD779-4F30-4919-98F5-B229B33928FA","title":"霊夢がお風呂を澄ますと…","duration":3.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.172.jpeg"},{"id":"6479E576-DEC6-4603-AFC9-0D1C5EE118C6","title":"シーン 173","duration":5.1000000000000005,"slideTitle":"第173スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"私がお風呂から戻ってくると、彼はビール缶をあけ、ため息をついていた。「何か現場仕事に不満でもあるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.173.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅やれやれ.png"},{"id":"D7F78FAA-FEEC-49B7-9E69-D73C62706FFC","title":"シーン 174","duration":3.5,"slideTitle":"第174スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"「今日は、例の紅魔建設からの依頼だったんだけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.174.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅やれやれ.png"},{"id":"E3DC3C79-0148-4BCF-BB7B-9A6243C22D47","title":"シーン 175","duration":5.800000000000001,"slideTitle":"第175スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"彼はそういうと、その話を始める。特殊な力で一瞬で建造物を破壊できる女性がいる一族経営の館の解体工事中の出来事だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.175.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅やれやれ.png"},{"id":"E642DC5E-4006-4674-98B7-2816305EE5AB","title":"シーン 176","duration":4.800000000000001,"slideTitle":"第176スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.176.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅やれやれ.png"},{"id":"3947879A-56EB-4A7A-8EE0-2671454DE054","title":"シーン 177","duration":5.5,"slideTitle":"第177スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.177.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅やれやれ.png"},{"id":"7699202A-6C4A-4F21-86A5-7BA96620FD6B","title":"シーン 178","duration":5.2,"slideTitle":"第178スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.178.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅やれやれ.png"},{"id":"CB95BCA4-2B4B-4676-99E1-BF216EA57981","title":"シーン 179","duration":5.6000000000000005,"slideTitle":"第179スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"「だが、そんなことよりも、今日もこうして、霊夢のところに帰って来れて、俺は幸せ者だぜ。」私はそう笑みを浮かべる。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.179.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（笑い）.png"},{"id":"D5AC9941-7C99-4464-B579-C70A448EB5B7","title":"シーン 180","duration":5.300000000000001,"slideTitle":"第180スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"「そうね…」私は、夫のその発言こう返すことしかできなかった。そして、なんだか距離を感じてしまったのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.180.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（笑い）.png"},{"id":"F52FC789-63BF-4A66-94B8-2C992A1A044C","title":"シーン 181","duration":3.5,"slideTitle":"第181スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「ん…」僕はふと目が覚めると、\n朝日が登り、窓から日光が差し込んでいた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.181.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png"},{"id":"DC67122F-0D26-44A4-9599-1BB9FD124A9A","title":"シーン 182","duration":5.4,"slideTitle":"第182スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"そして、僕は大きく背伸びしてあくびをすると、誰かが部屋の戸を叩く。「入ってきて大丈夫ですよ。」僕はそう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.182.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png"},{"id":"F3E7F8CC-0435-4106-9253-35F32AFD9CA7","title":"シーン 183","duration":3.5,"slideTitle":"第183スライド","backgroundName":"nc256896_病室-昼.png","characterName":"因幡てゐ","telop":"「今朝は、よく眠れましたか、紅夢さん。？」\n画像出典\nニコニコモンズ\nみんちりえ\nAppleCreatorStudio","animationName":"なし","transitionName":"なし","voiceCharacter":"因幡てゐ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.183.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/てゐ（微笑）.png"},{"id":"D5D060CE-6CCF-4992-9B97-01083A2073CF","title":"シーン 184","duration":3.5,"slideTitle":"第184スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「はい。それで、これから検査…ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.184.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/てゐ（微笑）.png"},{"id":"2D942CB8-A15F-4946-851F-46B0984086A9","title":"シーン 185","duration":3.5,"slideTitle":"第185スライド","backgroundName":"nc256896_病室-昼.png","characterName":"因幡てゐ","telop":"「ええ、それでは、検査室に案内しますね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"因幡てゐ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.185.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/てゐ（微笑）.png"},{"id":"43B16A27-A5EA-4E76-961B-5D62A1C9FF20","title":"シーン 186","duration":3.7,"slideTitle":"第186スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「わかりました。」\n僕はそういうと、ベッドからおり、検査室に向かっていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.186.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/てゐ（微笑）.png"},{"id":"0E26A345-2066-4304-BBFE-AA092E2A90A8","title":"シーン 187","duration":3.5,"slideTitle":"第187スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、それから検査を終えると、\nお昼休憩のタイミングで教室に入る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.187.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"BFF3DED5-D6C4-48B7-92BE-B35D977E1B32","title":"シーン 188","duration":4.3,"slideTitle":"第188スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「なぜ、お昼時になってあなたが来るのですか…？」\n私は、彼が来たことに驚き、そう聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.188.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"D2D8DFA5-DF44-4FC1-B0E9-5FD56FED0EEF","title":"シーン 189","duration":5.1000000000000005,"slideTitle":"第189スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「昨日、校庭で3000m走ったら、バタって倒れて、さっきまで…」僕がそう言っていると、突如放送が入る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.189.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"5351E90B-CB46-476E-BC5F-A29A3A78658E","title":"シーン 190","duration":5.1000000000000005,"slideTitle":"第190スライド","backgroundName":"ペーストされた画像.tiff","characterName":"萃香","telop":"「全校生徒及び児童に次ぐ、本日、５限から７限までは、\nグラウンドで全クラス合同のエンドレスランを行う…」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.190.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（驚く）.png"},{"id":"CE765B0E-126B-426C-B1BB-147515453A67","title":"シーン 191","duration":5.0,"slideTitle":"第191スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「どうやら、あまり話している余裕はなさそうですね…、ささっと昼食とって校庭に出たほうがいいですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.191.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（困る）.png"},{"id":"065C6652-9FC0-4A78-AF31-542770D5CB7A","title":"シーン 192","duration":5.2,"slideTitle":"第192スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女がそう呟き、数分で放送は終わり、周りが、急ぎ始める。\n僕は、そこで、今日のお弁当がないことを思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.192.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（困る）.png"},{"id":"D6A35B3D-BB75-4E58-9F5D-59F5F42CAE34","title":"シーン 193","duration":5.0,"slideTitle":"第193スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそこで、彼女に学食はあるか聞こうとしたが、すでにそこにはいなかった。僕は仕方がなく、教室を出る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.193.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"FAAB1C3E-2486-4CDE-A299-EAFD9E461AA1","title":"シーン 194","duration":5.0,"slideTitle":"第194スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"そして、校庭に来ると、大勢の女子たちが、グラウンドで動き回っていた。すると、ある女子と体がぶつかる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.194.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"E3BE2E0C-9C70-495F-8F38-5C609866B650","title":"シーン 195","duration":3.5,"slideTitle":"第195スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"古明地こいし","telop":"「あの、大丈夫ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.195.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"5FB29D77-96E0-42AE-A01C-735E5569F597","title":"シーン 196","duration":3.5,"slideTitle":"第196スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「大丈夫ですけど…あなたは…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.196.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"B7F0ECCA-A77D-4C7B-BB06-14B494202A05","title":"シーン 197","duration":3.5,"slideTitle":"第197スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"古明地こいし","telop":"「私は、Kー3組の古明地こいしです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.197.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"5F693D0D-E335-439C-88F6-33D5FF937508","title":"シーン 198","duration":4.0,"slideTitle":"第198スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「えっと僕は…藤原紅夢です…」\n僕がそう言っていると、どこからか声がする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.198.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"2F8114B4-31A8-4650-9C24-04E360D4C948","title":"シーン 199","duration":5.0,"slideTitle":"第199スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「ほら、そこの二人、ささっと準備体操済ませて、スタートラインに立ちなさい。もうすぐ始まりますから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.199.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（怒る）.png"},{"id":"3E71E1A2-BD60-41A6-96E3-8FB218BB317A","title":"シーン 200","duration":4.1000000000000005,"slideTitle":"第200スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕とこいしは、彼女にそう言われ、\n準備体操をすると、スタートラインに向かうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.200.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"969B7CB4-DF65-420A-8E1D-564AF86706E3","title":"二人がスタートラインに立つと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.201.jpeg","animationDuration":1.5},{"id":"D71CE86C-CD1C-45FB-AEE9-8B924D5A3CD4","title":"シーン 202","duration":5.300000000000001,"slideTitle":"第202スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"それから、僕たちがスタートラインに立ってしばらくすると、さっきの放送で話していた人物から、内容が話された。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.202.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"FCF8A1AE-AC5C-46A3-903D-31600298C87E","title":"シーン 203","duration":5.2,"slideTitle":"第203スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"エンドレスランのルールは一言で言えば、その場に倒れるまで走り続ける、または歩き続ける無限長距離走らしい。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.203.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"AD5977EA-32F3-40E9-B0B1-8452039D1F35","title":"シーン 204","duration":4.9,"slideTitle":"第204スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は、病み上がりの体に負担がかからないか心配だった。\nすると、昨日僕が倒れるまで走らせた彼女が来る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.204.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"C817185D-D105-4E17-9C17-1CDBC59387C9","title":"シーン 205","duration":5.7,"slideTitle":"第205スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「藤原さんは初めてのエンドレスランで、こいしさんと同等程度の体力ですから、二人のペースを合わせて走りましょうか。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.205.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"89FC8F80-B3B2-4E1E-97C6-8B28163DABF6","title":"シーン 206","duration":5.2,"slideTitle":"第206スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「お二人さんのペースは、きっと最後尾になりますから、私がお二人さんの後ろを走る形でサポートしましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.206.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（微笑）.png"},{"id":"ABECDC1B-8098-46A1-B73B-3B36BB2B8C10","title":"シーン 207","duration":5.7,"slideTitle":"第207スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「ですが、だからと言って気を抜いたり、だらけたら体を叩きますから、走る力が尽きても、歩いて前に進んでくださいね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.207.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（怒る）.png"},{"id":"FA5E526E-E6C2-44B1-980D-814C31C34DBE","title":"シーン 208","duration":3.7,"slideTitle":"第208スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕はふと、彼女にそう言われ、こいしの方を見る。\n彼女は苦笑いを浮かべていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.208.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"92C43ACD-5B4E-4126-A508-60AD30888E86","title":"シーン 209","duration":5.800000000000001,"slideTitle":"第209スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"だが、僕たちを置き去りにするように、開始の合図である笛が鳴り響くと、ゾロゾロと女子の大群が動き、僕たちも動き始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.209.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"C4C6CAE1-6BDA-477E-B5BE-D799205D44E1","title":"シーン 210","duration":5.2,"slideTitle":"第210スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、僕たちが走り始めて、数分経つと、ぞろぞろと、前方の大群が校門を抜けて、複数の方向に分散していく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.210.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"05760A91-7892-483B-A868-5CF7F883937E","title":"シーン 211","duration":3.5,"slideTitle":"第211スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"「校門をでたら、右に曲がって、進んでください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.211.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"2C1F14B2-E67F-4495-BE11-737EBB9C70E8","title":"シーン 212","duration":5.9,"slideTitle":"第212スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"僕たちは、それから、1kmくらい走ると、住宅街に入り、その中を進んでいた。だが、こいしと僕は走り続けるのに限界が来る…","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.212.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg"},{"id":"5F752C23-5992-4331-9A91-0486641392E8","title":"シーン 213","duration":5.5,"slideTitle":"第213スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"僕がふと、隣を見ると、汗ばむ彼女の姿があった。ふと足を見ると、彼女も走り続けるのには限界が来ているようだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.213.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/toho_ref_20261008_194930_440.png"},{"id":"DA033EA9-9F1C-4BD1-AC29-CCF6273E5817","title":"シーン 214","duration":5.800000000000001,"slideTitle":"第214スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"美鈴","telop":"「走り続けるのが厳しいなら、歩いても構いませんから、止まってないで前にすすまないと、学校に戻るときには夜中ですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.214.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/目閉じ困る.png"},{"id":"B4862D32-7368-4946-9993-AA01B91FBD5F","title":"シーン 215","duration":5.1000000000000005,"slideTitle":"第215スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"美鈴","telop":"私がそういうと、二人は走るのを諦め、歩き始める。\n「また、走れるようになったら走ってもらいますからね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.215.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"60E7D3A2-C07C-42D2-9C50-ED785086321B","title":"シーン 216","duration":3.8000000000000003,"slideTitle":"第216スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"「わかってますよ…それくらい…」\n僕はそう言いながら、再び、こいしの方を見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.216.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"92074A40-85C5-4239-BF45-D8B7504E9CC5","title":"シーン 217","duration":5.5,"slideTitle":"第217スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"彼女は、細かく息を吐きながら、歩き続ける。僕は、ふと僕の歩くペースと彼女のペースのずれに気づき、少し遅く歩く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.217.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/息を吐くこいし.png"},{"id":"D68A9F2E-2DF1-4F7A-BF06-2D79C0D3EE86","title":"シーン 218","duration":5.1000000000000005,"slideTitle":"第218スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"僕も、彼女と同様に息を細かく吐いていたことに気づき、深く息をすると、早歩き寄りの速度で再び走り始める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.218.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/息を吐くこいし.png"},{"id":"32D3792D-6034-4517-AC57-446987F9A0A6","title":"シーン 219","duration":5.1000000000000005,"slideTitle":"第219スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"古明地こいし","telop":"私は、いきなり走り始めた彼に、待ってと言い、そのまま手を出す。すると、次の瞬間、彼と私の手が触れ合う。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.219.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（驚く）.png"},{"id":"778E7991-07E5-44C6-B68E-AD470CE55B2E","title":"シーン 220","duration":5.4,"slideTitle":"第220スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"僕はふと、手に何かが当たり、ふと視線をこいしに移すと、彼女が頰てっていた。「どうしたんですか、こいしさん？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.220.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（驚く）.png"},{"id":"A468CCEB-11BB-4602-9DA2-350BEBB1442F","title":"シーン 221","duration":4.800000000000001,"slideTitle":"第221スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"古明地こいし","telop":"「いえ、なんでもありません、とりあえず、走りましょう。」\n私は、緊張して、そう口走り、走り始める。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.221.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り目閉じこいし.png"},{"id":"39363302-3465-4A06-817E-70F7EF143D52","title":"シーン 222","duration":5.7,"slideTitle":"第222スライド","backgroundName":"nc367698_住宅街２（日中）.jpg","characterName":"操夢","telop":"「そうですか。」僕はそう返し、呼吸を整えながら、ペースを彼女に合わせてあげていく。するとペースが少し上がっていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.222.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc367698_住宅街２（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り目閉じこいし.png"},{"id":"58D30690-3B14-4EDA-81EE-3D42C980AEBE","title":"シーン 223","duration":4.5,"slideTitle":"第223スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"操夢","telop":"僕たちはそれから、さらに1kmほど走ると、息が再び荒くなり、走りから歩きに変わってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.223.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り目閉じこいし.png"},{"id":"C5DA06C0-752C-465C-8148-13041EAC2AB1","title":"シーン 224","duration":5.2,"slideTitle":"第224スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"美鈴","telop":"私は、二人のペースがあまりにも遅いので、本当にこのペースで学校に戻れるのだろうかと、不安を感じてしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.224.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"6C619857-6780-4542-B48A-CCFC85DBDAAA","title":"シーン 225","duration":4.5,"slideTitle":"第225スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"古明地こいし","telop":"私は、息をぜぇぜぇ吐きながら、歩いていると、足元にあるに何かにつまづいてしまう。「あっ！」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.225.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg"},{"id":"4590C308-2632-4345-9D3D-7027B94B3087","title":"シーン 226","duration":5.800000000000001,"slideTitle":"第226スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"操夢","telop":"僕は、彼女が地面に倒れ込みかけると、腕をだし、彼女を抱え込む。すると、彼女が驚き、僕も恥ずかしくなり、頬照っていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.226.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（驚く）.png"},{"id":"B9F1CC2A-5BA1-4AA0-9EEF-5FBC84D20913","title":"シーン 227","duration":4.5,"slideTitle":"第227スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"操夢","telop":"僕は、こいしをお姫様抱っこしたまま、後ろにいる彼女に目線を送る。「どうすればいいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.227.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（驚く）.png"},{"id":"B22381DA-BB7D-4340-9150-CCFA99C1E9F7","title":"シーン 228","duration":5.4,"slideTitle":"第228スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"美鈴","telop":"「もし、あなたが彼女を抱いたまま、前に進めば、特別に、二人とも完走したことにしましょう、それでいいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.228.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/目閉じ困る.png"},{"id":"AD1278BD-546B-4927-9831-E1353154E6E7","title":"シーン 229","duration":5.7,"slideTitle":"第229スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"美鈴","telop":"私がそう、彼に抱き抱えられている彼女に視線を送る。すると、彼女は、目を閉じ、微かに頷いた。「早く進んでください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.229.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"375C8D5B-9DBD-4C06-81C9-162702EE015F","title":"シーン 230","duration":4.9,"slideTitle":"第230スライド","backgroundName":"nc240173_住宅街（日中）.jpg","characterName":"操夢","telop":"僕に抱っこされたこいしを見ると、恥ずかしいそうに身を丸くしていた。僕は、前を向き、再び走り始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.230.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc240173_住宅街（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恥ずかしい顔こいし.png"},{"id":"206F82C1-A043-4972-9BB3-A2F8295F03C7","title":"そして、時間が過ぎていき…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.231.jpeg","animationDuration":1.5},{"id":"209FF8F0-CAE1-4940-89F3-9877E5903881","title":"シーン 232","duration":5.6000000000000005,"slideTitle":"第232スライド","backgroundName":"2026-10-08_20-48.png","characterName":"操夢","telop":"僕はふと目が覚めると、そこは学校の保健室だった。僕は、ゆっくりとベッドから降りると、隣に人が寝てることに気づく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.232.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-08_20-48.png"},{"id":"F3FB22F3-6BCF-4767-8540-333F497220E5","title":"シーン 233","duration":4.7,"slideTitle":"第233スライド","backgroundName":"2026-10-08_20-48.png","characterName":"操夢","telop":"彼女は、恥ずかしいそうな表情の状態で寝ていた。\n僕は、彼女を起こさないようにそっと保健室を出る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.233.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-08_20-48.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恥ずかしい顔こいし.png"},{"id":"1D92C93A-49CD-4215-B659-6445F636AF27","title":"シーン 234","duration":4.2,"slideTitle":"第234スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"そして、廊下に出ると、ふとお腹が空き、何かご飯はないかを考えながら、歩を進めていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.234.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg"},{"id":"54BE6CD4-D765-427C-B8E4-A4AB1F4C96BD","title":"シーン 235","duration":3.5,"slideTitle":"第235スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"すると、ふと誰かが向こうからやってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.235.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg"},{"id":"349FEDFE-576E-4674-9100-F9F1CB9D3887","title":"シーン 236","duration":3.5,"slideTitle":"第236スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"フランドール・スカーレット","telop":"「こんばんは。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.236.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"A8645C64-A272-4348-A28A-FC31B5848143","title":"シーン 237","duration":5.4,"slideTitle":"第237スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"「こんばんは…、あなたは…誰ですか…こんな夜中に、学校の式内を歩ける人なんてごくわずかのはずなんですけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.237.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"39B5CA92-F9A8-4222-BEB4-1B6239D8886E","title":"シーン 238","duration":3.5,"slideTitle":"第238スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"フランドール・スカーレット","telop":"「私が、なんで夜中にこんな場所にいるか、知りたいの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.238.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"635DAEF2-FB8A-442A-9A79-4213CB8429E2","title":"シーン 239","duration":3.5,"slideTitle":"第239スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"「知りたいというよりかは…大丈夫なのかな…って。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.239.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"7D147466-FD7B-472C-A1B5-4FCB1C8E9629","title":"シーン 240","duration":3.5,"slideTitle":"第240スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"フランドール・スカーレット","telop":"「それなら、教えてあげる。実はね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.240.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"BFDFF076-ED76-475B-95B5-F43DECF238A4","title":"シーン 241","duration":4.0,"slideTitle":"第241スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"彼女はそういうと、僕にあることを耳打ちする。\n僕はその事実に衝撃を受けるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.241.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"CEFB03DC-C9F9-4C75-8980-C36D10513619","title":"シーン 242","duration":3.5,"slideTitle":"第242スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"フランドール・スカーレット","telop":"「それじゃあ、あなたの血、ちょうだい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.242.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"6F52D2E3-CEE9-4F8D-8EB9-70CA5243368E","title":"シーン 243","duration":3.5,"slideTitle":"第243スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"「えっ…、別にいいですけど…」\n僕はなぜか、そう答えてしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.243.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"ACE530F5-A51B-47D3-87FB-C0965E153386","title":"シーン 244","duration":3.5,"slideTitle":"第244スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"フランドール・スカーレット","telop":"「それじゃあ、いただっきまーす！」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.244.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"B020437C-E6DA-444F-9E02-B9AB836E383B","title":"シーン 245","duration":3.5,"slideTitle":"第245スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"操夢","telop":"彼女はそういうと、僕に噛みつき、血を吸い取っていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.245.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg"},{"id":"D276EE77-ABDA-4C80-8067-A01170B92AB6","title":"シーン 246","duration":4.9,"slideTitle":"第246スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"フランドール・スカーレット","telop":"私は、彼の血を吸い始めると、今までになかった独特な感覚に襲われていき、何かが変わっていく気がする。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.246.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"5160A5AA-009C-4764-974F-B3D7838BD90C","title":"シーン 247","duration":4.5,"slideTitle":"第247スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"私は、彼女が豹変していくのがわかると、\nその間の隙をつき、彼女の首に、腕を勢いよくぶつける。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.247.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"ADD5656B-2C00-4F3A-B43E-C653555FD030","title":"シーン 248","duration":4.0,"slideTitle":"第248スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「私の妹が、あなたにご迷惑かけたようで申し訳ありません。」\n私は、そう彼女に返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.248.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア（弱る）.png"},{"id":"4AB70208-46E8-45B3-9DDF-FF3F06A12124","title":"シーン 249","duration":5.800000000000001,"slideTitle":"第249スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"「いえいえ、迷惑ではありませんよ、彼女が暴走する前に、食い止めることができましたから。それで、あなたたちの名前は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.249.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア（弱る）.png"},{"id":"D067E91B-FFBA-45B0-AE9B-74B12D61A06C","title":"シーン 250","duration":4.6000000000000005,"slideTitle":"第250スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「私の名前は、レミリア・スカーレット、その妹の名前はフランドール・スカーレットと言います。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.250.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"444005C8-C09D-41F6-B6A5-B9EAA79B3395","title":"シーン 251","duration":5.1000000000000005,"slideTitle":"第251スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「ご存知かもしれませんが、彼女は建物を一言で破壊できる才の持ち主で、私たちは紅魔建設を営んでいます。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.251.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"F8A10CF6-0495-4BA3-BA79-9C214F562EE0","title":"シーン 252","duration":3.5,"slideTitle":"第252スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「ただし…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.252.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"C7AD6000-B795-411C-86B0-772DCBBC6758","title":"シーン 253","duration":4.9,"slideTitle":"第253スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"「お二人さんは吸血鬼で、時折妹さんが暴走するっという感じですか。それで、この学園の卒業生ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.253.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"1C1D3652-A780-4E22-AF9A-81F7357B0E5C","title":"シーン 254","duration":4.6000000000000005,"slideTitle":"第254スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「ええ、よくご存知で。あなたのいうとおり私たちは、吸血鬼で、その詳細は公ではありませんの。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.254.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"F94DF26B-79DC-45C1-BD79-826CB960F233","title":"シーン 255","duration":3.5,"slideTitle":"第255スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「それで…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.255.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"D52FCA1F-75C6-41B5-84CF-9A8F97603C67","title":"シーン 256","duration":3.5,"slideTitle":"第256スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"「秘密保持契約で、口外は厳禁って言ったところですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.256.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"376A93F7-1464-44AD-96C4-6255C1B7135D","title":"シーン 257","duration":5.1000000000000005,"slideTitle":"第257スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「ええ、今この場で、口頭による契約成立とみなしていただき、今後、この事実が口外控えていただけますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.257.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"CEA102A9-E7C4-45C0-9D53-597D06B8877C","title":"シーン 258","duration":5.7,"slideTitle":"第258スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"「承知しました、それで、この学園に来たのは、単純な深夜徘徊ではありませんよね。妹さんが入口を破壊してるだろうし…」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.258.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"1DC3F268-7733-4AA8-AE0D-6EA1D9F4B931","title":"シーン 259","duration":5.4,"slideTitle":"第259スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「ええ、これから、私は、妹が破壊した入口を修復するための手筈を取る予定です。それで、あなたはどうしますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.259.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"576CCFC0-D53C-4D7C-94FD-7B82404DDFEF","title":"シーン 260","duration":5.2,"slideTitle":"第260スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"「そのついでに、食事の用意もできないでしょうか、私、今日、\nいや昨日のお昼から、何も食べてないんです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.260.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"C31DD708-33C3-4114-B9F6-09D0F8E13E01","title":"シーン 261","duration":5.300000000000001,"slideTitle":"第261スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"レミリア・スカーレット","telop":"「分かりました、それくらいはお安いご用です。では、私と一緒に、その妹を抱えてきていただけますでしょうか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.261.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"53D21802-82CB-428D-BEFB-9D6AB7D9EF79","title":"シーン 262","duration":3.8000000000000003,"slideTitle":"第262スライド","backgroundName":"nc485835_学校の廊下（夜・照明OFF）.jpg","characterName":"サブ","telop":"「ええ分かりました。」\n私はそういうと、フランを抱え、レミリアについていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.262.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485835_学校の廊下（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"5F1529E1-EB6A-412F-81B2-FE3B8264FDA0","title":"シーン 263","duration":3.5,"slideTitle":"第263スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"僕は、ふと目が覚めると、そこは学校の保健室だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.263.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png"},{"id":"62D61D02-C5E1-423E-B798-05178147B4EB","title":"シーン 264","duration":3.5,"slideTitle":"第264スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"ふと隣を見ると彼女がすやすやと気持ちよさそうに眠っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.264.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝顔.png"},{"id":"79F8C698-A6CA-4EC6-B3FD-F6D6912DC848","title":"シーン 265","duration":3.5,"slideTitle":"第265スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"僕は、彼女を起こさないように、そっとベッドから降りる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.265.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝顔.png"},{"id":"EDA67F03-D8D8-48B6-AE65-FBEDA99D849C","title":"シーン 266","duration":3.5,"slideTitle":"第266スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"古明地こいし","telop":"「んっ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.266.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし寝起き顔.png"},{"id":"25F30434-4EE6-49D9-BB7F-DF8C976FF395","title":"シーン 267","duration":3.7,"slideTitle":"第267スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"古明地こいし","telop":"「ここは…、どこ…、あなたは…だれ…?」\n私は、そう私を見てくる彼に尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.267.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし寝ぼけ眼.png"},{"id":"C80943C2-C24E-4CFB-9C63-44AED712CC25","title":"シーン 268","duration":5.7,"slideTitle":"第268スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"「ここは、学校の保健室で、僕が覚えているのは、こいしさんとエンドレスランをしていて、途中で倒れる直前まで…です。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.268.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし寝ぼけ眼.png"},{"id":"EB156986-C4AE-4374-B661-D6BD1BE808CD","title":"シーン 269","duration":5.7,"slideTitle":"第269スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"古明地こいし","telop":"「えっと…あなたは、エンドラスランの途中で私を、お姫様抱っこした、紅夢さんですか？」私は、目覚めた頭でそう問う。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.269.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/照れ小口開け.png"},{"id":"55F25C13-23F1-44DD-A25D-E38D1B82C010","title":"シーン 270","duration":5.1000000000000005,"slideTitle":"第270スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"「それで…合ってます…」僕がそう言うと、なんとも言えない空気感が、保健室を包み込む。すると、扉が開く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.270.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/照れ小口開け.png"},{"id":"E37A6F7E-6259-49F0-9B3F-8F2C3E22B002","title":"シーン 271","duration":5.6000000000000005,"slideTitle":"第271スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"萃香","telop":"「あんたたち、昨日のエンドレスランで、過去最低の記録を生み出したそうじゃないか…、その話、詳しく聞かせなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.271.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"CF7AB37E-2DA4-4D47-A2B9-C198C6C0775A","title":"シーン 272","duration":5.5,"slideTitle":"第272スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"「えっと…」僕は、その強面の彼女に、怖気付いてしまう。\nだが、勇気を出して言う、「それは…どう言う意味ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.272.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"53B8F3FC-84DB-40AD-BF73-1D627A1E22A2","title":"シーン 273","duration":6.0,"slideTitle":"第273スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"萃香","telop":"「美鈴から、聞いた話だと、途中からそこの彼女を、抱っこして走ったそうじゃないか？私だったら、そうはさせなかったぞ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.273.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"DF2F8F03-BC49-4994-BF6A-3E73AAEBE976","title":"シーン 274","duration":3.7,"slideTitle":"第274スライド","backgroundName":"ColabGPU_1791188423_26966.png","characterName":"操夢","telop":"僕たちはそれから、その女性の説教を、\nチャイムがなるまで聞かされるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.274.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791188423_26966.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"E723EFFD-0C3A-4E3B-BD25-6CD0B036527B","title":"シーン 275","duration":4.9,"slideTitle":"第275スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、彼女の説教を聞き終えてから、教室に来ると、\nすでに1時間目が始まるまであと1分だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.275.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"1B3A714D-A317-4220-8FA8-47D8A44514C0","title":"シーン 276","duration":5.4,"slideTitle":"第276スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、机に来ると、教科書の束が置いてあった。そして、付箋が机に貼られていて、今日の1時間目は現代文だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.276.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"3A4F4F5C-7C93-44DA-BBC3-930B3A2D09EC","title":"シーン 277","duration":3.5,"slideTitle":"第277スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから、僕の元女子校生活３日目が始まった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.277.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"6AE2FB72-F274-4834-B251-988AD47A6608","title":"それから時間が進み…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.278.jpeg","animationDuration":1.5},{"id":"BA241D1B-AC6C-41A5-A05D-8C8FF2AE5C91","title":"シーン 279","duration":3.5,"slideTitle":"第279スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、午前中の授業を終えると、\nふと、昼食がないことを思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.279.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"1B1A98B1-A238-4811-B661-9A6F80A80921","title":"シーン 280","duration":3.5,"slideTitle":"第280スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そこで、ふとさとりの姿を探す。\nだが、彼女は教室にはいなかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.280.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"752D3E90-CAE2-482B-B06A-1E477642BE45","title":"シーン 281","duration":3.6,"slideTitle":"第281スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"仕方なく、僕は廊下に出て歩いていると、\nふと向こうから、誰かがやってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.281.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"468D4CC5-0A6F-4850-9BB0-1DAAABFE9871","title":"シーン 282","duration":5.4,"slideTitle":"第282スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「おや、藤原さんですか、ちょうどよかった。あなた宛の荷物が来てたので、ちょうど渡そうとしてたところですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.282.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"10E0D429-6E37-4C0D-9455-C67A1A8FDF1C","title":"シーン 283","duration":4.2,"slideTitle":"第283スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「これ、魔理沙と名乗る女性から、預かった荷物です。」\n私はそう言うと、彼にそれを渡す。","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.283.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"1B1EDF22-7C84-415C-9989-BD179965606C","title":"シーン 284","duration":4.5,"slideTitle":"第284スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「では、私は、この後用があるので、ここで失礼します。」\n私はそう言うと、そのまま歩き出した。","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.284.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"F0142C32-5101-48F9-A2AD-B99E4EA096E0","title":"シーン 285","duration":5.5,"slideTitle":"第285スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、彼女に渡された荷物を持って、自席に戻ると、荷物を包んでいた風呂敷を時中を見ると、小瓶と弁当と紙があった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.285.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"4825CADA-0B2A-46A3-89C8-399CCB1E693A","title":"シーン 286","duration":5.4,"slideTitle":"第286スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、その紙を見る。そこには、寄り道がてら、母から僕の弁当を受け取って、事務室に届けたことともう一つあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.286.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"3EF37A45-01A9-4591-AA79-9F1B902D13F7","title":"シーン 287","duration":5.4,"slideTitle":"第287スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それは、この小瓶には試験薬が入っていて、それを飲めば、きっと僕の役に立つから飲んでみなさいと言う文章だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.287.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"068C4265-AF21-4404-9813-7C5DB4B19454","title":"シーン 288","duration":4.800000000000001,"slideTitle":"第288スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、その小瓶を手に取り眺める。そこには水に近い色合いの液体と、牛乳の色をした液体が入っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.288.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"46550C0C-9510-4952-BA86-7F2FC4B548A1","title":"シーン 289","duration":5.6000000000000005,"slideTitle":"第289スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はとりあえず、割れないように小瓶をどかすと、弁当を食べる。\nそして、弁当を数十分で食べ切ると、再び瓶を手に取る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.289.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"883EA35C-50F2-4961-BCC3-F6353240F3F8","title":"シーン 290","duration":3.9000000000000004,"slideTitle":"第290スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、その瓶をぼーっと眺めていると、\n誰かが教室に入り、僕の席に駆け寄ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.290.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"0DFEB9AB-55A3-40CD-B468-EAC64BC737A8","title":"シーン 291","duration":4.0,"slideTitle":"第291スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「あんた、これ、どこで手に入れたの？」\n私は、彼からその瓶を取り上げ、そう尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.291.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"7CAD845B-45EF-43AE-BF11-23517DE95603","title":"シーン 292","duration":3.5,"slideTitle":"第292スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…母の知人からです…」\n僕は、ビクビクしながらそう答える。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.292.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"7C292B88-48CB-4699-ABCF-CBA43E9878C7","title":"シーン 293","duration":3.5,"slideTitle":"第293スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「その知人の名前は？」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.293.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"0D46F94A-CDA7-4962-9864-04A4D043E647","title":"シーン 294","duration":3.5,"slideTitle":"第294スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「魔理沙…霧雨魔理沙さんです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.294.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"F69F9081-F1D2-47B7-8CB6-3C4EB9AE2B84","title":"シーン 295","duration":5.800000000000001,"slideTitle":"第295スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「いいわね、これはまだ、世に出てない代物なの。ここの大学院の薬を扱う学科で研究中の実験薬なの。あんた、分かってる？」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.295.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"ABE9C001-0F06-49F8-912F-11EAB5CFCF83","title":"シーン 296","duration":3.5,"slideTitle":"第296スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…、何を言いたんですか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.296.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"D9B19657-30A4-4770-B5E6-8172A672A390","title":"シーン 297","duration":5.6000000000000005,"slideTitle":"第297スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「これは、実験薬。服用した結果、どのような症状が出るかもわからない。そんなリスキーな薬をあんたは持ってたのよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.297.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"3DBC4FED-16E5-4441-B9A8-745B3B2F64B0","title":"シーン 298","duration":5.6000000000000005,"slideTitle":"第298スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「後で、担任に連絡入れるから、とりあえず、私についてきなさい。大学院で研究中の様子を見て、しっかり学びなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.298.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"BA7CB327-3F37-46D8-8432-5ECAFE2038C5","title":"シーン 299","duration":4.4,"slideTitle":"第299スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女は矢継ぎ早にそう僕に言うと、歩き出す。\n僕は、慌ててその跡を、追いかけていくのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.299.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"7D314C5D-35A5-49E5-99D8-25EDF46EBA22","title":"彼が彼女についていくと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.300.jpeg","animationDuration":1.5},{"id":"34DA6AF0-9269-4F28-B2B6-B0F97E58E1F1","title":"シーン 301","duration":4.6000000000000005,"slideTitle":"第301スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕がそれから、彼女と共に、大学院のある研究室に来た。\nすると、誰かが、僕の元に駆け寄ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.301.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"D9A28728-357C-4EA8-A8BC-9F573DA516A4","title":"シーン 302","duration":4.5,"slideTitle":"第302スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"私は、急にやってきた博士に驚くと共に、細々と一緒にきた、男子に声をかける。「君、大丈夫？」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.302.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"80B85D69-ED91-4686-AE26-C389DDBDC3AD","title":"シーン 303","duration":3.5,"slideTitle":"第303スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…、あなたは…誰ですか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.303.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"D15DDDEC-DAAA-456F-8B5E-70D0F925523F","title":"シーン 304","duration":3.5,"slideTitle":"第304スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「私は、アリス・マーガトロイド。ここの大学院生。」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.304.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"F46EA9AB-4145-4415-8147-93A929974BC9","title":"シーン 305","duration":3.5,"slideTitle":"第305スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですか…」僕は、そう呟くと、すこし足がふらつく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.305.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"ED5C9860-EFF3-44AD-8A4E-17E6BF509CA3","title":"シーン 306","duration":5.300000000000001,"slideTitle":"第306スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"私は、今にも倒れ込みそうな彼に、椅子を差し出す。\n「君、大丈夫なの？具合が悪いなら、帰ったほうがいいわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.306.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（驚く）.png"},{"id":"C08A0952-BBB9-4905-BF3C-4CA4ACBB8B40","title":"シーン 307","duration":5.6000000000000005,"slideTitle":"第307スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「彼を帰さないで、アリス。彼、さっきあなたたちが研究と開発途中の試験薬が入った瓶を、手に持ってみてたんだから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.307.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"1E7B17E9-3F8A-4DC3-A696-3FB5EC48E12E","title":"シーン 308","duration":3.5,"slideTitle":"第308スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「そうですか、パチュリー博士…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.308.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"7977D059-E904-4D31-9E85-B40C290A03BF","title":"シーン 309","duration":3.7,"slideTitle":"第309スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「それで、あんたは本当に、\nあの瓶を魔理沙っていう人からもらったのかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.309.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"17E723C3-B7DE-42D3-B5BB-790B5E66C169","title":"シーン 310","duration":3.5,"slideTitle":"第310スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ええ、そうです…。間違いではないです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.310.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"367D15A5-4706-48CB-AA3D-4729876FE632","title":"シーン 311","duration":3.5,"slideTitle":"第311スライド","backgroundName":"ペーストされた画像.tiff","characterName":"パチュリー・ノーレッジ","telop":"「そう。なら、アリス、あんたも手伝ってちょうだい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.311.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（怒る）.png"},{"id":"F1CE60B5-04BB-4594-9478-218126CEFC71","title":"シーン 312","duration":3.5,"slideTitle":"第312スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「ええ、わかりました…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.312.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"36450E6C-D2AC-4B5B-94ED-F01F44034E4B","title":"シーン 313","duration":5.300000000000001,"slideTitle":"第313スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女たちは、それから、その瓶を持って奥に向かった。僕は、「ふぅ。」と一息つき、「今日は災難だな…」と呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.313.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"73DC7816-6935-4F19-B395-BCDA4BCD4482","title":"シーン 314","duration":5.0,"slideTitle":"第314スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"でも、前の学校に比べれば、幾分かマシな気がするこの環境で、これからを過ごさないと…そう、僕は考えた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.314.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"915EDCB5-4BE2-42C0-A82B-D1E068062A08","title":"シーン 315","duration":5.2,"slideTitle":"第315スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、そこでふと瓶の中身を考える…。今思い出せば、魔理沙さんが、あのように小瓶を渡すのは、昔からだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.315.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"9345057C-E81D-4DD1-ACCF-D122E6A57FAD","title":"シーン 316","duration":5.800000000000001,"slideTitle":"第316スライド","backgroundName":"nc244107_コンビニ（夜）.jpg","characterName":"操夢","telop":"僕が、ふと思い出したのは、僕が、小学校低学年くらいの時だった。そのとき、父が自転車を押しながら、その横を歩いていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.316.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244107_コンビニ（夜）.jpg"},{"id":"674DC62E-0282-4458-8654-D73817E4C9F7","title":"シーン 317","duration":4.800000000000001,"slideTitle":"第317スライド","backgroundName":"nc244107_コンビニ（夜）.jpg","characterName":"操夢","telop":"そして、急に父がふらつき、ばたりと、自転車が倒れる。そして、父を見ると、父の体に傷がついていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.317.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244107_コンビニ（夜）.jpg"},{"id":"66D5A14C-5583-48D9-8970-C54CEA6203A1","title":"シーン 318","duration":5.0,"slideTitle":"第318スライド","backgroundName":"nc244107_コンビニ（夜）.jpg","characterName":"操夢","telop":"そんな父を、僕は無理やり引っ張って起こそうとするが、小さな体では、少し持ち上げる程度になってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.318.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244107_コンビニ（夜）.jpg"},{"id":"DDE6B1A3-150D-4342-AD47-C87D2E72A059","title":"シーン 319","duration":5.800000000000001,"slideTitle":"第319スライド","backgroundName":"nc244107_コンビニ（夜）.jpg","characterName":"操夢","telop":"すると、ちょうど彼女がやってきて、おどいた様子でこちらに聞いてくる。何を聞いたかは忘れたが、彼女は、小瓶を取り出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.319.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244107_コンビニ（夜）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/魔理沙（驚く）.png"},{"id":"D5624E45-3442-43CB-A7BE-8211591FABA9","title":"シーン 320","duration":4.2,"slideTitle":"第320スライド","backgroundName":"nc244107_コンビニ（夜）.jpg","characterName":"操夢","telop":"そして、彼女は、そのまま、その小瓶の液体を父に飲ませると、彼女は、僕の目を覆い隠す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.320.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244107_コンビニ（夜）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/魔理沙（驚く）.png"},{"id":"7BC660C0-804A-48EF-9377-DD1A8E085176","title":"シーン 321","duration":4.9,"slideTitle":"第321スライド","backgroundName":"nc244107_コンビニ（夜）.jpg","characterName":"操夢","telop":"彼女が、僕の目から手を離し、僕がみたときには、普通にそこに立って、困っていた父の姿がそこにあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.321.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244107_コンビニ（夜）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"718B68EA-9D4D-49F4-9CA0-750D51223D38","title":"シーン 322","duration":5.0,"slideTitle":"第322スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それからは、ときどき魔理沙さんが、僕に小瓶を持ってくるようになり、僕に密かに渡してくるようになった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.322.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"23D2AD6E-04F2-47D0-9B26-88F714EE7DD7","title":"シーン 323","duration":6.5,"slideTitle":"第323スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は両親から小遣いを一切もらったことはなく、日常的な収入と言えるのは、魔理沙さんから渡された小瓶を飲んで、もらえる小銭だけだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.323.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"C1B8707F-58A1-40DE-BDD2-9FCF5F794DFB","title":"シーン 324","duration":5.5,"slideTitle":"第324スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"ふとそこまで考えた思い出し、ポケットを漁る、するとさっきの紙を見る。そこには飲めば、1000円札を一枚渡すとあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.324.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"2BB9E083-E1EE-4A0E-829B-124EFFB82C7C","title":"シーン 325","duration":3.5,"slideTitle":"第325スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、今回の収入源が消えたことに、ため息を吐く僕だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.325.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"3FFCD680-AD3B-4BAC-B582-7C34F04150CF","title":"シーン 326","duration":5.2,"slideTitle":"第326スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそれから、どれだけの時間待っただろうか…、そんな頃になると、アリスと名乗っていた彼女が、戻ってきた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.326.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"94676DCB-B9B4-4F83-AF14-33AE0A0BC969","title":"シーン 327","duration":4.7,"slideTitle":"第327スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「ごめんなさいね…、こんな時間まで、拘束しちゃって…」\n私が時計を見ると、夜の8時を指していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.327.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"C27B259D-1220-4DBF-97FC-C4C8F1163889","title":"シーン 328","duration":4.1000000000000005,"slideTitle":"第328スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「いえ…、僕が、あの小瓶を持ってたのが、\n原因ですから、謝らなくても大丈夫ですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.328.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"56CD1158-5F67-46EE-ACE1-4BD1F5E0E2F1","title":"シーン 329","duration":5.7,"slideTitle":"第329スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「そう…。とりあえず、博士が研究中に、寝落ちしたから、帰ってもいいわよ。あとは、私が、彼女を説得させておくから…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.329.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"D7647265-955B-432F-8EF5-08633A693590","title":"シーン 330","duration":3.5,"slideTitle":"第330スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「あと帰る前に、君の名前を聞かせてくれるかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.330.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"B3BE663E-BBA6-483A-BB79-E7CD20ED5CA9","title":"シーン 331","duration":3.5,"slideTitle":"第331スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「僕の名前は…藤原紅夢です。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.331.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"0C390664-335D-4697-88CD-576E205878FE","title":"シーン 332","duration":3.5,"slideTitle":"第332スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「もしかして、君の父親って、妹紅先輩？」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.332.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（驚く）.png"},{"id":"36D5FEAD-B32C-460E-9CB4-DAE00C561317","title":"シーン 333","duration":3.5,"slideTitle":"第333スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですけど…父も、この学校出身なんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.333.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"40D37DBA-440F-433F-AB96-7D0A0E6023A6","title":"シーン 334","duration":5.7,"slideTitle":"第334スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「いや、私たちが以前に、著名大学院同士での交流会の時に、ある男子校の裏側の有名人だったの…、いつの間に子どもを…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.334.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"E33FFA2E-1592-4ED3-98BC-A54CEA40A35C","title":"シーン 335","duration":3.5,"slideTitle":"第335スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「あの、何が言いたいんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.335.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"B023085B-27FD-4E60-BA9A-DEA7279EE8EF","title":"シーン 336","duration":5.6000000000000005,"slideTitle":"第336スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「いや、こんな話はもういいわ、それより、君はこれから、一人で教室まで戻れるかしら？戻れないなら、案内するけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.336.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"90DF35E6-5BC3-4F0D-BD7C-AA8798494F25","title":"シーン 337","duration":4.7,"slideTitle":"第337スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「いや、一人で大丈夫です。では、失礼します。」\n僕は、そう言い立ちあがろうとすると、眩暈がする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.337.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"160D1DFF-FA54-43CF-9DBC-5B4F36D0D3DC","title":"シーン 338","duration":4.0,"slideTitle":"第338スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"私は、彼が倒れかけるのを見て、そっと腕を出し支える。\n「君、本当に一人で大丈夫？」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.338.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（驚く）.png"},{"id":"61FE7DDE-01D8-49D4-90FC-D1F21732C8CA","title":"シーン 339","duration":6.1000000000000005,"slideTitle":"第339スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「きっと、長い時間座っていたからだと思いますから、心配はいらないですよ。それでは、失礼します。」僕はそう言い、部屋を出た。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.339.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"023E530D-FD5E-49DA-8E02-10DE8EFAA5F1","title":"シーン 340","duration":5.0,"slideTitle":"第340スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそれから、夜の学校を歩いていく。だが、空腹と疲労が、溜まりに溜まったこの体が、悲鳴をあげている。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.340.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"79A0D35D-ED11-4DFE-869E-771C9B203C38","title":"シーン 341","duration":4.9,"slideTitle":"第341スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、やがてその疲労は、頭にやってくる。\n「うぅ…」僕は、気絶しないように、意識を保ちながら歩く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.341.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"5571A1AE-E772-4F0A-AB43-D1BABDC6441B","title":"シーン 342","duration":4.3,"slideTitle":"第342スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、僕は、ある人影を見る。\nだが、僕はとうとう、その場で気を失い、倒れ込むのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.342.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"27B68CE8-2964-4298-9EEC-23FF6820F4B2","title":"シーン 343","duration":4.6000000000000005,"slideTitle":"第343スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"私は、突如倒れ込んだ、彼に近づき、声をかける。\nだが、反応が返らず、彼を抱え、職員室に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.343.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり寝顔.png"},{"id":"E52C39DF-6EC9-48BC-AE9A-781535DBFDA8","title":"シーン 344","duration":3.5,"slideTitle":"第344スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"私が職員室に入ると、彼女が私の方を見ると、驚く。","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.344.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（驚く）.png"},{"id":"C3039161-DFB3-40FD-B1FB-2C4BEE714208","title":"シーン 345","duration":3.5,"slideTitle":"第345スライド","backgroundName":"ペーストされた画像.tiff","characterName":"射命丸文","telop":"「どうしたんですか、早苗さん、その彼は？」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.345.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"60257356-2DEE-4901-AC43-71B3EC60DBCE","title":"シーン 346","duration":4.7,"slideTitle":"第346スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「ふとさっき、私が廊下を歩いていたら、彼が倒れたんですよ。それで、彼、叩いたら起きますかね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.346.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"FD7437A1-8BD6-4BD7-A18B-612697999B3E","title":"シーン 347","duration":3.8000000000000003,"slideTitle":"第347スライド","backgroundName":"ペーストされた画像.tiff","characterName":"射命丸文","telop":"「いや、叩くのはよしたほうがいいですよ、\n私が彼を自宅まで送り届けましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.347.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"A43DB3F6-A167-4AB2-8838-3CD544A8C3F3","title":"シーン 348","duration":4.9,"slideTitle":"第348スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「そうですか…、それではよろしくお願いします。」\n私は、そういうと、彼の身柄を彼女に預けるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.348.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"E9248D82-CCD7-42C2-8DA8-883F4A7B2EEF","title":"文が彼を抱え、彼の家に着くと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.349.jpeg","animationDuration":1.5},{"id":"4273E8EA-76D8-4320-88CC-01FB79DEC02F","title":"シーン 350","duration":4.800000000000001,"slideTitle":"第350スライド","backgroundName":"ペーストされた画像.tiff","characterName":"射命丸文","telop":"私は、彼の家に着くと、インターホンを押す。\n「武蔵学園の射命丸文です、誰かいらっしゃいませんか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.350.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"AD421AE7-950D-4A52-963B-E84C0A9D5E0F","title":"シーン 351","duration":4.6000000000000005,"slideTitle":"第351スライド","backgroundName":"ペーストされた画像.tiff","characterName":"射命丸文","telop":"すると、彼女の母で、学園の卒業生が出てきた。\n「あなたが連絡されていた彼を確保してきました。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.351.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（驚く）.png"},{"id":"F254B598-FD4B-4395-8167-587D2C198FA6","title":"シーン 352","duration":3.5,"slideTitle":"第352スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"「ありがとうございます。」私はそう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.352.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"E4520B69-E860-4CE6-8913-385B4934F25F","title":"シーン 353","duration":4.7,"slideTitle":"第353スライド","backgroundName":"ペーストされた画像.tiff","characterName":"射命丸文","telop":"「それじゃあ、後は、よろしくお願いします。」\n私はそういうと、彼をそっと下ろし、その場をさった。","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.353.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"AB8820AC-8CED-42AC-9EE5-EA65FFE68F3B","title":"シーン 354","duration":4.800000000000001,"slideTitle":"第354スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"「はぁ、全く困ったものだわ…」私は、ゆっくりと彼を抱えると、そのまま彼の部屋に、向かうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.354.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"00318898-C8D6-4C48-9CC1-3664DED1EC8E","title":"彼の目が覚めると…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.355.jpeg","animationDuration":1.5},{"id":"77970A21-AE68-4021-8A19-FB7E4CB4E188","title":"シーン 356","duration":4.9,"slideTitle":"第356スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、ふと目が覚めると、そこは自分の部屋だった。\nそして、ゆっくりとベッドから降りて、電気をつける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.356.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"A71C6D2F-650B-4E1F-ABA3-F3BED05B48E8","title":"シーン 357","duration":5.1000000000000005,"slideTitle":"第357スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、時計を見ると、深夜帯だということに気がつく。\nそして、同時に机の上にメモ書きがあることに気づく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.357.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"3440E968-44F3-4C81-8E9A-FF371E4F1808","title":"シーン 358","duration":5.4,"slideTitle":"第358スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そのメモ書きは、僕の知らない筆記跡でこう書かれていた。\n「これ以上無茶をすると、その頭が台無しになるぞ」と…。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.358.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"33B89E44-4D0B-43C3-BDC0-C6932DBF4229","title":"シーン 359","duration":5.4,"slideTitle":"第359スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ふっ…」僕は、それを見て思わずそう吹いてしまう。確かに、この人の言うとおり、僕の取り柄は勉学だけだからだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.359.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"8A83353B-F2F1-4F06-9975-6CC7FDE07F69","title":"シーン 360","duration":5.7,"slideTitle":"第360スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、そのメモ書きを残した人物にも、心当たりがないわけではなかった、だが、ごく僅かに感じるそれを、僕は思い返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.360.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"81407B92-585D-4CCB-9058-6A681CF14FBD","title":"シーン 361","duration":5.2,"slideTitle":"第361スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、ふとその横にある家族写真が目に映る…。\nそして、「ふぅ」と一息吐くと、電気を消し、ベッドに戻った。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.361.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"F7AEA52A-0861-452A-89CC-B2CD796F49CF","title":"そのころ、とある場所では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.362.jpeg","animationDuration":1.5},{"id":"5DE0DF56-E823-4F44-9C39-8FD7107DB460","title":"シーン 363","duration":4.800000000000001,"slideTitle":"第363スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"私は、自分の部屋で窓に視線を当てながら、片手に缶ビールを持ち、ぼそぼそと、一人小言を呟いていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.363.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"CE747318-ECF6-43C1-B8C3-9C69901DD3AC","title":"シーン 364","duration":4.4,"slideTitle":"第364スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"「なぁ、お前は、どう思う、今の私を見て…」\n私は、誰もいない部屋で、そう誰かに語りかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.364.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"372F99B4-8967-4E19-A2C6-ACCE878A6CB3","title":"シーン 365","duration":4.3,"slideTitle":"第365スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"だが、返事はない。それでも私は、言葉を続ける。\n「今の私が、お前に知られたら、きっと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.365.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"5775F514-BC09-48B2-8747-7C76E9BB2054","title":"シーン 366","duration":4.9,"slideTitle":"第366スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"「きっと…」私は、そう言うと、ふと後ろから声が聞こえる。\n誰もいないはずの空間からは、声が聞こえる。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.366.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"8C5337B7-0CD7-4AC1-BE02-21947FE2F7A5","title":"シーン 367","duration":5.2,"slideTitle":"第367スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"だが、私は、頭を振り、缶ビールを飲み切ると、そのままベッドに入る。だが、だんだんと、その声は大きくなる。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.367.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"EEB20742-0903-4452-9E9C-2E565AB129AD","title":"シーン 368","duration":3.5,"slideTitle":"第368スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"私は、ふと気がつけば、その声に体が勝手に動いていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.368.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"99EEE232-B108-4C38-9DED-EB3753983C6F","title":"それから…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.369.jpeg","animationDuration":1.5},{"id":"D477064A-CF7E-4D8E-A748-34532CBF4BC9","title":"シーン 370","duration":3.8000000000000003,"slideTitle":"第370スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"「あれ、私は…いったい何を…」\n私は、ふと気がつくと、そこはある交差点だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.370.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"56554650-D7C1-435D-8900-B1B1E1FAF61A","title":"シーン 371","duration":5.2,"slideTitle":"第371スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"「お前、今俺が止めなければ、車に轢かれるところだったぞ。\nこんな時間帯に、女一人でふらふら何してたんだ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.371.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（激怒）.png"},{"id":"7203F21C-DBE6-43AA-9F4C-A582064803D4","title":"シーン 372","duration":3.5,"slideTitle":"第372スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"「えっ…」私はそう言われるが、思い出せない。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.372.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（激怒）.png"},{"id":"A608C0DF-3D85-48FC-991B-0AF1772FEFEA","title":"シーン 373","duration":5.0,"slideTitle":"第373スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"「まぁ、車が走ってなかったことが幸いか。それより、お前さんは、どうしたんだ、何かに血迷ってるのか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.373.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（睨む）.png"},{"id":"A962FCA0-51A3-4F76-AD93-8303CF5EC664","title":"シーン 374","duration":3.9000000000000004,"slideTitle":"第374スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"「えっと…、私はただ…」\nそう言いかけて気がつく。「あなたは、霊夢の旦那さん…」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.374.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（睨む）.png"},{"id":"51ABF7C1-F901-4AE8-A068-8B93F2FE791F","title":"シーン 375","duration":3.5,"slideTitle":"第375スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"「そうか…、そしたら、久々の顔合わせだな…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.375.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（驚く）.png"},{"id":"3473EE49-B3EB-412E-B20D-563BA029F634","title":"シーン 376","duration":4.800000000000001,"slideTitle":"第376スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"「まぁ、とにかく、次からは、信号をよく見て渡るんだな。」\n私は、そう言うと、その場をさっていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.376.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（睨む）.png"},{"id":"A70442C2-D522-4B63-9A52-74FA7F4EBEA4","title":"シーン 377","duration":3.9000000000000004,"slideTitle":"第377スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"私は、彼が立ち去ると、「あの声は、いったい誰の声だったんだろう…」っと、そう呟きながら、家に帰るのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.377.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"0D92E3BA-B80A-45B7-83A9-F76516DB625E","title":"翌朝…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.378.jpeg","animationDuration":1.5},{"id":"0C3423E5-B993-4E3A-A659-5015F6E7FC84","title":"シーン 379","duration":5.4,"slideTitle":"第379スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、目が覚め、カーテンを開けると、朝日が部屋に差し込んでいた。そして、あくびをしながら、リビングに向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.379.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"F2F76A5C-4FD3-4FCD-B54B-89E47B3160B8","title":"シーン 380","duration":3.5,"slideTitle":"第380スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「どうしたの、母さん、そんな顔して。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.380.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"BC11C599-25F5-4641-AF91-3F7AF0FDA8A4","title":"シーン 381","duration":5.5,"slideTitle":"第381スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.381.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"ADEA551F-33DF-4B6F-919B-D3C454456478","title":"シーン 382","duration":5.300000000000001,"slideTitle":"第382スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.382.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"58C69D1B-F33E-49E9-87DB-056088C44E1D","title":"シーン 383","duration":3.5,"slideTitle":"第383スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"「それじゃあ、行ってくるわ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.383.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"CBB0B6BF-C7A2-46DB-AB25-D5465F65CE28","title":"シーン 384","duration":5.0,"slideTitle":"第384スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、それから朝食を食べ終えると、母が残していた洗い物などもまとめて済ませ、ふと冷蔵庫を開けてみる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.384.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"89A6C6FE-B20E-4558-9D7B-F32BC4C5628D","title":"シーン 385","duration":4.6000000000000005,"slideTitle":"第385スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"冷蔵庫の中は、スカスカだった。「買い物しないと…」\n僕は、そうぼさっと呟きながら、自室に戻る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.385.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"3FB40902-47FB-4B1E-B13C-DB2CC2B4441F","title":"シーン 386","duration":5.9,"slideTitle":"第386スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、自室に戻ってくると、少し目に見えぬ埃が溜まっていたので、軽くを掃除機をかける。そして、ふと両親の部屋に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.386.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"F50B9993-B760-4079-B547-E2A8974E5FAC","title":"シーン 387","duration":5.300000000000001,"slideTitle":"第387スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd","characterName":"操夢","telop":"そして、ふと窓から見える背景を見て思い出す、ここは台地の上で、向こう側は低地なため、景色が随分といいのだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.387.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd"},{"id":"9CD32E60-BB2F-49C1-B680-1671B8C026D9","title":"シーン 388","duration":5.6000000000000005,"slideTitle":"第388スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd","characterName":"操夢","telop":"そして、部屋を見渡す。母は準備をきちんと済ませてから、リビングで朝食を食べていた。僕は、机からメモ帳を出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.388.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd"},{"id":"969BD25D-5CE9-413D-BCCA-9DFC4514F33F","title":"シーン 389","duration":5.5,"slideTitle":"第389スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd","characterName":"操夢","telop":"そして、そこに冷蔵庫がスカスカなのを記して、机に残すと、僕は、自室で身なりを整えてから、学校に向かうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.389.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.pxd"},{"id":"7D9F52AD-5792-4347-8824-5EF9260E4579","title":"シーン 390","duration":3.5,"slideTitle":"第390スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、学校に着くと、さとりが声をかけてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.390.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"98DE443B-8C12-495A-852B-E010D64BE2A5","title":"シーン 391","duration":3.5,"slideTitle":"第391スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「今日は、朝から来れたんですね…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.391.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"5A65B0D3-391D-4CC7-9851-E7FDDC11D6B8","title":"シーン 392","duration":3.5,"slideTitle":"第392スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「何か、困ったことでもあったんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.392.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"4B776D4A-FBA5-4927-AEBC-28F4B7199AAA","title":"シーン 393","duration":3.5,"slideTitle":"第393スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「ええ、朝からあなたのことは、噂立ってますから…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.393.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"7AAFD78D-E170-4C1A-9BD8-DAD6FC33586D","title":"シーン 394","duration":3.5,"slideTitle":"第394スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「何で、僕の噂が出たら、困るんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.394.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"A608714A-9B4A-4F74-97F7-562822F46DBD","title":"シーン 395","duration":3.5,"slideTitle":"第395スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「それは…、今日の７限目に遠足の班を決めるからですよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.395.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"40CCD816-E872-4340-96B1-2AEB31175FB9","title":"シーン 396","duration":5.800000000000001,"slideTitle":"第396スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「遠足…」僕は、そうつぶやく。そして、今まで、幼少期を除けば、遠足などの校外活動は一切してこなかったことを思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.396.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"B13C72E4-FF90-4D08-825E-F832C84A5739","title":"シーン 397","duration":3.6,"slideTitle":"第397スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「まぁ、とりあえず、もうすぐ朝礼ですから、\n席に座ったほうがいいですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.397.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"291A33FD-C8A6-4C81-A6FD-5997BF1B36FF","title":"シーン 398","duration":3.7,"slideTitle":"第398スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですね…」僕は、彼女に言われた通り、\n自席に座り、荷物の整理を始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.398.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"7A7692D4-BDAB-4DF1-ADF6-D5A2F1D88AAD","title":"その頃とある場所では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.399.jpeg","animationDuration":1.5},{"id":"23AB659A-8243-4206-B7E1-BCEFFABCDC4D","title":"シーン 400","duration":4.9,"slideTitle":"第400スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「ねぇ、フラン。さっきから、どうしたのよ？」\n私は、そう辿々しい動きを見せる妹のフランに問いかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.400.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"33864D5B-2C44-45E8-90D6-86F3631383D0","title":"シーン 401","duration":5.0,"slideTitle":"第401スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「えっと…」私は、突如として声をかけられ、そう返す。\nそして、今から10年くらい前のことを思い出す…。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.401.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/もじもじ赤面.png"},{"id":"39DB23F9-EB70-4141-8968-30A22C757574","title":"シーン 402","duration":5.7,"slideTitle":"第402スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「まさか、かつてあなたに告白してきた、ある男児に再び出会って、そのまま彼の血を吸って…」私はある覚悟を決めて聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.402.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"5F838B77-803D-48B4-87DB-A4C5F43FD7B2","title":"シーン 403","duration":5.300000000000001,"slideTitle":"第403スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「その通りだよ…お姉様…、私は、久々に見た彼に…」\n私が、その言葉の続きを言いかけると、彼女が苦笑する。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.403.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア苦笑.png"},{"id":"B74B410A-A77A-4D54-BC32-6F51617CD9BA","title":"シーン 404","duration":5.800000000000001,"slideTitle":"第404スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「私のことは、気にしなくていいのよ、フラン。フランがこの屋敷から、出ていくのだとしも、私は、一人で生きられるから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.404.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア苦笑.png"},{"id":"3051CA33-A650-4204-BF62-72590BA4D870","title":"シーン 405","duration":3.5,"slideTitle":"第405スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「自分の部屋にこもって、少し考えてきてもいい？」\n私は、そう彼女に聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.405.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恥ずかしい顔.png"},{"id":"A50990B4-81F7-4B00-AF66-48E645E80981","title":"シーン 406","duration":4.1000000000000005,"slideTitle":"第406スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「いいわよ、あなたの将来に関わる、\n大事なことなんだから、ちゃんと考えてきなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.406.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア苦笑.png"},{"id":"BC16CD6F-A670-414E-84A4-5C1730D817C0","title":"シーン 407","duration":5.4,"slideTitle":"第407スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「私は、姉として、この屋敷の主人として…、失格ね…。」\n私は、フランが部屋を離れると、そう一人小言をつぶやく。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.407.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"F491E54F-A79C-4354-8F07-1E1DD95E8020","title":"シーン 408","duration":5.300000000000001,"slideTitle":"第408スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"私は、ふと目から涙がポタポタと垂れていることに気づく。\n「あれ…いつの間に…」私はそう呟くと、一人で笑った。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.408.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"ADA53D86-2B15-415C-934C-20B99A0D8989","title":"一方でフランは…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.409.jpeg","animationDuration":1.5},{"id":"F12E2A05-F0D0-48F9-A21D-F4B404B26702","title":"シーン 410","duration":5.4,"slideTitle":"第410スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私は、自分の部屋に戻ると、再び10年前、試験的な取り組みで、ある幼稚園のクラスの担当をしてたときを思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.410.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"40A9F2F8-C861-4032-A510-9F3F5E2DF1C1","title":"シーン 411","duration":5.9,"slideTitle":"第411スライド","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","characterName":"フランドール・スカーレット","telop":"私は、10年前、日々の解体工事にくる文句で溜まった疲労を癒そうとお姉様がいい、ある幼稚園のクラスを任されたときだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.411.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg"},{"id":"8311F1DE-EF74-429F-9DF0-95FD69FBAB10","title":"シーン 412","duration":5.5,"slideTitle":"第412スライド","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","characterName":"フランドール・スカーレット","telop":"その幼稚園は、著名な男子校の幼稚部に属する幼稚園で、その名の通り男児だけのクラスのみで、全体が構成されていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.412.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg"},{"id":"2F338B9D-250F-4EB9-9B59-A6DC756FB123","title":"シーン 413","duration":4.800000000000001,"slideTitle":"第413スライド","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","characterName":"フランドール・スカーレット","telop":"私たちは、それとは対照的な女子校出身だったので、\nそれと比べて意外とその日々は新鮮味を感じていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.413.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg"},{"id":"1F6B84D3-B259-434F-B0A0-383E902E6C5E","title":"シーン 414","duration":3.5,"slideTitle":"第414スライド","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","characterName":"フランドール・スカーレット","telop":"事の発端は、ある劇の発表をしていたときだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.414.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg"},{"id":"25568A47-7DBC-4211-8C89-6F8B7FAB3816","title":"シーン 415","duration":5.800000000000001,"slideTitle":"第415スライド","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","characterName":"フランドール・スカーレット","telop":"それは、事前に収録し、編集した劇の動画を上映する形での発表だった。そして、その発表途中に、部屋を飛び出る男児が出る。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.415.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg"},{"id":"B240F630-7D54-4B80-B2C1-7F271BFADB44","title":"シーン 416","duration":5.7,"slideTitle":"第416スライド","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterName":"フランドール・スカーレット","telop":"私が、その男児の後を追いかけると、遠くには、その男児は言っておらず、周囲をキョロキョロしながら、私に目線を当てる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.416.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-08-28_19-07.png"},{"id":"72B26C02-B1F1-417C-A08E-DD000F31FA11","title":"シーン 417","duration":3.5,"slideTitle":"第417スライド","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterName":"フランドール・スカーレット","telop":"すると、彼は、私の方を真正面に見つめ、ある言葉を告げる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.417.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-08-28_19-07.png"},{"id":"475B11D0-C9F4-49D6-8DA6-D39DFBE4D05D","title":"シーン 418","duration":3.5,"slideTitle":"第418スライド","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterName":"フランドール・スカーレット","telop":"その彼の行動に対して私は、一言返す程度だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.418.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-08-28_19-07.png"},{"id":"6F769195-5800-47E1-A3F5-AD1F4A431D7B","title":"シーン 419","duration":5.7,"slideTitle":"第419スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"今考えると、彼は、あえて発表中に部屋を飛び出ると言う、目立つ行動で私を外に出し、同年代の男児から離れたのだと思う。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.419.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"573FBBC1-9350-489B-BE7A-34EB2155519B","title":"シーン 420","duration":5.7,"slideTitle":"第420スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私が聞いたところでは、その後、彼は、勉学における成績で、常に学内トップだったとか。だが、欠けてるとこもあるとか…。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.420.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"FB2BE81D-647A-4D00-B8AA-CF24FCA5DFCD","title":"シーン 421","duration":5.7,"slideTitle":"第421スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私の母校と彼が元いた学校の学力は同等あるいは、私の母校がより高いので、中途入学のための入試難易度もそれなりに高い。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.421.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"6DAD6171-9179-40BD-9471-AC3F5CDCC2C0","title":"シーン 422","duration":5.2,"slideTitle":"第422スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"そして、あのとき…、ふとある情報を入手し、深夜帯に母校を突撃すると、情報にあった通り、彼の姿を発見した。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.422.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"89061FB6-090D-4AB5-860F-44BA8FAC3714","title":"シーン 423","duration":5.5,"slideTitle":"第423スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"あの時の私は、深夜テンションなのか、それとも、久々に彼に会ったからなのか、数人程度しかやっていない吸血をした。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.423.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"1EA1DF58-D58A-48EA-B982-E64E224E8EF5","title":"シーン 424","duration":5.4,"slideTitle":"第424スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"なぜ、そうしたのか、私にはまだ、完全には把握しきれてないし、この気持ちの正体もいまだに、どっちかわからない。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.424.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"391A686F-72A4-49A2-A32F-F02C82FCD14D","title":"シーン 425","duration":5.7,"slideTitle":"第425スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"単純に彼の背が伸びたからなのか、それとも…、私があの夜吸血する前に見た彼に、一目惚れしたからなのか…、わからない。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.425.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"0248139C-AEB5-440D-8D60-26808E57D1EE","title":"シーン 426","duration":5.800000000000001,"slideTitle":"第426スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"でも、この気持ちを確かめて、蹴りをつけないと、お姉様の仕事の手伝いで気が抜けてしまいそうだった。「どうしよう…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.426.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"13630811-01E9-405A-B9C3-3F03905CE47B","title":"シーン 427","duration":3.5,"slideTitle":"第427スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私は、それから、しばらく考え込むのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.427.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"0CA7BF02-D582-415F-9871-F06AF775144E","title":"彼に視点が戻り…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.428.jpeg","animationDuration":1.5},{"id":"CCC57BF7-1230-494C-A322-9ECDE1F75099","title":"シーン 429","duration":4.3,"slideTitle":"第429スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"あれから、６限までの授業を無事に乗り切った僕は、\n遠足の班決めが始まる時間になっていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.429.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"E31EF2DB-D5A1-44FE-9E44-8E0866009377","title":"シーン 430","duration":5.5,"slideTitle":"第430スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、教室の扉が開き、さとりが早苗師匠と読んでいた女性が入ってくる。そして、僕は、女子たちの挨拶に合わせる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.430.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"F469945D-BEBB-4DAB-91D1-1FC9CBCA1341","title":"シーン 431","duration":3.5,"slideTitle":"第431スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「着席してください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.431.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"6DBB3225-92A1-4242-ADA3-C7BEAB60B753","title":"シーン 432","duration":4.4,"slideTitle":"第432スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女がそう言うと、女子たちが一斉に着席し、\n僕もそれに合わせる。すると、彼女が話し始める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.432.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"BEEA494A-685A-4F41-8887-CA169B604E9A","title":"シーン 433","duration":5.800000000000001,"slideTitle":"第433スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「これから、放送で遠足に関する注意事項と、規定の放送、そして、あらかじめ決められた特定の生徒の班分け表を配ります。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.433.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"47A88AED-8B93-4436-AEDC-AB670C05BE56","title":"シーン 434","duration":3.5,"slideTitle":"第434スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「特定の生徒の班分けも放送されるので、よく聞くように。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.434.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"D92F6D3B-2369-4181-8AC0-001117F88584","title":"シーン 435","duration":5.5,"slideTitle":"第435スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女がそう言うと、校内放送が流れる。そして、その放送の最後に流れた、事前に決められた班分けに教室が、ざわつく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.435.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"8673B8E8-7254-4B7F-B204-C66EFC61541E","title":"シーン 436","duration":8.4,"slideTitle":"第436スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「静かに、放送でもあった通り、K-3組の古明地こいし、当クラスの古明地さとり、藤原紅夢、U-4組のアリス・マーガトロイドは同じ班で行動してもらいます。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.436.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（怒る）.png"},{"id":"E00EFDFA-735C-4AEC-A99D-E9B7C02F01D8","title":"シーン 437","duration":7.5,"slideTitle":"第437スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「今から、当クラスから該当する藤原さんと古明地さんには、放送で指定された、別室にて、話し合いを進めてもらいます。二人は帰りの支度を持っていくように。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.437.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（怒る）.png"},{"id":"4E4A6272-4F82-4D5D-B626-695DF71EE907","title":"シーン 438","duration":5.5,"slideTitle":"第438スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、困惑しながらも、見知らぬ女子と行動するよりかは、マシかと…、そう決めて、帰りを支度を済ませ、教室を出た。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.438.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（怒る）.png"},{"id":"347000DE-4A66-48C8-A379-1A5B98CBC181","title":"彼が別室に向かうと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.439.jpeg","animationDuration":1.5},{"id":"C89A6772-F644-4B9D-B9E2-6C5B86EAE4DF","title":"シーン 440","duration":5.2,"slideTitle":"第440スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから、僕が、指定された部屋にさとりと共に入ると、\nすでに、他のクラスからきた2人は、部屋で待っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.440.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"29238B99-0191-4692-B944-49F6E9A73B4D","title":"シーン 441","duration":3.5,"slideTitle":"第441スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、沈黙の時間と、変な空気感が部屋を包み込む。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.441.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"46EB4DB7-0D90-4515-9946-5F5AB005152F","title":"シーン 442","duration":3.5,"slideTitle":"第442スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「とりあえず、遠足のための調べ物をしませんか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.442.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"694AE083-9674-4231-B0EA-10273F301C60","title":"シーン 443","duration":3.5,"slideTitle":"第443スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「今回の目的地は、副都心か臨海部だそうですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.443.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"BD4C5DAA-071F-4E84-B93B-8FE07A0C9979","title":"シーン 444","duration":3.5,"slideTitle":"第444スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地こいし","telop":"「藤原さんは、池袋・新宿・渋谷とお台場、どっちに行きたい？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.444.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"2F3070EC-7132-4C50-9580-54E3E67638AF","title":"シーン 445","duration":3.5,"slideTitle":"第445スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「僕は…、お台場が空いてそうだから、そっちがいいです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.445.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"3011CC44-4F0C-4E05-859D-66965CBFBC25","title":"シーン 446","duration":3.5,"slideTitle":"第446スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「それで、誰かお台場に行ったことがある人は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.446.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"BA61594C-87F6-4396-9E91-EA98D123EC05","title":"シーン 447","duration":3.5,"slideTitle":"第447スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「僕は…昔に家族で何度か行きました…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.447.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"6AA3E397-2BF5-437A-8FB0-2BB813A4CECD","title":"シーン 448","duration":3.5,"slideTitle":"第448スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地こいし","telop":"「私は、名前は知っているけど行ったことはないよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.448.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"78B9699B-B79B-49E0-AAF4-93DB2ED4F9CB","title":"シーン 449","duration":3.5,"slideTitle":"第449スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「私も、こいしと一緒ですよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.449.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"50911D32-1F18-462B-B9FB-2E77F99BE742","title":"シーン 450","duration":3.5,"slideTitle":"第450スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「私は…国際展示場での発表で何度かだけ…です。」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.450.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"6D1768BA-EC7E-4449-BC56-7FC7619D408A","title":"シーン 451","duration":3.5,"slideTitle":"第451スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですか…」僕がそう言っていると、扉が開く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.451.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"EB9249AC-D119-407A-ACC1-24FBAE08B005","title":"シーン 452","duration":4.0,"slideTitle":"第452スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"「おや、みなさん、お揃いのようで…」\n私はそう言いながら、ある紙を出し、机に置く。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.452.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"386CD28B-9CA2-4563-89BF-81137C2CF4B0","title":"シーン 453","duration":5.7,"slideTitle":"第453スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"「これは、遠足ノートです。あなたたちの班は、遠足にかかる費用が、全額学校負担になってますので、確認してください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.453.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"678F89D7-F745-4595-BA3F-8B6893D18C2C","title":"シーン 454","duration":5.0,"slideTitle":"第454スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"突如やってきて、ノートを残し、彼女が去ると、こいしたちが驚いた表情を見せる。僕も、内心驚いていた…。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.454.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"63455349-12CE-40BD-84AC-14CC85FD910D","title":"シーン 455","duration":5.5,"slideTitle":"第455スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「一体これは、なぜこんな待遇なのでしょう…、普通だったら、必要な費用は自前調達ですが…、学校が全額負担とは…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.455.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"B0608D81-5AE8-484A-AC57-368E6656C231","title":"シーン 456","duration":5.6000000000000005,"slideTitle":"第456スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「さぁ、わからないです…。」僕はそう言うと、ふとそのノートを取って中身を見る。そこには、ある内容が書かれていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.456.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"7DBDCFDC-4820-4C4F-BEB0-8B23F6DEFC70","title":"シーン 457","duration":5.800000000000001,"slideTitle":"第457スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「全国財閥校統一模試…」そのノートには、僕がこの試験を遠足の2週間前に受けて、その結果が遠足に関わると書いてあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.457.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"5AA871F3-82A6-4B4D-98C5-A481AE526D68","title":"シーン 458","duration":5.2,"slideTitle":"第458スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「これ…、私たちのような偏差値や学力に加えて、\nそれなりに敷居が高い学校で生き残るための模擬試験ですよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.458.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"C27AC764-9AC2-4C92-BEC0-12DECEDB60CE","title":"シーン 459","duration":5.2,"slideTitle":"第459スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「確か、一般的な高校入試とは、別枠の財力を持つ家の子どもが受けるやつですよね…、僕は、受けてませんが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.459.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"94624CDA-DFBD-44BB-AEB5-DC6929A3CD7F","title":"シーン 460","duration":5.4,"slideTitle":"第460スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、遠足以外にも、僕が受けたこの試験の結果は、彼女たちの今後も左右する可能性があると…記載されていた…。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.460.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"A1EC788D-FFD7-4AFB-80C3-252A42297520","title":"シーン 461","duration":5.6000000000000005,"slideTitle":"第461スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「これは…実質的に、こいしさんたちの学業が、僕の試験の結果の内容によって左右する…、どんな目的でこんなことを…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.461.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"732BF10C-6AE8-48EA-A0E5-62D0F4A1C7E0","title":"シーン 462","duration":5.300000000000001,"slideTitle":"第462スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「さぁ、私には分かりませんが、少なくとも、私たちの学校生活に関わるということは…確定しているみたいです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.462.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"DFA1097B-C810-44AD-8F21-59C2B58D26AA","title":"シーン 463","duration":5.7,"slideTitle":"第463スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそこから、ノートを読み進めると、遠足の流れや、予定に加え、彼女たちの学業にも関わる試験だと詳細に書かれていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.463.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"A0E99E73-4BC3-41DA-9030-3F24D01B4AEE","title":"シーン 464","duration":5.6000000000000005,"slideTitle":"第464スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、最後にこう書いてあった。模擬試験は筆記による通常の試験を2週間後、そしてその他の試験を遠足後に行うと…。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.464.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"0165475C-EBAF-4BE2-BB32-C7E58310C29B","title":"シーン 465","duration":5.4,"slideTitle":"第465スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、これまでたくさんの時間を勉学に使い、励んできたきたが、ここでは、それを違った形で要求されるようだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.465.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378787_文化系の部室（夕方）.jpg"},{"id":"20095BCA-6CF5-4548-8F9C-14CBC841042E","title":"シーン 466","duration":5.800000000000001,"slideTitle":"第466スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕たちは、それから話し合いを進めているうちに、すでに日が暮れ、夜になっていた。ふと時計を見ると、夜の6時過ぎだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.466.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"B603634F-2D54-4041-A24B-EF297CBAA00F","title":"シーン 467","duration":4.7,"slideTitle":"第467スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「それで、これで遠足のプランはバッチリですか？」\n私は、話の流れで、班長になり、皆にそう尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.467.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"15914833-115C-44AD-9F20-2F239AD87A4F","title":"シーン 468","duration":3.5,"slideTitle":"第468スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「僕は、このプランでいいと思います。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.468.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"5B6FB949-EB20-4693-A696-FF73D6169AAC","title":"シーン 469","duration":3.5,"slideTitle":"第469スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「私も、紅夢さんの意見に同感です。」\n制作ソフト及び協力\nGemini\nTohoStuido","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.469.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"1C904892-C2CE-493E-B783-51C7833B73AC","title":"シーン 470","duration":3.5,"slideTitle":"第470スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地こいし","telop":"「私も同じ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.470.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"D0B1906E-E0F9-4A43-9EE2-E907541F4A99","title":"シーン 471","duration":3.5,"slideTitle":"第471スライド","backgroundName":"ペーストされた画像.tiff","characterName":"アリス・マーガトロイド","telop":"「では、先に失礼しますね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"アリス・マーガトロイド","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.471.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/アリス（困り）.png"},{"id":"EBE1157E-3239-4E9C-801B-4D951E349D66","title":"シーン 472","duration":5.0,"slideTitle":"第472スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"アリスさんはそういうと、帰って行った。「この教室の戸締り…、僕がするので、二人は帰っていいですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.472.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"1C9F355A-90D4-4F6E-815D-8D2C73056BEE","title":"シーン 473","duration":3.5,"slideTitle":"第473スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「分かりました…、じゃあお先に失礼します…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.473.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"30B5033A-5AC6-4634-8675-146182D74DFA","title":"シーン 474","duration":5.9,"slideTitle":"第474スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、僕は、ただ一人残されたこの部屋で、息を吐く。そして、一度だけ深呼吸を済ますと、戸締りをして、家に帰るのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.474.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc378788_文化系の部室（夜・照明ON）.jpg"},{"id":"EECE82BB-1A59-4100-BFD5-8123F3C3795D","title":"シーン 475","duration":4.7,"slideTitle":"第475スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそれから、家に着くと、誰も家にいないことに気づく。\n「母さんと父さんはどうしたんだろう…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.475.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"9D5B25FF-6D39-4547-B952-D7A7A82ABF65","title":"シーン 476","duration":3.5,"slideTitle":"第476スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそう呟きながら、家の玄関を鍵を使って開ける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.476.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"CB57679D-8AA8-4A4C-B555-359855EE375A","title":"シーン 477","duration":3.5,"slideTitle":"第477スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、暗い玄関口に入ると、扉に鍵をかけて、自室に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.477.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"B122ECDD-9BCD-4993-8D66-0F9FF63EDBC1","title":"シーン 478","duration":4.6000000000000005,"slideTitle":"第478スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそれから、自室に入り、電気をつける。\nそして、荷物を下ろすと、そのままリビングに向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.478.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"CD5312FB-9C90-4C41-AB4F-903A073AEF29","title":"シーン 479","duration":5.7,"slideTitle":"第479スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、リビングに来ると、食卓の上に、メモ書きがあった。そこには、帰りが遅いから、一人で夕飯を済ますようにとあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.479.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"F530DC52-476F-44BE-B47F-6ABF7F166382","title":"シーン 480","duration":4.1000000000000005,"slideTitle":"第480スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、ふと冷蔵庫を開けて、中身を見る。\n中身は、朝見た通り、スカスカになっていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.480.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"81B6A9A6-277E-4AA8-8547-AF7C1516F8A2","title":"シーン 481","duration":4.9,"slideTitle":"第481スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、冷蔵庫の扉を閉めると、上の棚を開ける。\n普段なら常備しているインスタント食品もないようだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.481.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"CC369ADE-D8E3-4E0A-A4EE-16354C3914A1","title":"シーン 482","duration":3.5,"slideTitle":"第482スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、上の棚を閉めると、どうするか悩む。\nすると、インターホンが鳴る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.482.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"7860285F-829A-4391-AE96-7FBB46523F33","title":"シーン 483","duration":5.300000000000001,"slideTitle":"第483スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、玄関の電気をつけて、扉を開ける。すると、刀を携えた女性が、入ってくる。「あの、どんな用でしょうか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.483.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"6C3E89B9-2F36-40A7-8104-884A6FAE9C03","title":"シーン 484","duration":4.2,"slideTitle":"第484スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、彼女はある手帳を取り出し、見せる。\nそこには、警察の紋章があった。「えっと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.484.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"3A551DA4-8EC3-49C9-8062-4C71C554834A","title":"シーン 485","duration":4.3,"slideTitle":"第485スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「私は、武蔵警察署の魂魄妖夢と申します。\n実は、急用でお伺いしたいことがございまして…」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.485.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"A15A99DB-4011-41A0-94DE-0E54A9A06AFB","title":"シーン 486","duration":4.4,"slideTitle":"第486スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女はそう言いながら、ある写真を見せる。\nそれは…、母の友人である魔理沙さんの写真だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.486.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"5E667BF7-1792-4A48-A2CA-44EDB7EEFCC0","title":"シーン 487","duration":3.5,"slideTitle":"第487スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「この人物をご存知ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.487.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"FA122D51-9F79-4E18-9B52-530E8AA5D6A7","title":"シーン 488","duration":3.5,"slideTitle":"第488スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ええ、母の友人ですが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.488.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"844F9912-72F4-40D5-901E-E96BBADA6A2D","title":"シーン 489","duration":3.5,"slideTitle":"第489スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「あなたの母親の名前を伺ってもよろしいでしょうか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.489.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"E169B619-0A19-421D-8C6E-BB4593DC6903","title":"シーン 490","duration":3.5,"slideTitle":"第490スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「博麗霊夢です…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.490.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"FD3A2DE0-E442-48A5-BBFC-FBB2B897B03E","title":"シーン 491","duration":4.0,"slideTitle":"第491スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「そうですか、今朝、あなたが母親の様子を\n見ていて気がかりなことはありましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.491.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"71305E78-E024-48E9-9D20-02BCABB64AF3","title":"シーン 492","duration":3.5,"slideTitle":"第492スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、彼女にそう言われ、今朝のことを思い出す…","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.492.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"B54B0A22-F49E-4088-8584-4FE9142560D1","title":"シーン 493","duration":3.5,"slideTitle":"第493スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"「どうしたの、母さん、そんな顔して。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.493.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"48D49B4F-DEB6-4E4C-8A65-D6B2B06A43F3","title":"シーン 494","duration":5.5,"slideTitle":"第494スライド","backgroundName":"リビング（日中）.jpg","characterName":"博麗霊夢","telop":"「さっき、テレビで真夜中に、ふらふら赤信号で道路を横断する魔理沙を、彼が歩道に引き戻したニュースが流れてね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.494.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"D98A21B3-A888-4E8F-8D1A-F52203394037","title":"シーン 495","duration":5.300000000000001,"slideTitle":"第495スライド","backgroundName":"リビング（日中）.jpg","characterName":"操夢","telop":"「もし、気になるなら、魔理沙さんの家に行ってきなよ。僕が、後片付けとか、全部済ましてから、出かけるから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.495.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/j.png"},{"id":"6F708CD5-E407-4766-AC9B-7E8C102A7923","title":"シーン 496","duration":3.5,"slideTitle":"第496スライド","backgroundName":"リビング（日中）.jpg","characterName":"博麗霊夢","telop":"「それじゃあ、行ってくるわ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.496.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/リビング（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"5A403F6E-A3A6-40B7-9EAF-E0D5E94B6FCE","title":"シーン 497","duration":5.5,"slideTitle":"第497スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「今朝、テレビで母が、友人が赤信号を横断していたというニュースを見ていて、不安だから見てくると言ってました…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.497.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"BBA4CF21-6149-4119-A83E-E89B89B16E4C","title":"シーン 498","duration":3.5,"slideTitle":"第498スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「ほう…そうでしたか。それ以外には何かありましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.498.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"3776ABBE-D8B3-41D6-823F-38821EEB0E53","title":"シーン 499","duration":3.5,"slideTitle":"第499スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「あとは、帰りが遅くなると書かれたメモ書きくらいしか…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.499.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"7991848F-C112-446F-9C61-C7717EAB082F","title":"シーン 500","duration":3.5,"slideTitle":"第500スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「そうですか。それで、あなたの父親はどんな様子でしたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.500.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"7F00187F-E4BF-420D-9468-34712D89AC11","title":"シーン 501","duration":3.5,"slideTitle":"第501スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「父は、僕が起きた時には、すでにいませんでした。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.501.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"CD9662B0-A75C-4319-B63D-D67651CD9AEA","title":"シーン 502","duration":3.5,"slideTitle":"第502スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「そうですか…。承知しました。\nそれで、何かご要望はありますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.502.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"E149E994-4CB3-48E5-B671-7856B4470795","title":"シーン 503","duration":3.5,"slideTitle":"第503スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「要望ですか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.503.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"8D9BEFD5-DB6C-4F6A-8C56-7CB22292125C","title":"シーン 504","duration":4.9,"slideTitle":"第504スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「ええ、私について来てくださるのなら、署にいるあなたの母親と話すこともできますが？どうしますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.504.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"7A1D5999-4FE5-405C-93A5-FBC97A071553","title":"シーン 505","duration":3.5,"slideTitle":"第505スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「いえ…大丈夫です…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.505.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"2F4C2670-7CE3-4EEF-A865-C4A1859D250B","title":"シーン 506","duration":3.5,"slideTitle":"第506スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「それと、最後に一つだけ、お伺いしてもよろしいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.506.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"FEE6B237-5FE1-4520-8C58-56DDCAD9F969","title":"シーン 507","duration":3.5,"slideTitle":"第507スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「どんなことですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.507.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"D64574BD-B267-41ED-8C24-CA1AC8F6E815","title":"シーン 508","duration":3.5,"slideTitle":"第508スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「あなたは、魔理沙さんのここ\n最近の様子について知ってますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.508.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"DDBEE571-1C1B-46A0-9F77-35D9F002133C","title":"シーン 509","duration":3.5,"slideTitle":"第509スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…、特にはないです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.509.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"19065806-85B3-4C48-AB5A-A1726D5FA33D","title":"シーン 510","duration":4.800000000000001,"slideTitle":"第510スライド","backgroundName":"ペーストされた画像.tiff","characterName":"魂魄妖夢","telop":"「承知しました。突如の訪問にご対応いただきありがとうございました。これにて、私は失礼致します。」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.510.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"ACADB87C-CB63-4128-82A4-B37272AB8FC9","title":"シーン 511","duration":3.5,"slideTitle":"第511スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女はそういうと、去っていった。\n僕は、ひとまず、リビングに戻る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.511.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"9B68EBE5-A403-4DBB-B56A-1E1E09F6357B","title":"シーン 512","duration":4.3,"slideTitle":"第512スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、食卓に座るとテレビをつける。\n僕は、その映像を見ているうちに、全身に痛みが走る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.512.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"04D4D47B-C626-4AA9-9DB8-C199F7BAACC9","title":"シーン 513","duration":5.4,"slideTitle":"第513スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"そこには、ある女性が、街中にビームを撃ちまくる映像と、彼女との戦いに負けたのか、警察署で休む母が映っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.513.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"EE43FA45-72DA-41E0-A253-0C2DBF4281B7","title":"シーン 514","duration":5.7,"slideTitle":"第514スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"今、テレビで流れている映像を見ると、父とその女性が戦っている様子が流れていたが、父はビームを避けているだけだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.514.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"AC58C529-97EF-4B08-ACB9-3A7666C78523","title":"シーン 515","duration":5.0,"slideTitle":"第515スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"きっと彼が、この映像をしっかりと目に焼き付ければ、冷静に考えて、母が映っていた警察署に向かうだろう。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.515.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"034BA421-A64B-463A-B76D-375402EA1EE1","title":"シーン 516","duration":5.4,"slideTitle":"第516スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"「私は、どうすればいいのかな…」っと、そう呟きながら、ある覚悟を決め、準備を済ませると、その場所に向かった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.516.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"10BB240D-8DFF-40AE-A56A-B3F359D5882F","title":"その頃、ある場所では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.517.jpeg","animationDuration":1.5},{"id":"7B307C6C-25B7-417B-9BA7-D7B55A439C15","title":"シーン 518","duration":5.7,"slideTitle":"第518スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私は、ふと部屋にある小さなテレビを見ていると、とある街中の生中継映像が流れた。私は、思わず、その映像に目を見張る。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.518.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"8B038B59-79EA-408D-813A-19D475ED3701","title":"シーン 519","duration":5.5,"slideTitle":"第519スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"その映像は、ビームを撃ち続ける女性と、それを避ける男性の様子が映されていた。そして、私は、ふと画面を注視する。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.519.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"5592D146-241A-4444-A3C9-A03CAAA29F0F","title":"シーン 520","duration":5.5,"slideTitle":"第520スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"すると、一瞬だけ、どこかの警察署内で休んでいる巫女が映っていた。私は、そこでハッとし、お姉様の元に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.520.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"4FAEB362-90E3-4949-B271-2B7AA5335142","title":"シーン 521","duration":3.5,"slideTitle":"第521スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「お姉様！」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.521.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"13AC9E8C-E14D-4F9A-B40B-64057E7EA730","title":"シーン 522","duration":3.6,"slideTitle":"第522スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「どうしたのよ、フラン。そんな驚いた表情をして。」\n私は、そう妹に尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.522.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"40A11941-5ACB-491B-B218-4C71AE869100","title":"シーン 523","duration":4.3,"slideTitle":"第523スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"すると、彼女は衝撃的な内容を語りだす。\n私は、その内容を聞くと、ある人物に電話をかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.523.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"72D13F51-D993-4E63-93AE-4A929B97E499","title":"シーン 524","duration":5.300000000000001,"slideTitle":"第524スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"私は、職員室で作業をしていると、突如として電話が鳴る。\n私は、鳴り響く電話の受話器を取るとある声が聞こえた。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.524.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"17B79F0D-0D52-4C7D-9685-5CBCCAA961E0","title":"シーン 525","duration":4.3,"slideTitle":"第525スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"「お嬢様、その慌てた口調、何かあったんですか？」\n私は、その電話の声…レミリアに尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.525.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"B1A02596-B197-4DC9-8692-1526BBADC15B","title":"シーン 526","duration":3.5,"slideTitle":"第526スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「咲夜、今すぐテレビをつけなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.526.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"4F05CD3D-8B36-4AE1-87C0-E248AF784493","title":"シーン 527","duration":5.800000000000001,"slideTitle":"第527スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"私は、お嬢様にそう言われ、テレビをつける。すると、そこには衝撃的な映像が流れていた。「これは、どういうことですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.527.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"144BF874-1E54-4DA4-AC34-C3DD78669374","title":"シーン 528","duration":5.6000000000000005,"slideTitle":"第528スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「説明している時間は、ないわ。とにかく、その場所に、誰かを急行させて、騒ぎを鎮静化させなさい。そうじゃないと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.528.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"1CD66CC4-E204-4D20-8DE5-D77B03143357","title":"シーン 529","duration":3.5,"slideTitle":"第529スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"私は、お嬢様からの命令を聞き、\n電話を終えると、ある部屋に電話をかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.529.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"4880BBDA-797C-4AB5-89C9-B2792DB6E412","title":"シーン 530","duration":3.5,"slideTitle":"第530スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"「もしもし、こんな時間に電話をかけて、どうしたんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.530.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"2AA03A07-5AA5-4B06-8B70-5F30F3BAF7E5","title":"シーン 531","duration":3.5,"slideTitle":"第531スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"私は、そう聞く彼女に、お嬢様からの電話の内容を伝える。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.531.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"BA288C55-58B5-4DE0-A0E7-70EA7264811C","title":"シーン 532","duration":3.5,"slideTitle":"第532スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"「そうですか…、分かりました。」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.532.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"0C3B53C7-BAD2-4892-9209-AE33B9338B64","title":"シーン 533","duration":3.5,"slideTitle":"第533スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"私は、電話が切れると、お嬢様の家電にかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.533.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"D8E49C05-EF47-4579-8320-155CCB5F1C08","title":"シーン 534","duration":5.0,"slideTitle":"第534スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"私は、咲夜との通話を終えると、フランにいう。\n「フラン、今すぐに彼が今どこにいるか、探して来なさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.534.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"8AA54D7D-2FD2-4970-848E-C324A836E309","title":"シーン 535","duration":3.5,"slideTitle":"第535スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「分かった。じゃあ、彼を探してくるね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.535.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"C41B6BEB-6F97-4C15-BD3F-4251F8B2884B","title":"シーン 536","duration":5.4,"slideTitle":"第536スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「フラン、しっかりと彼を見つけ出して、守って見せなさい、彼がその場所で倒れる前に、いいとこ見せて来なさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.536.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"2F5E3850-F493-4F27-B078-9F1948AD6574","title":"シーン 537","duration":3.5,"slideTitle":"第537スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「うん、わかった！」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.537.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"3FE0E29E-9DBC-4635-BC31-513E93EEFD56","title":"シーン 538","duration":5.7,"slideTitle":"第538スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"フランが、そう言って去ると、私は「はぁ」とため息をつく。\nそして、同時に、これがきっかけで二人が…と考えるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.538.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"96570882-1B94-4D0B-8E6B-779E7525FE6C","title":"シーン 539","duration":5.5,"slideTitle":"第539スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"私が、テレビに映っていた場所に来ると、そこでは、彼女が箒に跨って空を飛び回りながら、ビームを周囲に放っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.539.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"E7034F3A-334F-428F-92A1-B960A00DB329","title":"シーン 540","duration":4.4,"slideTitle":"第540スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"そして、ふと周りを見ると、父が困惑しながら、\nひたすらにそのビームを避けている様子だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.540.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"1AAF4F12-0473-47C4-8B12-CC1B390CE8ED","title":"シーン 541","duration":5.7,"slideTitle":"第541スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"すると、ふと空腹を体が訴えてくる。今ここで、夕飯を食べて仕舞えば、きっと彼が戻ってくる。そうはさせたくはなかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.541.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"30C8E9DD-B6AA-4776-B654-D4F9DA1E7FBB","title":"シーン 542","duration":3.5,"slideTitle":"第542スライド","backgroundName":"ペーストされた画像.tiff","characterName":"サブ","telop":"だが、空腹に抗えるわけでもなく、私はある飲食店に入った。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.542.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"801FF784-0D95-4E46-AA1D-ABB5ADCACCB0","title":"シーン 543","duration":5.6000000000000005,"slideTitle":"第543スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「んっ…」僕は、ふと気がつくと、そこは夜の街中だった。\nそして、ふと周りを見渡していると、魔理沙さんと父が見える。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.543.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"5F34FB60-D819-42CC-A3CC-608205A07F6C","title":"シーン 544","duration":5.6000000000000005,"slideTitle":"第544スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"ふともう一度見ると、魔理沙さんはビームを父やビルに向かって乱射するように放ち、父はそれを困った表情で避けていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.544.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"1B925D4C-3974-44EB-B71C-20769F14ECB2","title":"シーン 545","duration":5.7,"slideTitle":"第545スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、後ろから僕の肩が叩かれる。その方向に振り向くと、この前、夜の学校の廊下で会った女性だった。「こんばんは。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.545.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"0E69229E-0EFB-429C-8785-79D9030BEFFA","title":"シーン 546","duration":3.5,"slideTitle":"第546スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「こんばんは。こんなところで、どうしたの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.546.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"10A77525-1050-454E-B058-6D1882AB2196","title":"シーン 547","duration":5.5,"slideTitle":"第547スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…」僕はそう言い、なぜ自分がこんな場所に来たかを思い出そうとするが、思い出せない。「分からないです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.547.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"1FF46E35-7437-4BA8-85DF-1093CB1CA88D","title":"シーン 548","duration":3.5,"slideTitle":"第548スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「そう、それより、あなたは、これから、何かの予定はある？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.548.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"90CA0A04-3C00-4A08-AB48-5C42CA6C3746","title":"シーン 549","duration":3.5,"slideTitle":"第549スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…ないです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.549.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"1BDF9112-8E0D-4D96-8515-6413D5E2CF25","title":"シーン 550","duration":3.5,"slideTitle":"第550スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「そう、なら私と一緒に、夜の街を歩いてみない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.550.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"0D378A8D-0C19-4E60-A6C4-C0519F77C4B8","title":"シーン 551","duration":5.0,"slideTitle":"第551スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…」僕は、彼女からの誘いに、どう返そうか考えていると、誰かがビルに激突し、僕はその方を見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.551.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"0D729553-8699-4697-83B5-A4B2E522A468","title":"シーン 552","duration":5.9,"slideTitle":"第552スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"「痛てぇ…、ついよそ見をしちまったぜ…」私は、彼女からのビームが来ているのにも関わらず、逆ナンを受けている息子を見た。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.552.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（弱る）.png"},{"id":"51B39045-DD43-40E3-902C-9C999BCA64ED","title":"シーン 553","duration":3.5,"slideTitle":"第553スライド","backgroundName":"ペーストされた画像.tiff","characterName":"霧雨魔理沙","telop":"「二ヒヒィ、まだまだ足りないぜ…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.553.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"63716F3B-EB59-482E-A976-242059A56F55","title":"シーン 554","duration":4.7,"slideTitle":"第554スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"「くっ…」私には、息子にサインを送る余裕もなく、\n彼女からやってくるビームを再び、避け始めた。」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.554.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペース