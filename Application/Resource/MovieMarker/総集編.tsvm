se,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1248.jpeg","id":"2B129BA8-B93D-4313-9715-FC589F96DEF8","slideTitle":"第1248スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","telop":"「ええ、条件に見合った部屋が、ここしかなかったので…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1249","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1249.jpeg","id":"38F8195F-3B49-4EB4-95C8-19EC382EA2D6","slideTitle":"第1249スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","telop":"「そうですか…。それならいいんですけど…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 1250","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1250.jpeg","id":"C94C7A40-1837-4836-8389-8CFABB94551B","slideTitle":"第1250スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","telop":"「それより、アリスさんの入力が終わったら、こいしさんを目覚めさせてください…」僕は、そう言いながら、こいしを見る。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1251","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1251.jpeg","id":"9ADE9FC6-8C89-4B55-8B2A-9CB61FB36A59","slideTitle":"第1251スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/寝落ち寸前.png","telop":"そこには、寝落ち寸前のような表情で、こくこくと頭が動いているこいしの姿があった。「今寝ちゃうと、夜眠れませんから…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1252","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1252.jpeg","id":"F504901A-257F-4D7E-87AB-32DF05E043D5","slideTitle":"第1252スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","telop":"「分かりました…」私と彼がそう話していると、浴室の扉が開く。そして、妹を起こし、入浴に向かわせた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 1253","animationName":"なし","duration":4.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1253.jpeg","id":"89F42D63-F707-400C-A53A-62C80E75D619","slideTitle":"第1253スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"私は、入浴が終わると、ポケベルに着信があったことに気がつく。そして、さとりと彼の了承を得ると電話に出る。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"title":"シーン 1254","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1254.jpeg","id":"AA5D8E7E-D702-4AEC-99E9-60402B810AC0","slideTitle":"第1254スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「もしもし、どうしたんですか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"title":"シーン 1255","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1255.jpeg","id":"F9AB7326-2203-4525-976A-C61BFF55447F","slideTitle":"第1255スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「あんたたち一体、遠足で何をしてるの？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 1256","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1256.jpeg","id":"89BDB03B-960A-44E2-9CD1-BA04DFD49C5C","slideTitle":"第1256スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「えっ？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"title":"シーン 1257","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1257.jpeg","id":"D6C71D7F-40EB-4C09-BFB6-E0F180FBA8E6","slideTitle":"第1257スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"僕は、彼女が困惑しているのを見て、目線で電話口を変わったほうがいいか、確認する。すると、彼女はポケベルを僕に渡す。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1258","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1258.jpeg","id":"C6F91892-5287-450A-93D8-C937F12A37AB","slideTitle":"第1258スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「もしもし、紅夢です…、どうしましたか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1259","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1259.jpeg","id":"7BFBE7D6-86D5-417C-BCF3-1A2425F45045","slideTitle":"第1259スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「美鈴から聞いたわよ、あんたが居候している家に送ったデビットカードから、短時間で5件の入出金があったみたいじゃない。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 1260","animationName":"なし","duration":5.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1260.jpeg","id":"6FB15DC0-AD5A-4370-8699-9E4ED4ED7C74","slideTitle":"第1260スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「それで、あんたたちは、これからどうするのよ？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 1261","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1261.jpeg","id":"5D745DF6-DEA8-4F72-80F4-C71A0FBE2D24","slideTitle":"第1261スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「あれ…パチュリーさんは、知らないんですか…、例のデビットカードが送られたとき、一緒に手紙が入っていたことを…？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1262","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1262.jpeg","id":"8303749C-29DE-4AE6-BA2B-901147F5EA9B","slideTitle":"第1262スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「えっ？何よ手紙って…？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 1263","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1263.jpeg","id":"033A1338-4E5E-4997-ADC2-C89B026FF33F","slideTitle":"第1263スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"僕は、そう彼女に聞かれ、デビットカードともに入っていた手紙というか、遠足後の試験に関する詳細を彼女に伝える。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1264","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1264.jpeg","id":"11B54109-86C7-4BCE-BA67-A6B57406DFF8","slideTitle":"第1264スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「それで、それは誰が今持ってるの？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 1265","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1265.jpeg","id":"E48F3CEE-A36D-47DE-8C10-36DB5044439D","slideTitle":"第1265スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「僕のバックの中に入ってますよ。それに、その封筒の差出人は、学園長の名義で、ちょうど都合もいいので…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1266","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1266.jpeg","id":"9527066A-A7A0-49F0-9B77-FCB93B2E55BB","slideTitle":"第1266スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「分かったわ、だけど覚悟してね…、お金は大事に使うのよ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 1267","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1267.jpeg","id":"498085FE-4AC2-4F37-AC4E-44C5246B61E9","slideTitle":"第1267スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"彼女は、そう言うと、電話を切った。「終わりましたよ…、\nきっとこれで、説教電話はこないと…思います…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1268","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/76A7C805-E348-58FD-AF88-6D354533D371.jpg","backgroundName":"76A7C805-E348-58FD-AF88-6D354533D371.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1268.jpeg","id":"0E64198B-411F-4052-9C91-8F2E9559BD79","slideTitle":"第1268スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「あっ…ありがとう…」\n私は、そう辿々しく言うと、彼からポケベルを受け取った。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterNam