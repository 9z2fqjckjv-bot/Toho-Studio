/Slide_097_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.097.jpeg","id":"C63CA681-15A1-4EA1-9C20-3539CD99FC2C","slideTitle":"第97スライド"},{"audioTrack":"track_voice_soumu","telop":"すると彼女は、校庭に出てくる。\n「あの僕は…何をこれからするんですか…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.456077097505668,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 98","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_098_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.098.jpeg","id":"1B2CCCC4-5887-470F-90C9-07C9973C36A5","slideTitle":"第98スライド"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「1500m走だよ。\n準備体操を済ませたら、私に声をかけなさい。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":9.013242630385488,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 99","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_099_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.099.jpeg","id":"FDBD5249-163D-4301-A8D1-16F6A8680CD2","slideTitle":"第99スライド"},{"audioTrack":"track_voice_soumu","telop":"「分かりました…」僕は、とりあえずそう返し、準備体操をする。\nそして、それが終わると、言われた通りに声をかける。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":7.7017233560090705,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 100","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_100_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.100.jpeg","id":"F9256AB1-D6FD-44B9-B6D2-07A3697A9E33","slideTitle":"第100スライド"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「それじゃあ、今から時間測るから、走ってみなさい。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":2.3244897959183675,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 101","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1014_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.101.jpeg","id":"9090ABE1-054A-4FF4-8DC3-A38529D0338E","slideTitle":"第101スライド"},{"audioTrack":"track_voice_soumu","telop":"「はい…」僕はそう言うと、\n校庭に引かれた線に沿って、走り始める。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":5.967596371882086,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 102","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1023_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.102.jpeg","id":"79400FC4-84BF-4269-97FD-B8B03CCEE894","slideTitle":"第102スライド"},{"telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"彼が1500m走を完走すると…","animationName":"なし","duration":2.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.103.jpeg","id":"C3022370-4E27-4863-9331-01D9A82C0E19","slideTitle":"中扉"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「君、そこら辺の女子よりも、足が遅いんじゃないか？」\n私は、手元の腕時計を見ながら言う、あれから10分がたった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":8.15281179138322,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 104","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1040_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.104.jpeg","id":"05BEEF91-3C59-4227-9E12-2AA67BB4CDC8","slideTitle":"第104スライド"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「これだと、女子相手に情けない男になるぞ、どうだ、もう一走りして、今度は…8分目安にするのはどうだ？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":5.575986394557823,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 105","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_105_十六夜咲夜.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.105.jpeg","id":"34A978D7-B0AE-4A28-89ED-80388AE9C8AF","slideTitle":"第105スライド"},{"audioTrack":"track_voice_soumu","telop":"「じゃあ、もう一走りしますか…」僕は、彼女の理屈が通っているように感じ、何らかのプライドが刺激されたか、そう呟く。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.344126984126984,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 106","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_106_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.106.jpeg","id":"8BACFE2E-715D-412F-B1DF-CCAC1F87E39E","slideTitle":"第106スライド"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「そうだ、その意気込みで、8分切れるように走ってみなさい。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":7.754489795918367,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 107","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1074_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.107.jpeg","id":"D4B2B99A-F6BD-4A87-84EF-A4C1BED58AC3","slideTitle":"第107スライド"},{"audioTrack":"track_voice_soumu","telop":"僕は彼女にそう言われると、再び走り始める。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":9.364761904761904,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 108","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_108_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.108.jpeg","id":"463B3B66-00A9-49A1-BC17-440BDCDD5A68","slideTitle":"第108スライド"},{"telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"彼がもう一走りをすると…","animationName":"なし","duration":2.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.109.jpeg","id":"1616AD46-BBA1-436B-A824-D34B1439C1EF","slideTitle":"中扉"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「さっきよりは良くなったか…」\n私は、手元の腕時計を見る。あれから9分弱が経っていた。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":8.461995464852608,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 110","animationName":"なし","duration":4.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1103_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.110.jpeg","id":"660DE83B-D17A-470E-A361-C864F68FC6BC","slideTitle":"第110スライド"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「とりあえず、これで今日はおしまいにしよう、今度の体育では、同じトラックで女子と競争になるから、覚悟するのだぞ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第４話\/美鈴（困る）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":6.959478458049887,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 111","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1117_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.111.jpeg","id":"122CDC6E-4088-47F4-816E-49E378CD4684","slideTitle":"第111スライド"},{"audioTrack":"track_voice_soumu","telop":"彼女はそう言うと、そのまま何かを呟きながら、去っていった。\n僕は、その場でしゃがみ込んで、休みを取る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":2.5060770975056688,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 112","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_112_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.112.jpeg","id":"536B2071-9E48-46F7-BDEC-DB50B080BE5D","slideTitle":"第112スライド"},{"audioTrack":"track_voice_soumu","telop":"すると、走ってた時には感じなかった痛みが僕を襲う。\nどうやら、無理強いをしていたようだった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":3.1756462585034013,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 113","animationName":"なし","duration":4.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_113_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.113.jpeg","id":"3644452C-4154-44FA-9301-765A09D6C647","slideTitle":"第113スライド"},{"audioTrack":"track_voice_soumu","telop":"だが、彼女の言葉は事実を述べているだけなので、何もいえず、ただ一人、校庭で俯きながら、考え込む僕だった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":2.406077097505669,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 114","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_114_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.114.jpeg","id":"B9B6971D-C93E-4334-8254-86EA5F15C835","slideTitle":"第114スライド"},{"audioTrack":"track_voice_soumu","telop":"そして、立ちあがろうとしたその時、\n僕の全身がぐらつき、そのまま倒れ込むのだった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":1.3756462585034013,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 115","animationName":"なし","duration":4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_115_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.115.jpeg","id":"7794C957-3C33-420D-8C15-9D7A4E1C5AA7","slideTitle":"第115スライド"},{"audioTrack":"track_voice_soumu","telop":"「んっ…ここは…」僕はふと目が覚めると、そう呟く。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":2.423469387755102,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 116","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_116_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.116.jpeg","id":"F904D2FE-5A68-409E-87AA-7DC58E428EEF","slideTitle":"第116スライド"},{"audioTrack":"track_voice_marisa","telop":"「おや、目が覚めたかい…、紅夢君…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/霧雨魔理沙_通常.png","seStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","voiceDuration":10.094489795918367,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"霧雨魔理沙","bgmStartTimeOffset":0,"title":"シーン 117","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1179_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.117.jpeg","id":"4719812C-2A19-4C78-8522-F8CC05020F97","slideTitle":"第117スライド"},{"audioTrack":"track_voice_soumu","telop":"「あなたは…魔理沙さんですか…母の友達の…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/箒あり困った笑み.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":15.811995464852608,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 118","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1185_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.118.jpeg","id":"368F2B3F-7DDD-49AE-8475-0D24C39E24F4","slideTitle":"第118スライド"},{"audioTrack":"track_voice_marisa","telop":"「ああ…そうだ…。それより…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/霧雨魔理沙_通常.png","seStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","voiceDuration":9.686984126984127,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"霧雨魔理沙","bgmStartTimeOffset":0,"title":"シーン 119","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1191_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.119.jpeg","id":"1F984BB9-8DAC-4BC7-8D9D-03936904A666","slideTitle":"第119スライド"},{"audioTrack":"track_voice_soumu","telop":"「何か、言いたいことでもあるのですか？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/箒あり困った笑み.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":4.971292517006803,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 120","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_120_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.120.jpeg","id":"50C41C4A-CDF0-4297-8482-9003738CD1A3","slideTitle":"第120スライド"},{"audioTrack":"track_voice_marisa","telop":"「お前の祖母さんが、困ってたぞ、私の孫が云々…って」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/霧雨魔理沙_通常.png","seStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","voiceDuration":1.9144897959183673,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"霧雨魔理沙","bgmStartTimeOffset":0,"title":"シーン 121","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1210_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.121.jpeg","id":"B3F57A4D-8CE2-457F-9081-0C119CC1A945","slideTitle":"第121スライド"},{"audioTrack":"track_voice_soumu","telop":"「それだけ…ですか？」\n僕は、彼女の言葉には、裏がある気がして、そう尋ねる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/箒あり困った笑み.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.510430839002268,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 122","animationName":"なし","duration":3.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_122_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.122.jpeg","id":"8CB012C8-A0E0-4D11-848A-34EC7FF69C47","slideTitle":"第122スライド"},{"audioTrack":"track_voice_marisa","telop":"「じゃあ、霊夢にお前が起きたこと言って、帰るから、あとは母親のいうことでも聞いてけ…よ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/霧雨魔理沙_通常.png","seStartTimeOffset":0,"voiceCharacter":"霧雨魔理沙","voiceDuration":3.4194784580498867,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"霧雨魔理沙","bgmStartTimeOffset":0,"title":"シーン 123","animationName":"なし","duration":4.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1231_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.123.jpeg","id":"681F1E59-FF52-4736-A20A-29020B75AF0D","slideTitle":"第123スライド"},{"audioTrack":"track_voice_soumu","telop":"そういうと、彼女は部屋から去っていった。\n「一体、何を考えているのだろう…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":1.8746031746031746,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 124","animationName":"なし","duration":3.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1249_八雲紫.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.124.jpeg","id":"A8ECB2AB-A7BC-4A9C-BA82-123B6D9E7ED5","slideTitle":"第124スライド"},{"audioTrack":"track_voice_soumu","telop":"そして、それから数分程度で霊夢が部屋に入ってくる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":5.813673469387755,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 125","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1259_八雲紫.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.125.jpeg","id":"F1545D19-7028-4F79-B054-FA1C6AA39823","slideTitle":"第125スライド"},{"audioTrack":"track_voice_reimu","telop":"「あんたね…無理なことは無理ですって、ちゃんと言いなさいよ…。たとえ、難しくてもね…。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","voiceDuration":8.666984126984127,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 126","animationName":"なし","duration":4.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1269_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.126.jpeg","id":"2074D962-1F77-40C5-B12E-9A4E7BF82EE5","slideTitle":"第126スライド"},{"audioTrack":"track_voice_soumu","telop":"「…まだ、そこまで回復は出来てないよ…母さん…」\n僕は、小さな声でそう返し、窓を見る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":6.762607709750567,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 127","animationName":"なし","duration":4.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_127_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.127.jpeg","id":"124F0EA4-CC50-4F82-9B6A-3DFF5C59D568","slideTitle":"第127スライド"},{"audioTrack":"track_voice_reimu","telop":"「それに…最近…魔理沙の様子が変なのよね…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","voiceDuration":1.996984126984127,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 128","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1280_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.128.jpeg","id":"9BCA0369-38FE-4B56-94B6-75091BFE9876","slideTitle":"第128スライド"},{"audioTrack":"track_voice_soumu","telop":"「母さんの言うとおりだよ。様子がどこかおかしい…、まるで隠し事をしているかのように…感じる。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/バトルっぽい頬照り余裕.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":6.9321541950113374,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 129","animationName":"なし","duration":4.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1298_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.129.jpeg","id":"93515A1B-5241-4566-B820-439598B77F7F","slideTitle":"第129スライド"},{"audioTrack":"track_voice_reimu","telop":"「まぁ、ゴダゴダいっても仕方ないわね。今晩は念の為に、病室で過ごして、翌日検査するみたいだから、しっかりするのよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/告知\/霊夢（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","voiceDuration":2.961995464852608,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 130","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1307_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.130.jpeg","id":"7F5625D5-552E-4A78-A1D4-50FCABB5F1DB","slideTitle":"第130スライド"},{"audioTrack":"track_voice_soumu","telop":"彼女はそういうと、そのまま病室を去った。\nよくよく考えれば、ここは学校の附属病院だった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":0.8930385487528345,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 131","animationName":"なし","duration":4.3,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1310_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.131.jpeg","id":"358CF4EB-309A-4721-B130-DF0A90F5266C","slideTitle":"第131スライド"},{"audioTrack":"track_voice_soumu","telop":"僕は、そのまま窓を眺めていると、眠たくなり、目を閉じた。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":3.4712925170068027,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 132","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc256897_病室-夕方-電気あり.png","backgroundName":"nc256897_病室-夕方-電気あり.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1320_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.132.jpeg","id":"156D9154-9D97-4966-A5C1-8F9306F365D5","slideTitle":"第132スライド"},{"telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"附属病院のある診察室では…","animationName":"なし","duration":2.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.133.jpeg","id":"E64D6045-D97A-4B36-9EAC-A7F60BBB2EE1","slideTitle":"中扉"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","telop":"私は、ふと目の前のパソコンに表示されている、\nとある患者のカルテを見ていた。","seStartTimeOffset":0,"voiceCharacter":"永琳","voiceDuration":9.790861678004536,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 134","animationName":"なし","duration":3.7,"backgroundName":"単色背景","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1343_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.134.jpeg","id":"AA3FBE66-5A55-4253-B82E-EC68D4EC6E6E","slideTitle":"第134スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","telop":"患者の名前は「藤原紅夢」、彼は生まれてから、もう少しで16年になる。そして、彼の裏に潜む彼女は出てきて約3年がたつ。","seStartTimeOffset":0,"voiceCharacter":"永琳","voiceDuration":7.184489795918368,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 135","animationName":"なし","duration":5.800000000000001,"backgroundName":"単色背景","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1359_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.135.jpeg","id":"DD12586D-D50B-4C27-BBC2-3FD21BBD5E9C","slideTitle":"第135スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","telop":"私の孫にあたる彼は、通常なら片方に偏るはずの、\n性ホルモンが彼の場合、半分半分になっている。","seStartTimeOffset":0,"voiceCharacter":"永琳","voiceDuration":1.28,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 136","animationName":"なし","duration":4.5,"backgroundName":"単色背景","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_136_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.136.jpeg","id":"A521FC1C-5FDD-49D3-8643-FEA034AAEFCF","slideTitle":"第136スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","telop":"そして、彼にはほぼ機能していない臓器が2つある。もし、彼がこのまま20歳になれば、一生子どもを作れない体になってしまう。","seStartTimeOffset":0,"voiceCharacter":"永琳","voiceDuration":6.819773242630386,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 137","animationName":"なし","duration":6,"backgroundName":"単色背景","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1375_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.137.jpeg","id":"F085EEF0-D815-4596-B731-157FE35CF5EA","slideTitle":"第137スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","telop":"彼が、そんな複雑な構造になった理由…、それは、彼を担当していた前任の医師が語っていた。その原因は学校だと…","seStartTimeOffset":0,"voiceCharacter":"永琳","voiceDuration":5.463673469387755,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 138","animationName":"なし","duration":5.300000000000001,"backgroundName":"単色背景","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1386_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.138.jpeg","id":"433A4909-7871-4A65-AD47-E9486AAD69D5","slideTitle":"第138スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","audioTrack":"track_voice_%E6%B0%B8%E7%90%B3","telop":"すると、私の診察室を誰かがノックする。\n「どうぞ。」私は、その人物を診察室に入れさせる。","seStartTimeOffset":0,"voiceCharacter":"永琳","voiceDuration":8.058253968253968,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 139","animationName":"なし","duration":4.3,"backgroundName":"単色背景","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1396_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.139.jpeg","id":"BA9F26E8-0B44-44F9-9578-4DB1E043F932","slideTitle":"第139スライド"},{"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","telop":"「永琳さん、彼が元いた学校の詳細を調べました。」\n私はそういうと、調べた情報をまとめたノートを渡す。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/文（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"射命丸文","voiceDuration":6.677823129251701,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"射命丸文","bgmStartTimeOffset":0,"title":"シーン 140","animationName":"なし","duration":4.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","backgroundName":"nc232269_バー.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1400_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.140.jpeg","id":"FADB6E4A-CD8C-4513-BB23-D9FD8B4B089C","slideTitle":"第140スライド"},{"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","telop":"「どうやら、彼がいた前の学校は、この学園に匹敵するくらいの元男子校で、女子比率は1%未満、問題が山積みのようです。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/文（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"射命丸文","voiceDuration":8.609478458049887,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"射命丸文","bgmStartTimeOffset":0,"title":"シーン 141","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","backgroundName":"nc232269_バー.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_141_フランドール・スカーレット.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.141.jpeg","id":"B1854E04-F7E1-4C02-B506-65F2E61168A6","slideTitle":"第141スライド"},{"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","telop":"「永琳さんに言われて調べましたが、徹底した閉鎖空間のごくわずかな隙間から入手した情報なので、気をつけてください。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/文（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"射命丸文","voiceDuration":7.832154195011338,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"射命丸文","bgmStartTimeOffset":0,"title":"シーン 142","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","backgroundName":"nc232269_バー.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1428_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.142.jpeg","id":"3B4E9181-6FBE-4AD7-8E08-7C8F3E0C0077","slideTitle":"第142スライド"},{"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","telop":"「それと、息子さんの言ってたことは全て事実だそうですよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/文（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"射命丸文","voiceDuration":6.661995464852608,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"射命丸文","bgmStartTimeOffset":0,"title":"シーン 143","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第24話\/nc232269_バー.jpg","backgroundName":"nc232269_バー.jpeg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1435_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.143.jp