oice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.557.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン困り後ろ手.png"},{"id":"A77F27C9-DB5F-4C12-B7D0-8DC70612A349","title":"シーン 558","duration":6.5,"slideTitle":"第558スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、その彼女の表情を見ると、なんだか断るのは、申し訳なく感じてくる。「散歩とは違いますが…僕の用事に付き合ってくれませんか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.558.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン困り後ろ手.png"},{"id":"E624E633-438A-4A27-BB51-76FE7C625C89","title":"シーン 559","duration":3.5,"slideTitle":"第559スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「ありがとう！」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.559.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"3EF1E1A3-E2DB-448F-BE28-DA39D55B92E9","title":"シーン 560","duration":5.2,"slideTitle":"第560スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、そう彼女が笑うと、どこかで見たことのあるようなその表情に、過去を思い出しながら、一緒に歩き始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.560.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"8159CF47-D6C4-4C43-8B3F-00216B491C7A","title":"シーン 561","duration":5.300000000000001,"slideTitle":"第561スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"私が、その場所につき、そっと影から覗くと、一方の男女は戦い、もう一方の男女は一緒にどこかに歩き出していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.561.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"71732192-1181-4D4B-8352-E5F9595005DB","title":"シーン 562","duration":3.5,"slideTitle":"第562スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"「一体、何があったんでしょうか…」私は、そう呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.562.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（弱る）.png"},{"id":"72674D81-6C1D-4096-943F-D48D80BBFFAE","title":"シーン 563","duration":5.300000000000001,"slideTitle":"第563スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"だが、歩き出した二人の方は、あっという間に姿が消え、残ったのは、元学園生の霧雨魔理沙とある男性だけだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.563.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（弱る）.png"},{"id":"25CC0A73-888D-4E0A-A5F3-721AED1013DE","title":"歩き始めたフランと彼は…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.564.jpeg","animationDuration":1.5},{"id":"364A8C3C-45F3-4E81-87FF-D8490C73FCC9","title":"シーン 565","duration":5.1000000000000005,"slideTitle":"第565スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕とその女性、フランさんはあるスーパーに寄って行った。\n冷蔵庫がスカスカなために、買い出しにやって来た。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.565.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"0286CE48-CDDC-4C49-80C2-600DEC65C6B0","title":"シーン 566","duration":5.5,"slideTitle":"第566スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そういえば、フランさんって、過去に僕と会ってましたか？」\n僕は、過去の記憶を確かめるために、彼女にそう尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.566.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"4018D9C6-B559-4536-B628-68F8FECCFB5F","title":"シーン 567","duration":3.5,"slideTitle":"第567スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「さあ、どうだろうね。あなたは、思い出せるかしら…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.567.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"7C94F546-87DC-4E9B-A6FC-8B2C3A0646B1","title":"シーン 568","duration":5.2,"slideTitle":"第568スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、その彼女の表情を見て、僕がそれを思い出すまでは、答えなささそうなので、献立を考え、食材を見ていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.568.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"D29AE953-FC32-478B-AAA3-BADC6DD8FFF4","title":"シーン 569","duration":3.5,"slideTitle":"第569スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「フランさんは、夕飯はもう食べましたか？」\n僕はそう彼女に聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.569.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"781348F1-32B0-4C3D-969A-B2C0B9C43A55","title":"シーン 570","duration":3.5,"slideTitle":"第570スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「いや…まだ食べてないよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.570.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"FA181CFB-CE07-429D-87A0-C8EF7A207605","title":"シーン 571","duration":5.0,"slideTitle":"第571スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「何か、食べたい料理とかってありますか？僕は、親にガスコンロは危ないから使うなって言われてますが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.571.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"BE2C72C3-EDD8-4061-B0A6-DBA5ED74D5E1","title":"シーン 572","duration":3.5,"slideTitle":"第572スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「そう…、もしあれだったら、私も手伝うよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.572.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"1B556287-E653-4FFF-8C48-CB8FDAA10E98","title":"シーン 573","duration":3.5,"slideTitle":"第573スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですか…、何か食べたい物はありますか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.573.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"CD394625-A92F-4DE5-B1E2-D229A7859413","title":"シーン 574","duration":3.5,"slideTitle":"第574スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「どうしようかな…、あなたは何か得意な料理でもあるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.574.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"6FB5CCC0-DAB5-4B76-B733-D04F219DE5FE","title":"シーン 575","duration":4.800000000000001,"slideTitle":"第575スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「得意な料理ですか…、強いていえば、ガスコンロと包丁を使わない料理だったら、僕でもできますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.575.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"5DF066AA-B324-4D76-BCDD-955E07CB4899","title":"シーン 576","duration":3.5,"slideTitle":"第576スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「そう…、なら…リゾットはどう？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.576.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"2EE69263-F6A1-45CB-A52B-B616AB062A01","title":"シーン 577","duration":4.800000000000001,"slideTitle":"第577スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「リゾットですか…」僕はそう言いながら、献立を思いつく。\nそして、目的の食材がある売り場に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.577.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"4CB4F409-C012-44F0-A232-BE6B85BBCEAC","title":"シーン 578","duration":5.9,"slideTitle":"第578スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、サバ味噌煮缶とチーズ、パックご飯をカゴに入れて歩く。\nそして、去り際に、ふりかけが目に入り、それもカゴに入れる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.578.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"10ADBE10-6FEC-4AF1-B589-C1B477E6C0C2","title":"シーン 579","duration":5.0,"slideTitle":"第579スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、卵売り場に向かい、卵を手に取る。ふと、振り返ると、彼女の姿が見えなかった。僕は、彼女を探す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.579.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"AEA64834-5244-4AC8-9101-559840A5184E","title":"シーン 580","duration":5.1000000000000005,"slideTitle":"第580スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、彼女を探し、ワインの売り場に来ると、彼女はあるワインを見つめていた。「それ、飲みたいんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.580.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"B9021D16-0E69-4BB7-9C3B-AA8B81FA80F3","title":"シーン 581","duration":3.5,"slideTitle":"第581スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「なんだか、良さげなワイン見つけちゃって…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.581.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"E139EFDC-FDE9-4693-AF96-73AE7596E270","title":"シーン 582","duration":5.7,"slideTitle":"第582スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですか…」僕は、そう言い考える、ここでワインを買って行ってもいいが、母がそれ見たら、どんな反応をするかと…。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.582.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"88EBAA9F-71A3-42B2-A491-530DC7E862B0","title":"シーン 583","duration":3.8000000000000003,"slideTitle":"第583スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、数十秒、そう深く考えると、\nまぁいいかと括り、そのワインをカゴに入れた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.583.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"B7FDFCDE-C12D-410D-A3BC-B4C5435A6ACF","title":"シーン 584","duration":3.5,"slideTitle":"第584スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「ありがとう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.584.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"328DC190-C7DC-4B3C-AF97-C792DC66755B","title":"シーン 585","duration":3.5,"slideTitle":"第585スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「いえいえ。」僕はそう言い、彼女を見る。\nすると、ハッと過去を思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.585.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"2D8415EE-2585-40FE-B8FD-CEFDC6FB676E","title":"シーン 586","duration":5.800000000000001,"slideTitle":"第586スライド","backgroundName":"459934D7-5BEE-51E6-B535-0BD9971501AE.jpg","characterName":"操夢","telop":"それは、今から10年ほど前の、ある劇の発表日だった。その日は、参観日だったが、周りの同級生と違い、両親は来なかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.586.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/459934D7-5BEE-51E6-B535-0BD9971501AE.jpg"},{"id":"C90A8254-24A8-4DDB-83EE-EEEB4E267B79","title":"シーン 587","duration":5.6000000000000005,"slideTitle":"第587スライド","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterName":"操夢","telop":"僕は、その発表をつまらなく感じ、ぼっと席を立ち、当時の先生、初恋であった彼女…フランを一瞬見て、教室を飛び出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.587.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"BF06BDF3-D03A-4D12-9103-5959570833C8","title":"シーン 588","duration":5.4,"slideTitle":"第588スライド","backgroundName":"3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterName":"操夢","telop":"そして、彼女にある告白をする。その当時は、単に「ありがとう。」と返される程度だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.588.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/3BE7CBEF-8EBA-560D-860E-0F8F686E7F08.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"B35D369A-46FF-4AE9-9D65-C32EE82CAF4E","title":"シーン 589","duration":3.5,"slideTitle":"第589スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「あれから、10年ちょっとなんですね…」\n僕はそうぼさっと呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.589.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"D665C6FA-91B2-4201-96A7-6A88BEC4A105","title":"シーン 590","duration":3.5,"slideTitle":"第590スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、彼女は驚きの表情を見せる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.590.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"DC60B501-D302-4A0F-9799-A6A34174A533","title":"シーン 591","duration":3.5,"slideTitle":"第591スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「ようやく思い出せたか…、それで、今でも…はあるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.591.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"55BB6275-D52A-4010-B498-ED8E708B6EC7","title":"シーン 592","duration":5.800000000000001,"slideTitle":"第592スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、そう彼女に聞かれ、一瞬迷う。彼女に初恋してからは、ずっと男子だけに囲まれて育ったので、別の恋をしていなかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.592.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"EA8B9D9D-615D-4AC5-8C6E-2619607A3C7C","title":"シーン 593","duration":4.4,"slideTitle":"第593スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ええ、変わってませんよ…。」\n僕は、少し恥ずかしさを覚えながら、そう彼女に返すのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.593.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"8CA4DB47-5AC8-4B34-A6AC-D7B55D2C0069","title":"その頃、妹紅と魔理沙は…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.594.jpeg","animationDuration":1.5},{"id":"4820FA5F-F617-4C60-B2F7-5175641D6B4C","title":"シーン 595","duration":5.5,"slideTitle":"第595スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"私は、一瞬の隙があれから、時々でき、その度に彼女のビームの餌食になっていた。いつの間にか、息も切れかけている。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.595.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"52B963CE-2A95-4B7A-906C-26E2E7F70E4B","title":"シーン 596","duration":5.300000000000001,"slideTitle":"第596スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"あと数発のビームを喰らえば、倒れ込むのは確実な、その状況で、彼女に反撃もできずに、私は、それを避け続けた。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.596.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"900C503A-772D-48FD-86D9-FF04D4D7DCC5","title":"シーン 597","duration":5.0,"slideTitle":"第597スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"すると、突如彼女が、これまでとは異なり、手に力を込め始める。「次のビームを食らったら、終わりだな…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.597.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"176C126A-C757-4508-800B-3510CDC32FCE","title":"シーン 598","duration":3.8000000000000003,"slideTitle":"第598スライド","backgroundName":"ペーストされた画像.tiff","characterName":"藤原妹紅","telop":"そして、これまでより高火力のビームを受け終わると、\n私は、その場に倒れ込んだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.598.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"408FE36A-1859-4FF3-97DA-57F888C78A79","title":"シーン 599","duration":5.6000000000000005,"slideTitle":"第599スライド","backgroundName":"ペーストされた画像.tiff","characterName":"美鈴","telop":"私は、彼が倒れ込むとその隙をつき、彼女の背後に立つ。\nそして、彼女の首筋に強力な打撃を与えて、気絶させるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.599.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"5A487E98-E417-424D-A6AE-F1A144F4CDB1","title":"フランと彼が家に着くと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.600.jpeg","animationDuration":1.5},{"id":"4A808C1F-9F67-4712-8E12-F3BAABDF4E63","title":"シーン 601","duration":5.1000000000000005,"slideTitle":"第601スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"あれから、レジで僕が財布を忘れたので、彼女が立て替えて、家に帰ってくると、パックごはんをレンチンする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.601.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"6F107514-AE26-4A7B-8DE3-606CCB7E7025","title":"シーン 602","duration":5.1000000000000005,"slideTitle":"第602スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、レンチンが終わると、蓋を開け、その上に鯖の味噌煮缶とチーズをそのままのせて、再びレンチンする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.602.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"372F0E6E-2F93-44F5-BB79-5CD222A092D1","title":"シーン 603","duration":5.5,"slideTitle":"第603スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから、手袋をつけて、レンチンした料理を取り出し、彼女が座っている食卓に運ぶ。「できましたよ、フランさん。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.603.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"32D1AE4B-4949-455D-B808-3E935E670ACF","title":"シーン 604","duration":4.800000000000001,"slideTitle":"第604スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「ありがとう、紅夢くん。」私はそう言い、彼から箸を受け取ると、そのまま熱々の料理を口に頬張る。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.604.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"EAC967CA-DBE6-4CE5-B420-46251BBC52F2","title":"シーン 605","duration":3.5,"slideTitle":"第605スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「あっち…」私はそう言いながら、口をハフハフさせる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.605.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（困り）.png"},{"id":"79726961-A2C3-4895-AB5E-2276259DF222","title":"シーン 606","duration":3.5,"slideTitle":"第606スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そんなに焦らなくて大丈夫ですよ、ご飯は逃げませんから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.606.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（困り）.png"},{"id":"B7AD96D7-030B-4DBB-8C92-F17D1490739F","title":"シーン 607","duration":3.5,"slideTitle":"第607スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「そうだね…。」私はそう言い、今度は冷ましてから食べる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.607.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（困り）.png"},{"id":"10FA7B62-175E-4ABE-B609-38A8A343A80D","title":"シーン 608","duration":3.5,"slideTitle":"第608スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「おいしい！」私は、思わずそう声を発する。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.608.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"4A8B6CDA-A951-4885-9796-5E7C34E27454","title":"シーン 609","duration":3.5,"slideTitle":"第609スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ふっ。」僕は、彼女のその仕草に思わず笑ってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.609.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"3943788E-0C72-46AA-8F33-8C15653B7441","title":"シーン 610","duration":5.7,"slideTitle":"第610スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私はそれから、あっという間にごはんを食べ切ると彼を見る。\n「ねぇ、さっき買ってきたワインとグラスを出してくれない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.610.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"0152487A-B967-4847-8614-1CCBB0A048F9","title":"シーン 611","duration":5.1000000000000005,"slideTitle":"第611スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「いいですよ。ちょっと待ってください。」僕はそう言い、冷蔵庫にしまったワインを取り出してグラスに注ぐ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.611.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"EC0412D4-3B09-4BEE-B00C-EDF088CBC1C3","title":"シーン 612","duration":4.800000000000001,"slideTitle":"第612スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、ワインを注ぐと、彼女の前に置く。すると、彼女が僕の手を掴む。「あの、どうしたんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.612.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"98E75F04-EEC5-44A9-95C3-CEF8F73F8009","title":"シーン 613","duration":5.7,"slideTitle":"第613スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そういうと、彼女は席を立ち、僕の隣に立つと、頬に何かが触れる感触がする。その途端に、強烈な恥ずかしさを僕は覚える。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.613.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"CA525935-26A1-438E-8C6D-5AB8DB6F86B1","title":"シーン 614","duration":3.5,"slideTitle":"第614スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「どう、私からのキスは？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.614.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"0952437E-C539-4F8E-946C-3D7F41178738","title":"シーン 615","duration":4.800000000000001,"slideTitle":"第615スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女はワインを飲みながら、そう僕に聞く。\n「えっと…」僕は返すべき言葉が分からず、戸惑ってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.615.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"7413A330-B59A-41CA-A3BF-CAB8C34CFB81","title":"シーン 616","duration":5.4,"slideTitle":"第616スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、わずかに彼女と帰宅したことを、後悔した。だが、それよりも、彼女の表情やその声が頭の中に入り込んでくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.616.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"6F96CC4C-60B6-4AA7-82CE-EAC2067A16FE","title":"シーン 617","duration":3.5,"slideTitle":"第617スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「…少しばかし、恥ずかしいです…」僕は、そう返すのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.617.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"BC5A8779-CCD7-4689-BF6F-654F12BAD4F9","title":"その頃、霊夢は…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.618.jpeg","animationDuration":1.5},{"id":"95B202E0-3531-4982-BA2E-E017B13C6EF0","title":"シーン 619","duration":3.5,"slideTitle":"第619スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"私は、この取調室でふと今朝のことを思い出していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.619.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"596FF635-30B7-4145-841E-8960B8AC7808","title":"シーン 620","duration":5.0,"slideTitle":"第620スライド","backgroundName":"nc238754_一人部屋（日中）.jpg","characterName":"博麗霊夢","telop":"私は、家を出てから、魔理沙の家に着くと、彼女は、ため息をつきながら、どこか暗く感じる表情をしていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.620.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc238754_一人部屋（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"75790BD6-90F0-4495-8F72-4BC7B6484BED","title":"シーン 621","duration":5.7,"slideTitle":"第621スライド","backgroundName":"nc238754_一人部屋（日中）.jpg","characterName":"博麗霊夢","telop":"私が、彼女にそんな表情をしている理由を問うと、昨晩の就寝時に、やけ酒をしていると、ふと不思議な声が聞こえたという。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.621.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc238754_一人部屋（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"BA6AE1FD-A42B-47A8-A5A7-484CE83A2DF0","title":"シーン 622","duration":5.300000000000001,"slideTitle":"第622スライド","backgroundName":"nc238754_一人部屋（日中）.jpg","characterName":"博麗霊夢","telop":"そして、気がつけば、赤信号の横断歩道を渡っており、彼が止めなければ、きっとあのまま車に轢かれていたという。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.622.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc238754_一人部屋（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"2D1C9ECB-BB0D-4AE4-8017-FC1C99B7B9FE","title":"シーン 623","duration":5.800000000000001,"slideTitle":"第623スライド","backgroundName":"nc238754_一人部屋（日中）.jpg","characterName":"博麗霊夢","telop":"私は、その症状が時折彼女に現れることを知っていて、だが、出来事が起きてから、翌朝には記憶から消えることを知っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.623.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc238754_一人部屋（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"2C25AF40-1E4A-4763-A8BC-292BC7E32D13","title":"シーン 624","duration":5.9,"slideTitle":"第624スライド","backgroundName":"nc238754_一人部屋（日中）.jpg","characterName":"博麗霊夢","telop":"だが、彼女はあの後も、悪夢に悩まされていて、今日1日を無事に過ごせるかが不安だというので、励まし、私は仕事に向かった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.624.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc238754_一人部屋（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔.png"},{"id":"61014F65-FCD5-4E31-9F13-7C2E4F32FD3D","title":"シーン 625","duration":4.2,"slideTitle":"第625スライド","backgroundName":"nc73538_【背景素材】博麗神社.pxd","characterName":"博麗霊夢","telop":"それから、時が進み、夕陽がさしていた頃、\n彼女が突如として私が勤めている神社に現れた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.625.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔2.png"},{"id":"7770C1E4-65DE-4966-93DE-E8DF0D477C6D","title":"シーン 626","duration":5.2,"slideTitle":"第626スライド","backgroundName":"nc73538_【背景素材】博麗神社.pxd","characterName":"博麗霊夢","telop":"すると、彼女は、私にあることを聞いてくる。それは、以前の彼女なら気にすることもなかったはずの内容だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.626.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔2.png"},{"id":"2A40AA99-FAAE-4BA9-95EA-49183BA3506D","title":"シーン 627","duration":5.1000000000000005,"slideTitle":"第627スライド","backgroundName":"nc73538_【背景素材】博麗神社.pxd","characterName":"博麗霊夢","telop":"今考えれば、それはある予兆だったのだとわかる。\nだが、その時の私は、再度、励ます程度で済ませてしまった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.627.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/困り顔2.png"},{"id":"7180C9DB-52C1-444E-B5A7-798A28BBBD09","title":"シーン 628","duration":5.5,"slideTitle":"第628スライド","backgroundName":"nc247230_都会の街中（夕方）.jpg","characterName":"博麗霊夢","telop":"一応励ましたものの、様子が気になった私は、神社を早く出て、彼女を再度見ると、顔色が先ほどよりも悪くなっていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.628.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc247230_都会の街中（夕方）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/具合の悪い顔.png"},{"id":"78EBAEA8-CF3F-4816-9808-7DD1687DB0B2","title":"シーン 629","duration":5.7,"slideTitle":"第629スライド","backgroundName":"nc247230_都会の街中（夕方）.jpg","characterName":"博麗霊夢","telop":"そして、彼女は、ある言葉を私にいう。私は、その言葉に思わず彼女を平手打ちし、なぜそんなことを言うのかと問いただす。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.629.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc247230_都会の街中（夕方）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影のある笑顔2.png"},{"id":"82C27D8B-1567-42D9-B85F-4F3E40C0D5D0","title":"シーン 630","duration":5.6000000000000005,"slideTitle":"第630スライド","backgroundName":"nc247230_都会の街中（夕方）.jpg","characterName":"博麗霊夢","telop":"すると、彼女は、謎に笑い出し、だんだんと様子が変わっていき、まるで悩みなどなかったように笑うと、ビームを出した。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.630.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc247230_都会の街中（夕方）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"89002E67-83BD-4206-8B85-5139841795B4","title":"シーン 631","duration":5.4,"slideTitle":"第631スライド","backgroundName":"nc247230_都会の街中（夕方）.jpg","characterName":"博麗霊夢","telop":"結果的に、私は、彼女のビームを避けて、戦うことになってしまい、だんだんと周りのビル群に影響が出始めていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.631.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc247230_都会の街中（夕方）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霧雨魔理沙7.jpg"},{"id":"1F42414C-394E-4D22-A247-B94A1509E2D2","title":"シーン 632","duration":5.7,"slideTitle":"第632スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"あれから、数時間程度の間、私は彼女からのビームを避け続けていたが、それでもビームを喰らい、気づけば倒れてしまった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.632.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"EE661264-2422-43D9-9ABE-9C646E6E81AF","title":"シーン 633","duration":5.7,"slideTitle":"第633スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"そして、目が覚めてからは、ここで時折警官と話したり、考え事をしたりしていた。そして、彼と息子の今の様子が気になる。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.633.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"2FE599EF-CDBD-4EF9-965E-AEF8B735305D","title":"シーン 634","duration":4.9,"slideTitle":"第634スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"魂魄妖夢","telop":"「お待たせしました、あなたが解放されることになったので、いまから、玄関口まで私が、ご案内します。」","animationName":"なし","transitionName":"なし","voiceCharacter":"魂魄妖夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.634.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妖夢（微笑）.png"},{"id":"D8D52643-2A5B-4092-A717-42B5E611E101","title":"シーン 635","duration":5.300000000000001,"slideTitle":"第635スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.635.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"907D341B-5527-4558-9A95-E4058FFC5A6B","title":"シーン 636","duration":3.8000000000000003,"slideTitle":"第636スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"レミリア・スカーレット","telop":"「実は、あなたの息子さんの将来に関わることで、\n折行ってご相談がありまして…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.636.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"6158D54A-0D39-4C23-9EBC-64A60A3A8647","title":"シーン 637","duration":3.5,"slideTitle":"第637スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"「何の相談ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.637.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"CAE1D51C-F4C4-4015-AF26-0968B1309128","title":"シーン 638","duration":3.5,"slideTitle":"第638スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"レミリア・スカーレット","telop":"「実は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.638.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"98F65829-D4CD-47F6-8AD7-9A0F1A73D60E","title":"シーン 639","duration":3.5,"slideTitle":"第639スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"私はそれを聞き、驚く。「とりあえず、私の家に来ますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.639.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"F015B02A-0003-47A2-B08C-A84E9DDC8A99","title":"シーン 640","duration":3.5,"slideTitle":"第640スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"レミリア・スカーレット","telop":"「ええ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.640.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"DD71BA36-4B65-4AD1-9737-168F2FFD69D0","title":"二人が家に着くと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.641.jpeg","animationDuration":1.5},{"id":"107BF372-95DC-46A7-A382-6D6EDE4FF892","title":"シーン 642","duration":5.800000000000001,"slideTitle":"第642スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"私たちが、家に着くと、どことなく違和感が漂う。そして、ふと冷蔵庫を開けてみると、見知らぬワインがあった。「まさか…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.642.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"C4D0E301-0DB2-42EA-889D-20E14A762DD2","title":"シーン 643","duration":5.300000000000001,"slideTitle":"第643スライド","backgroundName":"一人部屋３（夜・照明OFF）.jpg","characterName":"博麗霊夢","telop":"そして、そっと息子の部屋の扉を開けて、中を覗く。すると、彼女が言っていた女性が、スヤスヤとベッドで寝ていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.643.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/一人部屋３（夜・照明OFF）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手すやすや頬照り寝顔.pxd"},{"id":"050746B3-E573-4D35-AF39-4B06BC95B4BA","title":"シーン 644","duration":5.7,"slideTitle":"第644スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"そして、私と彼の部屋に入ると、紅夢がベッドの片方で寝ていた。私は、それを確認すると、リビングで待つ彼女の元に戻る。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.644.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝顔３.pxd"},{"id":"2E3DD5E2-ADDA-4D87-A860-ED4024164B1D","title":"シーン 645","duration":3.5,"slideTitle":"第645スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「それで、各部屋の様子はどうでしたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.645.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"FFE764CC-CA33-4806-819E-E60C3A60DE4B","title":"シーン 646","duration":4.800000000000001,"slideTitle":"第646スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"「あなたに指摘された通りです。それで…本当に私の息子の許嫁に妹さんをもらって大丈夫でしょうか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.646.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"C4FC3639-D1BE-47E2-B9BC-A6BF17C3ED5F","title":"シーン 647","duration":3.5,"slideTitle":"第647スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「ええ、妹がきっとそれを望みますから…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.647.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"6F8F2047-009E-4077-AF69-631E6B469CEF","title":"シーン 648","duration":3.5,"slideTitle":"第648スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"「建設会社の方は、後継者はいるのですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.648.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"A43713B1-4C89-4D7D-9B5B-124B89ABCE53","title":"シーン 649","duration":3.5,"slideTitle":"第649スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「後継者は今は、いませんが…、それが何か？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.649.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"C4BD3689-DB73-422D-B684-62D743E58159","title":"シーン 650","duration":5.300000000000001,"slideTitle":"第650スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"私は、息子の事情を話すべきか迷う、だが、ここで話しておかないと後々大変になるのは目に見えていた。「実は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.650.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手困り顔.png"},{"id":"F38BE49F-37D8-47BF-B17F-C103FEA0F9FA","title":"シーン 651","duration":3.5,"slideTitle":"第651スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"私は、彼女の話にとても驚く。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.651.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手驚く.png"},{"id":"61956D0C-6590-42DB-91DA-E549404ACA0F","title":"シーン 652","duration":5.2,"slideTitle":"第652スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「そうですか…」私は、このままでは養子を迎え入れるか、企業合併以外の選択肢しか残されない事実に考え込む。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.652.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア（弱る）.png"},{"id":"BB9C94A6-285A-4EB4-B1C0-7A427F23925A","title":"シーン 653","duration":3.5,"slideTitle":"第653スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「承知しました…。それでもう一つお願いがあるのですか…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.653.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"F1873F00-BC76-4AD5-AED2-E10ACCF15A08","title":"シーン 654","duration":5.7,"slideTitle":"第654スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"私はその内容に驚く。そして考えこむ。それから数分程度の間の後、告げる。「それでは、息子の今後については頼みます。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.654.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"A52CA28A-298C-4A08-B2B9-EF043DA8CFE7","title":"シーン 655","duration":5.1000000000000005,"slideTitle":"第655スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「私からの二つの願いに答えていただき、ありがとうございます。このご恩は、近いうちに必ずお返しします。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.655.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"6F4614E9-BB4D-4E40-AFA8-C1C16AA22585","title":"シーン 656","duration":5.2,"slideTitle":"第656スライド","backgroundName":"ペーストされた画像.tiff","characterName":"博麗霊夢","telop":"彼女はそういうと、家を去っていった。私は、「はぁ…」吐息を吐くと、そのまま入浴を済ませて、寝室に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.656.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"68B89A40-8204-416A-A531-3E20A9E548FC","title":"シーン 657","duration":5.5,"slideTitle":"第657スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"そして、部屋にそっと入って気づく。「今日は久々の添い寝ね…」私はそう呟きながら、彼の横に入り、寝付くのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.657.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝顔３.pxd"},{"id":"FD0029A7-E8A0-4FD2-A3D7-249668E602C8","title":"シーン 658","duration":3.5,"slideTitle":"第658スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「ねぇ、私と一緒に、大人の体験、してみない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.658.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"FFAD13A3-DD87-496D-8A48-BFB3E2F2152F","title":"シーン 659","duration":3.5,"slideTitle":"第659スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「大人の体験？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.659.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"83AFE071-6E98-4DE7-9667-1D9896B311C4","title":"シーン 660","duration":3.5,"slideTitle":"第660スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「うん、そう、私が導いてあげる、だから私に身を委ねて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.660.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"5898D958-B2B9-41FC-AD71-17F64C78C25A","title":"シーン 661","duration":5.300000000000001,"slideTitle":"第661スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、彼女にそう言われ、息を吐きながら、脱力する。\nすると、彼女が僕の背中に手を回し、唇をそっとくっつける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.661.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"B4EA44B8-B182-4CCF-8457-37FDD1D701A5","title":"シーン 662","duration":3.5,"slideTitle":"第662スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、彼女が僕の手を握り、そっと彼女の胸に当てる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.662.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"F4E6E08F-B44F-452E-A339-BDE58E40D737","title":"シーン 663","duration":3.5,"slideTitle":"第663スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「ほら、どう先生のーは？大きい？小さい？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.663.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"7C381043-1DFF-43FB-9D61-41D960F702A0","title":"シーン 664","duration":5.1000000000000005,"slideTitle":"第664スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「…僕は、どっちでも大丈夫ですよ…」僕は、どこかふわふわしたような、だが確かに感じるその感触を味わう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.664.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"C65F6E6B-2311-4CAA-893B-DDC2E08B7020","title":"シーン 665","duration":5.800000000000001,"slideTitle":"第665スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"私は、彼に自らの胸を触らせた後、そっと彼の頭を胸に埋める。\n「ほら、もっと力を抜いて…、リラーックス、リラーックス。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.665.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"0975F01C-4729-45CB-B46A-4E8E45EDADEB","title":"シーン 666","duration":5.7,"slideTitle":"第666スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女はそう言いながら、僕の服をそっと掴む。僕は、それに気づかずに、ふわふわしながら感じる感触に身を任せるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.666.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/夜のお誘い.png"},{"id":"473AAD3E-D6B2-428A-AB45-06B48460ECBF","title":"一方、霊夢は…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.667.jpeg","animationDuration":1.5},{"id":"F26ACF76-1643-45B9-A2A0-ADCB77170A57","title":"シーン 668","duration":4.2,"slideTitle":"第668スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"藤原妹紅","telop":"「だからよ…」私は、そう妻である彼女に、\n仕事終わりの飲み会での愚痴をお酒片手に話す。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.668.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ぐち.png"},{"id":"9D89E591-7835-41B8-9D8D-A5D6F7CD740E","title":"シーン 669","duration":4.4,"slideTitle":"第669スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"「どうしたの、あなた、急に黙り込んで？」\n私が、そう彼に問いかけると、急に抱きついてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.669.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/酔った顔.png"},{"id":"CE37F38C-4C20-482A-9670-D1D18993BF22","title":"シーン 670","duration":4.1000000000000005,"slideTitle":"第670スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"藤原妹紅","telop":"「だから、今晩は朝までーだぞ、霊夢。」\n私は、そういうと、彼女に襲い掛かるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.670.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/やる.png"},{"id":"C3F5DCFC-E4B1-4168-A8E5-3818070A5D7C","title":"シーン 671","duration":5.7,"slideTitle":"第671スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"操夢","telop":"「んっ…」僕はふと目が覚める。そして、ぼんやりと目の前を見る。そして、ふと手が目の前に触れる。「あれ…この感触…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.671.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/気持ちの良い寝顔.png"},{"id":"C57FACE1-47AC-4260-87DF-B279058DF9C7","title":"シーン 672","duration":3.5,"slideTitle":"第672スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"博麗霊夢","telop":"「あら、まだやり足りないの、あなた…」","animationName":"不透明度","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.672.jpeg","videoPath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_animations/元女子校の日常総集編_default/slide_672_anim.m4v","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/気持ちの良い寝顔.png"},{"id":"DF79135A-68DB-464F-B4DA-D93C16CC6B80","title":"シーン 673","duration":5.1000000000000005,"slideTitle":"第673スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"操夢","telop":"そして、互いの意識がクリアになっていき、はっきりと姿を捉えると、沈黙の時間がわずかに流れる。「………」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.673.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"6C7F8A48-3D24-444C-A717-D886FE7663ED","title":"シーン 674","duration":3.5,"slideTitle":"第674スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"操夢&博麗霊夢","telop":"「ぎゃーーーーーーーーーーーーーーーーー！」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢&博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.674.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（驚く）.png"},{"id":"910E7893-6731-46AC-9E40-8E7EB60D64F6","title":"シーン 675","duration":5.800000000000001,"slideTitle":"第675スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「んっ…」私は、誰かの叫び声が聞こえて、目が覚める。「一体、何があったの？」私は、そう呟きながら、ベッドから降りる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.675.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/寝起き小口開け.png"},{"id":"48EA4D70-3322-42FF-A659-E24F9F68F663","title":"シーン 676","duration":3.5,"slideTitle":"第676スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"博麗霊夢","telop":"「あっ、あんた、一体どんな夢見てたら、母親の…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.676.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（怒る）.png"},{"id":"41D0326E-DCC4-4199-9E8E-D2CC3018A4A7","title":"シーン 677","duration":4.4,"slideTitle":"第677スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"操夢","telop":"「なんとなく感じてた、あの感触は…」\n僕は、そこで、気付いてはいけないような事実に気づく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.677.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（怒る）.png"},{"id":"BE48D29E-2D50-425C-B8F0-361BB6F9E107","title":"シーン 678","duration":3.5,"slideTitle":"第678スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"博麗霊夢","telop":"「とりあえず、今はいいわ。それより鏡見てきなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.678.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（怒る）.png"},{"id":"E5E05A21-0EAF-4B07-895E-9DB359563B82","title":"シーン 679","duration":5.2,"slideTitle":"第679スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"博麗霊夢","telop":"私は、息子を部屋から追い出すと、「はぁ」とため息をつく。\n「今日のことが、彼にバレなければいいのだけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.679.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/پj.png"},{"id":"229749FE-2404-467B-A812-9AF18AB3FAA1","title":"シーン 680","duration":3.5,"slideTitle":"第680スライド","backgroundName":"E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterName":"博麗霊夢","telop":"私はそう一人、ぼさっと呟くと、リビングに降りていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.680.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/E1D3751D-BB7F-53CF-9E90-C078A5AB6FC6.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/پj.png"},{"id":"B6057186-273C-493E-B1C6-2D5CFD3A5911","title":"それから…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.681.jpeg","animationDuration":1.5},{"id":"C3A9F234-FD19-446C-832C-4FD5FE920EE0","title":"シーン 682","duration":5.6000000000000005,"slideTitle":"第682スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから、僕は鏡の前で、身だしなみの手入れを済ませると、リビングにはフランが困った表情を浮かべながら立っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.682.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"FA0B430F-6F15-4A8C-9BA1-48827E820461","title":"シーン 683","duration":3.5,"slideTitle":"第683スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「どうしたんですか、フランさん？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.683.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"1D820641-C1AC-4037-BF27-73289841FD6B","title":"シーン 684","duration":3.5,"slideTitle":"第684スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「さっき君の母親が、慌てた様子で家を飛び出していって…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.684.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"2B4FE344-62D3-47FB-84FE-65230C2D4E63","title":"シーン 685","duration":3.5,"slideTitle":"第685スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「…さぁ、僕は知らないですよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.685.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"A4817347-8F87-4AEA-8DFA-7FBF3B417584","title":"シーン 686","duration":3.5,"slideTitle":"第686スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「それ、本当なの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.686.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"807B06C3-9C89-43CA-B29D-56ED12EFB068","title":"シーン 687","duration":3.5,"slideTitle":"第687スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「恥ずかしい話ですが、それでも聞きたいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.687.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"B8AD6644-7DBB-407E-84CE-01C9D892D34A","title":"シーン 688","duration":3.5,"slideTitle":"第688スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「聞かせて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.688.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"CC847D8D-B71F-4BC3-A9E1-E433D9785AAE","title":"シーン 689","duration":5.7,"slideTitle":"第689スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、彼女にそう言われ、今朝の出来事と、昨晩の夢の内容を彼女に１から話していく。すると、彼女の頬が、頬照っていく。","animationName":"バウンス","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.689.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"9E356D35-255A-441E-92D8-FBFF7E9AFE13","title":"シーン 690","duration":3.5,"slideTitle":"第690スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「それ、外では内緒だからね、分かった？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.690.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"54F190A2-786A-466C-9C64-61E052E4D484","title":"シーン 691","duration":4.9,"slideTitle":"第691スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ええ、分かりました…。」僕は、なぜ彼女がそういうのか、分からなかったが、とりあえず、そう答えた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.691.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"51AEEA83-AFF2-4A32-BCC1-BACD531069C4","title":"シーン 692","duration":3.5,"slideTitle":"第692スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕たちがそんな会話をしていると、インターホンが鳴る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.692.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"DF46FA20-045C-4435-B774-3526EB029C1F","title":"シーン 693","duration":4.2,"slideTitle":"第693スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、玄関に出ると、そこには知らない女性が立っていた。\n「あの、あなたは、誰ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.693.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"EC3F8264-AA9C-43DF-AF1E-7E89AC6DB0B3","title":"シーン 694","duration":5.1000000000000005,"slideTitle":"第694スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"私は、彼にそう聞かれると、自分の名刺を彼に渡す。\n「私は、紅魔建設の代表、レミリア・スカーレットです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.694.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"130990F6-CC73-4D73-A521-CDE443AB62B4","title":"シーン 695","duration":5.5,"slideTitle":"第695スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、その名刺を受け取ると、僕の名前を彼女に伝える。\nすると、彼女はどうやら、その名前を見知っているようだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.695.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"C3718359-55F3-4FA8-B51C-953647DB8A41","title":"シーン 696","duration":3.9000000000000004,"slideTitle":"第696スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「それで、突然なのだけど、\n家に上がらせてもらってもいいかしら、藤原紅夢くん？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.696.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"6950373C-5800-4EEE-BFB0-5BACD23086FE","title":"シーン 697","duration":3.5,"slideTitle":"第697スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「ええ、いいですよ。」\n僕はそういうと、彼女を家にあげ、リビングに戻る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.697.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"6BDB44EB-7539-4F82-896E-533516FDF4EE","title":"シーン 698","duration":3.5,"slideTitle":"第698スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が家に戻ると、フランが驚いた様子でこちらを見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.698.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"14620984-198E-4109-8955-E725090DBE44","title":"シーン 699","duration":3.5,"slideTitle":"第699スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「どうしたの、お姉様…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.699.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"0F1ABC92-09B9-4C9C-B362-703B7C2AD88E","title":"シーン 700","duration":3.5,"slideTitle":"第700スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「彼の母親と契約して、彼を引き取りに来たのよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.700.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"874E0408-6724-4A73-BA04-5B369F0584D0","title":"シーン 701","duration":3.5,"slideTitle":"第701スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「え…、それって…これからあの屋敷で彼と住むってこと？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.701.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"947AEF02-8633-4152-A055-D39F18463F37","title":"シーン 702","duration":4.5,"slideTitle":"第702スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「ええそのとおり。それで、紅夢くんは、\n荷物と部屋の整理にどれくらいの時間がかかるかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.702.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"4D5D0C82-B802-45D3-9AC4-126D04B21C8B","title":"シーン 703","duration":3.5,"slideTitle":"第703スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…」僕は、レミリアの発言に戸惑ってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.703.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"01B4AB11-6C04-4815-8938-F0CCC68C878D","title":"シーン 704","duration":5.800000000000001,"slideTitle":"第704スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「もし、時間がかかるなら、私もお手伝いするわ。それで、どうかしら？できれば、今日の夕方には屋敷宛に発送したいけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.704.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"97A87F9A-826D-4108-8855-7032C9F4447C","title":"シーン 705","duration":4.4,"slideTitle":"第705スライド","backgroundName":"ペーストされた画像.tiff","characterName":"レミリア・スカーレット","telop":"「じゃあ、それでお願いします…」\nそれから、僕と彼女たちは引っ越しの作業を進めるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.705.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"93811044-A947-4C7D-B863-FB0C2EF46CE5","title":"一方、魔理沙は…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.706.jpeg","animationDuration":1.5},{"id":"05D6675A-F1FC-4E2E-85C6-21186C62152F","title":"シーン 707","duration":3.5,"slideTitle":"第707スライド","backgroundName":"nc256896_病室-昼.png","characterName":"霧雨魔理沙","telop":"私は、ふと目が覚めると、そこは病院だった。\nすると、誰かが入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.707.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png"},{"id":"020D9766-CBA8-49E8-86B6-E15C76256B3B","title":"シーン 708","duration":3.5,"slideTitle":"第708スライド","backgroundName":"nc256896_病室-昼.png","characterName":"博麗霊夢","telop":"「あんた、大丈夫だったの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.708.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"6665D029-C57D-44E0-82BA-AD455EB04E72","title":"シーン 709","duration":3.5,"slideTitle":"第709スライド","backgroundName":"nc256896_病室-昼.png","characterName":"霧雨魔理沙","telop":"「ああ、今はもう平気さ…。それより、先生はどう言ってた？」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.709.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"470EEE72-A1E3-4498-94E0-1CEB082B6DC4","title":"シーン 710","duration":4.5,"slideTitle":"第710スライド","backgroundName":"nc256896_病室-昼.png","characterName":"博麗霊夢","telop":"「一度、消えかけていた人格が急に出て、\n暴れたんだから、制限付きでの生活を再開させるって…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.710.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"D68AEAA6-813C-4A88-BC67-F7C3B6B258E0","title":"シーン 711","duration":3.5,"slideTitle":"第711スライド","backgroundName":"nc256896_病室-昼.png","characterName":"霧雨魔理沙","telop":"「そうか…、それより…彼はどうだ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.711.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"306F17DE-17BD-460C-9F07-757E6CE10D20","title":"シーン 712","duration":3.5,"slideTitle":"第712スライド","backgroundName":"nc256896_病室-昼.png","characterName":"博麗霊夢","telop":"「彼って、紅夢のこと？それなら、いつもと変わらないわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.712.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"2C1F9623-406B-47D6-8E06-2C6195C0FCE4","title":"シーン 713","duration":3.5,"slideTitle":"第713スライド","backgroundName":"nc256896_病室-昼.png","characterName":"霧雨魔理沙","telop":"「そうか…、それなら安心だな…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.713.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"02B72E74-891C-42B1-859D-1B8872DB33DC","title":"シーン 714","duration":3.5,"slideTitle":"第714スライド","backgroundName":"nc256896_病室-昼.png","characterName":"博麗霊夢","telop":"「あんた、何言ってんのよ。\nそれより、自分自身を心配した方がいいわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.714.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/博麗霊夢_困った笑み.png"},{"id":"B74205D5-CBCD-4189-96CC-B26903D56467","title":"シーン 715","duration":3.5,"slideTitle":"第715スライド","backgroundName":"nc256896_病室-昼.png","characterName":"霧雨魔理沙","telop":"「そうか…。彼に一言だけ、伝言してくれないか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.715.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/博麗霊夢_困った笑み.png"},{"id":"DFF3AC9B-23D3-4C12-84BB-161A8844FC21","title":"シーン 716","duration":3.5,"slideTitle":"第716スライド","backgroundName":"nc256896_病室-昼.png","characterName":"博麗霊夢","telop":"「何なの、伝言って？」私はそう言って、耳を立てて聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.716.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/博麗霊夢_困った笑み.png"},{"id":"6AB0DDFF-1777-49DD-8753-57C605796707","title":"シーン 717","duration":5.7,"slideTitle":"第717スライド","backgroundName":"nc256896_病室-昼.png","characterName":"霧雨魔理沙","telop":"「気を悪くしたのなら、すまない。これが、私が考えられる最善策と彼のための言葉なんだ。だから、彼にそう伝えてくれ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.717.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恐怖顔２.png"},{"id":"1BCF460E-8DF9-4804-847D-3FF32C64D99B","title":"シーン 718","duration":4.2,"slideTitle":"第718スライド","backgroundName":"nc256896_病室-昼.png","characterName":"博麗霊夢","telop":"「そう、それじゃあ、またお見舞いに来るわ。」\n私はそう言うと、勤務地に向かっていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.718.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恐怖顔２.png"},{"id":"7EBCF8D9-CB4F-4D6D-AFC5-D16F960085BB","title":"シーン 719","duration":5.7,"slideTitle":"第719スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"レミリアの突如の訪問から始まった引っ越し作業は、なんとか1日で完了し、今は、フランと僕の二人部屋で休んでいた。\n東方Project二次創作作品\n第11話","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.719.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"9AD549F8-D2E4-4E01-83E6-6400F9E2DB43","title":"シーン 720","duration":4.800000000000001,"slideTitle":"第720スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"そして、この部屋に来てからというものの、互いに無言の時間が流れ、微妙な空気感が部屋を覆っている。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.720.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"F4E94587-2F68-4C79-8B44-604527865296","title":"シーン 721","duration":3.5,"slideTitle":"第721スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「ねぇ、これから、どうする？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.721.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"D772F4F6-CBB8-4C2D-90CE-3FE53B8EA0BE","title":"シーン 722","duration":3.5,"slideTitle":"第722スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕たちが、互いに困惑していると、\nふと部屋の扉がノックされる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.722.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"A4B34D58-51EE-4ADE-A596-E70B2FC71C2E","title":"シーン 723","duration":3.5,"slideTitle":"第723スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"レミリア・スカーレット","telop":"「フラン、紅夢、入っていいかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.723.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"854367E1-67DD-49AE-ABCB-768681D358EA","title":"シーン 724","duration":3.5,"slideTitle":"第724スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「どうしたの、お姉様？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.724.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"5DAC0D45-EA0F-46C6-AB8B-D2CE68A2D28E","title":"シーン 725","duration":3.5,"slideTitle":"第725スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"レミリア・スカーレット","telop":"「今さっき、私が出たから、二人でお風呂に入ってきなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.725.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"C9448445-B0DF-4C28-9886-93959178451C","title":"シーン 726","duration":3.5,"slideTitle":"第726スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕とフランは、レミリアの発言に、互いに頬を頬照らせる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.726.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"F86729D8-088E-4066-B1A5-A0D4AB083D69","title":"シーン 727","duration":3.5,"slideTitle":"第727スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「お姉様、今なんて言ったの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.727.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"2C48952B-E310-40D7-A537-060B0EA1A26D","title":"シーン 728","duration":3.5,"slideTitle":"第728スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"彼女はそう発言するが、レミリアからの返事はない。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.728.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"04421B9F-14F6-447A-A961-FE865C506DC8","title":"シーン 729","duration":3.5,"slideTitle":"第729スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「どうする、一緒にお風呂に入る…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.729.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"9A8B840B-4FC8-444A-A309-527E9B463806","title":"シーン 730","duration":4.2,"slideTitle":"第730スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕が、その返答に悩んでいると、\nレミリアが僕たちに、ある言葉を突きつけていくのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.730.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（困る）.png"},{"id":"DDCF6590-832C-472C-AB09-2705C2991AAF","title":"シーン 731","duration":5.6000000000000005,"slideTitle":"第731スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"操夢","telop":"あの後、僕たちは二人で入浴する羽目になり、僕たちの間には気まずさを超えた、冷たい空気が漂いながら、夕飯を迎えた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.731.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png"},{"id":"78DA81C1-E037-4424-A179-C1409E2A2325","title":"シーン 732","duration":4.6000000000000005,"slideTitle":"第732スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「それじゃあ、夕飯を食べましょうか。」\n私は、そう二人に言うが、二人からの反応は返ってこない。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.732.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"A36E1C8E-0A6D-4D3F-9634-E6729C5F9BF3","title":"シーン 733","duration":3.5,"slideTitle":"第733スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「早く、夕飯食べないと、料理が冷めちゃうわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.733.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"3C65DFBF-B0F2-40E7-9317-BF682AD47F1C","title":"シーン 734","duration":5.1000000000000005,"slideTitle":"第734スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"操夢","telop":"僕たちは、彼女にそう告げられ、仕方なく料理に手を伸ばす。だが、先ほどまでの出来事が頭から離れなかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.734.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"950F5E9F-5A63-4339-9328-34B64A570516","title":"シーン 735","duration":4.2,"slideTitle":"第735スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"操夢","telop":"僕はそれから、機械的に食べ進めて、\n食事を終えると、彼女が突如として、声をかけてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.735.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（笑い）.png"},{"id":"567EAE8C-5F79-4FE2-AC22-96A4F3233395","title":"シーン 736","duration":4.4,"slideTitle":"第736スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「さてと、そろそろデザートの時間にしましょうか。」\n私はそう二人に告げて、そっと席を立つ。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.736.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"AA353500-570A-4261-9ABD-B7C480B30B88","title":"シーン 737","duration":4.6000000000000005,"slideTitle":"第737スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"操夢","telop":"僕がふとフランの方に視線をやると、彼女が驚いた。\nそれと同時、首筋に誰かが、噛み付いてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.737.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"6FCFEF94-06CC-4F83-A1C5-BA146EC0C430","title":"シーン 738","duration":4.5,"slideTitle":"第738スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"操夢","telop":"そして、僕がその行為が何であるかを把握するうちに、\n僕の意識が闇の中へ、落ちていくのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.738.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"3F704BCA-69AC-4AAC-89EC-E24355742897","title":"シーン 739","duration":6.300000000000001,"slideTitle":"第739スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"私は、ふと周囲を見渡すと、一方には、先日レミリアと名乗っていた人物、もう一方にはその妹がいた。するとレミリアが話しかけてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.739.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"96A62F31-5777-4C40-A7F2-8D44470E4156","title":"シーン 740","duration":3.5,"slideTitle":"第740スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「あら、ご機嫌用、今のご気分はいかがですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.740.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"F5E3FAD0-D342-4867-88DF-F567FA449E9A","title":"シーン 741","duration":3.5,"slideTitle":"第741スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「普段と変わらない…とでも言っておきましょうか…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.741.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"D82B6761-FA7A-4A1C-882E-9C38D4C818F0","title":"シーン 742","duration":5.6000000000000005,"slideTitle":"第742スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「そうですか。確か私とあなたが対面するのは、あの深夜帯の学校以来ですね。あれから、彼に何か変化はありましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.742.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"9CB54108-CC69-4F6C-8706-C9D8D2B7E0FF","title":"シーン 743","duration":3.9000000000000004,"slideTitle":"第743スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「それより、あなたの妹さんが、\n先ほどから固まってますけど、大丈夫でしょうか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.743.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"31628E39-507F-4BBF-AB6B-1530BDF3C324","title":"シーン 744","duration":5.800000000000001,"slideTitle":"第744スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「あら、それは失礼」私はそう言いながら、フランに軽いパンチをする。「しっかりしなさい、彼女は彼の裏に潜んでるのよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.744.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"3E358F29-AC8C-4391-90C2-7A1587EAA0C7","title":"シーン 745","duration":3.5,"slideTitle":"第745スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"彼女が、妹のフランにパンチをすると、表情が変わる。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.745.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"079AD055-FF40-4529-877D-8BBBF911BEBB","title":"シーン 746","duration":4.6000000000000005,"slideTitle":"第746スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「フラン、ああ見えても、彼女と彼は同一人物なのよ。\nだから、気をしっかり持って、接しなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.746.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"736D622A-3889-4A28-AFA1-E42CDBE64059","title":"シーン 747","duration":3.5,"slideTitle":"第747スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"フランドール・スカーレット","telop":"「そう…なんだ…」私はそう呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.747.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"CD2230CF-6F38-40B7-ADF5-A0BDAD6D8102","title":"シーン 748","duration":3.5,"slideTitle":"第748スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「それで、私を呼び出したと言うことは、\n何かしらの事情があるのですね？」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.748.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"010FCB0A-1116-487C-9EA1-8D3DF5F5CAB8","title":"シーン 749","duration":4.4,"slideTitle":"第749スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「ええそうよ。」私はそう言うと、\n事前に用意してあった、書面を彼女の方へとスライドさせる。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.749.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"DD8F6A90-E4B3-4854-A2A7-794DACFC0941","title":"シーン 750","duration":3.5,"slideTitle":"第750スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「その書面を挟んでいるボールペンで、サインを頂けるかしら。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.750.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"A0640C45-C025-4E24-8F14-2609A3F05D67","title":"シーン 751","duration":5.300000000000001,"slideTitle":"第751スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"その書面には、先日の深夜帯に交わした契約を記したものと、フランの名前が記載された、婚姻届が挟まれてあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.751.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"54F154DF-E097-415C-AF27-EC3203D056B0","title":"シーン 752","duration":5.6000000000000005,"slideTitle":"第752スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「婚姻届の方は、まだ仮の状態よ。だから、あなたがサインしても、彼が拒絶すれば、無効。それで、返答はどうかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.752.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"D5FE856D-CFBF-4221-8878-877C4B2B128B","title":"シーン 753","duration":5.5,"slideTitle":"第753スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"私はふと考える、この機を逃せば、2度とこの書面を見れない気がした。そして、ペンを手に取ると、サインをして返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.753.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"770D7B2C-EC9B-4765-8117-0BC9B99B6439","title":"シーン 754","duration":3.9000000000000004,"slideTitle":"第754スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「フラン、この書類のコピーを取ってきなさい。」\n私はそう言い、書類とペンを渡す。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.754.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"F9F0060A-4567-46AF-820B-EBD0B2A0E4BE","title":"シーン 755","duration":5.6000000000000005,"slideTitle":"第755スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「夕方からのあなたの発言や所作は、私が表に出てくるように仕向けた手順なのですか？」私は確認のために、そう尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.755.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"000C4306-9375-413E-883B-1A9FBDBE4E8B","title":"シーン 756","duration":4.7,"slideTitle":"第756スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「ええ、そうよ。彼は見事に、引っかかってくれたわ。\nそれで、あなたはこれからどうするのかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.756.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"AEE37D3A-CE49-415E-BAC6-4622D1781F25","title":"シーン 757","duration":3.5,"slideTitle":"第757スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「特に予定は、ありませんよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.757.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"015BF21F-0159-4982-AF26-86438F706D5A","title":"シーン 758","duration":5.7,"slideTitle":"第758スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"レミリア・スカーレット","telop":"「そう。なら、この屋敷に図書館があるから、彼女に聞いて、読書するのがいいわ。何かあれば、彼女に聞いてちょうだい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.758.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"E09B35B2-C9B8-40D5-B325-C8AB22304F9D","title":"シーン 759","duration":4.3,"slideTitle":"第759スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"彼女はそう言うと、どこかへと去っていった。\nすると入れ替わるように、フランがやってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.759.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png"},{"id":"6B306BE9-F86F-428E-BE14-91D53746357A","title":"シーン 760","duration":3.5,"slideTitle":"第760スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"フランドール・スカーレット","telop":"「あれ、お姉様は？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.760.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"98D0C83A-F7AB-437A-B63C-A61DD1149D97","title":"シーン 761","duration":3.5,"slideTitle":"第761スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「彼女なら、どこかに向かって行きましたよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.761.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"BDAE4D24-FA6E-4412-B6FC-943FEDBF544A","title":"シーン 762","duration":3.5,"slideTitle":"第762スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"フランドール・スカーレット","telop":"「そう。それで、あなたは…これからどうするの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.762.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"25B2A03D-C503-4EB1-B97C-A46B2083ABB6","title":"シーン 763","duration":3.5,"slideTitle":"第763スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"私はそう聞く彼女に、思わず「ふっ」と笑ってしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.763.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"55F0803A-7047-4058-B4F8-FC4A6ABB800D","title":"シーン 764","duration":3.5,"slideTitle":"第764スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"フランドール・スカーレット","telop":"「ちょっと、なんで笑ってるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.764.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（不満）.png"},{"id":"3B8C4B9E-9E76-4F52-AB92-4AB27BF5808D","title":"シーン 765","duration":3.5,"slideTitle":"第765スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「さっきも、彼女にそう聞かれましたから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.765.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（不満）.png"},{"id":"8DBDF9AF-EA41-4B04-A5DE-B8B538008FE1","title":"シーン 766","duration":3.5,"slideTitle":"第766スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"フランドール・スカーレット","telop":"「何、私たちは姉妹だけど、何が言いたいの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.766.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"C2D23809-5219-49A1-8DFD-0F3B9D5425BA","title":"シーン 767","duration":3.7,"slideTitle":"第767スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"サブ","telop":"「いえ、なんでもないですよ。\nそれより、図書館の場所、教えてくれませんか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.767.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"D955C8BF-612D-4C2E-986F-630ED5F2D55C","title":"シーン 768","duration":3.5,"slideTitle":"第768スライド","backgroundName":"nc196982_食堂(夜2).png","characterName":"フランドール・スカーレット","telop":"「そう、なら案内するから、ついてきて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.768.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc196982_食堂(夜2).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"7A47DB81-3139-4214-8979-9B5FEEF88339","title":"シーン 769","duration":5.1000000000000005,"slideTitle":"第769スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"フランドール・スカーレット","telop":"「ここが、図書館。取り出した本は、元の位置に戻してよ。」\n私は、そう言うと、私と彼の部屋に戻っていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.769.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"A4CA9CE5-D502-43E9-9822-79C200FB937E","title":"シーン 770","duration":4.7,"slideTitle":"第770スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"サブ","telop":"「さてと…」私はそう言いながら、一息つくと、適当な本棚を眺めながら、図書館を歩き回るのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.770.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"E7C4FA06-F683-4BE1-8ECE-3C2105307CBE","title":"その頃、彼が元いた家では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.771.jpeg","animationDuration":1.5},{"id":"3DF079A1-C4B1-4EBE-90D5-B4186464ADC4","title":"シーン 772","duration":5.7,"slideTitle":"第772スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"私は、家に帰ってくるとため息をつく。例の騒動を鎮静化させる代わりに、魔理沙の面倒を私と彼で見ることになったからだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.772.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg"},{"id":"63C8A8E1-D807-4790-831D-876DE60E6E45","title":"シーン 773","duration":4.2,"slideTitle":"第773スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"「私の母校は昔から何も変わってないわね…」\n私がそう呟いていると、インターホンが鳴る。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.773.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg"},{"id":"758A073F-B623-4AE9-9D96-87A0B392D697","title":"シーン 774","duration":5.5,"slideTitle":"第774スライド","backgroundName":"nc235081_家（夜・灯りあり）.jpg","characterName":"博麗霊夢","telop":"私が外に出ると、書留郵便物の受け渡しだった。しかも、発送日時が数時間前になっていて、即日夜間速達の印があった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.774.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc235081_家（夜・灯りあり）.jpg"},{"id":"50822ACF-4044-4BC4-9723-7911FB61E59D","title":"シーン 775","duration":4.9,"slideTitle":"第775スライド","backgroundName":"nc235081_家（夜・灯りあり）.jpg","characterName":"博麗霊夢","telop":"即日夜間速達は、高い料金と引き換えに、夕方から夜にかけて出せば、日付が変わる前に届くと言うものだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.775.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc235081_家（夜・灯りあり）.jpg"},{"id":"DA60E253-2019-4DE6-A139-6D668F1BB551","title":"シーン 776","duration":5.4,"slideTitle":"第776スライド","backgroundName":"nc235081_家（夜・灯りあり）.jpg","characterName":"博麗霊夢","telop":"私は、ふとその封筒の宛名を見る。そこには、私と夫の名前があり、差出人には…ある建設会社の代表の名前があった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.776.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc235081_家（夜・灯りあり）.jpg"},{"id":"571432CE-FE22-4150-9D8B-78A253EE3D4B","title":"シーン 777","duration":3.5,"slideTitle":"第777スライド","backgroundName":"nc235081_家（夜・灯りあり）.jpg","characterName":"博麗霊夢","telop":"私はふと、昨晩のことを思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.777.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc235081_家（夜・灯りあり）.jpg"},{"id":"B493C6A0-1EEC-4BAA-8B52-2B5426E9624E","title":"シーン 778","duration":5.300000000000001,"slideTitle":"第778スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"私がそれから外に出ると、そこには著名な建設会社の代表であるレミリアの姿があった。「あの、どうされました？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.778.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"3EB5B092-7160-4C9D-AE06-C16591F31AD3","title":"シーン 779","duration":3.8000000000000003,"slideTitle":"第779スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"レミリア・スカーレット","telop":"「実は、あなたの息子さんの将来に関わることで、\n折行ってご相談がありまして…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.779.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"F96104D3-0B36-4CAD-8278-D32740992AD0","title":"シーン 780","duration":3.5,"slideTitle":"第780スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"「何の相談ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.780.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"77FA249A-E71D-42F4-A916-EA2218C61E6C","title":"シーン 781","duration":3.5,"slideTitle":"第781スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"レミリア・スカーレット","telop":"「実は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.781.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"858593F2-7A6B-488A-B90C-3FCC9675BFA0","title":"シーン 782","duration":5.5,"slideTitle":"第782スライド","backgroundName":"nc235081_家（夜・灯りあり）.jpg","characterName":"博麗霊夢","telop":"私は、それを思い出すと、その場で中身を見る。そこには、婚姻届のコピーがあった。私はそれを見ると、寝室に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.782.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/nc235081_家（夜・灯りあり）.jpg"},{"id":"6778E18A-25D0-44D3-A1B2-07B12BAE1235","title":"シーン 783","duration":5.800000000000001,"slideTitle":"第783スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"そして、魔理沙が家に来る前に取り出した、息子の部屋にあった書類や荷物、そして過去の記録物を取り出し、中身を確認する。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.783.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"CF741781-3331-44AE-9A18-D01D0BD611B1","title":"シーン 784","duration":5.1000000000000005,"slideTitle":"第784スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"その中身にある文字と、婚姻届の文字を比較する。どうやら、彼が書いたわけではなかった。「もしかしたら…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.784.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"02312313-324F-4DA6-BEDA-AB80AB24403E","title":"シーン 785","duration":5.800000000000001,"slideTitle":"第785スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"私は、取り出した書類や荷物の中から、入念深く探す。すると、あるものを見つける。その文字と婚姻届の文字は似通っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.785.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"75818D14-BE61-451F-8132-34E737A2F97E","title":"シーン 786","duration":5.6000000000000005,"slideTitle":"第786スライド","backgroundName":"96ADD4DE-3714-521D-BE06-732A989A7431.jpg","characterName":"博麗霊夢","telop":"私は、そこで気づく。いつの間にか、彼は、この家からいなくなったんだと。そして、時計を見ると、今日は土曜日だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.786.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/96ADD4DE-3714-521D-BE06-732A989A7431.jpg"},{"id":"A2F2EF56-263F-4775-8096-E57815685F7E","title":"シーン 787","duration":5.2,"slideTitle":"第787スライド","backgroundName":"2026-10-26_19-50.png","characterName":"操夢","telop":"僕は、ふと気がつくと、そこはフランと僕の二人部屋だった。\nすると、扉が、突如として開き、誰かが入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.787.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png"},{"id":"4E34801A-39B7-4B3B-AE67-30F35D49CFBD","title":"シーン 788","duration":3.5,"slideTitle":"第788スライド","backgroundName":"2026-10-26_19-50.png","characterName":"フランドール・スカーレット","telop":"「あら、目が覚めたの、紅夢くん…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.788.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"7DF1123E-E134-4DB8-BE9E-9513156ABCD6","title":"シーン 789","duration":4.5,"slideTitle":"第789スライド","backgroundName":"2026-10-26_19-50.png","characterName":"操夢","telop":"僕はふと、彼女の吐息が酒臭いことに気がつく。「…フランさん、どれだけお酒を飲みましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.789.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"889D2BB1-641E-45AD-B793-F441FBD8A05B","title":"シーン 790","duration":3.5,"slideTitle":"第790スライド","backgroundName":"2026-10-26_19-50.png","characterName":"操夢","telop":"僕がそう尋ねるが、返答はなく、\n代わりに彼女は僕をベッドの上に押し倒す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.790.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"E0D49E61-1019-4285-8B12-CB9E9DE928BA","title":"シーン 791","duration":5.800000000000001,"slideTitle":"第791スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"フランドール・スカーレット","telop":"「そんなことよりも…」私はそう言いながら、服を動かし、彼に下着と生身をチラ見せする。「どう、先生といいことしない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.791.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"2234759C-8465-4BD8-8ADC-2D1D3B0A8CA9","title":"シーン 792","duration":5.4,"slideTitle":"第792スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"「でも…僕は…」僕は彼女をそう制止させようとするが、そう言いかける口を彼女は、そっと口付けをして封じてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.792.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/後ろ手口閉じ目閉じ.png"},{"id":"3A4600EF-1B65-4BE1-BDE2-AE7195A05B7F","title":"シーン 793","duration":3.5,"slideTitle":"第793スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"フランドール・スカーレット","telop":"「どう、このまま先生に身を任せてくれない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.793.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"4231C5AB-2DFA-4264-A137-172BC986202E","title":"シーン 794","duration":5.4,"slideTitle":"第794スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"僕はそう言われ、一瞬断ろうかと思ったが、雰囲気的に難しいと感じ、全身の力を抜いて、脱力する。「それじゃあ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.794.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"BBCB91E1-C894-440C-9D4A-20E3B40862B7","title":"シーン 795","duration":5.0,"slideTitle":"第795スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"フランドール・スカーレット","telop":"「ありがとう、それじゃあ、気持ち良くしてあげる。」\n私はそういい、彼の服を脱がすと、自らも服を脱いだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.795.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"DBBECF62-2F71-495E-B102-64CA11435D02","title":"シーン 796","duration":5.0,"slideTitle":"第796スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「んっ…」僕はふと目が覚めると、窓から朝日が差し込んでいた。そして、ふとある違和感を感じ、隣を見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.796.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"4BD2BD71-2BF1-43B1-86CB-74FA32036F72","title":"シーン 797","duration":5.5,"slideTitle":"第797スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕は、隣を見た瞬間に、裸のフランを見てしまい、さっとベッドから飛び出る。そして、ふと手元を見ると僕も裸だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.797.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"616552D3-406D-42B9-9E3C-F5B5C076D1C9","title":"シーン 798","duration":5.6000000000000005,"slideTitle":"第798スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕は、服を着るということが抜け落ちたまま、あたふたしていると、突如として扉をノックされ、レミリアの声が聞こえる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.798.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"5A33F106-4DFF-4914-B61B-C9B25C3E172B","title":"シーン 799","duration":4.800000000000001,"slideTitle":"第799スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"レミリア・スカーレット","telop":"「もう起きてるの、二人とも？起きているなら、返事をしなさい。じゃないと、勝手に扉を開けるわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.799.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"BF607166-4AF2-4CFF-BE9F-7F992B2BFF5C","title":"シーン 800","duration":5.800000000000001,"slideTitle":"第800スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕は、ふとフランの方を見ると、彼女は依然として裸のまますやすやと眠っていた。僕は、そのまま戸惑っていると、扉が開く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.800.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"A50C525E-D51E-4CD7-AD4A-85E39CF25ED1","title":"シーン 801","duration":5.4,"slideTitle":"第801スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"そして、部屋に入ってきた彼女は、みるみるうちに頬を赤く染めていた。「あの…レミリアさん…僕は…どうすれば…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.801.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/驚き.png"},{"id":"124F357A-03E6-498D-86D0-8879323E0224","title":"シーン 802","duration":3.5,"slideTitle":"第802スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"レミリア・スカーレット","telop":"「とりあえず、服を着たらどうなの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.802.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"7C3D84A8-FFF3-40E8-A750-06EE13F38EF0","title":"シーン 803","duration":5.4,"slideTitle":"第803スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕は、彼女にそう指摘され、自分が裸のままであることに気づく。そして、ベッドの下に服があり、それを取って切る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.803.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"79FD82A6-0EBA-49B2-82DF-57663DBD249F","title":"シーン 804","duration":5.7,"slideTitle":"第804スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"レミリア・スカーレット","telop":"「とりあえず、私は食堂に戻るから、あなたもフランを起こして、ささっと食堂に来なさい、そこでこの件は話しましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.804.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"3ACA6B30-2596-48C7-B5CB-9F8E6D138C1D","title":"シーン 805","duration":4.5,"slideTitle":"第805スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"彼女はそういうと、部屋をさっていった。\nそれから、静けさが部屋に戻ると、フランが目を覚ます。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.805.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"417B20DF-E1E4-4489-8008-60DEEF507B58","title":"シーン 806","duration":3.5,"slideTitle":"第806スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「んっ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.806.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/寝起き顔.png"},{"id":"26363004-D314-4310-9442-033C77DA681A","title":"シーン 807","duration":3.5,"slideTitle":"第807スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「あれ…ここは…」\n私は、そう言いながら、だんだんと頭が冴えてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.807.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/寝起き小口開け.png"},{"id":"F12AF81D-41A6-4591-8E92-B592CBD24AB0","title":"シーン 808","duration":3.5,"slideTitle":"第808スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「紅夢くん…昨日はごめんなさい、真夜中に襲いかかって…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.808.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"241AE507-E380-430B-AF4A-0961AFDCE793","title":"シーン 809","duration":3.5,"slideTitle":"第809スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「それより、服を着てくれませんか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.809.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"E65D3DC7-722E-4C0C-B9FB-7491F7403D4A","title":"シーン 810","duration":3.5,"slideTitle":"第810スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「とりあえず、着替えるから、部屋から出てくれない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.810.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"407F04EA-F514-4633-9F2D-A15F14CF2BDA","title":"シーン 811","duration":5.7,"slideTitle":"第811スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「分かりました…、着替えたら食堂に来てください。僕は、先に食堂に向かっているので。」僕はそういうと、部屋を離れた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.811.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"74B0CEC8-FE81-4D31-A2F0-011BF57F157F","title":"シーン 812","duration":3.5,"slideTitle":"第812スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕は、それから食堂に来ると、すでに朝食の準備ができていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.812.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png"},{"id":"14F060D7-3285-437A-896C-8DC939708F5F","title":"シーン 813","duration":4.5,"slideTitle":"第813スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"それから、10分程度でフランもやってくる。\nすると、挨拶を済ますと、3人で朝食を食べ始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.813.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png"},{"id":"6F64CDF0-4F1B-4C9E-96D7-ED9E2F9E63A6","title":"シーン 814","duration":3.5,"slideTitle":"第814スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「それで、〇〇を卒業した気分を教えてくれるかしら、紅夢。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.814.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"F997C59A-3431-4C9A-A2D1-2D5A6F1DCA00","title":"シーン 815","duration":4.3,"slideTitle":"第815スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「あの、〇〇ってなんですか…？」\n僕は、フランが頬照りながら驚いている姿を見ながらいう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.815.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"25DCC5FA-1CB0-4CE3-8045-798C0EC900ED","title":"シーン 816","duration":3.5,"slideTitle":"第816スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「こんなこと言わなくてもわかるでしょ。それで、どうなの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.816.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"8A0D22F5-099E-4863-B281-F2856F664F88","title":"シーン 817","duration":5.7,"slideTitle":"第817スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕は、そういうとレミリアの表情と今までの会話から、その言葉の意味を推測する。「フランさんならわかると思いますが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.817.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"D1C4A07C-5B43-4FD7-85BB-EA33973FBC69","title":"シーン 818","duration":3.5,"slideTitle":"第818スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"それから僕が二人に告げた、ある内容に二人は驚くのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.818.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（驚く）.png"},{"id":"BDB1B174-4DA8-4647-9DA2-5C8EECB52DD4","title":"それから…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.819.jpeg","animationDuration":1.5},{"id":"4553D41D-9E04-410E-B779-08B8AF44048D","title":"シーン 820","duration":5.7,"slideTitle":"第820スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"それから、僕は、朝食を食べ終えて、身支度を整えると、フランに図書館の場所を聞いて、やってきた。そしてある本を探す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.820.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"0264F32F-9E4F-40D5-850C-95A266052D31","title":"シーン 821","duration":5.800000000000001,"slideTitle":"第821スライド","backgroundName":"04039E1E-32B0-5CF7-8D5F-42290235463E.jpg","characterName":"操夢","telop":"それから、目的の本がありそうな棚を見つけ、その棚をはじから見ていく。「あった。」僕はそう言い、その本を取り出し戻る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.821.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/04039E1E-32B0-5CF7-8D5F-42290235463E.jpg"},{"id":"D5AE2DFA-E3B0-4A53-BBF1-53F00EA266F3","title":"シーン 822","duration":5.4,"slideTitle":"第822スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そして、取り出した本は、「全国財閥高統一模試」の過去問集だった。そして、フランにもらった新品のノートを開く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.822.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"849B58E5-5725-46CB-9D62-2D71795B7778","title":"シーン 823","duration":5.4,"slideTitle":"第823スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そこから、僕は遠足の2週間前に受ける、その試験に向けた勉強を黙々と、この大規模な図書館で進めていくのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.823.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"6FF6C983-425A-4879-B951-75DFE1865D73","title":"一方でフランとレミリアは…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.824.jpeg","animationDuration":1.5},{"id":"F97C2A5F-EA4F-4B5B-9E76-17D650E4E941","title":"シーン 825","duration":3.5,"slideTitle":"第825スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「ねぇ、フラン。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.825.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"36E52B71-33ED-48ED-869C-78BE28E8C19E","title":"シーン 826","duration":3.5,"slideTitle":"第826スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"フランドール・スカーレット","telop":"「なに、お姉様？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.826.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"F9A4D9F5-7407-4919-8D84-FBF0A570FD78","title":"シーン 827","duration":3.5,"slideTitle":"第827スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「フランは、昨晩の飲み会、どこまで覚えてるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.827.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"59535419-8254-4070-A709-10893EB3BC6B","title":"シーン 828","duration":3.5,"slideTitle":"第828スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"フランドール・スカーレット","telop":"「えっと…」私はそう言われ、記憶を遡る。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.828.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"C6C3FA69-7847-4F2A-A108-894EB37A7103","title":"シーン 829","duration":5.300000000000001,"slideTitle":"第829スライド","backgroundName":"nc228271_居酒屋の個室.jpg","characterName":"フランドール・スカーレット","telop":"昨晩、彼女が図書館に行った後、私とお姉様は、もともとこの屋敷に住んでいた咲夜たちとの飲み会に向かった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.829.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc228271_居酒屋の個室.jpg"},{"id":"DE9DDE58-85A8-4804-9B75-D74CE6888A35","title":"シーン 830","duration":5.1000000000000005,"slideTitle":"第830スライド","backgroundName":"nc228271_居酒屋の個室.jpg","characterName":"フランドール・スカーレット","telop":"すると、始まってからすぐに、パチュリーが私に、祝いの言葉を告げる。その後、順々に言葉を聞き終えていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.830.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc228271_居酒屋の個室.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"1F49DF68-6B80-4570-9988-E4B62DA9C509","title":"シーン 831","duration":4.800000000000001,"slideTitle":"第831スライド","backgroundName":"nc228271_居酒屋の個室.jpg","characterName":"フランドール・スカーレット","telop":"私は、彼女たちからの祝いの言葉に少し困惑する。\nなぜなら、彼との結婚が決まったわけではないからだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.831.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc228271_居酒屋の個室.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"A178DF99-BDAC-45A7-98EA-304A5AEF45CF","title":"シーン 832","duration":5.0,"slideTitle":"第832スライド","backgroundName":"咲夜（困る）.png","characterName":"フランドール・スカーレット","telop":"すると、咲夜が私になぜ、困っているかを聞いてくる。\n私が戸惑っていると、お姉様がそのことを伝える。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.832.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/咲夜（困る）.png"},{"id":"79AF5709-E473-48BB-9141-871C2E671C44","title":"シーン 833","duration":4.6000000000000005,"slideTitle":"第833スライド","backgroundName":"咲夜（弱る）.png","characterName":"フランドール・スカーレット","telop":"その言葉に皆は、謝り、少しばかし空気が暗くなりかけてたところに、赤ワインとお通しが出てくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.833.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/咲夜（弱る）.png"},{"id":"F28E33E5-3612-440E-80CB-216D62DE0FF7","title":"シーン 834","duration":5.6000000000000005,"slideTitle":"第834スライド","backgroundName":"咲夜（弱る）.png","characterName":"フランドール・スカーレット","telop":"そして、それからしばらく経つと、お酒だけ飲んでいた私とお姉様は…、私はその先を思い出そうとするが、思い出せない。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.834.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/咲夜（弱る）.png"},{"id":"6290FE1F-4A29-4D49-839C-C9D8AA3817CE","title":"シーン 835","duration":5.4,"slideTitle":"第835スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「確かに、あの時は、私とフランだけすでに食事を済ませて、酒だけをのが、原因なのは分かっている、けど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.835.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"B5C0D779-2AF4-46B2-81C4-B210834DCD61","title":"シーン 836","duration":5.5,"slideTitle":"第836スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「私がフランにいう資格は、ないかもしれないけど、少しばかし、アルコールの自己管理くらい、出来たらどうかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.836.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"B0614162-8177-4435-9145-5941E75A333C","title":"シーン 837","duration":5.300000000000001,"slideTitle":"第837スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"フランドール・スカーレット","telop":"私は、お姉様の指摘通りなので、頭を抱えて考える。だが、だんだんとオーバヒートしているような感覚がしてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.837.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（弱る）.png"},{"id":"9FABF601-0A98-4208-9D38-6939AE104C0E","title":"シーン 838","duration":4.800000000000001,"slideTitle":"第838スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"私はそこで、「しまった」とつぶやく。だが、\nそう呟いている間にも、フランはこちらに攻撃をしてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.838.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"C813BFF8-19AD-4066-8E19-1C3802F81964","title":"シーン 839","duration":4.9,"slideTitle":"第839スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"私は、彼女の攻撃を避けながら、あるものを探す。\nすると、ハッと思い出し、その場所に向かい、疾走する。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.839.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"5DBB59AE-2828-4686-B05C-256016507511","title":"シーン 840","duration":4.9,"slideTitle":"第840スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"そして、フランの攻撃を避けながら、なんとか取り出したそれを、フランの攻撃の隙をつき、ぷつっと刺す。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.840.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"82A4FCED-5A20-4F63-88FB-761D7568C0DE","title":"シーン 841","duration":3.5,"slideTitle":"第841スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"フランドール・スカーレット","telop":"「あれ…今私は、なにしてたんだっけ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.841.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"20D5460D-4CE1-4F78-9632-FCF54C1835D5","title":"シーン 842","duration":3.5,"slideTitle":"第842スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「とりあえず、彼のいる図書館に行ってきたらどうかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.842.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"0FD45873-952D-4284-A8B5-D7793D47917E","title":"シーン 843","duration":3.5,"slideTitle":"第843スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"フランドール・スカーレット","telop":"「じゃあ、図書館にいってくるね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.843.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"0B0EA400-DF4D-4D08-8E34-0CFE8410A19C","title":"シーン 844","duration":3.5,"slideTitle":"第844スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"フランはそういうと去っていった。\nそして、私は先ほど使用したそれをみる。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.844.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg"},{"id":"234340FE-5112-4118-8C5A-C00EA295B173","title":"シーン 845","duration":5.800000000000001,"slideTitle":"第845スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"これは、注射器で、その中には、ある人物の血液が入っていた。\nその人物は、今、彼が元いた家に住んでいる女性のものだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.845.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg"},{"id":"C8F0B205-72D2-48F8-B086-360314BD6837","title":"シーン 846","duration":5.7,"slideTitle":"第846スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「どっかのタイミングで、彼から採血しないとね…」特殊な体を持つ二人の血液は、フランの狂気を瞬時に、鎮静化できた。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.846.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg"},{"id":"49C712E4-FBBC-42D2-85ED-817EA263A081","title":"シーン 847","duration":5.7,"slideTitle":"第847スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"このことを知るまでは、フランの狂気を肉弾戦で食い止めるか、一瞬の隙をついて気絶させるかの二択しかなかったのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.847.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg"},{"id":"9972C7FC-3785-48DA-AA34-EC6CEF0AC881","title":"シーン 848","duration":5.300000000000001,"slideTitle":"第848スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"彼とその女性には、狂気というものは存在しないが、別の要素を持っていた。この流れは、今後も続くかもしれない。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.848.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg"},{"id":"23ECE441-FF3F-457A-85B5-21798254F6CD","title":"シーン 849","duration":3.5,"slideTitle":"第849スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"私は、それを見ながら、そんなことを考えるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.849.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg"},{"id":"675A8058-1232-483A-8277-48EB33F4CA1A","title":"シーン 850","duration":3.5,"slideTitle":"第850スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"僕が、図書館で勉強していると、フランがやってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.850.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"51C4F517-6BFD-44DA-B33E-1C5BD26217F4","title":"シーン 851","duration":3.5,"slideTitle":"第851スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"フランドール・スカーレット","telop":"「何をしているの？」\n作成者：zuyasi","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.851.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"8AA9EDE0-66DF-4BB3-8A6A-9F11E9D78155","title":"シーン 852","duration":3.5,"slideTitle":"第852スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"「今度受ける試験の勉強ですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.852.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"096B4A36-58FE-4C87-9E55-4ACAF62365AC","title":"シーン 853","duration":3.5,"slideTitle":"第853スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"フランドール・スカーレット","telop":"「どんな試験を受けるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.853.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"473DC43F-383C-46FC-91A4-9F83239B3DC6","title":"シーン 854","duration":4.4,"slideTitle":"第854スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"「全国財閥高統一模試ですよ。」\n僕はそういうと、勉強を再開した。\n元女子校の日常\n〜彼が図書館で勉強していると、フランが話しかけてきて…〜","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.854.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"C1CF2CDA-B76F-4622-8FB2-295B8472DD7F","title":"シーン 855","duration":4.5,"slideTitle":"第855スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから、あっという間に、時間が経ち、\n気がつけば転校してから、半月の程の期間が経っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.855.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"6DBD275B-95DE-462A-8AE9-47053D2400CE","title":"シーン 856","duration":5.9,"slideTitle":"第856スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、今日は、この2週間ほどで勉強した全国財閥高統一模試を受ける日だった。すると、教室の扉が開き、担任が入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.856.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"EAFDEBBA-A544-4D51-8E27-F556D62B210F","title":"シーン 857","duration":5.1000000000000005,"slideTitle":"第857スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、素早く席を立ち上がり、クラスメイトに合わせた朝の挨拶をする。そして、彼女の合図とともに席に座る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.857.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"D1581755-C85E-4263-AAB9-1696E9C1AC35","title":"シーン 858","duration":5.9,"slideTitle":"第858スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「それでは、朝礼を始めます。今日は、毎月恒例の定期ミニテスト日です。全時限でミニテストがあるので、覚悟してください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.858.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"C4D54A30-1FBF-437A-B7E7-A8D6B39092BE","title":"シーン 859","duration":5.2,"slideTitle":"第859スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、彼女の発言に驚く。ミニテストがあるなんて聞いてなかったからだ。だが、彼女がある衝撃的な発言をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.859.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"0EAA5026-6CCC-4DF8-8F43-8936E7F9C74C","title":"シーン 860","duration":5.7,"slideTitle":"第860スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「藤原さん、あなたは今日、ミニテストの代わりに、体力測定を行いますから、このあとすぐに、萃香先生を訪ねるように。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.860.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"FB79C9D7-E8E2-4617-85A8-42851E596DEF","title":"シーン 861","duration":3.5,"slideTitle":"第861スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「あっ…、はい…、分かりました…」僕はそう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.861.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"EE95D8E1-B47F-4428-9D62-7272C082D485","title":"シーン 862","duration":3.5,"slideTitle":"第862スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「連絡は以上です。皆試験に励むように。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.862.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"4F648994-320D-47B2-B170-AF44D21450D9","title":"シーン 863","duration":5.2,"slideTitle":"第863スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女はそういうと、去っていった。僕は、ぼんやりとしていると、突如として、先ほど言っていた人が入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.863.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"76CB8519-FC5D-4B5E-B909-CD0533BD3DC4","title":"シーン 864","duration":3.5,"slideTitle":"第864スライド","backgroundName":"ペーストされた画像.tiff","characterName":"萃香","telop":"「藤原くん、ボケっとしてないで、\nさっさと私の後に着いてきなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.864.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"965A0D57-CDDF-491F-BAC3-9864068A4E27","title":"シーン 865","duration":3.5,"slideTitle":"第865スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はそう彼女に言われ、後ろをついていくのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.865.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"4804EA7E-C018-4E31-A0BF-A1AA2760D6CA","title":"シーン 866","duration":3.5,"slideTitle":"第866スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"そして、彼女についていくと、やってきたのは校庭だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.866.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"1EAC38B4-3D5E-45FC-A71B-B5685F9747F0","title":"シーン 867","duration":3.5,"slideTitle":"第867スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「準備体操済ませて、とりあえずグラウンドを3周しなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.867.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"F86F843B-BE1E-48E2-9CEE-15BEFEAB5C6A","title":"シーン 868","duration":5.2,"slideTitle":"第868スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「分かりました…」僕は、彼女の有無を言わさぬ態度に、ある一種の恐ろしさを感じながら、準備体操をして走る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.868.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"5BE4BE6D-702B-4C77-B5E7-D1F35CE44970","title":"シーン 869","duration":3.5,"slideTitle":"第869スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「次は、樽投げだ。この酒樽を思いきっり投げ飛ばしなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.869.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"BC0293CB-117B-42F9-8DD5-377241618879","title":"シーン 870","duration":3.5,"slideTitle":"第870スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は彼女に言われるがままに、酒樽を一所懸命に投げる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.870.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"1C267C2E-DF9E-498D-B102-B7C6FD86B2AA","title":"シーン 871","duration":3.5,"slideTitle":"第871スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「今度は、握力だ。酒樽を持ってみなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.871.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"24C3C896-BA56-482E-BE77-533E32525B7F","title":"シーン 872","duration":3.6,"slideTitle":"第872スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕が、その酒樽を持つと、\n彼女はどこからともなく、酒樽をもう一つ取り出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.872.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"0D5775D6-4C50-43E0-97C3-F0081393E7E4","title":"シーン 873","duration":3.5,"slideTitle":"第873スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「中の酒をこぼさぬように、酒樽を持ち替えなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.873.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"95C5556C-FB0D-4C11-8114-2E1AD7F08B04","title":"シーン 874","duration":5.5,"slideTitle":"第874スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は彼女が新しい酒樽を地面にそっと置くと、すでに持っていた樽を地面に置き、新しい方を持つ。すると、力がかかる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.874.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"B7616A91-4386-4708-B898-4BA22202A21E","title":"シーン 875","duration":5.0,"slideTitle":"第875スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"すると、彼女は、もう一つ酒樽を置くと、それも持つようにいう。僕は、慎重に手を動かして、その樽を持つ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.875.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"5B2CB3D5-58FF-45F9-9A25-0F0C62B93257","title":"シーン 876","duration":5.0,"slideTitle":"第876スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"それから、僕は、握力がそこをつくまで、酒樽を何回も持たせられ、それが終わると、10分の休憩が挟まれた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.876.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/怒る.png"},{"id":"F2B96123-F549-446D-B99C-399F61C17820","title":"シーン 877","duration":4.4,"slideTitle":"第877スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"それが終わると、彼女は、今度どこからか持ってきた\nメモリがついているマットを、地面に敷く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.877.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"C012191B-47E5-4932-9F82-AA789D84EE33","title":"シーン 878","duration":3.5,"slideTitle":"第878スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「今敷いたこのマットに向かって飛んでみなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.878.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"1ABC280B-F9A6-426C-9ED0-4A4ABEB9EA07","title":"シーン 879","duration":5.300000000000001,"slideTitle":"第879スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は、そう言われると、マットに向かって飛ぶ、そして、飛び終えると同時に、文句を言われ、彼女が手本を見せる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.879.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"1BF670EF-E688-4B74-B7D3-B2D004F06554","title":"シーン 880","duration":3.5,"slideTitle":"第880スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「今私が見せたように、飛んでみなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.880.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"D94F4F78-872C-4BE5-AC55-CC487D33BE19","title":"シーン 881","duration":3.5,"slideTitle":"第881スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は、彼女にそう言われ、\n彼女が本当に人なのかを疑いながら、飛ぶ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.881.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"E0CA37E6-D7E6-45A2-A93D-9F09524569F6","title":"シーン 882","duration":5.300000000000001,"slideTitle":"第882スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"それが終わると、彼女は、いきなり僕をマットの上に押し倒す。\nすると、彼女を僕の足元を押さえ込み、説明をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.882.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"3DC9EFCF-5C76-4FE0-A2DA-3BA85258FC3E","title":"シーン 883","duration":3.5,"slideTitle":"第883スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「今から、時間を測るから、上体起こしをしなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.883.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"331E8046-5E1F-4AED-A1EC-86751A17621B","title":"シーン 884","duration":5.7,"slideTitle":"第884スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は、すでに動けない状態でそう言われ、彼女が時間を測り始めると、残っている力を引き出しながら、言われた通りにする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.884.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"D6DAC4E3-C9B1-4121-9F90-CC394BD9B36A","title":"シーン 885","duration":4.2,"slideTitle":"第885スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"すると、彼女は休憩だと言い、10分間の休憩が再び入る。\n彼女はその間に、マットを片す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.885.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"539D8B34-4D6E-4C91-AB8A-1392EBF1E480","title":"シーン 886","duration":5.300000000000001,"slideTitle":"第886スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「次は、反復横跳びだ、そこに立って私が時間を測り始めたら、動き出しなさい。フライングはするんじゃないぞ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.886.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"402A05C5-09A9-42D1-A4DE-AAC2C75AE657","title":"シーン 887","duration":4.9,"slideTitle":"第887スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は、すでに息切れが起きていたが、なんとか深呼吸で落ち着かせると、彼女の合図に合わせて、動き出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.887.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"24DA1A24-41DF-479F-8B62-D791DECE61AF","title":"シーン 888","duration":4.1000000000000005,"slideTitle":"第888スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「次は、制限時間内に、グラウンドを1周しなさい。\nそれが無事に終われば、昼休憩だ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.888.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"2465E677-17DB-44A8-A86F-DB681B384414","title":"シーン 889","duration":4.800000000000001,"slideTitle":"第889スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「…は…はい…」僕はなんとかそう返し、彼女が1分のタイマーをスタートさせると、僕は全力疾走する。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.889.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"6246E970-A5F9-4A2A-B963-A28D3BAF69C5","title":"シーン 890","duration":4.0,"slideTitle":"第890スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"萃香","telop":"「それじゃあ、30分後にまた、ここにきなさい。\nそしたら、最後に1500m走だ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"萃香","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.890.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/萃香（怒る）.png"},{"id":"5D88168D-D323-4426-9EB3-7F398453F153","title":"シーン 891","duration":4.800000000000001,"slideTitle":"第891スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"僕は、頭の中で鐘が鳴ったようなガーンという感覚を感じながら、ふと思い出す。「荷物、教室の中だ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.891.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"519F7D34-98C3-4994-8C29-217F3ADC89F7","title":"シーン 892","duration":5.1000000000000005,"slideTitle":"第892スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"まだ、きっと校舎は試験中だから、入れない。それと、弁当を持ってきたかも忘れた。「お昼ご飯どうしよう…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.892.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"C9429323-10DA-4C91-B8E6-62C4AA7DC31B","title":"シーン 893","duration":3.5,"slideTitle":"第893スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"すると、誰かがこちらに駆け寄ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.893.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png"},{"id":"D83A9A41-FBFF-477D-A3AF-46C06570DA91","title":"シーン 894","duration":3.5,"slideTitle":"第894スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"美鈴","telop":"「大丈夫ですか、何があったんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"美鈴","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.894.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（驚く）.png"},{"id":"1F9E3F67-3E58-471C-B312-E12C30714AFE","title":"シーン 895","duration":4.9,"slideTitle":"第895スライド","backgroundName":"ColabGPU_1791199901_67118.png","characterName":"操夢","telop":"「…」僕は、すでにまともな言葉を発せなくなっていた。\nそして、彼女が困っているところで、気を失った。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.895.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791199901_67118.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/美鈴（困る）.png"},{"id":"33AC0710-0A04-4C49-AFAE-79DBC10E7B92","title":"彼が再び目覚めると…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.896.jpeg","animationDuration":1.5},{"id":"4D0F9C02-4F29-4008-8280-623901A753B3","title":"シーン 897","duration":4.800000000000001,"slideTitle":"第897スライド","backgroundName":"2026-10-26_19-50.png","characterName":"操夢","telop":"「ん…」僕は目が覚めると、そこはフランとの二人部屋だった。\nすると、フランが驚き、部屋を飛び出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.897.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"0E685626-60CE-4E4A-B9AA-19751A3E81DA","title":"シーン 898","duration":3.5,"slideTitle":"第898スライド","backgroundName":"2026-10-26_19-50.png","characterName":"レミリア・スカーレット","telop":"「あら、目が覚めたの、紅夢。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.898.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"B822ED05-01D1-4099-9C8F-4A5A383712C5","title":"シーン 899","duration":3.5,"slideTitle":"第899スライド","backgroundName":"2026-10-26_19-50.png","characterName":"操夢","telop":"「あの…僕は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.899.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"7DC52E56-A988-4288-92D6-18D6B46B3402","title":"シーン 900","duration":3.5,"slideTitle":"第900スライド","backgroundName":"2026-10-26_19-50.png","characterName":"レミリア・スカーレット","telop":"「試験と体力テストなら無事に終わったわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.900.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"0537E054-E625-4D3E-8386-251E8DB6C6DC","title":"シーン 901","duration":3.5,"slideTitle":"第901スライド","backgroundName":"2026-10-26_19-50.png","characterName":"操夢","telop":"「えっと…、なんでそのことを…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.901.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"4FB2E43F-795E-423F-BF99-783410764673","title":"シーン 902","duration":3.7,"slideTitle":"第902スライド","backgroundName":"2026-10-26_19-50.png","characterName":"レミリア・スカーレット","telop":"「そんなの、決まってるじゃない。私は、あなたの母親がわりなんだから…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.902.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア（困り）.png"},{"id":"09DF7151-0968-423A-8209-D346550D3EED","title":"シーン 903","duration":3.5,"slideTitle":"第903スライド","backgroundName":"2026-10-26_19-50.png","characterName":"フランドール・スカーレット","telop":"「私だって分かってるよ…紅夢くんのこと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.903.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/小口開け赤面.png"},{"id":"78019380-D2C8-4603-B46A-F098892CD68E","title":"シーン 904","duration":3.5,"slideTitle":"第904スライド","backgroundName":"2026-10-26_19-50.png","characterName":"レミリア・スカーレット","telop":"「それで、学校には馴染めたかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.904.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"6A2BAF9C-3278-4569-9CE5-6C2CE714B424","title":"シーン 905","duration":3.5,"slideTitle":"第905スライド","backgroundName":"2026-10-26_19-50.png","characterName":"レミリア・スカーレット","telop":"「ええ、少しずつですが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.905.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"3E55C1BF-409D-4F58-9C9A-D776770CBD10","title":"シーン 906","duration":5.0,"slideTitle":"第906スライド","backgroundName":"2026-10-26_19-50.png","characterName":"レミリア・スカーレット","telop":"「そう、じゃあ、今夜はもう遅いから、そのまま寝なさい。」\n私は、そういうと、そのまま部屋を出ていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.906.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/レミリア（微笑）.png"},{"id":"CB53F307-38DA-4224-9F3E-58417FA16F02","title":"シーン 907","duration":5.6000000000000005,"slideTitle":"第907スライド","backgroundName":"2026-10-26_19-50.png","characterName":"フランドール・スカーレット","telop":"「ほら、私も寝るから、ベッドで横になって、電気も消すから。」\n私が、そう促すと、電気を消して二人でベッドに入った。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.907.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-26_19-50.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"5E24D5C8-14D3-43BE-95AF-CCEA83203437","title":"その頃、ある場所では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.908.jpeg","animationDuration":1.5},{"id":"B386BC75-D7B3-4C6E-8909-CD3FFE68AA5A","title":"シーン 909","duration":5.4,"slideTitle":"第909スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"私が家に帰ってくると、なぜか霊夢と魔理沙の二人がリビングで私の方に視線を向けていた。何となく嫌な予感がする。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.909.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"4257C6B8-A980-41B7-A91D-BAB569BAA389","title":"シーン 910","duration":3.5,"slideTitle":"第910スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"博麗霊夢","telop":"「ねぇ、あなた、私と魔理沙のどっちを選ぶの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.910.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"E67AEFFB-0204-46F5-BAFA-726145DD12FF","title":"シーン 911","duration":3.5,"slideTitle":"第911スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"霧雨魔理沙","telop":"「まさか、どっちもなんていうのか、妹紅さん…」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.911.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/魔理沙箒・帽子なし微笑.png"},{"id":"0C5026A9-7F8F-4FA2-A5AE-32EDDEA0D745","title":"シーン 912","duration":5.5,"slideTitle":"第912スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"息子がいなくなって魔理沙がやってきてから、2週間ちょっと、その間に、この三角関係になり、私に危機が訪れていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.912.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"3F16747B-A5B6-4610-947B-EDE4E219ABB7","title":"シーン 913","duration":5.9,"slideTitle":"第913スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"妻を選べば、ビームが飛んできて、魔理沙を選べば、妻の怒声が響いてしまうこの状況に私は、ただ無言になるしか出来なかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.913.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"6910B065-3CCF-4D47-9C89-1804A1BD6148","title":"シーン 914","duration":5.7,"slideTitle":"第914スライド","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","characterName":"藤原妹紅","telop":"お願いだから、早く戻ってきてくれ、息子よ…。私は叶いもしないはずのそんな願いを抱きながら、この状況をやり過ごした。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.914.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/リビング（夜・照明ON・カーテン閉）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（微笑）.png"},{"id":"9C8382FC-5DB3-4A8A-BFE0-ACE66C539EA0","title":"シーン 915","duration":5.6000000000000005,"slideTitle":"第915スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"体力テストと、統一模試を受けてから数日が経ち、遠足まであと1週間を切った今日、僕は教室に入ると、自分の席に着く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.915.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"B0DA2E75-CD6D-45FE-A171-F537D61AAAB7","title":"シーン 916","duration":3.5,"slideTitle":"第916スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"すると、さとりがこちらに駆け寄ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.916.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"1E6E9235-059C-4CC8-8010-C2508EAAE045","title":"シーン 917","duration":3.5,"slideTitle":"第917スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「紅夢さん、あなた学内で、有名人になってますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.917.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"904530DD-E73A-43FA-8FF9-EDCA1B5AE998","title":"シーン 918","duration":4.9,"slideTitle":"第918スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっ…」僕はそう呟き、なぜ自分が有名人になったかを考える。そして、彼女に聞く。「なぜですか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.918.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"99B4659A-3384-479F-B7D1-F757E53FA7A8","title":"シーン 919","duration":5.6000000000000005,"slideTitle":"第919スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「本来なら大学受験に使われるような高難度の問題が入り混じった模試で満点を取り、文武両道な転校生が学内にいると…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.919.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"2F35EB36-BC60-4D26-A50E-93A0E8941E2B","title":"シーン 920","duration":5.2,"slideTitle":"第920スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「教員側も驚愕しているっていう噂と共に、生徒の間でも話題になってますよ。それこそ遠足と学校行事よりも…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.920.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"2C2935DC-A448-4C97-B034-82854D7AAD4D","title":"シーン 921","duration":5.9,"slideTitle":"第921スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「私が聞いた限りだと、あなたは1500mを数分で走り切った後に受けた模試で100点が出た、転校生だと言われてますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.921.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"4D448FA5-3945-46A1-8FBC-044CC7389998","title":"シーン 922","duration":5.5,"slideTitle":"第922スライド","backgroundName":"ペーストされた画像.tiff","characterName":"古明地さとり","telop":"「女子は、噂に敏感で、何でもかんでもすぐに広まるので、気をつけないと、後々面倒ごとに巻き込まれちゃいますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.922.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"F9AB0BA9-FB6D-437E-9E68-07AF851775EA","title":"シーン 923","duration":3.5,"slideTitle":"第923スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「えっと…」\n僕は、彼女から聞いたその内容に困惑するのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.923.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png"},{"id":"9E8DA511-91B7-4B7D-853E-87CB4D3AD301","title":"シーン 924","duration":5.2,"slideTitle":"第924スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから、さとりは自席に戻り、しばらくすると、教室の扉がチャイムと同時に開く。そして、担任が入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.924.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"83D1C156-52F2-463C-A77C-E969C588C712","title":"シーン 925","duration":5.2,"slideTitle":"第925スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕はいつものように、素早く立ち上がり、クラスメイトと同じタイミングで礼と挨拶をすると、彼女の合図で座る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.925.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"2B09082D-7697-43C4-812B-05482AAADB6D","title":"シーン 926","duration":5.7,"slideTitle":"第926スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「それでは、朝礼を始めます。今日は、テスト返却の後は、遠足に向けた、全校集会なので昼食後速やかに移動するように。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.926.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"CEF997B4-39EF-4550-B8B6-4D83824FFEBF","title":"シーン 927","duration":5.300000000000001,"slideTitle":"第927スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「それと藤原さんは、今学園内で流れている情報の真意を確かめるので、朝礼後、速やかに職員室を訪ねるように。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.927.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"6AF1D68D-19F6-46FD-ADC5-378926DE0EF3","title":"シーン 928","duration":3.5,"slideTitle":"第928スライド","backgroundName":"ペーストされた画像.tiff","characterName":"東風谷早苗","telop":"「今日の連絡は以上です。今日も1日、勉学を励みましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.928.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"EBDB889C-01D6-4FA3-87E7-3B97B307FBD8","title":"シーン 929","duration":4.3,"slideTitle":"第929スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"彼女はそういうと、去っていた。\n僕は、きょとんとしながら、ふと我に帰り、職員室に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.929.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"61691046-8FA6-4A54-8862-B566EAEBEC79","title":"シーン 930","duration":3.5,"slideTitle":"第930スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"そして、僕が職員室に来ると、ある女性がやってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.930.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"86800F80-CE22-4E9A-8575-CDC22127B208","title":"シーン 931","duration":5.1000000000000005,"slideTitle":"第931スライド","backgroundName":"ペーストされた画像.tiff","characterName":"十六夜咲夜","telop":"「藤原さん、早速ですが、別室に移動して、あなたの話を聞かせてもらうので、私の後についてきてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.931.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"9B802BD9-0DF3-40A4-BF14-321B98C9DCEE","title":"シーン 932","duration":3.5,"slideTitle":"第932スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"僕がそう言われ、やってきたのは被服室だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.932.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png"},{"id":"8EA680F2-2A29-412D-951F-EA9BE6691617","title":"シーン 933","duration":3.5,"slideTitle":"第933スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「それで、こないだの体力テスト、どうでしたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.933.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"8035C3C2-5F55-47BF-A1F4-EDFAFBB3109F","title":"シーン 934","duration":3.5,"slideTitle":"第934スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「えっと…僕に取っては、負荷が大きいテストでした…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.934.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"30113B69-D738-461D-92CC-747B79393236","title":"シーン 935","duration":3.5,"slideTitle":"第935スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「そうですか…それで、どこまでの記憶がありますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.935.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"20F957C3-8FDD-4F10-919E-6F470DE165EA","title":"シーン 936","duration":3.5,"slideTitle":"第936スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「確か…グラウンドを全力疾走したところまでです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.936.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"692523C6-E112-4A1A-856B-FAC85DF7B95D","title":"シーン 937","duration":3.5,"slideTitle":"第937スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「それで、次に目が覚めた時、あなたはどこにいましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.937.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"39CB2DED-91D9-4754-B8FE-57D0B6AE9DBB","title":"シーン 938","duration":3.5,"slideTitle":"第938スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「家の寝室です…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.938.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"569F8B68-7942-430D-AC61-ED422B735297","title":"シーン 939","duration":3.5,"slideTitle":"第939スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「ちなみに、その間の記憶は、まったくありませんか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.939.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"8EBB22E1-5289-4274-AAA5-0C8491A613D2","title":"シーン 940","duration":3.5,"slideTitle":"第940スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「ええ…、でも僕は、ある意味、慣れっこですよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.940.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"F11A1A4F-91A5-4400-89EE-F446775983E5","title":"シーン 941","duration":3.5,"slideTitle":"第941スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「そう言える理由は？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.941.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"A15D734C-F54E-4A9B-B36E-EBE4C97EE8AC","title":"シーン 942","duration":3.8000000000000003,"slideTitle":"第942スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「その内容話すと、少なくとも1時間は必要ですけど、\nそれでも聞きたいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.942.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"22AB55E8-CFF1-49F5-BF37-9DF25981EFD3","title":"シーン 943","duration":3.5,"slideTitle":"第943スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「ええ、あなたの心身にかかる事柄ですから、\nぜひ、聞かせてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.943.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"4C7EE76A-0F95-4C3F-BFE4-739FCA47A4AC","title":"シーン 944","duration":3.5,"slideTitle":"第944スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"僕は、彼女の意思を確認すると、過去を思い返しながら話す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.944.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"32915E31-9ECF-431E-A233-DC55C7A84DD1","title":"シーン 945","duration":3.5,"slideTitle":"第945スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「それで、あなたはこの学校に転校して、良かったですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.945.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"68F6EEAA-6196-4E5F-8095-2E895020FDA8","title":"シーン 946","duration":5.5,"slideTitle":"第946スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「ええ、前の学校と比べると、かなり良いです。母に、母の母校に転校したいと言って、良かったと僕は思っています。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.946.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"3FB977F5-4BD1-420F-9E53-93A66E71AF66","title":"シーン 947","duration":5.7,"slideTitle":"第947スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「そうですか…、ところで話の節々から、あなたの記憶には、欠けているところがありますが、何か心当たりはありますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.947.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"F1BAE720-2921-49F0-97B4-EFF4E9F60642","title":"シーン 948","duration":5.6000000000000005,"slideTitle":"第948スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「…正直に言って分からないです。小さかった頃は、それこそ些細な違いで、記憶が欠け始めたのは、中学からですから…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.948.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"A7D7A65F-3B50-429D-9FB7-D5F284A1554E","title":"シーン 949","duration":5.6000000000000005,"slideTitle":"第949スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「…ただ、証拠を出せというのなら、僕のこの身体が、それを示してます…、正直にいうと人様には見せたくないですが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.949.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"36D6376D-BDFB-493B-8E27-7379CED56497","title":"シーン 950","duration":5.7,"slideTitle":"第950スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「そうですか…。ところで、あなたは、この間の模試を受けている時の様子と、午後の1500m走の様子を見たいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.950.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"3E46C72B-9E88-46C8-9EBB-DA5AE0012A94","title":"シーン 951","duration":3.5,"slideTitle":"第951スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「えっ？」僕は、彼女の急な質問に、そう返してしまう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.951.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"1B20FADF-8D98-45EA-B562-32609D03B16D","title":"シーン 952","duration":5.0,"slideTitle":"第952スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「もし、見たいのなら、教員用のPCにデータが保存されているので、お見せできますが…、どうしますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.952.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"873B2F8D-1676-4AED-BFF2-B99E5397D41A","title":"シーン 953","duration":5.800000000000001,"slideTitle":"第953スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「えっと…」僕はふと迷う。確かに、こないだの気を失っている間に、自分が何をしてかを見たいが、見たくない気持ちもある。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.953.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"38BB75F5-7A95-4FF1-A054-3A8B3E8CAA3D","title":"シーン 954","duration":3.5,"slideTitle":"第954スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"「いや、いいです…」僕は、それから彼女にそう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.954.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"39A507AA-5046-449B-B62A-CABAB6AF73A6","title":"シーン 955","duration":5.4,"slideTitle":"第955スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"「そうですか…、最後に一つだけ、こないだ渡した例の遠足に関する条件ですが、無事に満たしましたよ、では失礼。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.955.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"60011A1E-009E-4A60-94BA-6768D81C7D99","title":"シーン 956","duration":5.7,"slideTitle":"第956スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"操夢","telop":"彼女はそういうと、部屋をさっていった。僕は、ゆっくりと立ちあがろうとすると、突如として頭痛が走り、床に崩れ落ちる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.956.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png"},{"id":"CE05B220-7848-48D2-844C-A5AE0D57631C","title":"シーン 957","duration":3.9000000000000004,"slideTitle":"第957スライド","backgroundName":"ColabGPU_1791195025_33546.png","characterName":"十六夜咲夜","telop":"そして、僕の様子を見に戻ってきた彼女を、\n一瞬見ると、そのまま気を失うのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.957.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791195025_33546.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/咲夜（驚く）.png"},{"id":"120A2915-95CA-4A01-8D88-9A85FEF96D18","title":"彼がふと気がつくと…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.958.jpeg","animationDuration":1.5},{"id":"96AB10C4-1D20-4150-934A-7FDD738A9AB4","title":"シーン 959","duration":3.8000000000000003,"slideTitle":"第959スライド","backgroundName":"ColabGPU_1791193839_80109.png","characterName":"操夢","telop":"僕はふと気がつくと、そこはトイレだった。\nそして、手を洗ってから、トイレを出る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.959.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ColabGPU_1791193839_80109.png"},{"id":"0EF13587-D5B5-4FF5-A609-EA13CF5C5DA3","title":"シーン 960","duration":5.4,"slideTitle":"第960スライド","backgroundName":"nc485831_学校の廊下（日中）.jpg","characterName":"操夢","telop":"そして、学校の廊下を歩いているときに、ふと午後は、全校集会だったことを思い出す。そして、僕は体育館に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.960.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc485831_学校の廊下（日中）.jpg"},{"id":"4868C870-3B89-44F5-B2CF-F83E4B206E1E","title":"シーン 961","duration":5.5,"slideTitle":"第961スライド","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","characterName":"操夢","telop":"僕が体育館に来ると、すでにほとんどの生徒や児童が集まっているようだった。僕は、ふと周りを見渡し、ある列に入る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.961.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg"},{"id":"64717BBB-8C8D-4188-ADAF-8F85F67C1A64","title":"シーン 962","duration":3.5,"slideTitle":"第962スライド","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","characterName":"操夢","telop":"それから、数時間の間、遠足の説明を聞くのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.962.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg"},{"id":"F700E7AA-56BA-4D1B-B2B6-5B4CE9A591B9","title":"説明会が終わり…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.963.jpeg","animationDuration":1.5},{"id":"174B66DE-0153-4843-B678-AE6517B9CDC0","title":"シーン 964","duration":4.800000000000001,"slideTitle":"第964スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕は、朝と同じように礼と挨拶をして、数分程度の短い週例を終えると、そのまま、学校の校門に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.964.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"6C4DD4B8-05C8-4CFD-B3B1-0F053F8CF394","title":"シーン 965","duration":4.5,"slideTitle":"第965スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が、学校の校門に来ると、ある車が門の前に止まっていた。\nすると、中からフランが降りてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.965.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"DD2E0700-E69C-4098-BC9F-B8B1FF413A10","title":"シーン 966","duration":3.5,"slideTitle":"第966スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「学校、お疲れ様、紅夢。とりあえず、車に乗って。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.966.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"E8092C64-5357-437D-8B12-FB2B9C9DC252","title":"シーン 967","duration":4.9,"slideTitle":"第967スライド","backgroundName":"02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","characterName":"フランドール・スカーレット","telop":"僕は、彼女にそう言われ、車に乗ると、数十分で高速に入る。\n「あの、フランさん、どこに行くのですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.967.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg"},{"id":"54471F6A-3505-40CD-B9B8-94C184E1259C","title":"シーン 968","duration":3.5,"slideTitle":"第968スライド","backgroundName":"02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","characterName":"フランドール・スカーレット","telop":"「それは、向こうに着くまで秘密。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.968.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（余裕）.png"},{"id":"A962F7B9-509C-4AEC-8A67-ABC26CD37734","title":"シーン 969","duration":5.300000000000001,"slideTitle":"第969スライド","backgroundName":"02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg","characterName":"フランドール・スカーレット","telop":"僕は彼女にそう返され、前に向き直る。それから、僕はフランの隣の助手席で、ただぼーっと車窓を眺めるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.969.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/02AD8E04-C216-5029-82B0-EA4A70A993B1.jpg"},{"id":"D2E4422F-E145-49FC-94F7-1EB0F45D4CCD","title":"シーン 970","duration":5.7,"slideTitle":"第970スライド","backgroundName":"image53.jpeg","characterName":"操夢","telop":"僕は、フランに連れられて、とある山間のキャンプ場に来ていた。そして、僕は、彼女にキャンプ用品を持ってきたかを聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.970.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image53.jpeg"},{"id":"59EA7D67-F034-428B-A898-F57681FF2AD4","title":"シーン 971","duration":5.2,"slideTitle":"第971スライド","backgroundName":"image53.jpeg","characterName":"フランドール・スカーレット","telop":"「もちろん、持ってきたよ。」私はそう言い、車からテントなどのキャンプ用品を取り出し、テントの設営をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.971.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image53.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"C527960F-7B4A-4B72-923C-E94524671547","title":"シーン 972","duration":5.4,"slideTitle":"第972スライド","backgroundName":"image53.jpeg","characterName":"操夢","telop":"それから、数分から数十分の間、彼女は黙々と、テントの設営やキャンプの準備を進めていく。「何か手伝いますか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.972.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image53.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"8A74967F-0D00-4081-BC42-4FFB512EBEB8","title":"シーン 973","duration":3.5,"slideTitle":"第973スライド","backgroundName":"image53.jpeg","characterName":"フランドール・スカーレット","telop":"「いや、手伝わなくていいよ。そこらへんで座って、待ってて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.973.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image53.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"54144284-36C8-4547-AA0A-8ABE12486E0D","title":"シーン 974","duration":5.5,"slideTitle":"第974スライド","backgroundName":"image53.jpeg","characterName":"操夢","telop":"僕は、彼女がそう返すと、彼女の作業の邪魔にならない位置で、座って、その作業が終わるまで、周囲を見渡すのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.974.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image53.jpeg"},{"id":"8B449AE7-6A66-4AF2-85E8-945A6A7166CD","title":"シーン 975","duration":5.6000000000000005,"slideTitle":"第975スライド","backgroundName":"image55.jpeg","characterName":"古明地さとり","telop":"テントの設営が終わり、夕日が静まると、フランはあらかじめ準備されていた食材とフライパンを焚き火の上に置く。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地さとり","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.975.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg"},{"id":"A09D77B4-6414-4EEE-A84B-47046E86FC23","title":"シーン 976","duration":4.5,"slideTitle":"第976スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「今晩は、ステーキ丼だよ、紅夢。」\n私はそう言いながら、飯盒を乗せて、お肉を一緒に焼く。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.976.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"C621CBB1-C310-4089-A7ED-7E15FFF5F41D","title":"シーン 977","duration":4.2,"slideTitle":"第977スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"僕は、彼女がそういうと、焚き火の上に置かれた食材を眺める。そして、ふと空を見上げる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.977.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"915497DB-3B67-46A4-8D0D-64C0D92F6888","title":"シーン 978","duration":4.800000000000001,"slideTitle":"第978スライド","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterName":"操夢","telop":"そこには、満点の星空が広がっていた。僕は、\nその星空を無言で、眺めていると、フランが声をかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.978.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg"},{"id":"ED297991-0043-49F9-9326-C6BD316B3DCB","title":"シーン 979","duration":3.5,"slideTitle":"第979スライド","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterName":"フランドール・スカーレット","telop":"「どう、満点の星空を見た感想は？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.979.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"FE191797-F32D-47D0-8F06-BA3B60B93095","title":"シーン 980","duration":3.5,"slideTitle":"第980スライド","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterName":"操夢","telop":"「車を数時間走らせて、やってきた価値がありますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.980.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"F314DD74-1437-4577-BADF-7C856A3CB7CA","title":"シーン 981","duration":3.5,"slideTitle":"第981スライド","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterName":"フランドール・スカーレット","telop":"「そうでしょ。それで、ご飯食べた後は、何する？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.981.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"40039FE6-5E5D-49D8-8CB1-A4009C45E2A5","title":"シーン 982","duration":3.5,"slideTitle":"第982スライド","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterName":"操夢","telop":"「そうですね…、僕は、フランさんの希望に合わせますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.982.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"8D461F40-0AB8-4F0C-B936-CDF6121A56AC","title":"シーン 983","duration":3.5,"slideTitle":"第983スライド","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterName":"フランドール・スカーレット","telop":"「そう…、ほら、そろそろご飯ができるよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.983.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"D4ED9F41-488F-4EAA-AC34-47D65202616F","title":"シーン 984","duration":5.300000000000001,"slideTitle":"第984スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"僕は、彼女にそう言われ、視線を戻すと、彼女は、どこからか紙皿を取り出し、焼き上がった肉を乗せて、僕に渡す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.984.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"E1104204-5606-4F2E-B5DF-4F6D12F9EFBC","title":"シーン 985","duration":5.7,"slideTitle":"第985スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「ほら、出来たよ。」私はそう言い、紙皿に乗せたステーキを彼に渡すと、飯盒を取り、川の水に少しだけつけて、彼に渡す。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.985.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"21813B55-BDDF-4B9B-AFDB-D0A4A191AB78","title":"シーン 986","duration":4.4,"slideTitle":"第986スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「じゃあ、出来たのご飯、食べよ。」\n私は彼にそう言うと、私たちは、出来た料理を食べ進めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.986.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"7848B8B0-D025-4EA1-9569-1EDEB1EBE4A6","title":"二人は夕飯を終えると…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.987.jpeg","animationDuration":1.5},{"id":"D5C5B212-3238-4A10-B0DE-BFD1C761DCF5","title":"シーン 988","duration":5.0,"slideTitle":"第988スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"僕と彼女は、夕飯を済ますと、飯盒だけ、水で軽く洗い、焚き火のそばに隣同士で座り、静寂の時間を過ごす。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.988.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フラン（笑い）.png"},{"id":"C7EB2877-0373-43DD-8F3D-56088169698E","title":"シーン 989","duration":3.5,"slideTitle":"第989スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「紅夢は、キャンプをするのは初めて？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.989.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"7BB447EB-1D4A-4CFB-A454-F3EFBACD610E","title":"シーン 990","duration":5.7,"slideTitle":"第990スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"「ええ、僕の家は父しか車の運転ができなくて、その父は週6で働いていて、連休なんてのは、そんなに取れなかったので。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.990.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"66DFB3F6-300C-43F1-8B44-2FFCFF98A23C","title":"シーン 991","duration":3.5,"slideTitle":"第991スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「へぇ…、それじゃあ、外出することはあった？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.991.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"8DC40044-AAF0-49C1-8F2F-2B49201ABF57","title":"シーン 992","duration":5.5,"slideTitle":"第992スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"「外出することも、滅多になかったです…、小さかった頃は学校の目の隙をついて、母と出かけることはありましたが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.992.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"FB76FF13-40A1-44E4-AE11-334C34926851","title":"シーン 993","duration":5.5,"slideTitle":"第993スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"僕はそういっていると、頭痛が走る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.993.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（微笑）.png"},{"id":"D604AE71-FF42-4AE7-AF10-40B48C8E6231","title":"シーン 994","duration":4.800000000000001,"slideTitle":"第994スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"ある日、僕が登校してくると、周囲のクラスメイトから冷ややかな視線が向けられていることに気がつく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.994.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"1C74C762-3FAF-4F98-8FCF-7CC8E9F0426D","title":"シーン 995","duration":3.5,"slideTitle":"第995スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"そして、机の中に手を入れると、あるものを取り出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.995.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"0C573BD8-2908-42DE-AD6F-3FAF073D9437","title":"シーン 996","duration":3.5,"slideTitle":"第996スライド","backgroundName":"教室の前の方（日中）.jpg","characterName":"操夢","telop":"その瞬間、周りからある囁き声が聞こえる…、それは…","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.996.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/教室の前の方（日中）.jpg"},{"id":"984F5ABA-2C9A-4319-BDCE-DC74F2682E89","title":"シーン 997","duration":3.5,"slideTitle":"第997スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「紅夢、大丈夫？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.997.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"BC602B95-29E8-40F2-AEE5-C8A2944A7124","title":"シーン 998","duration":5.4,"slideTitle":"第998スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「ええ、大丈夫です、嫌な記憶が一瞬蘇っただけですから…」\n本当はトラウマのフラッシュバックだったが、嘘をつく。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.998.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"697F9923-92C4-492A-A2E0-635B9C8EDCF4","title":"シーン 999","duration":3.5,"slideTitle":"第999スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「顔が青ざめてるけど…大丈夫なの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.999.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"B69E3134-9F35-4B65-BE3E-B13E333614EF","title":"シーン 1000","duration":3.5,"slideTitle":"第1000スライド","backgroundName":"image55.jpeg","characterName":"操夢","telop":"「すこしだけ、席を外しても、大丈夫ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1000.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"71F296BE-5DBE-404D-B28E-6A5ECF65E0BF","title":"シーン 1001","duration":5.7,"slideTitle":"第1001スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「もし、何かあるんだったら、私にいってね。」私は、不安が残りながら、彼にそう言うと、彼は、森林の中に入っていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1001.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"23857862-6AF2-4409-8197-C37261467674","title":"その頃、某所では…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1002.jpeg","animationDuration":1.5},{"id":"5F87584F-36E3-43FA-BB89-A390C336E1D0","title":"シーン 1003","duration":3.5,"slideTitle":"第1003スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"私は、一人自室で、くつろいでいると、二人の様子が見える。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1003.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（驚く）.png"},{"id":"1B6B1A9D-6085-4723-9C05-1EDF983D7715","title":"シーン 1004","duration":4.6000000000000005,"slideTitle":"第1004スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「一体何があったの…、フラン…、紅夢…」\n私は、不安な気持ちになりながら、そう一人つぶやく。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1004.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア（弱る）.png"},{"id":"D31932CB-B7D1-4155-8C89-14BA0298EBC1","title":"シーン 1005","duration":5.2,"slideTitle":"第1005スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"すると、今度ははっきりと、二人の様子が見える。「これは、緊急事態ね…」私はそう言いながら、電話をかける。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1005.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり驚き後ろ手.png"},{"id":"B56A145E-EB2C-445D-A416-355AA4CFE03C","title":"フランに視点が写り…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1006.jpeg","animationDuration":1.5},{"id":"BE724ECA-7B2B-4855-A3F3-0904B343EEA0","title":"シーン 1007","duration":5.7,"slideTitle":"第1007スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"私は、それから、数十分の間、待っていたが、一向に彼が戻ってくる気配を感じず、探しにいくべきか、迷っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1007.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"45CDC4F6-0FD3-4016-B867-C37BA5C339EB","title":"シーン 1008","duration":5.2,"slideTitle":"第1008スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"すると、ふと持ってきたバックから音が出ているように感じ、\n中を開けると、それは私のポケベルの着信音だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1008.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"7EA05DEF-94E9-40AC-A312-3C5BE69036D9","title":"シーン 1009","duration":3.6,"slideTitle":"第1009スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"私は、通話ボタンを押すと、耳にかざす。\n「お姉様…、どうしよう…、彼が…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1009.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"FA6858B9-71AF-4BBE-B7AB-9E760C786C71","title":"シーン 1010","duration":5.7,"slideTitle":"第1010スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「フラン、よく聞いて、ちょうだい。今すぐに、彼を探して。だけど、日付が変わる前に見つけ出せなかったら、報告して。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1010.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり驚き後ろ手.png"},{"id":"8820BA22-859E-4C2D-9A5C-79849D41D532","title":"シーン 1011","duration":3.5,"slideTitle":"第1011スライド","backgroundName":"image55.jpeg","characterName":"フランドール・スカーレット","telop":"「分かった…」私は通話を切ると、彼の姿を探し始めた。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1011.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image55.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"F6B72649-7EF5-499E-8EE3-59D5904C1F29","title":"シーン 1012","duration":5.300000000000001,"slideTitle":"第1012スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"「はぁ、はぁ。」僕は、荒い息をしながら、森の中を彷徨った。\nすると、先ほど蘇った過去が頭の中で勝手に流れる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1012.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"3257AD52-1A97-4390-9CFD-9295DCDB6B1B","title":"シーン 1013","duration":3.5,"slideTitle":"第1013スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"僕の意識は、あと少しで吹き飛びそうだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1013.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"3F8619F8-43FF-44D3-9F89-E7EF69F04997","title":"シーン 1014","duration":4.800000000000001,"slideTitle":"第1014スライド","backgroundName":"image56.jpeg","characterName":"フランドール・スカーレット","telop":"「紅夢、どこにいるの？聞こえたら返事して…」私は、暗い夜の森でそう呼びかけながら、彼の姿を探す。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1014.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"62168262-089B-4347-A43B-B7FA363D0CD4","title":"シーン 1015","duration":4.6000000000000005,"slideTitle":"第1015スライド","backgroundName":"image56.jpeg","characterName":"フランドール・スカーレット","telop":"「紅夢？どこにいるの？」私は、だんだんと早足になるのを自覚しながら、彼の姿を必死に探し出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1015.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"F64E1570-2A78-4007-AFB2-7BE3258F3AF6","title":"シーン 1016","duration":5.7,"slideTitle":"第1016スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"僕は、その攻撃に抵抗しながら、意識が切れないようにする。\nだが、僕ができる唯一の対抗策は、ひたすら逃げるだけだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1016.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"27EF2DAD-4C08-48A8-9973-C82BC93BD158","title":"シーン 1017","duration":4.2,"slideTitle":"第1017スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"だが、それも長くは続かず、僕は何か躓くと、\nこけてしまい、そのまま意識が落ちていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1017.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"D8B326BC-F2F6-485C-BD59-AE8D455CEF3B","title":"シーン 1018","duration":5.4,"slideTitle":"第1018スライド","backgroundName":"image56.jpeg","characterName":"フランドール・スカーレット","telop":"私は、彼の姿を探しながら、ポケベルの時間を確認する。時刻は、午後9時だった。彼が席を外してから数時間だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1018.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"84A66AF9-BBEA-4128-B31A-CFB5943E53EA","title":"シーン 1019","duration":5.800000000000001,"slideTitle":"第1019スライド","backgroundName":"image56.jpeg","characterName":"フランドール・スカーレット","telop":"「紅夢、どこにいるの…」私は、気がつけば、木々の合間を縫うように走りながら、彼を探していた。だが、まだ見つからない。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1019.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"0E50217E-263D-40BD-B976-0125D5F3AA9E","title":"シーン 1020","duration":5.6000000000000005,"slideTitle":"第1020スライド","backgroundName":"image56.jpeg","characterName":"フランドール・スカーレット","telop":"そして、ふとポケベルの時間を確認する。あと数十分で日付が変わるところだった。だが、私は時間を気にせず、彼を探す。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1020.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困った笑み.png"},{"id":"716BB46E-FE3C-43BD-9A40-C6130C1EB776","title":"シーン 1021","duration":5.1000000000000005,"slideTitle":"第1021スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"「んっ…」僕は、ふと目が覚めて、周りを見る、するとそこには、こっちを見ながら、不気味に笑う彼女がいた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1021.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"D2B5CB2A-6220-45AE-883F-8D7E7AD3C704","title":"シーン 1022","duration":3.5,"slideTitle":"第1022スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"「フラン…さん…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1022.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"D8629D5F-FA54-4233-B53B-4FBE48E77277","title":"シーン 1023","duration":3.5,"slideTitle":"第1023スライド","backgroundName":"image56.jpeg","characterName":"フランドール・スカーレット","telop":"「見ーつけた。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1023.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"17BBF612-5881-47B7-B4D1-EFE59CAD9689","title":"シーン 1024","duration":5.0,"slideTitle":"第1024スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"僕は、彼女の気配から、直感的に、次の行動を予測する。\nそして、彼女とは反対方向に、回転し、立ち上がる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1024.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"F876EC2E-71FE-4981-BD39-F3B42EA545A8","title":"シーン 1025","duration":5.1000000000000005,"slideTitle":"第1025スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"そして、彼女がこちらに襲いかかるタイミングで、背後に回り、\n腕に力を込めると、それを彼女の首筋に当てる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1025.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（狂気）.png"},{"id":"0A1CDC82-5C16-4927-B68A-D7BF49FCE83A","title":"シーン 1026","duration":3.5,"slideTitle":"第1026スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"すると、彼女は何かを言いながら、その場に倒れ込む。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1026.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/ぐったり.png"},{"id":"537D1919-A19D-4C61-97A0-2BF35BC6A872","title":"シーン 1027","duration":5.1000000000000005,"slideTitle":"第1027スライド","backgroundName":"image56.jpeg","characterName":"操夢","telop":"そして、僕は、今何をしたのかを理解すると共に、再び頭痛に晒されて、彼女に被さるように倒れ込むのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1027.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"A0E3E43B-50A4-456C-A7B2-04B8742D6476","title":"シーン 1028","duration":5.300000000000001,"slideTitle":"第1028スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"私は、フランに電話をしたあと、ずっとそわそわしていた。そして、ふと時計を見ると、時刻は真夜中を指していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1028.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり驚き後ろ手.png"},{"id":"46EFE288-B703-4FA8-BF63-1912897989D0","title":"シーン 1029","duration":5.800000000000001,"slideTitle":"第1029スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「フラン、今から、私がそっちに向かうから、待ってなさい。」\n私は、そう言い、家を離れ、その場所に飛んで向かうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1029.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/レミリア壊れたにやけ顔.png"},{"id":"55DDA5BA-6B02-460D-8A81-8A57303ABF78","title":"おまけ","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1030.jpeg","animationDuration":1.5},{"id":"4761E263-39E2-430D-A87E-7DA7167DF02F","title":"シーン 1031","duration":3.5,"slideTitle":"第1031スライド","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","characterName":"藤原妹紅","telop":"「あの…お二人さん…こんな時間に、俺のベッドで何を…」","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1031.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・月明り・青）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/にやけ顔.png"},{"id":"E737EEE5-BC5B-457A-9547-BC4D14881A0A","title":"シーン 1032","duration":3.5,"slideTitle":"第1032スライド","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","characterName":"博麗霊夢","telop":"「魔理沙、準備はいいわね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1032.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・月明り・青）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊夢（余裕）.png"},{"id":"18761C87-8A95-45FB-B96D-2F73F4D89DB1","title":"シーン 1033","duration":3.5,"slideTitle":"第1033スライド","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","characterName":"霧雨魔理沙","telop":"「ああ、もちろんだぜ、霊夢。」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1033.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・月明り・青）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/にやけ顔.png"},{"id":"EDB8B487-8D44-44DB-825C-6D3313C00F75","title":"シーン 1034","duration":5.300000000000001,"slideTitle":"第1034スライド","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","characterName":"藤原妹紅","telop":"二人は、何かの確認をすると、いきなり私の服を掴んでくる。\nそして、まんまと服を脱がされると、二人も服を脱ぐ。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1034.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・月明り・青）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/にやけ顔.png"},{"id":"84085304-2D9E-463E-9B9D-FAEB6D0F88BC","title":"シーン 1035","duration":5.5,"slideTitle":"第1035スライド","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","characterName":"藤原妹紅","telop":"そして、霊夢が私のベッドで、上を向いたまま横になると、魔理沙が私の手を引っ張り、霊夢、魔理沙、私の順で重なる。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1035.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・月明り・青）.jpg"},{"id":"535BA694-0705-46F3-B6FA-E66039B802F2","title":"シーン 1036","duration":3.5,"slideTitle":"第1036スライド","backgroundName":"寝室の窓際のベッド（夜・月明り・青）.jpg","characterName":"藤原妹紅","telop":"そして、私は、魔理沙にアレを根こそぎ取られるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"藤原妹紅","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1036.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・月明り・青）.jpg"},{"id":"7CB42859-8D22-4C80-8C7A-07D979F2BF82","title":"シーン 1037","duration":3.5,"slideTitle":"第1037スライド","backgroundName":"image56.jpeg","characterName":"レミリア・スカーレット","telop":"私は、二人がいるキャンプ場に来ると、森の中に入る。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1037.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"67160033-080F-4AB3-93B0-B6DBC6CC1845","title":"シーン 1038","duration":3.5,"slideTitle":"第1038スライド","backgroundName":"image56.jpeg","characterName":"レミリア・スカーレット","telop":"そして、私は、森の中にいるはずの二人を探し回る。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1038.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg"},{"id":"1D588BAE-0C9C-4964-B6F7-64625B3634D7","title":"シーン 1039","duration":4.800000000000001,"slideTitle":"第1039スライド","backgroundName":"image56.jpeg","characterName":"レミリア・スカーレット","telop":"すると、二人が重なって倒れているのを発見する。\n「見ーつけた。」私はそう言うと、二人に襲いかかる。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1039.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/ぐったり.png"},{"id":"450BD0B6-A224-44A1-9593-D81FF1A5172B","title":"シーン 1040","duration":3.5,"slideTitle":"第1040スライド","backgroundName":"image56.jpeg","characterName":"レミリア・スカーレット","telop":"私は、今まさに、二人に襲いかかると、急に彼が目覚める。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1040.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/ぐったり.png"},{"id":"3F6CAC36-1169-4F29-8C5B-C897C18EBD69","title":"シーン 1041","duration":5.6000000000000005,"slideTitle":"第1041スライド","backgroundName":"image56.jpeg","characterName":"レミリア・スカーレット","telop":"私は、一瞬フリーズしたように固まると、彼が一瞬で消え、首筋に、鋭い衝撃が入り、そのまま気を失い、倒れるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1041.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image56.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/ぐったり.png"},{"id":"5B80AAD5-270B-491C-8139-2CAA298DB881","title":"シーン 1042","duration":3.5,"slideTitle":"第1042スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"操夢","telop":"「んっ…」僕は、ふと目が覚めると、\nそこは朝日が差し込む森の中だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1042.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg"},{"id":"614A0F69-B472-4A92-A376-687E0D1A3E71","title":"シーン 1043","duration":5.4,"slideTitle":"第1043スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"操夢","telop":"そして、ふと体を回転させて、起き上がると、そこには、ぐったりと重なるように倒れているフランとレミリアがいた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1043.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/ぐったり.png"},{"id":"A15A6CBB-F861-4E83-B041-0789A2897536","title":"シーン 1044","duration":3.5,"slideTitle":"第1044スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"操夢","telop":"僕は、二人をそっと、回転させる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1044.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/ぐったり.png"},{"id":"B4B175C2-F43E-4229-B0A1-C24AA1CBE812","title":"シーン 1045","duration":3.5,"slideTitle":"第1045スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"操夢","telop":"すると、二人から声が出ると共に、だんだんと目が覚める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1045.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/小口開け.png"},{"id":"75C4140D-3655-44E0-9F1D-47E12A8C1CA7","title":"シーン 1046","duration":3.5,"slideTitle":"第1046スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"操夢","telop":"「二人とも、目が覚めましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1046.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/寝起き小口開け.png"},{"id":"9FF71D5A-F51D-4781-8398-706733BDF422","title":"シーン 1047","duration":4.7,"slideTitle":"第1047スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"レミリア・スカーレット","telop":"「私は、ここで何してたのかしら…。」\n私は、どこか記憶が抜け落ちているような感覚がし、そう言う。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1047.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"A6C995C2-2E9D-4832-8A68-91D765CC5C24","title":"シーン 1048","duration":5.7,"slideTitle":"第1048スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"フランドール・スカーレット","telop":"「確か、夕飯食べた後、紅夢がいなくなって、探して…」私は、長い時間をかけて彼を探すとこで記憶がぷつりと消えていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1048.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"D3BCAD8B-804B-43AE-AC9C-3392E589099B","title":"シーン 1049","duration":3.5,"slideTitle":"第1049スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"レミリア・スカーレット","telop":"「とりあえず、この森を抜けましょう。」\n私は、そうフランと彼に言う。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1049.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"5F62D068-7D24-4A96-B502-4BEB6DEB63D4","title":"シーン 1050","duration":3.5,"slideTitle":"第1050スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"操夢","telop":"「僕も、レミリアさんの意見に賛成です。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1050.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"075FC4E8-BD3F-43F5-901F-F7A732BD4AF0","title":"シーン 1051","duration":3.5,"slideTitle":"第1051スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"フランドール・スカーレット","telop":"「私も、お姉様の言う通りだと思う。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1051.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"53FD07DB-0E41-406D-91D5-60AD8161CB50","title":"シーン 1052","duration":4.7,"slideTitle":"第1052スライド","backgroundName":"8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterName":"レミリア・スカーレット","telop":"「それじゃあ、とりあえず森から抜け出しましょうか。」\n私はそう言い、二人と共に、森を抜け出した。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1052.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/8D0B547A-F73E-5C08-B92E-C70E609AF6AE.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"04B02745-BF56-415E-BB9D-8962A47C5E64","title":"それから…","duration":1.5,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1053.jpeg","animationDuration":1.5},{"id":"5827DE95-B755-4CF8-9AB3-A73FDDFD0642","title":"シーン 1054","duration":5.800000000000001,"slideTitle":"第1054スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕たちは、それから、家に戻り、食堂で昼食をとっていると、二人は互いの記憶を擦り合わせ、僕にどこまで覚えてるか尋ねる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1054.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png"},{"id":"09E0FA58-1A34-4C21-9CB1-0748E34CAD89","title":"シーン 1055","duration":3.5,"slideTitle":"第1055スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「ねぇ、紅夢、あなたはどこまで覚えてるの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1055.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"03B2212A-C1BB-4008-9615-D06A64105FA8","title":"シーン 1056","duration":3.5,"slideTitle":"第1056スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「僕は、森の中をひたすら歩いて、気絶するところまでです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1056.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"603073AF-1524-47CB-B54C-F662E4EF7E39","title":"シーン 1057","duration":3.5,"slideTitle":"第1057スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「それで、何か他に、覚えていることはある？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1057.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"F634CF64-956E-4682-8329-CCA7C668B7E2","title":"シーン 1058","duration":3.5,"slideTitle":"第1058スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「あとは、強いて言うなら過去を思い出したくらい…です。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1058.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"1A4EC0F1-B0EF-4D8A-9AFC-07176CAFAB81","title":"シーン 1059","duration":3.5,"slideTitle":"第1059スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「ねぇ、あなたが言う、\nその過去について聞かせてくれないかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1059.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"57A164CE-B4AC-4B7A-A4BE-77A8CFBC8023","title":"シーン 1060","duration":3.5,"slideTitle":"第1060スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕は、彼女にそう言われ、前にも誰かに話したことを思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1060.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"2276A6B0-DB7C-42C3-A03B-269421A25639","title":"シーン 1061","duration":3.5,"slideTitle":"第1061スライド","backgroundName":"咲夜（微笑）.png","characterName":"十六夜咲夜","telop":"「ちなみに、その間の記憶は、まったくありませんか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1061.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"C01FB726-8381-4E96-88F6-A1FAA14AC3A4","title":"シーン 1062","duration":3.5,"slideTitle":"第1062スライド","backgroundName":"咲夜（微笑）.png","characterName":"操夢","telop":"「ええ…、でも僕は、ある意味、慣れっこですよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1062.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"F33CB897-B245-4845-8C02-27559A8EB2F2","title":"シーン 1063","duration":3.5,"slideTitle":"第1063スライド","backgroundName":"咲夜（微笑）.png","characterName":"十六夜咲夜","telop":"「そう言える理由は？」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1063.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"5A4E20E7-A19E-4234-A069-9638EDA835C3","title":"シーン 1064","duration":3.8000000000000003,"slideTitle":"第1064スライド","backgroundName":"咲夜（微笑）.png","characterName":"操夢","telop":"「その内容話すと、少なくとも1時間は必要ですけど、\nそれでも聞きたいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1064.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"38B7278D-FC7A-4BCF-B72F-D30A6541146D","title":"シーン 1065","duration":3.5,"slideTitle":"第1065スライド","backgroundName":"咲夜（微笑）.png","characterName":"十六夜咲夜","telop":"「ええ、あなたの心身にかかる事柄ですから、\nぜひ、聞かせてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"十六夜咲夜","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1065.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"685A0998-FA33-4B03-864A-6C00CCA9484D","title":"シーン 1066","duration":3.5,"slideTitle":"第1066スライド","backgroundName":"咲夜（微笑）.png","characterName":"操夢","telop":"僕は、彼女の意思を確認すると、過去を思い返しながら話す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1066.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/咲夜（微笑）.png"},{"id":"8D99A5EC-032A-40B0-8665-7952933BD52D","title":"シーン 1067","duration":3.5,"slideTitle":"第1067スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕は、そのときの内容と全く同じ内容を、二人話す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1067.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"DF97A17A-20CA-40ED-B6DF-26390626B25B","title":"シーン 1068","duration":5.300000000000001,"slideTitle":"第1068スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「その話は本当なのかしら…、前聞いた時も驚いたけど、まさかそんな陰湿な行為が、あの男子校であったなんて…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1068.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"02380579-34BB-4C19-8F57-119B32B7B625","title":"シーン 1069","duration":3.5,"slideTitle":"第1069スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「私たちが学校にいた時は、そんなこと聞いたことないよ…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume"