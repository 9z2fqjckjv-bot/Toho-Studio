des\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1882.jpeg","id":"5D9CCAA8-1267-46C2-8D8F-9451F0423F82","slideTitle":"第1882スライド"},{"telop":"そして、気がつけばお昼に近くなっていて、僕は、魔理沙に断って、この家に戻ってきた。そして、取り出した本も元に戻す。","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1883","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1883.jpeg","id":"99106DE0-4328-4CD0-A958-9B9EF714A6BF","slideTitle":"第1883スライド"},{"telop":"そのまま僕が、ただぼーっとしてると誰かが駆け寄ってくる。","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1884","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1884.jpeg","id":"8CEFFBF8-B045-4EBA-898C-A3F04DC39533","slideTitle":"第1884スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","telop":"「あなた、今まで何してたのよ。もうすぐお昼だから、\n部屋に行ってもフランしかいなかったし。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1885","animationName":"なし","duration":4.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1885.jpeg","id":"8BEF144D-A5C8-4E2D-B31B-50D1340F9919","slideTitle":"第1885スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/困り顔小口開け.png","telop":"「魔理沙さんに、ある本について質問しに行ったんですよ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1886","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1886.jpeg","id":"4CE9B454-F251-4EB4-9FE7-CEF16C63397C","slideTitle":"第1886スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（怒る）.png","telop":"「まぁ、とにかくフランとこいしを待たせるわけには行かないから、さっさと私の後についてきなさい。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1887","animationName":"なし","duration":4.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1887.jpeg","id":"5D638A08-CD6E-49AF-A6D1-D4A2E170B4F7","slideTitle":"第1887スライド"},{"telop":"彼女はそういうと、去っていく。僕は慌てて、跡をつける。そして、昼食をとっている最中もレミリアとフランから怒られた。","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1888","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc77066_【背景素材】紅魔館大図書館.jpg","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1888.jpeg","id":"4F80458F-2DC4-4BC4-837D-04D12ADD29C9","slideTitle":"第1888スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"僕は昼食と歯磨きを済ますと、フランと僕の二人部屋で一人、ベッドに座り、休んでいた。すると部屋の扉がノックされる。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1889","animationName":"なし","duration":5.6000000000000005,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1889.jpeg","id":"F9980CD2-C0BB-4822-BE35-416B4CE19A16","slideTitle":"第1889スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「どうぞ。」僕がそう言うと、部屋の扉が開く。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1890","animationName":"なし","duration":3.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1890.jpeg","id":"DBC1BA37-EFC2-4201-B82E-4F211C98FC60","slideTitle":"第1890スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"そして、部屋に入ってきたのは、こいしとフランだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1891","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1891.jpeg","id":"9C97BEA4-5CD0-4871-B762-E4FD02E53905","slideTitle":"第1891スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「紅夢、一緒に出かけようよ！」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 1892","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1892.jpeg","id":"D7E50FBD-7E32-407E-AB73-0422BA75ABAA","slideTitle":"第1892スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「えっ？」僕がそう突如の誘いに戸惑っていると、\nフランが補足説明をする。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1893","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1893.jpeg","id":"133A7BC9-F2AF-43F9-9E06-8C28219D222B","slideTitle":"第1893スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「お姉様の許可はとったから、私は、紅夢の意見に任せるよ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1894","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1894.jpeg","id":"5E93F306-5287-4710-943F-02B4BF4D8AA8","slideTitle":"第1894スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「そうですか…、でも大丈夫なんですか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1895","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1895.jpeg","id":"C1E65093-3D0E-49EC-B744-6A821A7A65E9","slideTitle":"第1895スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「私が、常にそばにいれば、大丈夫だよ…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1896","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1896.jpeg","id":"87535566-CE67-4E85-922E-9CFC33303A4A","slideTitle":"第1896スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「分かりました…、それでどこに行きますか？」僕がそう言うと、彼女はある場所の名前を言い、僕たちは家を出るのだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1897","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1897.jpeg","id":"1D85EB63-7460-4921-8C64-C2B3F7DA77E6","slideTitle":"第1897スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"僕がこいしに連れられ、やってきたのは遊園地だった。\nそして、僕はこいしあれこれと半日の間、連れ回される。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1898","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1898.jpeg","id":"6F2CF3A9-09FF-4B24-89D1-FC185D046A27","slideTitle":"第1898スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"そして、気がつけば夕日が差し込む時間帯になっていた。\nすると、こいしが観覧車を指差しながら、あることを言う。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1899","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/2026-11-15_13-37.png","backgroundName":"2026-11-15_13-37.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1899.jpeg","id":"D8CDD077-1128-4B0E-AD73-F4824417AA48","slideTitle":"第1899スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「ねぇ、最後に観覧車に乗ろうよ。」","seStartTimeOffset":0,"