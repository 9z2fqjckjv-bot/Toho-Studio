gePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2063.jpeg","id":"5E00DD5E-62C2-4E11-9439-74B4371E38A2","slideTitle":"第2063スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/頬照り目閉じこいし.png","telop":"「分かりました…」僕はそういうと、病室に戻っていった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2064","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","backgroundName":"nc166698_病院の診察室.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2064.jpeg","id":"0E796B6F-7E1F-4F62-9161-91ED2CD2EE69","slideTitle":"第2064スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/永琳（怒り）.png","telop":"私は彼が帰ると、ある彼のデータを眺めていた。実は、さっき見せた脳波のデータはダミーで、本当は違うデータを取っていた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 2065","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","backgroundName":"nc166698_病院の診察室.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2065.jpeg","id":"D780379B-DCD9-400B-8964-0BC5F4BAD8A4","slideTitle":"第2065スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/永琳（怒り）.png","telop":"「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 2066","animationName":"なし","duration":5.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","backgroundName":"nc166698_病院の診察室.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2066.jpeg","id":"D5AC907D-3086-4A7F-8B85-565EF9CD1A70","slideTitle":"第2066スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/永琳（怒り）.png","telop":"実は、それは彼の出生に関わる秘密情報でもあり、しかもその情報を以前、彼を担当してた医者からは聞いてないものだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 2067","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc166698_病院の診察室.png","backgroundName":"nc166698_病院の診察室.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2067.jpeg","id":"5F560463-5307-430C-9D40-3095A7BF2917","slideTitle":"第2067スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/永琳（怒り）.png","telop":"それは、彼の両親と、ある女性の過去を端的に表していた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"八意永琳","bgmStartTimeOffset":0,"title":"シーン 2068","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/Toho