StartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"フランドール・スカーレット","bgmStartTimeOffset":0,"title":"シーン 1023","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/image56.jpeg","backgroundName":"image56.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1023.jpeg","id":"2F78EEEA-432A-4B04-8D78-5F5BB1AAE47D","slideTitle":"第1023スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","telop":"僕は、彼女の気配から、直感的に、次の行動を予測する。\nそして、彼女とは反対方向に、回転し、立ち上がる。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1024","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/image56.jpeg","backgroundName":"image56.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1024.jpeg","id":"201C61D7-C537-4AD3-AFC8-847DDDC1D86A","slideTitle":"第1024スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/フラン（狂気）.png","telop":"そして、彼女がこちらに襲いかかるタイミングで、背後に回り、\n腕に力を込めると、それを彼女の首筋に当てる。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1025","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/image56.jpeg","backgroundName":"image56.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1025.jpeg","id":"D32EFF84-6589-4EEC-8C75-E5BDA75E0B99","slideTitle":"第1025スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/ぐったり.png","telop":"すると、彼女は何かを言いながら、その場に倒れ込む。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1026","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/image56.jpeg","backgroundName":"image56.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1026.jpeg","id":"AD7A1E6B-997B-4B8D-BCFA-01AF5ABE8A08","slideTitle":"第1026スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"そして、僕は、今何をしたのかを理解すると共に、再び頭痛に晒されて、彼女に被さるように倒れ込むのだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1027","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/image56.jpeg","backgroundName":"image56.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1027.jpeg","id":"21A1BA90-C49B-43D1-9A7C-F28487B3D760","slideTitle":"第1027スライド"},{"character