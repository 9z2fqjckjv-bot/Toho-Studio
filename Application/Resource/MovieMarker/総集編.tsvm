Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2130.jpeg","id":"7CCAC1B5-C9AA-4708-930D-608359A7703E","slideTitle":"第2130スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/帽子なし目閉じ口閉じ.png","telop":"「これから、元々、この家に住んでいた人たちと食事があるから、あなたにも、それに参加してもらうから、覚悟しなさい。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2131","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2131.jpeg","id":"17CF02EF-B141-45AE-AF46-C5F0F377DCB6","slideTitle":"第2131スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/帽子なし目閉じ口閉じ.png","telop":"「そうですか…」僕は彼女の言葉を聞くと、こいしの頭を撫でるのをやめようとすると、彼女がその手を掴む。「おっと…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2132","animationName":"なし","duration":5.6000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2132.jpeg","id":"C9BB1CE3-5622-4AC1-B8BC-3C61DF4A033A","slideTitle":"第2132スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（不満）.png","telop":"「こいし、そろそろ彼と、\n食事に出かけないとだから、彼を離してちょうだい。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 2133","animationName":"なし","duration":3.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2133.jpeg","id":"A550889D-2BEB-4AF3-A95E-85F0012F9068","slideTitle":"第2133スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「やだ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2134","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2134.jpeg","id":"E6DF5DF5-AA1B-45D3-B53C-F14BBD24AABE","slideTitle":"第2134スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/レミリア（不満）.png","telop":"「やだじゃない、あなたもう20歳を過ぎた大人でしょ。だったら、そうわがままなんて言うじゃない。じゃないと…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 2135","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2135.jpeg","id":"67664F3F-9B06-408E-9DA8-1F7F0F0E9055","slideTitle":"第2135スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","telop":"「あなたの彼に対する態度が、元住人に知れ渡ることになるけど、いいのかしら？その態度は、家だけの秘密じゃないの？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 2136","animationName":"なし","duration":5.6000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2136.jpeg","id":"A77DD0F7-EDAF-4005-AC9A-A85292149BF1","slideTitle":"第2136スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「ずるい！私はもっと、彼のそばにいたいのに…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2137","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2137.jpeg","id":"67DE813B-0A49-4F62-BBA6-FC10E7A5EB3E","slideTitle":"第2137スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/レミリア（余裕）.png","telop":"「でも秘密は知られたくないんでしょ？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 2138","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2138.jpeg","id":"A18E4867-04AB-4309-93E7-F124D2A9B890","slideTitle":"第2138スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「うぐっ…わかった。でも、\n帰ってきたらもっと彼に、甘えるんだから！」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2139","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","backgroundName":"1A54FDC5-F240-5222-A72C-C38DABF3999E.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2139.jpeg","id":"2C3C28DC-CC64-4E52-B6F9-4A7298CA9F41","slideTitle":"第2139スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「それじゃあ、行きましょうか。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"レミリア・スカーレット","bgmStartTimeOffset":0,"title":"シーン 2140","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","backgroundName":"nc107556_紅魔的館内.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2140.jpeg","id":"2250A921-9F6E-4720-948E-317913123C18","slideTitle":"第2140スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"「ええ、そうですね。」それから僕とレミリアとフランは、\n食事に出かけていくのだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2141","animationName":"なし","duration":4.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第12話\/nc107556_紅魔的館内.jpg","backgroundName":"nc107556_紅魔的館内.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2141.jpeg","id":"D33C6191-9E2B-4991-838C-D7A10D87B373","slideTitle":"第2141スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"大学院まで完走した24歳。","animationName":"なし","duration":5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2142.jpeg","id":"63F3B5E4-FA25-4746-B1AD-42586FEEB948","slideTitle":"中扉"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"僕は食事を終えて、夜の10時ごろに、酔いが全身に巡り巡って、赤くになったレミリアとフランを連れて帰ってきた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2143","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2143.jpeg","id":"5EDE4192-B9CC-4BEC-8D1E-30BC24009C11","slideTitle":"第2143スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"すると、僕はある嫌な予感がする。そこで僕は、食事前にパチュリーからもらっていたある液体を二人に飲ます。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2144","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2144.jpeg","id":"A8698382-1E8D-4100-AD71-352EA3CBA67C","slideTitle":"第2144スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"そして、その予感は見事に的中し、二人は料理が口に逆走しなかったはいいものの、二人の下にはある液体が垂れ流れていた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2145","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2145.jpeg","id":"CDB01479-3030-4E88-8710-F9673F4B1671","slideTitle":"第2145スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","telop":"「これ、あなたが開発した、アルコール排出促進剤。\n二人が酔い潰れそうだったら、その前に飲ませて。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 2146","animationName":"なし","duration":4.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2146.jpeg","id":"FA2A2E60-F94E-47ED-9C4A-267593C7D90E","slideTitle":"第2146スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第3話\/パチュリー（弱る）.png","telop":"「ただし、ゲロを吐くことはないけど、その代わりにアルコールがそのまま混じったアレがスカートから出てくるから。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"パチュリー・ノーレッジ","bgmStartTimeOffset":0,"title":"シーン 2147","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","backgroundName":"D94F8ECB-7B4B-53CA-BC9F-CDA4A5BD0BFE.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2147.jpeg","id":"BE1AAB1F-A544-45F7-9F12-86CE006D9943","slideTitle":"第2147スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/こいし（驚く）.png","telop":"僕は、自分たちがアレを出していることに気がつかない二人をじっと見る…。ちなみにその薬の別名は、赤ちゃん薬だった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2148","animationName":"なし","duration":5.6000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2148.jpeg","id":"C2AFD579-E166-42D6-9731-39181A1278A3","slideTitle":"第2148スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「ねぇ、二人を素っ裸にして、何する気なの？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2149","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2149.jpeg","id":"7B59E4B3-7703-4454-A39A-0BF14D9D58AE","slideTitle":"第2149スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「こいし…、ちょっと手伝って、酔いが回って、アレを漏らしちゃったお二人さんを、浴室に連行するから。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2150","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2150.jpeg","id":"7F67A87A-1465-49AB-8534-A2AEB3F996F8","slideTitle":"第2150スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「はぁ？何言ってるの、あんた。言っておくけど、私は二人の下のお世話なんてしないから、あんた一人でしてね。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2151","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2151.jpeg","id":"C8751B68-5720-4C78-A74A-D537B9966742","slideTitle":"第2151スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「もしかして、こいし…、やけ酒してた？」\n僕は、彼女が普段呼びない呼び方で、僕を呼んだのでそう聞く。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2152","animationName":"なし","duration":4.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2152.jpeg","id":"3BD82433-0CA8-4BAD-A7A7-93F203AC6DD0","slideTitle":"第2152スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「くっ…、一人で寂しくて、お酒で濁してたのよ、私…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2153","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2153.jpeg","id":"64E496F7-39DE-41B9-8C45-F94BA794D853","slideTitle":"第2153スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「ふっ…」僕は、彼女の言動に思わず、そう笑い出してしまう。\n「あれ…酔ってないつもりだけど、酒が回ってきたのかな…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2154","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2154.jpeg","id":"53D49CA3-3AB9-4B7D-9DAB-203899F82413","slideTitle":"第2154スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「まぁ、いいや。とにかく、アレを漏らしたお二人さんの介護、手伝って、それが済んだら、思う存分頭を撫でてあげるから。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2155","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2155.jpeg","id":"23746686-5452-48D4-B00D-B482D4397803","slideTitle":"第2155スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「うっ…、分かったわよ、この私が手伝ってあげる。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 2156","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2156.jpeg","id":"386812D9-A5CD-4CDB-9142-8BBC0860F757","slideTitle":"第2156スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"「ふっ」僕は、彼女の言動で何かが外れてしまったのか、そこから彼女が怒鳴り込むまで、大笑いしてしまうのだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 2157","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第30話\/nc213186_紅魔館ロビー.jpg","backgroundName":"nc213186_紅魔館ロビー.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2157.jpeg","id":"EB9D8C88-61DB-4F12-8962-627946E8F84F","slideTitle":"第2157スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/帽子なし怒り.png","telop":"","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"大学に通う21歳。","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.2158.jpeg","id":"9793F44E-EF15-4B0E-8776-8775517A