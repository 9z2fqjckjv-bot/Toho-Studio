1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2100.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"B7812D5B-6D7C-4A6A-84C1-368B0BBAA56B","title":"シーン 2101","duration":3.5,"slideTitle":"第2101スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"僕がそう聞くと、三人は赤面し、驚いた表情をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2101.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"D24C456E-37D7-4C15-BD45-D030B9F13866","title":"シーン 2102","duration":4.4,"slideTitle":"第2102スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"古明地こいし","telop":"「そんなことは、もうどうだっていいの、\nそれにあなたが病院にいるうちに、決着がついたし。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2102.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（不満）.png"},{"id":"40191C18-C844-4B0A-8ED7-9D65052B58FA","title":"シーン 2103","duration":3.5,"slideTitle":"第2103スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"「それじゃあ、僕はどうなるんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2103.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"C5771AA9-D3FE-4757-A80C-298C2C4E1E65","title":"シーン 2104","duration":5.300000000000001,"slideTitle":"第2104スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"古明地こいし","telop":"「お姉ちゃんが人をあなたを刺して逃げてるとこを、警察に捕まって、それから瞬く間に邪道派の悪事がバレたの。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2104.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（不満）.png"},{"id":"F9F1446A-58D8-42EF-A6F5-A621BE1F0FA8","title":"シーン 2105","duration":3.5,"slideTitle":"第2105スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"「それで？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2105.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"2BA34E69-330D-444B-97F4-1F6B93019C5A","title":"シーン 2106","duration":5.7,"slideTitle":"第2106スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"古明地こいし","telop":"「邪道派のせいで、両親がいる正道派が謝罪会見をして、グループ全体が更生することになったの。だから、その件はなし。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2106.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（不満）.png"},{"id":"FBA765F1-A346-4888-8661-6320299C80BA","title":"シーン 2107","duration":5.7,"slideTitle":"第2107スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"「えっと…、それじゃあ…」僕がそう呟いていると、フランがベッドの上にある机に、婚姻届と藤原と書かれたハンコを出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2107.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"18DC196D-2A75-45A5-850F-DA4410BCE8EE","title":"シーン 2108","duration":5.7,"slideTitle":"第2108スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"フランドール・スカーレット","telop":"「地下底国グループは、私たちが買収して、紅夢がこれにハンコを押せば、私たちの正式な一員になるの。だから、押して。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2108.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"33B6288D-1F9E-451E-9BBF-E3575AAD89CF","title":"シーン 2109","duration":3.5,"slideTitle":"第2109スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"「じゃあ、母の神社はどうなるんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2109.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"81F21332-AE9B-4C3B-9D66-8F49F0DF0F55","title":"シーン 2110","duration":5.7,"slideTitle":"第2110スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"レミリア・スカーレット","telop":"「あなたの母については、私たちが選出した後継ぎを向こうに送るから、安心しなさい。それと、学校の了承も得てるから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2110.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"34E55233-1857-4AEC-93F5-777B9E40B21E","title":"シーン 2111","duration":4.800000000000001,"slideTitle":"第2111スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"「そうですか…ならいいですけど…」僕は、\n三人の説明を聞き終えると、そう言いながらハンコを押した。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2111.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"D99A3E53-ED0B-4071-BF3E-11E9F986733B","title":"シーン 2112","duration":5.5,"slideTitle":"第2112スライド","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","characterName":"操夢","telop":"あれから、長い年月がたち、あっという間に、僕は卒業式を迎えた。すると卒業生代表のスピーチで僕の名前が呼ばれる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2112.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg"},{"id":"CB2A5B86-4EBA-42D8-920F-BE448A289200","title":"シーン 2113","duration":5.800000000000001,"slideTitle":"第2113スライド","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","characterName":"操夢","telop":"そして、僕は卒業生を代表したスピーチのために壇上を上がる。\n卒業生の列にさとり、そしてこいし、保護者席にフランがいた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2113.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg"},{"id":"E52498CF-9733-41EE-9D28-E34A5A8F2261","title":"シーン 2114","duration":3.5,"slideTitle":"第2114スライド","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","characterName":"操夢","telop":"そして、僕はそれから卒業生代表のスピーチを読み上げる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2114.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg"},{"id":"33A97A61-9514-4EB7-AE32-99EEACC62F05","title":"シーン 2115","duration":3.5,"slideTitle":"第2115スライド","backgroundName":"B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg","characterName":"操夢","telop":"スピーチが終わると、僕は席に戻り、卒業式が続くのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2115.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/B3198052-32F7-5805-8AFC-BCCF2D49CA5B.jpg"},{"id":"E3D85AB6-3E4A-4DB1-8A5E-13A87CBCADCC","title":"シーン 2116","duration":5.1000000000000005,"slideTitle":"第2116スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"それから卒業式を終えた僕たちは、教室に戻る。そして僕は、担任からの一言と終礼が終わると、校門に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2116.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff"},{"id":"080C2AC0-AF6F-48BB-A577-AA7CB33D3A30","title":"シーン 2117","duration":5.0,"slideTitle":"第2117スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"僕が校門を出ると、そこには頬が赤らみ、涙を見せるフランの姿があった。「なんで、泣いているんですか。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2117.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/泣き笑い.png"},{"id":"9ECB2871-AF36-44E4-AB1C-998D7C1B605D","title":"シーン 2118","duration":3.5,"slideTitle":"第2118スライド","backgroundName":"ペーストされた画像.tiff","characterName":"フランドール・スカーレット","telop":"「仕方ないじゃん、感動してたら、自然に溢れてきたの。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2118.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/涙目頬照り小口笑い.png"},{"id":"3FCE1D82-C2F5-4F7A-836C-15F1E2EA28B8","title":"シーン 2119","duration":4.5,"slideTitle":"第2119スライド","backgroundName":"ペーストされた画像.tiff","characterName":"操夢","telop":"「そうですか…、とりあえず、帰りませんか？」\n僕がそう聞くと、彼女は頷き、僕たちは帰宅する。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2119.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/ペーストされた画像.tiff","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/涙目頬照り小口笑い.png"},{"id":"7A7C43CD-C7AD-4333-A103-8658A88E7F47","title":"シーン 2120","duration":4.1000000000000005,"slideTitle":"第2120スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"僕とフランが帰宅すると、レミリアに呼び出される。\nすると、二人が祝福の言葉を述べる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2120.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手笑い.png"},{"id":"E3E5354A-A734-461A-A8EC-51C29E881973","title":"シーン 2121","duration":3.5,"slideTitle":"第2121スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット&古明地こいし","telop":"「卒業おめでとう！」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット&古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2121.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手笑い.png"},{"id":"85B9DB6E-6957-4D66-9747-21927972E8F9","title":"シーン 2122","duration":3.5,"slideTitle":"第2122スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"「ありがとうございます。」僕は、二人にそう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2122.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手笑い.png"},{"id":"6064CE58-6EA6-4527-8411-5E53E211A4CD","title":"シーン 2123","duration":3.5,"slideTitle":"第2123スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"すると、二人の頬が一気に頬照る。「どうしたんですか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2123.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/驚き.png"},{"id":"04FDDBB0-A7A0-4A36-94AA-6982438E8862","title":"シーン 2124","duration":3.5,"slideTitle":"第2124スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「あなた、その微笑みはずるいわよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2124.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/赤面小口開け.png"},{"id":"CDD287E1-2B82-49AD-A2E8-67508BAF3968","title":"シーン 2125","duration":3.5,"slideTitle":"第2125スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"古明地こいし","telop":"「そんな微笑みを、突然見せられたら、欲しくなっちゃうじゃん…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2125.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/赤面小口開け.png"},{"id":"C00A7FB1-58A8-42A6-9B58-031F7B377CFC","title":"シーン 2126","duration":3.5,"slideTitle":"第2126スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"僕は、二人のその反応に、思わず「ふっ」と笑いが漏れる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2126.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/赤面小口開け.png"},{"id":"78E85527-BB75-4372-8F26-5BC83DE4AFC2","title":"シーン 2127","duration":3.5,"slideTitle":"第2127スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「笑わないでちょうだい…、まったくそういうところなのよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2127.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"8B7DFC22-261B-4729-A96A-7B0F9AE30431","title":"シーン 2128","duration":3.5,"slideTitle":"第2128スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"古明地こいし","telop":"「私たちが我慢できずに襲いかかったら、ちゃんと責任とってよね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2128.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"8E52B6C9-19BA-4CC9-BB7B-54582A4BDF47","title":"シーン 2129","duration":5.0,"slideTitle":"第2129スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"「まぁまぁ、いいじゃないですか…」僕は、そう言いながら、\n不機嫌になっているこいしの頭をそっと撫でる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2129.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"75905D19-E37F-468B-86E4-267CAF4D41DE","title":"シーン 2130","duration":5.1000000000000005,"slideTitle":"第2130スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"すると彼女が、おとなしくなる。「それで、これからどうするんですか？」僕は、こいしの頭を撫でながら聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2130.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"35DB2B08-1680-458E-9467-87114EBD9DF7","title":"シーン 2131","duration":5.7,"slideTitle":"第2131スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"「これから、元々、この家に住んでいた人たちと食事があるから、あなたにも、それに参加してもらうから、覚悟しなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2131.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"27F23B96-BFC3-42DF-8B81-785559D5DCDB","title":"シーン 2132","duration":5.6000000000000005,"slideTitle":"第2132スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"「そうですか…」僕は彼女の言葉を聞くと、こいしの頭を撫でるのをやめようとすると、彼女がその手を掴む。「おっと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2132.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"168649F5-632B-40D9-A071-73A590765C91","title":"シーン 2133","duration":3.7,"slideTitle":"第2133スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「こいし、そろそろ彼と、\n食事に出かけないとだから、彼を離してちょうだい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2133.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"8A325C35-3C52-4FE6-ACE2-CE30DC1E8124","title":"シーン 2134","duration":3.5,"slideTitle":"第2134スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"古明地こいし","telop":"「やだ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2134.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（怒る）.png"},{"id":"E9A473B3-C4A1-4904-9997-28ED1A2D176A","title":"シーン 2135","duration":5.4,"slideTitle":"第2135スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「やだじゃない、あなたもう20歳を過ぎた大人でしょ。だったら、そうわがままなんて言うじゃない。じゃないと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2135.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"F6225278-0B61-458A-81BA-D431D51FD9DF","title":"シーン 2136","duration":5.6000000000000005,"slideTitle":"第2136スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「あなたの彼に対する態度が、元住人に知れ渡ることになるけど、いいのかしら？その態度は、家だけの秘密じゃないの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2136.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"7B735D0F-4E99-4625-9CCA-842F46B9AA7C","title":"シーン 2137","duration":3.5,"slideTitle":"第2137スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"古明地こいし","telop":"「ずるい！私はもっと、彼のそばにいたいのに…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2137.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"4C3B8186-35CE-4B86-92C6-74C079771215","title":"シーン 2138","duration":3.5,"slideTitle":"第2138スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「でも秘密は知られたくないんでしょ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2138.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"C92BE024-CAA1-4AC5-A00C-D5738D2656B8","title":"シーン 2139","duration":3.5,"slideTitle":"第2139スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"古明地こいし","telop":"「うぐっ…わかった。でも、\n帰ってきたらもっと彼に、甘えるんだから！」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2139.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/レミリア（余裕）.png"},{"id":"4AF68A7D-0919-4D3A-AD28-F0BECAEEA01A","title":"シーン 2140","duration":3.5,"slideTitle":"第2140スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"レミリア・スカーレット","telop":"「それじゃあ、行きましょうか。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2140.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手小口笑い笑い目.png"},{"id":"E3861BBF-BDEB-4A65-BB55-076C8AC2360B","title":"シーン 2141","duration":4.1000000000000005,"slideTitle":"第2141スライド","backgroundName":"nc107556_紅魔的館内.jpg","characterName":"操夢","telop":"「ええ、そうですね。」それから僕とレミリアとフランは、\n食事に出かけていくのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2141.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc107556_紅魔的館内.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/後ろ手小口笑い笑い目.png"},{"id":"41B8F41D-8CC6-48F4-80A0-01074B0AD1C7","title":"スカーレット・紅夢（大学院まで完走した24歳。）","duration":5.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2142.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/困った笑み.png","animationDuration":5.0},{"id":"49D8AB5C-B2F7-45D4-B13C-D0C5EFE35CB6","title":"シーン 2143","duration":5.4,"slideTitle":"第2143スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕は食事を終えて、夜の10時ごろに、酔いが全身に巡り巡って、赤くになったレミリアとフランを連れて帰ってきた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2143.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/よったニヤケ顔.png"},{"id":"8CFD32B8-BEC8-4D10-9117-34B9DED478E5","title":"シーン 2144","duration":5.1000000000000005,"slideTitle":"第2144スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"すると、僕はある嫌な予感がする。そこで僕は、食事前にパチュリーからもらっていたある液体を二人に飲ます。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2144.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/よったニヤケ顔.png"},{"id":"07415398-E53C-43E9-94B6-6EE25E565F8D","title":"シーン 2145","duration":5.7,"slideTitle":"第2145スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"そして、その予感は見事に的中し、二人は料理が口に逆走しなかったはいいものの、二人の下にはある液体が垂れ流れていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2145.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/よったニヤケ顔.png"},{"id":"64F742DC-7455-4785-A261-9346342BF895","title":"シーン 2146","duration":4.800000000000001,"slideTitle":"第2146スライド","backgroundName":"nc228271_居酒屋の個室.jpg","characterName":"パチュリー・ノーレッジ","telop":"「これ、あなたが開発した、アルコール排出促進剤。\n二人が酔い潰れそうだったら、その前に飲ませて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2146.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc228271_居酒屋の個室.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（弱る）.png"},{"id":"D3B3AC16-DDF0-4113-ABE9-B2C41984D0BB","title":"シーン 2147","duration":5.5,"slideTitle":"第2147スライド","backgroundName":"nc228271_居酒屋の個室.jpg","characterName":"パチュリー・ノーレッジ","telop":"「ただし、ゲロを吐くことはないけど、その代わりにアルコールがそのまま混じったアレがスカートから出てくるから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2147.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc228271_居酒屋の個室.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（弱る）.png"},{"id":"771DCC33-96EE-4570-A051-7E7B44AB3A01","title":"シーン 2148","duration":5.6000000000000005,"slideTitle":"第2148スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕は、自分たちがアレを出していることに気がつかない二人をじっと見る…。ちなみにその薬の別名は、赤ちゃん薬だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2148.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/よったニヤケ顔.png"},{"id":"BE015053-0DB0-4D0A-BDA6-FE1E8C17C0AA","title":"シーン 2149","duration":3.5,"slideTitle":"第2149スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"古明地こいし","telop":"「ねぇ、二人を素っ裸にして、何する気なの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2149.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"FB0F8117-E12E-469E-B9A1-3B69B421BB8D","title":"シーン 2150","duration":5.0,"slideTitle":"第2150スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「こいし…、ちょっと手伝って、酔いが回って、アレを漏らしちゃったお二人さんを、浴室に連行するから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2150.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"74DFBC99-9916-4B2D-8EA4-2661400B4B2D","title":"シーン 2151","duration":5.4,"slideTitle":"第2151スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"古明地こいし","telop":"「はぁ？何言ってるの、あんた。言っておくけど、私は二人の下のお世話なんてしないから、あんた一人でしてね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2151.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り不満.png"},{"id":"79F6078E-BED9-423E-B082-68013752F134","title":"シーン 2152","duration":4.9,"slideTitle":"第2152スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「もしかして、こいし…、やけ酒してた？」\n僕は、彼女が普段呼びない呼び方で、僕を呼んだのでそう聞く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2152.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り不満.png"},{"id":"A80EF592-C370-44DF-8A48-9B3F2335E34C","title":"シーン 2153","duration":3.5,"slideTitle":"第2153スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"古明地こいし","telop":"「くっ…、一人で寂しくて、お酒で濁してたのよ、私…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2153.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"52903A23-563C-4D7C-B08A-62B3E02A30C7","title":"シーン 2154","duration":5.7,"slideTitle":"第2154スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「ふっ…」僕は、彼女の言動に思わず、そう笑い出してしまう。\n「あれ…酔ってないつもりだけど、酒が回ってきたのかな…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2154.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"09481879-1DF4-4F0C-9FB4-AADCBEAD0281","title":"シーン 2155","duration":5.800000000000001,"slideTitle":"第2155スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「まぁ、いいや。とにかく、アレを漏らしたお二人さんの介護、手伝って、それが済んだら、思う存分頭を撫でてあげるから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2155.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"3948DA42-AB22-424A-99EC-844419FCEF30","title":"シーン 2156","duration":3.5,"slideTitle":"第2156スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"古明地こいし","telop":"「うっ…、分かったわよ、この私が手伝ってあげる。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2156.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"10A42854-55F4-43BB-B2F2-52E1ABD4B4C2","title":"シーン 2157","duration":5.4,"slideTitle":"第2157スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「ふっ」僕は、彼女の言動で何かが外れてしまったのか、そこから彼女が怒鳴り込むまで、大笑いしてしまうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2157.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png"},{"id":"D0712D3A-624F-4DDC-982B-BC4DCC9425D9","title":"古明地こいし（大学に通う21歳。）","duration":5.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2158.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照りジト目あわわ.png","animationDuration":5.0},{"id":"4902DB88-D5DF-47A4-B4EE-2C03486B84DB","title":"シーン 2159","duration":4.9,"slideTitle":"第2159スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「んっ…」僕はふと目が覚めると、そこは家の玄関ホールだった。そして、ある感触がし、ふとそれを見る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2159.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg"},{"id":"98F6FF4F-4D27-4D7C-A50F-2B0E75C6FB6A","title":"シーン 2160","duration":5.6000000000000005,"slideTitle":"第2160スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"すると、こいしが僕に抱きつく形で眠っていた。そして、ふと昨晩の記憶を思い出そうとしていると、誰かの視線を感じる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2160.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/帽子なしバトルっぽい目閉じ口閉じ.png"},{"id":"6FA3BB2D-8923-4535-86E6-9A6C1707D98E","title":"シーン 2161","duration":4.6000000000000005,"slideTitle":"第2161スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"すると、そこには頬が赤らみ、驚いているフランがいた。\n「あっ、しまった…」僕は、ふとそう呟く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2161.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"AD0F4240-C79B-4D0B-9571-798B0BBB32CA","title":"シーン 2162","duration":3.5,"slideTitle":"第2162スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"そして、彼女は僕に駆け寄ってくると、僕にビンタをした。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2162.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"1C78FF54-74D5-460F-BCEF-6B4F1B206AA6","title":"シーン 2163","duration":3.5,"slideTitle":"第2163スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"すると、こいしが目覚める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2163.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"6250E748-589F-4012-9D68-A7F9074224B8","title":"シーン 2164","duration":3.5,"slideTitle":"第2164スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"古明地こいし","telop":"「えへへ、私、お兄ちゃんと抱き合って寝れた…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2164.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"8F3ED7FB-69CA-41D8-92E9-82BB4CFEC645","title":"シーン 2165","duration":5.300000000000001,"slideTitle":"第2165スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"フランドール・スカーレット","telop":"「紅夢、これはどう言うことなの？私という存在がいながら、こいしとこんなとこで抱き合って寝るなんて。一体…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2165.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"0FA66D46-0071-41BD-A7A5-61A015BF6784","title":"シーン 2166","duration":5.7,"slideTitle":"第2166スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「でも僕は…」僕はそう言いかけ、ハッとする。なぜなら、高校生の時なら、真っ先にそうなった言い訳を言っていたからだ。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2166.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"581DB49D-7302-438B-A6EB-CB5CEC27F30A","title":"シーン 2167","duration":5.300000000000001,"slideTitle":"第2167スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"古明地こいし","telop":"「私は、お兄ちゃんと一緒に過ごしていれば、安心できるし、いっぱい甘えて、頼れるから、それでいいと思うよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2167.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"7909D162-B6C2-4D99-AC1C-15FFCE3EB4EC","title":"シーン 2168","duration":5.7,"slideTitle":"第2168スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕は、こいしの言葉にどこか安心感を覚える。別にこいしが好きなんじゃない、ただその安心という言葉の響きがいいのだ…。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2168.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"243A9A6B-2602-416A-ABC2-196317CFDC5A","title":"シーン 2169","duration":5.2,"slideTitle":"第2169スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕は、自分自身のフランやこいしに対する気持ちや考え方がわからなくなり、困っていると、レミリアの声がする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2169.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"8EFBEEAB-A123-4EC2-B26F-3CF36D9A04E3","title":"シーン 2170","duration":5.7,"slideTitle":"第2170スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"レミリア・スカーレット","telop":"「ねぇ、あなたとこいしは互いの存在に依存する共依存じゃないかしら…、もしあなたが彼女の発言に安心してたらだけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2170.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり驚き後ろ手.png"},{"id":"848341EB-CA90-4518-BA80-8C222D929921","title":"シーン 2171","duration":5.7,"slideTitle":"第2171スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕は、レミリアの発言に、なぜか納得してしまった。そして、こうつぶやく。「確かに、レミリアさんの意見が正しいです…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2171.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり驚き後ろ手.png"},{"id":"73AA259A-FAA2-4E15-9B5E-88328871AF4B","title":"シーン 2172","duration":5.4,"slideTitle":"第2172スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"それから、四人の間には、これまでに感じたことのない冷たく気まずい空気が漂い出す。そして、沈黙の時間が流れる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2172.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フランごくり.png"},{"id":"7BCAA47A-2E33-468E-893D-1D3769A99DB7","title":"シーン 2173","duration":5.5,"slideTitle":"第2173スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"レミリア・スカーレット","telop":"「それで、これからどうするの？あなたの意見を聞かせてもらえないかしら…。じゃないと来月からの予定が狂うのよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2173.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フランごくり.png"},{"id":"346C53CB-D5D6-4F31-A583-0FC0DE008783","title":"シーン 2174","duration":5.4,"slideTitle":"第2174スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「僕は…、この関係が壊れるのは嫌で、フランさんと離婚したくない…、でも、これは僕の単なるわがままですよ…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2174.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フランごくり.png"},{"id":"038D2C19-01A4-47CB-A263-A4810D4DC569","title":"シーン 2175","duration":5.2,"slideTitle":"第2175スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕は、それからしばらくの間、冷えた笑いに溢れかえる。\nだが、フランが僕の頬を強く叩き、僕はハッと我に帰る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2175.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"D4A213D5-9FAB-43FC-8D8D-8B4B402D120A","title":"シーン 2176","duration":5.4,"slideTitle":"第2176スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"フランドール・スカーレット","telop":"「紅夢、しっかりして！このことは、あなたの妻である私の責任でもあるし、そこら辺はちゃんと責任を果たすから！」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2176.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"10A78351-243F-4764-B06B-37736058749F","title":"シーン 2177","duration":5.7,"slideTitle":"第2177スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"「確かにフランのいう通りですね…、このままだといけないのは僕も分かっているので、誰にも依存しないようにしますよ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2177.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"75883B4A-2118-4595-920E-D81C39ECA2F1","title":"シーン 2178","duration":4.7,"slideTitle":"第2178スライド","backgroundName":"nc213186_紅魔館ロビー.jpg","characterName":"操夢","telop":"僕はそう言う。だが、僕はまだ気づけなかった。\n僕の中でのこいしの存在の大きさ、そしてその効果を。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2178.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc213186_紅魔館ロビー.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"1E843EE9-A530-4D28-8527-DDD58752019B","title":"続く…","duration":2.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2179.jpeg","animationDuration":2.0},{"id":"C1213F3F-D3BE-4C37-A9E4-F3BB72BB14B2","title":"ご視聴ありがとうございました！","duration":20.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2180.jpeg","animationDuration":20.0}]