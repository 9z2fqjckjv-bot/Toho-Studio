":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2004.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/帽子なし怒り.png"},{"id":"577C658B-4425-4874-BBCE-7B4CBEF71C50","title":"古明地こいし（中学生）","duration":5.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2005.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/帽子なし怒り.png","animationDuration":5.0},{"id":"9B7E97B9-56BC-4A76-99D7-E1934019BD64","title":"シーン 2006","duration":5.2,"slideTitle":"第2006スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"あれからしばらく経ち、大型連休が終わり、僕は再び学校にやってきた。そして、いつものように朝礼が始まった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2006.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"09563F5C-CDF4-4FCE-B378-F17756FF40ED","title":"シーン 2007","duration":5.5,"slideTitle":"第2007スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「今日は、連休明け初日ですが、気を引き締め、教員から叱責を受けることもなく、向上心を持って取り組みましょう。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2007.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"9658AC9C-D49E-41A0-BE0E-0DCF3D7925A7","title":"シーン 2008","duration":5.300000000000001,"slideTitle":"第2008スライド","backgroundName":"2026-10-04_16-42.png","characterName":"東風谷早苗","telop":"「ただし、藤原さんは、このあと、速やかに職員室に向かってください。連休前の行動に関して確認をしますから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"東風谷早苗","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2008.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/早苗（微笑）.png"},{"id":"D8BC8BB0-3AE2-4A2C-9FB4-832046DDCFA6","title":"シーン 2009","duration":4.2,"slideTitle":"第2009スライド","backgroundName":"2026-10-04_16-42.png","characterName":"操夢","telop":"彼女はそういうと、去って行った。\n僕は、何となくの予測がついた状態で、職員室に向かう。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2009.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/2026-10-04_16-42.png"},{"id":"52C0C04B-67CB-40A2-A487-80812FF20462","title":"シーン 2010","duration":4.2,"slideTitle":"第2010スライド","backgroundName":"nc253888_学校の職員室（日中）.jpg","characterName":"操夢","telop":"僕はそれから、職員室に来ると、ある女性がやってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2010.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc253888_学校の職員室（日中）.jpg"},{"id":"96EB2037-A8FD-477F-AED6-ADBAC9D5E095","title":"シーン 2011","duration":3.5,"slideTitle":"第2011スライド","backgroundName":"nc253888_学校の職員室（日中）.jpg","characterName":"射命丸文","telop":"「とりあえず、別室に行きましょうか。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2011.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc253888_学校の職員室（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"C8D9D2FA-F7C8-4037-95E1-5379A35D7866","title":"シーン 2012","duration":3.5,"slideTitle":"第2012スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"操夢","telop":"僕が彼女についていくと、やってきたのはある部室だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2012.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"2D2E6B0E-6827-42E1-9EE3-FFA3F0B2334D","title":"シーン 2013","duration":3.5,"slideTitle":"第2013スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「ひとまず、遠足から今に至るまでの流れを説明してください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2013.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"C11C0B74-657D-4041-9E96-D31EBF0D7DE9","title":"シーン 2014","duration":4.800000000000001,"slideTitle":"第2014スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"操夢","telop":"彼女がそういうと、僕は、彼女に言われた通りに話す。\n彼女は、時折相槌や質問をしながら、聞いていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2014.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"FE80CF3E-764A-4A1D-982D-8E6BE96038C7","title":"シーン 2015","duration":3.5,"slideTitle":"第2015スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「それにしても、厄介ですね…、例の発表は…」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2015.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"52ED9062-0D60-44CE-992F-01B551D5C6A8","title":"シーン 2016","duration":3.5,"slideTitle":"第2016スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"操夢","telop":"「地下底国グループの話ですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2016.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"1517428F-E0BE-42D2-BBC3-A9BDD6EE1D39","title":"シーン 2017","duration":3.5,"slideTitle":"第2017スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「ええ…、何しろ学校も巻き添えを食らってますから…」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2017.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"A4423AE6-F124-413C-A7BD-D2908E32B802","title":"シーン 2018","duration":3.5,"slideTitle":"第2018スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"操夢","telop":"「それで、遠足前に来た、例のお題はどうなったんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2018.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（困る）.png"},{"id":"23BEBB21-C61A-4344-9EF8-7C97D0EC1409","title":"シーン 2019","duration":3.5,"slideTitle":"第2019スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「確かに、あなたの行動は、周囲に大きな影響を与えました。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2019.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（怒る）.png"},{"id":"EF655740-4AC5-47DE-94E9-1F9B0E56B8A2","title":"シーン 2020","duration":5.6000000000000005,"slideTitle":"第2020スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「ですが、あなたの行動は、こちらが予定していた試験を前取りしたのであることを私たちも認識してますから。ただし…」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2020.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"06CE11E7-B33E-4BF5-9DB6-EEE149A11349","title":"シーン 2021","duration":5.800000000000001,"slideTitle":"第2021スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「あなたは、これからパチュリー博士のいる研究室に向かってもらいます。そこではアリスさんに事情を聞き取り中ですから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2021.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"D76D7E61-C38F-4A1E-8B2F-31664F20805D","title":"シーン 2022","duration":3.5,"slideTitle":"第2022スライド","backgroundName":"nc227198_部室（昼）.jpg","characterName":"射命丸文","telop":"「とりあえず、私の後についてきてください。」","animationName":"なし","transitionName":"なし","voiceCharacter":"射命丸文","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2022.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc227198_部室（昼）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/文（微笑）.png"},{"id":"5B829D04-870B-432A-94B7-4F4E5B50D3E2","title":"シーン 2023","duration":4.0,"slideTitle":"第2023スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"操夢","telop":"僕がそう言った彼女と共に研究室にくると、\n彼女のいう通りアリスとパチュリーがいた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2023.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（弱る）.png"},{"id":"F295617B-25DC-48B5-9EBF-8B7A60B71D4F","title":"シーン 2024","duration":3.5,"slideTitle":"第2024スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"操夢","telop":"そして、彼女はパチュリーに耳打ちしてから去って言った。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2024.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/東方惑情録　第3話/パチュリー（弱る）.png"},{"id":"0FA1BB99-8282-4494-970F-D6D933240626","title":"シーン 2025","duration":3.5,"slideTitle":"第2025スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"パチュリー・ノーレッジ","telop":"「あら、当の本人がやってきたのね…、それで何の用かしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2025.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"E91EAD2E-5C00-446D-B7BC-C8417ACF3882","title":"シーン 2026","duration":3.5,"slideTitle":"第2026スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"操夢","telop":"「えっと…、彼女について来てと言われて来ただけですけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2026.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"EAA8A7F5-8FCC-4A0D-9395-9148A4140418","title":"シーン 2027","duration":3.5,"slideTitle":"第2027スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"パチュリー・ノーレッジ","telop":"「そうね…、とりあえず、私のとこに来なさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2027.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"D14C589C-9DFA-4C52-8CB7-10FEB2941E43","title":"シーン 2028","duration":5.300000000000001,"slideTitle":"第2028スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"操夢","telop":"彼女は、そう言って、手をこまねく。僕は、彼女のそばに立つ。\nすると、彼女は何かの瓶を手に取り、説明を始める。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2028.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"B9B19A40-648A-4223-B8A1-F0851A2F9A50","title":"シーン 2029","duration":5.7,"slideTitle":"第2029スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"パチュリー・ノーレッジ","telop":"「とりあえず、遠足後に受ける試験として、この液体を飲んでもらうから。たとえ不味くても、吐かずに飲み切りなさいね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"パチュリー・ノーレッジ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2029.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"46D4B848-DDE2-48A3-9DA7-508ABDC47A3E","title":"シーン 2030","duration":5.800000000000001,"slideTitle":"第2030スライド","backgroundName":"5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterName":"操夢","telop":"彼女はそういうと、僕が何かを言い出す前に、この瓶の中にある液体を飲ませてくる。そして僕は、意識が闇に落ちるのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2030.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/5296ED2E-3516-5D38-AACC-F50CB132CE91.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/パチュリー（微笑）.png"},{"id":"CC418DA8-C756-4A62-B759-E34B7E5AE314","title":"シーン 2031","duration":4.800000000000001,"slideTitle":"第2031スライド","backgroundName":"単色背景","characterName":"操夢","telop":"僕は、ふと気がつくと、そこは暗闇が広がる空間だった。\nすると、遠くで誰かが戦っている音が聞こえる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2031.jpeg"},{"id":"36844F59-3BED-475F-8953-1506DFC75C53","title":"シーン 2032","duration":5.1000000000000005,"slideTitle":"第2032スライド","backgroundName":"単色背景","characterName":"操夢","telop":"その音は、だんだんとこちらに近づいてきくる。\nそして、だんだんと暗闇に慣れて見えたのは、女性の姿だった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2032.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/疲労.png"},{"id":"81C9F83A-CE32-442A-AA3B-E0F6BF070707","title":"シーン 2033","duration":3.5,"slideTitle":"第2033スライド","backgroundName":"単色背景","characterName":"サブ","telop":"「今すぐ、私の背中に隠れなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2033.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/疲労.png"},{"id":"2938D531-8656-4377-856D-6732236C856B","title":"シーン 2034","duration":5.6000000000000005,"slideTitle":"第2034スライド","backgroundName":"単色背景","characterName":"操夢","telop":"彼女がそういうと、僕は無意識のうちに、彼女の背中に隠れる。\nなぜだかわからないが、彼女が母である霊夢に見えていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2034.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/疲労.png"},{"id":"168EB1B8-40A7-4350-9C2F-85617A87A188","title":"シーン 2035","duration":3.6,"slideTitle":"第2035スライド","backgroundName":"単色背景","characterName":"操夢","telop":"すると、彼女は暗闇から鋭い攻撃を受ける。\nそして、ぐちゃりと何か飛び散る。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2035.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/疲労.png"},{"id":"C445A29D-E516-4BAF-96FE-95BB793B4409","title":"シーン 2036","duration":3.5,"slideTitle":"第2036スライド","backgroundName":"単色背景","characterName":"操夢","telop":"僕は、それが血だとわかると、彼女から離れようとする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2036.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc422703_血痕06【フリー素材あそび】.png"},{"id":"4D3A25E1-5CD9-47D9-B5AD-15D7BF4DAE5C","title":"シーン 2037","duration":4.5,"slideTitle":"第2037スライド","backgroundName":"単色背景","characterName":"サブ","telop":"「逃げるな、目の前の景色を目に焼き付けなさい…\nそうじゃないと次は、あなたの番になるわよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"サブ","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2037.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc422703_血痕06【フリー素材あそび】.png"},{"id":"2EA069D6-289E-4DB5-8D90-D96F823CEE43","title":"シーン 2038","duration":3.5,"slideTitle":"第2038スライド","backgroundName":"単色背景","characterName":"操夢","telop":"彼女がそう言いながら、僕を庇い、再び攻撃を受ける。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2038.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc422703_血痕06【フリー素材あそび】.png"},{"id":"786ABA98-684C-4204-B79F-6319D18457BD","title":"シーン 2039","duration":5.300000000000001,"slideTitle":"第2039スライド","backgroundName":"単色背景","characterName":"操夢","telop":"するとまた血が飛び散り、今度はその相手の姿が一瞬見える。\n「えっ…」そして、ある姿と重なる。「魔理沙さん…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2039.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc422703_血痕06【フリー素材あそび】.png"},{"id":"2971DFE5-498F-4B0B-961A-E34DE55B0FD8","title":"シーン 2040","duration":5.5,"slideTitle":"第2040スライド","backgroundName":"単色背景","characterName":"操夢","telop":"僕は、そう思わず呟いていると、遠くの方から誰かが僕の声を叫んでいるような感じがして、だんだんと視界が暗転した。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2040.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc422703_血痕06【フリー素材あそび】.png"},{"id":"938A9F7A-CCE7-4534-A0EF-2168DBC845C9","title":"シーン 2041","duration":4.7,"slideTitle":"第2041スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「んっ…」僕は誰かの叫び声で目が覚める。\nそこには、頬照った状態で泣いているこいしの姿があった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2041.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/やられ涙目驚き頬照り.png"},{"id":"04B82F29-882C-454F-9A39-CC69EA473C6E","title":"シーン 2042","duration":3.5,"slideTitle":"第2042スライド","backgroundName":"nc256896_病室-昼.png","characterName":"古明地こいし","telop":"「目が覚めたの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2042.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/やられ涙目驚き頬照り.png"},{"id":"BE8FDA03-CF70-47E6-8955-7DF22E0D0561","title":"シーン 2043","duration":3.5,"slideTitle":"第2043スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「ええ…、僕はどれくらい寝てましたか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2043.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/やられ涙目驚き頬照り.png"},{"id":"727FCE8F-ABE5-4FFB-9297-71833FC4553E","title":"シーン 2044","duration":3.5,"slideTitle":"第2044スライド","backgroundName":"nc256896_病室-昼.png","characterName":"古明地こいし","telop":"「えっと…数時間くらい。でも、ずっと苦しそうにしてた…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2044.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恥ずかしい顔こいし.png"},{"id":"67593196-FF1C-4DE6-8009-1B5A89CB4970","title":"シーン 2045","duration":3.5,"slideTitle":"第2045スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「授業はどうしたんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2045.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恥ずかしい顔こいし.png"},{"id":"39E2BB53-9110-4D94-93E0-AA42367F3CCA","title":"シーン 2046","duration":3.5,"slideTitle":"第2046スライド","backgroundName":"nc256896_病室-昼.png","characterName":"古明地こいし","telop":"「いまは、お昼休み。それで、何か悪い夢でもみたの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2046.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り目閉じこいし.png"},{"id":"FB65E472-16B8-4567-A753-75E2201F28A9","title":"シーン 2047","duration":4.4,"slideTitle":"第2047スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"「えっと…」僕はそういうが、うまく思い出せない。\n「確かに、悪い夢だったかもしれません…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2047.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り目閉じこいし.png"},{"id":"5F896E8F-4509-4ADE-B914-766042E5603E","title":"シーン 2048","duration":3.5,"slideTitle":"第2048スライド","backgroundName":"nc256896_病室-昼.png","characterName":"古明地こいし","telop":"「とりあえず、先生に報告してくるから、待ってて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2048.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（困る）.png"},{"id":"8460E533-7DF0-4DE7-9DFF-91240F811B7D","title":"シーン 2049","duration":3.5,"slideTitle":"第2049スライド","backgroundName":"nc256896_病室-昼.png","characterName":"操夢","telop":"彼女はそういうと、去っていった。僕は、ただ困惑していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2049.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256896_病室-昼.png"},{"id":"B8866B24-9E75-4844-B40C-6CA9A4B1FECF","title":"?（主人公の彼に潜む、謎の黒い影。圧倒的…）","duration":5.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2050.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/恐怖にやり.png","animationDuration":5.0},{"id":"7ADD0BA2-3415-48C9-8846-19904C6B4E26","title":"シーン 2051","duration":3.5,"slideTitle":"第2051スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"僕はそれから、永琳に呼ばれを診察を受けていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2051.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png"},{"id":"A9539116-30B3-42A0-8A29-68CFF3AD6269","title":"シーン 2052","duration":4.4,"slideTitle":"第2052スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「それで、パチュリー博士があなたに、\n飲ませた液体に関する感想を聞かせてもらおうかしら。」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2052.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"31E080C9-8A00-43DE-9CE5-E4A01A91BA92","title":"シーン 2053","duration":4.0,"slideTitle":"第2053スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"「感想って言われても…、\n飲んだ直後に意識が飛んじゃったので、覚えてないです…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2053.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"FA44507A-D11D-456A-8B1E-599D11EACFB2","title":"シーン 2054","duration":3.5,"slideTitle":"第2054スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「そう…、それでさっきまで見てた夢は分かるかしら？」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2054.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"B9F334D3-9DBA-4C8C-9853-290851FB937F","title":"シーン 2055","duration":3.5,"slideTitle":"第2055スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"「多分こいしさんがいうに、悪い夢だったんだと思います。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2055.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"705FEF15-1D7C-49E9-858B-5DD340A4343F","title":"シーン 2056","duration":3.5,"slideTitle":"第2056スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「それで、あなたの考えは？」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2056.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"382F635C-51EC-4212-8CA4-26BFCA992F01","title":"シーン 2057","duration":3.5,"slideTitle":"第2057スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"「いや…夢の内容を覚えているわけではないので…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2057.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"E6CB1EC7-70EA-4CB5-95EE-14534B09726A","title":"シーン 2058","duration":3.5,"slideTitle":"第2058スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「そう…」私は、そう言いながら、彼にあるものを見せる。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2058.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"0D0CBA90-0512-49AE-8B02-DF91AFAAE2A0","title":"シーン 2059","duration":3.5,"slideTitle":"第2059スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"「それは…脳波ですか…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2059.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"57E9BB3D-AFBB-415E-BAE3-65BF33118A90","title":"シーン 2060","duration":4.800000000000001,"slideTitle":"第2060スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「ええ。実は、あなたがあの研究室で倒れた後、\nすぐに病室に運ばれて、あなたの脳波をとっていたの。」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2060.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"E3762826-3850-4542-979C-45D75CB32A1F","title":"シーン 2061","duration":3.5,"slideTitle":"第2061スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"「そうですか…、それで、何かわかるんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2061.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"7601A337-0B73-494C-90B4-0C1D2903163C","title":"シーン 2062","duration":5.4,"slideTitle":"第2062スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「そうね…、簡潔にいうなら、あなたの落ち着き度合いを確認するためよ。まぁ、そんなことは気にしなくていいわ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2062.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"62F345BC-A70C-46E3-B507-C46858F72BD9","title":"シーン 2063","duration":5.300000000000001,"slideTitle":"第2063スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「とりあえず、今日の診察はここまでにしましょう、学校には早退と伝えてあるから、病室に戻って休んでなさい。」","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2063.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"176E46F0-A39D-4492-96FC-18AB5B76C324","title":"シーン 2064","duration":3.5,"slideTitle":"第2064スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"操夢","telop":"「分かりました…」僕はそういうと、病室に戻っていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2064.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png"},{"id":"38ABC839-628F-4A09-B7D6-F12C86DC1A13","title":"シーン 2065","duration":5.800000000000001,"slideTitle":"第2065スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"私は彼が帰ると、ある彼のデータを眺めていた。実は、さっき見せた脳波のデータはダミーで、本当は違うデータを取っていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2065.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（怒り）.png"},{"id":"C61D62E1-3ED3-4C8F-BD14-0C8933FE4305","title":"シーン 2066","duration":5.9,"slideTitle":"第2066スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"「3つ目の人格ね…」私はそう言いながら、彼のカルテを見返す。そのカルテとデータを照らし合わせながら、ある3人を考える。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2066.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（怒り）.png"},{"id":"37EB8582-C656-4EDD-9B31-B3D2F2930326","title":"シーン 2067","duration":5.7,"slideTitle":"第2067スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"実は、それは彼の出生に関わる秘密情報でもあり、しかもその情報を以前、彼を担当してた医者からは聞いてないものだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2067.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（怒り）.png"},{"id":"5799080A-08D0-4392-90DC-CEFE0D5F8C0F","title":"シーン 2068","duration":3.5,"slideTitle":"第2068スライド","backgroundName":"nc166698_病院の診察室.png","characterName":"八意永琳","telop":"それは、彼の両親と、ある女性の過去を端的に表していた。","animationName":"なし","transitionName":"なし","voiceCharacter":"八意永琳","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2068.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc166698_病院の診察室.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（怒り）.png"},{"id":"F10929AA-0E39-427C-8E58-DAED13E44419","title":"八意永琳（主人公の担当医）","duration":5.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2069.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/永琳（微笑）.png","animationDuration":5.0},{"id":"744F8A36-4B02-4BF0-9955-0DBCCD8A051C","title":"シーン 2070","duration":3.5,"slideTitle":"第2070スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"古明地こいし","telop":"「紅夢、退院できるみたいだから、一緒に帰ろ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2070.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（微笑）.png"},{"id":"DA8EF5DF-2B34-4035-BE9B-6D32E3A0BA21","title":"シーン 2071","duration":5.800000000000001,"slideTitle":"第2071スライド","backgroundName":"nc256897_病室-夕方-電気あり.png","characterName":"操夢","telop":"彼女は、突如病室の扉を開け、僕にそう言ってくる。「そうですか…、分かりました。」僕はそう言い、ゆっくりと体を起こす。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2071.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256897_病室-夕方-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（微笑）.png"},{"id":"68BF32ED-8B5B-4949-88EA-C14DFC6010A4","title":"シーン 2072","duration":5.2,"slideTitle":"第2072スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"僕たちが、校門から出てくると、フランが驚いた様子で、車から降りてきた。「どうしたんですか、フランさん？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2072.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（微笑）.png"},{"id":"4447A191-5F4C-465C-AB0F-CCD18EAA371E","title":"シーン 2073","duration":3.5,"slideTitle":"第2073スライド","backgroundName":"image79.jpeg","characterName":"フランドール・スカーレット","telop":"「手を見なさい！」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2073.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"73936C6A-3481-4D53-AC91-3157F416A41D","title":"シーン 2074","duration":3.6,"slideTitle":"第2074スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"「こいしさんが、こうしたい言ったから、\n単純に手を繋いでいるんですけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2074.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（余裕）.png"},{"id":"467AA009-CB86-4EDE-8314-17A23D847868","title":"シーン 2075","duration":5.0,"slideTitle":"第2075スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"僕は、単純にそう説明する。ふと、隣を見ると、こいしがニヤついていた。だが、ある嫌な目線を僕は感じる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2075.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/こいし（余裕）.png"},{"id":"51240227-8E7C-4167-9AB4-CFD52CCCABB6","title":"シーン 2076","duration":5.1000000000000005,"slideTitle":"第2076スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"すると、僕の視線に気がついたのか、彼女がこちらに駆け寄ってくる。そして、彼女はポッケを探るようにする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2076.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（余裕影）.png"},{"id":"A1B606E9-8EF8-4196-8757-0AEE6035875E","title":"シーン 2077","duration":5.5,"slideTitle":"第2077スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"すると、彼女はナイフを取り出す。僕が、反射的にこいしの前に立つ。すると、僕の体にナイフが突き刺さる。「うっ…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2077.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/さとり（余裕影）.png"},{"id":"89C801D2-290F-4E9B-8A3F-051350928967","title":"シーン 2078","duration":5.6000000000000005,"slideTitle":"第2078スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"僕は、瞬間的に状況を把握し、残っている力を込めて、こいしにいう。「こいしさん、フランさんと車で帰ってください！」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2078.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影付き恐怖顔.png"},{"id":"757AB7F4-98F9-49FD-B10F-7B89DEDB6F16","title":"シーン 2079","duration":5.6000000000000005,"slideTitle":"第2079スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"「ほら、さっさと動かないと、僕たちは、さとりの手の平の上で遊ばれてしまいますよ！」僕はできるだけ大きな声で言う。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2079.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影付き恐怖顔.png"},{"id":"652E5E45-48D4-4150-A892-6FAC1D6F1E10","title":"シーン 2080","duration":3.5,"slideTitle":"第2080スライド","backgroundName":"image79.jpeg","characterName":"古明地こいし","telop":"「でも、紅夢が…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2080.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困り.png"},{"id":"0F85F185-E0D9-4F10-B165-FFDF03F84E32","title":"シーン 2081","duration":5.0,"slideTitle":"第2081スライド","backgroundName":"image79.jpeg","characterName":"古明地こいし","telop":"僕は、いてもたってもいられなくなり、傷口を押さえ込む手を離し、血がついた手で二人を順番にビンタする。","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2081.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困り.png"},{"id":"93ED6FDC-3FB2-4625-ACA0-34E37BE8B823","title":"シーン 2082","duration":5.800000000000001,"slideTitle":"第2082スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"「フランさん、僕のことは気にせずに、彼女を連れて、家に戻ってください。」僕は、一瞬正気を取り戻したフランにそう言う。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2082.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困り.png"},{"id":"0447B576-E21A-4FC3-9DC0-E9287F1FE212","title":"シーン 2083","duration":3.5,"slideTitle":"第2083スライド","backgroundName":"image79.jpeg","characterName":"操夢","telop":"だが、それとともに僕は意識を失ってしまうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2083.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/image79.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/影あり困り.png"},{"id":"0CBC7BC2-3C06-4E9E-A213-E8094AC02BD9","title":"名無し（主人公の2つ目の人格）","duration":5.0,"slideTitle":"中扉","backgroundName":"単色背景","characterName":"","telop":"","animationName":"なし","transitionName":"なし","voiceCharacter":"","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2084.jpeg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/やられ怒り.png","animationDuration":5.0},{"id":"B40EC884-5A96-4CC3-AD3C-5D44DB07263C","title":"シーン 2085","duration":5.2,"slideTitle":"第2085スライド","backgroundName":"単色背景","characterName":"操夢","telop":"僕は、ふと気がつくと、そこはまたもや暗闇に包まれた空間だった。だが、なんとなくさっきのとは違う気がする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2085.jpeg"},{"id":"6734AC70-3575-46BD-8505-DCCE69C9005F","title":"シーン 2086","duration":3.5,"slideTitle":"第2086スライド","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","characterName":"操夢","telop":"すると、暗闇からモザイクが掛かったベッドが見えてくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2086.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・まっくら・青）.pxd"},{"id":"EE47037A-840C-48C2-AF26-8DE142497251","title":"シーン 2087","duration":4.5,"slideTitle":"第2087スライド","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","characterName":"操夢","telop":"そして、頬照りながらニヤつく、母と魔理沙、\nさらに、頬照りながらも困っている父の姿があった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2087.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・まっくら・青）.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/Tپj.png"},{"id":"9A664308-9DD5-4345-A975-C57E976342A9","title":"シーン 2088","duration":5.2,"slideTitle":"第2088スライド","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","characterName":"操夢","telop":"僕は、状況的に3人ともお酒に酔ってることがわかる。\nすると、3人は言葉にならないことを呟きながら、重なる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2088.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・まっくら・青）.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"CDB33576-C261-4E37-B893-32DFBC0EB327","title":"シーン 2089","duration":5.7,"slideTitle":"第2089スライド","backgroundName":"寝室の窓際のベッド（夜・まっくら・青）.pxd","characterName":"操夢","telop":"僕はそこで、知らずとも理解してしまうのだった、僕の遺伝子には、両親からのとは別に、魔理沙のものもあるということに。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2089.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/寝室の窓際のベッド（夜・まっくら・青）.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/妹紅（困る）.png"},{"id":"C5613F4E-315D-406C-9614-8107A30A26E9","title":"シーン 2090","duration":4.1000000000000005,"slideTitle":"第2090スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"僕はふと目が覚めると、そこは病室だった。\nすると、フランが驚いた表情で僕を見ていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2090.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"826EBE22-4E35-499E-A3D1-A2CDBA62EAFD","title":"シーン 2091","duration":3.5,"slideTitle":"第2091スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"フランドール・スカーレット","telop":"「紅夢が目覚めたこと、お姉様とこいしに伝えてくるね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2091.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"9D91EB9E-8AE5-496A-B30A-70ECCF52258B","title":"シーン 2092","duration":5.7,"slideTitle":"第2092スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"彼女はそう言うと去ってしまった。僕はただ一人、ぼーっとする。なぜか、頭の中では、先ほど見た夢が繰り返し再生された。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2092.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png"},{"id":"485380FB-1D54-414E-8C96-5701FCA4607F","title":"シーン 2093","duration":5.7,"slideTitle":"第2093スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"僕が、数分ほど待っていると、フランはレミリアとこいしを引き連れて戻ってきた。そして、なんとも言えない空気が流れる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2093.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"A0422ED7-F655-48F5-84E1-FD01F166524F","title":"シーン 2094","duration":3.5,"slideTitle":"第2094スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"古明地こいし","telop":"「目が覚めてよかった…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.2094.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc256899_病室-夜-電気あり.png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"1EC6562E-57C4-4B68-A375-E659FD6DF6C8","title":"シーン 2095","duration":3.5,"slideTitle":"第2095スライド","backgroundName":"nc256899_病室-夜-電気あり.png","characterName":"操夢","telop":"こいしがそう呟くと、フランが反応する。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOver