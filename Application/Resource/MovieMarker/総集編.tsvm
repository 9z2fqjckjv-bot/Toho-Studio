itory\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1850.jpeg","id":"409F6361-42CD-4814-B5EF-53A68DF04A5A","slideTitle":"第1850スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/フラン困り後ろ手.png","telop":"主人公の彼が1500m走を8分台で走破した後、倒れそのまま大学病院に入り、その後魔理沙と霊夢の見舞いがあったの翌日の朝に彼の病室を訪ねた大人の女性。彼を検査室に案内している。耳が特徴的。シリーズ出ているのは第4話のみ。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"大学病院に勤める看護師","animationName":"なし","duration":5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1851.jpeg","id":"DB4B7ED7-493E-4DC4-B6BE-8D63D0EA52AE","slideTitle":"タイトル"},{"telop":"僕はあの後、魔理沙の家に向かったが、彼女が引っ越したことがわかり、隣の住人から聞いた話をもとにこの家に来た。","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1852","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第26話\/nc235078_家（日中）.jpg","backgroundName":"nc235078_家（日中）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1852.jpeg","id":"65A6A256-32BB-4FA6-949E-61BE3362C10A","slideTitle":"第1852スライド"},{"telop":"この家は、僕が以前まで住んでいた家のため、\nインターホンを鳴らさずに、中に入っていく。","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1853","animationName":"なし","duration":4.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/