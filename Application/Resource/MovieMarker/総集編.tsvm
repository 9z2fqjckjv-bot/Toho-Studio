ール.jpg","backgroundName":"nc230307_ショッピングモール.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1181.jpeg","id":"5B475DD7-EF2A-4E5B-9085-821FB4985CD0","slideTitle":"第1181スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/こいし（笑い）.png","telop":"「えっ、こいし。本気でくじ引きをするの？紅夢さんも、\n無理にお金を出そうとしなくて、大丈夫ですよ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 1182","animationName":"なし","duration":4.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc230307_ショッピングモール.jpg","backgroundName":"nc230307_ショッピングモール.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1182.jpeg","id":"B5BB04F3-13E3-48D0-8371-B56032C97F4D","slideTitle":"第1182スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/こいし（笑い）.png","telop":"「ありがとう…！」\n私はそう言うと、早速、そのお店に入って行った。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 1183","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc230307_ショッピングモール.jpg","backgroundName":"nc230307_ショッピングモール.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1183.jpeg","id":"CC3D01EE-49D9-459E-B5F2-8AE3AB3E7592","slideTitle":"第1183スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","telop":"「あの、いいんですか、妹のわがままに付き合っても…。\nもし、あれだったら、私が注意しますよ…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 1184","animationName":"なし","duration":4.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc230307_ショッピングモール.jpg","backgroundName":"nc230307_ショッピングモール.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1184.jpeg","id":"829034B3-86B5-4AEA-B6CD-2C830E03240C","slideTitle":"第1184スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","telop":"僕は、そういう彼女にあるものをバックから取り出し見せる。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1185","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc230307_ショッピングモール.jpg","backgroundName":"nc230307_ショッピングモール.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1185.jpeg","id":"EB5F69F3-A411-467D-804C-A2FF0E144B41","slideTitle":"第1185スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/さとり（驚く）.png","telop":"私は、彼がバックから取り出した、封筒の中身を見て驚く。\nそこには、ある衝撃の内容が書かれた手紙とカードがあった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"titl