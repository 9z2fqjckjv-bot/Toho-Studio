":"なし","duration":4.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1646.jpeg","id":"A1EC5D24-0403-4604-BD14-828D1F68DAA6","slideTitle":"第1646スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「あの、いいんですか？こいしさんだけはしゃいでしまって。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"title":"シーン 1647","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1647.jpeg","id":"6DBDD644-7181-47C5-94E9-AA81A1D7A112","slideTitle":"第1647スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/アリス（困り）.png","telop":"「別にいいですよ。僕は、\nその姿を遠くから見るだけで十分満足ですから…。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1648","animationName":"なし","duration":3.6,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1648.jpeg","id":"E88A66D8-CC28-44B8-A5CE-230F52FCAFC8","slideTitle":"第1648スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","telop":"「あなた、それ本音なのですか？」\n私は、彼の発言に思わず驚き、そう尋ねてしまう。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"アリス・マーガトロイド","bgmStartTimeOffset":0,"title":"シーン 1649","animationName":"なし","duration":3.9000000000000004,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1649.jpeg","id":"4C5D6A4C-974A-4AE4-86E3-C0CDCEED9EC2","slideTitle":"第1649スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第21話\/アリス（驚く）.png","telop":"「ええ、そうですけど…、それが何か？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1650","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1650.jpeg","id":"6D086C14-3B3D-452B-B7E4-B4D9834605D1","slideTitle":"第1650スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","telop":"「私は知りませんからね…、そんな考えで彼女に接しても…」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1651","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1651.jpeg","id":"E424A8A9-0239-41B7-A80D-6F0FA06C38E6","slideTitle":"第1651スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","telop":"僕は、彼女が何を言いたいのかが、分からなかった。\nだが、海ではしゃぐこいしの姿を見て、ほのぼのとした。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 1652","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.1652.jpeg","id":"F7F4B1A9-A7A2-4560-B021-595B57F6332B","slideTitle":"第1652スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/アリス（困る）.png","telop":"「あの、私の存在を忘れてはいませんか？」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 1653","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/image74.jpeg","backgroundName":"image74.jpeg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932