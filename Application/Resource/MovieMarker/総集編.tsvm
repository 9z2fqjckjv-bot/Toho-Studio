8E%9F%E5%A6%B9%E7%B4%85","telop":"「その館は、３階建だったんだけど、その金髪女性の一言で崩壊すると、その断片が俺に飛んできてさ…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/妹紅やれやれ.png","seStartTimeOffset":0,"voiceCharacter":"藤原妹紅","voiceDuration":8.954489795918366,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"藤原妹紅","bgmStartTimeOffset":0,"title":"シーン 176","animationName":"なし","duration":4.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1765_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.176.jpeg","id":"34D859A8-CCC0-4404-BB9E-13E923FD5C39","slideTitle":"第176スライド"},{"audioTrack":"track_voice_%E8%97%A4%E5%8E%9F%E5%A6%B9%E7%B4%85","telop":"「その断片を直前に避けてから、そいつに言ってやったんだ、「こんなリスキーなことしてたら労災につながるぞって。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/妹紅やれやれ.png","seStartTimeOffset":0,"voiceCharacter":"藤原妹紅","voiceDuration":10.821995464852607,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"藤原妹紅","bgmStartTimeOffset":0,"title":"シーン 177","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1772_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.177.jpeg","id":"857FABA2-3E99-4F20-B0D5-4EF8753F1753","slideTitle":"第177スライド"},{"audioTrack":"track_voice_%E8%97%A4%E5%8E%9F%E5%A6%B9%E7%B4%85","telop":"「だけどそいつの姉がまぁ、お嬢様気取りの嫌なやつで、俺の助言など耳にも入れない、昔からあそこはそうだ…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/妹紅やれやれ.png","seStartTimeOffset":0,"voiceCharacter":"藤原妹紅","voiceDuration":10.988231292517007,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"藤原妹紅","bgmStartTimeOffset":0,"title":"シーン 178","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/nc283171_商店街（夕方）.jpg","backgroundName":"nc283171_商店街（夕方）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1780_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.178.jpeg","id":"2A615E6D-198B-4FA0-A7AC-50555004E199","slideTitle":"第178スライド"},{"audioTrack":"track_voice_%E8%97%A4%E5%8E%9F%E5%A6%B9%E7%B4%85","telop":"「だが、そんなことよりも、今日もこうして、霊夢のところに帰って来れて、俺は幸せ者だぜ。」私はそう笑みを浮かべる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/妹紅（笑い）.png","seStartTimeOffset":0,"voiceCharacter":"藤原妹紅","voiceDuration":6.729478458049886,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"藤原妹紅","bgmStartTimeOffset":0,"title":"シーン 179","animationName":"なし","duration":5.6000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1797_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.179.jpeg","id":"6BBD9AB3-7EC7-43CF-B18B-11AAE9DF2CC5","slideTitle":"第179スライド"},{"audioTrack":"track_voice_reimu","telop":"「そうね…」私は、夫のその発言こう返すことしかできなかった。そして、なんだか距離を感じてしまったのだった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/妹紅（笑い）.png","seStartTimeOffset":0,"voiceCharacter":"博麗霊夢","voiceDuration":1.3144897959183675,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"博麗霊夢","bgmStartTimeOffset":0,"title":"シーン 180","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/リビング（夜・照明ON・カーテン閉）.jpg","backgroundName":"リビング（夜・照明ON・カーテン閉）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1809_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.180.jpeg","id":"91B4633F-492E-4E6B-A8EA-CCD3CD303123","slideTitle":"第180スライド"},{"audioTrack":"track_voice_soumu","telop":"「ん…」僕はふと目が覚めると、\n朝日が登り、窓から日光が差し込んでいた。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":1.8756462585034013,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 181","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_181_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.181.jpeg","id":"0A6F4B96-9D88-4915-B0D3-DFC5DC609B86","slideTitle":"第181スライド"},{"audioTrack":"track_voice_soumu","telop":"そして、僕は大きく背伸びしてあくびをすると、誰かが部屋の戸を叩く。「入ってきて大丈夫ですよ。」僕はそう返す。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":4.023469387755102,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 182","animationName":"なし","duration":5.4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_182_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.182.jpeg","id":"CC27AAA4-385F-4036-85FA-5698DFDE88EC","slideTitle":"第182スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第26話\/てゐ（微笑）.png","telop":"「今朝は、よく眠れましたか、紅夢さん。？」\n画像出典\nニコニコモンズ\nみんちりえ\nAppleCreatorStudio","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"因幡てゐ","bgmStartTimeOffset":0,"title":"シーン 183","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.183.jpeg","id":"D31E5E3B-1515-4E66-BF9B-06D9EA0F2D35","slideTitle":"第183スライド"},{"audioTrack":"track_voice_soumu","telop":"「はい。それで、これから検査…ですか？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/フラン困り後ろ手.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":6.395215419501134,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 184","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1843_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.184.jpeg","id":"43B5EA47-B613-4089-8CF8-44F3687A6332","slideTitle":"第184スライド"},{"audioTrack":"track_voice_%E3%81%A6%E3%82%90","telop":"「ええ、それでは、検査室に案内しますね。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第26話\/てゐ（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"てゐ","voiceDuration":1.966984126984127,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"因幡てゐ","bgmStartTimeOffset":0,"title":"シーン 185","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1855_霧雨魔理沙.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.185.jpeg","id":"0A769E7F-D3F8-465A-A83B-3D6B33D77AE8","slideTitle":"第185スライド"},{"audioTrack":"track_voice_soumu","telop":"「わかりました。」\n僕はそういうと、ベッドからおり、検査室に向かっていった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/総集編\/フラン困り後ろ手.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":3.283809523809524,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 186","animationName":"なし","duration":3.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc256896_病室-昼.png","backgroundName":"nc256896_病室-昼.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1867_にとり.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.186.jpeg","id":"80C5A844-79BF-492B-BD04-32982326EFD2","slideTitle":"第186スライド"},{"audioTrack":"track_voice_soumu","telop":"僕は、それから検査を終えると、\nお昼休憩のタイミングで教室に入る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":4.8778231292517,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 187","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_187_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.187.jpeg","id":"3BDF1156-92B8-4D8C-A541-A9119CC72E82","slideTitle":"第187スライド"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「なぜ、お昼時になってあなたが来るのですか…？」\n私は、彼が来たことに驚き、そう聞く。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/さとり（驚く）.png","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","voiceDuration":1.7598639455782312,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 188","animationName":"なし","duration":4.3,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1883_にとり.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.188.jpeg","id":"FF2D16B4-F5EB-403E-A789-83C44C872EFF","slideTitle":"第188スライド"},{"audioTrack":"track_voice_soumu","telop":"「昨日、校庭で3000m走ったら、バタって倒れて、さっきまで…」僕がそう言っていると、突如放送が入る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/さとり（驚く）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":9.025646258503402,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 189","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1898_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.189.jpeg","id":"CA248FF2-0A11-4DD0-8328-BF2918E7DB33","slideTitle":"第189スライド"},{"audioTrack":"track_voice_%E8%90%83%E9%A6%99","telop":"「全校生徒及び児童に次ぐ、本日、５限から７限までは、\nグラウンドで全クラス合同のエンドレスランを行う…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/さとり（驚く）.png","seStartTimeOffset":0,"voiceCharacter":"萃香","voiceDuration":8.320748299319728,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"萃香","bgmStartTimeOffset":0,"title":"シーン 190","animationName":"なし","duration":5.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1900_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.190.jpeg","id":"A0F658FB-0079-46BF-99F7-755836ACB38F","slideTitle":"第190スライド"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%95%E3%81%A8%E3%82%8A","telop":"「どうやら、あまり話している余裕はなさそうですね…、ささっと昼食とって校庭に出たほうがいいですよ。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","seStartTimeOffset":0,"voiceCharacter":"古明地さとり","voiceDuration":3.1644897959183673,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"さ&り","bgmStartTimeOffset":0,"title":"シーン 191","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_191_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.191.jpeg","id":"B5DC531D-CF22-45F4-913D-A0EB53F17B23","slideTitle":"第191スライド"},{"audioTrack":"track_voice_soumu","telop":"彼女がそう呟き、数分で放送は終わり、周りが、急ぎ始める。\n僕は、そこで、今日のお弁当がないことを思い出す。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/さとり（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":3.1615192743764173,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 192","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1920_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.192.jpeg","id":"320E356A-E292-450A-AABD-79A6655913E8","slideTitle":"第192スライド"},{"audioTrack":"track_voice_soumu","telop":"僕はそこで、彼女に学食はあるか聞こうとしたが、すでにそこにはいなかった。僕は仕方がなく、教室を出る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":0.8191156462585034,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 193","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1932_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.193.jpeg","id":"977745EF-51D4-4A56-9CEF-2E2E022A5FA8","slideTitle":"第193スライド"},{"audioTrack":"track_voice_soumu","telop":"そして、校庭に来ると、大勢の女子たちが、グラウンドで動き回っていた。すると、ある女子と体がぶつかる。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":1.2647619047619048,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 194","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1943_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.194.jpeg","id":"D4D27350-9BAD-4BF2-92D6-4AD6A2519A66","slideTitle":"第194スライド"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"「あの、大丈夫ですか？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","voiceDuration":8.731065759637188,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 195","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1951_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.195.jpeg","id":"D1C93DF1-038B-4F95-A335-94E4E5B96B7E","slideTitle":"第195スライド"},{"audioTrack":"track_voice_soumu","telop":"「大丈夫ですけど…あなたは…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.441950113378685,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 196","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1965_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.196.jpeg","id":"7FDADA5D-8EB5-4629-A915-748C0781A924","slideTitle":"第196スライド"},{"audioTrack":"track_voice_%E5%8F%A4%E6%98%8E%E5%9C%B0%E3%81%93%E3%81%84%E3%81%97","telop":"「私は、Kー3組の古明地こいしです。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","seStartTimeOffset":0,"voiceCharacter":"古明地こいし","voiceDuration":5.394489795918368,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"古明地こいし","bgmStartTimeOffset":0,"title":"シーン 197","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1976_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.197.jpeg","id":"C14A942B-7331-4074-B026-1B18DE006EDF","slideTitle":"第197スライド"},{"audioTrack":"track_voice_soumu","telop":"「えっと僕は…藤原紅夢です…」\n僕がそう言っていると、どこからか声がする。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":5.273469387755102,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 198","animationName":"なし","duration":4,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1986_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.198.jpeg","id":"42A8A625-C61E-49F5-98C1-6C6C9B0D9EBD","slideTitle":"第198スライド"},{"audioTrack":"track_voice_%E7%BE%8E%E9%88%B4","telop":"「ほら、そこの二人、ささっと準備体操済ませて、スタートラインに立ちなさい。もうすぐ始まりますから。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（怒る）.png","seStartTimeOffset":0,"voiceCharacter":"美鈴","voiceDuration":8.614489795918367,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 199","animationName":"なし","duration":5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1993_博麗霊夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.199.jpeg","id":"D837C508-9312-4664-9FAC-EBB65DB8B380","slideTitle":"第199スライド"},{"audioTrack":"track_voice_soumu","telop":"僕とこいしは、彼女にそう言われ、\n準備体操をすると、スタートラインに向かうのだった。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第25話\/困り顔.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":3.340861678004535,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 200","animationName":"なし","duration":4.1000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_2000_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.200.jpeg","id":"58485ED5-C815-427A-A974-F430367F514D","slideTitle":"第200スライド"},{"telop":"","seStartTimeOffset":0,"seVolume":1,"voiceStartTimeOffset":0,"bgmName":"BGM: 東方妖恋談","transitionName":"なし","voice2StartTimeOffset":0,"characterName":"","bgmStartTimeOffset":0,"title":"二人がスタートラインに立つと…","animationName":"なし","duration":2.5,"backgroundName":"単色背景","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.201.jpeg","id":"138BCE1F-FA99-4A50-899A-CB7718B2B5BE","slideTitle":"中扉"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"それから、僕たちがスタートラインに立ってしばらくすると、さっきの放送で話していた人物から、内容が話された。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 202","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.202.jpeg","id":"071D456A-E48D-4DAC-982D-6852DFFCB50B","slideTitle":"第202スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"エンドレスランのルールは一言で言えば、その場に倒れるまで走り続ける、または歩き続ける無限長距離走らしい。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 203","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.203.jpeg","id":"77B16EEC-F73E-40E5-9084-93D34C3C92D9","slideTitle":"第203スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"僕は、病み上がりの体に負担がかからないか心配だった。\nすると、昨日僕が倒れるまで走らせた彼女が来る。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 204","animationName":"なし","duration":4.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.204.jpeg","id":"25EADDE2-50B6-4E76-A4DF-1F829F0A8F5A","slideTitle":"第204スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","telop":"「藤原さんは初めてのエンドレスランで、こいしさんと同等程度の体力ですから、二人のペースを合わせて走りましょうか。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 205","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.205.jpeg","id":"0D68D5C8-99F0-47C1-9AC6-06CBB918CC39","slideTitle":"第205スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","telop":"「お二人さんのペースは、きっと最後尾になりますから、私がお二人さんの後ろを走る形でサポートしましょう。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 206","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.206.jpeg","id":"F5B44F9B-6D74-48D8-8B06-0878A6048DD7","slideTitle":"第206スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（怒る）.png","telop":"「ですが、だからと言って気を抜いたり、だらけたら体を叩きますから、走る力が尽きても、歩いて前に進んでくださいね。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 207","animationName":"なし","duration":5.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ColabGPU_1791199901_67118.png","backgroundName":"ColabGPU_1791199901_67118.png","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.207.jpeg","id":"EBE2A55F-D348-4EA1-88F5-F71EC0B0C1F6","slideTitle":"第207スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","telop":"僕はふと、彼女にそう言われ、こいしの方を見る。\n彼女は苦笑いを浮かべていた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 208","animationName":"なし","duration":3.7,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.208.jpeg","id":"7476ADD7-EDA9-46BF-81A1-D029A75C9319","slideTitle":"第208スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/困った笑み.png","telop":"だが、僕たちを置き去りにするように、開始の合図である笛が鳴り響くと、ゾロゾロと女子の大群が動き、僕たちも動き始めた。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 209","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第22話\/BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","backgroundName":"BE81E0CE-58E8-5C94-87E2-1680044AF26C.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.209.jpeg","id":"E5EB8E4F-168C-4979-9E8B-67DC19A42EF4","slideTitle":"第209スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"そして、僕たちが走り始めて、数分経つと、ぞろぞろと、前方の大群が校門を抜けて、複数の方向に分散していく。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 210","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.210.jpeg","id":"24BBC4F9-4C13-4C95-A954-0056F35560C0","slideTitle":"第210スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"「校門をでたら、右に曲がって、進んでください。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 211","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/ペーストされた画像.tiff","backgroundName":"ペーストされた画像.tiff","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.211.jpeg","id":"981AE877-2029-4FAD-8A09-1903C0EBBBB5","slideTitle":"第211スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","telop":"僕たちは、それから、1kmくらい走ると、住宅街に入り、その中を進んでいた。だが、こいしと僕は走り続けるのに限界が来る…","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 212","animationName":"なし","duration":5.9,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc367698_住宅街２（日中）.jpg","backgroundName":"nc367698_住宅街２（日中）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.212.jpeg","id":"D3253A08-EFF5-4AC8-B29A-982EFE0723A2","slideTitle":"第212スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/toho_ref_20261008_194930_440.png","telop":"僕がふと、隣を見ると、汗ばむ彼女の姿があった。ふと足を見ると、彼女も走り続けるのには限界が来ているようだった。","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 213","animationName":"なし","duration":5.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc367698_住宅街２（日中）.jpg","backgroundName":"nc367698_住宅街２（日中）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.213.jpeg","id":"6643CC3E-7B20-4969-B73E-4AA05CA173C4","slideTitle":"第213スライド"},{"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/目閉じ困る.png","telop":"「走り続けるのが厳しいなら、歩いても構いませんから、止まってないで前にすすまないと、学校に戻るときには夜中ですよ。」","seStartTimeOffset":0,"seVolume":1,"bgmName":"BGM: 東方妖恋談","voiceStartTimeOffset":0,"transitionName":"なし","voice2StartTimeOffset":0,"characterName":"美鈴","bgmStartTimeOffset":0,"title":"シーン 214","animationName":"なし","duration":5.800000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/nc367698_住宅街２（日中）.jpg","backgroundName":"nc367698_住宅街２（日中）.jpg","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dc