\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":3.9886848072562358,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 156","animationName":"なし","duration":5.6000000000000005,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/教室の前の方（日中）.jpg","backgroundName":"教室の前の方（日中）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1563_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.156.jpeg","id":"10140BDA-35E4-4178-A902-17AA6E5D4690","slideTitle":"第156スライド"},{"audioTrack":"track_voice_soumu","telop":"僕は、それを今でも覚えている。いや、正確に言えば、僕の心に打撃を与えたその傷跡が、僕を束縛しているのだ…","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":0.5756462585034013,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 157","animationName":"なし","duration":5.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第15話\/教室の前の方（日中）.jpg","backgroundName":"教室の前の方（日中）.jpg","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_1571_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.157.jpeg","id":"AEAD48F0-7379-4BE3-8A87-AB9F36DB8C53","slideTitle":"第157スライド"},{"audioTrack":"track_voice_soumu","telop":"そう、それは…","characterI