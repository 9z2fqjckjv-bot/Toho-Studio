racted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ驚き.png"},{"id":"B789AE5A-94AA-49AA-8696-314C120985F2","title":"シーン 1949","duration":5.800000000000001,"slideTitle":"第1949スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"すると、彼女はますます赤く染まっていき、僕を押し倒したことを疑うくらいになっていた。だが、彼女は強烈なビンタをする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1949.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ怒り.png"},{"id":"BF22234B-E0D3-440E-A9AB-64B089A29264","title":"シーン 1950","duration":3.5,"slideTitle":"第1950スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"古明地こいし","telop":"「あんた、今まで私を騙してたの！」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1950.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ怒り.png"},{"id":"9B9A3E36-62F5-4F2E-AE78-BF92086C4623","title":"シーン 1951","duration":5.6000000000000005,"slideTitle":"第1951スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"「いえ、僕は戸籍上は男ですが、医者からは生まれつき、女性と男性、双方の臓器や体の部位があるって言われたんです。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1951.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ怒り.png"},{"id":"A4FC9326-7AEE-4EE3-9784-A080E48FB62B","title":"シーン 1952","duration":3.5,"slideTitle":"第1952スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"古明地こいし","telop":"「何、それどういうこと？あんたは男と女、どっちなの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1952.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ不満.png"},{"id":"B2B56D83-EBBB-42E1-A2AF-E0FC3D821384","title":"シーン 1953","duration":5.1000000000000005,"slideTitle":"第1953スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"「性別の判断基準は分かりませんが、僕は小さい頃から男として今まで、生きてきましたよ、記憶の限りでは。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1953.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ不満.png"},{"id":"155DF96D-DC63-4872-9F73-C99423AA53CB","title":"シーン 1954","duration":3.5,"slideTitle":"第1954スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"古明地こいし","telop":"「ふぅん…、まぁいいわ…、\nあなたを奪うことには変わりはないのだから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1954.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り小口開け.png"},{"id":"DB8C8350-BD54-4718-AA8C-8417448C6042","title":"シーン 1955","duration":4.800000000000001,"slideTitle":"第1955スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"古明地こいし","telop":"「それでどうしますか、このままいきますか？\n僕は、特殊な体つきなので、子どもはできないですけど。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1955.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/頬照り小口開け.png"},{"id":"FD1354B2-F242-4BE1-AFEB-81B510D77E43","title":"シーン 1956","duration":3.5,"slideTitle":"第1956スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"すると彼女は再び赤らみを帯びて、驚く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1956.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ驚き.png"},{"id":"BD865E61-6A29-4C37-8F6E-3CE839BC0634","title":"シーン 1957","duration":5.2,"slideTitle":"第1957スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"古明地こいし","telop":"「そんなことどうだっていいわ、あなたが私をその気にさせたんだから。何かあっても、絶対に責任とってよね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1957.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ不満.png"},{"id":"011DA625-FA6B-4D15-AA32-F0CE7529D52F","title":"シーン 1958","duration":3.5,"slideTitle":"第1958スライド","backgroundName":"01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterName":"操夢","telop":"彼女はそういうと、無理やり僕の服を脱がすのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1958.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/01B9D6C4-260F-54BA-9FEC-5D178E103F22.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り赤らみ不満.png"},{"id":"3B4792DB-4385-425F-8340-2FECBBC7EC32","title":"シーン 1959","duration":5.2,"slideTitle":"第1959スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「んっ…」僕は、ふと目が覚めると、窓から光が差し込んでいた。\n僕は、ふと動こうとすると、違和感に気がつく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1959.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"40143555-A8C5-439F-BCE8-B8B62E7C8FC7","title":"シーン 1960","duration":5.4,"slideTitle":"第1960スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"そして、ふと隣を見ると、そこにはすやすや眠るこいしの姿があった。だが、僕はすぐに違和感の正体を知る。「裸…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1960.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ寝顔.png"},{"id":"7AE11730-80E7-4F35-A49C-627D89093DB1","title":"シーン 1961","duration":3.5,"slideTitle":"第1961スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"古明地こいし","telop":"「ん…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1961.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ第三の目なし寝起き顔.png"},{"id":"95B965CA-4151-415F-BE5B-B132E1F68D66","title":"シーン 1962","duration":3.5,"slideTitle":"第1962スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"古明地こいし","telop":"「あなた昨晩のこと、どこまで覚えているの？」\n制作ソフト及び協力\nGemini\nTohoStuido","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1962.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り第三の目なし怒り.png"},{"id":"B89A2127-3BBA-4DC5-8A07-D6FBF60AFED3","title":"シーン 1963","duration":5.7,"slideTitle":"第1963スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"彼女は、目が覚めると、縛るように抱きつき、そう聞いてくる。\n「昨日、こいしさんに襲われるまで、全部覚えてますけど…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1963.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り第三の目なし怒り.png"},{"id":"DC9F28C7-4648-4882-9019-65BED60CB4B3","title":"シーン 1964","duration":3.5,"slideTitle":"第1964スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"古明地こいし","telop":"「まぁ、いいわ。私がいいと思うまで、このままにしなさい…」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1964.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り第三の目なし怒り.png"},{"id":"15ABE55E-67D6-44EC-A8BC-BBD5FD4D6B37","title":"シーン 1965","duration":5.800000000000001,"slideTitle":"第1965スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕はそれから、フランが部屋の扉を開けるまでの間、ずっと彼女に抱きしめられていた。そして、それを見たフランは絶叫した。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1965.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/パジャマ頬照り第三の目なし怒り.png"},{"id":"6EA6618A-165D-4CBC-818E-2DA9CA4CD627","title":"シーン 1966","duration":4.5,"slideTitle":"第1966スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"それから、僕は服を着て食堂に来ると、\nそこには頬照った状態で、怒りの表情を見せる3人がいた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1966.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"631F28F5-B94B-4E03-9A79-8ED89FFDC58A","title":"シーン 1967","duration":3.5,"slideTitle":"第1967スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「紅夢は一体、どういうつもりなの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1967.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"0BB3E22C-C9ED-4746-A068-0C23DCA9DFE3","title":"シーン 1968","duration":5.7,"slideTitle":"第1968スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「こいしさんが突然恋人の有無を聞いてきて、あの部屋がフランとの二人部屋だって言うと、ムキになって襲ってきたので…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1968.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"A9EF7630-8785-4714-83FA-7DD7CD146529","title":"シーン 1969","duration":3.5,"slideTitle":"第1969スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「私が聞きたいのは紅夢の意見だよ。事実じゃない。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1969.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"54D06721-438D-4531-B2BF-B49A677D53D1","title":"シーン 1970","duration":5.1000000000000005,"slideTitle":"第1970スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「意見って…、僕はさっきそれを含めて話したんですが、\nもっとわかりやすく言うなら、僕はフランさんが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1970.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"ED78C6F2-A2B3-469F-B998-9AA7C839C502","title":"シーン 1971","duration":3.5,"slideTitle":"第1971スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕がそこまでいうと、こいしが驚いた表情をする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1971.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"72B88394-8E40-43D3-9C44-288A746D880A","title":"シーン 1972","duration":3.5,"slideTitle":"第1972スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"古明地こいし","telop":"「それじゃあ、私は好きじゃないって言うの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1972.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"20600D9C-1F68-4026-B3B1-A40196122730","title":"シーン 1973","duration":5.300000000000001,"slideTitle":"第1973スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「『好き』と言う言葉の解釈が違うかもしれませんが、\n僕はこいしさんは恋人というよりかは、妹だと思いますよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1973.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"2D4A466E-B054-4CE4-8C73-C5E18A74CAF2","title":"シーン 1974","duration":3.5,"slideTitle":"第1974スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕の発言に、こいしが再び驚く。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1974.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"C2162142-EEDE-4636-85D3-4DCE95251E3D","title":"シーン 1975","duration":3.5,"slideTitle":"第1975スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"だが、彼女は表情を変えて、\n僕の方にくると、強烈な平手打ちをする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1975.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"B8AC4DDC-623B-44FC-84C3-E087FF1BC8EC","title":"シーン 1976","duration":3.5,"slideTitle":"第1976スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"古明地こいし","telop":"「もう、あんたのことなんかは知らないんだから！」","animationName":"なし","transitionName":"なし","voiceCharacter":"古明地こいし","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1976.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"14E671BE-70F0-40C0-8707-414D80A2D311","title":"シーン 1977","duration":5.2,"slideTitle":"第1977スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"彼女そう激昂すると、食堂を走って出て行った。僕は、\n彼女の後を追いかけようとすると、フランが僕の手を掴む。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1977.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"312DF6B4-ED42-4412-AE7F-586FABEA8263","title":"シーン 1978","duration":3.5,"slideTitle":"第1978スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「あの…あのまま外に出たら、\nまた襲撃されそうですが、いいんですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1978.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"5BA2D11F-B45B-42DE-810D-F7C2D3975BBB","title":"シーン 1979","duration":3.5,"slideTitle":"第1979スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「食堂を出る前に、一言、私に言ったらどうなの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1979.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"FE324FAE-AE61-47C3-BF77-AAEA787599AF","title":"シーン 1980","duration":5.7,"slideTitle":"第1980スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「さっき言いかけた言葉に続きをつけるなら、フランさんが僕の初恋ですが、正直に言えば、それは明確な答えじゃないと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1980.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"5B93DE63-B4E1-4036-A7AE-3299E29CDB42","title":"シーン 1981","duration":3.5,"slideTitle":"第1981スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"僕がそう言うと、二人は驚きの声をあげる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1981.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/フラン（驚く）.png"},{"id":"8CB5310D-A660-449F-8044-1EC87678DEDE","title":"シーン 1982","duration":3.5,"slideTitle":"第1982スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"すると、フランは僕の頬をビンタし、レミリアが話し出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1982.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（不満）.png"},{"id":"FA8D12F1-C208-4C6D-9EFA-0608A4F92DEF","title":"シーン 1983","duration":5.800000000000001,"slideTitle":"第1983スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「あなた、言われないと相手の気持ちが分からないの？少しくらいは指摘されずとも、相手の気持ちを理解できたらどうなの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1983.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"595625EB-C67B-444E-A93D-56258025DDBA","title":"シーン 1984","duration":5.7,"slideTitle":"第1984スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「えっ？ でも、これまでの人生では、勉強しているだけで、相手の気持ちなんか考えなくても問題などなかったんですが…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1984.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（不満）.png"},{"id":"60433F5A-9CED-45D7-AB78-89E170F7F7FC","title":"シーン 1985","duration":4.800000000000001,"slideTitle":"第1985スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「まぁ、さっきの発言は聞かなかったことにするから、\nあなたはもっと…、こう、なんて言うのかしら…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1985.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"921C63BA-D8D7-4782-86FD-31474B77BE9D","title":"シーン 1986","duration":5.800000000000001,"slideTitle":"第1986スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「私から言うのなんだけど、紅夢は乙女心っていうものを知るべきだと思うよ。ただ、本読んだり勉強だけするんじゃなくて。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1986.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"8816287D-FEE5-4385-9BF6-02F607F0A76F","title":"シーン 1987","duration":5.300000000000001,"slideTitle":"第1987スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"操夢","telop":"「乙女心ですか…」僕はしばらく考えるが、ふと思い出す。「それより、先にこいしを探して、見つけ出さないと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1987.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"E65F3C0E-7E84-42C0-BD17-C6AEC3C4DAC1","title":"シーン 1988","duration":3.5,"slideTitle":"第1988スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"私は、ふと気がつくと、彼は食堂を離れて行った。","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1988.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（驚く）.png"},{"id":"39840ACD-26F5-4DBC-B361-D081FA3677B6","title":"シーン 1989","duration":3.5,"slideTitle":"第1989スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「フラン、これからするべきことは分かってるわね。」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1989.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/レミリア（不満）.png"},{"id":"B15397FF-8A24-4C4B-8BA2-4A80722DE202","title":"シーン 1990","duration":3.5,"slideTitle":"第1990スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"フランドール・スカーレット","telop":"「分かってるよ、お姉様。彼に分からせないと…」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1990.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第11話/フラン（怒る）.png"},{"id":"F01F6089-74A5-4EAB-9B74-5BC13018B4C5","title":"シーン 1991","duration":3.5,"slideTitle":"第1991スライド","backgroundName":"nc196979_食堂(昼).png","characterName":"レミリア・スカーレット","telop":"「とりあえず、彼への教育を考えないとね…」","animationName":"なし","transitionName":"なし","voiceCharacter":"レミリア・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1991.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc196979_食堂(昼).png","ch