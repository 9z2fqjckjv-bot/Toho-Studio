":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1812.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（微笑）.png"},{"id":"38ECC1F7-1D8D-49E0-B374-7FE5E82B1631","title":"シーン 1813","duration":3.5,"slideTitle":"第1813スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"博麗霊夢","telop":"「一体、その情報どこから仕入れたのよ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1813.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（微笑）.png"},{"id":"38879419-DDC9-4D25-9DAE-AA0D0DB9ECB3","title":"シーン 1814","duration":5.6000000000000005,"slideTitle":"第1814スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"先代の巫女","telop":"「霖之助さ。あいつが最近の神社の様子を突然聞いてきて、いい話があるなんて言いながら、封筒と情報を渡してきたぞ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"先代の巫女","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1814.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（微笑）.png"},{"id":"42BA8705-C168-45F0-8819-6ABEB92B0CE7","title":"シーン 1815","duration":3.5,"slideTitle":"第1815スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"博麗霊夢","telop":"「まさか、その封筒は賄賂じゃないでしょうね？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1815.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（微笑）.png"},{"id":"97E6B5DB-EC51-41DF-872D-EEC3A8CEEEE8","title":"シーン 1816","duration":3.5,"slideTitle":"第1816スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"先代の巫女","telop":"「いや特に、ただ情報と引き換えに…」","animationName":"なし","transitionName":"なし","voiceCharacter":"先代の巫女","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1816.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（微笑）.png"},{"id":"B693653F-8500-422A-8601-D6821E467B21","title":"シーン 1817","duration":5.1000000000000005,"slideTitle":"第1817スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"博麗霊夢","telop":"「まさか、その封筒は賄賂じゃないでしょうね？」私のその指摘に、彼女は困った表情をする。「はぁ、全く…」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1817.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"4A56B7A8-929C-422F-A1DB-6739FF299117","title":"シーン 1818","duration":4.7,"slideTitle":"第1818スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"先代の巫女","telop":"「これはすまない、霊夢。情報と引き換えに、\n新しい神社の後継を手配してくれることになったんだ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"先代の巫女","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1818.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"7A50FD82-D4D2-44FD-8E76-1271A6A5FB75","title":"シーン 1819","duration":3.5,"slideTitle":"第1819スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"博麗霊夢","telop":"「はっ？」私は、突拍子のない母の衝撃発言に、そう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1819.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"67E24045-C39C-4C22-B52B-5E62B8E5D88A","title":"シーン 1820","duration":3.5,"slideTitle":"第1820スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"先代の巫女","telop":"「だから、お前のとこの息子は、不要になったんだ…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"先代の巫女","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1820.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"460C2478-169A-4ACA-8902-1BF693646B84","title":"シーン 1821","duration":3.5,"slideTitle":"第1821スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"博麗霊夢","telop":"「えっ？どういうこと、私が必死に生んだ彼がいらないの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1821.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"280098B0-6BE2-4667-940E-E383E907A796","title":"シーン 1822","duration":3.5,"slideTitle":"第1822スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"先代の巫女","telop":"「そうだが…、それが何か？」","animationName":"なし","transitionName":"なし","voiceCharacter":"先代の巫女","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1822.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"5CCC47DA-A7B4-4B63-A3DC-D1B1E9F30F79","title":"シーン 1823","duration":3.5,"slideTitle":"第1823スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"博麗霊夢","telop":"「覚悟は…出来ているんでしょうね…？」","animationName":"なし","transitionName":"なし","voiceCharacter":"博麗霊夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1823.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/靈夢（困る）.png"},{"id":"8D38200A-1133-4A96-9D50-0B15A07ED7F5","title":"シーン 1824","duration":5.800000000000001,"slideTitle":"第1824スライド","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterName":"先代の巫女","telop":"「えっと…それは…」私は、目の前に見える娘の怒気に一歩一歩と後ずさる。だが、娘から強烈な拳を喰らってしまうのだった。","animationName":"なし","transitionName":"なし","voiceCharacter":"先代の巫女","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1824.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc73538_【背景素材】博麗神社.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/霊異変やっちまった.png"},{"id":"62BEE25B-F7D7-42F2-B5AA-A10AFC667FDE","title":"シーン 1825","duration":5.5,"slideTitle":"第1825スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"僕は、あれから魔法使い入門編の本を、読んでいる際にふと思いつき、僕とフランの部屋からノートとペンを持ってきた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1825.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"33144619-00CB-4CD9-913E-A5AF9648DAE8","title":"シーン 1826","duration":5.4,"slideTitle":"第1826スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そして、本の内容をもとに、自分なりにノートを書き込んでいく。そして、ふと本を読んでいて、あることに気がつく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1826.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"A2A1197D-33BD-49D3-B8EE-841B918A03D1","title":"シーン 1827","duration":5.300000000000001,"slideTitle":"第1827スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"それは、ちょくちょく語尾に「だぜ。」という特徴的な口癖が書かれていることだった。そこで、僕はふと思い出す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1827.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"6B1C3732-8736-4E62-846C-976F024497EE","title":"シーン 1828","duration":5.1000000000000005,"slideTitle":"第1828スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そして巻末までページを捲ると、なぜか、出典や著者、出版社などの情報が載ったページが誰かに破られていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1828.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"59F753FA-2521-4383-834F-FC8ADF155302","title":"シーン 1829","duration":4.800000000000001,"slideTitle":"第1829スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そして、僕は本の表紙にある著者名を見る。\nよく見ると、それは元の名前の上に、ラベルが貼ってあった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1829.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"BEF53900-131D-46E0-8984-7B6B29D33219","title":"シーン 1830","duration":5.4,"slideTitle":"第1830スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"僕は、そのラベルを剥がそうと、爪を立てるが、がっしりと拍子にラベルがしがみついていて、剥がすことができない。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1830.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"B849EA77-A4D3-4990-A610-CF1544D59174","title":"シーン 1831","duration":5.6000000000000005,"slideTitle":"第1831スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そして、僕は推測を立てる。おそらくこの本は、母の友人である魔理沙が書いたものだが、その証拠となるものはなかった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1831.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"4D621E0E-C912-48EE-A959-FD6F1BE891D0","title":"シーン 1832","duration":3.8000000000000003,"slideTitle":"第1832スライド","backgroundName":"nc77066_【背景素材】紅魔館大図書館.jpg","characterName":"操夢","telop":"そして、僕は直接本人に聞くのがいいと考え、\nその本を片手に部屋に戻っていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1832.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/nc77066_【背景素材】紅魔館大図書館.jpg"},{"id":"F0138B16-7F55-4739-AC5B-697F3D6F5701","title":"シーン 1833","duration":4.9,"slideTitle":"第1833スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕が部屋に戻ってきて、本をバックにしまって、\n出かけようとすると、部屋の扉が開き、誰かが入ってくる。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1833.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd"},{"id":"7E947EDE-A10C-41F9-9183-F1B48CD30EC6","title":"シーン 1834","duration":3.5,"slideTitle":"第1834スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「ねぇ、これからどこにいくの、紅夢？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1834.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"B4FC90F3-D81D-4068-8504-66F37D1A4EE8","title":"シーン 1835","duration":3.5,"slideTitle":"第1835スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「魔理沙さんの家ですけど…、どうかしました？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1835.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"62F465D9-6F6E-4FF5-BF19-FF0839A4A607","title":"シーン 1836","duration":3.5,"slideTitle":"第1836スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「彼女の家で、何をするつもりだったの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1836.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"C86576D8-A108-4C0C-8E6D-09F68FE83A99","title":"シーン 1837","duration":5.5,"slideTitle":"第1837スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕は彼女の質問を聞くと、バックを下ろし、中に入れた本を見せる。「この本について、聞きたいことがあるんですよ。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1837.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/疑問顔.png"},{"id":"5B1368B0-7830-466B-9A12-91BEADB01AFF","title":"シーン 1838","duration":3.5,"slideTitle":"第1838スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「この本って…、図書館のやつだよね？\nそれで、何を聞きたいの？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1838.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"6A06E534-E98D-4C58-A0BE-D05DBBFC0828","title":"シーン 1839","duration":5.7,"slideTitle":"第1839スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「この本の巻末にあるはずの出典が破かれていてないことと、本の表紙にある著者名にかぶるようにラベルがあったので…。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1839.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"ECD38690-7A56-42C6-94C7-F3525D487EA1","title":"シーン 1840","duration":5.300000000000001,"slideTitle":"第1840スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕が、そういうと、彼女は固まったような表情を見せる。\n「どうしたんですか、フランさん。そんな表情をして。」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1840.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/フランごくり.png"},{"id":"756B3086-CEB4-44B6-8639-9F76782E9FD4","title":"シーン 1841","duration":3.5,"slideTitle":"第1841スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「紅夢、ちょっとその本を渡しに、渡してくれない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1841.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"397DAB6E-B277-45BB-89D9-7C6454E929EE","title":"シーン 1842","duration":3.5,"slideTitle":"第1842スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「えっ、なぜですか？」僕は、彼女の発言にそう返す。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1842.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"21E0ACA7-ACD6-4A8D-BB51-D6B07FDA6C9E","title":"シーン 1843","duration":3.5,"slideTitle":"第1843スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「図書館の本を外に持ってくなら、\nお姉様に確認しなきゃいけないから。」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1843.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"897669D2-0E27-47F4-AD0C-60F6F4E913BE","title":"シーン 1844","duration":4.0,"slideTitle":"第1844スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「そうですか…、分かりました。」\n僕は、そういうと、その本を彼女に手渡そうとする。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1844.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"872E0852-AF7D-4054-8E7E-6340C403D456","title":"シーン 1845","duration":3.5,"slideTitle":"第1845スライド","backgroundName":"nc238754_一人部屋（日中）.pxd","characterName":"霧雨魔理沙","telop":"「渡すな。」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1845.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc238754_一人部屋（日中）.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/驚く顔影あり.pxd"},{"id":"0F76B049-82DD-4FED-96F4-0577244B5B85","title":"シーン 1846","duration":5.1000000000000005,"slideTitle":"第1846スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"僕は、彼女に本を手渡そうとすると、呪いにかかったかのように、目の前に魔理沙の姿が現れ、警告をしていた。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1846.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"45FA7750-5CA1-4D17-BAC6-6D98EED860DA","title":"シーン 1847","duration":3.5,"slideTitle":"第1847スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「ねぇ、聞いてるの？その本、渡してくれない？」","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1847.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"BBF1DD94-8929-4DBA-9F8D-F76DA5496989","title":"シーン 1848","duration":3.5,"slideTitle":"第1848スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"操夢","telop":"「いや、今は渡せないです。帰ってきてからでもいいですか？」","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1848.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/2026-10-25_16-14.pxd","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常　第12話/困り顔小口開け.png"},{"id":"6D750A35-01A6-496B-B6A5-FFFDE445DD67","title":"シーン 1849","duration":3.5,"slideTitle":"第1849スライド","backgroundName":"2026-10-25_16-14.pxd","characterName":"フランドール・スカーレット","telop":"「えっ？」私が、そう呟いていると、\nいつの間にか彼は部屋を出ていった。","animationName":"なし","transitionName":"なし","voiceCharacter":"フランドール・スカーレット","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1849.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoS