b\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/早苗（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"東風谷早苗","voiceDuration":4.273673469387755,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"東風谷早苗","bgmStartTimeOffset":0,"title":"シーン 88","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_088_ナレーション.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.088.jpeg","id":"CBFA1B4E-55D4-4174-B646-D6D2652EB287","slideTitle":"第88スライド"},{"audioTrack":"track_voice_soumu","telop":"彼女がそういうと、クラスメイトの女子たちは「お疲れ様です。」と一斉に返し、僕が急いで立ち、一緒に礼をする。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/早苗（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.341950113378685,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 89","animationName":"なし","duration":5.300000000000001,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_089_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.089.jpeg","id":"698601EB-8351-483E-950E-0F542F09C84A","slideTitle":"第89スライド"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「何か、伝えたいことがある生徒はいますか。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/早苗（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"東風谷早苗","voiceDuration":8.545850340136054,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"東風谷早苗","bgmStartTimeOffset":0,"title":"シーン 90","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_090_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.090.jpeg","id":"0A4E5116-B36B-47A8-A509-43784E332F41","slideTitle":"第90スライド"},{"audioTrack":"track_voice_soumu","telop":"彼女がそういうと、シーンと教室が静まり返る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/早苗（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.458253968253969,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 91","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_091_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.091.jpeg","id":"321F2BF6-4CA3-4292-A895-BE8C6DC6F630","slideTitle":"第91スライド"},{"audioTrack":"track_voice_%E6%9D%B1%E9%A2%A8%E8%B0%B7%E6%97%A9%E8%8B%97","telop":"「それでは、終礼はこれで終了です。お疲れ様でした。」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/早苗（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"東風谷早苗","voiceDuration":3.535578231292517,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"東風谷早苗","bgmStartTimeOffset":0,"title":"シーン 92","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_092_射命丸文.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.092.jpeg","id":"CE93E595-F780-426D-9CBE-D99CCFBA2AA1","slideTitle":"第92スライド"},{"audioTrack":"track_voice_soumu","telop":"僕は、周りの女子たちと共に立ち上がると、「お疲れ様でした。」と一斉に返し、お礼を済ませた。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/早苗（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":2.4017233560090703,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 93","animationName":"なし","duration":4.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_093_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.093.jpeg","id":"0131F3A0-26DD-402C-BB3C-933E5839CECC","slideTitle":"第93スライド"},{"audioTrack":"track_voice_soumu","telop":"彼女が教室からいなくなると、空気が少し和む。\nだが、そんなところにある女性が教室に入る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第11話\/フラン（困る）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.910430839002268,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 94","animationName":"なし","duration":4.2,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_094_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（総集編）_84dcf932f7\/交換夫婦（総集編）_84dcf932f7.094.jpeg","id":"01C1386A-85E3-42A3-B208-3A787AAC393D","slideTitle":"第94スライド"},{"audioTrack":"track_voice_soumu","telop":"すると、その女性は僕の席に来て、あることを言う。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第4話\/美鈴（微笑）.png","seStartTimeOffset":0,"voiceCharacter":"操夢","voiceDuration":8.646303854875283,"transitionName":"なし","bgmName":"BGM: 東方妖恋談","seVolume":1,"voiceStartTimeOffset":0,"voice2StartTimeOffset":0,"characterName":"操夢","bgmStartTimeOffset":0,"title":"シーン 95","animationName":"なし","duration":3.5,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/元女子校の日常　第28話\/2026-10-04_16-42.png","backgroundName":"2026-10-04_16-42.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_095_操夢.wav","showTelopOverlay":false,"bgmVolume":0.65,"