meOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1852.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc235078_家（日中）.jpg"},{"id":"D98AF2DA-D769-4B58-A31C-2EEDA203BC16","title":"シーン 1853","duration":4.2,"slideTitle":"第1853スライド","backgroundName":"nc235078_家（日中）.jpg","characterName":"操夢","telop":"この家は、僕が以前まで住んでいた家のため、\nインターホンを鳴らさずに、中に入っていく。","animationName":"なし","transitionName":"なし","voiceCharacter":"操夢","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1853.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc235078_家（日中）.jpg"},{"id":"AAAAE490-44EA-4BF2-9682-E5E985F1D255","title":"シーン 1854","duration":3.5,"slideTitle":"第1854スライド","backgroundName":"nc244641_家の玄関ホール（日中）.jpg","characterName":"霧雨魔理沙","telop":"「おや、紅夢くん、何しにやってきたんだ？」","animationName":"なし","transitionName":"なし","voiceCharacter":"霧雨魔理沙","voice2StartTimeOffset":0.0,"bgmStartTimeOffset":0.0,"bgmVolume":0.7,"seStartTimeOffset":0.0,"seVolume":1.0,"voiceStartTimeOffset":0.0,"showTelopOverlay":false,"slideImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_slides/元女子校の日常総集編_6ce7fe1ac7/元女子校の日常総集編_6ce7fe1ac7.1854.jpeg","backgroundImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/nc244641_家の玄関ホール（日中）.jpg","characterImagePath":"/Volumes/ZSSD/GitHub/repository/TohoStudio/.cache/keynote_extracted/元女子校の日常総集編/魔理沙箒・帽子なし微笑.png"},{"id":"EBFA4443-9E33-4332-A3CB-2E3DDC9813D8","title":"シーン 1855","duratio