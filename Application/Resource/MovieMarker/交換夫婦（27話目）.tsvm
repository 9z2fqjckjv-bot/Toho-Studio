[{"telop":"私たちがこの部屋に戻ってくると、霊夢たちがなぜか、怒っていた。「私たちがいない間に、何があったんだ？」\n今回の迷シーン","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.884489795918368,"characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.001.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_霧雨魔理沙.wav","title":"シーン 1","slideTitle":"第1スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","voiceCharacter":"霧雨魔理沙","id":"BC0E31E9-CC82-484A-81EC-D5D5D8044BC1","transitionName":"なし"},{"telop":"「彼ったら、私たちが寝ている隙に、ささっと向こうに行ったのよ。私たちに、あんな体験させておいて…」","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":8.511995464852607,"characterName":"博麗霊夢","audioTrack":"track_voice_reimu","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.002.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","duration":4.9,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav","title":"シーン 2","slideTitle":"第2スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","voiceCharacter":"博麗霊夢","id":"35D9BCE8-6579-412A-84B4-2B16959E08CF","transitionName":"なし"},{"telop":"「そうですよ。私たちに何も言わずに、東京に行ってしまった彼には、一言でもいいから、私たちを起こして欲しかったです…」","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":7.971587301587301,"characterName":"射命丸文","audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.003.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","duration":5.800000000000001,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_射命丸文.wav","title":"シーン 3","slideTitle":"第3スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/射命丸文\/射命丸文\/赤面\/文（怒る）.png","voiceCharacter":"射命丸文","id":"66028A4E-9C9D-4232-841F-480419649F63","transitionName":"なし"},{"telop":"私は、そんなことを言う二人に、ふっと笑いが漏れてしまう。","animationName":"なし","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceDuration":4.464489795918367,"characterName":"霧雨魔理沙","audioTrack":"track_voice_marisa","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.004.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","duration":3.5,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","title":"シーン 4","slideTitle":"第4スライド","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","voiceCharacter":"霧雨魔理沙","id":"DAD2CA9D-6EC3-403C-9820-3185A09601E1","transitionName":"なし"},{"characterName":"博麗霊夢","title":"シーン 5","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","voiceDuration":4.111995464852607,"audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.005.jpeg","animationName":"なし","slideTitle":"第5スライド","id":"05699090-FA40-4348-BF51-EDB9F89F638F","transitionName":"なし","telop":"「なんで、あんたは笑ってるのよ、それに、みんなも…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.5,"voiceCharacter":"博麗霊夢"},{"characterName":"霧雨魔理沙","title":"シーン 6","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_006_霧雨魔理沙.wav","voiceDuration":7.2182312925170065,"audioTrack":"track_voice_marisa","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.006.jpeg","animationName":"なし","slideTitle":"第6スライド","id":"A42F1206-A3CA-4845-A53B-DD57A8C54B93","transitionName":"なし","telop":"「何だか、二人が駄々こねる子どもにそっくりだなって、\n感じたらふと、笑いが込み上げてくるぜ…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":4.6000000000000005,"voiceCharacter":"霧雨魔理沙"},{"characterName":"霧雨魔理沙","title":"シーン 7","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（驚く）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_007_霧雨魔理沙.wav","voiceDuration":6.5619954648526075,"audioTrack":"track_voice_marisa","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.007.jpeg","animationName":"なし","slideTitle":"第7スライド","id":"7A47859E-ED01-4014-B7FC-EB96EF9D6C6A","transitionName":"なし","telop":"すると、二人は「あっ」と声を出して驚く。\n「どうしたんだ、急に声出して驚いて…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.9000000000000004,"voiceCharacter":"霧雨魔理沙"},{"characterName":"博麗霊夢","title":"シーン 8","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/射命丸文\/射命丸文\/赤面\/文（困る）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_008_博麗霊夢.wav","voiceDuration":3.316984126984127,"audioTrack":"track_voice_reimu","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.008.jpeg","animationName":"なし","slideTitle":"第8スライド","id":"63AF6DDA-85F8-48F6-87D6-D7AFD440405C","transitionName":"なし","telop":"「なんだか、恥ずかしいわ…、彼がいないと…」","backgroundName":"nc73538_【背景素材】博麗神社.jpg","duration":3.5,"voiceCharacter":"博麗霊夢"},{"characterName":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.009.jpeg","slideTitle":"タイトル","telop":"交換夫婦","backgroundName":"単色背景","animationName":"なし","voiceCharacter":"","id":"5D2BFA1A-C7E8-41D2-964B-0721AAB84D0B","duration":3,"transitionName":"なし","title":"東方Project二次創作 powerd by zuyasi　※前回の内容とは一部異なります。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","duration":4.3,"id":"6E1C709D-F5D1-49CF-B5A4-B80122CB59EB","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_010_操夢.wav","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第10スライド","title":"シーン 10","voiceDuration":6.016938775510204,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.010.jpeg","telop":"僕は、霊夢が寝静まった後、操作盤を触り続ける。"},{"backgroundName":"nc73538_【背景素材】博麗神社.jpg","audioTrack":"track_voice_soumu","animationName":"なし","duration":3.5,"id":"0304F2B8-9698-452B-BB20-88FAEC6F1F20","characterName":"操夢","transitionName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_011_操夢.wav","voiceCharacter":"操夢","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideTitle":"第11スライド","title":"シーン 11","voiceDuration":4.899546485260771,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.011.jpeg","telop":"今、僕はこの国の、いや、\nこの世の中の仕組みを一から書き換えている。"},{"animationName":"なし","id":"ACC13FBB-A835-46BD-8EA6-311DA7D6E1CB","characterName":"操夢","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.012.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","telop":"僕は、文と霊夢の二人の寝顔を時折眺めながら、ふと考える。\nある種の覚悟を、僕は決めなければならない…。","duration":5.1000000000000005,"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_012_操夢.wav","title":"シーン 12","audioTrack":"track_voice_soumu","voiceDuration":7.808253968253968,"slideTitle":"第12スライド","voiceCharacter":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg"},{"animationName":"なし","id":"A128A8B3-A652-4DFB-9F33-575DE96A2F48","characterName":"操夢","transitionName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.013.jpeg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","telop":"すると、誰かが部屋に入ってくる。","duration":3.5,"voiceAud