i\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_016_赤面.wav","voiceDuration":3.0033333333333334,"audioTrack":"track_voice_%E8%B5%A4%E9%9D%A2","slideTitle":"第16スライド","telop":"「そう、それで、これからあなたはどうするの？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png","id":"50439696-2C03-432C-BC47-6837A659EC67","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"赤面","duration":3.5,"animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.016.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","characterName":"赤面","title":"シーン 16"},{"voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_017_操夢.wav","voiceDuration":4.162607709750567,"audioTrack":"track_voice_soumu","slideTitle":"第17スライド","telop":"「そうですね…」僕がそう呟いていると、円球から音が鳴る。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png","id":"293987A1-32F8-49DB-BA32-EAE78D6C12A7","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","duration":3.5,"animationName":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.017.jpeg","backgroundName":"nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","characterName":"操夢","title":"シーン 17"},{"audioTrack":"track_voice__DD8F","voiceCharacter":"ナレーション","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_018_ナレーション.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":4.347369614512472,"characterName":"ナレーション","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第18スライド","animationName":"なし","telop":"「東京の某所にいる人物からの着信です。応答しますか？」","id":"C4B9359E-5BDF-454B-B6EF-0B5AB4F08F0B","duration":3.5,"title":"シーン 18","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.018.jpeg"},{"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_019_操夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":1.5,"characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第19スライド","animationName":"なし","telop":"「応答してください。」","id":"4A10978F-D08C-4C42-9C5B-AC991C548763","duration":3.5,"title":"シーン 19","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.019.jpeg"},{"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_020_操夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":7.108253968253968,"characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第20スライド","animationName":"なし","telop":"僕がその着信に出ると、ある人物の声が流れる。\nするとその途端、彼女が驚きの表情を見せる。","id":"9D183078-17D8-41C7-9783-75725AABD66C","duration":4.3,"title":"シーン 20","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.020.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（驚く）.png"},{"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_021_操夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":6.3691156462585035,"characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第21スライド","animationName":"なし","telop":"僕は、その人物と、数分程度の電話を済ますと、\nそのままここを、離れる準備を始める。","id":"284E0572-BF8A-4B13-B2CC-DE61BCC1CBEE","duration":4,"title":"シーン 21","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.021.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（驚く）.png"},{"audioTrack":"track_voice_%E8%B5%A4%E9%9D%A2","voiceCharacter":"赤面","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_022_赤面.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":2.301904761904762,"characterName":"赤面","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第22スライド","animationName":"なし","telop":"「これから、どこへ向かうのですか？」","id":"F86D7B68-A3DD-44C9-9CE9-91E7FB5552DB","duration":3.5,"title":"シーン 22","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.022.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png"},{"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_023_操夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":8.0756462585034,"characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第23スライド","animationName":"なし","telop":"「敵地…とだけ言っておきましょうか、霊夢さんや、魔理沙さんたちには、元の生活に戻れたらいい…とだけ言ってください。」","id":"FAE6340D-13C1-4484-A47F-7B2246CF3F14","duration":5.800000000000001,"title":"シーン 23","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.023.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png"},{"audioTrack":"track_voice_%E8%B5%A4%E9%9D%A2","voiceCharacter":"赤面","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_024_赤面.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":1.7512925170068028,"characterName":"赤面","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第24スライド","animationName":"なし","telop":"「分かりました…それと…」","id":"CA39D01F-C36F-4302-80F6-6408F9DA0F45","duration":3.5,"title":"シーン 24","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.024.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png"},{"audioTrack":"track_voice_%E8%B5%A4%E9%9D%A2","voiceCharacter":"赤面","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_025_赤面.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":2.7341496598639456,"characterName":"赤面","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第25スライド","animationName":"なし","telop":"「…出ていく前に一つお願いしてもいいですか？」","id":"01A91CD9-8EE4-4DC3-9826-DC359098F1AC","duration":3.5,"title":"シーン 25","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.025.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png"},{"audioTrack":"track_voice_soumu","voiceCharacter":"操夢","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_026_操夢.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":2.069115646258503,"characterName":"操夢","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第26スライド","animationName":"なし","telop":"「それで、どんなお願いですか？」","id":"0EF5719E-25A1-4B80-8612-A1C06050A8D4","duration":3.5,"title":"シーン 26","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.026.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（困り）.png"},{"audioTrack":"track_voice_%E8%B5%A4%E9%9D%A2","voiceCharacter":"赤面","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_027_赤面.wav","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","transitionName":"なし","voiceDuration":6.30047619047619,"characterName":"赤面","backgroundName":"nc73538_【背景素材】博麗神社.jpg","slideTitle":"第27スライド","animationName":"なし","telop":"「私を島送りにしたことを絶対後悔しますよ…とだけ、\nあの青河童に言っておいてください。」","id":"D2719106-67D0-4D1A-A0EC-E424CC4B7B80","duration":4.4,"title":"シーン 27","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.027.jpeg","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（怒り）.png"},{"slideTitle":"第28スライド","duration":4.7,"audioTrack":"track_voice_soumu","characterName":"操夢","telop":"「分かりました、それじゃ、霊夢さんたちのことは任せます。」\n僕はそういうと、部屋から出ていった。","backgroundName":"nc73538_【背景素材】博麗神社.jpg","voiceCharacter":"操夢","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/河童\/河城みとり\/赤面\/みとり（怒り）.png","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_028_操夢.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.028.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 28","id":"7D845B6C-6CCF-4112-B400-351A16F5A89A","voiceDuration":6.5941269841269845,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg"},{"characterName":"","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.029.jpeg","slideTitle":"中扉","telop":"","backgroundName":"単色背景","animationName":"なし","voiceCharacter":"","id":"6DF9086C-4416-4A15-8E63-28082AFD44DF","duration":3,"transitionName":"なし","title":"その頃、東京の某所では…"},{"slideTitle":"第30スライド","duration":5.5,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","telop":"「紫様、例のFaxにある条件、本当に従うのですか？」\n私は、先ほどまでの電話を終えて、彼女にそう問いかける。","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_030_にとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.030.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 30","id":"8F005AD6-EB6A-4679-8FCE-55F687BC1941","voiceDuration":9.098684807256236,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第31スライド","duration":3.5,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","characterName":"八雲紫","telop":"「ええ、そうよ。それが何か言いたいのかしら？」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"八雲紫","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_031_八雲紫.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.031.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 31","id":"91B99902-7953-4B36-943D-9E943BB59050","voiceDuration":3.009546485260771,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第32スライド","duration":4.9,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","telop":"「その条件に従ったら、彼の支配下に入ることに許諾したことになりますよ。それで、よろしいのですか？」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_032_にとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.032.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 32","id":"813772BE-CB65-4371-B2AA-0A2C55D0CF82","voiceDuration":7.4812925170068025,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第33スライド","duration":3.5,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","characterName":"八雲紫","telop":"「それで、何かダメなことでもあるのかしら？」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"八雲紫","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_033_八雲紫.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.033.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 33","id":"DD5C966C-07EC-4D49-A093-4C46056404F5","voiceDuration":2.675578231292517,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第34スライド","duration":5.7,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","telop":"「確かにあの文書には、ゆかりん党の公約を実現すると、書いてありますが、彼がその公約を実現する保証はありませんよ。」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_034_にとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.034.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 34","id":"7A70255E-8F8D-4C44-8870-00FA29377060","voiceDuration":8.524399092970521,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第35スライド","duration":5.6000000000000005,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","telop":"「私の立ち位置でこんなことを申し上げるのは失礼ですが、はっきり言って、条件に対する対価が良すぎる気がしますよ。」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_035_にとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.035.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 35","id":"126F1687-CED9-4397-9E25-BF66E4B6A09F","voiceDuration":7.8415419501133785,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第36スライド","duration":5.2,"audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","characterName":"八雲紫","telop":"「確かにそうね…でも、世論が傾いてしまった今、私たちにできることっていうのは、これくらいしかないわよ。」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"八雲紫","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_036_八雲紫.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.036.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 36","id":"F8793EC0-DE4E-4001-9AED-31B63A5E3227","voiceDuration":6.8808843537414965,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第37スライド","duration":5.2,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","telop":"「確かに、そうですね…、でもはっきり言って、私は信用できませんよ、彼の条件は。十分な覚悟が入りますよ。」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_037_にとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.037.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 37","id":"E921E194-FB3B-4E44-B6FB-3718D8CA2938","voiceDuration":8.497006802721089,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"slideTitle":"第38スライド","duration":5.5,"audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","characterName":"にとり","telop":"「何てたって、私の押し売りで、パソコンを数週間前に送りつけた元顧客ですから…、その彼があんな条件を出すとは…」","backgroundName":"nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_038_にとり.wav","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.038.jpeg","animationName":"なし","transitionName":"なし","title":"シーン 38","id":"4047D460-6228-4B50-95ED-DBE690B690A1","voiceDuration":8.219160997732427,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg"},{"animationName":"なし","id":"4DF14CD1-E6E5-4910-9F14-2CF7ADCAA9CF","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg","voiceCharacter":"八雲紫","voiceDuration":3.0415192743764172,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.039.jpeg","title":"シーン 39","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_039_八雲紫.wav","slideTitle":"第39スライド","transitionName":"なし","backgroundName":"nc222578_会議室1-2.jpg","telop":"「何か、忘れていることはないかしら、にとり。」","characterName":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","duration":3.5},{"animationName":"なし","id":"C1CDE37D-0C76-4403-87B9-0C091F45A21E","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceDuration":8.216054421768707,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.040.jpeg","title":"シーン 40","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_040_にとり.wav","slideTitle":"第40スライド","transitionName":"なし","backgroundName":"nc222578_会議室1-2.jpg","telop":"「それも承知の上ですよ。何より彼の存在には、島送りにした彼女も絡んでますから、理解した上で、ですよ。」","characterName":"にとり","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","duration":5.1000000000000005},{"animationName":"なし","id":"DFDE15AF-C179-409D-813B-1B3DF79E3A7F","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg","voiceCharacter":"八雲紫","voiceDuration":2.9812925170068025,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.041.jpeg","title":"シーン 41","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_041_八雲紫.wav","slideTitle":"第41スライド","transitionName":"なし","backgroundName":"nc222578_会議室1-2.jpg","telop":"「そうね…」私がそういうと、戸がノックされる。","characterName":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","duration":3.5},{"animationName":"なし","id":"E2C44B47-1B48-4BD2-9912-3AEE8FC7DEB6","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg","voiceCharacter":"にとり","voiceDuration":7.337959183673469,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.042.jpeg","title":"シーン 42","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_042_にとり.wav","slideTitle":"第42スライド","transitionName":"なし","backgroundName":"nc222578_会議室1-2.jpg","telop":"「私は、紫様が、どうなっても知りませんからね…」\n私はそう彼女に言い残すと、部屋から出ていった。","characterName":"にとり","audioTrack":"track_voice_%E3%81%AB%E3%81%A8%E3%82%8A","duration":4.9},{"animationName":"なし","id":"8086A634-828A-44D8-A2B3-F714A7065112","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc222578_会議室1-2.jpg","voiceCharacter":"八雲紫","voiceDuration":7.475578231292517,"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.043.jpeg","title":"シーン 43","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_043_八雲紫.wav","slideTitle":"第43スライド","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲藍\/八雲藍(バトルっぽい)\/赤面\/藍（困る）.png","backgroundName":"nc222578_会議室1-2.jpg","telop":"すると、彼女と入れ替わるように、藍が入ってくる。\nそして、彼女のその言葉に、深呼吸をすると、部屋を出た。","characterName":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","duration":5.1000000000000005},{"animationName":"なし","id":"DC65F503-7448-4290-8EC8-D1BE000C40F5","voiceDuration":8.769115646258504,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.044.jpeg","title":"シーン 44","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_044_操夢.wav","slideTitle":"第44スライド","transitionName":"なし","backgroundName":"nc196984_書斎(夕).png","telop":"僕が、東京の某所に入ると、ある部屋に案内され、そこで、待たされる。そして、数分程度でその人物が入ってくる。","characterName":"操夢","audioTrack":"track_voice_soumu","duration":5.300000000000001},{"animationName":"なし","id":"BBA2709C-09C0-4C8D-9719-DD010AB893F0","voiceDuration":2.23,"voiceCharacter":"八雲紫","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.045.jpeg","title":"シーン 45","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_045_八雲紫.wav","slideTitle":"第45スライド","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png","backgroundName":"nc196984_書斎(夕).png","telop":"「ようこそ…と言った方がいいかしら…？」","characterName":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","duration":3.5},{"animationName":"なし","id":"3304FFF1-52AD-4482-9A32-35273414EF11","voiceDuration":5.373469387755102,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.046.jpeg","title":"シーン 46","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_046_操夢.wav","slideTitle":"第46スライド","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png","backgroundName":"nc196984_書斎(夕).png","telop":"「いえ、定型の挨拶は不要ですよ…総理。」\n僕は、そう彼女に返す。","characterName":"操夢","audioTrack":"track_voice_soumu","duration":3.5},{"animationName":"なし","id":"5FD3FA9B-B2CA-451D-ABC0-C4A91226A055","voiceDuration":3.4241043083900227,"voiceCharacter":"八雲紫","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.047.jpeg","title":"シーン 47","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_047_八雲紫.wav","slideTitle":"第47スライド","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png","backgroundName":"nc196984_書斎(夕).png","telop":"「そう、それじゃあ、早速本題を聞かせてくれるかしら？」","characterName":"八雲紫","audioTrack":"track_voice_%E5%85%AB%E9%9B%B2%E7%B4%AB","duration":3.5},{"animationName":"なし","id":"F9867FDA-DF75-42E0-A9BD-5EE2C855AC5C","voiceDuration":7.022380952380952,"voiceCharacter":"操夢","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.048.jpeg","title":"シーン 48","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_048_操夢.wav","slideTitle":"第48スライド","transitionName":"なし","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/八雲紫\/八雲紫（バトルっぽい）\/通常\/紫（微笑）.png","backgroundName":"nc196984_書斎(夕).png","telop":"「ええ、いいでしょう。まず、手始めに…」\n僕はそう言い、小1時間程度のプレゼンを仕向けるのだった。","characterName":"操夢","audioTrack":"track_voice_soumu","duration":4.800000000000001},{"characterName":"霧雨魔理沙","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.049.jpeg","slideTitle":"中扉","telop":"","backgroundName":"単色背景","animationName":"なし","voiceCharacter":"霧雨魔理沙","id":"C54332E7-A4D1-4493-B3FF-47E50425ED99","duration":3,"transitionName":"なし","title":"一方魔理沙たちは…"},{"audioTrack":"track_voice_marisa","slideTitle":"第50スライド","telop":"私たちがこの部屋に戻ってくると、霊夢たちがなぜか、怒っていた。「私たちがいない間に、何があったんだ？」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.050.jpeg","id":"CEC86CA7-A419-4AD5-BAF7-11B6BF127781","transitionName":"なし","title":"シーン 50","voiceDuration":8.884489795918368,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_001_霧雨魔理沙.wav","characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","duration":5.1000000000000005},{"audioTrack":"track_voice_reimu","slideTitle":"第51スライド","telop":"「彼ったら、私たちが寝ている隙に、ささっと向こうに行ったのよ。私たちに、あんな体験させておいて…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.051.jpeg","id":"B37FDC74-D934-4922-B87D-9C1CD1F33B98","transitionName":"なし","title":"シーン 51","voiceDuration":8.511995464852607,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_002_博麗霊夢.wav","characterName":"博麗霊夢","voiceCharacter":"博麗霊夢","duration":4.9},{"audioTrack":"track_voice_%E5%B0%84%E5%91%BD%E4%B8%B8%E6%96%87","slideTitle":"第52スライド","telop":"「そうですよ。私たちに何も言わずに、東京に行ってしまった彼には、一言でもいいから、私たちを起こして欲しかったです…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/射命丸文\/射命丸文\/赤面\/文（怒る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.052.jpeg","id":"71131F42-3A67-441E-8B88-23D0307F50CD","transitionName":"なし","title":"シーン 52","voiceDuration":7.971587301587301,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_003_射命丸文.wav","characterName":"射命丸文","voiceCharacter":"射命丸文","duration":5.800000000000001},{"audioTrack":"track_voice_marisa","slideTitle":"第53スライド","telop":"私は、そんなことを言う二人に、ふっと笑いが漏れてしまう。","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.053.jpeg","id":"39436469-958D-405F-B104-4883D525A693","transitionName":"なし","title":"シーン 53","voiceDuration":4.464489795918367,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_004_霧雨魔理沙.wav","characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","duration":3.5},{"audioTrack":"track_voice_reimu","slideTitle":"第54スライド","telop":"「なんで、あんたは笑ってるのよ、それに、みんなも…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.054.jpeg","id":"DAC0AAAF-D7A1-4198-8119-2195A7FB2F6E","transitionName":"なし","title":"シーン 54","voiceDuration":4.111995464852607,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_005_博麗霊夢.wav","characterName":"博麗霊夢","voiceCharacter":"博麗霊夢","duration":3.5},{"audioTrack":"track_voice_marisa","slideTitle":"第55スライド","telop":"「何だか、二人が駄々こねる子どもにそっくりだなって、\n感じたらふと、笑いが込み上げてくるぜ…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（怒る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.055.jpeg","id":"F586EE3F-EAF9-4651-B46F-81E52FAAAEDB","transitionName":"なし","title":"シーン 55","voiceDuration":7.2182312925170065,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_055_霧雨魔理沙.wav","characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","duration":4.6000000000000005},{"audioTrack":"track_voice_marisa","slideTitle":"第56スライド","telop":"すると、二人は「あっ」と声を出して驚く。\n「どうしたんだ、急に声出して驚いて…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/主人公たち\/博麗霊夢\/博麗霊夢(旧)\/博麗霊夢(旧)\/赤面\/霊夢（驚く）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/背景\/nc73538_【背景素材】博麗神社.jpg","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（27話目）_80789df3f8\/交換夫婦（27話目）_80789df3f8.056.jpeg","id":"316B9654-95C6-4F90-A45C-990433190C62","transitionName":"なし","title":"シーン 56","voiceDuration":6.5619954648526075,"animationName":"なし","voiceAudioPath":"\/Users\/zuyasi\/Library\/Application Support\/TohoStudio\/GeneratedAudio\/Slide_056_霧雨魔理沙.wav","characterName":"霧雨魔理沙","voiceCharacter":"霧雨魔理沙","duration":3.9000000000000004},{"audioTrack":"track_voice_reimu","slideTitle":"第57スライド","telop":"「なんだか、恥ずかしいわ…、彼がいないと…」","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/Documents\/動画用\/キャラクター\/射命丸文\/射命丸文\/赤面\/文（困る）.png","backgroundName":"nc73538_【背景素材】博麗神社.jpg","backgroundImagePath":"\/Volumes\/ZSSD