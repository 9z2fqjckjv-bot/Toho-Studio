[{"backgroundHeight":1080,"telopY":855,"slideType":"title","slideIndex":1,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":3,"backgroundY":0,"buildOrder":[],"presenterNote":"","transitionDelay":0,"slideWidth":1920,"characterName":"","animationTag":"なし","id":"6FCF6283-19E1-4F36-9754-17D5DBF8C502","slideHeight":1080,"telop":"告知","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"@zuyasi","objects":[],"rawPresenterNote":"","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.001.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/ゲームシナリオ\/image33.png","slideIndex":2,"backgroundName":"単色背景","detectedObjects":["キャラクター: image33.png"],"backgroundX":0,"telopWidth":1920,"characterY":30,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":2.876984126984127,"backgroundY":0,"buildOrder":[],"presenterNote":"この度、投稿者のふとした思いつきから東方Projectの二次創作ゲームを作ることにしました。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","characterX":720,"id":"D5EEB78E-24FB-4844-A285-7C969CFB907B","slideHeight":1080,"telop":"ゲーム制作開始のお知らせ","transitionDuration":0,"telopX":0,"characterWidth":480,"telopHeight":225,"title":"シーン 2","characterHeight":850,"objects":[],"rawPresenterNote":"（操夢）この度、投稿者のふとした思いつきから東方Projectの二次創作ゲームを作ることにしました。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.002.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":3,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":2.926984126984127,"backgroundY":0,"buildOrder":[],"presenterNote":"ゲームの名前は東方Project恋愛シュミレーターです。ですが、仮称のため、実際に名称をゲームの利用者さんから公募をしようと思います。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"2A0E6F21-2422-4568-8108-4A3D130152DB","slideHeight":1080,"telop":"ゲームの名称\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 3","objects":[],"rawPresenterNote":"（操夢）ゲームの名前は東方Project恋愛シュミレーターです。ですが、仮称のため、実際に名称をゲームの利用者さんから公募をしようと思います。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.003.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":4,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":4.300498866213152,"backgroundY":0,"buildOrder":[],"presenterNote":"ゲームのゴールには、結婚式にしようと思います。結婚式のシーンが来たら、エンドロールを流し、ゲームクリアになります。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"DA74061E-2FB3-4102-8926-791FA6A27B2B","slideHeight":1080,"telop":"目的\nゴール\n結婚式","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 4","objects":[],"rawPresenterNote":"（操夢）ゲームのゴールには、結婚式にしようと思います。結婚式のシーンが来たら、エンドロールを流し、ゲームクリアになります。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.004.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":5,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":9.634489795918368,"backgroundY":0,"buildOrder":[],"presenterNote":"シナリオに関しては、特に開発者である私が作るのではなく、ゲーム開始から今までの会話内容をもとに、AIが3つの選択肢を利用者に掲示し、その選択肢から選ぶことで進行していきます。自由記述にはしないことで、AI費用の節約を図ります。モデルは、Geminiを予定しています。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"21ED2C04-7596-44E7-BC5D-4D52BD82EC9D","slideHeight":1080,"telop":"シナリオ","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 5","objects":[],"rawPresenterNote":"（操夢）シナリオに関しては、特に開発者である私が作るのではなく、ゲーム開始から今までの会話内容をもとに、AIが3つの選択肢を利用者に掲示し、その選択肢から選ぶことで進行していきます。自由記述にはしないことで、AI費用の節約を図ります。モデルは、Geminiを予定しています。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.005.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":6,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":7.996984126984127,"backgroundY":0,"buildOrder":[],"presenterNote":"立ち絵は、このチャンネルでお馴染みのはるか式立ち絵を使います。AIに画像を作成することはさせず、あくまでPSDファイルの表情編集や、頬照りや影の設定、高度な作成モードの利用でPSDファイルの画像の色味や見た目の変更ができるようにします。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"62A388AF-8294-4695-B687-5CFE47E290BA","slideHeight":1080,"telop":"立ち絵\n立ち絵の自動作成と表示\n利用者が選んだプロンプトになぞられた立ち絵を作成します。なお、画像を生成するのではなく、TohoStudioを自動操作させることによってPSDファイルだけ基本は、完結できるようにし、高度な作成モードを利用することで、色変えや見た目のアレンジを利用できるようにする予定。","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 6","objects":[],"rawPresenterNote":"（操夢）立ち絵は、このチャンネルでお馴染みのはるか式立ち絵を使います。AIに画像を作成することはさせず、あくまでPSDファイルの表情編集や、頬照りや影の設定、高度な作成モードの利用でPSDファイルの画像の色味や見た目の変更ができるようにします。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.006.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":7,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":1.280748299319728,"backgroundY":0,"buildOrder":[],"presenterNote":"利用料金は基本0円ですが、AI機能に関しては、1プロンプトにつき10円で、事前に追加したデジポットから引き落とすか、あるいは利用者側でGeminiAPIを取得し、設定するかのいずれかを選べます。ただし、この１プロンプトにつき10円は今後、変更される可能性があるとだけ、述べておきます。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"B12C6845-CF7C-4DA3-B4F0-874F3B0C5057","slideHeight":1080,"telop":"利用料金","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 7","objects":[],"rawPresenterNote":"（操夢）利用料金は基本0円ですが、AI機能に関しては、1プロンプトにつき10円で、事前に追加したデジポットから引き落とすか、あるいは利用者側でGeminiAPIを取得し、設定するかのいずれかを選べます。ただし、この１プロンプトにつき10円は今後、変更される可能性があるとだけ、述べておきます。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.007.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":8,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":3.3973696145124714,"backgroundY":0,"buildOrder":[],"presenterNote":"背景画像は、既存のデータベースから自動選択するアルゴリズムを利用するか、AI側で画像を生成する方法のいずれかをとります。ただし、画像が生成された場合には、1枚の画像につき100円の代金をデジポットから引き落とします。必要に応じて使いすぎ防止の設定も加える予定です。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢&あるいは&既存のデータベースの画像をアレンジする","animationTag":"なし","id":"AEF295C0-F6FF-4C40-ABED-8CDB51772C6D","slideHeight":1080,"telop":"背景\n自動選択と必要に応じた生成\n背景は、既存のデータベースから自動選択するか、データベースに存在しない画像の場合は、画像を生成する。ただし、画像が生成された場合には、1枚の画像につき100円の代金をデジポットから引き落とす。なお、使いすぎ防止の設定を必要に応じて設ける予定。","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 8","objects":[],"rawPresenterNote":"（操夢）背景画像は、既存のデータベースから自動選択するアルゴリズムを利用するか、AI側で画像を生成する（あるいは、既存のデータベースの画像をアレンジする）方法のいずれかをとります。ただし、画像が生成された場合には、1枚の画像につき100円の代金をデジポットから引き落とします。必要に応じて使いすぎ防止の設定も加える予定です。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.008.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":9,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":5.714489795918367,"backgroundY":0,"buildOrder":[],"presenterNote":"キャラクターのセリフは、サーバーのライセンスを新規に購入します。購入後にAIと連携して、音声を生成するアルゴリズムやプログラムを組み立てて、公開します。また、選択肢の作成、キャラボイスの作成、立ち絵の作成、必要に応じて背景画像の生成が行われますが、この時間を原則すうじゅうびょう以内に抑え込みます。そうすることで、利用者に臨場感があふれるリアルタイムのような会話を提供します。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"29B35DDE-D73E-452C-B723-0D16787B3647","slideHeight":1080,"telop":"キャラボイス","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 9","objects":[],"rawPresenterNote":"（操夢）キャラクターのセリフは、サーバーのライセンスを新規に購入します。購入後にAIと連携して、音声を生成するアルゴリズムやプログラムを組み立てて、公開します。また、選択肢の作成、キャラボイスの作成、立ち絵の作成、必要に応じて背景画像の生成が行われますが、この時間を原則すうじゅうびょう以内に抑え込みます。そうすることで、利用者に臨場感があふれるリアルタイムのような会話を提供します。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.009.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":10,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":7.891995464852608,"backgroundY":0,"buildOrder":[],"presenterNote":"会話が進むうちに、会話相手が自ら、性格を作り上げていく仕様になっています。上記のような性格のほか、他にも多種多様な性格に対応を予定しています。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"DC6A1711-F70D-4515-9E44-2B0F28E6F0FB","slideHeight":1080,"telop":"豊富な性格設定\nよりリアリティにあふれるシミュレーションを提供\n以下のような性格に対応予定。\nツンデレ、ヤンデレ、デレデレなど\nメンヘラ、依存など\n厨二病など\nシスコン、ブラコンなど\n特徴的な性別や言動など","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 10","objects":[],"rawPresenterNote":"（操夢）会話が進むうちに、会話相手が自ら、性格を作り上げていく仕様になっています。上記のような性格のほか、他にも多種多様な性格に対応を予定しています。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.010.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/ゲームシナリオ\/image33.png","slideIndex":11,"backgroundName":"単色背景","detectedObjects":["キャラクター: image33.png"],"backgroundX":0,"telopWidth":1920,"characterY":30,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":1.6530385487528345,"backgroundY":0,"buildOrder":[],"presenterNote":"おまけとして計画中のゲーム画面レイアウトを参考程度にご紹介します。実際の画面とは異なることがありますので、ご承知おきください。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","characterX":720,"id":"9FA60FF1-5E2D-4E77-9C3B-F606C02C0955","slideHeight":1080,"telop":"参考：ゲーム画面レイアウト","transitionDuration":0,"telopX":0,"characterWidth":480,"telopHeight":225,"title":"シーン 11","characterHeight":850,"objects":[],"rawPresenterNote":"（操夢）おまけとして計画中のゲーム画面レイアウトを参考程度にご紹介します。実際の画面とは異なることがありますので、ご承知おきください。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.011.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":12,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":1.2546485260770974,"backgroundY":0,"buildOrder":[{"effect":"回転","id":"9C61B7FA-D137-4419-BE55-3B803E7F09AF","trigger":"クリック時","delay":0,"order":1,"objectName":"操夢"}],"presenterNote":"ゲームを起動すると、プログラムやソースコードの検証が始まります。検証中に、違法なコードや不正なプログラムを発見した場合は、即座にブロックされ、以後ゲームの起動ができなくなる仕様です。処理にはインターネット接続が必須な内容を含むため、安定したネット環境を整えることを推奨します。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"回転","id":"78D6C1A1-D403-48B1-AD7B-35A923B24343","slideHeight":1080,"telop":"検証中…\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 12","objects":[],"rawPresenterNote":"（操夢）ゲームを起動すると、プログラムやソースコードの検証が始まります。検証中に、違法なコードや不正なプログラムを発見した場合は、即座にブロックされ、以後ゲームの起動ができなくなる仕様です。処理にはインターネット接続が必須な内容を含むため、安定したネット環境を整えることを推奨します。","backgroundWidth":1920,"animations":[{"id":"59732B03-9AF0-4E56-8CBF-F3C891AF790A","effect":"回転","rotationAngle":360,"rotationCount":1,"animationKind":"action","targetObjectName":"操夢","duration":5,"order":1,"rotationDirection":"clockwise"}],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.012.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":13,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":5,"backgroundY":0,"buildOrder":[{"effect":"回転","id":"06446B1B-BF62-479E-B083-9A1FA4EAE854","trigger":"クリック時","delay":0,"order":1,"objectName":"操夢"}],"presenterNote":"正常に検証が終了すると、ゲームの起動が始まります。ゲームの読み込みが終了すると、次の画面に進みます。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"回転","id":"C5EF825B-DA4D-4BFD-9E8D-3E8FDDD49802","slideHeight":1080,"telop":"起動中…\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 13","objects":[],"rawPresenterNote":"（操夢）正常に検証が終了すると、ゲームの起動が始まります。ゲームの読み込みが終了すると、次の画面に進みます。","backgroundWidth":1920,"animations":[{"id":"FED770E7-5311-46BB-9CA7-8E04CA75E3AA","effect":"回転","rotationAngle":360,"rotationCount":1,"animationKind":"action","targetObjectName":"操夢","duration":5,"order":1,"rotationDirection":"clockwise"}],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.013.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":14,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":7.1000000000000005,"backgroundY":0,"buildOrder":[],"presenterNote":"この画面に来たら、認証開始ボタンを押し、アプリ内ブラウザでGoogleアカウントにログインします。これは、課金情報の紐付けと管理に使われます。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢&追加費用はかかりません。","animationTag":"なし","id":"F31FB7BF-A53C-4A7F-A82B-645EB93D358F","slideHeight":1080,"telop":"以下のボタンを押し、認証をしてください。\n認証開始↗️\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 14","objects":[],"rawPresenterNote":"（操夢）この画面に来たら、認証開始ボタンを押し、アプリ内ブラウザでGoogleアカウントにログインします。これは、課金情報の紐付けと管理に使われます。（追加費用はかかりません。）","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.014.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":15,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":9.9,"backgroundY":0,"buildOrder":[],"presenterNote":"認証が済んだら、プレイヤー名を入力します。なお、レイアウトに記載の通り、このゲームにはフレンド機能や共有機能などはないため、キャラクターからの呼び名だけに使われます。読み方は次の画面で指定できます。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"300C0DD8-02DD-4D74-91C9-163C50DE37C2","slideHeight":1080,"telop":"プレイヤー名を入力","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 15","objects":[],"rawPresenterNote":"（操夢）認証が済んだら、プレイヤー名を入力します。なお、レイアウトに記載の通り、このゲームにはフレンド機能や共有機能などはないため、キャラクターからの呼び名だけに使われます。読み方は次の画面で指定できます。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.015.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":16,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":4.1000000000000005,"backgroundY":0,"buildOrder":[],"presenterNote":"プレイヤー名が入力できたら、その読み方を入力します。入力できたら、次へを押します。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"67865981-54A9-4046-B73B-0696339CED43","slideHeight":1080,"telop":"読み方を入力\n読み方を入力","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 16","objects":[],"rawPresenterNote":"（操夢）プレイヤー名が入力できたら、その読み方を入力します。入力できたら、次へを押します。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.016.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":17,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":5,"backgroundY":0,"buildOrder":[{"effect":"回転","id":"80CAB15B-FA2F-4889-93DC-77B4F7A59E20","trigger":"クリック時","delay":0,"order":1,"objectName":"操夢"}],"presenterNote":"読み方を決めて、次に進むと、プレイヤー名と読み方にNGワードや不適切な表現が含まれていないかを、検証します。万が一、含まれていた場合には、プレイヤー名と読み方を再入力する必要があります。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"回転","id":"05555D43-2DB1-4A9E-A428-6DAE59929C05","slideHeight":1080,"telop":"検証中…\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 17","objects":[],"rawPresenterNote":"（操夢）読み方を決めて、次に進むと、プレイヤー名と読み方にNGワードや不適切な表現が含まれていないかを、検証します。万が一、含まれていた場合には、プレイヤー名と読み方を再入力する必要があります。","backgroundWidth":1920,"animations":[{"id":"2C6DEF07-1135-444E-9121-47C32EFB38C4","effect":"回転","rotationAngle":360,"rotationCount":1,"animationKind":"action","targetObjectName":"操夢","duration":5,"order":1,"rotationDirection":"clockwise"}],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.017.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/告知\/霊夢（微笑）.png","slideIndex":18,"backgroundName":"単色背景","detectedObjects":["キャラクター: 霊夢（微笑）.png"],"backgroundX":0,"telopWidth":1920,"characterY":30,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":21.400000000000002,"backgroundY":0,"buildOrder":[],"presenterNote":"次に、ヒロイン役になるキャラクターを選びます。\n左右の矢印キーで出演作品あるいは分類を選び、上下の矢印キーでその分類に該当するキャラクター名を選択します。\nすると、右側にそのキャラクターのサンプル画像が表示されます。\n現状だと、PC向けに配信予定ですが、必要に応じてスマホ版も出す予定です。\nまた、Mキーを押すとあなたの性別が男になり、Wキーで女になります。\nその他の性別に関しては、今現在対応していません。今後、対応予定です。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢&紅魔郷&妖々夢","animationTag":"なし","characterX":720,"id":"7F2C59C7-DF5F-4855-A0F1-2573D8DC54F2","slideHeight":1080,"telop":"キャラクターと\nあなたの性別を選ぶ\n←　主人公　→\n↑\n博麗霊夢\n↓\nM：男　W：女","transitionDuration":0,"telopX":0,"characterWidth":480,"telopHeight":225,"title":"シーン 18","characterHeight":850,"objects":[],"rawPresenterNote":"（操夢）次に、ヒロイン役になるキャラクターを選びます。\n左右の矢印キーで出演作品あるいは分類（紅魔郷、妖々夢、風神録などです。）を選び、上下の矢印キーでその分類に該当するキャラクター名を選択します。\nすると、右側にそのキャラクターのサンプル画像が表示されます。\n現状だと、PC向けに配信予定ですが、必要に応じてスマホ版も出す予定です。\nまた、Mキーを押すとあなたの性別が男になり、Wキーで女になります。\nその他の性別に関しては、今現在対応していません。今後、対応予定です。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.018.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":19,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":9.1,"backgroundY":0,"buildOrder":[],"presenterNote":"キャラクターを選んだら、次にAIの導入方法を選択します。プロンプト購入の場合、一定額の代金をデジポットとして支払い、利用します。GeminiAPIキーの場合、APIキーを登録します。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢&APIキーは&ローカル保存なため","animationTag":"なし","id":"A94E552F-5634-484D-B5F1-1C56E43301F6","slideHeight":1080,"telop":"AIの導入方法を選択\nプロンプト購入","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 19","objects":[],"rawPresenterNote":"（操夢）キャラクターを選んだら、次にAIの導入方法を選択します。プロンプト購入の場合、一定額の代金をデジポットとして支払い、利用します。GeminiAPIキーの場合、APIキーを登録します。（APIキーは、ローカル保存なため、他の人に見られることはありません。）","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.019.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":20,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":69.9,"backgroundY":0,"buildOrder":[],"presenterNote":"プロンプトの購入プランは全部で10種類あり、購入画面では3ページに分かれて表示されますが、まとめて購入するほど1プロンプトあたりの単価が安くなるお得な設定になっています。まず1ページ目にはライトから標準利用向けのプランが並んでおり、気軽に試せる「お試し利用に最適」な10prompt・100円、少しだけ会話したい時の「短時間利用なら」20prompt・200円、ここから割引が適用されて「10prompt分お得」になる50prompt・400円、そしてたっぷり会話を重ねたい方に向けた「ボリューミー」な100prompt・800円があります。続いて2ページ目は日常的にたっぷり使いたい方向けで、100promptを2回買うよりお得になる「さらにコスパアップ」の200prompt・1,200円、プラス300円で一気に2.5倍の量になる「一番人気の高コスパ」500prompt・1,500円、残数を気にせず「毎日たっぷり話せる」1,000prompt・2,000円、そして1プロンプトあたり1.5円で長くじっくり遊べる「長期間の相棒に」2,000prompt・3,000円が揃っています。最後の3ページ目は超大容量のヘビーユーザー向けとなっており、1円を切る単価で思う存分使い倒せる「限界突破の大容量」5,000prompt・4,000円と、1プロンプトあたり0.5円という破格の「最安値・究極のまとめ買い」10,000prompt・5,000円をご用意しています。なお、プロンプトは後からいつでも追加購入ができ、次の画面でオートチャージの設定も可能ですので、まずは少ないプランから始めても安心です。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"615EC652-8471-48F3-97AE-3BF806CD08C7","slideHeight":1080,"telop":"プロンプトを購入\n10prompt：¥100\n20prompt：¥200\n50prompt：¥400\n100prompt：¥800\n1 \/ 3\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 20","objects":[],"rawPresenterNote":"（操夢）プロンプトの購入プランは全部で10種類あり、購入画面では3ページに分かれて表示されますが、まとめて購入するほど1プロンプトあたりの単価が安くなるお得な設定になっています。まず1ページ目にはライトから標準利用向けのプランが並んでおり、気軽に試せる「お試し利用に最適」な10prompt・100円、少しだけ会話したい時の「短時間利用なら」20prompt・200円、ここから割引が適用されて「10prompt分お得」になる50prompt・400円、そしてたっぷり会話を重ねたい方に向けた「ボリューミー」な100prompt・800円があります。続いて2ページ目は日常的にたっぷり使いたい方向けで、100promptを2回買うよりお得になる「さらにコスパアップ」の200prompt・1,200円、プラス300円で一気に2.5倍の量になる「一番人気の高コスパ」500prompt・1,500円、残数を気にせず「毎日たっぷり話せる」1,000prompt・2,000円、そして1プロンプトあたり1.5円で長くじっくり遊べる「長期間の相棒に」2,000prompt・3,000円が揃っています。最後の3ページ目は超大容量のヘビーユーザー向けとなっており、1円を切る単価で思う存分使い倒せる「限界突破の大容量」5,000prompt・4,000円と、1プロンプトあたり0.5円という破格の「最安値・究極のまとめ買い」10,000prompt・5,000円をご用意しています。なお、プロンプトは後からいつでも追加購入ができ、次の画面でオートチャージの設定も可能ですので、まずは少ないプランから始めても安心です。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.020.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":21,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":6.1000000000000005,"backgroundY":0,"buildOrder":[],"presenterNote":"次に、オートチャージのプランを選択します。既存のプロンプトが切れた際に、その都度自動でデジポット残高から引き落とされます。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"803AE68E-0323-47B2-A967-14074F12EFEB","slideHeight":1080,"telop":"オートチャージプランを選択\n10prompt：¥100\n20prompt：¥200\n50prompt：¥400\n100prompt：¥800\n200prompt：¥800\n500prompt：¥800\n1prompt：¥10\nオートチャージなし\n前に戻る\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 21","objects":[],"rawPresenterNote":"（操夢）次に、オートチャージのプランを選択します。既存のプロンプトが切れた際に、その都度自動でデジポット残高から引き落とされます。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.021.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":22,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":8.200000000000001,"backgroundY":0,"buildOrder":[],"presenterNote":"最後にデジポットの追加代金を選択します。\n500円から1万円を選べます。\nなお、実際にプロンプトの購入に使える残高は、追加金額から手数料を差し引いた金額になります。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"7887EF63-65F3-48F0-BCC2-F4D56E776175","slideHeight":1080,"telop":"500円","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 22","objects":[],"rawPresenterNote":"（操夢）最後にデジポットの追加代金を選択します。\n500円から1万円を選べます。\nなお、実際にプロンプトの購入に使える残高は、追加金額から手数料を差し引いた金額になります。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.022.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":23,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":3.5,"backgroundY":0,"buildOrder":[],"presenterNote":"最後に購入内容と金額を確認します。訂正する場合は、前に戻るを押します。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"なし","id":"B770FBF9-FD1E-4197-B56A-EAE8ADD686AF","slideHeight":1080,"telop":"前に戻る","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 23","objects":[],"rawPresenterNote":"（操夢）最後に購入内容と金額を確認します。訂正する場合は、前に戻るを押します。","backgroundWidth":1920,"animations":[],"slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/告知_56505f9ca4\/告知_56505f9ca4.023.jpeg","transitionTag":"なし"},{"backgroundHeight":1080,"telopY":855,"slideType":"content","slideIndex":24,"backgroundName":"単色背景","detectedObjects":["演出枠"],"backgroundX":0,"telopWidth":1920,"transitionTrigger":"クリック時","transitionEffect":"なし","duration":5,"backgroundY":0,"buildOrder":[{"effect":"回転","id":"39C313E8-597C-4D2B-A058-CDFEA9FDFAA4","trigger":"クリック時","delay":0,"order":1,"objectName":"操夢"}],"presenterNote":"購入内容の確認を済ますと、ゲームデータが保存されます。万が一、支払い処理をキャンセルしたり、中断した場合でも、次回にゲームを再起動すれば、購入内容の確認から進められます。セーブが終わると、アプリ内ブラウザが開き、PayPalでの支払いを終えると、次の画面に進みます。","transitionDelay":0,"slideWidth":1920,"characterName":"操夢","animationTag":"回転","id":"37B4DB7D-7FCE-4AE3-9FB4-B51B31906A66","slideHeight":1080,"telop":"セーブ中…\n東方恋愛シュミレーター\n仮称です。もしかしたら変わるかも…","transitionDuration":0,"telopX":0,"telopHeight":225,"title":"シーン 24","objects":[],"rawPresenterNote":"（操夢）購入内容の確認を済ますと、ゲームデータ