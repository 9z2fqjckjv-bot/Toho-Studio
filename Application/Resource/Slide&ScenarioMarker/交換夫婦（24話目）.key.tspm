84E0C7C02D","name":"tile_paper_ltgray.jpeg","x":100,"width":300,"y":100,"height":300},{"objectType":"image","imagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）叡智シーンのみ\/一人部屋３（日中）.jpg","id":"B78E8899-AC4E-43D9-A776-B3128687C00E","animations":[],"name":"一人部屋３（日中）.jpeg","x":100,"width":300,"y":100,"height":300}],"transitionTag":"クロスディゾルブ","transitionTrigger":"automatically","characterName":"操夢","presenterNote":"僕は、それから、家に戻ってくると、ポケットからポケベルを取り出し、PCに繋げて起動する。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.015.jpeg","buildOrder":[],"animations":[],"duration":4.4,"slideIndex":15},{"telop":"そして、何気なくポケベルのアプリを開く。\nFiles\nポケベル\nポケベル\nFiles\n編集\n表示\n移動\nウィンドウ\nヘルプ","backgroundName":"nc73538_【背景素材】博麗神社.jpg","animationTag":"なし","transitionDelay":0,"rawPresenterNote":"（操夢）そして、何気なくポケベルのアプリを開く。","slideType":"content","transitionEffect":"クロスディゾルブ","title":"シーン 16","backgroundHeight":1080,"telopY":855,"telopWidth":1920,"backgroundY":0,"backgroundWidth":1920,"telopX":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"D2CEE13B-114D-40E6-8946-41FA9294958A","slideHeight":1080,"slideWidth":1920,"backgroundX":0,"detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg","オブジェクト:A1DD21DE-9AB8-500D-B285-8A3946DA22C1.jpeg"],"telopHeight":225,"transitionDuration":0.8,"objects":[{"objectType":"image","animations":[],"id":"39313936-23F9-4312-8E75-40B4D3AF6D06","name":"tile_paper_medgray.jpeg","x":100,"width":300,"y":100,"height":300},{"objectType":"image","animations":[],"id":"D5336064-2BEF-4CE8-8AA8-1204C316B53D","name":"tile_paper_ltgray.jpeg","x":100,"width":300,"y":100,"height":300},{"objectType":"image","imagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/A1DD21DE-9AB8-500D-B285-8A3946DA22C1.jpeg","id":"30E7726C-E9B5-4ED5-A6F4-3BA90EDB0DC9","animations":[],"name":"A1DD21DE-9AB8-500D-B285-8A3946DA22C1.jpeg","x":100,"width":300,"y":100,"height":300}],"transitionTag":"クロスディゾルブ","transitionTrigger":"automatically","characterName":"操夢","presenterNote":"そして、何気なくポケベルのアプリを開く。","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/交換夫婦（24話目）_df4c9d483a\/交換夫婦（24話目）_df4c9d483a.016.jpeg","buildOrder":[],"animations":[],"duration":3.5,"slideIndex":16},{"characterY":30,"telop":"ポケベル\nポケベル初回設定\nポケベル\nFiles\nポケベルはさまざまな人々の\n「誰かと繋がりたい」という\n思いが沢山こもった製品として\n平成初期から中期にかけて\n流行した通話機能を有する機器\nであり、国会においてスマート\nフォンマナーの問題が挙げられ\n国民のスマートフォン利用を\n原則中止すると、我ら河童\nが生み出したこのポケベルが\n巨大な需要を生み出して…\npocketbell.kappa\/home\/top\n政府公認の安心国産ポケベル\nホーム\nポケベルって何？\n出来ること\n河童の技術力\nポケベル史\n政府公認とは？\nポケベルの魅力\n電話の歴史\nポケベルの性能\nポケベルの価格\n必要なもの\n固定電話は必須？\n通信機能について\nすると、右上に通知が表示され、\n僕は、その通知にカーソルを合わせてクリックする。\n操作\nWeb\nポケベル\n政府が臨時記者会見が始まる\n例の賭博問題に関する言及か…","backgroundName":"nc73538_【背景素材】博麗神社.jpg","characterHeight":850,"characterX":720,"animationTag":"なし","transitionDelay":0,"characterImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/交換夫婦（21.22話目）\/長ズボンにとり（微笑）.png","rawPresenterNote":"（操夢）すると、右上に通知が表示され、僕は、その通知にカーソルを合わせてクリックする。","slideType":"content","transitionEffect":"クロスディゾルブ","title":"シーン 17","backgroundHeight":1080,"telopY":855,"characterWidth":480,"backgroundY":0,"backgroundWidth":1920,"telopX":0,"backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","id":"8D5BE9FC-CCD0-40D1-AE1F-6BCF85DFB471","telopWidth":1920,"slideHeight":1080,"slideWidth":1920,"backgroundX":0,"detectedObjects":["キャラクター:長ズボンにとり（微笑）.png","オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg","オブジェクト:A1DD21DE-9AB8-500D-B285-8A3946DA22C1.jpeg"],"telopHeight":225,"transitionDuration":0.8,"objects":[{"objectType":"image","animations":[],"id":"080218FA-5CED-4FFF-A48E-7EB272784F92","name":"