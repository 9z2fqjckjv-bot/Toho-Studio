ray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"580186F9-975F-4294-9D10-407FC3553252","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"939283A3-0F02-4010-82AC-78D6F8A790D6","objectType":"image"}],"presenterNote":"ところがわたしがかまくらについてみっかとたたないうちに、わたしをよびよせたともだちは、きゅうにくにもからかえれというでんぽうをうけとった。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.012.jpeg"},{"backgroundHeight":1080,"title":"シーン 13","telopX":0,"telop":"電報には母が病気だからと断って\nあったけれども友達はそれを信じなかった。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":13,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）でんぽうにはははがびょうきだからとことわってあったけれどもともだちはそれをしんじなかった。","telopY":855,"slideType":"content","id":"CFBF6D38-E39B-45F4-808B-199AACB36CDA","duration":4.5,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"9E99AC5D-BD14-43DF-842B-922C94CBFC52","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"4BD550E1-5E51-41B8-BD69-1EE2062D26CB","objectType":"image"}],"presenterNote":"でんぽうにはははがびょうきだからとことわってあったけれどもともだちはそれをしんじなかった。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.013.jpeg"},{"backgroundHeight":1080,"title":"シーン 14","telopX":0,"telop":"友達はかねてから国元にいる親たちに\n勧まない結婚を強いられていた。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":14,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）ともだちはかねてからくにもとにいるおやたちにすすまないけっこんをしいられていた。","telopY":855,"slideType":"content","id":"88982783-F920-4AA9-9E55-BDA8410D6803","duration":4,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"34E1899F-0201-484E-8595-7D457AC0240E","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"3E28EF53-0A6E-4F64-B3EF-185915AA73D1","objectType":"image"}],"presenterNote":"ともだちはかねてからくにもとにいるおやたちにすすまないけっこんをしいられていた。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.014.jpeg"},{"backgroundHeight":1080,"title":"シーン 15","telopX":0,"telop":"彼は現代の習慣からいうと結婚するにはあまり年が若過ぎた。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":15,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）かれはげんだいのしゅうかんからいうとけっこんするにはあまりとしがわかすぎた。","telopY":855,"slideType":"content","id":"F02653B4-93D0-4746-B816-36350BB9409F","duration":3.8000000000000003,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"23E012EE-7283-4DF5-9B23-7E5D01280834","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"5A329155-E162-4994-9C6E-49156D18E0FB","objectType":"image"}],"presenterNote":"かれはげんだいのしゅうかんからいうとけっこんするにはあまりとしがわかすぎた。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.015.jpeg"},{"backgroundHeight":1080,"title":"シーン 16","telopX":0,"telop":"それに肝心の当人が気に入らなかった。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":16,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）それにかんじんのとうにんがきにいらなかった。","telopY":855,"slideType":"content","id":"1E61073A-BFFA-477D-8E0D-FB5C2EA47ABA","duration":3.5,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"9495F2A7-8BF1-4B25-A1F7-5D5B5E61C5EE","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"3422AD74-89AD-42C9-B712-F40F7168BA4B","objectType":"image"}],"presenterNote":"それにかんじんのとうにんがきにいらなかった。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.016.jpeg"},{"backgroundHeight":1080,"title":"シーン 17","telopX":0,"telop":"それで夏休みに当然帰るべきところを、\nわざと避けて東京の近くで遊んでいたのである。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":17,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）それでなつやすみにとうぜんかえるべきところを、わざとさけてとうきょうのちかくであそんでいたのである。","telopY":855,"slideType":"content","id":"0DCF1EF2-C7EE-4C91-A709-925153341307","duration":5,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"637167F8-853A-4EC8-945A-1A1AAA84D153","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"B4EAD8F8-D11A-4151-8851-608F63A5B71B","objectType":"image"}],"presenterNote":"それでなつやすみにとうぜんかえるべきところを、わざとさけてとうきょうのちかくであそんでいたのである。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.017.jpeg"},{"backgroundHeight":1080,"title":"シーン 18","telopX":0,"telop":"彼は電報を私に見せてどうしようと相談をした。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":18,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）かれはでんぽうをわたしにみせてどうしようとそうだんをした。","telopY":855,"slid