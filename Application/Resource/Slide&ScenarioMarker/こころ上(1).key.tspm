ote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.019.jpeg"},{"backgroundHeight":1080,"title":"シーン 20","telopX":0,"telop":"けれども実際彼の母が病気であるとすれば\n彼は固より帰るべきはずであった。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":20,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）けれどもじっさいかれのははがびょうきであるとすればかれはこよりかえるべきはずであった。","telopY":855,"slideType":"content","id":"68BAE6B3-90F8-4A30-98E7-E8A6ABC6B9BF","duration":4.3,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"461FA278-292C-4A32-A3F2-FF2762F4C75E","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"A51BFD66-23E3-48C9-848F-4144E508254C","objectType":"image"}],"presenterNote":"けれどもじっさいかれのははがびょうきであるとすればかれはこよりかえるべきはずであった。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.020.jpeg"},{"backgroundHeight":1080,"title":"シーン 21","telopX":0,"telop":"それで彼はとうとう帰る事になった。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":21,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）それでかれはとうとうかえることになった。","telopY":855,"slideType":"content","id":"10EA506A-8D5C-4ED2-BD64-7971B7BC45EA","duration":3.5,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"C20C71ED-9FB7-428B-81F3-BF915D09C496","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"96267429-12C5-4628-8DC6-FF5A0209493C","objectType":"image"}],"presenterNote":"それでかれはとうとうかえることになった。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.021.jpeg"},{"backgroundHeight":1080,"title":"シーン 22","telopX":0,"telop":"せっかく来た私は一人取り残された。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":22,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）せっかくきたわたしはひとりとりのこされた。","telopY":855,"slideType":"content","id":"A720AA1A-6C5E-40DD-9443-C63F35E0A676","duration":3.5,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"F9380AFE-E5D0-4294-B257-26743B61383B","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"2EEBDF86-8EF5-4161-A0D4-B6039F7E0AFA","objectType":"image"}],"presenterNote":"せっかくきたわたしはひとりとりのこされた。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.022.jpeg"},{"backgroundHeight":1080,"title":"シーン 23","telopX":0,"telop":"学校の授業が始まるにはまだ大分日数があるので鎌倉におってもよし、帰ってもよいという境遇にいた私は、当分元の宿に留まる覚悟をした。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":23,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）がっこうのじゅぎょうがはじまるにはまだだいぶにっすうがあるのでかまくらにおってもよし、かえってもよいというきょうぐうにいたわたしは、とうぶんもとのやどにとまるかくごをした。","telopY":855,"slideType":"content","id":"F1ADAC8B-6588-441D-AD67-B47082BE56B8","duration":8.6,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"1901BA15-2B50-4252-8814-41DD72845F5A","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"14876DBD-5C1C-47A4-9D9D-4F56193C0B16","objectType":"image"}],"presenterNote":"がっこうのじゅぎょうがはじまるにはまだだいぶにっすうがあるのでかまくらにおってもよし、かえってもよいというきょうぐうにいたわたしは、とうぶんもとのやどにとまるかくごをした。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.023.jpeg"},{"backgroundHeight":1080,"title":"シーン 24","telopX":0,"telop":"友達は中国のある資産家の息子で金に不自由のない男であったけれども、学校が学校なのと年が年なので、生活の程度は私とそう変りもしなかった。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":24,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）ともだちはちゅうごくのあるしさんかのむすこでかねにふじゆうのないおとこであったけれども、がっこうががっこうなのととしがとしなので、せいかつのていどはわたしとそうかわりもしなかった。","telopY":855,"slideType":"content","id":"EB52B0B4-1178-46B3-BAF3-2ABCEEB1ABE3","duration":9,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"724B329C-4BEE-4E08-B433-302C463FEDE9","objectType":"image"},{"animations":[],"name":"tile_paper_ltgray.jpeg","y":100,"height":300,"x":100,"width":300,"id":"40971F19-3017-4863-B6A7-74FAA7598889","objectType":"image"}],"presenterNote":"ともだちはちゅうごくのあるしさんかのむすこでかねにふじゆうのないおとこであったけれども、がっこうががっこうなのととしがとしなので、せいかつのていどはわたしとそうかわりもしなかった。","transitionTag":"なし","slideImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_slides\/こころ上_1__89da902c03\/こころ上_1__89da902c03.024.jpeg"},{"backgroundHeight":1080,"title":"シーン 25","telopX":0,"telop":"したがって一人ぼっちになった私は別に\n恰好な宿を探す面倒ももたなかったのである。","telopWidth":1920,"backgroundName":"nc73538_【背景素材】博麗神社.jpg","detectedObjects":["オブジェクト:tile_paper_medgray.jpeg","オブジェクト:tile_paper_ltgray.jpeg"],"telopHeight":225,"transitionDelay":0,"slideWidth":1920,"transitionDuration":0,"backgroundY":0,"transitionEffect":"なし","slideIndex":25,"transitionTrigger":"クリック時","backgroundImagePath":"\/Volumes\/ZSSD\/GitHub\/repository\/TohoStudio\/.cache\/keynote_extracted\/東方惑情録　第2話\/nc73538_【背景素材】博麗神社.jpg","rawPresenterNote":"（操夢）したがってひとりぼっちになったわたしはべつにかっこうなやどをさがすめんどうももたなかったのである。","telopY":855,"slideType":"content","id":"3EEE31AE-1895-4834-BF8C-558973109FD1","duration":4.9,"animationTag":"なし","slideHeight":1080,"buildOrder":[],"characterName":"操夢","backgroundX":0,"backgroundWidth":1920,"animations":[],"objects":[{"animations":[],"name":"tile_paper_medgray.j