# ==============================================================================
# 東方Project恋愛シミュレーター サーバー設定 (.env.example -> .env にコピーして使用)
# ※ このファイルおよび secrets/ 配下は絶対に GitHub へ公開しないでください。
# ==============================================================================

# サーバー待受設定
RENAI_HOST=0.0.0.0
RENAI_PORT=8096
RENAI_PUBLIC_BASE_URL=http://127.0.0.1:8096

# 素材ルート（~/Documents）
DOC_ROOT=~/Documents

# サーバー管理用 Gemini API キー（「プロンプト購入」モードのユーザー向け）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# AquesTalk1 Linux版ライブラリ配置先（契約後に libAquesTalk1-*.so 等を配置）
AQUESTALK_LINUX_LIBS_DIR=~/Documents/キャラセリフメーカー/libs/linux
AQUESTALK_DEV_KEY=
AQUESTALK_USR_KEY=
# AquesTalk1 ライセンス実費回収目標額（税込・利益ゼロ上限ストッパー）
# 初年度: 開発¥49,500 + サーバー版¥107,800 = 157300 / 2年目以降: AQUESTALK_COST_PERIOD=year_2, 107800 に変更
AQUESTALK_COST_PERIOD=year_1
AQUESTALK_ANNUAL_TARGET_YEN=157300
# 評価・開発中のローカルブリッジ（Mac側 AquesTalkPlayer 連携用）
AQUESTALK_BRIDGE_URL=http://127.0.0.1:18091

# Google OAuth 認証設定（Slide 13: 課金情報の紐付け・管理）
GOOGLE_OAUTH_JSON_PATH=./secrets/google_oauth_client.json
ALLOW_DEV_AUTH=true

# PayPal 決済設定（Slide 3, 21-24: デポジット支払い）
# sandbox または live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal決済手数料率（国内標準 3.6% + 40円。実費回収の残高計算に使用）
PAYPAL_FEE_RATE=0.036
PAYPAL_FEE_FIXED_YEN=40
ALLOW_SANDBOX_SIMULATION=true

# 負荷制御（Minecraftサーバー・Chromeとの干渉防止）
MAX_CONCURRENT_HEAVY_TASKS=2
ENABLE_CHOICE_PREFETCH=false
