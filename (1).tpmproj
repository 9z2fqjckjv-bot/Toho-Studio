  "scenes": [
    {
      "slide_index": 1,
      "text": "ぼくが、りょうしんとけんかわかれして、そのままいえでしてから、はやすうかげつ、ぐんまとながののけんきょうにあるとうげのみちをあるいていたとき。",
      "notes": "（操夢）ぼくが、りょうしんとけんかわかれして、そのままいえでしてから、はやすうかげつ、ぐんまとながののけんきょうにあるとうげのみちをあるいていたとき。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクガ、リョウシントケンカワカレシテ、ソノママイエデシテカラ、ワヤスウカゲツ、グンマトナガノノケンキョウニアルトウゲノミチヲアルイテイタトキ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "template_name": "タイトル",
      "template_info": {
        "layout_name": "タイトル",
        "is_section_header": true,
        "section_title": "\"3"
      },
      "slide_objects": {
        "characters": [
          {
            "name": "操夢",
            "image_name": "操夢_立ち絵",
            "image_path": "",
            "animations": [],
            "has_movement": false,
            "status": "静止画 (立ち絵表示)",
            "duration": 0
          }
        ],
        "telop": {
          "detected": true,
          "text": "僕が、両親と喧嘩別れして、そのまま家出してから、はや数ヶ月、群馬と長野の県境にある峠の道を歩いていたとき…",
          "shape_name": "テロップ枠",
          "animations": []
        },
        "texts": [],
        "shapes": [],
        "template": {
          "layout_name": "タイトル",
