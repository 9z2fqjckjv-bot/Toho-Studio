    {
      "slide_index": 4,
      "text": "すると、くるまのきゅうぶれーきおんが、ぼくのみみをしげきする。",
      "notes": "（操夢）すると、くるまのきゅうぶれーきおんが、ぼくのみみをしげきする。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、クルマノキュウブレーキオンガ、ボクノミミオシゲキスル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
