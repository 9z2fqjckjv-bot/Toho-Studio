    {
      "slide_index": 3,
      "text": "ぼくはただひたすらに、そのとうげみちをかるいざわにむけてあるきつづける。",
      "notes": "（操夢）ぼくはただひたすらに、そのとうげみちをかるいざわにむけてあるきつづける。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワタダヒタスラニ、ソノトウゲミチオカルイザワニムケテアルキツズケル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "template_name": "写真",
