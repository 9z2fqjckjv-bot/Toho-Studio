            "status": "静止画 (立ち絵表示)",
            "duration": 0
          }
        ],
        "telop": {
          "detected": true,
          "text": "僕はただひたすらに、その峠道を軽井沢に向けて歩き続ける。",
          "shape_name": "テロップ枠",
          "animations": []
        },
        "texts": [],
        "shapes": [],
