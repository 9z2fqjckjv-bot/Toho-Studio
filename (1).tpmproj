      "voice": "jgr",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ココワ。ワイビル、ダヨ。ワタシガキノウミツケテ、アナタガキゼツシタアト、ココマデハコンデキタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
