    {
      "slide_index": 2,
      "text": "びゅんびゅんとぼくのよこをすれちがうたいこうしゃをよけながら、つきあかりだけのほどうもないくらいよみちをあるく。",
      "notes": "（操夢）びゅんびゅんとぼくのよこをすれちがうたいこうしゃをよけながら、つきあかりだけのほどうもないくらいよみちをあるく。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ビュンビュントボクノヨコオスレチガウタイコウシャヲヨケナガラ、ツキアカリダケノホドウモナイクライヨミチオアルク。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "transition_automatic": false,
      "template_name": "写真",
      "template_info": {
        "layout_name": "写真",
        "is_section_header": false,
        "section_title": ""
      },
      "slide_objects": {
        "characters": [
          {
            "name": "操夢",
            "image_name": "操夢_立ち絵",
            "image_path": "",
            "animations": [],
            "has_movement": false,
            "status": "静止画 (立ち絵表示)",
            "duration": 0
          }
        ],
        "telop": {
          "detected": true,
          "text": "ビュンビュンと僕の横をすれ違う対向車を避けながら、\n月明かりだけの歩道もない暗い夜道を歩く。",
          "shape_name": "テロップ枠",
          "animations": []
        },
        "texts": [],
        "shapes": [],
        "template": {
          "layout_name": "写真",
          "is_section_header": false,
          "section_title": ""
        }
      },
