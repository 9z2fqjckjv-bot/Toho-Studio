    },
    {
      "slide_index": 3,
      "text": "「ねぇ、にとり。操夢の姿、見なかったかしら？」",
      "notes": "（霊夢）「ねぇ、にとり。操夢の姿、見なかったかしら？」",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ネー、ニトリ。ソームノスガタ、ミナカッタカシラ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
