    {
      "slide_index": 2,
      "text": "「こんにちはー！にとりの訪問販売でーす！」",
      "notes": "（にとり）「こんにちはー！にとりの訪問販売でーす！」",
      "character": "にとり",
      "voice": "jgr",
      "speed": 105,
      "pitch": 105,
      "phonemes": "コンニチハーニトリノホウモンハンバイデース",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
