      "audio_duration": 2.1738095238095236,
      "audio_file": "slide_004.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第3話/第3話.004.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 5,
      "text": "「それで、彼はどこに行くって、言ってたの？」",
      "notes": "（霊夢）「それで、彼はどこに行くって、言ってたの？」",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソレデ、カレワドコニイクッテ、イッテタノ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.1557596371882086,
      "audio_file": "slide_005.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第3話/第3話.005.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 6,
      "text": "「特に、何も言ってなかった、それがどうかした？」",
      "notes": "（にとり）「特に、何も言ってなかった、それがどうかした？」",
      "character": "にとり",
      "voice": "jgr",
      "speed": 105,
      "pitch": 105,
      "phonemes": "トクニ、ナニモイッテナカッタ、ソレガドウカシタ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
        "images": [],
        "characters": [],
        "background": []
      },
      "character_images": "",
      "bg_images": [],
      "telop_frame_detected": true,
      "audio_duration": 3.428707482993197,
      "audio_file": "slide_006.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第3話/第3話.006.jpeg",
      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 7,
      "text": "「そう…。私はそう言うと、彼を探し始めた。」",
      "notes": "（霊夢）「そう…。私はそう言うと、彼を探し始めた。」",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ソウ。ワタシワソウイウト、カレオサガシハジメタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
