      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 4,
      "text": "「彼なら、さっきすれ違ったよ。」",
      "notes": "（にとり）「彼なら、さっきすれ違ったよ。」",
      "character": "にとり",
      "voice": "jgr",
      "speed": 105,
      "pitch": 105,
      "phonemes": "カレナラ、サッキスレチガッタヨ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
        "presenter_notes": [],
        "transitions": [],
