      "video_clip_path": null,
      "animation_path": null,
      "video_start_time": 0,
      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "sound_effects": []
    },
    {
      "slide_index": 13,
      "text": "「う…うん…」僕は、そう返すのがやっとの状態で彼女の手を取り、立ち上がる。だが、その瞬間に頭痛が走る。",
      "notes": "（操夢）「う…うん…」僕は、そう返すのがやっとの状態で彼女の手を取り、立ち上がる。だが、その瞬間に頭痛が走る。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ウウンボクワ、ソウカエスノガヤットノジョウタイデカノジョノテオトリ、タチアガル。ダガ、ソノシュンカンニズツウガハシル。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
