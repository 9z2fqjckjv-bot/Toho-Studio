      "_cacheBuster": 1787996142069,
      "sound_effects": []
    },
    {
      "slide_index": 8,
      "text": "「ここ最近、フランお嬢様がご乱心になられることが増えておりまして、その度に被害が及ぶため、それの抑止になるかと…」",
      "notes": "（咲夜）「ここ最近、フランお嬢様がご乱心になられることが増えておりまして、その度に被害が及ぶため、それの抑止になるかと…」",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "ココサイキン、フランオジョーサマガゴランシンニナラレルコトガフエテオリマシテ、ソノタビニヒガイガオヨブタメ、ソレノヨクシニナルカト",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
