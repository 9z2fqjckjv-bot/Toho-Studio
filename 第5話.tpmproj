      "_cacheBuster": 1787996142069,
      "sound_effects": []
    },
    {
      "slide_index": 11,
      "text": "「何か、対策があるのかしら？」",
      "notes": "（紫）「何か、対策があるのかしら？」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ナニカ、タイサクガアルノカシラ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
      "animation_details": {
