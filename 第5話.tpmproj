      "video_duration": null,
      "animation_duration": null,
      "is_enabled": true,
      "audio_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/音声/第5話/slide_002.wav",
      "_cacheBuster": 1787996142069,
      "sound_effects": []
    },
    {
      "slide_index": 3,
      "text": "「それじゃあ、2回目の彼に関わる会議、始めるわね。」",
      "notes": "（紫）「それじゃあ、2回目の彼に関わる会議、始めるわね。」",
      "character": "紫",
      "voice": "f2",
      "speed": 95,
      "pitch": 100,
      "phonemes": "ソレジャア、ニカイメノカレニカカワルカイギ、ハジメルワネ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
