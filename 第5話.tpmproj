      "_cacheBuster": 1787996142069,
      "sound_effects": []
    },
    {
      "slide_index": 10,
      "text": "「確かに、指摘の通り、そのままだと、彼に被害が及びます。」",
      "notes": "（咲夜）「確かに、指摘の通り、そのままだと、彼に被害が及びます。」",
      "character": "咲夜",
      "voice": "f1",
      "speed": 105,
      "pitch": 125,
      "phonemes": "タシカニ、シテキノトオリ、ソノママダト、カレニヒガイガオヨビマス。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
