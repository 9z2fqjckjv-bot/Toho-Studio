      "audio_duration": 8.927006802721088,
      "audio_file": "slide_002.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第5話/第5話.002.jpeg",
      "video_clip_path": null,
