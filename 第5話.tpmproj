    },
    {
      "slide_index": 13,
      "text": "「その発言…、矛盾してません？」",
      "notes": "（文）「その発言…、矛盾してません？」",
      "character": "文",
      "voice": "f2",
      "speed": 100,
      "pitch": 125,
      "phonemes": "ソノハツゲン、ムジュンシテマセン",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
