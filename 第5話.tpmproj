      "audio_duration": 2.478639455782313,
      "audio_file": "slide_011.wav",
      "image_path": "/Volumes/ZSSD/GitHub/repository/Toho-Project-Second-Story/幼き日の夢/スライド画像/第5話/第5話.011.jpeg",
      "video_clip_path": null,
      "animation_path": null,
