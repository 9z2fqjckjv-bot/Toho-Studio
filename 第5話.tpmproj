      "_cacheBuster": 1787996142069,
      "sound_effects": []
    },
    {
      "slide_index": 9,
      "text": "「でも、それじゃあ、彼に被害が出るんじゃないの？」",
      "notes": "（霊夢）「でも、それじゃあ、彼に被害が出るんじゃないの？」",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "デモ、ソレジャア、カレニヒガイガデルンジャナイノ",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
