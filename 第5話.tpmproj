    {
      "slide_index": 2,
      "text": "私がゆかりの家にくると、彼と関係のあるもこう、ゆかり、そして特に関わりのなさそうなさくやとあやのよにんがいた。",
      "notes": "（霊夢）私がゆかりの家にくると、彼と関係のあるもこう、ゆかり、そして特に関わりのなさそうなさくやとあやのよにんがいた。",
      "character": "霊夢",
      "voice": "f1",
      "speed": 100,
      "pitch": 100,
      "phonemes": "ワタシガユカリノイエニクルト、カレトカンケイノアルモコウ、ユカリ、ソシテトクニカカワリノナサソウナサクヤトアヤノヨニンガイタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
      "transition_effect": "no transition effect",
      "target_duration": null,
      "is_animation_sync": false,
      "has_animation": false,
      "animated_objects": [],
