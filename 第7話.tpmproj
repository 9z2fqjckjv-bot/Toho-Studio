    {
      "slide_index": 2,
      "text": "ぼくは、じぶんのへやでのんびりとおちゃをすすりながら、へやをみわたしていた。",
      "notes": "（操夢）ぼくは、じぶんのへやでのんびりとおちゃをすすりながら、へやをみわたしていた。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "ボクワ、ジブンノヘヤデノンビリトオチャオススリナガラ、ヘヤオミワタシテイタ。",
      "extra_delay": 0,
      "transition_delay": 0.5,
      "transition_duration": 1,
