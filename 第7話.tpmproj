    {
      "slide_index": 3,
      "text": "すると、へやがのっくされ、だれかがはいってくる。",
      "notes": "（操夢）すると、へやがのっくされ、だれかがはいってくる。",
      "character": "操夢",
      "voice": "imd1",
      "speed": 100,
      "pitch": 115,
      "phonemes": "スルト、ヘヤガノックサレ、ダレカガハイッテクル。",
      "extra_delay": 0,
